{
  "name": "vx-lang",
  "displayName": "Vx Language",
  "description": "Syntax highlighting and language support for Vx",
  "publisher": "hiraditya",
  "repository": {
    "type": "git",
    "url": "https://github.com/vx-lang/Vx"
  },
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onLanguage:vx"
  ],
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vx",
        "aliases": [
          "Vx",
          "vx"
        ],
        "extensions": [
          ".vx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vx",
        "scopeName": "source.vx",
        "path": "./syntaxes/vx.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^16.11.7",
    "typescript": "^4.8.4"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}
