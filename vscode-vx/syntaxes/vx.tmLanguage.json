{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "vx",
  "patterns": [
    {
      "include": "#macros"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "macros": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(!)",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.vx"
            },
            "2": {
              "name": "keyword.operator.vx"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vx",
          "match": "\\b(import|fn|let|mut|for|in|if|else|loop|while|break|continue|return|spawn|on|transfer|unroll|across|match|unsafe|safe|comptime|assert|grad|vjp|jvp|as|requires|ensures|invariant|macro_rules)\\b"
        },
        {
          "name": "storage.type.vx",
          "match": "\\b(struct|enum|trait|impl|extern)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.vx",
          "match": "\\b(i4|i8|i16|i32|i64|i128|u4|u8|u16|u32|u64|u128|f16|bf16|f32|f64|bool|Topology|MemorySpace|Ref|Verified|Pinned|HardwareState|Tensor|Matrix)\\b"
        },
        {
          "name": "constant.language.topology.vx",
          "match": "\\b(Host|GPU|AMX|ANE|AccCore|NPU|HostDRAM|NPUHBM|LocalSRAM)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vx",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vx",
          "match": "//.*$"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.vx",
          "match": "\\b(0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)([iu](8|16|32|64|128)|usize|f(16|32|64))?\\b"
        },
        {
          "name": "constant.language.boolean.vx",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vx",
          "match": "(\\+|-|\\*|/|%|==|!=|<|>|<=|>=|=|\\+=|-=|\\*=|/=|&&|\\|\\||!)"
        }
      ]
    }
  },
  "scopeName": "source.vx"
}
