{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vx",
  "scopeName": "source.vx",
  "fileTypes": [
    "vx"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#type_names"
    },
    {
      "include": "#scalar_types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#macros"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.vx",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.vx",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vx",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vx",
          "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)([a-zA-Z][0-9a-zA-Z]*)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.vx"
            }
          }
        },
        {
          "name": "storage.type.vx",
          "match": "\\b(fn|let|mut|struct|enum|trait|impl|extern|pub|transfer_async|transfer)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vx",
          "match": "\\b(for|in|if|else|loop|while|break|continue|return|match|spawn|tasks|on|across|unroll|where|unsafe|safe|comptime|import|as|assert|grad|vjp|jvp|requires|ensures|invariant|type)\\b"
        }
      ]
    },
    "type_names": {
      "patterns": [
        {
          "name": "support.type.vx",
          "match": "\\b(Topology|Memory|Ref|Verified|Distinct|Pinned|HardwareState|Tensor|Matrix)\\b"
        }
      ]
    },
    "scalar_types": {
      "patterns": [
        {
          "name": "storage.type.primitive.vx",
          "match": "\\b(f4e2m1|f8e4m3|f8e5m2|bf16|f16|f32|f64|i4|u4|i8|u8|i16|u16|i32|u32|i64|u64|i128|u128|usize|bool)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vx",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.vx",
          "match": "\\bself\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)!\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.vx"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vx",
          "match": "(->|=>|::|\\.\\.|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%&|^!<>=@$?:.])"
        }
      ]
    }
  }
}
