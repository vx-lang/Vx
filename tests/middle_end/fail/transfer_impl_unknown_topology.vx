// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s 2>&1 | FileCheck %s --check-prefix=PLACE
// A lowering for a machine this compilation has never heard of. It is code that
// nothing can run, and before the `for` clause it could not even be asked: a
// lowering named no machine, so there was nothing to check it against (Vx#353).
// CHECK: E6015
// The console also names the place in the source.
// PLACE: Error[E6015] at {{.*}}transfer_impl_unknown_topology.vx:16:1:
// CHECK: no topology named 'Ampere' is declared
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Ampere {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    for i in 0..raw::extent(src) {
      raw::store(dst, i, raw::load(src, i));
    }
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
