// RUN: not vxc %s 2>&1 | FileCheck %s
// `std::tensor`'s `sum` is a method of 1-D tensors only. Called on a rank-2 tensor, it is
// reported as a method that type does not have, naming the type.
// CHECK: Method 'sum' not found on type Tensor<f32, [2, 4]>
import std::tensor;

fn reduce_all(m : Tensor<f32, [2, 4]>) -> f32 {
  return m.sum();
}

fn main() -> i32 {
  let mut t = Tensor<f32, [2, 4]>::uninit();
  t[0][0] = 1.0;
  let s : f32 = reduce_all(t);
  print(s);
  return 0;
}
