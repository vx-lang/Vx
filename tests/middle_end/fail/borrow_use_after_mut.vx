//===----------------------------------------------------------------------===//
// Accessing a variable while a live mutable borrow exists must be rejected.
// Unlike borrow_mut_twice (which tests double-borrow), this tests direct
// access to the original variable while a mutable borrow is active.
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn use_ref(r: &mut DynTensor<f32>) -> i32 {
  return 0;
}

fn main() -> i32 {
  let mut x = Tensor<f32>();
  let y = &mut x;
  let z = x;
  use_ref(y);
  return 0;
}

// CHECK: Cannot access 'x' because it is mutably borrowed.
