// RUN: not vxc %s 2>&1 | FileCheck %s

// Repaired fossil: this file once pinned an emitted `memref.copy` between
// address spaces, but it has failed at SEMA for years (legacy Tensor syntax
// and a Tensor-returning main), so the MLIR CHECK matched nothing. The checks
// now pin the sema refusals the file actually produces; cross-space transfer
// legality itself is sema's job today (E6009/E6010/E6004 and the raw::
// contract), each pinned by its own test.

fn main() -> Tensor<f32> {
  let t_host : Tensor<f32> = Tensor([ 1, 1 ]);
  let t_device : Tensor<f32> = t_host.to_device();

  spawn on(Topology::NPU[0]) {
    let t_core = transfer(t_device, Memory::NPU_HBM);
  }

  return t_host;
}

// CHECK: `main` must return i32
// CHECK: Missing generic argument for Tensor initialization.
