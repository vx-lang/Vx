// RUN: not vxc %s 2>&1 | FileCheck %s
// A closure runs when called, not when the lowering runs, so a primitive
// inside one escapes the barrier and async guarantees. Refused at typing --
// the whole-body scan never sees closure bodies (they are lifted out first).
// CHECK: E6017
// CHECK: inside a closure
impl transfer Memory::L2 -> Memory::SMEM {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i64 {
    let f = | x : i64 | x + raw::lanes();
    return f(1);
  }
}
fn main() -> i32 {
  return 0;
}
