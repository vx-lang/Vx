// RUN: not vxc %s 2>&1 | FileCheck %s
// A tensor constructor takes exactly the arguments its type does not already carry (Vx#429).
//
// `Tensor<f32, [2, 2]>` has its shape in the type, so the constructor takes nothing; passing one
// anyway would be a second shape with no rule saying which wins. `DynTensor<f32>` has no shape in
// its type at all -- that is what the variant is for -- so the constructor is where the shape
// arrives, and omitting it leaves a tensor nothing can size.
//
// A `Tensor`'s extents are part of its type, so an extent nothing can evaluate is not a static
// extent (Vx#399). Written down, that has to be refused rather than quietly answered with a
// `DynTensor`: the older `Tensor<f32>([n, m])` spelling had no type to contradict and could be
// reclassified silently, but a type the source states is a claim, and answering a different one
// is how a shape nobody can read comes to be trusted by a later check.
//
// Both constructors are covered, since the rule is about the type and not about which one was
// written.
//
// CHECK-DAG: 'Tensor::uninit' expects 0 argument(s)
// CHECK-DAG: 'DynTensor::new' expects 1 argument(s)
// CHECK-DAG: every extent has to be known at compile time

fn shape_written_twice() -> i32 {
  let t = Tensor<f32, [ 2, 2 ]>::uninit([ 2, 2 ]);
  return 0;
}

fn shape_written_nowhere() -> i32 {
  let t = DynTensor<f32>::new();
  return 0;
}

fn shape_not_known_until_run_time(n : i32) -> i32 {
  let t = Tensor<f32, [ n, n ]>::uninit();
  return 0;
}

fn main() -> i32 {
  return 0;
}
