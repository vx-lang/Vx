// RUN: not vxc %s 2>&1 | FileCheck %s
//
// Declarations of built-in names are refused. Patchable built-in topologies
// (`GPU`, `NPU`, `AccCore`) can only declare `dtypes:`. Transfer edges are
// refused for these topologies. Built-in topologies that cannot patch `dtypes:`
// (`CPU`, `AMX`, `ANE`, `CpuAvx512`, `CpuNeon`) are refused immediately.
// `Current` is refused for its name.
// topology_shadows_builtin.vx shows what goes wrong when it is not refused.
// CHECK-DAG: topology 'CPU' cannot take `dtypes:`, because host functions and the standard library run on it
// CHECK-DAG: a topology cannot be named `Current`
// CHECK-DAG: topology 'NPU' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'AccCore' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'AMX' cannot take `dtypes:`, because its memory `CPU_DRAM` belongs to 'CPU'
// CHECK-DAG: topology 'ANE' cannot take `dtypes:`, because its memory `NPU_HBM` belongs to 'NPU'. Put `dtypes:` on 'NPU'
// CHECK-DAG: topology 'GPU' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'CpuAvx512' cannot take `dtypes:`, because its memory `CPU_DRAM` belongs to 'CPU'
// CHECK-DAG: topology 'CPU_AVX512' cannot take `dtypes:`, because its memory `CPU_DRAM` belongs to 'CPU'
// CHECK-DAG: topology 'CpuNeon' cannot take `dtypes:`, because its memory `CPU_DRAM` belongs to 'CPU'
// CHECK-DAG: topology 'CPU_Neon' cannot take `dtypes:`, because its memory `CPU_DRAM` belongs to 'CPU'

Memory CHIP_RAM {
  capacity: 1 GB, bandwidth: 1 TB/s
}

Topology CPU {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology Current {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology NPU {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology AccCore {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology AMX {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology ANE {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology GPU {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CpuAvx512 {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CPU_AVX512 {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CpuNeon {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CPU_Neon {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}

fn main() -> i32 {
  return 0;
}
