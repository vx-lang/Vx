// RUN: not vxc %s 2>&1 | FileCheck %s
//
// Declarations of built-in names are refused for their `transfer` edges, and
// `Current` is refused for its name. A use of that name always means the built-in,
// so overriding its transfer edges is refused.
// topology_shadows_builtin.vx shows what goes wrong when it is not refused.
// CHECK-DAG: topology 'CPU' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: a topology cannot be named `Current`
// CHECK-DAG: topology 'NPU' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'AccCore' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'AMX' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'ANE' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'GPU' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'CpuAvx512' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'CPU_AVX512' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'CpuNeon' has the name of a built-in topology, so it cannot set transfer edges
// CHECK-DAG: topology 'CPU_Neon' has the name of a built-in topology, so it cannot set transfer edges

Memory CHIP_RAM {
  capacity: 1 GB, bandwidth: 1 TB/s
}

Topology CPU {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology Current {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology NPU {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology AccCore {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology AMX {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology ANE {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology GPU {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CpuAvx512 {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CPU_AVX512 {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CpuNeon {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}
Topology CPU_Neon {
  memory: Memory::CHIP_RAM, transfer Memory::CPU_DRAM -> Memory::CHIP_RAM : 100
}

fn main() -> i32 {
  return 0;
}
