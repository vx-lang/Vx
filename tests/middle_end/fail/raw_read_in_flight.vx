// RUN: not vxc %s 2>&1 | FileCheck %s
// Reading the destination while the copy is in flight: its contents are
// unspecified until the wait. The same reject hir/seam.rs gives a stale read.
// CHECK: E6021
// CHECK: still outstanding
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM copy_engine
}
impl transfer Memory::L2 -> Memory::SMEM {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    raw::async_copy(dst, src, 0);
    let v = raw::load(dst, 0);
    raw::async_wait();
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
