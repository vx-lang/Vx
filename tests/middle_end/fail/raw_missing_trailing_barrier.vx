// RUN: not vxc %s 2>&1 | FileCheck %s
// A lowering that writes the destination on a synchronizing edge must end
// with raw::barrier(): without it the transfer is relaxed and a stale read
// is reachable -- the seam obligation, in syntactic form.
// CHECK: E6021
// CHECK: does not end with
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Dev {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    raw::store(dst, 0, 1.0);
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
