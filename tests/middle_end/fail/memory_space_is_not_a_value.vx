// RUN: not vxc %s 2>&1 | FileCheck %s
// A memory space is not a value. `transfer(a, Memory::X)` and `t.with_memory(Memory::X)`
// destructure it at the call site, and every other use carries it in a type, so the
// expression has no value type to answer with.
//
// It used to answer a dims-less f32 tensor. A source with no dims skips the comparison
// against an annotation, so a declaration was accepted and the mismatch surfaced from
// codegen as "not a runtime value", saying nothing about the type it contradicted. The
// sibling `Topology::GPU` was rejected all along, which is what made the asymmetry visible.
//
// The positions are separate because they do not share a check: the declaration has one,
// the argument has eight, and reaching either through a binding goes a third way. A bare
// `let` and a `return` have no annotation to contradict and still surface from codegen --
// see the issue, they need the diagnostic raised where the expression is typed, which
// cannot be done blindly because `with_memory` reaches the same arm legitimately.
//
// CHECK-COUNT-2: Type mismatch in variable declaration
// CHECK-COUNT-2: Type mismatch in argument 1
fn take(t : Tensor<f32, [ 2, 2 ]>) -> i32 {
  return 0;
}

fn in_a_declaration() -> i32 {
  let t : Tensor<f32, [ 2, 2 ]> = Memory::GPU_HBM;
  return 0;
}

fn through_a_binding() -> i32 {
  let m = Memory::GPU_HBM;
  let t : Tensor<f32, [ 2, 2 ]> = m;
  return 0;
}

fn in_an_argument() -> i32 {
  return take(Memory::GPU_HBM);
}

fn in_an_argument_through_a_binding() -> i32 {
  let m = Memory::GPU_HBM;
  return take(m);
}

fn main() -> i32 {
  return 0;
}
