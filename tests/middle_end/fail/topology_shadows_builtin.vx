// RUN: not vxc %s 2>&1 | FileCheck %s
// Declaring a topology named after a built-in is allowed only if it patches fields
// like `dtypes:`. Overriding fields the compiler hardcodes for the built-in (such as
// `arch:`) is refused: the parser resolves `Topology::GPU` to the built-in unconditionally,
// so the override would be silently ignored at every use site.
// CHECK: E6016
// CHECK: cannot override its `arch:`
Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology GPU {
  arch: applegpu,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s
}
fn main() -> i32 {
  return 0;
}
