// RUN: not vxc %s 2>&1 | FileCheck %s
// A lane-guarded early return carries the in-flight copy out of the body: the
// walk models every exit, so the leak on the early path is refused. This
// program passed every check before the exit-aware walk (A2 review).
// CHECK: E6021
// CHECK: on some path out of the body
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM copy_engine
}
impl transfer Memory::L2 -> Memory::SMEM {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    raw::async_copy(dst, src, 0);
    if raw::lane() == 0 {
      return 0;
    }
    raw::async_wait();
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
