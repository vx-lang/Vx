// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error[E4003]
// Soundness (#266, #269): bc9 through a closure callee. `f(m)` reborrows `*m`; mutating through `m`
// via `insert(m, 42)` while that reborrow is live is a shared-XOR-mutable violation. Now caught by
// the *aliasing* rule (E4003) — `resolve_callee_ref_signature` resolves the closure's `Closure_N_call`
// signature (minus its env parameter). Previously it was caught only incidentally by the escape rule
// (E4005), which also over-rejected the sound closure-return in
// tests/frontend/pass/borrow_closure_return_param.vx.
struct Map {
  slot : i32, present : i32
}
fn insert(m : &mut Map, v : i32) -> void {
  m.slot = v; m.present = 1;
}
fn bad(m : &mut Map) -> &i32 {
  let f = |q : &Map| &q.slot;
  let found = f(m);
  insert(m, 42);
  return found;
}
fn main() -> i32 {
  let mut x = Map {
    slot : 1, present : 1
  };
  return *bad(&mut x);
}
