// RUN: not vxc %s 2>&1 | FileCheck %s
// ANE cannot take dtypes:, because NPU_HBM belongs to NPU.
// CHECK: E6016
// CHECK: topology 'ANE' cannot take `dtypes:`, because its memory `NPU_HBM` belongs to 'NPU'. Put `dtypes:` on 'NPU'

Topology ANE {
  memory: Memory::NPU_HBM,
  visible: [Memory::NPU_HBM, Memory::CPU_DRAM],
  dtypes: [f16]
}

fn main() -> i32 {
  return 0;
}

