// RUN: not vxc %s 2>&1 | FileCheck %s
// Two mutable borrows with the FIRST held live across the second (the `w = y`
// use). Repaired from a pre-NLL fossil: the old first borrow died immediately,
// and the test only failed because `main` returned Tensor (the #210 i32 rule).
// CHECK: Cannot access 'x' because it is mutably borrowed.
fn main() -> i32 {
  let mut x : Tensor<f32> = Tensor<f32>();
  let y = &mut x;
  let z = &mut x; // Error: x is still mutably borrowed (y lives until `w = y`)
  let w = y;
  return 0;
}
