// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Comptime assert failed: Hardware dimensions are completely mismatched!
fn main() -> i32 {
  comptime {
    assert(256 == 512, "Hardware dimensions are completely mismatched!");
  }
  return 0;
}
