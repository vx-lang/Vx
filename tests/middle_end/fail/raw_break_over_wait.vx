// RUN: not vxc %s 2>&1 | FileCheck %s
// A break jumps over the wait: the copy from the broken iteration is still in
// flight at the post-loop read. The loop join unions every way out, so the
// break path's state reaches the load. Passed before the exit-aware walk.
// CHECK: E6021
// CHECK: still outstanding
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM copy_engine
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Dev {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    for i in 0..raw::extent(src) {
      raw::async_copy(dst, src, i);
      if raw::lane() == 0 {
        break;
      }
      raw::async_wait();
    }
    let v = raw::load(dst, 0);
    raw::async_wait();
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
