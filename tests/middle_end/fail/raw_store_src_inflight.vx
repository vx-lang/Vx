// RUN: not vxc %s 2>&1 | FileCheck %s
// The engine is still READING the source of an in-flight copy; writing it
// races the engine. Reading it is fine, so only the store is refused.
// CHECK: E6021
// CHECK: source of an in-flight
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM copy_engine
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Dev {
  fn move_tile(src: &mut Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    raw::async_copy(dst, src, 0);
    raw::store(src, 1, 1.0);
    raw::async_wait();
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
