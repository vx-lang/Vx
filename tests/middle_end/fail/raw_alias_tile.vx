// RUN: not vxc %s 2>&1 | FileCheck %s
// The primitives touch only the tiles the transfer was given. A local alias
// would carry the same tensor under a different name -- invisible to the
// name-keyed async walk, which is exactly how an in-flight read slipped
// through in review.
// CHECK: E6017
// CHECK: not a parameter of this lowering
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Dev {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    let alias = src;
    let v = raw::load(alias, 0);
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
