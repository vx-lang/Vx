// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: E4003
// `pick_unsafe` stores a pointer to `a.slot` in `c` inside an `unsafe` block, and returns what
// `c` points at. The return-provenance summary does not follow a store through a pointer, so the
// result may point into any argument, and the checker must refuse a change to `x` while `r` is
// in use.
struct Map {
  slot : i32, present : i32
}
struct Cell {
  p : *const i32
}
fn insert(m : &mut Map, v : i32) -> void {
  m.slot = v; m.present = 1;
}
fn pick_unsafe(a : &Map, b : &Map, c : &mut Cell) -> &i32 {
  unsafe { c.p = (&a.slot) as *const i32; }
  return unsafe { &*c.p };
}
fn bad() -> i32 {
  let mut x = Map {
    slot : 1, present : 1
  };
  let mut y = Map {
    slot : 2, present : 1
  };
  let mut c = Cell {
    p : (&y.slot) as *const i32
  };
  let r = pick_unsafe(&x, &y, &mut c);
  insert(&mut x, 9);   // `r` points at `x.slot`
  return *r;
}
fn main() -> i32 {
  return 0;
}
