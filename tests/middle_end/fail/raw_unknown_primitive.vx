// RUN: not vxc %s 2>&1 | FileCheck %s
// The primitive set is closed: eight names, nothing else. A typo'd or invented
// primitive is refused by name, so the floor cannot grow by accident.
// CHECK: E6017
// CHECK: unknown primitive
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Dev {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    raw::memcpy(dst, src);
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
