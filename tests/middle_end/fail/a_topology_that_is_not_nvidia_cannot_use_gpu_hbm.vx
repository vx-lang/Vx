//===----------------------------------------------------------------------===//
// `Memory::GPU_HBM` is the memory of the built-in NVIDIA GPU, and a transfer into it goes to that
// GPU. So a topology of another arch cannot have it as its memory: its kernels would run in one
// place and its tensors would be in another. An NVIDIA topology can have it.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not="topology 'Nvidia'"
// The errors come in the order of the names.
// CHECK: E6016
// CHECK: topology 'Apple' uses `Memory::GPU_HBM`, which is only valid for `arch: nvptx64`
// CHECK: E6016
// CHECK: topology 'Spirv' has `arch: spirv64`, but its memory is `Memory::GPU_HBM`

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, managed: explicit, scope: device
}
Topology Spirv {
  arch: spirv64,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 63 GB/s
}
Topology Apple {
  arch: applegpu,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 63 GB/s
}
Topology Nvidia {
  arch: nvptx64,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 63 GB/s
}

fn main() -> i32 {
  return 0;
}
