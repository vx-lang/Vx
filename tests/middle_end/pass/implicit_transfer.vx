// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

struct MyModel {
  weights: DynTensor<f32>,
}

impl Relocatable for MyModel {
  fn relocate(self: MyModel) -> MyModel {
    return self;
  }
}

fn process(m_host: MyModel) -> MyModel {
  spawn on(Topology::NPU[0]) {
    // This access crosses the topology boundary and triggers implicit transfer
    let m_device = m_host;
  }
  return MyModel {
    weights: Tensor<f32>()
  };
}

// XFAIL-RUN: emit-mlir fails on the same defect: the struct's tensor field reaches `llvm.insertvalue`
// XFAIL-LOWER: a struct with a tensor field lowers to `llvm.insertvalue` on a memref, which is not a primitive LLVM type (Vx#356)
// CHECK: "func.call"
