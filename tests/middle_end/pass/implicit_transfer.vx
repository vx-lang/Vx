// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

struct MyModel {
  weights: Tensor<f32, [?, ?]>,
}

impl Relocatable for MyModel {
  fn relocate(self: MyModel) -> MyModel {
    return self;
  }
}

fn process(m_host: MyModel) -> MyModel {
  spawn on(Topology::NPU[0]) {
    // This access crosses the topology boundary and triggers implicit transfer
    let m_device = m_host;
  }
  return MyModel {
    weights: Tensor<f32>([1, 1])
  };
}

// The transfer into the NPU region calls `relocate`.
// CHECK: func.call @MyModel$relocate
