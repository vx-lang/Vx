// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s

struct Config {
  dim : i32, norm_eps : f32,
}

fn main() -> i32 {
  let conf = Config {
    dim : 288,
    norm_eps : 0.00001,
  };

  let a = conf.dim;
  let b = conf.norm_eps;

  return 0;
}

// CHECK: module
// CHECK: func.func @main() -> i32 {
// CHECK: %0 = llvm.mlir.undef : !llvm.struct<"Config", (i32, f32)>
// CHECK: %c288_i32 = arith.constant 288 : i32
// CHECK: %1 = llvm.insertvalue %c288_i32, %0[0] : !llvm.struct<"Config", (i32, f32)>
// CHECK: %cst = arith.constant 9.99999974E-6 : f32
// CHECK: %2 = llvm.insertvalue %cst, %1[1] : !llvm.struct<"Config", (i32, f32)>
// CHECK: %3 = llvm.extractvalue %2[0] : !llvm.struct<"Config", (i32, f32)>
// CHECK: %4 = llvm.extractvalue %2[1] : !llvm.struct<"Config", (i32, f32)>
// CHECK: %c0_i32 = arith.constant 0 : i32
// CHECK: return %c0_i32 : i32
// CHECK: }
// CHECK: }
