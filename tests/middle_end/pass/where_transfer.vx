// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// `where Transfer<S, D>`: a function generic over two topologies with a transfer
// constraint. At the call the variables are deduced (S = GPU, D = CPU, from the two
// Pinned arguments) and the constraint is discharged against the cost graph -- a
// GPU->CPU path exists, so it compiles and monomorphizes.

fn move_between<S: Topology, D: Topology>(src: Pinned<i32, Topology::S>, dst: Pinned<i32, Topology::D>) -> i32
  where Transfer<S, D>
{
  return 0;
}

fn main() -> i32 {
  let a = spawn on(Topology::GPU) {
    5
  };
  let b = spawn on(Topology::CPU) {
    7
  };
  move_between(a, b);
  return 0;
}

// CHECK: func.func @move_between
