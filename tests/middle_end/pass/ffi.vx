// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

extern "C" {
  fn malloc(size : i32)->*mut f32;
}

fn main() -> i32 {
  unsafe { let ptr = malloc(1024); }
  return 0;
}

// A size is a count and malloc hands back storage, so the signature is i32 -> ptr. It used to
// read memref<?x?xi32> -> memref<memref<?x?xf32>>, which is what spelling a scalar as a
// dims-less tensor bought (Vx#399).
// CHECK: func.func private @malloc(i32) -> !llvm.ptr
// CHECK-LABEL: func.func @main() -> i32 {
// CHECK: %[[N:.*]] = arith.constant 1024 : i32
// CHECK: call @malloc(%[[N]]) : (i32) -> !llvm.ptr
