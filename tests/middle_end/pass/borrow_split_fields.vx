//===----------------------------------------------------------------------===//
// Split borrows: different fields of the same struct can be mutably borrowed
// simultaneously because they occupy disjoint memory.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: llvm.mlir.undef : !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: llvm.insertvalue %[[V0]], %{{.*}} : !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V1:.*]] = arith.constant 2 : i32
// CHECK: llvm.insertvalue %[[V1]], %{{.*}} : !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V2:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: llvm.alloca %[[V2]] x !llvm.struct<"Point", (i32, i32)> : (i32) -> !llvm.ptr
// CHECK: llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Point", (i32, i32)>
// CHECK: llvm.getelementptr %{{.*}}, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V3:.*]] = arith.constant 0 : i32
// CHECK: return %[[V3]] : i32

struct Point {
  x : i32,
  y : i32,
}

fn main() -> i32 {
  let mut p = Point {
    x : 1, y : 2
  };

  // Borrow field x mutably
  let bx = &mut p.x;

  // Borrow field y mutably — this is allowed because x and y are disjoint
  let by = &mut p.y;

  return 0;
}
