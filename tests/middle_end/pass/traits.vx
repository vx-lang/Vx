// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

trait Dimension {
  fn dim(self : DynTensor<f32>)->i32;
}

impl Dimension for DynTensor<f32> {
  fn dim(self : DynTensor<f32>) -> i32 {
    return 2;
  }
}

fn process<T : Dimension>(val : T) -> i32 {
  let d = val.dim();
  return d;
}

fn main() -> i32 {
  let t : Tensor<f32, []> = 1.0;
  let res = process(t);
  return 0;
}

// dim() answers a rank, so it returns i32. The receiver is shape-generic, which is what
// DynTensor spells (Vx#399); the trait method still monomorphizes per element type.
// dim() answers a rank, so it returns i32, and its receiver is shape-generic, which is what
// DynTensor spells. The rank-0 argument is a real memref<f32> now rather than a scalar cast
// into a rank-2 memref (Vx#399).
// CHECK-LABEL: func.func @Tensor$f32$dim(%arg0: memref<?x?xf32>) -> i32 {
// CHECK: %[[R:.*]] = arith.constant 2 : i32
// CHECK: return %[[R]] : i32
// CHECK-LABEL: func.func @process$Tensor$f32(%arg0: memref<f32>) -> i32 {
// CHECK: %[[V:.*]] = memref.load %arg0[] : memref<f32>
// CHECK: %[[T:.*]] = builtin.unrealized_conversion_cast %[[V]] : f32 to memref<?x?xf32>
// CHECK: call @Tensor$f32$dim(%[[T]]) : (memref<?x?xf32>) -> i32
// CHECK-LABEL: func.func @main() -> i32 {
// CHECK: %[[BUF:.*]] = memref.alloc() : memref<f32>
// CHECK: linalg.fill ins(%{{.*}} : f32) outs(%[[BUF]] : memref<f32>)
// CHECK: call @process$Tensor$f32(%[[BUF]]) : (memref<f32>) -> i32
