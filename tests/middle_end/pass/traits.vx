// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

trait Dimension {
  fn dim(self : Tensor<f32, [?, ?]>)->i32;
}

impl Dimension for Tensor<f32, [?, ?]> {
  fn dim(self : Tensor<f32, [?, ?]>) -> i32 {
    return 2;
  }
}

fn process<T : Dimension>(val : T) -> i32 {
  let d = val.dim();
  return d;
}

fn main() -> i32 {
  let t = Tensor<f32, [2, 2]>::uninit();
  let res = process(t);
  return 0;
}

// dim() answers a rank, so it returns i32. The impl is for a rank-2 receiver with run-time
// extents, so a `[2, 2]` argument widens to it; the trait method still monomorphizes per
// element type. This used to pass a rank-0 tensor, which no impl covers: the checker let it
// through and codegen bitcast an f32 into a rank-2 memref. Rank is static now, and a rank
// no impl covers is refused at the call.
// The two paths emit the functions in different orders, so these are DAG-matched.
// CHECK-DAG: func.func @Tensor$f32$2x2$dim(%arg0: memref<?x?xf32>) -> i32
// CHECK-DAG: func.func @process$Tensor$f32$2x2(%arg0: memref<2x2xf32>) -> i32
// CHECK-DAG: memref.cast %arg0 : memref<2x2xf32> to memref<?x?xf32>
// CHECK-DAG: call @Tensor$f32$2x2$dim(%{{.*}}) : (memref<?x?xf32>) -> i32
// CHECK-DAG: call @process$Tensor$f32$2x2(%{{.*}}) : (memref<2x2xf32>) -> i32
