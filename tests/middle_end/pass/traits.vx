// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

trait Dimension {
  fn dim(self : Tensor<f32>)->Tensor<i32>;
}

impl Dimension for Tensor<f32> {
  fn dim(self : Tensor<f32>) -> Tensor<i32> {
    return 2;
  }
}

fn process<T : Dimension>(val : T) -> Tensor<i32> {
  let d = val.dim();
  return d;
}

fn main() -> i32 {
  let t : Tensor<f32> = 1.0;
  let res = process(t);
  return 0;
}

// CHECK: module
// CHECK:   func.func @Tensor$f32$0$dim(%arg0: memref<?x?xf32>) ->
// memref<?x?xi32> { CHECK:     arith.constant 2 : i32 CHECK:     return CHECK:
// func.func @process$Tensor$f32$0(%arg0: memref<?x?xf32>) -> memref<?x?xi32> {
// CHECK:     call @Tensor$f32$0$dim(%
// CHECK:     return
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     arith.constant 1.000000e+00 : f32
// CHECK:     call @process$Tensor$f32$0(%
// CHECK:     return

