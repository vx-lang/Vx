// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The doc's sketch, in the provable form: a range loop over the extent gives
// the prover `0 <= i < 4` for free, so every bounds obligation closes without
// an invariant, and the trailing barrier makes the transfer synchronizing.
// CHECK: main
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl Transfer<Memory::L2, Memory::SMEM> for Topology::Dev {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    for i in 0..raw::extent(src) {
      raw::store(dst, i, raw::load(src, i));
    }
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
