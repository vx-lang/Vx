// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
//
// A rank-0 tensor holds one value in a buffer, on both code generators: `t` is stored into a
// `memref<f32>`, and the transfer moves that buffer, not the bare number.

// CHECK: %[[T:.*]] = memref.alloc() : memref<f32>
// CHECK: memref.store %{{.*}}, %[[T]][] : memref<f32>
// CHECK: "vx.transfer"(%[[T]]){{.*}}: (memref<f32>) -> memref<f32>

fn main() -> i32 {
  let t : Tensor<f32, []> = 1.5;
  let td = transfer(t, Memory::NPU_HBM);
  let h = transfer(td, Memory::CPU_DRAM);
  return 0;
}
