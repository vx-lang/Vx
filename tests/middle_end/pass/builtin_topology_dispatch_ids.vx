// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// Each built-in topology name, written every way the language allows, picks the
// device number the runtime dispatches on. Both spellings of `CpuAvx512` and
// `CpuNeon` pick the same device. A name the compiler did not recognise would get
// a large number made from its letters instead.
//
// The spawns are generated in source order, so the checks are too.
// CHECK: vx.spawn topology(0)
// CHECK: vx.spawn topology(0)
// CHECK: vx.spawn topology(300)
// CHECK: vx.spawn topology(400)
// CHECK: vx.spawn topology(500)
// CHECK: vx.spawn topology(501)
// CHECK: vx.spawn topology(103)
// CHECK: vx.spawn topology(202)
// CHECK: vx.spawn topology(600)
// CHECK: vx.spawn topology(600)
// CHECK: vx.spawn topology(700)
// CHECK: vx.spawn topology(700)
// CHECK: vx.spawn topology(2849)
// CHECK: vx.spawn topology(2194)

fn main() -> i32 {
  spawn on(Topology::CPU) {
    let _a = 1;
  }
  spawn on(Topology::Current) {
    let _a = 1;
  }
  spawn on(Topology::AMX) {
    let _a = 1;
  }
  spawn on(Topology::ANE) {
    let _a = 1;
  }
  // No index means device 0.
  spawn on(Topology::GPU) {
    let _a = 1;
  }
  spawn on(Topology::GPU[1]) {
    let _a = 1;
  }
  spawn on(Topology::NPU[3]) {
    let _a = 1;
  }
  spawn on(Topology::AccCore[2]) {
    let _a = 1;
  }
  spawn on(Topology::CpuAvx512) {
    let _a = 1;
  }
  spawn on(Topology::CPU_AVX512) {
    let _a = 1;
  }
  spawn on(Topology::CpuNeon) {
    let _a = 1;
  }
  spawn on(Topology::CPU_Neon) {
    let _a = 1;
  }
  // A range of devices gets a number of its own.
  spawn on(Topology::NPU[0..14]) {
    let _a = 1;
  }
  spawn on(Topology::GPU[2..6]) {
    let _a = 1;
  }
  return 0;
}
