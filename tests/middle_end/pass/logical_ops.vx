// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s

fn main() -> i32 {
  let a : Tensor<i32, []> = 10;
  let b : Tensor<i32, []> = 20;
  let c : Tensor<i32, []> = 10;

  // Relational
  let is_less = a < b;
  let a2 : Tensor<i32, []> = 10;
  let is_eq = a2 == c;
  let b2 : Tensor<i32, []> = 20;
  let c2 : Tensor<i32, []> = 10;
  let is_neq = b2!= c2;

  let compound = is_less && is_eq;
  let a3 : Tensor<i32, []> = 10;
  let b3 : Tensor<i32, []> = 20;
  let c3 : Tensor<i32, []> = 10;
  let is_less2 = a3 < b3;
  let is_eq2 = a3 == c3;
  let compound2 = is_less2 && is_eq2;
  let inverted = !compound;
  let result = compound2 || inverted;

  return 0;
}

// Comparisons give `arith.cmpi`, and `!` gives `arith.xori`. `&&` and `||` are branches,
// because their right side must not run when the left side already decides the result.
// `a && b` jumps to the end with `a` when `a` is false; `a || b` does when `a` is true.
// CHECK: [[LESS:%[0-9]+]] = arith.cmpi slt
// CHECK: [[EQ:%[0-9]+]] = arith.cmpi eq
// CHECK: arith.cmpi ne
// CHECK: cf.cond_br [[LESS]], ^[[RHS:bb[0-9]+]], ^[[END:bb[0-9]+]]([[LESS]] : i1)
// CHECK: ^[[RHS]]:
// CHECK-NEXT: cf.br ^[[END]]([[EQ]] : i1)
// CHECK: ^[[END]]([[AND:%[0-9]+]]: i1):
// CHECK: [[NOT:%[0-9]+]] = arith.xori [[AND]]
// CHECK-NEXT: cf.cond_br [[LEFT:%[0-9]+]], ^[[END2:bb[0-9]+]]([[LEFT]] : i1), ^[[RHS2:bb[0-9]+]]
// CHECK: ^[[RHS2]]:
// CHECK-NEXT: cf.br ^[[END2]]([[NOT]] : i1)
