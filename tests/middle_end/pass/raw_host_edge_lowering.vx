// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// A lowering for a host edge: CPU_DRAM is not in the topology's visible list
// (no shipped fleet file lists it), and it does not have to be -- the host
// side is reachable by construction, so E6022 exempts it.
// CHECK: main
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl transfer Memory::CPU_DRAM -> Memory::L2 {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    for i in 0..raw::extent(src) {
      raw::store(dst, i, raw::load(src, i));
    }
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
