// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

enum PadMode {
  Pad,
  Trim
}

fn process_tensor(val: Tensor<f32, [128, 128]>) -> Tensor<f32, [256]> {
  // Fails exactly without PadMode::Pad, but succeeds with it!
  let padded = val.reshape([256], PadMode::Pad);
  return padded;
}

// The reshape is a view: one reinterpret_cast rewrites the buffer as a flat 256-element
// memref, so nothing is copied.
// CHECK-LABEL: func.func @process_tensor(%arg0: memref<128x128xf32>) -> memref<256xf32> {
// CHECK-NEXT: %[[V:.*]] = memref.reinterpret_cast %arg0 to offset: [0], sizes: [256], strides: [1] : memref<128x128xf32> to memref<256xf32>
// CHECK-NEXT: return %[[V]] : memref<256xf32>

fn main() -> i32 {
  let v = Tensor<f32, [ 128, 128 ]>::fill(1.0);
  process_tensor(v);
  return 0;
}
