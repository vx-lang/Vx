// RUN: vxc %s -o %t.mlir
// RUN: FileCheck %s < %t.mlir

enum PadMode {
  Pad,
  Trim
}

fn process_tensor(val: Tensor<f32, [128, 128]>) -> Tensor<f32, [256]> {
  // Fails exactly without PadMode::Pad, but succeeds with it!
  let padded = val.reshape([256], PadMode::Pad);
  return padded;
}

// CHECK: "func.func"() <{function_type = (memref<128x128xf32>) -> memref<256xf32>, sym_name = "process_tensor"}> ({
// CHECK: "memref.cast"(%
// CHECK: "memref.cast"(%
// CHECK: "func.return"(%

fn main() -> i32 {
  let v: Tensor<f32, [128, 128]> = 1.0;
  process_tensor(v);
  return 0;
}
