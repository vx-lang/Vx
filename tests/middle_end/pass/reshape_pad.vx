// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

enum PadMode {
  Pad,
  Trim
}

fn process_tensor(val: Tensor<f32, [128, 128]>) -> Tensor<f32, [256]> {
  // Fails exactly without PadMode::Pad, but succeeds with it!
  let padded = val.reshape([256], PadMode::Pad);
  return padded;
}

// The reshape is a view: one reinterpret_cast rewrites the parameter's buffer as a flat
// 256-element memref. Returning it copies, because the result is the caller's buffer and the
// view points at the argument's. That copy is what keeps the returned tensor from aliasing the
// argument -- handing the view back directly would have let a write through the result change
// `val`, which its type does not say. The cost is real: a view returned unchanged now copies.
// CHECK-LABEL: func.func @process_tensor
// CHECK-SAME: (%[[RET:.*]]: memref<256xf32>, %arg1: memref<128x128xf32>) {
// CHECK-NEXT: %[[V:.*]] = memref.reinterpret_cast %arg1 to offset: [0], sizes: [256], strides: [1] : memref<128x128xf32> to memref<256xf32>
// CHECK-NEXT: memref.copy %[[V]], %[[RET]] : memref<256xf32> to memref<256xf32>
// CHECK-NEXT: return

fn main() -> i32 {
  let v = Tensor<f32, [ 128, 128 ]>::fill(1.0);
  process_tensor(v);
  return 0;
}
