// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @probe(%arg0: !llvm.ptr) -> !llvm.ptr
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Map", (i32, i32)>
// CHECK: return %[[V0]] : !llvm.ptr
// CHECK-LABEL: func.func @main() -> i32
// CHECK: llvm.mlir.undef : !llvm.struct<"Map", (i32, i32)>
// CHECK: %[[V0:.*]] = arith.constant 7 : i32
// CHECK: llvm.insertvalue %[[V0]], %{{.*}} : !llvm.struct<"Map", (i32, i32)>
// CHECK: %[[V1:.*]] = arith.constant 1 : i32
// CHECK: llvm.insertvalue %[[V1]], %{{.*}} : !llvm.struct<"Map", (i32, i32)>
// CHECK: %[[V2:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: llvm.alloca %[[V2]] x !llvm.struct<"Map", (i32, i32)> : (i32) -> !llvm.ptr
// CHECK: %[[V3:.*]] = llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK: return %[[V3]] : i32
// Regression for #270: assigning a function to a variable and calling it indirectly used to ICE in
// codegen ("Missing signature for function pointer 'f'") because `infer_ast_type` did not recover a
// bare function name's signature from the function registry, so `ast_env` had no type for `f`. It is
// a *sound* program — no mutation — so the borrow checker does not mask the ICE. JITs to 7.
struct Map {
  slot : i32, present : i32
}
fn probe(q : &Map) -> &i32 {
  return &q.slot;
}
fn main() -> i32 {
  let x = Map {
    slot : 7, present : 1
  };
  let f = probe;
  return *f(&x);
}
