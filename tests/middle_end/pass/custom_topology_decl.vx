// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A source-level topology declaration describes a user-defined topology's memory
// model in-language (here: default placement in Local SRAM). It registers a
// descriptor in the topology registry, and `Topology::AcmeTPU` is then usable in
// `spawn on(...)` with no language edit -- parse -> typecheck -> `vx.spawn`.

Topology AcmeTPU {
  memory: Memory::Local_SRAM
}

fn main() -> i32 {
  spawn on(Topology::AcmeTPU) {
    let x = 1;
  }
  return 0;
}

// CHECK: func.func @main
// CHECK: vx.spawn topology(
// CHECK: vx.yield
