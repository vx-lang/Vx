// RUN: vxc %s | FileCheck %s

fn main() -> Tensor<f32> {
  return 0.0;
}

fn process(t_host: Tensor<f32>) -> Tensor<f32> {
  let t_device = t_host.to_device();

  spawn on (Topology::NPU[0]) {
    let x = t_device;
  }

  return t_host;
}

// CHECK: "builtin.module"() ({
// CHECK:   "func.func"() <{function_type = () -> i32, sym_name = "main"}> ({
// CHECK:     %1 = "arith.constant"() <{value = 0.000000e+00 : f32}> : () -> f32
// CHECK:     "func.return"(%1) : (f32) -> ()
// CHECK:   }) {llvm.emit_c_interface} : () -> ()
// CHECK:   "func.func"() <{function_type = (memref<?x?xf32>) -> memref<?x?xf32>, sym_name = "process"}> ({
// CHECK:   ^bb0(%arg0: memref<?x?xf32>):
// CHECK:     %0 = "vx.transfer"(%arg0) <{target_topology = 100 : i32}> : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     "vx.spawn"() <{topology = 100 : i32}> ({
// CHECK:     ^bb0:
// CHECK:     }) : () -> ()
// CHECK:     "func.return"(%arg0) : (memref<?x?xf32>) -> ()
// CHECK:   }) : () -> ()
// CHECK: }) : () -> ()
