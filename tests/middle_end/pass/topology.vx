// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=FLAT
//
// The flat code generator names the built-in space on the transfer and the topology on
// the spawn, as the AST code generator does, and the name adds no string global.
// FLAT-NOT: flat-codegen
// FLAT-NOT: llvm.mlir.global
// FLAT-LABEL: func.func @process(
// FLAT: "vx.transfer"(%arg0) <{target_topology = 100 : i32}> {space = "NPU_HBM"}
// FLAT: } {topology_name = "NPU[0]"}

fn main() -> i32 {
  return 0;
}

fn process(t_host : Tensor<f32, [?, ?]>) -> Tensor<f32, [?, ?]> {
  let t_device = t_host.to_device();

  spawn on(Topology::NPU[0]) {
    let x = t_device;
  }

  return t_host;
}

// CHECK: module
// CHECK:   func.func @main() -> i32 {
// CHECK:     arith.constant 0 : i32
// CHECK:     return
// CHECK:   }
// CHECK:   func.func @process(%arg0: memref<?x?xf32> {vx.owned}) -> memref<?x?xf32> {
// CHECK:     "vx.transfer"
// CHECK:     vx.spawn topology(100) {
// CHECK:       vx.yield
// CHECK:     }
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK: }
