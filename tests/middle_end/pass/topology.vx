// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s

fn main() -> i32 {
  return 0;
}

fn process(t_host : DynTensor<f32>) -> DynTensor<f32> {
  let t_device = t_host.to_device();

  spawn on(Topology::NPU[0]) {
    let x = t_device;
  }

  return t_host;
}

// CHECK: module
// CHECK:   func.func @main() -> i32 {
// CHECK:     arith.constant 0 : i32
// CHECK:     return
// CHECK:   }
// CHECK:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     "vx.transfer"
// CHECK:     vx.spawn topology(100) {
// CHECK:       vx.yield
// CHECK:     }
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK: }
