// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @probe(%arg0: !llvm.ptr) -> !llvm.ptr
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Map", (i32, i32)>
// CHECK: return %[[V0]] : !llvm.ptr
// CHECK-LABEL: func.func @pass_through(%arg0: !llvm.ptr) -> !llvm.ptr
// CHECK: call @probe(%{{.*}}) : (!llvm.ptr) -> !llvm.ptr
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
// Non-regression for #243: reborrowing through a reference *parameter* and returning the
// result is sound (the referent is caller-owned and outlives the call). The escape analysis
// must NOT flag this, and the reborrow tracker must NOT report a false conflict — there is no
// mutation aliasing the shared reborrow.
struct Map {
  slot : i32, present : i32
}
fn probe(m : &Map) -> &i32 {
  return &m.slot;
}
fn pass_through(m : &Map) -> &i32 {
  let r = probe(m);
  return r;
}
fn main() -> i32 {
  return 0;
}
