// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A user-defined topology can declare a *novel* memory space (not one of the
// built-ins), and a transfer edge to it. `Memory::AcmeSRAM` is not a built-in, so
// it parses to `MemorySpace::Custom("AcmeSRAM")`; the declaration registers it as
// the topology's placement and adds the host->AcmeSRAM edge to the cost graph.

Topology AcmeTPU2 {
  memory: Memory::AcmeSRAM
  transfer Memory::CPU_DRAM -> Memory::AcmeSRAM : 25
}

fn main() -> i32 {
  spawn on(Topology::AcmeTPU2) {
    let x = 1;
  }
  return 0;
}

// CHECK: func.func @main
// CHECK: vx.spawn topology(
// CHECK: vx.yield
