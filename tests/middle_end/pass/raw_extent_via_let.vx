// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The natural authoring shape: the extent bound through a let. The fold
// records `n == 4`, the range loop records `0 <= i < n`, and the bounds
// close without an invariant.
// CHECK: main
impl transfer Memory::L2 -> Memory::SMEM {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    let n = raw::extent(src);
    for i in 0..n {
      raw::store(dst, i, raw::load(src, i));
    }
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
