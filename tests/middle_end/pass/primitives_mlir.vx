// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn test_primitives() -> i32 {
  let a : u8 = 10;
  let b : i8 = 20;
  let c : u16 = 30;
  let d : i16 = 40;
  let e : u32 = 50;
  let f : i32 = 60;
  let g : u64 = 70;
  let h : i64 = 80;
  let i : u128 = 90;
  let j : i128 = 100;

  let x : f16 = 1.0;
  let y : bf16 = 2.0;
  let z : f32 = 3.0;
  let w : f64 = 4.0;

  return 0;
}

// Each annotated `let` initializer adopts its annotation's type (#240): the literal is born at
// that type rather than defaulting to i32. MLIR integers are signless, so `u*`/`i*` of a width
// share one constant type (e.g. `u8` and `i8` both print `: i8`).
// CHECK: module
// CHECK:   func.func @test_primitives() -> i32 {
// CHECK:     %c10_i8 = arith.constant 10 : i8
// CHECK:     %c20_i8 = arith.constant 20 : i8
// CHECK:     %c30_i16 = arith.constant 30 : i16
// CHECK:     %c40_i16 = arith.constant 40 : i16
// CHECK:     %c50_i32 = arith.constant 50 : i32
// CHECK:     %c60_i32 = arith.constant 60 : i32
// CHECK:     %c70_i64 = arith.constant 70 : i64
// CHECK:     %c80_i64 = arith.constant 80 : i64
// CHECK:     %c90_i128 = arith.constant 90 : i128
// CHECK:     %c100_i128 = arith.constant 100 : i128
// CHECK:     %cst = arith.constant 1.000000e+00 : f16
// CHECK:     %cst_0 = arith.constant 2.000000e+00 : bf16
// CHECK:     %cst_1 = arith.constant 3.000000e+00 : f32
// CHECK:     %cst_2 = arith.constant 4.000000e+00 : f64
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK: }
