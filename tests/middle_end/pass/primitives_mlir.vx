fn test_primitives() -> i32 {
  let a: u8 = 10;
  let b: i8 = 20;
  let c: u16 = 30;
  let d: i16 = 40;
  let e: u32 = 50;
  let f: i32 = 60;
  let g: u64 = 70;
  let h: i64 = 80;
  let i: u128 = 90;
  let j: i128 = 100;

  let x: f16 = 1.0;
  let y: bf16 = 2.0;
  let z: f32 = 3.0;
  let w: f64 = 4.0;

  return 0;
}

// CHECK: module {
// CHECK:   func.func @test_primitives() -> i32 {
// CHECK:     %c10_i32 = arith.constant 10 : i32
// CHECK:     %c20_i32 = arith.constant 20 : i32
// CHECK:     %c30_i32 = arith.constant 30 : i32
// CHECK:     %c40_i32 = arith.constant 40 : i32
// CHECK:     %c50_i32 = arith.constant 50 : i32
// CHECK:     %c60_i32 = arith.constant 60 : i32
// CHECK:     %c70_i32 = arith.constant 70 : i32
// CHECK:     %c80_i32 = arith.constant 80 : i32
// CHECK:     %c90_i32 = arith.constant 90 : i32
// CHECK:     %c100_i32 = arith.constant 100 : i32
// CHECK:     %cst = arith.constant 1.000000e+00 : f32
// CHECK:     %cst_0 = arith.constant 2.000000e+00 : f32
// CHECK:     %cst_1 = arith.constant 3.000000e+00 : f32
// CHECK:     %cst_2 = arith.constant 4.000000e+00 : f32
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK: }
