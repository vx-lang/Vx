// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: func.func @main() -> i32
// CHECK: func.return

fn main() -> i32 {
  let mut n = 0;
  let c = true;
  for i in 0..(if c { n = 3; n } else { 4 }) { }
  return n;
}
