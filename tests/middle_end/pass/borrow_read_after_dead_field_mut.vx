//===----------------------------------------------------------------------===//
// Non-regression for #276: reading a field after its `&mut p.x` borrow is dead
// must be accepted. NLL — `r`'s last use is `*r = 42`, so the mutable loan of
// `p.x` is dead by `return p.x`. The borrow-*creation* path already ran this
// dead-borrow sweep (bc5); the field-*access* check now does too, so the read
// no longer spuriously reports E4002 "Cannot access 'p' because it is mutably
// borrowed." The companion `borrow_use_after_mut.vx` (where the borrower is
// still live) must still be rejected.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: llvm.mlir.undef : !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: llvm.insertvalue %[[V0]], %{{.*}} : !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V1:.*]] = arith.constant 2 : i32
// CHECK: llvm.insertvalue %[[V1]], %{{.*}} : !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V2:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: %[[V3:.*]] = llvm.alloca %[[V2]] x !llvm.struct<"Point", (i32, i32)> : (i32) -> !llvm.ptr
// CHECK: llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Point", (i32, i32)>
// CHECK: arith.constant 42 : i32
// CHECK: llvm.load %[[V3]] : !llvm.ptr -> !llvm.struct<"Point", (i32, i32)>
// CHECK: %[[V4:.*]] = llvm.extractvalue %{{.*}} : !llvm.struct<"Point", (i32, i32)>
// CHECK: return %[[V4]] : i32

struct Point {
  x : i32,
  y : i32,
}

fn main() -> i32 {
  let mut p = Point {
    x : 1, y : 2
  };
  let r = &mut p.x;
  *r = 42;
  return p.x;
}
