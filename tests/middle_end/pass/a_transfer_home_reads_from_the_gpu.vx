//===----------------------------------------------------------------------===//
// A transfer to the CPU of a tensor in GPU memory must read it from the GPU. The type of the
// tensor says where it is, whatever made it: `uninit()`, `new()`, a `spawn` region or a
// parameter. The transfer then carries `source_topology = 500` (the GPU), and the program calls
// `vx_plugin_transfer_device_to_host` for each one. Without the mark it copies with the CPU,
// which reads GPU memory and crashes on a machine with a GPU. No GPU is needed to compile it.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s --action emit-llvm 2>&1 | FileCheck %s --check-prefix=CALL
// RUN: vxc %s --legacy-codegen --action emit-llvm 2>&1 | FileCheck %s --check-prefix=CALL
//
// CHECK-LABEL: func.func @from_uninit(
// CHECK: "vx.transfer"({{.*}}source_topology = 500 : i32, space = "CPU_DRAM"
// CHECK-LABEL: func.func @from_new(
// CHECK: "vx.transfer"({{.*}}source_topology = 500 : i32, space = "CPU_DRAM"
// CHECK-LABEL: func.func @from_a_spawn(
// CHECK: "vx.transfer"({{.*}}source_topology = 500 : i32, space = "CPU_DRAM"
// CHECK-LABEL: func.func @from_a_parameter(
// CHECK: "vx.transfer"({{.*}}source_topology = 500 : i32, space = "CPU_DRAM"
//
// CALL-COUNT-4: llvm.call @vx_plugin_transfer_device_to_host(
// CALL-NOT: llvm.call @vx_plugin_transfer_device_to_host(

fn from_uninit() -> f32 {
  let mut g = unsafe { Tensor<f32, [4], Memory::GPU_HBM>::uninit() };
  spawn on(Topology::GPU) {
    for i in 0..4 {
      g[i] = 1.0;
    }
  }
  let h = transfer(g, Memory::CPU_DRAM);
  return h[0];
}

fn from_new() -> f32 {
  let g = Tensor<f32, [4], Memory::GPU_HBM>::new();
  let h = transfer(g, Memory::CPU_DRAM);
  return h[0];
}

fn from_a_spawn() -> f32 {
  let g = spawn on(Topology::GPU) {
    let mut t = unsafe { Tensor<f32, [4], Memory::GPU_HBM>::uninit() };
    for i in 0..4 {
      t[i] = 2.0;
    }
    t
  };
  let h = transfer(g, Memory::CPU_DRAM);
  return h[0];
}

fn from_a_parameter(g : Tensor<f32, [4], Memory::GPU_HBM>) -> f32 {
  let h = transfer(g, Memory::CPU_DRAM);
  return h[0];
}

fn main() -> i32 {
  let p = Tensor<f32, [4], Memory::GPU_HBM>::new();
  print(from_uninit() + from_new() + from_a_spawn() + from_a_parameter(p));
  return 0;
}
