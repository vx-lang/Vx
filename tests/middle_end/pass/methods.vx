// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

struct Point {
  x : f32, y : f32
}

impl Point {
  fn distance(self : Point) -> f32 { return self.x + self.y; }
}

fn main() -> i32 {
  let p = Point{x : 3.0, y : 4.0};
  let d = p.distance();
  return 0;
}

// CHECK: module {
// CHECK:   func.func @Point_distance(%arg0: !llvm.struct<"Point", (f32, f32)>)
// -> f32 { CHECK:     %0 = llvm.extractvalue %arg0[0] : !llvm.struct<"Point",
// (f32, f32)> CHECK:     %1 = llvm.extractvalue %arg0[1] :
// !llvm.struct<"Point", (f32, f32)> CHECK:     %2 = arith.addf %0, %1 : f32
// CHECK:     return %2 : f32
// CHECK:   }
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     %0 = llvm.mlir.undef : !llvm.struct<"Point", (f32, f32)>
// CHECK:     %cst = arith.constant 3.000000e+00 : f32
// CHECK:     %1 = llvm.insertvalue %cst, %0[0] : !llvm.struct<"Point", (f32,
// f32)> CHECK:     %cst_0 = arith.constant 4.000000e+00 : f32 CHECK:     %2 =
// llvm.insertvalue %cst_0, %1[1] : !llvm.struct<"Point", (f32, f32)> CHECK: %3
// = call @Point_distance(%2) : (!llvm.struct<"Point", (f32, f32)>) -> f32
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK: }

