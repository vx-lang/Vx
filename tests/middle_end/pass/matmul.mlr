// RUN: vxc %s -o %t.mlir
// RUN: FileCheck %s < %t.mlir

fn my_matmul(a: Tensor<f32, [128, 64]>, b: Tensor<f32, [64, 256]>) -> Tensor<f32, [128, 256]> {
    let c = a @ b;
    return c;
}


fn main() -> i32 {
    let a: Tensor<f32, [128, 64]> = 1.0;
    let b: Tensor<f32, [64, 256]> = 1.0;
    my_matmul(a, b);
    return 0;
}

// CHECK: module
// CHECK:   func.func @my_matmul(%arg0: memref<128x64xf32>, %arg1: memref<64x256xf32>) -> memref<128x256xf32> {
// CHECK:     %alloc = memref.alloc() : memref<128x256xf32>
// CHECK:     %cst = arith.constant 0.000000e+00 : f32
// CHECK:     linalg.fill ins(%cst : f32) outs(%alloc : memref<128x256xf32>)
// CHECK:     linalg.matmul ins(%arg0, %arg1 : memref<128x64xf32>, memref<64x256xf32>) outs(%alloc : memref<128x256xf32>)
// CHECK:     return %alloc : memref<128x256xf32>
// CHECK:   }
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     %cst = arith.constant 1.000000e+00 : f32
// CHECK:     %cst_0 = arith.constant 1.000000e+00 : f32
// CHECK:     %0 = builtin.unrealized_conversion_cast %cst : f32 to memref<128x64xf32>
// CHECK:     %1 = builtin.unrealized_conversion_cast %cst_0 : f32 to memref<64x256xf32>
// CHECK:     %2 = call @my_matmul(%0, %1) : (memref<128x64xf32>, memref<64x256xf32>) -> memref<128x256xf32>
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK: }
