// RUN: vxc %s -o %t.mlir
// RUN: FileCheck %s < %t.mlir

fn my_matmul(a: Tensor<f32, [128, 64]>, b: Tensor<f32, [64, 256]>) -> Tensor<f32, [128, 256]> {
    let c = a * b;
    return c;
}


fn main() -> i32 {
    let a: Tensor<f32, [128, 64]> = 1.0;
    let b: Tensor<f32, [64, 256]> = 1.0;
    my_matmul(a, b);
    return 0;
}

// CHECK: "builtin.module"() ({
// CHECK:   "func.func"() <{function_type = (memref<128x64xf32>, memref<64x256xf32>) -> memref<128x256xf32>, sym_name = "my_matmul"}> ({
// CHECK:   ^bb0(%arg0: memref<128x64xf32>, %arg1: memref<64x256xf32>):
// CHECK:     %4 = "memref.alloc"() <{operandSegmentSizes = array<i32: 0, 0>}> : () -> memref<128x256xf32>
// CHECK:     %5 = "arith.constant"() <{value = 0.000000e+00 : f32}> : () -> f32
// CHECK:     "linalg.fill"(%5, %4) <{operandSegmentSizes = array<i32: 0, 0>}> ({
// CHECK:     }) : (f32, memref<128x256xf32>) -> ()
// CHECK:     "linalg.matmul"(%arg0, %arg1, %4) <{operandSegmentSizes = array<i32: 0, 0>}> ({
// CHECK:     }) : (memref<128x64xf32>, memref<64x256xf32>, memref<128x256xf32>) -> ()
// CHECK:     "func.return"(%4) : (memref<128x256xf32>) -> ()
// CHECK:   }) : () -> ()
// CHECK:   "func.func"() <{function_type = () -> i32, sym_name = "main"}> ({
// CHECK:     %0 = "arith.constant"() <{value = 1.000000e+00 : f32}> : () -> f32
// CHECK:     %1 = "arith.constant"() <{value = 1.000000e+00 : f32}> : () -> f32
// CHECK:     %2 = "func.call"(%0, %1) <{callee = @my_matmul}> : (f32, f32) -> memref<128x256xf32>
// CHECK:     %3 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK:     "func.return"(%3) : (i32) -> ()
// CHECK:   }) {llvm.emit_c_interface} : () -> ()
// CHECK: }) : () -> ()
