// RUN: vxc %s -o %t.mlir
// RUN: FileCheck %s < %t.mlir

fn process_tensor(val: Tensor<f32, [128, 128]>) -> Tensor<f32, [4, 64, 64]> {
  // 128 * 128 = 16384
  // 2 * 64 * 2 * 64 = 16384
  let temp = val.reshape([2, 64, 2, 64]);

  // 0, 2, 1, 3 permutation is valid for 4-dimensional tensor
  let permuted = temp.transpose([0, 2, 1, 3]);

  let final_view = permuted.reshape([4, 64, 64]);
  return final_view;
}

// CHECK: func.func @process_tensor(%arg0: memref<128x128xf32>) -> memref<4x64x64xf32> {
// CHECK: %cast = memref.cast %
// CHECK: %cast_0 = memref.cast %
// CHECK: %cast_1 = memref.cast %
// CHECK: %cast_2 = memref.cast %
// CHECK: %cast_3 = memref.cast %
// CHECK: %cast_4 = memref.cast %
// CHECK: return %

fn main() -> i32 {
  let v: Tensor<f32, [128, 128]> = 1.0;
  process_tensor(v);
  return 0;
}


// FRONTEND-LABEL: module {
// FRONTEND: func.func @test_f32() -> i32
// FRONTEND: memref.alloc
