// RUN: vxc %s -o %t.mlir
// RUN: FileCheck %s < %t.mlir

fn process_tensor(val: Tensor<f32, [128, 128]>) -> Tensor<f32, [4, 64, 64]> {
  // 128 * 128 = 16384
  // 2 * 64 * 2 * 64 = 16384
  let temp = val.reshape([2, 64, 2, 64]);

  // 0, 2, 1, 3 permutation is valid for 4-dimensional tensor
  let permuted = temp.transpose([0, 2, 1, 3]);

  let final_view = permuted.reshape([4, 64, 64]);
  return final_view;
}

// CHECK: "func.func"() <{function_type = (memref<128x128xf32>) -> memref<4x64x64xf32>, sym_name = "process_tensor"}> ({
// CHECK: "memref.cast"(%
// CHECK: "memref.cast"(%
// CHECK: "memref.cast"(%
// CHECK: "memref.cast"(%
// CHECK: "memref.cast"(%
// CHECK: "memref.cast"(%
// CHECK: "func.return"(%

fn main() -> i32 {
  let v: Tensor<f32, [128, 128]> = 1.0;
  process_tensor(v);
  return 0;
}
