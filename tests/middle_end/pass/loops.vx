// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
// CHECK: memref.alloca()
// CHECK: cf.cond_br
// CHECK: memref.store
// CHECK: return

fn test_loop(a : Tensor<f32, [10, 10]>, b : Tensor<f32, [10, 10]>) -> Tensor<f32, [10, 10]> {
  let mut result = Tensor<f32, [10, 10]>::uninit();
  for i in 0..10 {
    result[i][i] = a[i][i] * b[i][i];
  }
  return result;
}
