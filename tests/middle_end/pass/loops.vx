// CHECK: memref.alloca()
// CHECK: scf.for
// CHECK: memref.store
// CHECK: return

fn test_loop(a : Tensor, b : Tensor) -> Tensor {
  let mut result = Tensor<f32>([ 10, 10 ]);
  for
  i in 0..10 { result[i][i] = a[i][i] * b[i][i]; }
  return result;
}

