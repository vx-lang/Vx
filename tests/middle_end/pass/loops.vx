// CHECK: "memref.alloca"
// CHECK: "affine.for"
// CHECK: "memref.store"
// CHECK: "func.return"

fn test_loop(a: Tensor, b: Tensor) -> Tensor {
  let mut result = Tensor([10, 10]);
  for i in 0..10 {
    result[i][i] = a[i][i] * b[i][i];
  }
  return result;
}
