// Sibling sub-spaces (docs/discussions/implementation_plans/subspace_scheduling.md §2.3): SMEM
// and TMEM are B200's per-SM on-chip memories -- physically distinct peers, neither inside the
// other -- so both are declared `within: Memory::GPU_HBM` (siblings, not nested). The example
// stages a tile into each, then moves tiles *between* the sub-spaces:
//
//   - Independent schedules: each sub-space has its own granule-rounded bump allocator, so SMEM
//     and TMEM both start at offset 0.
//   - Same-space move (`ta -> TMEM`, `sa -> SMEM`): a fresh slot in the same space, no cost (no
//     data actually moves off the space).
//   - Sibling lateral (`ta -> SMEM`): there is no direct SMEM<->TMEM edge, so the move routes
//     through their nearest common ancestor GPU_HBM and is costed on *both* legs --
//     16384/256 (TMEM) + 16384/128 (SMEM) = 192 cycles.
//
// A 64x64 f32 tile is 64*64*4 = 16384 B = exactly one 16 KB granule (slots = 1). `ta` is read
// twice (these staged tiles are not linear).
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

Memory GPU_HBM {
  capacity: 40 GiB, bandwidth: 3 TB/s
}
Memory SMEM {
  within: Memory::GPU_HBM, capacity: 228 KiB, bandwidth: 128 B/cyc, granule: 16 KiB, scope: sm
}
Memory TMEM {
  within: Memory::GPU_HBM, capacity: 256 KiB, bandwidth: 256 B/cyc, granule: 16 KiB, scope: sm
}

fn main() -> i32 {
  let a = Tensor<f32, [64, 64]>::uninit();
  let b = Tensor<f32, [64, 64]>::uninit();

  // Stage one tile into each sibling from the host.
  let sa = transfer(a, Memory::SMEM); // CPU -> SMEM: offset 0
  let ta = transfer(b, Memory::TMEM); // CPU -> TMEM: independent cursor, also offset 0

  // Move between sub-spaces.
  let tt = transfer(ta, Memory::TMEM); // ta -> TMEM : same space, bumps to 16384
  let ts = transfer(ta, Memory::SMEM); // ta -> SMEM : sibling lateral via GPU_HBM, cost 192
  let ss = transfer(sa, Memory::SMEM); // sa -> SMEM : same space, bumps to 32768
  return 0;
}

// sa: CPU -> SMEM, offset 0.
// CHECK: vx.transfer
// CHECK: offset = 0 : i64
// CHECK: space = "SMEM"
// ta: CPU -> TMEM, its own cursor, also offset 0.
// CHECK: vx.transfer
// CHECK: offset = 0 : i64
// CHECK: space = "TMEM"
// tt: ta -> TMEM (same space) -> TMEM's cursor bumps to 16384.
// CHECK: vx.transfer
// CHECK: offset = 16384 : i64
// CHECK: space = "TMEM"
// ts: ta -> SMEM (sibling lateral) -> routed via GPU_HBM, costed on both legs.
// CHECK: vx.transfer
// i64, not i32: a `B/s` seam is costed in picoseconds and overflows i32 at 4.3 ms. Both legs here
// are `B/cyc`, so the value is unaffected -- 16384/256 + 16384/128 = 192 cycles.
// CHECK: cost = 192 : i64
// CHECK: offset = 16384 : i64
// CHECK: space = "SMEM"
// ss: sa -> SMEM (same space) -> SMEM's cursor bumps to 32768.
// CHECK: vx.transfer
// CHECK: offset = 32768 : i64
// CHECK: space = "SMEM"
