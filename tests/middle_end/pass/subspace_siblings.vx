// Sibling sub-spaces (docs/discussions/implementation_plans/subspace_scheduling.md): SMEM and
// TMEM are B200's per-SM on-chip memories -- physically distinct peers, neither inside the other
// -- so both are declared `within: Memory::GPU_HBM` (siblings, not nested). Each sub-space has
// its *own* granule-rounded bump allocator, so their `offset`s are independent: interleaving
// transfers into SMEM and TMEM, both still start at offset 0 and bump only within their own space.
//
// A 64x64 f32 tile is 64*64*4 = 16384 B = exactly one 16 KB granule (slots = 1).
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

Memory GPU_HBM {
  capacity: 40 GB, bandwidth: 3 TB/s
}
Memory SMEM {
  within: Memory::GPU_HBM, capacity: 228 KB, granule: 16 KB, scope: sm
}
Memory TMEM {
  within: Memory::GPU_HBM, capacity: 256 KB, granule: 16 KB, scope: sm
}

fn main() -> i32 {
  let a = Tensor<f32>([64, 64]);
  let b = Tensor<f32>([64, 64]);
  let c = Tensor<f32>([64, 64]);
  let d = Tensor<f32>([64, 64]);

  // Interleave the two siblings to show the cursors are independent.
  let sa = transfer(a, Memory::SMEM); // SMEM: offset 0
  let ta = transfer(c, Memory::TMEM); // TMEM: offset 0 (its own cursor, also 0)
  let sb = transfer(b, Memory::SMEM); // SMEM: offset 16384 (unaffected by the TMEM transfer)
  let tb = transfer(d, Memory::TMEM); // TMEM: offset 16384
  return 0;
}

// Both siblings live under GPU_HBM; each has its own bump allocator.
// SMEM tile 1 -> offset 0.
// CHECK: vx.transfer
// CHECK: offset = 0 : i64
// CHECK: space = "SMEM"
// CHECK: within = "GPU_HBM"
// TMEM tile 1 -> independent cursor, also offset 0.
// CHECK: vx.transfer
// CHECK: offset = 0 : i64
// CHECK: space = "TMEM"
// CHECK: within = "GPU_HBM"
// SMEM tile 2 -> bumped to 16384, not disturbed by the TMEM transfer between.
// CHECK: vx.transfer
// CHECK: offset = 16384 : i64
// CHECK: space = "SMEM"
// TMEM tile 2 -> 16384.
// CHECK: vx.transfer
// CHECK: offset = 16384 : i64
// CHECK: space = "TMEM"
