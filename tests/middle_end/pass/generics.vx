// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// Generic function with implicit type deduction
fn process<T>(val : T) -> T {
  return val;
}

fn main() -> Tensor<i32> {
  let t1 : Tensor<f32> = 1;
  let t2 : Tensor<i32> = 2;

  // Instantiate process twice, once with f32, once with i32
  let res1 = process(t1);
  let res2 = process(t2);

  return res2;
}

// CHECK: module
// CHECK:   func.func @process$Tensor$f32$0(%arg0: memref<?x?xf32>) ->
// memref<?x?xf32> { CHECK:     return %arg0 : memref<?x?xf32> CHECK:   } CHECK:
// func.func @process_TensorI32_(%arg0: memref<?x?xi32>) -> memref<?x?xi32> {
// CHECK:     return %arg0 : memref<?x?xi32>
// CHECK:   }
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %c2_i32 = arith.constant 2 : i32
// CHECK:     %0 = builtin.unrealized_conversion_cast %c1_i32 : i32 to
// memref<?x?xf32> CHECK:     %1 = call @process$Tensor$f32$0(%0) :
// (memref<?x?xf32>) -> memref<?x?xf32> CHECK:     %2 =
// builtin.unrealized_conversion_cast %c2_i32 : i32 to memref<?x?xi32> CHECK:
// call @process_TensorI32_ CHECK: arith.constant 0 : i32 CHECK: return CHECK: }

// FRONTEND-LABEL: module {
// FRONTEND: func.func @test_f32() -> i32
// FRONTEND: memref.alloc

// MLIR-LABEL: module {
// MLIR: func.func @test_f32() -> i32

// LLVM-LABEL: module {
// LLVM: llvm.func @test_f32() -> i32
