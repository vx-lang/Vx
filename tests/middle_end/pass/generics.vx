// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s

// Generic function with implicit type deduction
fn process<T>(val : T) -> T {
  return val;
}

fn main() -> i32 {
  let t1 : Tensor<f32, []> = 1.0;
  let t2 : Tensor<i32, []> = 2;

  // Instantiate process twice, once with f32, once with i32
  let res1 = process(t1);
  let res2 = process(t2);

  return 0;
}

// One monomorph per element type, each over a rank-0 buffer. The value reaching them is a
// real memref<f32> rather than a scalar cast into a rank-2 memref (Vx#396, Vx#399).
// CHECK-LABEL: func.func @process$Tensor$f32(%arg0: memref<f32>) -> memref<f32> {
// CHECK: %[[V:.*]] = memref.load %arg0[] : memref<f32>
// CHECK: %[[OUT:.*]] = memref.alloc() : memref<f32>
// CHECK: linalg.fill ins(%[[V]] : f32) outs(%[[OUT]] : memref<f32>)
// CHECK: return %[[OUT]] : memref<f32>
// CHECK-LABEL: func.func @process$Tensor$i32(%arg0: memref<i32>) -> memref<i32> {
// CHECK: return %{{.*}} : memref<i32>
// CHECK-LABEL: func.func @main() -> i32 {
// CHECK: call @process$Tensor$f32(%{{.*}}) : (memref<f32>) -> memref<f32>
// CHECK: call @process$Tensor$i32(%{{.*}}) : (memref<i32>) -> memref<i32>
