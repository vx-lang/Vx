// RUN: vxc %s | FileCheck %s

// Generic function with implicit type deduction
fn process<T>(val: T) -> T {
  return val;
}

fn main() -> Tensor<i32> {
  let t1: Tensor<f32> = 1;
  let t2: Tensor<i32> = 2;

  // Instantiate process twice, once with f32, once with i32
  let res1 = process(t1);
  let res2 = process(t2);

  return res2;
}

// CHECK: "builtin.module"() ({
// CHECK:   "func.func"() <{function_type = (memref<?x?xf32>) -> memref<?x?xf32>, sym_name = "process_TensorF32_"}> ({
// CHECK:   ^bb0(%arg1: memref<?x?xf32>):
// CHECK:     "func.return"(%arg1) : (memref<?x?xf32>) -> ()
// CHECK:   }) : () -> ()
// CHECK:   "func.func"() <{function_type = (memref<?x?xi32>) -> memref<?x?xi32>, sym_name = "process_TensorI32_"}> ({
// CHECK:   ^bb0(%arg0: memref<?x?xi32>):
// CHECK:     "func.return"(%arg0) : (memref<?x?xi32>) -> ()
// CHECK:   }) : () -> ()
// CHECK:   "func.func"() <{function_type = () -> i32, sym_name = "main"}> ({
// CHECK:     %0 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// CHECK:     %1 = "arith.constant"() <{value = 2 : i32}> : () -> i32
// CHECK:     %2 = "func.call"(%0) <{callee = @process_TensorF32_}> : (i32) -> memref<?x?xf32>
// CHECK:     %3 = "func.call"(%1) <{callee = @process_TensorI32_}> : (i32) -> memref<?x?xi32>
// CHECK:     "func.return"(%3) : (memref<?x?xi32>) -> ()
// CHECK:   }) {llvm.emit_c_interface} : () -> ()
// CHECK: }) : () -> ()
