// `nn_top_k_long` on rows of different kinds. A line says `ok` when, in each row, the positions
// are k different positions of the row, and the last chosen score comes before the first score
// that is not chosen: the larger score first, and of two equal scores the lower position. A row
// with k scores or fewer must get its positions and then -1. The rows start at different places
// and have different lengths.
//
// The first run uses the Apple GPU on a Mac, and the CPU copy of each kernel elsewhere. The
// second run uses the CPU copy everywhere.
//
// RUN: vxc %s --host default --machine fleet/m4-uma.vx | FileCheck %s
// RUN: env VX_METAL=0 vxc %s --host default --machine fleet/m4-uma.vx | FileCheck %s
//
// CHECK: {{^}}random, 32768 of 2048: ok{{$}}
// CHECK-NEXT: {{^}}all equal, 32768 of 2048: ok{{$}}
// CHECK-NEXT: {{^}}close to 1, 32768 of 2048: ok{{$}}
// CHECK-NEXT: {{^}}few values, 20000 of 2048: ok{{$}}
// CHECK-NEXT: {{^}}NaN and zeros, 5000 of 2000: ok{{$}}
// CHECK-NEXT: {{^}}NaN and zeros, 1000 of 900: ok{{$}}
// CHECK-NEXT: {{^}}short rows, 1000 of 2048: ok{{$}}
// CHECK-NEXT: {{^}}k of k + 1: ok{{$}}
// CHECK-NEXT: {{^}}1 of 3000: ok{{$}}
import core::convert;
import core::num;
import std::nn;

fn mix(x : u32) on Topology::Any -> u32
ensures writes_only()
{
  let mut h = x * 2654435761u32;
  h = h ^ (h >> 15u32);
  h = h * 2246822519u32;
  h = h ^ (h >> 13u32);
  return h;
}

// A value in [-1, 1) for index i of the random row `seed`.
fn random(seed : u32, i : i32) on Topology::Any -> f32
ensures writes_only()
{
  return ((mix(seed * 7919u32 + (i as u32)) >> 8u32) as f32) * 0.00000011920929 - 1.0;
}

// Whether score x at position i comes before score y at position j: the larger score first, and
// of two equal scores the lower position. A NaN comes after every number.
fn before(x : f32, i : i32, y : f32, j : i32) -> bool {
  if x != x {
    return y != y && i < j;
  }
  if y != y {
    return true;
  }
  return x > y || (x == y && i < j);
}

// The score at position i of row r of each kind of test.
fn score(kind : i32, r : i32, i : i32) -> f32 {
  let x = random((r + 1) as u32, i);
  if kind == 0 {
    return x * 4.0;
  }
  if kind == 1 {
    // All equal.
    return 1.5;
  }
  if kind == 2 {
    // Close to 1, so most keys agree in their top 3 bytes.
    return 1.0 + x * 0.00001;
  }
  if kind == 3 {
    // Few values: many equal scores.
    return f32::floor(x * 8.0);
  }
  // NaN, infinities and both zeros among the numbers.
  let m = i % 7;
  if m == 0 {
    return 0.0 / 0.0;
  }
  if m == 1 {
    return -0.0;
  }
  if m == 2 {
    return 0.0;
  }
  if m == 3 {
    return -1.0 / 0.0;
  }
  if m == 4 && i % 3 == 0 {
    return 1.0 / 0.0;
  }
  return x;
}

fn check(name : *const i8, kind : i32, rows : i32, width : i32, k : i32) -> void {
  let mut hs = Tensor<f32>([rows, width]);
  let mut hstart = Tensor<i32>([rows]);
  let mut hlen = Tensor<i32>([rows]);
  for r in 0..rows {
    // Row r starts at 3 * r and is shorter by 8 * r, so the rows are ragged.
    hstart[r] = 3 * r;
    hlen[r] = width - 8 * r;
    for i in 0..width {
      hs[r][i] = score(kind, r, i - 3 * r);
    }
  }
  let scores = transfer(hs, Memory::HBM);
  let starts = transfer(hstart, Memory::HBM);
  let lengths = transfer(hlen, Memory::HBM);
  let mut ids = transfer(Tensor<i32>([rows, k]), Memory::HBM);
  nn_top_k_long(&mut ids, &scores, &starts, &lengths, rows, k);
  let hi = transfer(&ids, Memory::CPU_DRAM);
  let hs2 = transfer(&scores, Memory::CPU_DRAM);
  let mut ok = true;
  for r in 0..rows {
    let n = hlen[r];
    let s = hstart[r];
    let mut chosen = Tensor<i32>([n]);
    for i in 0..n {
      chosen[i] = 0;
    }
    let want = k.min(n);
    for j in 0..k {
      let p = hi[r][j];
      if j < want {
        if p < 0 || p >= n || chosen[p] != 0 {
          ok = false;
        } else {
          chosen[p] = 1;
        }
      } else if p != -1 {
        ok = false;
      }
    }
    if ok && want < n {
      // The last chosen score must come before the first score that is not chosen.
      let mut worst = -1;
      let mut best = -1;
      for i in 0..n {
        if chosen[i] != 0 {
          if worst < 0 || before(hs2[r][s + worst], worst, hs2[r][s + i], i) {
            worst = i;
          }
        } else {
          if best < 0 || before(hs2[r][s + i], i, hs2[r][s + best], best) {
            best = i;
          }
        }
      }
      if !before(hs2[r][s + worst], worst, hs2[r][s + best], best) {
        ok = false;
      }
    }
  }
  if ok {
    println!("{}: ok", name);
  } else {
    println!("{}: wrong positions", name);
  }
  return;
}

fn main() -> i32 {
  check("random, 32768 of 2048", 0, 3, 32768, 2048);
  check("all equal, 32768 of 2048", 1, 2, 32768, 2048);
  check("close to 1, 32768 of 2048", 2, 2, 32768, 2048);
  check("few values, 20000 of 2048", 3, 2, 20000, 2048);
  // The k-th largest score is a zero here, and a NaN in the next line.
  check("NaN and zeros, 5000 of 2000", 4, 2, 5000, 2000);
  check("NaN and zeros, 1000 of 900", 4, 2, 1000, 900);
  check("short rows, 1000 of 2048", 0, 2, 1000, 2048);
  check("k of k + 1", 0, 1, 9, 8);
  check("1 of 3000", 0, 2, 3000, 1);
  return 0;
}
