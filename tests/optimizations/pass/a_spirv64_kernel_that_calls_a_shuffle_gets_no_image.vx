//===----------------------------------------------------------------------===//
// A region for an Intel GPU (`arch: spirv64`) calls `shfl_down`, which holds a
// `gpu.shuffle`. The SPIR-V image inlines the function, and a shuffle needs
// subgroups of 32 lanes, which a SPIR-V kernel cannot ask for yet. So the
// region gets no image, and the warning says why.
//
// RUN: vxc %s --action emit-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: the region placed on `Topology::Simd` in `main` (kernel `{{[a-z0-9_]+}}`) cannot become a `spirv64` device image: it shuffles values between the lanes of a subgroup (`gpu.shuffle`)

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 8 GiB, bandwidth: 400 GB/s, managed: cached, scope: device
}
Topology Simd {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 60 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 60 GB/s
}

fn shfl_down(v : f32, delta : i32) on Topology::Simd -> f32 {
  return mlir!( inputs : (%v = v : f32, %d = delta : i32), returns : f32, dialects : ["gpu", "arith"]) {
    %w = "arith.constant"() {
      value = 32 : i32
    } : () -> i32
    %r, %ok = gpu.shuffle down %v, %d, %w : f32
    macro.yield %r : f32
  };
}

fn main() -> i32 {
  let mut x = Tensor<f32, [32]>::fill(1.0);
  spawn on(Topology::Simd) {
    for i in 0..32 {
      x[i] = shfl_down(x[i], 16);
    }
  }
  print(x[0] as i32);
  return 0;
}
