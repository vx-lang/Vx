// RUN: vxc %s --action emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,gpu-kernel-outlining)" | FileCheck %s

fn dummy() -> Tensor<f32> {
  return 0.0;
}

fn process(t: Tensor<f32>) -> Tensor<f32> {
  let mut t_device = t.to_device();
  spawn on (Topology::NPU[0]) {
    dummy();
  }
  return t;
}

// Check for the host kernel launch
// CHECK: gpu.launch_func

// Check for the generated device module
// CHECK: gpu.module
// CHECK: gpu.func
// CHECK: gpu.return
