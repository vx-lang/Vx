// LLVM:     gpu.launch_func  @process_kernel::@process_kernel blocks in (%1, %1, %1) threads in (%1, %1, %1) : i64 args(%c0_i32 : i32)
// LLVM:     %43 = llvm.extractvalue %19[0] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
