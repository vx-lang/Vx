// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,gpu-kernel-outlining)" | FileCheck %s --check-prefix=GPU
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,gpu-kernel-outlining,gpu-to-llvm,reconcile-unrealized-casts)" | FileCheck %s --check-prefix=LLVM

fn dummy(x: i32) -> i32 {
  return x*2+1;
}

fn process(t: Tensor<f32>) -> Tensor<f32> {
  let mut t_device = t.to_device();
  spawn on (Topology::NPU[0]) {
    dummy(0);
  }
  return t;
}

// 1. Check for the frontend emission of vx.spawn

// 2. Check for the GPU dialect lowering

// 3. Check for the LLVM dialect lowering

// FRONTEND: module {
// FRONTEND:   func.func private @printMemrefF32(memref<*xf32>)
// FRONTEND:   func.func private @printMemrefF64(memref<*xf64>)
// FRONTEND:   func.func private @printMemrefI32(memref<*xi32>)
// FRONTEND:   func.func private @printMemrefI64(memref<*xi64>)
// FRONTEND:   func.func private @printMemrefBF16(memref<*xbf16>)
// FRONTEND:   func.func @dummy(%arg0: i32) -> i32 {
// FRONTEND:     return %arg0 : i32
// FRONTEND:   }
// FRONTEND:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// FRONTEND:     %0 = "vx.transfer"(%arg0) <{target_topology = 100 : i32}> : (memref<?x?xf32>) -> memref<?x?xf32, 1>
// FRONTEND:     %alloca = memref.alloca() : memref<memref<?x?xf32, 1>>
// FRONTEND:     memref.store %0, %alloca[] : memref<memref<?x?xf32, 1>>
// FRONTEND:     vx.spawn topology(100) {
// FRONTEND:       %c0_i32 = arith.constant 0 : i32
// FRONTEND:       %1 = func.call @dummy(%c0_i32) : (i32) -> i32
// FRONTEND:       vx.yield
// FRONTEND:     }
// FRONTEND:     return %arg0 : memref<?x?xf32>
// FRONTEND:   }
// FRONTEND: }

// GPU: module attributes {gpu.container_module} {
// GPU:   func.func private @printMemrefF32(memref<*xf32>)
// GPU:   func.func private @printMemrefF64(memref<*xf64>)
// GPU:   func.func private @printMemrefI32(memref<*xi32>)
// GPU:   func.func private @printMemrefI64(memref<*xi64>)
// GPU:   func.func private @printMemrefBF16(memref<*xbf16>)
// GPU:   func.func @dummy(%arg0: i32) -> i32 {
// GPU:     return %arg0 : i32
// GPU:   }
// GPU:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// GPU:     %c1 = arith.constant 1 : index
// GPU:     %c0_i32 = arith.constant 0 : i32
// GPU:     %c0 = arith.constant 0 : index
// GPU:     %dim = memref.dim %arg0, %c0 : memref<?x?xf32>
// GPU:     %dim_0 = memref.dim %arg0, %c1 : memref<?x?xf32>
// GPU:     %alloc = memref.alloc(%dim, %dim_0) : memref<?x?xf32, 1>
// GPU:     memref.copy %arg0, %alloc : memref<?x?xf32> to memref<?x?xf32, 1>
// GPU:     %alloca = memref.alloca() : memref<memref<?x?xf32, 1>>
// GPU:     memref.store %alloc, %alloca[] : memref<memref<?x?xf32, 1>>
// GPU:     gpu.launch_func  @process_kernel::@process_kernel blocks in (%c1, %c1, %c1) threads in (%c1, %c1, %c1)  args(%c0_i32 : i32)
// GPU:     %memspacecast = memref.memory_space_cast %alloc : memref<?x?xf32, 1> to memref<?x?xf32>
// GPU:     memref.dealloc %memspacecast : memref<?x?xf32>
// GPU:     return %arg0 : memref<?x?xf32>
// GPU:   }
// GPU:   gpu.module @process_kernel {
// GPU:     gpu.func @process_kernel(%arg0: i32) kernel attributes {known_block_size = array<i32: 1, 1, 1>, known_grid_size = array<i32: 1, 1, 1>} {
// GPU:       %block_id_x = gpu.block_id  x
// GPU:       %block_id_y = gpu.block_id  y
// GPU:       %block_id_z = gpu.block_id  z
// GPU:       %thread_id_x = gpu.thread_id  x
// GPU:       %thread_id_y = gpu.thread_id  y
// GPU:       %thread_id_z = gpu.thread_id  z
// GPU:       %grid_dim_x = gpu.grid_dim  x
// GPU:       %grid_dim_y = gpu.grid_dim  y
// GPU:       %grid_dim_z = gpu.grid_dim  z
// GPU:       %block_dim_x = gpu.block_dim  x
// GPU:       %block_dim_y = gpu.block_dim  y
// GPU:       %block_dim_z = gpu.block_dim  z
// GPU:       %0 = func.call @dummy(%arg0) : (i32) -> i32
// GPU:       gpu.return
// GPU:     }
// GPU:     func.func @dummy(%arg0: i32) -> i32 {
// GPU:       return %arg0 : i32
// GPU:     }
// GPU:   }
// GPU: }

// LLVM: module attributes {gpu.container_module} {
// LLVM:   llvm.func @free(!llvm.ptr)
// LLVM:   llvm.func @malloc(i64) -> !llvm.ptr
// LLVM:   func.func private @printMemrefF32(memref<*xf32>)
// LLVM:   func.func private @printMemrefF64(memref<*xf64>)
// LLVM:   func.func private @printMemrefI32(memref<*xi32>)
// LLVM:   func.func private @printMemrefI64(memref<*xi64>)
// LLVM:   func.func private @printMemrefBF16(memref<*xbf16>)
// LLVM:   func.func @dummy(%arg0: i32) -> i32 {
// LLVM:     return %arg0 : i32
// LLVM:   }
// LLVM:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// LLVM:     %0 = builtin.unrealized_conversion_cast %arg0 : memref<?x?xf32> to !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)>
// LLVM:     %c1 = arith.constant 1 : index
// LLVM:     %1 = builtin.unrealized_conversion_cast %c1 : index to i64
// LLVM:     %c0_i32 = arith.constant 0 : i32
// LLVM:     %c0 = arith.constant 0 : index
// LLVM:     %2 = llvm.extractvalue %0[3, 0] : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %3 = llvm.extractvalue %0[3, 1] : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %4 = llvm.mlir.constant(1 : index) : i64
// LLVM:     %5 = llvm.mul %3, %2 : i64
// LLVM:     %6 = llvm.mlir.zero : !llvm.ptr
// LLVM:     %7 = llvm.getelementptr %6[%5] : (!llvm.ptr, i64) -> !llvm.ptr, f32
// LLVM:     %8 = llvm.ptrtoint %7 : !llvm.ptr to i64
// LLVM:     %9 = llvm.call @malloc(%8) : (i64) -> !llvm.ptr
// LLVM:     %10 = llvm.addrspacecast %9 : !llvm.ptr to !llvm.ptr<1>
// LLVM:     %11 = llvm.mlir.poison : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)>
// LLVM:     %12 = llvm.insertvalue %10, %11[0] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %13 = llvm.insertvalue %10, %12[1] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %14 = llvm.mlir.constant(0 : index) : i64
// LLVM:     %15 = llvm.insertvalue %14, %13[2] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %16 = llvm.insertvalue %2, %15[3, 0] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %17 = llvm.insertvalue %3, %16[3, 1] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %18 = llvm.insertvalue %3, %17[4, 0] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %19 = llvm.insertvalue %4, %18[4, 1] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %20 = llvm.mlir.constant(1 : index) : i64
// LLVM:     %21 = llvm.extractvalue %0[3, 0] : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %22 = llvm.mul %20, %21 : i64
// LLVM:     %23 = llvm.extractvalue %0[3, 1] : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %24 = llvm.mul %22, %23 : i64
// LLVM:     %25 = llvm.mlir.zero : !llvm.ptr
// LLVM:     %26 = llvm.getelementptr %25[1] : (!llvm.ptr) -> !llvm.ptr, f32
// LLVM:     %27 = llvm.ptrtoint %26 : !llvm.ptr to i64
// LLVM:     %28 = llvm.mul %24, %27 : i64
// LLVM:     %29 = llvm.extractvalue %0[1] : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %30 = llvm.extractvalue %0[2] : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %31 = llvm.getelementptr %29[%30] : (!llvm.ptr, i64) -> !llvm.ptr, f32
