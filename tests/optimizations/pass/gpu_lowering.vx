// LLVM:     %33 = llvm.extractvalue %19[2] : !llvm.struct<(ptr<1>, ptr<1>, i64, array<2 x i64>, array<2 x i64>)> 
// LLVM:     %34 = llvm.getelementptr %32[%33] : (!llvm.ptr<1>, i64) -> !llvm.ptr<1>, f32
// LLVM:     "llvm.intr.memcpy"(%34, %31, %28) <{isVolatile = false}> : (!llvm.ptr<1>, !llvm.ptr, i64) -> ()
