// RUN: vxc %s --action emit-mlir -X mlir=--pass-pipeline="builtin.module(func.func(convert-linalg-to-affine-loops),func.func(affine-loop-unroll{unroll-factor=4}),func.func(affine-super-vectorize{virtual-vector-size=16}))"

fn test_vectorize(a: Tensor<f32, [16, 16]>, b: Tensor<f32, [16, 16]>) -> Tensor<f32, [16, 16]> {
  return a + b;
}

// CHECK: func.func @test_vectorize
