//===----------------------------------------------------------------------===//
// A tile of sums in `Memory::REG`, with a row for each subgroup, stays in the registers of the
// tensor cores. Both code generators give `acc` a stack slot marked `vx.registers`, and the loops
// of subgroups stay loops, with one matmul in each kernel. `in_registers` is `a_in_hbm` of lane_matmuls_of_a_tile_in_hbm_give_the_sums.vx
// with `acc` in registers, so it prints the same values. With no GPU, the kernels run on the CPU.
//
// The rows of `acc` in `too_large_for_shared_memory` take 256 KB, more than the shared memory of
// the H200. In registers they take 512 bytes of each lane. The PTX has shared memory only for `sa`
// and `sb`, and no local memory. In `in_registers`, the lanes load `a` from HBM into the registers
// of `mma.sync`, and store their sums from registers straight to HBM.
//
// A GPU without `mma.sync` (`sm_75`) cannot keep `acc` in registers, and the lowering refuses it.
//
// RUN: vxc %s --host default --machine fleet/h200.vx --action emit-mlir 2>/dev/null | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h200.vx --action emit-mlir 2>/dev/null | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --host default --machine fleet/h200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env -u VX_GPU_CHIP vxc %s --host default --machine fleet/h200.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s --check-prefix=PTX --implicit-check-not=local_depot < %t.ptx
// RUN: env -u VX_GPU_CHIP vxc %s --legacy-codegen --host default --machine fleet/h200.vx --emit-ptx -o %t.ast.ptx
// RUN: FileCheck %s --check-prefix=PTX --implicit-check-not=local_depot < %t.ast.ptx
// RUN: env VX_GPU_CHIP=sm_75 not vxc %s --host default --machine fleet/h200.vx --emit-ptx -o /dev/null 2>&1 | FileCheck %s --check-prefix=SM75
// RUN: env VX_GPU_CHIP=sm_75 not vxc %s --legacy-codegen --host default --machine fleet/h200.vx --emit-ptx -o /dev/null 2>&1 | FileCheck %s --check-prefix=SM75
// MLIR: memref.alloca() {alignment = 16 : i64, vx.registers} : memref<2x32x16xf32>
// MLIR: "vx.lane_matmul"
// MLIR-NOT: "vx.lane_matmul"
// MLIR: memref.alloca() {alignment = 16 : i64, vx.registers} : memref<16x64x64xf32>
// MLIR: "vx.lane_matmul"
// MLIR-NOT: "vx.lane_matmul"
// CHECK: {{^}}in registers: -3 -3 7 sum of all 1020{{$}}
// PTX-LABEL: .entry too_large_for_shared_memory(
// PTX-NOT: .shared .align
// PTX: .shared .align 16 .b8 vx_npu_kernel_0_smem_{{[0-9]+}}[{{2048|32768}}];
// PTX-NOT: .shared .align
// PTX: .shared .align 16 .b8 vx_npu_kernel_0_smem_{{[0-9]+}}[{{2048|32768}}];
// PTX-NOT: .shared .align
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-LABEL: .entry in_registers(
// PTX-NOT: .shared .align
// PTX: .shared .align 16 .b8 vx_npu_kernel_1_smem_0[1024];
// PTX-NOT: .shared .align
// PTX: ld.global.nc.v2.b32
// PTX: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32
// PTX: st.global.v2.b32 [{{.*}}], {%r{{[0-9]+}}, %r{{[0-9]+}}};
// SM75: the compiler cannot keep a tile in `Memory::REG` in registers, because this use needs it in memory

fn in_registers(c : &mut Tensor<f32, [2, 32, 16], Memory::HBM>, a : &Tensor<f8e4m3, [2, 32, 32], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 32, 16], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [2, 32, 16], Memory::REG>::uninit() };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for j in 0..16 {
            sb[w][i][j] = ((i * 2 + j) % 5 - 2) as f8e4m3;
          }
        }
        lanes::fill(&mut acc[w], 1.0);
        acc[w] = acc[w] + (a[w] as f32) @ (sb[w] as f32);
        lanes::copy(&mut c[w], &acc[w], [0, 0]);
      }
    }
  }
  return;
}

pub fn too_large_for_shared_memory(out : &mut Tensor<f32, [?, ?], Memory::HBM>, a : &Tensor<f16, [?, ?], Memory::HBM>, b : &Tensor<f16, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sa = unsafe {
        Tensor<f16, [16, 64, 16], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe { Tensor<f16, [16, 64], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [16, 64, 64], Memory::REG>::uninit()
      };
      for s in 0..16 across subgroups {
        lanes::fill(&mut acc[s], 0.0);
      }
      for kb in 0..2 {
        lanes::copy(&mut sb, b, [kb * 16, 0]);
        for s in 0..16 across subgroups {
          lanes::copy(&mut sa[s], a, [s * 64, kb * 16]);
          acc[s] = acc[s] + (sa[s] as f32) @ (sb as f32);
        }
      }
      for s in 0..16 across subgroups {
        lanes::copy(out, &acc[s], [s * 64, 0]);
      }
    }
  }
  return;
}

fn say(h : &Tensor<f32, [2, 32, 16]>) -> void {
  let mut all = 0.0;
  for w in 0..2 {
    for i in 0..32 {
      for j in 0..16 {
        all = all + h[w][i][j];
      }
    }
  }
  println!("{} {} {} sum of all {}", h[0][0][0], h[1][31][15], h[1][20][5], all);
  return;
}

fn main() -> i32 {
  let mut ha = Tensor<f8e4m3, [2, 32, 32]>::fill(0.0);
  for w in 0..2 {
    for i in 0..32 {
      for k in 0..32 {
        ha[w][i][k] = (((w * 32 + i) * 3 + k * 5) % 7 - 3) as f8e4m3;
      }
    }
  }
  let a = transfer(ha, Memory::HBM);
  let mut c = transfer(Tensor<f32, [2, 32, 16]>::fill(0.0), Memory::HBM);
  in_registers(&mut c, &a);
  let hc = transfer(c, Memory::CPU_DRAM);
  print!("in registers: ");
  say(&hc);
  return 0;
}
