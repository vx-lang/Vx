// RUN: vxc %s -O1 --run | FileCheck %s
// RUN: vxc %s -O2 --run | FileCheck %s
//
// The `0..64` loop and the `usize` loop both read `a`. Loop fusion merges the
// fill of `a` with the `0..64` loop. It once deleted the fill of the real `a`
// too, because it did not see the `usize` loop, which the compiler writes as
// branches. The sum of `a` then printed as NaN, not as 64.
//
// CHECK: 64 2

fn main() -> i32 {
  let a = Tensor<f32, [64]>::fill(1.0);
  let mut b = Tensor<f32, [64]>::fill(0.0);
  for i in 0..64 {
    b[i] = a[i] + 1.0;
  }
  let mut s = 0.0;
  for i in 0usize..64usize {
    s = s + a[i];
  }
  println!("{} {}", s, b[3]);
  return 0;
}
