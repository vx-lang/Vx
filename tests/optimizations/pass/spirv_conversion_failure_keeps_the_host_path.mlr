//===----------------------------------------------------------------------===//
// When the SPIR-V conversion cannot rewrite a kernel, the compile carries on
// and says why. The region keeps the host path it already has, so there is no
// image in the payload and the host copy of the kernel runs.
//
// This kernel reads through a `memref.subview`, which the argument flattening
// has no arithmetic for. The step used to stop the whole compile with "cannot
// compile this device kernel", which turned a program that runs perfectly well
// on the host into one that does not compile at all.
//
// RUN: vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s
// CHECK: cannot become a `spirv64` device image: it hands a tensor to `memref.subview`
// CHECK-SAME: It will run on the host instead.

module {
  func.func @main() -> i32 {
    %c0 = arith.constant 0 : i32
    return %c0 : i32
  }
  vx.kernel @k(501) {arch = "spirv64"} : (memref<4xf32>, memref<2xf32>) -> () {
  ^bb0(%src: memref<4xf32>, %dst: memref<2xf32>):
    vx.return
  }
  gpu.module @kernels {
    gpu.func @k(%src: memref<4xf32>, %dst: memref<2xf32>) kernel {
      %c0 = arith.constant 0 : index
      %view = memref.subview %src[0] [2] [1] : memref<4xf32> to memref<2xf32, strided<[1]>>
      %value = memref.load %view[%c0] : memref<2xf32, strided<[1]>>
      memref.store %value, %dst[%c0] : memref<2xf32>
      gpu.return
    }
  }
}
