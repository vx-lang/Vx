//===----------------------------------------------------------------------===//
// `lanes::matmul_scaled` with MXFP4 tiles: each 32 values of `a` and `b` along k share one
// `f8e8m0` scale, a power of two. `acc` starts at 1, so the old value counts. A scale of 1.5 is
// stored as 1, because `as f8e8m0` rounds down. A Python loop gave the expected values. The
// kernel runs on the CPU here, with the flat and the AST code generators.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/b200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/b200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}-38.4375 90.75 -18 sum 152.1875{{$}}

fn main() -> i32 {
  let mut c = transfer(Tensor<f32, [2, 16, 8]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut a = unsafe {
        Tensor<f4e2m1, [2, 16, 64], Memory::SMEM>::uninit()
      };
      let mut sa = unsafe {
        Tensor<f8e8m0, [2, 16, 2], Memory::SMEM>::uninit()
      };
      let mut b = unsafe {
        Tensor<f4e2m1, [2, 64, 8], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<f8e8m0, [2, 2, 8], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [2, 16, 8], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          if i < 16 {
            for k in 0..64 {
              a[w][i][k] = (((i * 3 + k * 5 + w) % 13 - 6) as f32 * 0.5) as f4e2m1;
            }
            for q in 0..2 {
              sa[w][i][q] = ((1 << ((i + q * 3 + w) % 4)) as f32 * 0.25) as f8e8m0;
            }
            for j in 0..8 {
              acc[w][i][j] = 1.0;
            }
          }
          for k2 in 0..2 {
            let k = i * 2 + k2;
            for j in 0..8 {
              b[w][k][j] = (((k * 7 + j * 2 + w) % 9 - 4) as f32) as f4e2m1;
            }
          }
          if i < 2 {
            for j in 0..8 {
              sb[w][i][j] = ((((i * 5 + j + w) % 3) + 1) as f32 * 0.5) as f8e8m0;
            }
          }
        }
        lanes::matmul_scaled(&mut acc[w], &a[w], &sa[w], &b[w], &sb[w]);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..8 {
              c[w][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  let h = transfer(c, Memory::CPU_DRAM);
  let mut all = 0.0;
  for w in 0..2 {
    for i in 0..16 {
      for j in 0..8 {
        all = all + h[w][i][j];
      }
    }
  }
  println!("{} {} {} sum {}", h[0][0][0], h[1][15][7], h[0][7][3], all);
  return 0;
}
