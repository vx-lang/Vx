// Full-MLIR regression lock for slice elementwise ops + store (S3). `scalar * slice` broadcasts
// then multiplies; `slice + slice` loads both and adds; the assignment `o[i] = <slice>` becomes
// a `vector.store` into the S1 row view. These are the output accumulate (`o += s*v`)
// and rescale (`o *= s`). Regenerate with:
//   cargo run --bin update_mlir_test_checks -- tests/optimizations/pass/slice_elementwise_mlir.vx
//
// The elementwise ops are vectorized by construction: no scalar per-element loop.
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s --implicit-check-not=scf.for --implicit-check-not=affine.for

fn o_update(mut o : Tensor<f32, [2, 4]>, v : Tensor<f32, [2, 4]>, s : f32) -> i32 {
  o[0] = o[0] + s * v[0];
  o[1] = o[1] * s;
  return 0;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func @o_update(%arg0: memref<2x4xf32> {vx.owned}, %arg1: memref<2x4xf32> {vx.owned}, %arg2: f32) -> i32 {
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_i32_0 = arith.constant 0 : i32
// CHECK:     %2 = arith.index_cast %c0_i32_0 : i32 to index
// CHECK:     %c4_1 = arith.constant 4 : index
// CHECK:     %3 = arith.muli %2, %c4_1 : index
// CHECK:     %reinterpret_cast_2 = memref.reinterpret_cast %arg0 to offset: [%3], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_i32_3 = arith.constant 0 : i32
// CHECK:     %4 = arith.index_cast %c0_i32_3 : i32 to index
// CHECK:     %c4_4 = arith.constant 4 : index
// CHECK:     %5 = arith.muli %4, %c4_4 : index
// CHECK:     %reinterpret_cast_5 = memref.reinterpret_cast %arg1 to offset: [%5], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %6 = vector.broadcast %arg2 : f32 to vector<4xf32>
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %7 = vector.load %reinterpret_cast_5[%c0] {alignment = 16 : i64} : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %8 = arith.mulf %6, %7 : vector<4xf32>
// CHECK:     %c0_6 = arith.constant 0 : index
// CHECK:     %9 = vector.load %reinterpret_cast_2[%c0_6] {alignment = 16 : i64} : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %10 = arith.addf %9, %8 : vector<4xf32>
// CHECK:     %c0_7 = arith.constant 0 : index
// CHECK:     vector.store %10, %reinterpret_cast[%c0_7] {alignment = 16 : i64} : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     vx.drop %arg1 : memref<2x4xf32>
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %11 = arith.index_cast %c1_i32 : i32 to index
// CHECK:     %c4_8 = arith.constant 4 : index
// CHECK:     %12 = arith.muli %11, %c4_8 : index
// CHECK:     %reinterpret_cast_9 = memref.reinterpret_cast %arg0 to offset: [%12], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c1_i32_10 = arith.constant 1 : i32
// CHECK:     %13 = arith.index_cast %c1_i32_10 : i32 to index
// CHECK:     %c4_11 = arith.constant 4 : index
// CHECK:     %14 = arith.muli %13, %c4_11 : index
// CHECK:     %reinterpret_cast_12 = memref.reinterpret_cast %arg0 to offset: [%14], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_13 = arith.constant 0 : index
// CHECK:     %15 = vector.load %reinterpret_cast_12[%c0_13] {alignment = 16 : i64} : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %16 = vector.broadcast %arg2 : f32 to vector<4xf32>
// CHECK:     %17 = arith.mulf %15, %16 : vector<4xf32>
// CHECK:     %c0_14 = arith.constant 0 : index
// CHECK:     vector.store %17, %reinterpret_cast_9[%c0_14] {alignment = 16 : i64} : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     vx.drop %arg0 : memref<2x4xf32>
// CHECK:     %c0_i32_15 = arith.constant 0 : i32
// CHECK:     return %c0_i32_15 : i32
// CHECK:   }
// CHECK: }
