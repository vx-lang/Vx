// Full-MLIR regression lock for slice elementwise ops + store (S3). `scalar * slice` broadcasts
// then multiplies; `slice + slice` loads both and adds; the assignment `o[i] = <slice>` becomes
// a `vector.store` into the S1 row view. These are FlashAttention's O accumulate (`o += s*v`)
// and rescale (`o *= s`). Regenerate with:
//   cargo run --bin update_mlir_test_checks -- tests/optimizations/pass/slice_elementwise_mlir.vx
//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
//
// The elementwise ops are vectorized by construction: no scalar per-element loop.
// CHECK-NOT: scf.for
// CHECK-NOT: affine.for

fn o_update(o : Tensor<f32, [2, 4]>, v : Tensor<f32, [2, 4]>, s : f32) -> i32 {
  o[0] = o[0] + s * v[0];
  o[1] = o[1] * s;
  return 0;
}

// CHECK: module attributes {llvm.module_flags = {"Debug Info Version" = 3 : i32, "Dwarf Version" = 4 : i32}} {
// CHECK:   func.func private @printMemrefF32(memref<*xf32>)
// CHECK:   func.func private @printMemrefF64(memref<*xf64>)
// CHECK:   func.func private @printMemrefI32(memref<*xi32>)
// CHECK:   func.func private @printMemrefI64(memref<*xi64>)
// CHECK:   func.func private @printMemrefBF16(memref<*xbf16>)
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @o_update(%arg0: memref<2x4xf32>, %arg1: memref<2x4xf32>, %arg2: f32) -> i32 {
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_i32_0 = arith.constant 0 : i32
// CHECK:     %2 = arith.index_cast %c0_i32_0 : i32 to index
// CHECK:     %c4_1 = arith.constant 4 : index
// CHECK:     %3 = arith.muli %2, %c4_1 : index
// CHECK:     %reinterpret_cast_2 = memref.reinterpret_cast %arg1 to offset: [%3], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %4 = vector.broadcast %arg2 : f32 to vector<4xf32>
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %5 = vector.load %reinterpret_cast_2[%c0] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %6 = arith.mulf %4, %5 : vector<4xf32>
// CHECK:     %c0_3 = arith.constant 0 : index
// CHECK:     %7 = vector.load %reinterpret_cast[%c0_3] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %8 = arith.addf %7, %6 : vector<4xf32>
// CHECK:     %c0_i32_4 = arith.constant 0 : i32
// CHECK:     %9 = arith.index_cast %c0_i32_4 : i32 to index
// CHECK:     %c4_5 = arith.constant 4 : index
// CHECK:     %10 = arith.muli %9, %c4_5 : index
// CHECK:     %reinterpret_cast_6 = memref.reinterpret_cast %arg0 to offset: [%10], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_7 = arith.constant 0 : index
// CHECK:     vector.store %8, %reinterpret_cast_6[%c0_7] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %11 = arith.index_cast %c1_i32 : i32 to index
// CHECK:     %c4_8 = arith.constant 4 : index
// CHECK:     %12 = arith.muli %11, %c4_8 : index
// CHECK:     %reinterpret_cast_9 = memref.reinterpret_cast %arg0 to offset: [%12], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_10 = arith.constant 0 : index
// CHECK:     %13 = vector.load %reinterpret_cast_9[%c0_10] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %14 = vector.broadcast %arg2 : f32 to vector<4xf32>
// CHECK:     %15 = arith.mulf %13, %14 : vector<4xf32>
// CHECK:     %c1_i32_11 = arith.constant 1 : i32
// CHECK:     %16 = arith.index_cast %c1_i32_11 : i32 to index
// CHECK:     %c4_12 = arith.constant 4 : index
// CHECK:     %17 = arith.muli %16, %c4_12 : index
// CHECK:     %reinterpret_cast_13 = memref.reinterpret_cast %arg0 to offset: [%17], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c0_14 = arith.constant 0 : index
// CHECK:     vector.store %15, %reinterpret_cast_13[%c0_14] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %c0_i32_15 = arith.constant 0 : i32
// CHECK:     return %c0_i32_15 : i32
// CHECK:   }
// CHECK: }
