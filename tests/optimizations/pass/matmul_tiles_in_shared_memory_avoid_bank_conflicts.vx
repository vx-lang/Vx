//===----------------------------------------------------------------------===//
// Shared memory has 32 banks of 4 bytes, so an address and the address 128 bytes after it are in
// the same bank. `ldmatrix` reads 8 rows of 16 bytes at once. With rows of 64 bytes or more, some
// of those rows are in the same banks, and the reads wait for each other.
//
// So on a GPU without TMA, the compiler moves the parts of each tile that `ldmatrix` reads. In
// each line of 128 bytes, the 16-byte part `c` goes to the place `c ^ (line % 8)`. With rows
// longer than 128 bytes, the row number takes the place of the line. Each access to the tile
// (a copy, a load, a store, an `ldmatrix`) then uses that place in a flat view of the tile.
// `sa` has rows of 64 bytes, so a part moves by its line (bit 6 of the element number). `sb`
// has rows of 256 bytes, so a part moves by its row (bit 7).
//
// On an H100 the copies use TMA, which writes the tile in its plain order, so the tiles stay.
//
// RUN: vxc %s --host default --machine fleet/a100-80.vx --emit-mlir 2>/dev/null | vx-opt --pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s
// RUN: vxc %s --legacy-codegen --host default --machine fleet/a100-80.vx --emit-mlir 2>/dev/null | vx-opt --pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir 2>/dev/null | vx-opt --pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=TMA

// CHECK-LABEL: gpu.func @vx_npu_kernel_0(
// CHECK-DAG: %[[SA:.*]] = memref.reinterpret_cast %{{.*}} to offset: [0], sizes: [512], strides: [1] : memref<16x32xbf16, 3> to memref<512xbf16, 3>
// CHECK-DAG: %[[SB:.*]] = memref.reinterpret_cast %{{.*}} to offset: [0], sizes: [4096], strides: [1] : memref<32x128xbf16, 3> to memref<4096xbf16, 3>
// The copy into `sa`, 16 bytes at a time when the addresses allow it, and else one element at a
// time. The new place of element `e` is `e ^ (((e >> 6) & 7) << 3)`.
// CHECK: %[[LINE:.*]] = arith.shrui %[[E:.*]], %c6{{(_[0-9]+)?}} : index
// CHECK-NEXT: arith.constant 7 : index
// CHECK-NEXT: %[[LOW:.*]] = arith.andi %[[LINE]], %c7{{(_[0-9]+)?}} : index
// CHECK-NEXT: arith.constant 3 : index
// CHECK-NEXT: %[[MOVE:.*]] = arith.shli %[[LOW]], %c3{{(_[0-9]+)?}} : index
// CHECK-NEXT: %[[AT:.*]] = arith.xori %[[E]], %[[MOVE]] : index
// CHECK-NEXT: nvgpu.device_async_copy %arg1[{{.*}}], %[[SA]][%[[AT]]], 8
// CHECK: arith.shrui %{{.*}}, %c6{{(_[0-9]+)?}} : index
// CHECK: %[[AT:.*]] = arith.xori
// CHECK-NEXT: memref.store %{{.*}}, %[[SA]][%[[AT]]] : memref<512xbf16, 3>
// The copy into `sb`, whose rows of 256 bytes move by their row: `e >> 7`.
// CHECK: arith.shrui %{{.*}}, %c7{{(_[0-9]+)?}} : index
// CHECK: %[[AT:.*]] = arith.xori
// CHECK-NEXT: nvgpu.device_async_copy %arg2[{{.*}}], %[[SB]][%[[AT]]], 8
// CHECK: arith.shrui %{{.*}}, %c7{{(_[0-9]+)?}} : index
// CHECK: %[[AT:.*]] = arith.xori
// CHECK-NEXT: memref.store %{{.*}}, %[[SB]][%[[AT]]] : memref<4096xbf16, 3>
// The `ldmatrix` reads find each row at its new place.
// CHECK: arith.shrui %{{.*}}, %c6{{(_[0-9]+)?}} : index
// CHECK: %[[AT:.*]] = arith.xori
// CHECK-NEXT: nvgpu.ldmatrix %[[SA]][%[[AT]]] {numTiles = 4 : i32, transpose = false}
// CHECK: arith.shrui %{{.*}}, %c7{{(_[0-9]+)?}} : index
// CHECK: %[[AT:.*]] = arith.xori
// CHECK-NEXT: nvgpu.ldmatrix %[[SB]][%[[AT]]] {numTiles = 2 : i32, transpose = true}

// TMA-LABEL: gpu.func @vx_npu_kernel_0(
// TMA-NOT: arith.xori
// TMA: nvgpu.ldmatrix %{{.*}} : memref<16x32xbf16, 3>
// TMA-NOT: arith.xori
// TMA: nvgpu.ldmatrix %{{.*}} : memref<32x128xbf16, 3>

pub fn one_step(c : &mut Tensor<f32, [?, 16, 128], Memory::HBM>, a : &Tensor<bf16, [?, ?], Memory::HBM>, b : &Tensor<bf16, [?, ?], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe { Tensor<bf16, [16, 32], Memory::SMEM>::uninit() };
      let mut sb = unsafe { Tensor<bf16, [32, 128], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [1, 16, 128], Memory::SMEM>::uninit()
      };
      let ta = lanes::copy_async(&mut sa, a, [blk * 16, 0]);
      let tb = lanes::copy_async(&mut sb, b, [0, 0]);
      ta.wait();
      tb.wait();
      for w in 0..1 across subgroups {
        acc[w] = (sa as f32) @ (sb as f32);
        for j in 0..32 across lanes {
          for i in 0..16 {
            c[blk][i][j] = acc[w][i][j];
            c[blk][i][j + 32] = acc[w][i][j + 32];
            c[blk][i][j + 64] = acc[w][i][j + 64];
            c[blk][i][j + 96] = acc[w][i][j + 96];
          }
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
