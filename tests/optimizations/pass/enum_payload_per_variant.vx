//===----------------------------------------------------------------------===//
// A generic enum whose variants carry payloads of different types. The layout used to
// take the first variant's payload for all of them (Vx#570), which broke two ways.
//
// `Mix` is the type case: `f32` and `i32` are the same width, so nothing overflows, and
// the failure was in how the bits travelled. The slot was declared `f32`, the struct is
// passed whole, and 7 read as a float is a denormal that a copy may flush to zero -- so
// the payload came back 0 rather than 7. It is why the slot is now an integer of the
// right width and the store and load each name the type they are really moving.
//
// `Wide` is the size case, and its narrow variant is declared first on purpose: with the
// slot sized from the first variant it held four bytes, and the `i64` did not fit. The
// value used is the largest `i64`, so any truncation shows.
//
// Both variants of both enums are read, since a slot sized or typed for one of them is
// exactly what worked before.
//
// The fix is to the flat path. The AST path has never lowered a mixed-payload enum and
// still does not: it builds the value with `llvm.insertvalue` and would need a cast at
// each insert and extract. That is why this file lives here rather than in backend/pass,
// whose runner executes every program through the AST path -- this runner takes the RUN
// line, which uses the flat path, and the marker keeps the legacy replay off.
// REQUIRES: flat-codegen
// RUN: vxc %s --run 2>&1 | FileCheck %s
// CHECK: 7 2.5 -1 7 9223372036854775807 -1
enum Mix<T> {
  A(T),
  B(i32),
}

impl<T> Mix<T> {
  fn a_or(self : Mix<T>, d : T) -> T {
    match self {
      Mix<T>::A(v) => {
        return v;
      }
      Mix<T>::B(v) => {
        return d;
      }
    }
  }

  fn b_or(self : Mix<T>, d : i32) -> i32 {
    match self {
      Mix<T>::A(v) => {
        return d;
      }
      Mix<T>::B(v) => {
        return v;
      }
    }
  }
}

enum Wide<T> {
  Small(i32),
  Big(T),
}

impl<T> Wide<T> {
  fn small_or(self : Wide<T>, d : i32) -> i32 {
    match self {
      Wide<T>::Small(v) => {
        return v;
      }
      Wide<T>::Big(v) => {
        return d;
      }
    }
  }

  fn big_or(self : Wide<T>, d : T) -> T {
    match self {
      Wide<T>::Small(v) => {
        return d;
      }
      Wide<T>::Big(v) => {
        return v;
      }
    }
  }
}

fn main() -> i32 {
  print(Mix<f32>::B(7).b_or(0));
  print!(" ");
  print(Mix<f32>::A(2.5).a_or(0.5));
  print!(" ");
  print(Mix<f32>::A(2.5).b_or(-1));
  print!(" ");

  print(Wide<i64>::Small(7).small_or(0));
  print!(" ");
  let big : i64 = 9223372036854775807;
  let zero : i64 = 0;
  print(Wide<i64>::Big(big).big_or(zero));
  print!(" ");
  print(Wide<i64>::Big(big).small_or(-1));
  return 0;
}
