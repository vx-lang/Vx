//===----------------------------------------------------------------------===//
// The PTX of `lanes::fill`. Each lane stores the value in its elements of the tile in shared
// memory, and then every lane of the block waits (`bar.sync`). In the code of a subgroup, only
// the lanes of the subgroup wait (`bar.warp.sync`).
//
// RUN: vxc %s --host default --machine fleet/a100-80.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx --implicit-check-not=local_depot
// RUN: vxc %s --legacy-codegen --host default --machine fleet/a100-80.vx --emit-ptx -o %t.ast.ptx
// RUN: FileCheck %s < %t.ast.ptx --implicit-check-not=local_depot

// The block has no lane loop, so it has one lane, which stores 2.5 (`0f40200000`) four elements
// at a time.
// CHECK-LABEL: .entry fill_a_tile(
// CHECK: st.shared.v4.b32 [%rd{{[0-9]+}}], {0f40200000, 0f40200000, 0f40200000, 0f40200000};
// CHECK: bar.sync 0;
// CHECK: ld.shared.b32
// CHECK-NEXT: st.global.b32
pub fn fill_a_tile(y : &mut Tensor<f32, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tile = unsafe { Tensor<f32, [16, 16], Memory::SMEM>::uninit() };
      lanes::fill(&mut tile, 2.5);
      lanes::copy(y, &tile, [0, 0]);
    }
  }
  return;
}

// CHECK-LABEL: .entry fill_subgroup_rows(
// CHECK: st.shared.b32 [%rd{{[0-9]+}}], 0;
// CHECK: bar.warp.sync -1;
// CHECK: ld.shared.b32
pub fn fill_subgroup_rows(y : &mut Tensor<f32, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut part = unsafe {
        Tensor<f32, [4, 8, 32], Memory::SMEM>::uninit()
      };
      for w in 0..4 across subgroups {
        lanes::fill(&mut part[w], 0.0);
        lanes::copy(y, &part[w], [8 * w, 0]);
      }
    }
  }
  return;
}
