//===----------------------------------------------------------------------===//
// Without each `across`, a program means the same (#252, L6), so its loops can run in order.
// The regions run on the CPU here (`CUDA_VISIBLE_DEVICES=`). The kernels are a warp for each row
// with 40 columns, a 16x16 tile, a block with lane loops of 256 and 128 and code between them that
// writes memory, and blocks with no lane loop. Each line is the sum of what a kernel wrote.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: warps 43900
// CHECK-NEXT: tile 32640
// CHECK-NEXT: two lane loops 137128
// CHECK-NEXT: no lane loop 6

fn sum(t : &Tensor<f32, [?]>, n : i32) -> f32 {
  let mut s = 0.0;
  for i in 0..n {
    s = s + t[i];
  }
  return s;
}

fn main() -> i32 {
  let rows = 5;
  let cols = 40;
  let mut y = transfer(Tensor<f32, [5, 40]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..(rows + 3) / 4 across blocks {
      for w in 0..4 across subgroups {
        let row = b * 4 + w;
        if row < rows {
          for c in 0..cols across lanes(32) {
            y[row][c] = (row * 100 + c) as f32;
          }
        }
      }
    }
  }
  let y = transfer(y, Memory::CPU_DRAM);
  let mut all = 0.0;
  for r in 0..rows {
    for c in 0..cols {
      all = all + y[r][c];
    }
  }
  println!("warps {}", all);

  let mut t = transfer(Tensor<f32, [256]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for i in 0..16 across lanes {
        for j in 0..16 across lanes {
          t[i * 16 + j] = (i * 16 + j) as f32;
        }
      }
    }
  }
  let t = transfer(t, Memory::CPU_DRAM);
  println!("tile {}", sum(&t, 256));

  let mut part = transfer(Tensor<f32, [256]>::fill(0.0), Memory::HBM);
  let mut d = transfer(Tensor<f32, [128]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for i in 0..256 across lanes {
        part[i] = i as f32;
      }
      part[0] = part[0] + 1000.0;
      for i in 0..128 across lanes {
        d[i] = part[i] + part[0];
      }
    }
  }
  let d = transfer(d, Memory::CPU_DRAM);
  println!("two lane loops {}", sum(&d, 128));

  let mut e = transfer(Tensor<f32, [3]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..3 across blocks {
      e[b] = (b * 2) as f32;
    }
  }
  let e = transfer(e, Memory::CPU_DRAM);
  println!("no lane loop {}", sum(&e, 3));
  return 0;
}
