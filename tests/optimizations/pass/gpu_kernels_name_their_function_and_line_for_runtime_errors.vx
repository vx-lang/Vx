//===----------------------------------------------------------------------===//
// The compiler gives each GPU kernel a name like `vx_npu_kernel_3`. The data that the program
// passes to the runtime with each kernel (the payload) also holds the Vx function and the line of
// the `spawn`. So a runtime error can say which `spawn` failed. Both code generators write them.
//
// - `add_one` has one `spawn`. `add_twice` calls `add_one`, and the kernel still names `add_one`.
// - `add_and_scale` has two `spawn`s. Its kernels name the same function with different lines.
//
// REQUIRES: flat-codegen
// RUN: env -u VX_GPU_CHIP vxc %s --host default --machine fleet/h100-sxm.vx --emit-llvm 2>&1 | FileCheck %s --implicit-check-not=function=add_twice
// RUN: env -u VX_GPU_CHIP vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --emit-llvm 2>&1 | FileCheck %s --implicit-check-not=function=add_twice

fn add_one(x : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  // CHECK-DAG: function=add_one\00source={{.*}}gpu_kernels_name_their_function_and_line_for_runtime_errors.vx:[[@LINE+1]]\00
  spawn on(Topology::Device) {
    for i in 0..n / 256 across blocks {
      for l in 0..256 across lanes {
        let j : i32 = 256 * i + l;
        x[j] = x[j] + 1.0;
      }
    }
  }
  return;
}

fn add_twice(x : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  add_one(x, n);
  add_one(x, n);
  return;
}

fn add_and_scale(x : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  // CHECK-DAG: function=add_and_scale\00source={{.*}}gpu_kernels_name_their_function_and_line_for_runtime_errors.vx:[[@LINE+1]]\00
  spawn on(Topology::Device) {
    for i in 0..n / 256 across blocks {
      for l in 0..256 across lanes {
        let j : i32 = 256 * i + l;
        x[j] = x[j] + 1.0;
      }
    }
  }
  // CHECK-DAG: function=add_and_scale\00source={{.*}}gpu_kernels_name_their_function_and_line_for_runtime_errors.vx:[[@LINE+1]]\00
  spawn on(Topology::Device) {
    for i in 0..n / 256 across blocks {
      for l in 0..256 across lanes {
        let j : i32 = 256 * i + l;
        x[j] = x[j] * 2.0;
      }
    }
  }
  return;
}
