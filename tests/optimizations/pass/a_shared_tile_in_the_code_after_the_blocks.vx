//===----------------------------------------------------------------------===//
// The code after a nest of blocks declares a tile in shared memory. The tile and its drop belong
// to that code, which only the last pass runs. So the tile is read and written after the check
// for the last pass.
//
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx
// CHECK: .entry reverse_after_the_blocks(
// CHECK-DAG: .shared .align 16 .b8 [[TILE:[a-z_0-9]+]][1024];
// CHECK-DAG: .shared .align 16 .u32 [[FLAG:[a-z_0-9$]+]];
// The address of this lane's element of the tile can come first.
// CHECK: mov.b64 [[TILE_AT:%rd[0-9]+]], [[TILE]];
// CHECK-NEXT: add.s64 [[ELEMENT:%rd[0-9]+]], [[TILE_AT]], {{%rd[0-9]+}};
// Each pass adds 1 to the count. Then the lanes read the flag, and only the last pass goes on.
// CHECK: atom.global.add.u32
// CHECK: ld.shared.b32 [[LAST:%r[0-9]+]], {{\[}}[[FLAG]]{{\]}};
// CHECK-NEXT: setp.ne.b32 [[NOT_LAST:%p[0-9]+]], [[LAST]], 1;
// CHECK-NEXT: @[[NOT_LAST]] bra
// The code after that uses the tile.
// CHECK-NEXT: ld.global.b32
// CHECK-NEXT: st.shared.b32 {{\[}}[[ELEMENT]]{{\]}}
// CHECK: bar.sync
// CHECK: ld.shared.b32
// CHECK: ret;

pub fn reverse_after_the_blocks(out : &mut Tensor<i32, [?], Memory::HBM>, part : &mut Tensor<i32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for l in 0..256 across lanes {
        part[b * 256 + l] = l;
      }
    }
    let mut s = unsafe { Tensor<i32, [256], Memory::SMEM>::uninit() };
    for l in 0..256 across lanes {
      s[l] = part[l];
    }
    for l in 0..256 across lanes {
      out[l] = s[255 - l];
    }
  }
  return;
}
