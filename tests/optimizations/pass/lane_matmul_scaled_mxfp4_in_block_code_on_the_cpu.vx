//===----------------------------------------------------------------------===//
// `lanes::matmul_scaled` with MXFP4 tiles in the code of a block: the 128 lanes compute `acc`, a
// 128 x 16 matrix, from `f4e2m1` tiles with k = 128 and an `f8e8m0` scale for each 32 values.
// `acc` starts at 1. A Python loop gave the expected values. The kernel runs on the CPU here, with
// the flat and the AST code generators. On a B200, `VX_TCGEN05=1` puts this matmul on the tensor
// cores with `kind::mxf4`, and the program must print the same line.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/b200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/b200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}-55.9375 23.8125 -17.5 sum 1947.375{{$}}

fn main() -> i32 {
  let mut c = transfer(Tensor<f32, [128, 16]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut a = unsafe {
        Tensor<f4e2m1, [128, 128], Memory::SMEM>::uninit()
      };
      let mut sa = unsafe { Tensor<f8e8m0, [128, 4], Memory::SMEM>::uninit() };
      let mut b = unsafe { Tensor<f4e2m1, [128, 16], Memory::SMEM>::uninit() };
      let mut sb = unsafe { Tensor<f8e8m0, [4, 16], Memory::SMEM>::uninit() };
      let mut acc = unsafe { Tensor<f32, [128, 16], Memory::SMEM>::uninit() };
      for i in 0..128 across lanes {
        for k in 0..128 {
          a[i][k] = (((i * 3 + k * 5) % 13 - 6) as f32 * 0.5) as f4e2m1;
        }
        for q in 0..4 {
          sa[i][q] = ((1 << ((i + q * 3) % 4)) as f32 * 0.25) as f8e8m0;
        }
        for j in 0..16 {
          b[i][j] = (((i * 7 + j * 2) % 9 - 4) as f32) as f4e2m1;
          acc[i][j] = 1.0;
        }
        if i < 4 {
          for j in 0..16 {
            sb[i][j] = ((((i * 5 + j) % 3) + 1) as f32 * 0.5) as f8e8m0;
          }
        }
      }
      lanes::matmul_scaled(&mut acc, &a, &sa, &b, &sb);
      for i in 0..128 across lanes {
        for j in 0..16 {
          c[i][j] = acc[i][j];
        }
      }
    }
  }
  let h = transfer(c, Memory::CPU_DRAM);
  let mut all = 0.0;
  for i in 0..128 {
    for j in 0..16 {
      all = all + h[i][j];
    }
  }
  println!("{} {} {} sum {}", h[0][0], h[127][15], h[64][7], all);
  return 0;
}
