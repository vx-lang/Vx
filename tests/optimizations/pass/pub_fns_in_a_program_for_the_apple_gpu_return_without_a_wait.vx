// In a library for the Apple GPU, a `pub fn` waits for the GPU before it returns, because its C
// caller reads the tensors right away (a_library_for_the_apple_gpu_waits_before_it_returns.vx).
// A program with `main` has no C caller, so `add_one` returns with no wait. The runtime waits
// for the GPU where `main` reads the result.
//
// RUN: vxc %s --host default --machine fleet/m4-uma.vx --action emit-llvm -o - 2>/dev/null | FileCheck %s --implicit-check-not="llvm.call @vx_plugin_control("
//
// CHECK-LABEL: llvm.func @add_one(
// CHECK: llvm.call @vx_plugin_dispatch_async(
// CHECK-NEXT: llvm.return

pub fn add_one(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..h across blocks {
      for x in 0..w across lanes(256) {
        dst[y][x] = src[y][x] + 1.0;
      }
    }
  }
  return;
}

fn main() -> i32 {
  let src = transfer(Tensor<f32, [2, 4]>::fill(1.0), Memory::HBM);
  let mut dst = transfer(Tensor<f32, [2, 4]>::fill(0.0), Memory::HBM);
  add_one(&mut dst, &src, 2, 4);
  let host = transfer(dst, Memory::CPU_DRAM);
  return host[1][3] as i32;
}
