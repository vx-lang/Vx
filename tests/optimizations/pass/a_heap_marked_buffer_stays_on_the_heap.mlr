// RUN: vx-opt %s --pass-pipeline="builtin.module(func.func(vx-promote-buffers-to-stack))" | FileCheck %s
//
// A small buffer marked `vx.heap` stays on the heap. A small buffer without the mark moves to
// the stack.

// CHECK-DAG: memref.alloc() {vx.heap} : memref<4xf32>
// CHECK-DAG: memref.alloca() : memref<8xf32>
// CHECK-NOT: memref.alloc() : memref<8xf32>

module attributes {vx.drops} {
  func.func @main() -> i32 {
    %c0 = arith.constant 0 : i32
    %i = arith.constant 0 : index
    %x = arith.constant 1.0 : f32
    %heap = memref.alloc() {vx.heap} : memref<4xf32>
    %small = memref.alloc() : memref<8xf32>
    memref.store %x, %heap[%i] : memref<4xf32>
    memref.store %x, %small[%i] : memref<8xf32>
    memref.dealloc %heap : memref<4xf32>
    memref.dealloc %small : memref<8xf32>
    return %c0 : i32
  }
}
