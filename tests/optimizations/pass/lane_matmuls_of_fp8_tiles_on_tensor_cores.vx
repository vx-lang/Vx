//===----------------------------------------------------------------------===//
// A matmul of `f8e4m3` or `f8e5m2` tiles in the code of a subgroup loop goes to the tensor cores
// on `sm_89` and later, when the sizes are multiples of 16 x 8 x 32. Each 16 x 8 piece of the
// result is a chain of `mma.sync.m16n8k32`, one for each 32 columns of the first tile. That PTX
// instruction needs PTX 8.4. `e5m2_tiles` has 64 columns, so each chain has two. In `k_loop`, the
// matmul adds to `acc` in each pass of a loop, so the lanes keep `acc` in registers until the loop
// ends. `k16_tiles` has 16 columns, which is not a multiple of 32, so each lane multiplies and
// adds its elements in f32. In `e4m3_by_f16` and `f16_by_e5m2`, one tile is f16 and the other is
// fp8. Then each lane converts two fp8 elements to f16 with one `cvt.rn.f16x2`, not as inline PTX,
// and each chain is of f16 `mma.sync.m16n8k16`. `ldmatrix` loads the f16 tile. `bf16_by_e4m3` has a
// bf16 tile, so each lane multiplies and adds its elements in f32. An `sm_80` chip has no fp8
// `mma.sync` and no `cvt.rn.f16x2` from fp8, and its PTX stays at 7.6.
//
// RUN: env -u VX_GPU_CHIP vxc %s --host default --machine fleet/h200.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s --implicit-check-not=local_depot < %t.ptx
// RUN: env -u VX_GPU_CHIP vxc %s --legacy-codegen --host default --machine fleet/h200.vx --emit-ptx -o %t.ast.ptx
// RUN: FileCheck %s --implicit-check-not=local_depot < %t.ast.ptx
// RUN: env VX_GPU_CHIP=sm_89 vxc %s --host default --machine fleet/h200.vx --emit-ptx -o %t.sm89.ptx
// RUN: FileCheck %s --implicit-check-not=local_depot < %t.sm89.ptx
// RUN: env VX_GPU_CHIP=sm_80 vxc %s --host default --machine fleet/h200.vx --emit-ptx -o %t.sm80.ptx
// RUN: FileCheck %s --check-prefix=SM80 --implicit-check-not=mma.sync < %t.sm80.ptx
// CHECK: .version 8.4
// CHECK-LABEL: .entry e4m3_tiles(
// CHECK: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32
// CHECK-LABEL: .entry e5m2_tiles(
// CHECK-COUNT-2: mma.sync.aligned.m16n8k32.row.col.f32.e5m2.e5m2.f32
// CHECK-LABEL: .entry k_loop(
// CHECK: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32
// CHECK-NOT: st.shared
// CHECK: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32
// CHECK-NOT: st.shared
// CHECK: bar.sync 0;
// CHECK-LABEL: .entry k16_tiles(
// CHECK-NOT: mma.sync
// CHECK: mul.rn.f32
// CHECK-LABEL: .entry e4m3_by_f16(
// CHECK-NOT: begin inline asm
// CHECK: cvt.rn.f16x2.e4m3x2
// CHECK: ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16
// CHECK: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// CHECK-LABEL: .entry f16_by_e5m2(
// CHECK: ldmatrix.sync.aligned.m8n8.x4.shared.b16
// CHECK-NOT: begin inline asm
// CHECK: cvt.rn.f16x2.e5m2x2
// CHECK: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// CHECK-LABEL: .entry bf16_by_e4m3(
// CHECK-NOT: mma.sync
// CHECK-NOT: cvt.rn.f16x2
// CHECK: mul.rn.f32
// SM80: .version 7.6
// SM80-LABEL: .entry e4m3_tiles(
// SM80: mul.rn.f32
// SM80-LABEL: .entry e4m3_by_f16(
// SM80-NOT: cvt.rn.f16x2
// SM80: mul.rn.f32

pub fn e4m3_tiles(c : &mut Tensor<f32, [?, 2, 32, 16], Memory::HBM>, a : &Tensor<f8e4m3, [?, 32], Memory::HBM>, b : &Tensor<f8e4m3, [32, 16], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe {
        Tensor<f8e4m3, [2, 32, 32], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 32, 16], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe {
        Tensor<f32, [2, 32, 16], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..32 {
            sa[w][i][k] = a[blk * 64 + w * 32 + i][k];
          }
          for j in 0..16 {
            sb[w][i][j] = b[i][j];
            acc[w][i][j] = 1.0;
          }
        }
        acc[w] = acc[w] + (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          for j in 0..16 {
            c[blk][w][i][j] = acc[w][i][j];
          }
        }
      }
    }
  }
  return;
}

pub fn e5m2_tiles(c : &mut Tensor<f32, [?, 2, 16, 8], Memory::HBM>, a : &Tensor<f8e5m2, [?, 64], Memory::HBM>, b : &Tensor<f8e5m2, [64, 8], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe {
        Tensor<f8e5m2, [2, 16, 64], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<f8e5m2, [2, 64, 8], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [2, 16, 8], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for l in 0..32 across lanes {
          for h in 0..2 {
            let k = h * 32 + l;
            for i in 0..16 {
              sa[w][i][k] = a[blk * 32 + w * 16 + i][k];
            }
            for j in 0..8 {
              sb[w][k][j] = b[k][j];
            }
          }
        }
        acc[w] = (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..8 {
              c[blk][w][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}

pub fn k_loop(c : &mut Tensor<f32, [?, 2, 16, 16], Memory::HBM>, a : &Tensor<f8e4m3, [?, ?], Memory::HBM>, b : &Tensor<f8e4m3, [?, 16], Memory::HBM>, k : i32, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe {
        Tensor<f8e4m3, [2, 16, 32], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe { Tensor<f8e4m3, [32, 16], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [2, 16, 16], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for j in 0..32 across lanes {
          if j < 16 {
            for i in 0..16 {
              acc[w][i][j] = 0.0;
            }
          }
        }
      }
      for kt in 0..k / 32 {
        for j in 0..16 across lanes {
          for r in 0..32 {
            sb[r][j] = b[kt * 32 + r][j];
          }
        }
        for w in 0..2 across subgroups {
          for kk in 0..32 across lanes {
            for i in 0..16 {
              sa[w][i][kk] = a[blk * 32 + w * 16 + i][kt * 32 + kk];
            }
          }
          acc[w] = acc[w] + (sa[w] as f32) @ (sb as f32);
        }
      }
      for w in 0..2 across subgroups {
        for j in 0..32 across lanes {
          if j < 16 {
            for i in 0..16 {
              c[blk][w][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}

pub fn k16_tiles(c : &mut Tensor<f32, [?, 2, 16, 8], Memory::HBM>, a : &Tensor<f8e4m3, [?, 16], Memory::HBM>, b : &Tensor<f8e4m3, [16, 8], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe {
        Tensor<f8e4m3, [2, 16, 16], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 16, 8], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [2, 16, 8], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          if i < 16 {
            for k in 0..16 {
              sa[w][i][k] = a[blk * 32 + w * 16 + i][k];
            }
            for j in 0..8 {
              sb[w][i][j] = b[i][j];
            }
          }
        }
        acc[w] = (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..8 {
              c[blk][w][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}

pub fn e4m3_by_f16(c : &mut Tensor<f32, [?, 2, 32, 16], Memory::HBM>, a : &Tensor<f8e4m3, [?, 32], Memory::HBM>, b : &Tensor<f16, [32, 16], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe {
        Tensor<f8e4m3, [2, 32, 32], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe { Tensor<f16, [2, 32, 16], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [2, 32, 16], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..32 {
            sa[w][i][k] = a[blk * 64 + w * 32 + i][k];
          }
          for j in 0..16 {
            sb[w][i][j] = b[i][j];
            acc[w][i][j] = 1.0;
          }
        }
        acc[w] = acc[w] + (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          for j in 0..16 {
            c[blk][w][i][j] = acc[w][i][j];
          }
        }
      }
    }
  }
  return;
}

pub fn f16_by_e5m2(c : &mut Tensor<f32, [?, 2, 16, 8], Memory::HBM>, a : &Tensor<f16, [?, 32], Memory::HBM>, b : &Tensor<f8e5m2, [32, 8], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe { Tensor<f16, [2, 16, 32], Memory::SMEM>::uninit() };
      let mut sb = unsafe {
        Tensor<f8e5m2, [2, 32, 8], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [2, 16, 8], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for k in 0..32 across lanes {
          for i in 0..16 {
            sa[w][i][k] = a[blk * 32 + w * 16 + i][k];
          }
          for j in 0..8 {
            sb[w][k][j] = b[k][j];
          }
        }
        acc[w] = (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..8 {
              c[blk][w][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}

pub fn bf16_by_e4m3(c : &mut Tensor<f32, [?, 2, 16, 8], Memory::HBM>, a : &Tensor<bf16, [?, 32], Memory::HBM>, b : &Tensor<f8e4m3, [32, 8], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut sa = unsafe {
        Tensor<bf16, [2, 16, 32], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 32, 8], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [2, 16, 8], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for k in 0..32 across lanes {
          for i in 0..16 {
            sa[w][i][k] = a[blk * 32 + w * 16 + i][k];
          }
          for j in 0..8 {
            sb[w][k][j] = b[k][j];
          }
        }
        acc[w] = (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..8 {
              c[blk][w][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}
