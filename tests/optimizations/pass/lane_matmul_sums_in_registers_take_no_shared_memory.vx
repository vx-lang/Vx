//===----------------------------------------------------------------------===//
// Each of 16 subgroups adds to its row of `acc`, 64 x 64 f32 (16 KB). The rows are 256 KB, more
// than the 228 KB of shared memory of the H100. Their only other uses are a fill and a copy out,
// so the tensor cores keep each row in the registers of its subgroup, and `acc` takes no shared
// memory. The checker gives no E6009 or E6010 for `acc`: the PTX has only `sa` (32 KB) and `sb`
// (2 KB) in shared memory.
//
// A GPU without `mma.sync` (`sm_75`) keeps `acc` in shared memory. The kernel then needs more
// shared memory than the H100 has, and the lowering refuses it.
//
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx 2>&1 | FileCheck %s --check-prefix=OK --allow-empty --implicit-check-not=Error
// RUN: FileCheck %s --input-file=%t.ptx
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ast.ptx 2>&1 | FileCheck %s --check-prefix=OK --allow-empty --implicit-check-not=Error
// RUN: FileCheck %s --input-file=%t.ast.ptx
// RUN: env VX_GPU_CHIP=sm_75 not vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o /dev/null 2>&1 | FileCheck %s --check-prefix=SM75
// RUN: env VX_GPU_CHIP=sm_75 not vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --emit-ptx -o /dev/null 2>&1 | FileCheck %s --check-prefix=SM75
// OK-NOT: E60
// CHECK-NOT: .shared .align 16 .b8 {{.*}}[262144];
// CHECK-DAG: .shared .align 16 .b8 vx_npu_kernel_0_smem_{{[0-9]+}}[2048];
// CHECK-DAG: .shared .align 16 .b8 vx_npu_kernel_0_smem_{{[0-9]+}}[32768];
// CHECK-NOT: .shared .align
// CHECK: mma.sync.aligned.m16n8k16
// SM75: this GPU kernel needs 296960 bytes of shared memory, but its memory has 233472

pub fn sums(out : &mut Tensor<f32, [?, ?], Memory::HBM>, a : &Tensor<f16, [?, ?], Memory::HBM>, b : &Tensor<f16, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sa = unsafe {
        Tensor<f16, [16, 64, 16], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe { Tensor<f16, [16, 64], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [16, 64, 64], Memory::SMEM>::uninit()
      };
      for s in 0..16 across subgroups {
        lanes::fill(&mut acc[s], 0.0);
      }
      for kb in 0..2 {
        lanes::copy(&mut sb, b, [kb * 16, 0]);
        for s in 0..16 across subgroups {
          lanes::copy(&mut sa[s], a, [s * 64, kb * 16]);
          acc[s] = acc[s] + (sa[s] as f32) @ (sb as f32);
        }
      }
      for s in 0..16 across subgroups {
        lanes::copy(out, &acc[s], [s * 64, 0]);
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
