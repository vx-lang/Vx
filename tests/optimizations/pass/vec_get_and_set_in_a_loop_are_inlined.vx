//===----------------------------------------------------------------------===//
// At -O3, `Vec::get` and `Vec::set` are inlined into a loop that calls them. The code that prints
// the message for a bad index stays a call to `vec_index_out_of_bounds`. Before, that code was
// inside `get` and `set`, and they were too large for LLVM to inline.
//
// RUN: vxc %s -O3 --emit-llvm 2>&1 | mlir-translate --mlir-to-llvmir | opt -passes='default<O3>' -S | FileCheck %s
// CHECK-LABEL: define {{.*}} @sum_get(
// CHECK-NOT: call {{.*}}Vec$i64$get
// CHECK: call void @vec_index_out_of_bounds(
// CHECK-NOT: call {{.*}}Vec$i64$get
// CHECK: {{^}}}
// CHECK-LABEL: define {{.*}} @fill_set(
// CHECK-NOT: call {{.*}}Vec$i64$set
// CHECK: call void @vec_index_out_of_bounds(
// CHECK-NOT: call {{.*}}Vec$i64$set
// CHECK: {{^}}}
import core::convert;
import std::vec;

fn fill_set(a : &mut Vec<i64>, n : i32) -> i32 {
  for i in 0..n {
    a.set(i, i64::from(i));
  }
  return 0;
}

fn sum_get(a : &Vec<i64>, n : i32) -> i64 {
  let mut s : i64 = 0;
  for i in 0..n {
    s = s + a.get(i);
  }
  return s;
}

fn main() -> i32 {
  let mut a = Vec<i64>::with_capacity(100);
  for i in 0..100 {
    a.push(i64::from(i));
  }
  fill_set(&mut a, 100);
  print(sum_get(&a, 100));
  return 0;
}
