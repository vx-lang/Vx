//===----------------------------------------------------------------------===//
// `ring` and `bars` use over 48 KiB of shared memory, so they are views into dynamic shared
// memory. They are declared after a loop. The compiler crashed on this, and now `ring` is at
// offset 0 and `bars` at offset 65536.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx
// CHECK: .extern .shared .align 16 .b8 __dynamic_shmem__0[];
// CHECK-LABEL: .entry ring_after_a_loop(
// CHECK: st.shared.b32 [__dynamic_shmem__0], 1;
// CHECK: st.shared.b32 [__dynamic_shmem__0+65536], 2;

pub fn ring_after_a_loop() -> void {
  spawn on(Topology::Device) {
    for _r in 0..1 {
    }
    let mut ring = unsafe { Tensor<i32, [16384], Memory::SMEM>::uninit() };
    let mut bars = unsafe { Tensor<i32, [1], Memory::SMEM>::uninit() };
    ring[0] = 1;
    bars[0] = 2;
  }
  return;
}

fn main() -> i32 {
  return 0;
}
