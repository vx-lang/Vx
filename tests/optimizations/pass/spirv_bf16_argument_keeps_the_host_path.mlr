//
//===----------------------------------------------------------------------===//
// A SPIR-V image holds a bf16 value as an i16, except a bf16 that a function
// takes or returns. A kernel that calls such a function keeps the host path,
// and the compile says why. LLVM's SPIR-V backend used to stop the process on
// the bf16 type instead.
//
// RUN: vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s
// CHECK-NOT: LLVM ERROR
// CHECK: (kernel `k`) cannot become a `spirv64` device image: it uses a `bf16` value in a way that a SPIR-V image cannot hold yet
// CHECK-SAME: It will run on the host instead.
// CHECK: @k_str("k\00abi=1\00topo=501\00toponame=Dev\00")

module {
  func.func @main(%x: memref<4xbf16>) -> i32 {
    %c0 = arith.constant 0 : i32
    vx.launch @k(%x) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xbf16>) -> ()
    return %c0 : i32
  }
  vx.kernel @k(501) {arch = "spirv64"} : (memref<4xbf16>) -> () {
  ^bb0(%src: memref<4xbf16>):
    vx.return
  }
  gpu.module @kernels {
    func.func @twice(%v: bf16) -> bf16 {
      %r = arith.addf %v, %v : bf16
      return %r : bf16
    }
    gpu.func @k(%src: memref<4xbf16>) kernel {
      %c0 = arith.constant 0 : index
      %v = memref.load %src[%c0] : memref<4xbf16>
      %r = func.call @twice(%v) : (bf16) -> bf16
      memref.store %r, %src[%c0] : memref<4xbf16>
      gpu.return
    }
  }
}
