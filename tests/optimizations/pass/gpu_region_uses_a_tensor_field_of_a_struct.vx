//===----------------------------------------------------------------------===//
// A struct in host memory can hold a tensor that is in the memory of the GPU. A GPU region can
// read and write the elements of such a field. The host reads the tensor from the struct before
// the launch, and the kernel takes the tensor. `main` uses a field of a struct in a struct, and
// `add_rows` uses the fields of a struct behind a reference.
//
// The region in `main` names `model.first.weights` two times, and its kernel takes that tensor
// one time: the 7 parameters of a tensor with 2 dimensions.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not="runs on the CPU"
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not="runs on the CPU"
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --check-prefix=PTX
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --check-prefix=PTX
// CHECK: sums: 7.5 7.5
// PTX: .entry vx_npu_kernel_1(
// PTX-SAME: vx_npu_kernel_1_param_6\0A)

struct Layer {
  rows : i32,
  weights : Tensor<f32, [?, ?], Memory::HBM>,
  sums : Tensor<f32, [?], Memory::HBM>
}

struct Model {
  first : Layer
}

fn add_rows(layer : &mut Layer) -> void {
  spawn on(Topology::Device) {
    for i in 0..4 {
      layer.sums[i] = layer.weights[i][0] + layer.weights[i][1];
    }
  }
  return;
}

fn main() -> i32 {
  let mut model = Model {
    first: Layer {
      rows: 4,
      weights: unsafe { Tensor<f32, [?, ?], Memory::HBM>::uninit([4, 2]) },
      sums: unsafe { Tensor<f32, [?], Memory::HBM>::uninit([4]) }
    }
  };
  spawn on(Topology::Device) {
    for i in 0..4 {
      model.first.weights[i][0] = 7.0;
      model.first.weights[i][1] = 0.5;
    }
  }
  add_rows(&mut model.first);
  let sums = transfer(model.first.sums, Memory::CPU_DRAM);
  println!("sums: {} {}", sums[0], sums[3]);
  return 0;
}
