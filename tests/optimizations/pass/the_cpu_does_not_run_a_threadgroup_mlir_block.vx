// An `mlir!` block with `threads` has no `gpu` op here, and the CPU still does not run it: every
// thread of a threadgroup runs such a block together, and the CPU copy of a kernel runs one thread.
// So the program stops with a message when no GPU runs the kernel.
//
// REQUIRES: macos
// RUN: vxc %s --host default --machine fleet/m4-uma.vx 2>&1 | FileCheck %s --check-prefix=GPU
// RUN: env VX_METAL=0 not vxc %s --host default --machine fleet/m4-uma.vx 2>&1 | FileCheck %s --check-prefix=CPU
//
// GPU: {{^}}out: 7 7{{$}}
// CPU: vx: the `mlir!` block with `threads` at line 16, column 23 runs only on a GPU, but no GPU ran its kernel, so the CPU did
// CPU-NOT: out:

pub fn sevens(out : &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..2 across blocks {
      let _d = unsafe { mlir!( threads : 32, inputs : (%o = out : memref<?xi32>, %b = b : i32), returns : i32, dialects : ["arith", "memref"], ensures : [writes_only(out[b..b + 1])]) {
          %k = arith.index_cast %b : i32 to index
          %c7 = arith.constant 7 : i32
          memref.store %c7, %o[%k] : memref<?xi32>
          macro.yield %c7 : i32
        } };
    }
  }
  return;
}

fn main() -> i32 {
  let mut out = transfer(Tensor<i32>([2]), Memory::HBM);
  sevens(&mut out);
  let h = transfer(&out, Memory::CPU_DRAM);
  println!("out: {} {}", h[0], h[1]);
  return 0;
}
