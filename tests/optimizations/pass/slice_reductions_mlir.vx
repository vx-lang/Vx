// Full-MLIR regression lock for slice reductions (S2). Each reduction over an S1 row view is
// `vector.load` (+ `arith.mulf` for dot) then a `vector.reduction` of the matching kind:
// `add` for dot/sum, `maximumf` for max, `minimumf` for min. These are vectorized by
// construction (SIMD), not by relying on the autovectorizer. Regenerate with:
//   cargo run --bin update_mlir_test_checks -- tests/optimizations/pass/slice_reductions_mlir.vx
//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
//
// The reductions are vectorized by construction: they must never lower to a scalar reduction
// loop. (These CHECK-NOT lines are preserved when the CHECK block is regenerated.)
// CHECK-NOT: scf.for
// CHECK-NOT: affine.for

fn dot_row(q : Tensor<f32, [2, 4]>, k : Tensor<f32, [2, 4]>) -> f32 {
  return dot(q[0], k[0]);
}

fn sum_row(q : Tensor<f32, [2, 4]>) -> f32 {
  return sum(q[0]);
}

fn max_row(q : Tensor<f32, [2, 4]>) -> f32 {
  return max(q[0]);
}

fn min_row(q : Tensor<f32, [2, 4]>) -> f32 {
  return min(q[0]);
}

// CHECK: module attributes {llvm.module_flags = {"Debug Info Version" = 3 : i32, "Dwarf Version" = 4 : i32}} {
// CHECK:   func.func private @printMemrefF32(memref<*xf32>)
// CHECK:   func.func private @printMemrefF64(memref<*xf64>)
// CHECK:   func.func private @printMemrefI32(memref<*xi32>)
// CHECK:   func.func private @printMemrefI64(memref<*xi64>)
// CHECK:   func.func private @printMemrefBF16(memref<*xbf16>)
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @dot_row(%arg0: memref<2x4xf32>, %arg1: memref<2x4xf32>) -> f32 {
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %2 = vector.load %reinterpret_cast[%c0] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %c0_i32_0 = arith.constant 0 : i32
// CHECK:     %3 = arith.index_cast %c0_i32_0 : i32 to index
// CHECK:     %c4_1 = arith.constant 4 : index
// CHECK:     %4 = arith.muli %3, %c4_1 : index
// CHECK:     %reinterpret_cast_2 = memref.reinterpret_cast %arg1 to offset: [%4], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %5 = vector.load %reinterpret_cast_2[%c0] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %6 = arith.mulf %2, %5 : vector<4xf32>
// CHECK:     %7 = vector.reduction <add>, %6 : vector<4xf32> into f32
// CHECK:     return %7 : f32
// CHECK:   }
// CHECK:   func.func @sum_row(%arg0: memref<2x4xf32>) -> f32 {
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %2 = vector.load %reinterpret_cast[%c0] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %3 = vector.reduction <add>, %2 : vector<4xf32> into f32
// CHECK:     return %3 : f32
// CHECK:   }
// CHECK:   func.func @max_row(%arg0: memref<2x4xf32>) -> f32 {
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %2 = vector.load %reinterpret_cast[%c0] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %3 = vector.reduction <maximumf>, %2 : vector<4xf32> into f32
// CHECK:     return %3 : f32
// CHECK:   }
// CHECK:   func.func @min_row(%arg0: memref<2x4xf32>) -> f32 {
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %2 = vector.load %reinterpret_cast[%c0] : memref<4xf32, strided<[1], offset: ?>>, vector<4xf32>
// CHECK:     %3 = vector.reduction <minimumf>, %2 : vector<4xf32> into f32
// CHECK:     return %3 : f32
// CHECK:   }
// CHECK: }
