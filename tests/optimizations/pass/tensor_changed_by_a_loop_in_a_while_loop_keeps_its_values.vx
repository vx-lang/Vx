// RUN: vxc %s -O1 --run | FileCheck %s
// RUN: vxc %s -O2 --run | FileCheck %s
//
// The `while` loop runs twice. Each time, the first `0..64` loop adds 1 to
// each element of `a`, and the second one adds the elements to `s`. Loop fusion
// once made the first loop change a copy of `a`, so the second turn started
// from the first values again, and the program printed 256.
//
// 64 * 2 + 64 * 3 = 320.
// CHECK: 320

fn main() -> i32 {
  let mut a = Tensor<f32, [64]>::fill(1.0);
  let mut s = 0.0;
  let mut k = 0;
  while k < 2 {
    for i in 0..64 {
      a[i] = a[i] + 1.0;
    }
    for i in 0..64 {
      s = s + a[i];
    }
    k = k + 1;
  }
  println!("{}", s);
  return 0;
}
