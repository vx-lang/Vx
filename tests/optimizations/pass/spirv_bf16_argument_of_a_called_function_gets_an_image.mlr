//===----------------------------------------------------------------------===//
// A SPIR-V image holds a bf16 value as an i16. A kernel calls `twice`, which
// takes and returns a bf16. The image inlines `twice` into the kernel, so the
// bf16 values are the kernel's own, and the kernel gets an image. LLVM's SPIR-V
// backend used to stop the process on the bf16 type of the function.
//
// RUN: vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s --implicit-check-not='cannot become'
// CHECK-NOT: LLVM ERROR
// CHECK: @k_str("k\00abi=1\00topo=501\00toponame=Dev\00format=spirv\00

module {
  func.func @main(%x: memref<4xbf16>) -> i32 {
    %c0 = arith.constant 0 : i32
    vx.launch @k(%x) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xbf16>) -> ()
    return %c0 : i32
  }
  vx.kernel @k(501) {arch = "spirv64"} : (memref<4xbf16>) -> () {
  ^bb0(%src: memref<4xbf16>):
    vx.return
  }
  gpu.module @kernels {
    func.func @twice(%v: bf16) -> bf16 {
      %r = arith.addf %v, %v : bf16
      return %r : bf16
    }
    gpu.func @k(%src: memref<4xbf16>) kernel {
      %c0 = arith.constant 0 : index
      %v = memref.load %src[%c0] : memref<4xbf16>
      %r = func.call @twice(%v) : (bf16) -> bf16
      memref.store %r, %src[%c0] : memref<4xbf16>
      gpu.return
    }
  }
}
