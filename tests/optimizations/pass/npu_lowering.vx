// LLVM:   %14 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %13, i64 %6, 4, 1
// LLVM:   %15 = call ptr @malloc(i64 64)
// LLVM:   %16 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } poison, ptr %15, 0
// LLVM:   %17 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %16, ptr %15, 1
// LLVM:   %18 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %17, i64 0, 2
// LLVM:   %19 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %18, i64 4, 3, 0
// LLVM:   %20 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %19, i64 4, 3, 1
// LLVM:   %21 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %20, i64 4, 4, 0
// LLVM:   %22 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %21, i64 1, 4, 1
// LLVM:   %23 = alloca { ptr, ptr, i64, [2 x i64], [2 x i64] }, i64 1, align 8
// LLVM:   %24 = insertvalue { ptr, ptr, i64 } poison, ptr %23, 0
// LLVM:   %25 = insertvalue { ptr, ptr, i64 } %24, ptr %23, 1
// LLVM:   %26 = insertvalue { ptr, ptr, i64 } %25, i64 0, 2
// LLVM:   %27 = extractvalue { ptr, ptr, i64 } %26, 1
// LLVM:   store { ptr, ptr, i64, [2 x i64], [2 x i64] } %22, ptr %27, align 8
// LLVM:   %28 = alloca ptr, align 8
// LLVM:   %29 = alloca i32, align 4
// LLVM:   store i32 0, ptr %29, align 4
// LLVM:   store ptr %29, ptr %28, align 8
// LLVM:   %30 = call i64 @vx_plugin_dispatch_async(ptr @vx_npu_kernel_0_str, i64 0, ptr %28)
// LLVM:   ret { ptr, ptr, i64, [2 x i64], [2 x i64] } %14
// LLVM: }
