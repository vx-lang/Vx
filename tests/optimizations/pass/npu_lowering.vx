// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" 2>&1 | FileCheck %s
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s
fn dummy(x : i32) on Topology::NPU[0] -> i32 { return x; }

fn process(t : Tensor<f32>) -> Tensor<f32> {
  let mut res = Tensor<i32>([ 4, 4 ]).with_memory(Memory::NPU_HBM);
  let val = spawn on(Topology::NPU[0]){dummy(0)};
  return t;
}

// NPU: module {
// NPU:   func.func private @printMemrefF32(memref<*xf32>)
// NPU:   func.func private @printMemrefF64(memref<*xf64>)
// NPU:   func.func private @printMemrefI32(memref<*xi32>)
// NPU:   func.func private @printMemrefI64(memref<*xi64>)
// NPU:   func.func private @printMemrefBF16(memref<*xbf16>)
// NPU:   func.func @dummy(%arg0: i32) -> i32 {
// NPU:     return %arg0 : i32
// NPU:   }
// NPU:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// NPU:     %c0_i32 = arith.constant 0 : i32
// NPU:     %c4 = arith.constant 4 : index
// NPU:     %alloc = memref.alloc(%c4, %c4) : memref<?x?xi32>
// NPU:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// NPU:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// NPU:     %0 = vx.launch @vx_npu_kernel_0(%c0_i32) : (i32) -> i32
// NPU:     return %arg0 : memref<?x?xf32>
// NPU:   }
// NPU:   vx.kernel @vx_npu_kernel_0(100) : (i32) -> i32 {
// NPU:   ^bb0(%arg0: i32):
// NPU:     %0 = func.call @dummy(%arg0) : (i32) -> i32
// NPU:     vx.return %0 : i32
// NPU:   }
// NPU: }

