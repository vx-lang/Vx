// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=NPU
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" | FileCheck %s --check-prefix=VXLLVM
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM
fn dummy(x: i32) on Topology::NPU[0] -> i32 {
  return x;
}

fn process(t: Tensor<f32>) -> Tensor<f32> {
  let mut res = Tensor<i32>([4, 4]).with_memory(Memory::NPU_HBM);
  let val = spawn on (Topology::NPU[0]) {
    dummy(0)
  };
  return t;
}

// FRONTEND: module {
// FRONTEND:   func.func private @printMemrefF32(memref<*xf32>)
// FRONTEND:   func.func private @printMemrefF64(memref<*xf64>)
// FRONTEND:   func.func private @printMemrefI32(memref<*xi32>)
// FRONTEND:   func.func private @printMemrefI64(memref<*xi64>)
// FRONTEND:   func.func private @printMemrefBF16(memref<*xbf16>)
// FRONTEND:   func.func @dummy(%arg0: i32) -> i32 {
// FRONTEND:     return %arg0 : i32
// FRONTEND:   }
// FRONTEND:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// FRONTEND:     %c4_i32 = arith.constant 4 : i32
// FRONTEND:     %0 = arith.index_cast %c4_i32 : i32 to index
// FRONTEND:     %c4_i32_0 = arith.constant 4 : i32
// FRONTEND:     %1 = arith.index_cast %c4_i32_0 : i32 to index
// FRONTEND:     %alloc = memref.alloc(%0, %1) : memref<?x?xi32>
// FRONTEND:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// FRONTEND:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// FRONTEND:     %2 = vx.spawn topology(100) {
// FRONTEND:       %c0_i32 = arith.constant 0 : i32
// FRONTEND:       %3 = func.call @dummy(%c0_i32) : (i32) -> i32
// FRONTEND:       vx.yield %3 : i32
// FRONTEND:     } : i32
// FRONTEND:     return %arg0 : memref<?x?xf32>
// FRONTEND:   }
// FRONTEND: }

// NPU: module {
// NPU:   func.func private @printMemrefF32(memref<*xf32>)
// NPU:   func.func private @printMemrefF64(memref<*xf64>)
// NPU:   func.func private @printMemrefI32(memref<*xi32>)
// NPU:   func.func private @printMemrefI64(memref<*xi64>)
// NPU:   func.func private @printMemrefBF16(memref<*xbf16>)
// NPU:   func.func @dummy(%arg0: i32) -> i32 {
// NPU:     return %arg0 : i32
// NPU:   }
// NPU:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// NPU:     %c0_i32 = arith.constant 0 : i32
// NPU:     %c4 = arith.constant 4 : index
// NPU:     %alloc = memref.alloc(%c4, %c4) : memref<?x?xi32>
// NPU:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// NPU:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// NPU:     %0 = vx.dispatch @vx_npu_kernel_0(%c0_i32) : (i32) -> i32
// NPU:     return %arg0 : memref<?x?xf32>
// NPU:   }
// NPU:   func.func @vx_npu_kernel_0(%arg0: i32) -> i32 attributes {vx.kernel, vx.topology = 100 : i32} {
// NPU:     %0 = call @dummy(%arg0) : (i32) -> i32
// NPU:     return %0 : i32
// NPU:   }
// NPU: }

// VXLLVM: module {
// VXLLVM:   func.func private @printMemrefF32(memref<*xf32>)
// VXLLVM:   func.func private @printMemrefF64(memref<*xf64>)
// VXLLVM:   func.func private @printMemrefI32(memref<*xi32>)
// VXLLVM:   func.func private @printMemrefI64(memref<*xi64>)
// VXLLVM:   func.func private @printMemrefBF16(memref<*xbf16>)
// VXLLVM:   func.func @dummy(%arg0: i32) -> i32 {
// VXLLVM:     return %arg0 : i32
// VXLLVM:   }
// VXLLVM:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// VXLLVM:     %c0_i32 = arith.constant 0 : i32
// VXLLVM:     %c4 = arith.constant 4 : index
// VXLLVM:     %alloc = memref.alloc(%c4, %c4) : memref<?x?xi32>
// VXLLVM:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// VXLLVM:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// VXLLVM:     %0 = llvm.mlir.addressof @vx_npu_kernel_0_str : !llvm.ptr
// VXLLVM:     %1 = llvm.mlir.constant(1 : i32) : i32
// VXLLVM:     %2 = llvm.alloca %1 x !llvm.ptr : (i32) -> !llvm.ptr
// VXLLVM:     %3 = llvm.mlir.constant(1 : i32) : i32
// VXLLVM:     %4 = llvm.alloca %3 x i32 : (i32) -> !llvm.ptr
// VXLLVM:     llvm.store %c0_i32, %4 : i32, !llvm.ptr
// VXLLVM:     %5 = llvm.mlir.constant(0 : i32) : i32
// VXLLVM:     %6 = llvm.getelementptr %2[0] : (!llvm.ptr) -> !llvm.ptr, !llvm.ptr
// VXLLVM:     llvm.store %4, %6 : !llvm.ptr, !llvm.ptr
// VXLLVM:     %7 = llvm.mlir.constant(0 : i64) : i64
// VXLLVM:     %8 = llvm.call @vx_plugin_dispatch_async(%0, %7, %2) : (!llvm.ptr, i64, !llvm.ptr) -> i64
// VXLLVM:     %9 = llvm.mlir.constant(0 : i32) : i32
// VXLLVM:     return %arg0 : memref<?x?xf32>
// VXLLVM:   }
// VXLLVM:   func.func @vx_npu_kernel_0(%arg0: i32) -> i32 attributes {vx.kernel, vx.topology = 100 : i32} {
// VXLLVM:     %0 = call @dummy(%arg0) : (i32) -> i32
// VXLLVM:     return %0 : i32
// VXLLVM:   }
// VXLLVM: }

