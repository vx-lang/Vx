// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=NPU
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" 2>&1 | FileCheck %s --check-prefix=VXLLVM
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=VXLLVM
fn dummy(x : i32) on Topology::NPU[0] -> i32 {
  return x;
}

fn process(t : DynTensor<f32>) -> DynTensor<f32> {
  let mut res = Tensor<i32, [4, 4], Memory::NPU_HBM>::uninit();
  let val = spawn on(Topology::NPU[0]) {
    dummy(0)
  };
  return t;
}

// @vx_plugin_dispatch_async(%0, %7, %2) : (!llvm.ptr, i64, !llvm.ptr) -> i64

// CHECK-LABEL: func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK: vx.spawn topology(100)

// A device spawn is outlined: the site becomes a vx.launch naming a vx.kernel that carries
// the topology, and the body moves into it.
// NPU-LABEL: func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// NPU: vx.launch @[[K:[a-z0-9_]+]]() {topology = 100 : i32, vx.topology_name = "NPU[0]"} : () -> i32
// NPU: return %arg0 : memref<?x?xf32>
// NPU: vx.kernel @[[K]](100) : () -> i32 {
// NPU: func.call @dummy(%{{.*}}) : (i32) -> i32
// NPU: vx.return

// vx-to-llvm replaces the launch with the vendor-neutral plugin call, passing a descriptor
// string that carries the kernel name, its topology id and the topology's name -- the ABI a
// worker reads. The kernel itself becomes an ordinary exported function.
// VXLLVM: llvm.func @vx_plugin_dispatch_async(!llvm.ptr, i64, !llvm.ptr, !llvm.ptr, i64) -> i64
// VXLLVM: llvm.mlir.global internal constant @[[S:[a-z0-9_]+]]_str("vx_npu_kernel_0\00topo=100\00toponame=NPU[0]\00")
// VXLLVM: %[[D:.*]] = llvm.mlir.addressof @[[S]]_str : !llvm.ptr
// VXLLVM: llvm.call @vx_plugin_dispatch_async(%[[D]], %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, !llvm.ptr, !llvm.ptr, i64) -> i64
// VXLLVM: @vx_npu_kernel_0() -> i32 attributes {llvm.emit_c_interface}
// VXLLVM-NOT: vx.launch
