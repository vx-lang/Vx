// VXLLVM:     %5 = llvm.mlir.constant(0 : i32) : i32
// VXLLVM:     %6 = llvm.getelementptr %2[0] : (!llvm.ptr) -> !llvm.ptr,
// !llvm.ptr VXLLVM:     llvm.store %4, %6 : !llvm.ptr, !llvm.ptr VXLLVM:     %7
// = llvm.mlir.constant(0 : i64) : i64 VXLLVM:     %8 = llvm.call
