//===----------------------------------------------------------------------===//
// An `across` loop can call `f32::from_bits` more than once, and as the left operand of
// `*`. Each loop must compile to a GPU kernel, with no error that the call needs the CPU.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK-COUNT-3: toponame=Device

import core::num;

pub fn left_operand(y : &mut Tensor<f32, [?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          y[i] = f32::from_bits(w[i]) * 2.0;
        }
      }
    }
  }
  return;
}

pub fn two_lets(y : &mut Tensor<f32, [?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          let a : f32 = f32::from_bits(w[i]);
          let c : f32 = f32::from_bits(w[i] << 16u32);
          y[i] = a + c;
        }
      }
    }
  }
  return;
}

pub fn two_sums(y : &mut Tensor<f32, [?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          let mut s : f32 = 0.0;
          s = s + f32::from_bits(w[i]);
          s = s + f32::from_bits(w[i] << 16u32);
          y[i] = s;
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
