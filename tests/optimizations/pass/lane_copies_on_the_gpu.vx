//===----------------------------------------------------------------------===//
// The PTX of `lanes::copy_async`. Each lane starts a `cp.async` of 16 bytes (`cg`) for each 16
// bytes of its part of the tile, if the addresses let it. Otherwise each lane starts a `cp.async`
// of 4 bytes (`ca`) for each of its elements. The last operand is the number of bytes to read: 0
// for an element past the end of the tensor, so the element is zero. The copies of one call are one group
// (`commit_group`). The wait of a token lets the groups that started after it go on
// (`wait_group n`), and then every lane of the block waits (`bar.sync`). In the code of a
// subgroup, only the lanes of the subgroup wait (`bar.warp.sync`).
//
// RUN: vxc %s --host default --machine fleet/a100-80.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx --implicit-check-not=local_depot
// RUN: vxc %s --legacy-codegen --host default --machine fleet/a100-80.vx --emit-ptx -o %t.ast.ptx
// RUN: FileCheck %s < %t.ast.ptx --implicit-check-not=local_depot
//
// On an `sm_90a` GPU, a copy can use TMA, with a tensor map that the host makes before the
// launch. The launcher of a kernel from `--emit-ptx` passes only the parameters of the function,
// so these kernels use `cp.async` there too.
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t90.ptx
// RUN: FileCheck %s --check-prefix=SM90 < %t90.ptx
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t90.ast.ptx
// RUN: FileCheck %s --check-prefix=SM90 < %t90.ast.ptx
// SM90: .target sm_90a
// SM90: cp.async.ca.shared.global
// SM90-NOT: cp.async.bulk

// Two tiles in flight: the wait for the first lets the second go on. The code of the second copy
// ends with its commit, the wait for the first group, and the reads of the first tile. LLVM puts
// that code first in the text, and the first copy after it.
// CHECK-LABEL: .entry sum_tiles(
// CHECK: .shared .align 16 .b8 {{.*}}[8192];
// CHECK: cp.async.cg.shared.global
// CHECK-NEXT: $L__BB
// CHECK-NEXT: cp.async.commit_group;
// CHECK-NEXT: cp.async.wait_group 1;
// CHECK-NEXT: bar.sync 0;
// CHECK: ld.shared.b32
// CHECK: cp.async.wait_group 0;
// CHECK-NEXT: bar.sync 0;
// CHECK: selp.b32 %r[[ROW:[0-9]+]], 4, 0, %p{{[0-9]+}};
// CHECK: selp.b32 %r[[BYTES:[0-9]+]], %r[[ROW]], 0, %p{{[0-9]+}};
// CHECK-NEXT: cp.async.ca.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 4, %r[[BYTES]];
// CHECK: cp.async.commit_group;
// CHECK: cp.async.ca.shared.global
// CHECK-NOT: cp.async.wait_group
// CHECK-LABEL: .entry three_in_flight(
pub fn sum_tiles(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, steps : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tiles = unsafe {
        Tensor<f32, [2, 32, 32], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes(256) {
        acc[t] = 0.0;
      }
      for k in 0..steps / 2 {
        let even = lanes::copy_async(&mut tiles[0], x, [0, k * 64]);
        let odd = lanes::copy_async(&mut tiles[1], x, [0, k * 64 + 32]);
        even.wait();
        for t in 0..256 across lanes(256) {
          acc[t] = acc[t] + tiles[0][t / 8][t % 8];
        }
        odd.wait();
        for t in 0..256 across lanes(256) {
          acc[t] = acc[t] + tiles[1][t / 8][t % 8];
        }
      }
      for t in 0..256 across lanes(256) {
        out[t] = acc[t];
      }
    }
  }
  return;
}

// Three tiles in flight, waited first, third and second. The first lets the two after it go on,
// and the third none. The second then lets the third go on, which ended already.
// CHECK: cp.async.wait_group 2;
// CHECK-NEXT: bar.sync 0;
// CHECK-NEXT: cp.async.wait_group 0;
// CHECK-NEXT: bar.sync 0;
// CHECK-NEXT: cp.async.wait_group 1;
// CHECK-NEXT: bar.sync 0;
// CHECK-NOT: cp.async
// CHECK-LABEL: .entry rows_of_subgroups(
pub fn three_in_flight(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tiles = unsafe {
        Tensor<f32, [3, 8, 32], Memory::SMEM>::uninit()
      };
      let first = lanes::copy_async(&mut tiles[0], x, [0, 0]);
      let second = lanes::copy_async(&mut tiles[1], x, [8, 0]);
      let third = lanes::copy_async(&mut tiles[2], x, [16, 0]);
      first.wait();
      third.wait();
      second.wait();
      for t in 0..32 across lanes(32) {
        out[t] = tiles[0][0][t] + tiles[1][0][t] + tiles[2][0][t];
      }
    }
  }
  return;
}

// Each of 4 subgroups copies a tile of 64 elements into its own row. In 16 bytes at a time, the
// tile is 16 copies, so lane `t % 32` of the subgroup starts one if `t % 32` is at most 15. In 4
// bytes at a time, the loop goes 32 elements at a time.
// The lane number goes through a 64-bit register on its way to the test.
// CHECK: and.b32 %r[[LANE:[0-9]+]], %r{{[0-9]+}}, 31;
// CHECK-NEXT: cvt.u64.u32 %rd[[LANE64:[0-9]+]], %r[[LANE]];
// CHECK: cp.async.ca.shared.global
// CHECK-NEXT: add.s64 %rd{{[0-9]+}}, %rd{{[0-9]+}}, 32;
// CHECK: cvt.u32.u64 %r[[LANE32:[0-9]+]], %rd[[LANE64]];
// CHECK-NEXT: setp.gt.u32 %p{{[0-9]+}}, %r[[LANE32]], 15;
// CHECK: cp.async.cg.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 16, %r{{[0-9]+}};
// CHECK-NEXT: $L__BB{{[0-9_]+}}:
// CHECK-NEXT: cp.async.commit_group;
// CHECK-NEXT: cp.async.wait_group 0;
// CHECK-NEXT: bar.warp.sync -1;
// CHECK-NOT: bar.sync
// CHECK: ld.shared.b32
// CHECK-NOT: cp.async
pub fn rows_of_subgroups(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut part = unsafe {
        Tensor<f32, [4, 2, 32], Memory::SMEM>::uninit()
      };
      for w in 0..4 across subgroups {
        let copy = lanes::copy_async(&mut part[w], x, [2 * w, 0]);
        copy.wait();
        for t in 0..32 across lanes(32) {
          out[w * 32 + t] = part[w][0][t] + part[w][1][t];
        }
      }
    }
  }
  return;
}

// A place that the host gives. The copy goes 16 bytes at a time if the rows of `x` and the column
// `c` are multiples of 4 elements. The number of bytes to read is 4 for each of the 4 elements
// that is in `x`, so a copy at the end of a row reads fewer. Lane `t` copies the 4 elements from
// column `4 * (t % 8)` of row `t / 8` of the tile.
// CHECK-LABEL: .entry one_wide_tile(
// CHECK: ld.param.b32 %r[[C:[0-9]+]], [one_wide_tile_param_12];
// CHECK: ld.param.b64 %rd[[ROW:[0-9]+]], [one_wide_tile_param_10];
// CHECK: mov.u32 %r[[T:[0-9]+]], %tid.x;
// CHECK-NEXT: cvt.u64.u32 %rd[[T64:[0-9]+]], %r[[T]];
// CHECK: and.b64 %rd[[ROW4:[0-9]+]], %rd[[ROW]], 3;
// CHECK-NEXT: setp.eq.b64 %p[[ROWOK:[0-9]+]], %rd[[ROW4]], 0;
// CHECK: and.b32 %r[[C4:[0-9]+]], %r[[C]], 3;
// CHECK-NEXT: setp.eq.b32 %p[[COK:[0-9]+]], %r[[C4]], 0;
// CHECK-NEXT: and.pred %p[[OK:[0-9]+]], %p[[ROWOK]], %p[[COK]];
// CHECK: @%p[[OK]] bra
// CHECK: cvt.u32.u64 %r[[T32:[0-9]+]], %rd[[T64]];
// CHECK-NEXT: shl.b32 %r[[T4:[0-9]+]], %r[[T32]], 2;
// CHECK-NEXT: and.b32 %r{{[0-9]+}}, %r[[T4]], 28;
// CHECK: min.u64 %rd[[N:[0-9]+]], %rd{{[0-9]+}}, 4;
// CHECK: cvt.u32.u64 %r[[N32:[0-9]+]], %rd[[N]];
// CHECK-NEXT: shl.b32 %r[[BYTES:[0-9]+]], %r[[N32]], 2;
// CHECK: selp.b32 %r[[COL:[0-9]+]], %r[[BYTES]], 0, %p{{[0-9]+}};
// CHECK: selp.b32 %r[[ALL:[0-9]+]], %r[[COL]], 0, %p{{[0-9]+}};
// CHECK-NEXT: cp.async.cg.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 16, %r[[ALL]];
// CHECK: cp.async.ca.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 4,
// CHECK-NOT: cp.async.cg
pub fn one_wide_tile(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, c : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tile = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
      let copy = lanes::copy_async(&mut tile, x, [0, c]);
      copy.wait();
      for t in 0..32 across lanes(32) {
        out[t] = tile[7][t];
      }
    }
  }
  return;
}

// The source `x[k]` starts `k` times the size of `x[0]` from the start of `x`. The copy goes 16
// bytes at a time if that start and the rows of `x[k]` are multiples of 4 elements.
// CHECK-LABEL: .entry tile_of_a_row(
// CHECK: ld.param.b32 %r[[K:[0-9]+]], [tile_of_a_row_param_14];
// CHECK: cvt.s64.s32 %rd[[K64:[0-9]+]], %r[[K]];
// CHECK: mul.lo.s64 %rd[[START:[0-9]+]], %rd{{[0-9]+}}, %rd[[K64]];
// CHECK: or.b64 %rd[[BOTH:[0-9]+]], %rd[[START]], %rd{{[0-9]+}};
// CHECK-NEXT: and.b64 %rd{{[0-9]+}}, %rd[[BOTH]], 3;
// CHECK: cp.async.cg.shared.global
pub fn tile_of_a_row(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?, ?], Memory::HBM>, k : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tile = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
      let copy = lanes::copy_async(&mut tile, &x[k], [0, 0]);
      copy.wait();
      for t in 0..32 across lanes(32) {
        out[t] = tile[7][t];
      }
    }
  }
  return;
}

// Elements of 8 bytes go 2 at a time.
// CHECK-LABEL: .entry eight_byte_tile(
// CHECK: min.u64 %rd{{[0-9]+}}, %rd{{[0-9]+}}, 2;
// CHECK: cp.async.cg.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 16, %r{{[0-9]+}};
// CHECK: cp.async.ca.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 8,
pub fn eight_byte_tile(out : &mut Tensor<i64, [?], Memory::HBM>, x : &Tensor<i64, [?, ?], Memory::HBM>, c : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tile = unsafe { Tensor<i64, [4, 16], Memory::SMEM>::uninit() };
      let copy = lanes::copy_async(&mut tile, x, [0, c]);
      copy.wait();
      for t in 0..16 across lanes(32) {
        out[t] = tile[3][t];
      }
    }
  }
  return;
}

// Elements of 2 bytes go 8 at a time. `cp.async` copies at least 4 bytes, so one element at a time
// is a load and a store, which end before the wait.
// CHECK-LABEL: .entry two_byte_tile(
// CHECK: min.u64 %rd{{[0-9]+}}, %rd{{[0-9]+}}, 8;
// CHECK: cp.async.cg.shared.global [%rd{{[0-9]+}}], [%rd{{[0-9]+}}], 16, %r{{[0-9]+}};
// CHECK: st.shared.b16
// CHECK: ld.global.nc.b16
// CHECK-NOT: cp.async.ca
pub fn two_byte_tile(out : &mut Tensor<bf16, [?], Memory::HBM>, x : &Tensor<bf16, [?, ?], Memory::HBM>, c : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tile = unsafe { Tensor<bf16, [4, 16], Memory::SMEM>::uninit() };
      let copy = lanes::copy_async(&mut tile, x, [0, c]);
      copy.wait();
      for t in 0..16 across lanes(32) {
        out[t] = tile[3][t];
      }
    }
  }
  return;
}

// A row of 6 elements of 4 bytes is not a multiple of 16 bytes, so each copy is one element.
// CHECK-LABEL: .entry narrow_tile(
// CHECK: cp.async.ca.shared.global
// CHECK-NOT: cp.async.cg
pub fn narrow_tile(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tile = unsafe { Tensor<f32, [4, 6], Memory::SMEM>::uninit() };
      let copy = lanes::copy_async(&mut tile, x, [0, 0]);
      copy.wait();
      for t in 0..6 across lanes(32) {
        out[t] = tile[3][t];
      }
    }
  }
  return;
}

// A pipeline: the next copy starts before the wait for this one, so while the lanes add one tile,
// the copy of the other one runs. The token of `even` gets a new copy in each pass. Every lane
// runs that copy and copies its own part of the tile, at an address from its lane. Lane 0 alone
// would copy at the fixed addresses of lane 0, such as `smem_0+128`. The wait comes right after
// the commit of the next copy, and the lanes read `tiles[1]` (1024 bytes on) after its wait. LLVM
// puts the reads of `tiles[1]` first in the text.
// CHECK-LABEL: .entry pipeline(
// CHECK: cp.async.commit_group;
// CHECK: cp.async.commit_group;
// CHECK-NEXT: cp.async.wait_group 1;
// CHECK: bar.sync 0;
// CHECK: ld.shared.b32 %r{{[0-9]+}}, [%rd{{[0-9]+}}+1024];
// CHECK-NOT: smem_{{[0-9]+}}+128]
// CHECK: cp.async.commit_group;
// CHECK-NEXT: cp.async.wait_group 1;
// CHECK: bar.sync 0;
// CHECK: ld.shared.b32
// CHECK-NOT: smem_{{[0-9]+}}+128]
pub fn pipeline(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, steps : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tiles = unsafe {
        Tensor<f32, [2, 8, 32], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe { Tensor<f32, [32], Memory::SMEM>::uninit() };
      for t in 0..32 across lanes(32) {
        acc[t] = 0.0;
      }
      let mut even = lanes::copy_async(&mut tiles[0], x, [0, 0]);
      for k in 0..steps / 2 {
        let odd = lanes::copy_async(&mut tiles[1], x, [0, 64 * k + 32]);
        even.wait();
        for t in 0..32 across lanes(32) {
          acc[t] = acc[t] + tiles[0][0][t];
        }
        even = lanes::copy_async(&mut tiles[0], x, [0, 64 * k + 64]);
        odd.wait();
        for t in 0..32 across lanes(32) {
          acc[t] = acc[t] + tiles[1][0][t];
        }
      }
      even.wait();
      for t in 0..32 across lanes(32) {
        out[t] = acc[t];
      }
    }
  }
  return;
}
