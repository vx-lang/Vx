//===----------------------------------------------------------------------===//
// A `spawn` loop that calls a helper writes one row per pass. When the compiler can show that
// the helper writes only its own variables, the loop splits across threads: the helper takes
// numbers, returns a number, and every call in it is to another such helper. `exp_helper` wraps
// `math.exp` in an `mlir!` block and takes only `f32`, so the launch splits.
//
// `grow_helper` has the same arguments and the same result, and its loop stays on one thread,
// because its body calls a method, which the compiler does not read. The two loops differ only
// in what the callee's body does, so the pair is about purity and not about the arguments.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=SPLIT --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s --check-prefix=SPLIT --implicit-check-not=Error
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=SERIAL --implicit-check-not=Error

// SPLIT: func.func @quiet_through_a_helper{{.*}}() -> f32
// SPLIT-LABEL: func.func @fill_with_exp_helper
// SPLIT: vx.spawn topology(500) {
// SPLIT: func.call @exp_helper
// SPLIT: } {arch = "nvptx64", topology_name = "GPU[0]", {{.*}}vx_parallel_trip = 64 : i64}

// SERIAL-LABEL: func.func @fill_through_a_grower
// SERIAL: vx.spawn topology(500) {
// SERIAL: func.call @grow_helper
// SERIAL-NOT: vx_parallel_trip
// SERIAL: func.func @grow_helper
import core::num;

fn exp_helper(x : f32) on Topology::Any -> f32 {
  return mlir!( inputs : (%a = x : f32), returns : f32, dialects : ["math"]) {
    %r = math.exp %a : f32
    macro.yield %r : f32
  };
}

fn grow_helper(x : f32) on Topology::Any -> f32 {
  return x.exp();
}

fn fill_with_exp_helper() -> f32 {
  let mut o = Tensor<f32, [64, 1], Memory::GPU_HBM>::new();
  spawn on(Topology::GPU) {
    for r in 0..64 {
      o[r][0] = exp_helper(o[r][0]);
    }
  }
  return transfer(o, Memory::CPU_DRAM)[0][0];
}

fn fill_through_a_grower() -> f32 {
  let mut o = Tensor<f32, [64, 1], Memory::GPU_HBM>::new();
  spawn on(Topology::GPU) {
    for r in 0..64 {
      o[r][0] = grow_helper(o[r][0]);
    }
  }
  return transfer(o, Memory::CPU_DRAM)[0][0];
}

// `writes_only()` accepts a call to a function that the compiler has shown writes only its own
// variables, even though that function says nothing about itself.
fn quiet_through_a_helper() on Topology::Any -> f32
ensures writes_only()
{
  return exp_helper(1.0);
}

fn main() -> i32 {
  print(fill_with_exp_helper());
  print(fill_through_a_grower());
  print(quiet_through_a_helper());
  return 0;
}
