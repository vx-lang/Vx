//===- spirv_cast_of_a_tensor_keeps_its_view.mlr ----------------*- MLIR -*-===//
//
// Part of the Vx Project, under the Apache License v2.0 with LLVM Exceptions.
// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// A call site casts a tensor to the type that the function takes, such as
// `memref<4xf32>` to `memref<?xf32>`. Once the call is inlined, the kernel
// reads through that cast. A cast changes only what the type says, so the SPIR-V
// argument flattening reads through the pointer and the offset of the tensor
// that the kernel was given.
//
// RUN: vx-opt %s --pass-pipeline="builtin.module(gpu.module(vx-flatten-spirv-kernel-args))" | FileCheck %s --implicit-check-not=memref.
// CHECK-LABEL: gpu.func @c(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: i64, %arg3: i64, %arg4: i64, %arg5: index
// CHECK: %[[I:[0-9]+]] = arith.index_cast %arg5 : index to i64
// CHECK-NEXT: %[[AT:[0-9]+]] = llvm.add %arg2, %[[I]] : i64
// CHECK-NEXT: %[[P:[0-9]+]] = llvm.getelementptr inbounds %arg1[%[[AT]]] : (!llvm.ptr<1>, i64) -> !llvm.ptr<1>, f32
// CHECK-NEXT: llvm.load %[[P]] : !llvm.ptr<1> -> f32

module {
  gpu.module @kernels {
    gpu.func @c(%src: memref<4xf32>, %i: index) kernel {
      %view = memref.cast %src : memref<4xf32> to memref<?xf32>
      %value = memref.load %view[%i] : memref<?xf32>
      memref.store %value, %src[%i] : memref<4xf32>
      gpu.return
    }
  }
}
