// `?n` in the tensor type of a parameter names that run-time extent. The body and the contracts
// read `n` as a `usize`: on the host, in a closure, in a generic function and in GPU kernels.
// The prover shows each `requires` at the call, from a number in the type of the argument or
// from what the caller knows about its own names. The `spawn` loop of `count_down` still runs
// in parallel.
//
// RUN: VX_NO_AST_FALLBACK=1 vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm 2>/dev/null | grep -o 'launch=[0-9]*' | FileCheck %s --check-prefix=LAUNCH --implicit-check-not=launch=
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --action emit-llvm 2>/dev/null | grep -o 'launch=[0-9]*' | FileCheck %s --check-prefix=LAUNCH --implicit-check-not=launch=
// RUN: env CUDA_VISIBLE_DEVICES= VX_HOST_THREADS=8 VX_NO_AST_FALLBACK=1 vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error --implicit-check-not=W1033 --implicit-check-not=W1009
// RUN: env CUDA_VISIBLE_DEVICES= VX_HOST_THREADS=8 vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error --implicit-check-not=W1033 --implicit-check-not=W1009
//
// LAUNCH: launch=64
//
// OUT: 15 48 2 1 5 10 7
// OUT: 5 7 3 10
// OUT: 3 8
// OUT: 64 63 1
// OUT: 80 82 0

fn area(m : &Tensor<f32, [?rows, ?cols]>) -> usize {
  return rows * cols;
}

// Both `?n` are one extent.
fn dot(a : &Tensor<f32, [?n]>, b : &Tensor<f32, [?n]>) -> f32 {
  let mut s = 0.0;
  for i in 0..n {
    s = s + a[i] * b[i];
  }
  return s;
}

fn quarter(t : &Tensor<f32, [?n]>) -> usize
requires n % 4 == 0
{
  return n / 4;
}

// `k % 8 == 0` shows the `n % 4 == 0` of `quarter`.
fn half_of_quarter(t : &Tensor<f32, [?k]>) -> usize
requires k % 8 == 0
{
  return quarter(t) / 2;
}

fn length(t : &Tensor<f32, [?n]>) -> usize
ensures return == n
{
  return n;
}

// The `ensures` of `length` shows the `ensures` here.
fn positive(t : &Tensor<f32, [?k]>) -> usize
requires k > 0
ensures return > 0
{
  return length(t);
}

// The `ensures` of `length` reaches `r` through a `let`.
fn positive_through_a_let(t : &Tensor<f32, [?k]>) -> usize
requires k > 0
ensures return > 0
{
  let r = length(t);
  return r;
}

// An extent is never below 0.
fn at_least_zero(t : &Tensor<f32, [?n]>) -> usize
ensures return >= 0
{
  return n;
}

// Only the `requires` reads `n`, and `t` is still a parameter that the function uses.
fn checked(t : &Tensor<f32, [?n]>) -> usize
requires n > 2
{
  return 3;
}

fn in_a_closure(t : &Tensor<f32, [?n]>) -> usize {
  let times = |k : usize| k * n;
  return times(2);
}

fn first<T>(t : &Tensor<T, [?n]>) -> usize {
  return n;
}

// The instance of `first` is checked inside this body. Its `n` and its `t` are its own.
fn first_of(u : &Tensor<f32, [?n]>) -> usize {
  let x = first(u);
  return x + n;
}

// A name is not part of the type: the method fits its trait, and `length` fits a `fn` type
// without names.
trait Rows {
  fn rows(self : &Self, t : &Tensor<f32, [?, ?]>) -> usize;
}

struct Counter {
  k : i32,
}

impl Rows for Counter {
  fn rows(self : &Self, t : &Tensor<f32, [?r, ?]>) -> usize {
    return r;
  }
}

fn count_down(out : &mut Tensor<i32, [?n], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for i in 0..64 {
      out[i] = (n as i32) - i;
    }
  }
}

fn write_rows(out : &mut Tensor<i32, [?rows, ?cols], Memory::HBM>) -> void
requires cols % 4 == 0
{
  spawn on(Topology::Device) {
    for t in 0..(rows as i32) across blocks {
      for c in 0..4 across lanes(32) {
        out[t][c] = (cols as i32) * 10 + t;
      }
    }
  }
}

fn main() -> i32 {
  let m = Tensor<f32, [3, 5]>::fill(1.0);
  let a = Tensor<f32, [8]>::fill(2.0);
  let b = Tensor<f32, [8]>::fill(3.0);
  let f = Tensor<f32, [5]>::fill(1.0);
  let g = Tensor<i32, [7]>::fill(1);
  let g2 = Tensor<f32, [7]>::fill(1.0);
  println!("{} {} {} {} {} {} {}", area(&m), dot(&a, &b), quarter(&a), half_of_quarter(&b), positive(&f), in_a_closure(&f), first(&g));
  println!("{} {} {} {}", positive_through_a_let(&f), at_least_zero(&g2), checked(&f), first_of(&f));
  let counter = Counter {
    k : 1
  };
  let as_value : fn(&Tensor<f32, [?]>) -> usize = length;
  println!("{} {}", counter.rows(&m), as_value(&a));

  let mut down = Tensor<i32, [?], Memory::HBM>::new([64]);
  count_down(&mut down);
  let hd = transfer(down, Memory::CPU_DRAM);
  println!("{} {} {}", hd[0], hd[1], hd[63]);

  let mut out = Tensor<i32, [3, 8], Memory::HBM>::fill(0);
  write_rows(&mut out);
  let h = transfer(out, Memory::CPU_DRAM);
  println!("{} {} {}", h[0][0], h[2][3], h[2][4]);
  return 0;
}
