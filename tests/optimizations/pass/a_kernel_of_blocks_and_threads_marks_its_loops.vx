//===----------------------------------------------------------------------===//
// A GPU kernel with one loop of blocks and two loops of threads in it. Both
// code generators mark each loop for the pass that maps it to blocks or
// threads, and put the tile in shared memory (address space 3). The marks
// come in a different order on each code generator.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=vx.parallel_init
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=vx.parallel_init
// CHECK: memref.alloca() {alignment = 16 : i64} : memref<32x1xf32, 3>
// CHECK-DAG: {vx.parallel_binit}
// CHECK-DAG: {vx.parallel_bbound}
// CHECK-DAG: {vx.parallel_bstep}
// CHECK-DAG: {vx.parallel_tinit}
// CHECK-DAG: {vx.parallel_tstep}
// CHECK-DAG: {vx.parallel_tinit}
// CHECK-DAG: {vx.parallel_tstep}
// CHECK: vx_parallel_threads = 32 : i64, vx_parallel_trip = 64 : i64, vx_parallel_two_level}

Memory CPU_DRAM {}

Memory GPU_HBM {
  within: Memory::CPU_DRAM,
  capacity: 24 GiB,
  bandwidth: 300 GB/s,
  managed: cached,
  scope: device
}

Memory SMEM {
  within: Memory::GPU_HBM,
  capacity: 48 KiB,
  bandwidth: 128 B/cyc,
  granule: 1 KiB,
  managed: explicit,
  scope: sm
}

fn rowsum(out : &mut Tensor<f32, [64, 1], Memory::GPU_HBM>, x : &Tensor<f32, [64, 128], Memory::GPU_HBM>) -> void {
  spawn on(Topology::GPU) {
    let mut part = unsafe { Tensor<f32, [32, 1], Memory::SMEM>::uninit() };
    for r in 0..64 {
      for t in 0..32 {
        let mut s : f32 = 0.0;
        for j in 0..4 {
          s = s + x[r][t + j * 32];
        }
        part[t][0] = s;
      }
      barrier();
      for z in 0..1 {
        let mut s : f32 = 0.0;
        for k in 0..32 {
          s = s + part[k][0];
        }
        out[r][z] = s;
      }
      barrier();
    }
  }
  return;
}

fn main() -> i32 {
  let x = transfer(Tensor<f32, [64, 128]>::new(), Memory::GPU_HBM);
  let mut o = transfer(Tensor<f32, [64, 1]>::new(), Memory::GPU_HBM);
  rowsum(&mut o, &x);
  return 0;
}
