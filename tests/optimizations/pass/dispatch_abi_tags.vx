//===----------------------------------------------------------------------===//
// The per-argument tag handed to `vx_plugin_dispatch_async` carries a memref's
// element type and rank, so a plugin can tell what it was given (#321). Before
// this every memref was tag 0 plus an opaque descriptor pointer -- enough to
// pass the argument, not enough to route it to a vendor kernel, since cuBLAS
// picks its kernel by dtype and needs M/N/K.
//
// Layout, from include/vx_hardware_runtime.h:
//
//   bits [7:0]    kind, 0 for a memref (unchanged, so the calling convention
//                 and the libffi mapping are untouched)
//   bits [15:8]   element type code
//   bits [23:16]  rank
//   bit  [24]     slot
//
// So an f16 rank-2 memref is (2 << 16) | (8 << 8) = 133120, and an f32 rank-2
// memref is (2 << 16) | (6 << 8) = 132608. Checking the literals is the point:
// the runtimes decode these by hand, so an encoding change not mirrored in the
// header would otherwise surface only as a plugin misreading a buffer at run
// time -- silently, since the pointer would still be valid.
//
// The local `c` each kernel writes is captured as a *slot*: storage holding a
// descriptor, which is what a kernel stores a result it allocated itself
// through. Described verbatim a slot is a rank-0 memref with no scalar element
// type, which is byte-identical to the opaque-pointer encoding -- so the bit
// says it is a slot and the element type and rank describe what it holds, and
// a plugin computing the result itself knows what to write there. Hence
// (1 << 24) | (2 << 16) | (8 << 8) = 16910336 for f16 and 16909824 for f32.
//
// This lives under optimizations/ rather than middle_end/ because the tag is
// materialized by `vx-to-llvm`, and the middle-end runner checks the module as
// it stands *before* the lowering pipeline.
//
// CHECK lines are matched as ordered substrings, so these follow the order the
// two functions are emitted in, which is the order they are written below.
//
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s
// CHECK: llvm.mlir.constant(16910336 : i32)
// CHECK: llvm.mlir.constant(133120 : i32)
// CHECK: llvm.mlir.constant(16909824 : i32)
// CHECK: llvm.mlir.constant(132608 : i32)

fn half_kernel(a : DynTensor<f16>) -> DynTensor<f16> {
  let mut c = Tensor<f16, [2, 2]>::uninit();
  spawn on(Topology::GPU) {
    for i in 0..2 {
      for j in 0..2 {
        c[i][j] = a[i][j];
      }
    }
  }
  return c;
}

fn single_kernel(a : DynTensor<f32>) -> DynTensor<f32> {
  let mut c = Tensor<f32, [2, 2]>::uninit();
  spawn on(Topology::GPU) {
    for i in 0..2 {
      for j in 0..2 {
        c[i][j] = a[i][j];
      }
    }
  }
  return c;
}
