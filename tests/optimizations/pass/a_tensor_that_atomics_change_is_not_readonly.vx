//===----------------------------------------------------------------------===//
// A `&` tensor parameter is `llvm.readonly`, and a GPU kernel reads it through the read-only
// cache. But the element atomics of `core::sync::atomic` change a tensor through a `&`. Such a
// tensor must not be `readonly`, or the optimizer may drop a write, and a plain read of it may not
// see the atomics. A function that passes its `&` on to an atomic changes it too, and so does a
// function that passes it to that one.
//
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s # flat-codegen

import core::sync::atomic;

// `counts` gets atomic adds in the kernel, and `keys` is only read.
// CHECK-DAG: func.func @histogram(%arg0: memref<?xi32> {vx.align = 16 : i64}, %arg1: memref<?xi32> {llvm.readonly, vx.align = 16 : i64}, %arg2: i32)
// CHECK-DAG: vx.arg_access = ["", "readonly", ""]
pub fn histogram(counts : &Tensor<u32, [?], Memory::HBM>, keys : &Tensor<u32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i : i32 = b * 256 + l;
        if i < n {
          let bin : i32 = (keys[i] & 255u32) as i32;
          let _old = atomic_fetch_add_u32(counts, bin, 1u32, AtomicOrdering::Relaxed);
        }
      }
    }
  }
  return;
}

// CHECK-DAG: func.func @count_one(%arg0: memref<?xi32>, %arg1: i32) {
fn count_one(counts : &Tensor<u32, [?]>, bin : i32) -> void {
  let _old = atomic_fetch_add_u32(counts, bin, 1u32, AtomicOrdering::Relaxed);
  return;
}

// It calls a function that changes `counts`, so it changes `counts` too.
// CHECK-DAG: func.func @count_two(%arg0: memref<?xi32>) {
fn count_two(counts : &Tensor<u32, [?]>) -> void {
  count_one(counts, 0);
  count_one(counts, 1);
  return;
}

// It only reads `counts`, so it keeps the mark.
// CHECK-DAG: func.func @first(%arg0: memref<?xi32> {llvm.readonly}) -> i32 {
fn first(counts : &Tensor<u32, [?]>) -> u32 {
  return counts[0];
}

fn main() -> i32 {
  let counts = Tensor<u32, [4]>::new();
  count_two(&counts);
  return first(&counts) as i32;
}
