//===----------------------------------------------------------------------===//
// A tensor comes back from GPU memory, and a function takes it by value. The GPU plugin
// allocated the tensor, so the caller gives the function a heap copy and frees the tensor once.
// A second free stops the program. The RUN lines hide the GPU, so the plugin keeps "GPU
// memory" on the host.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}5{{$}}

fn filled(v : f32) -> Tensor<f32, [4]> {
  let mut t = unsafe { Tensor<f32, [4]>::uninit() };
  t[0] = v;
  return t;
}

fn first_of(t : Tensor<f32, [4]>) -> f32 {
  let x = t;
  return x[0];
}

fn main() -> i32 {
  let t = transfer(transfer(filled(5.0), Memory::HBM), Memory::CPU_DRAM);
  println!("{}", first_of(t));
  return 0;
}
