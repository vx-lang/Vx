//===----------------------------------------------------------------------===//
// A `spawn on` loop that writes at an offset from the loop variable, `o[lo + r]` with `lo` set
// before the region, gives each pass its own row, so it runs in parallel like `o[r]` does.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s
// CHECK-DAG: launch=1024
// CHECK-DAG: launch=512
//
// Rows 0..512 hold 1 and rows 512..1024 hold 1 + 2, so the sum is 2048 however the passes are
// split across workers. Only the Linux host dispatcher splits a loop.
//
// RUN: env VX_HOST_THREADS=8 vxc %s 2>/dev/null | FileCheck %s --check-prefix=ANSWER
// ANSWER: sum=2048;

fn probe() -> f32 {
  let mut o = Tensor<f32, [1024, 1]>::new();
  let lo = 512;
  spawn on(Topology::GPU) {
    for r in 0..1024 {
      o[r][0] = 1.0;
    }
  }
  spawn on(Topology::GPU) {
    for r in 0..512 {
      o[lo + r][0] = o[lo + r][0] + 2.0;
    }
  }
  let mut sum = 0.0;
  for r in 0..1024 {
    sum = sum + o[r][0];
  }
  return sum;
}

fn main() -> i32 {
  print!("sum=");
  print(probe());
  print!(";");
  return 0;
}
