//===----------------------------------------------------------------------===//
// A lane loop writes `part[t]`, and a lane reduction then reads `part`. When each lane alone
// writes its own element, and only the reduction reads `part`, the GPU kernel keeps the element
// in a register. Then `part` takes no shared memory. In the other cases, `part` stays in shared
// memory.
//
// RUN: vxc %s --host default --machine fleet/a100-80.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx

// The larger value of 256 elements: a multiple of 32, so no lane needs the first element.
// CHECK-LABEL: .entry max_of_256(
// CHECK-NOT: .shared .align 16 .b8 {{.*}}[1024];
// CHECK: shfl.sync.down.b32
// CHECK-LABEL: .entry max_of_100(
pub fn max_of_256(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        part[t] = x[b * 256 + t];
      }
      let m = lanes::max(&part, 256);
      for t in 0..256 across lanes {
        out[b * 256 + t] = m;
      }
    }
  }
  return;
}

// The larger value of 100 elements pads with the first element, and in a block only lane 0 has
// it in a register. So `part` stays.
// CHECK: .shared .align 16 .b8 {{.*}}[1024];
// CHECK-LABEL: .entry read_again(
pub fn max_of_100(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        part[t] = x[b * 256 + t];
      }
      let m = lanes::max(&part, 100);
      for t in 0..256 across lanes {
        out[b * 256 + t] = m;
      }
    }
  }
  return;
}

// A later lane loop reads `part`, so `part` stays.
// CHECK: .shared .align 16 .b8 {{.*}}[1024];
// CHECK-LABEL: .entry reversed(
pub fn read_again(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        part[t] = x[b * 256 + t];
      }
      let s = lanes::sum(&part, 256);
      for t in 0..256 across lanes {
        out[b * 256 + t] = part[t] / s;
      }
    }
  }
  return;
}

// Lane `t` writes `part[255 - t]`, which another lane reads. So `part` stays.
// CHECK: .shared .align 16 .b8 {{.*}}[1024];
// CHECK-LABEL: .entry rows_of_20(
pub fn reversed(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        part[255 - t] = x[b * 256 + t];
      }
      let s = lanes::sum(&part, 256);
      for t in 0..256 across lanes {
        out[b * 256 + t] = s;
      }
    }
  }
  return;
}

// Each subgroup writes its own row of `part`. The larger value of 20 elements pads with the
// first element, which a shuffle takes from lane 0. The lanes from 20 on take it.
// CHECK-NOT: .shared .align 16 .b8 {{.*}}[512];
// CHECK: shfl.sync.idx.b32 %r[[FIRST:[0-9]+]], %r[[OWN:[0-9]+]], 0, 31, -1;
// CHECK-NEXT: selp.f32 %r[[V:[0-9]+]], %r[[OWN]], %r[[FIRST]], %p{{[0-9]+}};
// CHECK-NEXT: shfl.sync.down.b32 {{.*}}, %r[[V]], 16, 31, -1;
pub fn rows_of_20(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [4, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        for t in 0..32 across lanes {
          part[w][t] = x[(b * 4 + w) * 32 + t];
        }
        let m = lanes::max(&part[w], 20);
        for t in 0..32 across lanes {
          out[(b * 4 + w) * 32 + t] = m;
        }
      }
    }
  }
  return;
}

// Each subgroup writes two rows of `part`, `part[w][0]` and `part[w][1]`, and sums each. Each row
// keeps its own register, so `part` takes no shared memory. The sum of row 0 starts from `x`,
// and the sum of row 1 from `x * 2`, which LLVM writes as `x + x`.
// CHECK-LABEL: .entry two_rows_of_each_subgroup(
// CHECK-NOT: .shared .align 16 .b8 {{.*}}[1024];
// CHECK-NOT: ld.shared
// CHECK: ld.global.nc.b32 %r[[X:[0-9]+]],
// CHECK: add.rn.f32 %r[[TWICE:[0-9]+]], %r[[X]], %r[[X]];
// CHECK-NOT: ld.shared
// CHECK: shfl.sync.bfly.b32 %r{{[0-9]+}}, %r[[X]], 16, 31, -1;
// CHECK-NOT: ld.shared
// CHECK: shfl.sync.bfly.b32 %r{{[0-9]+}}, %r[[TWICE]], 16, 31, -1;
// CHECK-LABEL: .entry a_row_that_the_code_picks(
pub fn two_rows_of_each_subgroup(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe {
        Tensor<f32, [4, 2, 32], Memory::SMEM>::uninit()
      };
      for w in 0..4 across subgroups {
        for t in 0..32 across lanes {
          part[w][0][t] = x[(b * 4 + w) * 32 + t];
          part[w][1][t] = x[(b * 4 + w) * 32 + t] * 2.0;
        }
        let s0 = lanes::sum(&part[w][0], 32);
        let s1 = lanes::sum(&part[w][1], 32);
        for t in 0..32 across lanes {
          out[(b * 4 + w) * 32 + t] = s0 - s1;
        }
      }
    }
  }
  return;
}

// The row `part[w][k]` depends on `k`, which the code picks at run time. So the row has no
// register of its own, and `part` stays in shared memory.
// CHECK: .shared .align 16 .b8 {{.*}}[1024];
pub fn a_row_that_the_code_picks(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, rows : i32, k : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe {
        Tensor<f32, [4, 2, 32], Memory::SMEM>::uninit()
      };
      for w in 0..4 across subgroups {
        for t in 0..32 across lanes {
          part[w][k][t] = x[(b * 4 + w) * 32 + t];
        }
        let s = lanes::sum(&part[w][k], 32);
        for t in 0..32 across lanes {
          out[(b * 4 + w) * 32 + t] = s;
        }
      }
    }
  }
  return;
}
