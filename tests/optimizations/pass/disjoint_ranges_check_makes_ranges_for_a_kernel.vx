//===----------------------------------------------------------------------===//
// `DisjointRanges::check(t)` reads the ranges `[t[i][0], t[i][1])` on the CPU. It gives a
// `DisjointRanges` table when no two ranges overlap, and `None` when two do or when a range ends
// before it starts. Here the ranges [5, 7), [0, 3), [3, 5) and [7, 7) pass the check and move to
// the GPU. Block `t` writes `10 * t + r` into the rows of range `t`, and row 7 keeps -1. The
// first table passes although its ranges are not in order. The other tables test the check alone.
// An empty range overlaps a range around it, but not a range that starts where it is. The `u64`
// ranges meet at 2^63. The program needs no `unsafe`.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error

// CHECK: rows: 10 11 12 20 21 0 1 -1
// CHECK-NEXT: [6, 8) [0, 7): overlap
// CHECK-NEXT: [0, 4) [5, 3): overlap
// CHECK-NEXT: [0, 10) [5, 5): overlap
// CHECK-NEXT: [3, 3) [3, 5): disjoint
// CHECK-NEXT: i64 [-5, -1) [-1, 4): disjoint
// CHECK-NEXT: i64 [-5, 0) [-1, 4): overlap
// CHECK-NEXT: u64 [0, 2^63) [2^63, max): disjoint
// CHECK-NEXT: u64 [2^63, max) [2^63 + 1, 2^63 + 2): overlap

import core::option;

fn write_rows(out : &mut Tensor<f32, [?, ?], Memory::HBM>, tiles : &DisjointRanges<Tensor<i32, [?, 2], Memory::HBM>>) -> void {
  spawn on(Topology::Device) {
    for t in 0..tiles.len() across blocks {
      for r in 0..4 across lanes(32) {
        let row = (tiles[t][0] as i64) + (r as i64);
        if row < (tiles[t][1] as i64) {
          out[row][0] = (10 * t + r) as f32;
        }
      }
    }
  }
  return;
}

fn say_i32(o : Option<DisjointRanges<Tensor<i32, [?, 2]>>>) -> void {
  match o {
    Option<DisjointRanges<Tensor<i32, [?, 2]>>>::Some(_d) => {
      println!("disjoint");
    }
    Option<DisjointRanges<Tensor<i32, [?, 2]>>>::None => {
      println!("overlap");
    }
  }
  return;
}

fn say_i64(o : Option<DisjointRanges<Tensor<i64, [?, 2]>>>) -> void {
  match o {
    Option<DisjointRanges<Tensor<i64, [?, 2]>>>::Some(_d) => {
      println!("disjoint");
    }
    Option<DisjointRanges<Tensor<i64, [?, 2]>>>::None => {
      println!("overlap");
    }
  }
  return;
}

fn say_u64(o : Option<DisjointRanges<Tensor<u64, [?, 2]>>>) -> void {
  match o {
    Option<DisjointRanges<Tensor<u64, [?, 2]>>>::Some(_d) => {
      println!("disjoint");
    }
    Option<DisjointRanges<Tensor<u64, [?, 2]>>>::None => {
      println!("overlap");
    }
  }
  return;
}

/// The two ranges `[a, b)` and `[c, d)`.
fn two(a : i32, b : i32, c : i32, d : i32) -> Tensor<i32, [?, 2]> {
  let mut t = Tensor<i32, [?, 2]>::new([2, 2]);
  t[0][0] = a;
  t[0][1] = b;
  t[1][0] = c;
  t[1][1] = d;
  return t;
}

fn two_i64(a : i64, b : i64, c : i64, d : i64) -> Tensor<i64, [?, 2]> {
  let mut t = Tensor<i64, [?, 2]>::new([2, 2]);
  t[0][0] = a;
  t[0][1] = b;
  t[1][0] = c;
  t[1][1] = d;
  return t;
}

fn two_u64(a : u64, b : u64, c : u64, d : u64) -> Tensor<u64, [?, 2]> {
  let mut t = Tensor<u64, [?, 2]>::new([2, 2]);
  t[0][0] = a;
  t[0][1] = b;
  t[1][0] = c;
  t[1][1] = d;
  return t;
}

fn main() -> i32 {
  let mut table = Tensor<i32, [4, 2]>::fill(0);
  table[0][0] = 5;
  table[0][1] = 7;
  table[1][0] = 0;
  table[1][1] = 3;
  table[2][0] = 3;
  table[2][1] = 5;
  table[3][0] = 7;
  table[3][1] = 7;
  match DisjointRanges::check(table) {
    Option<DisjointRanges<Tensor<i32, [4, 2]>>>::Some(ranges) => {
      let tiles = transfer(ranges, Memory::HBM);
      let mut y = transfer(Tensor<f32, [8, 1]>::fill(-1.0), Memory::HBM);
      write_rows(&mut y, &tiles);
      let h = transfer(y, Memory::CPU_DRAM);
      println!("rows: {} {} {} {} {} {} {} {}", h[0][0], h[1][0], h[2][0], h[3][0], h[4][0], h[5][0], h[6][0], h[7][0]);
    }
    Option<DisjointRanges<Tensor<i32, [4, 2]>>>::None => {
      println!("rows: overlap");
    }
  }

  print!("[6, 8) [0, 7): ");
  say_i32(DisjointRanges::check(two(6, 8, 0, 7)));
  print!("[0, 4) [5, 3): ");
  say_i32(DisjointRanges::check(two(0, 4, 5, 3)));
  print!("[0, 10) [5, 5): ");
  say_i32(DisjointRanges::check(two(0, 10, 5, 5)));
  print!("[3, 3) [3, 5): ");
  say_i32(DisjointRanges::check(two(3, 3, 3, 5)));

  print!("i64 [-5, -1) [-1, 4): ");
  say_i64(DisjointRanges::check(two_i64(-5i64, -1i64, -1i64, 4i64)));
  print!("i64 [-5, 0) [-1, 4): ");
  say_i64(DisjointRanges::check(two_i64(-5i64, 0i64, -1i64, 4i64)));

  let half = 9223372036854775808u64;
  let max = 18446744073709551615u64;
  print!("u64 [0, 2^63) [2^63, max): ");
  say_u64(DisjointRanges::check(two_u64(0u64, half, half, max)));
  print!("u64 [2^63, max) [2^63 + 1, 2^63 + 2): ");
  say_u64(DisjointRanges::check(two_u64(half, max, half + 1u64, half + 2u64)));
  return 0;
}
