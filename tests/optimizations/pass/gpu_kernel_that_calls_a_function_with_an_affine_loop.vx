//===----------------------------------------------------------------------===//
// The kernel calls `count_up`, whose loop is an `affine.for`. The kernel still runs on the GPU:
// the device pipeline lowers the loop to branches.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s
// RUN: vxc %s -O2 --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s
// MLIR-LABEL: func.func @count_up
// MLIR: affine.for
// CHECK-NOT: runs on the CPU
// CHECK: image={{.*}}.entry vx_npu_kernel_0

fn count_up(n : i32) on Topology::GPU -> f32 {
  let mut s = 0.0;
  for k in 0..n {
    s = s + 1.0;
  }
  return s;
}

fn main() -> i32 {
  let x_host = Tensor<f32, [32]>::new();
  let mut x = transfer(x_host, Memory::GPU_HBM);
  spawn on(Topology::GPU) {
    for i in 0..32 {
      x[i] = count_up(4);
    }
  }
  let r = transfer(x, Memory::CPU_DRAM);
  print(r[3]);
  return 0;
}
