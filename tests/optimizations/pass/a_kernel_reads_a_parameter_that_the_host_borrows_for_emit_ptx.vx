//===----------------------------------------------------------------------===//
// The host passes `&n` to a function, so `n` gets a stack slot of the host. The kernel after it
// reads `n` as the bound of its loop of blocks. A GPU cannot read that slot. `n` cannot change,
// so the kernel must use the value of the parameter. `--emit-ptx` refused the kernel because it
// used a value that was not a parameter.
//
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx
// CHECK: .entry fill_rows(

fn show(x : &i32) -> void {
  println!("rows: {}", *x);
}

pub fn fill_rows(y : &mut Tensor<f32, [?, ?], Memory::HBM>, n : i32) -> void {
  show(&n);
  spawn on(Topology::Device) {
    for row in 0..n across blocks {
      for l in 0..32 across lanes(32) {
        y[row][l] = 1.0;
      }
    }
  }
  return;
}
