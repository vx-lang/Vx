// RUN: vxc %s -x mlir --action emit-mlir -X mlir=--pass-pipeline="builtin.module(func.func(convert-linalg-to-affine-loops),func.func(affine-loop-unroll{unroll-factor=4}))"

module {
  func.func @test_unroll(%arg0: memref<16xf32>, %arg1: memref<16xf32>) -> memref<16xf32> {
    %alloc = memref.alloc() : memref<16xf32>
    linalg.add ins(%arg0, %arg1 : memref<16xf32>, memref<16xf32>) outs(%alloc : memref<16xf32>)
    return %alloc : memref<16xf32>
  }
}

// CHECK: func.func @test_unroll
// CHECK: affine.for
// CHECK: step 4
// CHECK:   affine.load
// CHECK:   affine.load
// CHECK:   arith.addf
// CHECK:   affine.store
// CHECK:   affine.load
// CHECK:   affine.load
// CHECK:   arith.addf
// CHECK:   affine.store
// CHECK:   affine.load
// CHECK:   affine.load
// CHECK:   arith.addf
// CHECK:   affine.store
// CHECK:   affine.load
// CHECK:   affine.load
// CHECK:   arith.addf
// CHECK:   affine.store
