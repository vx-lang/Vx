//===----------------------------------------------------------------------===//
// Kernels from the `across` design on #252 that the checker accepts with no error:
//
// - `rmsnorm`: each lane writes `y[row][k * 256 + t]`, which fixes `t` because `k` is below 16
//   and `t` below 256. Lane 0 sums the partial sums and writes `part[0]`, and a later lane loop
//   reads `part[0]` from shared memory.
// - `warps`: a subgroup takes the row `b * 4 + w`, and `if row < rows` reads only `b`, `w` and the
//   host's `rows`, so every lane of the subgroup takes the same branch.
// - `tiles`: a 16x16 tile for each block, in a plain loop whose bound comes from the host.
// - `zeroed`: lane 0 fills a tensor in shared memory with zeros, and then every lane reads it.
//   The tensor is memory of the block, not a value that only lane 0 has.
// - `one_lane`: `b + t` fixes `b`, because the lane loop has one pass.
// - `positive_rows`: every lane gets the same result from a lane reduction, so it can be the
//   condition of an `if` around a lane loop.
// - `clamped`: in a plain loop around a lane loop, an `if` with no `break`, `continue` or
//   `return` reads a value that only lane 0 has. Every lane still gets to the barrier.
// - `widening_cast`: an `i64` holds every `i32`, so `b as i64` keeps the value of `b`.
// - `negated`: `-b + n - 1` fixes `b`, and its coefficients fit an `i32`.
// - `cast_inside_its_range`: `(b as u8) as i32` keeps the value of `b`, because `b` is below 200.
// - `first_of_each_block`: only the lane with `l == 0` writes `out[b]`, so no two lanes write it.
// - `first_when_large`: the same, with `l == 0` as one side of `&&`.
// - `rope_pairs`: each lane writes `2 * j` and `2 * j + 1`, and no two lanes make them equal.
// - `rope_halves`: each lane writes `j` and `j + 32`, with `j` below 32.
// - `pixels_with_alpha`: each lane writes the colors `x * 4 + c`, with `c` below 3, and the alpha
//   `x * 4 + 3`. The two indices differ by 1 to 3, less than 4, so no two lanes make them equal.
// - `bytes_to_floats`: `f32::from` says `ensures writes_only()`, so a lane can call it.
// - `grid_of_tiles`: one block loop covers a grid of tiles. The row index fixes `blk / nt` and the
//   column index fixes `blk % nt`, so the two together fix `blk`. `nt` is a factor of the loop's
//   end, so when it is zero the loop has no passes.
// - `quarters`: subgroup `w` writes the quarter `(w / 2, w % 2)` of a tile. In the lane loop,
//   `w / 2` and `w % 2` are the same in every pass.
//
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --allow-empty --implicit-check-not=Error

import core::convert;
import core::num;

pub fn rmsnorm(y : &mut Tensor<f32, [?, 4096], Memory::HBM>, x : &Tensor<f32, [?, 4096], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for row in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        let mut s : f32 = 0.0;
        for k in 0..16 {
          let v = x[row][k * 256 + t];
          s = s + v * v;
        }
        part[t] = s;
      }
      let mut total : f32 = 0.0;
      for t in 0..256 {
        total = total + part[t];
      }
      part[0] = total;
      for t in 0..256 across lanes {
        let inv = 1.0 / (part[0] / 4096.0 + 0.00001).sqrt();
        for k in 0..16 {
          y[row][k * 256 + t] = x[row][k * 256 + t] * inv;
        }
      }
    }
  }
  return;
}

pub fn warps(y : &mut Tensor<f32, [?, ?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, cols : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(rows + 3) / 4 across blocks {
      for w in 0..4 across subgroups {
        let row = b * 4 + w;
        if row < rows {
          for c in 0..cols across lanes(32) {
            y[row][c] = x[row][c] * scale;
          }
        }
      }
    }
  }
  return;
}

pub fn tiles(y : &mut Tensor<f32, [?, ?, 256], Memory::HBM>, n : i32, steps : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for s in 0..steps {
        for i in 0..16 across lanes {
          for j in 0..16 across lanes {
            y[b][s][i * 16 + j] = 1.0;
          }
        }
      }
    }
  }
  return;
}

pub fn zeroed(y : &mut Tensor<f32, [?, 64], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      let mut part = Tensor<f32, [64], Memory::SMEM>::fill(0.0);
      for t in 0..64 across lanes {
        y[b][t] = part[t];
      }
    }
  }
  return;
}

pub fn one_lane(y : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for t in 0..1 across lanes {
        y[b + t] = 1.0;
      }
    }
  }
  return;
}

pub fn positive_rows(y : &mut Tensor<f32, [?, 128], Memory::HBM>, x : &Tensor<f32, [?, 128], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      let mut part = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
      for t in 0..128 across lanes {
        part[t] = x[b][t];
      }
      let total = lanes::sum(&part, 128);
      if total > 0.0 {
        for t in 0..128 across lanes {
          y[b][t] = x[b][t] / total;
        }
      }
    }
  }
  return;
}

pub fn clamped(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, passes : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut a = unsafe { Tensor<f32, [4, 32], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        let mut acc : f32 = 0.0;
        for p in 0..passes {
          for l in 0..32 across lanes {
            a[w][l] = x[(p * 4 + w) * 32 + l];
          }
          let total = lanes::sum(&a[w], 32);
          let scaled : f32 = total * 2.0;
          let r : f32 = if scaled < 0.0 {
            0.0
          } else {
            scaled
          };
          acc = acc + r;
          if acc > 100.0 {
            acc = 100.0;
          }
        }
        out[w] = acc;
      }
    }
  }
  return;
}

pub fn widening_cast(y : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      y[b as i64] = 1.0;
    }
  }
  return;
}

pub fn negated(y : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      y[-b + n - 1] = 1.0;
    }
  }
  return;
}

pub fn cast_inside_its_range(y : &mut Tensor<f32, [200], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..200 across blocks {
      y[(b as u8) as i32] = 1.0;
    }
  }
  return;
}

pub fn first_of_each_block(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for l in 0..32 across lanes {
        if l == 0 {
          out[b] = x[b * 32 + l];
        }
      }
    }
  }
  return;
}

pub fn first_when_large(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for l in 0..32 across lanes {
        if n > 2 && 0 == l {
          out[b] = x[b * 32 + l];
        }
      }
    }
  }
  return;
}

pub fn rope_pairs(out : &mut Tensor<f32, [?, ?, 64], Memory::HBM>, x : &Tensor<f32, [?, ?, 64], Memory::HBM>, c : &Tensor<f32, [?, 32], Memory::HBM>, s : &Tensor<f32, [?, 32], Memory::HBM>, tokens : i32, heads : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..tokens across blocks {
      for h in 0..heads across blocks {
        for j in 0..32 across lanes {
          let a = x[t][h][2 * j];
          let b = x[t][h][2 * j + 1];
          out[t][h][2 * j] = a * c[t][j] - b * s[t][j];
          out[t][h][2 * j + 1] = a * s[t][j] + b * c[t][j];
        }
      }
    }
  }
  return;
}

pub fn rope_halves(out : &mut Tensor<f32, [?, ?, 64], Memory::HBM>, x : &Tensor<f32, [?, ?, 64], Memory::HBM>, c : &Tensor<f32, [?, 32], Memory::HBM>, s : &Tensor<f32, [?, 32], Memory::HBM>, tokens : i32, heads : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..tokens across blocks {
      for h in 0..heads across blocks {
        for j in 0..32 across lanes {
          let a = x[t][h][j];
          let b = x[t][h][j + 32];
          out[t][h][j] = a * c[t][j] - b * s[t][j];
          out[t][h][j + 32] = a * s[t][j] + b * c[t][j];
        }
      }
    }
  }
  return;
}

pub fn pixels_with_alpha(out : &mut Tensor<u8, [?, ?], Memory::HBM>, rows : i32, cols : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..rows across blocks {
      for x in 0..cols across lanes(256) {
        for c in 0..3 {
          out[y][x * 4 + c] = 128;
        }
        out[y][x * 4 + 3] = 255;
      }
    }
  }
  return;
}

pub fn bytes_to_floats(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<u8, [?, ?], Memory::HBM>, rows : i32, cols : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..rows across blocks {
      for x in 0..cols across lanes(256) {
        dst[y][x] = f32::from(src[y][x]);
      }
    }
  }
  return;
}

pub fn grid_of_tiles(c : &mut Tensor<f32, [?, ?], Memory::HBM>, mt : i32, nt : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..mt * nt across blocks {
      let bm = blk / nt;
      let bn = blk % nt;
      for j in 0..32 across lanes {
        for i in 0..64 {
          c[bm * 64 + i][bn * 64 + j] = 0.0;
          c[bm * 64 + i][bn * 64 + j + 32] = 1.0;
        }
      }
    }
  }
  return;
}

pub fn quarters(c : &mut Tensor<f32, [?, 64, 64], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for w in 0..4 across subgroups {
        for j in 0..32 across lanes {
          for i in 0..32 {
            c[b][(w / 2) * 32 + i][(w % 2) * 32 + j] = 0.0;
          }
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
