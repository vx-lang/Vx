//===----------------------------------------------------------------------===//
// On `sm_120a`, `lanes::matmul_scaled` runs on the tensor cores: one block-scaled
// `mma.sync.m16n8k64` for each 16 x 8 piece of `acc` and each 64 values of k. NVFP4 tiles, with an
// `f8e4m3` scale for 16 values, use `kind::mxf4nvf4` with 4 scales in a register. The scales
// lose their sign bit first. MXFP4 tiles, with an `f8e8m0` scale for 32 values, use `kind::mxf4`
// with 2 scales in a register. The instruction needs PTX 8.7. Plain `sm_120` has no such
// instruction, so there the matmul is a loop. No test here runs the code: CI has no such GPU.
//
// RUN: env VX_GPU_CHIP=sm_120a vxc %s --host default --machine fleet/b200.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx
// RUN: env VX_GPU_CHIP=sm_120a vxc %s --legacy-codegen --host default --machine fleet/b200.vx --emit-ptx -o %t.ast.ptx
// RUN: FileCheck %s < %t.ast.ptx
// RUN: env VX_GPU_CHIP=sm_120 vxc %s --host default --machine fleet/b200.vx --emit-ptx -o %t.plain.ptx
// RUN: FileCheck %s --check-prefix=PLAIN --implicit-check-not=mma < %t.plain.ptx
// CHECK: .version 8.{{[7-9]}}
// CHECK-LABEL: .entry nvfp4_tiles(
// CHECK: and.b{{16|32}} {{%rs?[0-9]+}}, {{%rs?[0-9]+}}, 127;
// CHECK: mma.sync.aligned.m16n8k64.row.col.kind::mxf4nvf4.block_scale.scale_vec::4X.f32.e2m1.e2m1.f32.ue4m3
// CHECK: bar.warp.sync
// CHECK-LABEL: .entry mxfp4_tiles(
// CHECK-NOT: , 127;
// CHECK: mma.sync.aligned.m16n8k64.row.col.kind::mxf4.block_scale.scale_vec::2X.f32.e2m1.e2m1.f32.ue8m0
// CHECK: bar.warp.sync
// PLAIN-LABEL: .entry nvfp4_tiles(
// PLAIN-LABEL: .entry mxfp4_tiles(

pub fn nvfp4_tiles(c : &mut Tensor<f32, [?, 16, 16], Memory::HBM>, a : &Tensor<f4e2m1, [?, 128], Memory::HBM>, sa : &Tensor<f8e4m3, [?, 8], Memory::HBM>, b : &Tensor<f4e2m1, [128, 16], Memory::HBM>, sb : &Tensor<f8e4m3, [8, 16], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut ta = unsafe {
        Tensor<f4e2m1, [16, 128], Memory::SMEM>::uninit()
      };
      let mut tsa = unsafe { Tensor<f8e4m3, [16, 8], Memory::SMEM>::uninit() };
      let mut tb = unsafe {
        Tensor<f4e2m1, [128, 16], Memory::SMEM>::uninit()
      };
      let mut tsb = unsafe { Tensor<f8e4m3, [8, 16], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [1, 16, 16], Memory::SMEM>::uninit()
      };
      for w in 0..1 across subgroups {
        for i in 0..32 across lanes {
          if i < 16 {
            for k in 0..128 {
              ta[i][k] = a[blk * 16 + i][k];
            }
            for q in 0..8 {
              tsa[i][q] = sa[blk * 16 + i][q];
            }
            for j in 0..16 {
              acc[w][i][j] = 0.0;
            }
          }
          for k2 in 0..4 {
            for j in 0..16 {
              tb[i * 4 + k2][j] = b[i * 4 + k2][j];
            }
          }
          if i < 8 {
            for j in 0..16 {
              tsb[i][j] = sb[i][j];
            }
          }
        }
        lanes::matmul_scaled(&mut acc[w], &ta, &tsa, &tb, &tsb);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..16 {
              c[blk][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}

pub fn mxfp4_tiles(c : &mut Tensor<f32, [?, 16, 16], Memory::HBM>, a : &Tensor<f4e2m1, [?, 128], Memory::HBM>, sa : &Tensor<f8e8m0, [?, 4], Memory::HBM>, b : &Tensor<f4e2m1, [128, 16], Memory::HBM>, sb : &Tensor<f8e8m0, [4, 16], Memory::HBM>, blocks : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..blocks across blocks {
      let mut ta = unsafe {
        Tensor<f4e2m1, [16, 128], Memory::SMEM>::uninit()
      };
      let mut tsa = unsafe { Tensor<f8e8m0, [16, 4], Memory::SMEM>::uninit() };
      let mut tb = unsafe {
        Tensor<f4e2m1, [128, 16], Memory::SMEM>::uninit()
      };
      let mut tsb = unsafe { Tensor<f8e8m0, [4, 16], Memory::SMEM>::uninit() };
      let mut acc = unsafe {
        Tensor<f32, [1, 16, 16], Memory::SMEM>::uninit()
      };
      for w in 0..1 across subgroups {
        for i in 0..32 across lanes {
          if i < 16 {
            for k in 0..128 {
              ta[i][k] = a[blk * 16 + i][k];
            }
            for q in 0..4 {
              tsa[i][q] = sa[blk * 16 + i][q];
            }
            for j in 0..16 {
              acc[w][i][j] = 0.0;
            }
          }
          for k2 in 0..4 {
            for j in 0..16 {
              tb[i * 4 + k2][j] = b[i * 4 + k2][j];
            }
          }
          if i < 4 {
            for j in 0..16 {
              tsb[i][j] = sb[i][j];
            }
          }
        }
        lanes::matmul_scaled(&mut acc[w], &ta, &tsa, &tb, &tsb);
        for i in 0..32 across lanes {
          if i < 16 {
            for j in 0..16 {
              c[blk][i][j] = acc[w][i][j];
            }
          }
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
