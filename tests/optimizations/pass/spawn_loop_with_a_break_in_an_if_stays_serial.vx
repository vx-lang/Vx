// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// A `break` inside an `if` leaves the `spawn on` loop. Run in order it stops every later pass;
// split across workers or GPU threads it would stop only the one that reached it. So the loop
// must not be split, and the kernel asks for no worker split and carries no launch size:
//
// REQUIRES: flat-codegen
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" 2>&1 | FileCheck %s
// CHECK-NOT: launch=
// CHECK-NOT: vx_host_worker_id
// CHECK: func.func @vx_npu_kernel_0
// CHECK-NOT: vx_host_worker_id
//
// Rows 0 to 9 are written, so 10 rows hold 1. Split across 8 workers, it was 58. Only the
// Linux host dispatcher splits a loop, so on macOS this line passes either way.
//
// RUN: env VX_HOST_THREADS=8 vxc %s 2>/dev/null | FileCheck %s --check-prefix=ANSWER
// ANSWER: written=10;

fn rows_written() -> f32 {
  let mut o = Tensor<f32, [64, 1], Memory::GPU_HBM>::new();
  spawn on(Topology::GPU) {
    for r in 0..64 {
      if r == 10 {
        break;
      }
      o[r][0] = 1.0;
    }
  }
  let back = transfer(o, Memory::CPU_DRAM);
  let mut written = 0.0;
  for r in 0..64 {
    written = written + back[r][0];
  }
  return written;
}

fn main() -> i32 {
  print!("written=");
  print(rows_written());
  print!(";");
  return 0;
}
