//===----------------------------------------------------------------------===//
// `scoped_fence` says `ensures writes_only()`, so the passes of an `across` loop may call it. Each
// of the 128 passes writes its own element of `out`, takes a fence, and adds 1 to `done`. The three
// scopes give three PTX fences: `cta` for a block, `gpu` for the device, and `sys` for the
// system. The host calls it too.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --check-prefix=PTX
// CHECK: out 8128 done 128 host 3
// PTX-DAG: fence.acq_rel.cta
// PTX-DAG: fence.acq_rel.gpu
// PTX-DAG: fence.sc.sys
import core::sync::atomic;

fn main() -> i32 {
  let mut out = transfer(Tensor<i32, [128]>::fill(0), Memory::HBM);
  let done = transfer(Tensor<u32, [1]>::fill(0u32), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..4 across blocks {
      for l in 0..32 across lanes {
        let n = b * 32 + l;
        out[n] = n;
        scoped_fence(AtomicOrdering::Release, FenceScope::Block);
        scoped_fence(AtomicOrdering::AcqRel, FenceScope::Device);
        scoped_fence(AtomicOrdering::SeqCst, FenceScope::System);
        let _d = atomic_fetch_add_u32(&done, 0, 1u32, AtomicOrdering::Relaxed);
      }
    }
  }
  let o = transfer(out, Memory::CPU_DRAM);
  let d = transfer(done, Memory::CPU_DRAM);
  let mut sum = 0;
  for i in 0..128 {
    sum = sum + o[i];
  }
  let h = Tensor<i32, [1]>::fill(3);
  scoped_fence(AtomicOrdering::Acquire, FenceScope::Device);
  println!("out {} done {} host {}", sum, d[0], h[0]);
  return 0;
}
