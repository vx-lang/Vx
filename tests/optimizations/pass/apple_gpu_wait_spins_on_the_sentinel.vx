// A wait of the Apple GPU spins on the sentinel the GPU writes, and blocks in `waitUntilCompleted`
// only when the spin gives up. The sentinel is a tiny kernel run at the end of a batch; when the
// CPU sees it finish, the batch's actual kernels have finished too, so the wait does not block in
// `waitUntilCompleted`, which on this Mac follows the end of the kernels by about 60 us. The spin
// is opt-in, for the probe of `benchmarks/metal_wait_probe.vx` measures it slower than the block
// on this driver: `VX_METAL_SENTINEL=1` turns it on. A short kernel ends long before the spin
// gives up, so the spin ends the wait, and the verbose line names the batch the sentinel ended.
// Each round fills the tensor with a different number (the round index), so a stale read from an
// unfinished kernel will produce the wrong sum.
//
// REQUIRES: macos
// RUN: env VX_METAL_SENTINEL=1 VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.gpu | FileCheck %s --check-prefix=OUT
// RUN: grep -e "Vx Metal" %t.gpu | grep -v -e "bytes of GPU memory" -e "bytes for a batch" -e "the sentinel ended" | FileCheck %s --check-prefix=GPU
//
// OUT: {{^}}sum 28{{$}}
//
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 1 x 1 x 1, block 256
// GPU-NEXT: [Vx Metal] waited for 1 kernel,{{.*}}

import core::convert;
import core::mem;

// dst[i] = v
fn fill(dst : &mut Tensor<f32, [?], Memory::HBM>, n : i32, v : f32) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          dst[i] = v;
        }
      }
    }
  }
  return;
}

extern "C" {
  fn memcpy(dst : *mut f32, src : *const f32 in Memory::HBM, bytes : i64) -> *mut f32;
}

// Reads x[0] on the CPU, in C: the wait for the batch runs through
// `VX_CTRL_WAIT` at the pointer, which is the wait that the spin can end. A
// wait of the tensors themselves blocks in `waitUntilCompleted` instead.
fn read_first(x : *const f32 in Memory::HBM) -> f32 {
  let mut one = Tensor<f32, [1]>::fill(0.0);
  unsafe { memcpy(one.as_mut_ptr(), x, size_of<f32>()); }
  return one[0];
}

fn main() -> i32 {
  let mut x = transfer(Tensor<f32, [256]>::fill(0.0), Memory::HBM);
  let mut sum : f64 = 0.0;
  for round in 0..8 {
    // Fill with the round number cast to f32 so a stale read fails.
    fill(&mut x, 256, round as f32);
    sum = sum + f64::from(read_first(x.as_ptr()));
  }
  // The sum of 0 + 1 + 2 + 3 + 4 + 5 + 6 + 7 is 28.
  println!("sum {}", sum);
  return 0;
}
