//===----------------------------------------------------------------------===//
// Emit real LLVM IR (`.ll`) for each backend and check it carries the right target
// triple and data layout. `--emit-llvm` lowers to the LLVM dialect, tags the module
// with `llvm.target_triple` / `llvm.data_layout` (via `--target <backend>`), then runs
// `mlir-translate` so the output is `.ll`, not LLVM-dialect MLIR. In the `.ll` these
// become `target triple` / `target datalayout` and functions become `define`s.
//
// RUN: vxc %s --emit-llvm --target x86_64 2>&1 | FileCheck %s --check-prefix=X86
// RUN: vxc %s --emit-llvm --target aarch64 2>&1 | FileCheck %s --check-prefix=AARCH64
// RUN: vxc %s --emit-llvm --target nvptx64 2>&1 | FileCheck %s --check-prefix=NVPTX
//
// AMDGPU is the odd one out: producing *valid* AMDGPU `.ll` needs target-specific
// alloca lowering (allocas must live in addrspace(5)), which the target-independent
// lowering does not do. So `--emit-llvm --target amdgcn` fails cleanly at translation
// with a diagnostic instead of emitting invalid IR or crashing.
// RUN: not vxc %s --emit-llvm --target amdgcn 2>&1 | FileCheck %s --check-prefix=AMDGPU

fn main() -> i32 {
  spawn on(Topology::GPU) {
    let _x = 1;
  }
  return 0;
}

// X86: target datalayout = "e-m:e-p270
// X86: target triple = "x86_64-unknown-linux-gnu"
// X86: define i32 @main

// AARCH64: target datalayout = "e-m:e-i8:8:32
// AARCH64: target triple = "aarch64-unknown-linux-gnu"
// AARCH64: define i32 @main

// NVPTX: target datalayout = "e-i64:64-i128:128-v16:16
// NVPTX: target triple = "nvptx64-nvidia-cuda"
// NVPTX: define i32 @main

// AMDGPU: mlir-translate failed
// AMDGPU: alloca on amdgpu must be in addrspace(5)
