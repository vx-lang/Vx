//===----------------------------------------------------------------------===//
// Emit LLVM IR for each backend and check it carries the right target triple and
// data layout. `--target <backend>` tags the module with `llvm.target_triple` /
// `llvm.data_layout` (which `mlir-translate` propagates to the `.ll` module).
//
// RUN: vxc %s --emit-llvm --target x86_64 2>&1 | FileCheck %s --check-prefix=X86
// RUN: vxc %s --emit-llvm --target aarch64 2>&1 | FileCheck %s --check-prefix=AARCH64
// RUN: vxc %s --emit-llvm --target nvptx64 2>&1 | FileCheck %s --check-prefix=NVPTX
// RUN: vxc %s --emit-llvm --target amdgcn 2>&1 | FileCheck %s --check-prefix=AMDGPU

fn main() -> i32 {
  spawn on(Topology::GPU) {
    let x = 1;
  }
  return 0;
}

// X86: llvm.target_triple = "x86_64-unknown-linux-gnu"
// X86: llvm.data_layout = "e-m:e-p270
// X86: llvm.func @main

// AARCH64: llvm.target_triple = "aarch64-unknown-linux-gnu"
// AARCH64: llvm.data_layout = "e-m:e-i8:8:32
// AARCH64: llvm.func @main

// NVPTX: llvm.target_triple = "nvptx64-nvidia-cuda"
// NVPTX: llvm.data_layout = "e-i64:64-i128:128-v16:16
// NVPTX: llvm.func @main

// AMDGPU: llvm.target_triple = "amdgcn-amd-amdhsa"
// AMDGPU: llvm.data_layout = "e-p:64:64-p1:64:64
// AMDGPU: llvm.func @main
