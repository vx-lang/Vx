//
//===----------------------------------------------------------------------===//
// When the NVPTX pipeline cannot make a kernel's image, the compile stops and
// says why. There is no PTX to carry and no quiet host run.
//
// The kernel reads and writes `complex<f32>`. The NVPTX pipeline runs no
// complex-to-LLVM conversion, so `complex.add` survives every stage and the
// module cannot be translated. That is the same shape as
// `spirv_conversion_failure_keeps_the_host_path.mlr`: a kernel the backend
// cannot express, in a program whose host copy could run. The two differ on
// purpose, because the backends do.
//
// RUN: not vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s
// CHECK: cannot compile kernel `k`: the NVPTX pipeline failed
// CHECK-NOT: will run on the host instead
// A device image would name its target. None is emitted, because the compile
// stopped first.
// CHECK-NOT: .target sm_
// CHECK-NOT: image=

module {
  func.func @main() -> i32 {
    %c0 = arith.constant 0 : i32
    %buf = memref.alloc() : memref<4xf32>
    vx.launch @k(%buf) {topology = 100 : i32} : (memref<4xf32>) -> ()
    memref.dealloc %buf : memref<4xf32>
    return %c0 : i32
  }
  vx.kernel @k(100) {arch = "nvptx64"} : (memref<4xf32>) -> () {
  ^bb0(%src: memref<4xf32>):
    vx.return
  }
  gpu.module @kernels {
    gpu.func @k(%src: memref<4xf32>) kernel {
      %c0 = arith.constant 0 : index
      %v = memref.load %src[%c0] : memref<4xf32>
      %c = complex.create %v, %v : complex<f32>
      %sum = complex.add %c, %c : complex<f32>
      %re = complex.re %sum : complex<f32>
      memref.store %re, %src[%c0] : memref<4xf32>
      gpu.return
    }
  }
}
