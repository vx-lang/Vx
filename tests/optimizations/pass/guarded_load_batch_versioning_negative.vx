// Negative tests for guarded load batch versioning.
//
// 1. neg_decreasing_offsets: guards have decreasing offsets (c + 224 down to c).
//    Monotonicity check rejects the batch; all 8 guards remain unversioned.
// 2. neg_bound: guards check against different bounds (cols vs cols2).
// 3. neg_store: intervening memory store to tensor memory between loads.
// 4. neg_u32_compare: guards use unsigned comparisons (ult); only slt is versioned.
// 5. neg_partial_sum: intermediate computation between guards used outside batch.
// 6. neg_scale_between: instruction between comparison and branch.
// 7. neg_if_between: control flow between comparison and branch.
// 8. neg_negative_first_offset: the first guard's offset is negative. The
//    batch is refused, because `c` near the smallest i32 plus that offset can
//    wrap, and the wrap check looks only at the last offset.
// 9. kernel_a100: sm_80 architecture stays unversioned even with valid batch.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t_h100.ptx
// RUN: FileCheck %s --input-file=%t_h100.ptx
// RUN: vxc %s --host default --machine fleet/a100-80.vx --emit-ptx -o %t_a100.ptx
// RUN: FileCheck %s --input-file=%t_a100.ptx --check-prefix=A100

// neg_decreasing_offsets has decreasing offsets, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_decreasing_offsets
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_bound has differing bounds, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_bound
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_store has intervening memory writes, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_store
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_u32_compare uses unsigned comparisons, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_u32_compare
// CHECK: setp.ge.u32
// CHECK-COUNT-7: setp.ge.u32

// neg_partial_sum uses intermediate computation outside the batch, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_partial_sum
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_scale_between has an instruction between cmp and branch, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_scale_between
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_if_between has control flow between cmp and branch, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_if_between
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_negative_first_offset starts at a negative offset, so the batch is
// refused and all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_negative_first_offset
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// kernel_a100 versions on Hopper sm_90:
// CHECK-LABEL: .visible .entry kernel_a100
// CHECK: add.s32 %r{{[0-9]+}}, %r{{[0-9]+}}, 224;
// CHECK: setp.lt.s32 %p{{[0-9]+}}, %r{{[0-9]+}}, %r{{[0-9]+}};

// kernel_a100 remains unversioned on Ampere sm_80:
// A100-LABEL: .visible .entry kernel_a100
// A100: setp.ge.s32
// A100-COUNT-7: setp.ge.s32

pub fn neg_decreasing_offsets(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let t0: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          let t1: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t2: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t3: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t4: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t5: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t6: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t7: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_bound(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32,
cols2: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let t0: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t3: f32 = if c + 96 < cols2 {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_store(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let t0: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2;
          let t3: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_u32_compare(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: u32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: u32 = (lane as u32) + batch * 256;
          let t0: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t3: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[(lane as u32) + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_partial_sum(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let t0: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t3: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let partial: f32 = t0 + t1 + t2 + t3;
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[lane + batch * 32] = partial + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_scale_between(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let ok0: bool = c < cols;
          let scale: f32 = w[c] * 2.0;
          let t0: f32 = if ok0 {
            scale * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t3: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_if_between(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32,
flag: bool
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let ok0: bool = c < cols;
          if flag {
            out[lane + batch * 32] = 1.0;
          }
          let t0: f32 = if ok0 {
            w[c] * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t3: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}

pub fn neg_negative_first_offset(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let t0: f32 = if c + (0 - 32) < cols {
            w[c + (0 - 32)] * x[c + (0 - 32)]
          } else {
            0.0
          };
          let t1: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          let t2: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t3: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t4: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t5: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t6: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t7: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          out[lane] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
}

fn kernel_a100(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for lane in 0..32 across lanes(32) {
        for batch in 0..((cols + 255) / 256) {
          let c: i32 = lane + batch * 256;
          let t0: f32 = if c < cols {
            w[c] * x[c]
          } else {
            0.0
          };
          let t1: f32 = if c + 32 < cols {
            w[c + 32] * x[c + 32]
          } else {
            0.0
          };
          let t2: f32 = if c + 64 < cols {
            w[c + 64] * x[c + 64]
          } else {
            0.0
          };
          let t3: f32 = if c + 96 < cols {
            w[c + 96] * x[c + 96]
          } else {
            0.0
          };
          let t4: f32 = if c + 128 < cols {
            w[c + 128] * x[c + 128]
          } else {
            0.0
          };
          let t5: f32 = if c + 160 < cols {
            w[c + 160] * x[c + 160]
          } else {
            0.0
          };
          let t6: f32 = if c + 192 < cols {
            w[c + 192] * x[c + 192]
          } else {
            0.0
          };
          let t7: f32 = if c + 224 < cols {
            w[c + 224] * x[c + 224]
          } else {
            0.0
          };
          out[lane + batch * 32] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
        }
      }
    }
  }
  return;
}
