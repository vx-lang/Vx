// Negative tests for guarded load batch versioning.
// In neg_bound, guards check against different bounds.
// In neg_store, a memory store inside the loop prevents versioning.
// Under both cases, the compiler must not version the loops.
//
// REQUIRES: flat-codegen
// RUN: env -u VX_GPU_CHIP vxc %s --host default --emit-ptx -o %t.on.ptx
// RUN: env -u VX_GPU_CHIP vxc %s --host default -fno-guarded-load-versioning --emit-ptx -o %t.off.ptx
// RUN: diff %t.on.ptx %t.off.ptx

fn neg_bound(
out: &mut Tensor<f32, [256], Memory::GPU_HBM>,
m: &Tensor<f32, [256, 256], Memory::GPU_HBM>,
v: &Tensor<f32, [256], Memory::GPU_HBM>
) -> void {
  spawn on(Topology::GPU[0]) {
    for batch in 0..256 {
      let mut sum = 0.0;
      for k in 0..8 {
        let col = batch + k * 32;
        if col + 1 < 200 {
          sum += m[batch][col] * v[col];
        }
        if col + 1 < 256 {
          sum += m[batch][col] * v[col];
        }
      }
      out[batch] = sum;
    }
  }
}

fn neg_store(
out: &mut Tensor<f32, [256], Memory::GPU_HBM>,
m: &Tensor<f32, [256, 256], Memory::GPU_HBM>,
v: &Tensor<f32, [256], Memory::GPU_HBM>
) -> void {
  spawn on(Topology::GPU[0]) {
    for batch in 0..256 {
      let mut sum = 0.0;
      for k in 0..8 {
        let col = batch + k * 32;
        if col + 1 < 256 {
          sum += m[batch][col] * v[col];
        }
        out[batch] = 1.0;
      }
      out[batch] = sum;
    }
  }
}
