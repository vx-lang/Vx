//===----------------------------------------------------------------------===//
// Negative tests for guarded load batch versioning.
//
// 1. neg_decreasing: a loop where guards decrease (7 - k < 4).
//    The compiler must not version the loop, and each lane must store 4.0.
// 2. neg_bound: guards check against different bounds (cols vs cols2).
//    The compiler must not version the batch.
// 3. neg_store: an intervening memory store to tensor memory occurs between loads.
//    The compiler must not version across the write.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s --input-file=%t.ptx

// neg_decreasing must compute and store 4.0 (0x40800000 = 1082130432):
// CHECK-LABEL: .visible .entry neg_decreasing
// CHECK: st.global.b32 [{{%rd[0-9]+}}], 1082130432;

// neg_bound has differing bounds, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_bound
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

// neg_store has intervening memory writes, so all 8 guards remain unversioned:
// CHECK-LABEL: .visible .entry neg_store
// CHECK: setp.ge.s32
// CHECK-COUNT-7: setp.ge.s32

pub fn neg_decreasing(out: &mut Tensor<f32, [?], Memory::HBM>, n: i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for i in 0..32 across lanes(32) {
        let mut sum: f32 = 0.0;
        for k in 0..8 {
          if 7 - k < 4 {
            sum = sum + 1.0;
          }
        }
        if i < n {
          out[i] = sum;
        }
      }
    }
  }
  return;
}

pub fn neg_bound(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32,
cols2: i32
) -> void {
  spawn on(Topology::Device) {
    for batch in 0..((cols + 255) / 256) {
      let c: i32 = batch * 256;
      let t0: f32 = if c < cols {
        w[c] * x[c]
      } else {
        0.0
      };
      let t1: f32 = if c + 32 < cols {
        w[c + 32] * x[c + 32]
      } else {
        0.0
      };
      let t2: f32 = if c + 64 < cols {
        w[c + 64] * x[c + 64]
      } else {
        0.0
      };
      let t3: f32 = if c + 96 < cols2 {
        w[c + 96] * x[c + 96]
      } else {
        0.0
      };
      let t4: f32 = if c + 128 < cols {
        w[c + 128] * x[c + 128]
      } else {
        0.0
      };
      let t5: f32 = if c + 160 < cols {
        w[c + 160] * x[c + 160]
      } else {
        0.0
      };
      let t6: f32 = if c + 192 < cols {
        w[c + 192] * x[c + 192]
      } else {
        0.0
      };
      let t7: f32 = if c + 224 < cols {
        w[c + 224] * x[c + 224]
      } else {
        0.0
      };
      out[batch] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
    }
  }
}

pub fn neg_store(
out: &mut Tensor<f32, [?], Memory::HBM>,
w: &Tensor<f32, [?], Memory::HBM>,
x: &Tensor<f32, [?], Memory::HBM>,
cols: i32
) -> void {
  spawn on(Topology::Device) {
    for batch in 0..((cols + 255) / 256) {
      let c: i32 = batch * 256;
      let t0: f32 = if c < cols {
        w[c] * x[c]
      } else {
        0.0
      };
      let t1: f32 = if c + 32 < cols {
        w[c + 32] * x[c + 32]
      } else {
        0.0
      };
      let t2: f32 = if c + 64 < cols {
        w[c + 64] * x[c + 64]
      } else {
        0.0
      };
      out[batch] = t0 + t1 + t2;
      let t3: f32 = if c + 96 < cols {
        w[c + 96] * x[c + 96]
      } else {
        0.0
      };
      let t4: f32 = if c + 128 < cols {
        w[c + 128] * x[c + 128]
      } else {
        0.0
      };
      let t5: f32 = if c + 160 < cols {
        w[c + 160] * x[c + 160]
      } else {
        0.0
      };
      let t6: f32 = if c + 192 < cols {
        w[c + 192] * x[c + 192]
      } else {
        0.0
      };
      let t7: f32 = if c + 224 < cols {
        w[c + 224] * x[c + 224]
      } else {
        0.0
      };
      out[batch] = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7;
    }
  }
}
