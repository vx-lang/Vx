//===----------------------------------------------------------------------===//
// The operand roles have to resolve for tensors declared inside a function, not
// only for parameters (#325).
//
// On the AST code generator a local lives in a slot, `memref<memref<?x?xf32>>`.
// The region only reads the slots, so the lowering reads each one before the
// spawn, and the launch gets the three buffers themselves. A GPU cannot read a
// slot on the host stack. `kernel_kind_matmul.vx` covers the parameter case.
//
// The out kind is `buffer`: `c = a @ b` fills the buffer `c` already names
// rather than allocating a second one and publishing a descriptor (Vx#391).
// `kernel_kind_matmul.vx` and `matvec_roles.vx` keep the `slot` kind, whose
// operands carry no shape to compare against.
//
// The pass pipeline is pinned to the vx lowering alone, since that is where the
// attribute is created and the later conversion consumes it.
//
//
// The role indices have moved twice: once when the outliner stopped capturing
// the loop bounds and the zero-fill value, and again when the destination
// became an operand of the matmul rather than something published after it, so
// it is captured first. The mapping is what matters, not the numbers: they say
// which operand is A, B and the destination, and
// tests/integration_test/gemm_plan_test.rs decodes the payload and checks it
// describes the GEMM the program wrote.
//
// Only the AST code generator keeps a local in a slot, so this RUN line uses it.
// RUN: vxc %s --legacy-codegen --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s
// CHECK: vx.launch @vx_npu_kernel_0
// CHECK: vx.kernel_kind = "matmul"
// CHECK: vx.kernel_out_kind = "buffer"
// CHECK: vx.kernel_roles = "a:1,b:2,out:0"
// CHECK-SAME: : (memref<{{[^<>]*}}xf32>, memref<{{[^<>]*}}xf32>, memref<{{[^<>]*}}xf32>) -> ()
//
// The flat code generator passes the local buffers directly. The roles must
// still resolve.
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=FLAT
// FLAT: vx.launch @vx_npu_kernel_0
// FLAT-SAME: vx.kernel_kind = "matmul"
// FLAT-SAME: vx.kernel_out_kind = "buffer"
// FLAT-SAME: vx.kernel_roles = "a:1,b:2,out:0"
// FLAT-SAME: (memref<2x2xf32>, memref<2x2xf32>, memref<2x2xf32>)
//
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=PAYLOAD
// PAYLOAD: \00kind=matmul\00roles=a:1,b:2,out:0\00outkind=buffer\00

fn local_gemm() -> f32 {
  let mut a = unsafe { Tensor<f32, [2, 2]>::uninit() };
  let mut b = unsafe { Tensor<f32, [2, 2]>::uninit() };
  let mut c = unsafe { Tensor<f32, [2, 2]>::uninit() };
  spawn on(Topology::GPU) {
    c = a @b;
  }
  return c[0][0];
}
