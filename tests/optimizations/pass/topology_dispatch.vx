// Value-based device dispatch built on #206 (Topology is a first-class runtime
// value: an i32 discriminant = arch::topology_dispatch_id, GPU=500, ANE=400,
// CPU=0). `impl dispatch for topology_test` routes on the *runtime* topology
// value and places the matching device kernel with `spawn on (Topology::X)`.
//
// In the lowered MLIR this shows up as:
//   * the dispatch method takes the topology value as an `i32` argument;
//   * `arith.cmpi eq` against the constants 500 / 400 selects the branch;
//   * each branch emits `vx.spawn topology(N)` with the matching dispatch id.
//
// CHECK lines are generated by utils/update_mlir_test_checks.rs.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

struct topology_test {
  workload : i32,
}

// Device kernels, each pinned to its topology. A pinned function is callable
// only from a matching device context (i.e. inside a `spawn on` that topology),
// so routing through them is a genuine device dispatch, not a plain call.
fn cpu_kernel() on Topology::CPU -> void {}
fn ane_kernel() on Topology::ANE -> void {}
fn gpu_kernel() on Topology::GPU -> void {}

trait dispatch {
  fn run(self : &topology_test, target : Topology) -> Topology;
}

impl dispatch for topology_test {
  fn run(self : &topology_test, target : Topology) -> Topology {
    if target == Topology::GPU {
      spawn on (Topology::GPU) { gpu_kernel(); };
      return Topology::GPU;
    }
    if target == Topology::ANE {
      spawn on (Topology::ANE) { ane_kernel(); };
      return Topology::ANE;
    }
    spawn on (Topology::CPU) { cpu_kernel(); };
    return Topology::CPU;
  }
}

fn main() -> i32 {
  let t = topology_test { workload : 10 };
  // `return f()` returns f()'s value (#210): main's exit code is the id of the
  // device it dispatched to (GPU = 500).
  return t.run(Topology::GPU);
}

// CHECK: module attributes {llvm.module_flags = {"Debug Info Version" = 3 : i32, "Dwarf Version" = 4 : i32}} {
// CHECK:   func.func private @printMemrefF32(memref<*xf32>)
// CHECK:   func.func private @printMemrefF64(memref<*xf64>)
// CHECK:   func.func private @printMemrefI32(memref<*xi32>)
// CHECK:   func.func private @printMemrefI64(memref<*xi64>)
// CHECK:   func.func private @printMemrefBF16(memref<*xbf16>)
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @topology_test$run(%arg0: !llvm.ptr, %arg1: i32) -> i32 {
// CHECK:     %c500_i32 = arith.constant 500 : i32
// CHECK:     %0 = arith.cmpi eq, %arg1, %c500_i32 : i32
// CHECK:     cf.cond_br %0, ^bb1, ^bb2
// CHECK:   ^bb1:  // pred: ^bb0
// CHECK:     vx.spawn topology(500) {
// CHECK:       func.call @gpu_kernel() : () -> ()
// CHECK:       %2 = llvm.mlir.constant(0 : i32) : i32
// CHECK:       vx.yield
// CHECK:     }
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %c500_i32_0 = arith.constant 500 : i32
// CHECK:     return %c500_i32_0 : i32
// CHECK:   ^bb2:  // pred: ^bb0
// CHECK:     cf.br ^bb3
// CHECK:   ^bb3:  // pred: ^bb2
// CHECK:     %c400_i32 = arith.constant 400 : i32
// CHECK:     %1 = arith.cmpi eq, %arg1, %c400_i32 : i32
// CHECK:     cf.cond_br %1, ^bb4, ^bb5
// CHECK:   ^bb4:  // pred: ^bb3
// CHECK:     vx.spawn topology(400) {
// CHECK:       func.call @ane_kernel() : () -> ()
// CHECK:       %2 = llvm.mlir.constant(0 : i32) : i32
// CHECK:       vx.yield
// CHECK:     } {plugin = "Apple_NPE_v1"}
// CHECK:     %c0_1 = arith.constant 0 : index
// CHECK:     %c400_i32_2 = arith.constant 400 : i32
// CHECK:     return %c400_i32_2 : i32
// CHECK:   ^bb5:  // pred: ^bb3
// CHECK:     cf.br ^bb6
// CHECK:   ^bb6:  // pred: ^bb5
// CHECK:     vx.spawn topology(0) {
// CHECK:       func.call @cpu_kernel() : () -> ()
// CHECK:       %2 = llvm.mlir.constant(0 : i32) : i32
// CHECK:       vx.yield
// CHECK:     }
// CHECK:     %c0_3 = arith.constant 0 : index
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK:   func.func @cpu_kernel() {
// CHECK:     return
// CHECK:   }
// CHECK:   func.func @ane_kernel() {
// CHECK:     return
// CHECK:   }
// CHECK:   func.func @gpu_kernel() {
// CHECK:     return
// CHECK:   }
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %0 = llvm.mlir.undef : !llvm.struct<"topology_test", (i32)>
// CHECK:     %c10_i32 = arith.constant 10 : i32
// CHECK:     %1 = llvm.insertvalue %c10_i32, %0[0] : !llvm.struct<"topology_test", (i32)> 
// CHECK:     %2 = llvm.mlir.constant(1 : i32) : i32
// CHECK:     %3 = llvm.alloca %2 x !llvm.struct<"topology_test", (i32)> : (i32) -> !llvm.ptr
// CHECK:     llvm.store %1, %3 : !llvm.struct<"topology_test", (i32)>, !llvm.ptr
// CHECK:     %c500_i32 = arith.constant 500 : i32
// CHECK:     %4 = call @topology_test$run(%3, %c500_i32) : (!llvm.ptr, i32) -> i32
// CHECK:     return %4 : i32
// CHECK:   }
// CHECK: }
