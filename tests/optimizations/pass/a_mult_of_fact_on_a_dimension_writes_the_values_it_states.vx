//===----------------------------------------------------------------------===//
// A kernel can take a tensor whose run-time pitch states `? mult_of 4` (#3668). The caller
// makes a tensor whose type carries the fact and hands it over: the run-time extents come
// from the written shape, and the fact rides on the type through the transfer, as a
// `Tensor<bf16, [?, ?]>` would not -- the call would refuse a tensor without the fact. Block
// `t` writes the rows of range `t`: rows 0..3 get `10..13`, rows 4..7 get `20..23`.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error

// CHECK: rows: 0 1 2 3 10 11 12 13

fn write_rows(out : &mut Tensor<bf16, [?, ? mult_of 4], Memory::HBM>, tiles : &DisjointRanges<Tensor<i32, [?, 2], Memory::HBM>>) -> void {
  spawn on(Topology::Device) {
    for t in 0..tiles.len() across blocks {
      for r in 0..4 across lanes(32) {
        let row = (tiles[t][0] as i64) + (r as i64);
        if row < (tiles[t][1] as i64) {
          let v = (10 * t + r) as f32;
          out[row][0] = v as bf16;
          out[row][1] = (v + 1.0) as bf16;
          out[row][2] = (v + 2.0) as bf16;
          out[row][3] = (v + 3.0) as bf16;
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  let mut table = Tensor<i32, [2, 2]>::fill(0);
  table[0][0] = 0;
  table[0][1] = 4;
  table[1][0] = 4;
  table[1][1] = 8;
  let tiles = unsafe { DisjointRanges(transfer(table, Memory::HBM)) };

  let scratch = unsafe { Tensor<bf16, [?, ? mult_of 4]>::uninit([8, 4]) };
  let mut out = transfer(scratch, Memory::HBM);
  write_rows(&mut out, &tiles);
  let h = transfer(out, Memory::CPU_DRAM);
  println!(
  "rows: {} {} {} {} {} {} {} {}",
  h[0][0] as f32, h[1][0] as f32, h[2][0] as f32, h[3][0] as f32,
  h[4][0] as f32, h[5][0] as f32, h[6][0] as f32, h[7][0] as f32
  );
  return 0;
}
