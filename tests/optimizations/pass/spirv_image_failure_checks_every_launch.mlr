//
//===----------------------------------------------------------------------===//
// A kernel the SPIR-V path cannot image may run on the host only when every
// launch of it passes memory the host can read. This kernel is launched twice:
// the first launch passes a tensor in `managed: explicit` memory, the second a
// plain one. Reading only the last launch found nothing to complain about, and
// left the region on the host over device memory.
//
// `vx.launch` is written by the outliner, one per spawn, and no fixture here
// makes two launches of one kernel. This is that IR by hand.
//
// RUN: not vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s
// CHECK: the region placed on topology 501 in `main` (kernel `k`) cannot become a `spirv64` device image
// CHECK: This region's operands are in 'GPU_HBM', declared `managed: explicit`
// CHECK-NOT: will run on the host instead

module {
  func.func @main(%host: memref<4xf32>, %other: memref<4xf32>) -> i32 {
    %c0 = arith.constant 0 : i32
    %d = "vx.transfer"(%host) {target_topology = 501 : i32, managed = "explicit", space = "GPU_HBM"} : (memref<4xf32>) -> memref<4xf32>
    vx.launch @k(%d) {topology = 501 : i32} : (memref<4xf32>) -> ()
    vx.launch @k(%other) {topology = 501 : i32} : (memref<4xf32>) -> ()
    return %c0 : i32
  }
  // The body reads memory, which is the other half of the question: a kernel
  // that only yields reads nothing and may run anywhere.
  vx.kernel @k(501) {arch = "spirv64"} : (memref<4xf32>) -> () {
  ^bb0(%src: memref<4xf32>):
    %c0 = arith.constant 0 : index
    %v = memref.load %src[%c0] : memref<4xf32>
    vx.return
  }
  gpu.module @kernels {
    gpu.func @k(%src: memref<4xf32>) kernel {
      %c0 = arith.constant 0 : index
      %view = memref.subview %src[0] [2] [1] : memref<4xf32> to memref<2xf32, strided<[1]>>
      %value = memref.load %view[%c0] : memref<2xf32, strided<[1]>>
      memref.store %value, %src[%c0] : memref<4xf32>
      gpu.return
    }
  }
}
