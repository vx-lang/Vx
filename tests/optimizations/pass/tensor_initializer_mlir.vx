//===----------------------------------------------------------------------===//
// Full-MLIR regression lock for tensor initializer lists. `Tensor<f32>([[..],[..]])` allocates
// a `memref<2x2xf32>` and stores each element in row-major order -- no fill
// loop. Regenerate with:
//   cargo run --bin update_mlir_test_checks -- tests/optimizations/pass/tensor_initializer_mlir.vx
//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s

fn init() -> i32 {
  let m = Tensor<f32>([[1.0, 2.0],
  [3.0, 4.0]]);
  return 0;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func @init() -> i32 {
// CHECK:     %alloc = memref.alloc() : memref<2x2xf32>
// CHECK:     %cst = arith.constant 1.000000e+00 : f32
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.index_cast %c0_i32 : i32 to index
// CHECK:     %c2 = arith.constant 2 : index
// CHECK:     %1 = arith.muli %0, %c2 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %alloc to offset: [%1], sizes: [2], strides: [1] : memref<2x2xf32> to memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %c0_i32_0 = arith.constant 0 : i32
// CHECK:     %2 = arith.index_cast %c0_i32_0 : i32 to index
// CHECK:     memref.store %cst, %reinterpret_cast[%2] : memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %cst_1 = arith.constant 2.000000e+00 : f32
// CHECK:     %c0_i32_2 = arith.constant 0 : i32
// CHECK:     %3 = arith.index_cast %c0_i32_2 : i32 to index
// CHECK:     %c2_3 = arith.constant 2 : index
// CHECK:     %4 = arith.muli %3, %c2_3 : index
// CHECK:     %reinterpret_cast_4 = memref.reinterpret_cast %alloc to offset: [%4], sizes: [2], strides: [1] : memref<2x2xf32> to memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %5 = arith.index_cast %c1_i32 : i32 to index
// CHECK:     memref.store %cst_1, %reinterpret_cast_4[%5] : memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %cst_5 = arith.constant 3.000000e+00 : f32
// CHECK:     %c1_i32_6 = arith.constant 1 : i32
// CHECK:     %6 = arith.index_cast %c1_i32_6 : i32 to index
// CHECK:     %c2_7 = arith.constant 2 : index
// CHECK:     %7 = arith.muli %6, %c2_7 : index
// CHECK:     %reinterpret_cast_8 = memref.reinterpret_cast %alloc to offset: [%7], sizes: [2], strides: [1] : memref<2x2xf32> to memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %c0_i32_9 = arith.constant 0 : i32
// CHECK:     %8 = arith.index_cast %c0_i32_9 : i32 to index
// CHECK:     memref.store %cst_5, %reinterpret_cast_8[%8] : memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %cst_10 = arith.constant 4.000000e+00 : f32
// CHECK:     %c1_i32_11 = arith.constant 1 : i32
// CHECK:     %9 = arith.index_cast %c1_i32_11 : i32 to index
// CHECK:     %c2_12 = arith.constant 2 : index
// CHECK:     %10 = arith.muli %9, %c2_12 : index
// CHECK:     %reinterpret_cast_13 = memref.reinterpret_cast %alloc to offset: [%10], sizes: [2], strides: [1] : memref<2x2xf32> to memref<2xf32, strided<[1], offset: ?>>
// CHECK:     %c1_i32_14 = arith.constant 1 : i32
// CHECK:     %11 = arith.index_cast %c1_i32_14 : i32 to index
// CHECK:     memref.store %cst_10, %reinterpret_cast_13[%11] : memref<2xf32, strided<[1], offset: ?>>
// CHECK:     vx.drop %alloc : memref<2x2xf32>
// CHECK:     %c0_i32_15 = arith.constant 0 : i32
// CHECK:     return %c0_i32_15 : i32
// CHECK:   }
// CHECK: }
