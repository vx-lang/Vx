// Full-MLIR regression lock for slice indexing (S1). `q[i]` on a rank-2 tensor lowers to a
// rank-reduced `memref.reinterpret_cast` (a strided row view) at the flat offset, and a
// following element read loads through that strided view. The CHECK lines below are the exact
// post-codegen MLIR; regenerate with:
//   cargo run --bin update_mlir_test_checks -- tests/optimizations/pass/slice_indexing_mlir.vx
//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s

fn slice_index(q : Tensor<f32, [2, 4]>) -> f32 {
  let r : Tensor<f32, [4]> = q[1];
  return r[2];
}

// CHECK: module attributes {llvm.module_flags = {"Debug Info Version" = 3 : i32, "Dwarf Version" = 4 : i32}} {
// CHECK:   func.func private @printMemrefF32(memref<*xf32>)
// CHECK:   func.func private @printMemrefF64(memref<*xf64>)
// CHECK:   func.func private @printMemrefI32(memref<*xi32>)
// CHECK:   func.func private @printMemrefI64(memref<*xi64>)
// CHECK:   func.func private @printMemrefBF16(memref<*xbf16>)
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @slice_index(%arg0: memref<2x4xf32>) -> f32 {
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %0 = arith.index_cast %c1_i32 : i32 to index
// CHECK:     %c4 = arith.constant 4 : index
// CHECK:     %1 = arith.muli %0, %c4 : index
// CHECK:     %reinterpret_cast = memref.reinterpret_cast %arg0 to offset: [%1], sizes: [4], strides: [1] : memref<2x4xf32> to memref<4xf32, strided<[1], offset: ?>>
// CHECK:     %c2_i32 = arith.constant 2 : i32
// CHECK:     %2 = arith.index_cast %c2_i32 : i32 to index
// CHECK:     %3 = memref.load %reinterpret_cast[%2] : memref<4xf32, strided<[1], offset: ?>>
// CHECK:     return %3 : f32
// CHECK:   }
// CHECK: }
