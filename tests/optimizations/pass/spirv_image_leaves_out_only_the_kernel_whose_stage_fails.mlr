//===----------------------------------------------------------------------===//
// Kernels `a` and `b` are in one device module. `b` adds two `f8E5M2` values,
// which LLVM cannot lower, so a stage of the SPIR-V pipeline fails, and no
// check before the stage names `b`. The compiler then builds each kernel alone.
// So only `b` loses its image, and `a` keeps its own.
//
// RUN: vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s
// CHECK-NOT: (kernel `a`)
// CHECK: the region placed on `Topology::Dev` in `main` (kernel `b`) cannot become a `spirv64` device image: the SPIR-V module did not translate to LLVM IR
// CHECK-NOT: (kernel `a`)
// CHECK-DAG: @a_str("a\00abi=1\00topo=501\00toponame=Dev\00format=spirv\00
// CHECK-DAG: @b_str("b\00abi=1\00topo=501\00toponame=Dev\00")

module {
  func.func @main(%x: memref<4xf32>, %y: memref<4xf8E5M2>) -> i32 {
    %c0 = arith.constant 0 : i32
    vx.launch @a(%x) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xf32>) -> ()
    vx.launch @b(%y) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xf8E5M2>) -> ()
    return %c0 : i32
  }
  vx.kernel @a(501) {arch = "spirv64"} : (memref<4xf32>) -> () {
  ^bb0(%src: memref<4xf32>):
    vx.return
  }
  vx.kernel @b(501) {arch = "spirv64"} : (memref<4xf8E5M2>) -> () {
  ^bb0(%src: memref<4xf8E5M2>):
    vx.return
  }
  gpu.module @kernels {
    gpu.func @a(%src: memref<4xf32>) kernel {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %value = memref.load %src[%c0] : memref<4xf32>
      memref.store %value, %src[%c1] : memref<4xf32>
      gpu.return
    }
    gpu.func @b(%src: memref<4xf8E5M2>) kernel {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %value = memref.load %src[%c0] : memref<4xf8E5M2>
      %sum = arith.addf %value, %value : f8E5M2
      memref.store %sum, %src[%c1] : memref<4xf8E5M2>
      gpu.return
    }
  }
}
