//===----------------------------------------------------------------------===//
// `peek` and `peek_twice` say `ensures reads_only(t)`, so the passes of an `across` loop may
// call them. `peek` reads with an `mlir!` block that says `reads_only(t)` too. `peek_twice`
// reads `t` itself, asks for its length, and passes it to `peek`. Each of the 128 passes
// writes its own element of `out`. The prover does not read the clause, so it gives no warning.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=prover
// CHECK: sum 24384

fn peek(t : &Tensor<i32, [?], Memory::HBM>, i : i32) on Topology::Device -> i32
ensures reads_only(t)
{
  return mlir!( inputs : (%t = t : memref<?xi32>, %i = i : i32), returns : i32,
  dialects : ["memref", "arith"], ensures : [reads_only(t)]) {
    %k = arith.index_cast %i : i32 to index
    %v = memref.load %t[%k] : memref<?xi32>
    macro.yield %v : i32
  };
}

fn peek_twice(t : &Tensor<i32, [?], Memory::HBM>, i : i32) on Topology::Device -> i32
ensures reads_only(t)
{
  let last = t.len() - 1;
  return t[i] + peek(t, last - i);
}

fn main() -> i32 {
  let mut input = Tensor<i32, [128]>::fill(0);
  for i in 0..128 {
    input[i] = i;
  }
  let t = transfer(input, Memory::HBM);
  let mut out = transfer(Tensor<i32, [128]>::fill(0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..4 across blocks {
      for l in 0..32 across lanes {
        let n = b * 32 + l;
        out[n] = peek_twice(&t, n) + peek(&t, n);
      }
    }
  }
  let o = transfer(out, Memory::CPU_DRAM);
  let mut sum = 0;
  for i in 0..128 {
    sum = sum + o[i];
  }
  println!("sum {}", sum);
  return 0;
}
