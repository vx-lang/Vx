//===----------------------------------------------------------------------===//
// Code in the outer loop of blocks, after the inner one, is the code of a group. It runs once
// for each pass of the outer loop, in the block of the last inner pass of that group, as soon as
// that group ends. This is the shape of a split attention: head `h` has 8 splits, and the code
// of its group merges them.
//
// Split `s` of head `h` writes 32 values `h * 1000 + s * 32 + l`. Lane `d` of the merge sums
// column `d` over the 8 splits: 8 * (h * 1000 + d) + 32 * 28. Lane 0 counts the runs of each
// group in `runs`, so each count is 1.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --check-prefix=PTX
// CHECK: merged 896 904 8896 25144 runs 1 1 1 1
// PTX: .entry vx_npu_kernel_0(
// PTX-SAME: fence.acq_rel.gpu{{.*}}atom.global.add.u32{{.*}}fence.acq_rel.gpu{{.*}}st.global.b32{{.*}}bar.sync{{.*}}ld.global.b32{{.*}}setp.ne.b32

fn main() -> i32 {
  let mut partial = transfer(Tensor<i32, [4, 256]>::fill(0), Memory::HBM);
  let mut merged = transfer(Tensor<i32, [4, 32]>::fill(0), Memory::HBM);
  let mut runs = transfer(Tensor<i32, [4]>::fill(0), Memory::HBM);
  spawn on(Topology::Device) {
    for h in 0..4 across blocks {
      for s in 0..8 across blocks {
        for l in 0..32 across lanes {
          partial[h][s * 32 + l] = h * 1000 + s * 32 + l;
        }
      }
      for d in 0..32 across lanes {
        let mut sum = 0;
        for s in 0..8 {
          sum = sum + partial[h][s * 32 + d];
        }
        merged[h][d] = sum;
      }
      runs[h] = runs[h] + 1;
    }
  }
  let m = transfer(merged, Memory::CPU_DRAM);
  let r = transfer(runs, Memory::CPU_DRAM);
  println!("merged {} {} {} {} runs {} {} {} {}", m[0][0], m[0][1], m[1][0], m[3][31], r[0], r[1], r[2], r[3]);
  return 0;
}
