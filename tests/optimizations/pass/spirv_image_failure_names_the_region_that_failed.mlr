//===----------------------------------------------------------------------===//
// Kernels `a`, `b` and `c` share one SPIR-V image. `b` reads through a
// `memref.subview` and `c` through a `memref.cast`, which the image cannot do
// yet. So all three lose the image. `b` and `c` each get their own reason, and
// the warning for `a` names `b`, the first kernel that failed.
//
// RUN: vx-opt %s --vx-to-llvm 2>&1 | FileCheck %s
// CHECK: the region placed on `Topology::Dev` in `main` (kernel `a`) cannot become a `spirv64` device image. It shares one image with the region placed on `Topology::Dev` in `main` (kernel `b`). That region cannot become one: it hands a tensor to `memref.subview`
// CHECK-SAME: It will run on the host instead.
// CHECK: the region placed on `Topology::Dev` in `main` (kernel `b`) cannot become a `spirv64` device image: it hands a tensor to `memref.subview`
// CHECK-SAME: It will run on the host instead.
// CHECK: the region placed on `Topology::Dev` in `main` (kernel `c`) cannot become a `spirv64` device image: it hands a tensor to `memref.cast`
// CHECK-SAME: It will run on the host instead.

module {
  func.func @main(%x: memref<4xf32>, %y: memref<4xf32>, %z: memref<4xf32>) -> i32 {
    %c0 = arith.constant 0 : i32
    vx.launch @a(%x) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xf32>) -> ()
    vx.launch @b(%y) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xf32>) -> ()
    vx.launch @c(%z) {topology = 501 : i32, vx.topology_name = "Dev"} : (memref<4xf32>) -> ()
    return %c0 : i32
  }
  vx.kernel @a(501) {arch = "spirv64"} : (memref<4xf32>) -> () {
  ^bb0(%src: memref<4xf32>):
    vx.return
  }
  vx.kernel @b(501) {arch = "spirv64"} : (memref<4xf32>) -> () {
  ^bb0(%src: memref<4xf32>):
    vx.return
  }
  vx.kernel @c(501) {arch = "spirv64"} : (memref<4xf32>) -> () {
  ^bb0(%src: memref<4xf32>):
    vx.return
  }
  gpu.module @kernels {
    gpu.func @a(%src: memref<4xf32>) kernel {
      %c0 = arith.constant 0 : index
      %value = memref.load %src[%c0] : memref<4xf32>
      memref.store %value, %src[%c0] : memref<4xf32>
      gpu.return
    }
    gpu.func @b(%src: memref<4xf32>) kernel {
      %c0 = arith.constant 0 : index
      %view = memref.subview %src[0] [2] [1] : memref<4xf32> to memref<2xf32, strided<[1]>>
      %value = memref.load %view[%c0] : memref<2xf32, strided<[1]>>
      memref.store %value, %src[%c0] : memref<4xf32>
      gpu.return
    }
    gpu.func @c(%src: memref<4xf32>) kernel {
      %c0 = arith.constant 0 : index
      %view = memref.cast %src : memref<4xf32> to memref<?xf32>
      %value = memref.load %view[%c0] : memref<?xf32>
      memref.store %value, %src[%c0] : memref<4xf32>
      gpu.return
    }
  }
}
