// The 32-bit element atomics of `core::sync::atomic` in kernels on the Apple GPU. Each kernel
// runs on the GPU, and again with VX_METAL=0, which runs the CPU copy of the kernel. Both runs
// must print the same numbers.
//
// The first kernel has 4 blocks of 32 lanes, and each of the 128 passes changes the same elements:
// - `adds`: each pass adds 1, so the old values are 0 to 127, and they add up to 8128.
// - `left` starts at 1000, and each pass takes 2 away.
// - `top` keeps the largest pass number plus 5.
// - `low` and `high` start at 0 and keep the smallest pass number minus 64 and the largest pass
//   number minus 200. A compare with no sign reads a negative number as a large u32. Then `low`
//   would stay 0, and `high` would become -73.
// - `bottom` is a `u32` that starts at 4000000000 and keeps the smallest pass number plus 5. A
//   compare with a sign would read 4000000000 as a negative number and keep it.
// - `ring` counts from 0 to 9 and starts again: 128 is 12 rounds of 10 and 8 more.
// - `slot`: each pass swaps in its number plus 1. Each of 0 to 128 is then an old value or the
//   final one, so the old values and the final one add up to 8256.
// - `owner`: each pass tries to change 0 to its number plus 1. Only one finds 0.
// - `flag`: each pass stores 1. Each pass also loads 42 from `fixed`, so the loads add up to 5376.
// - `hits` is in shared memory, one for each block. The 32 lanes of a block add 1 to it.
//
// The second kernel puts 512 keys in a table of 1024 slots, with a compare-and-swap on each slot
// that it tries. Only 400 keys are different, so the table holds 400 keys that add up to 559000.
//
// REQUIRES: macos
// RUN: env VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.gpu | FileCheck %s
// RUN: FileCheck %s --check-prefix=GPU --input-file=%t.gpu
// RUN: env VX_METAL=0 VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.cpu | FileCheck %s
// RUN: FileCheck %s --check-prefix=CPU --input-file=%t.cpu
//
// CHECK: {{^}}adds 128 olds 8128 left 744 top 132{{$}}
// CHECK-NEXT: {{^}}low -64 high 0 bottom 5 ring 8{{$}}
// CHECK-NEXT: {{^}}slot 8256 wins 1 flag 1 loads 5376{{$}}
// CHECK-NEXT: {{^}}shared 32 32 32 32{{$}}
// CHECK-NEXT: {{^}}table 400 559000{{$}}
//
// The fills, then the two kernels.
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 4 x 1 x 1, block 32
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 8 x 1 x 1, block 64
// CPU-NOT: [Vx Metal]
// CPU: Falling back to CPU libffi dispatch
import core::sync::atomic;

// Puts each key in the first slot from (key * 13) & mask on that is empty or holds the key.
// 4294967295 marks an empty slot.
pub fn insert_all(slots : &Tensor<u32, [?], Memory::HBM>, keys : &Tensor<u32, [?], Memory::HBM>, nblocks : i32, mask : u32) -> void {
  spawn on(Topology::Device) {
    for b in 0..nblocks across blocks {
      for l in 0..64 across lanes {
        let k = keys[b * 64 + l];
        let mut s = (k * 13u32) & mask;
        loop {
          let found = atomic_compare_and_swap_u32(slots, s as i32, 4294967295u32, k, AtomicOrdering::Relaxed);
          if found == 4294967295u32 || found == k {
            break;
          }
          s = (s + 1u32) & mask;
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  let adds = transfer(Tensor<u32, [1]>::fill(0u32), Memory::HBM);
  let mut olds = transfer(Tensor<i32, [128]>::fill(0), Memory::HBM);
  let left = transfer(Tensor<i32, [1]>::fill(1000), Memory::HBM);
  let top = transfer(Tensor<i32, [1]>::fill(0), Memory::HBM);
  let low = transfer(Tensor<i32, [1]>::fill(0), Memory::HBM);
  let high = transfer(Tensor<i32, [1]>::fill(0), Memory::HBM);
  let bottom = transfer(Tensor<u32, [1]>::fill(4000000000u32), Memory::HBM);
  let ring = transfer(Tensor<u32, [1]>::fill(0u32), Memory::HBM);
  let slot = transfer(Tensor<u32, [1]>::fill(0u32), Memory::HBM);
  let mut swapped = transfer(Tensor<u32, [128]>::fill(0u32), Memory::HBM);
  let owner = transfer(Tensor<i32, [1]>::fill(0), Memory::HBM);
  let wins = transfer(Tensor<i32, [1]>::fill(0), Memory::HBM);
  let flag = transfer(Tensor<i32, [1]>::fill(0), Memory::HBM);
  let fixed = transfer(Tensor<i32, [1]>::fill(42), Memory::HBM);
  let mut loads = transfer(Tensor<i32, [128]>::fill(0), Memory::HBM);
  let mut per_block = transfer(Tensor<u32, [4]>::fill(0u32), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..4 across blocks {
      let hits = Tensor<u32, [1], Memory::SMEM>::fill(0u32);
      for l in 0..32 across lanes {
        let n = b * 32 + l;
        olds[n] = atomic_fetch_add_u32(&adds, 0, 1u32, AtomicOrdering::Relaxed) as i32;
        let _s = atomic_fetch_sub_i32(&left, 0, 2, AtomicOrdering::Relaxed);
        let _t = atomic_fetch_max_i32(&top, 0, n + 5, AtomicOrdering::Relaxed);
        let _lo = atomic_fetch_min_i32(&low, 0, n - 64, AtomicOrdering::Relaxed);
        let _hi = atomic_fetch_max_i32(&high, 0, n - 200, AtomicOrdering::Relaxed);
        let _m = atomic_fetch_min_u32(&bottom, 0, (n + 5) as u32, AtomicOrdering::Relaxed);
        let _r = atomic_fetch_inc_wrap_u32(&ring, 0, 9u32, AtomicOrdering::Relaxed);
        swapped[n] = atomic_swap_u32(&slot, 0, (n + 1) as u32, AtomicOrdering::Relaxed);
        if atomic_compare_and_swap_i32(&owner, 0, 0, n + 1, AtomicOrdering::Relaxed) == 0 {
          let _w = atomic_fetch_add_i32(&wins, 0, 1, AtomicOrdering::Relaxed);
        }
        atomic_store_i32(&flag, 0, 1, AtomicOrdering::Relaxed);
        loads[n] = atomic_load_i32(&fixed, 0, AtomicOrdering::Relaxed);
        let _h = atomic_fetch_add_u32(&hits, 0, 1u32, AtomicOrdering::Relaxed);
      }
      for l in 0..1 across lanes {
        per_block[b + l] = hits[0];
      }
    }
  }
  let a = transfer(adds, Memory::CPU_DRAM);
  let o = transfer(olds, Memory::CPU_DRAM);
  let le = transfer(left, Memory::CPU_DRAM);
  let tp = transfer(top, Memory::CPU_DRAM);
  let lo = transfer(low, Memory::CPU_DRAM);
  let hi = transfer(high, Memory::CPU_DRAM);
  let bt = transfer(bottom, Memory::CPU_DRAM);
  let rg = transfer(ring, Memory::CPU_DRAM);
  let sl = transfer(slot, Memory::CPU_DRAM);
  let sw = transfer(swapped, Memory::CPU_DRAM);
  let w = transfer(wins, Memory::CPU_DRAM);
  let fl = transfer(flag, Memory::CPU_DRAM);
  let ld = transfer(loads, Memory::CPU_DRAM);
  let pb = transfer(per_block, Memory::CPU_DRAM);
  let mut sum = 0;
  let mut swaps = sl[0];
  let mut loaded_sum = 0;
  for i in 0..128 {
    sum = sum + o[i];
    swaps = swaps + sw[i];
    loaded_sum = loaded_sum + ld[i];
  }
  println!("adds {} olds {} left {} top {}", a[0], sum, le[0], tp[0]);
  println!("low {} high {} bottom {} ring {}", lo[0], hi[0], bt[0], rg[0]);
  println!("slot {} wins {} flag {} loads {}", swaps, w[0], fl[0], loaded_sum);
  println!("shared {} {} {} {}", pb[0], pb[1], pb[2], pb[3]);

  // 512 keys, and key i is (i % 400) * 7 + 1. So 112 keys are in the table twice.
  let mut host_keys = Tensor<u32, [512]>::fill(0u32);
  for i in 0..512 {
    host_keys[i] = ((i % 400) * 7 + 1) as u32;
  }
  let keys = transfer(host_keys, Memory::HBM);
  let slots = transfer(Tensor<u32, [1024]>::fill(4294967295u32), Memory::HBM);
  insert_all(&slots, &keys, 8, 1023u32);
  let table = transfer(slots, Memory::CPU_DRAM);
  let mut held = 0;
  let mut total = 0u32;
  for i in 0..1024 {
    if table[i] != 4294967295u32 {
      held = held + 1;
      total = total + table[i];
    }
  }
  println!("table {} {}", held, total);
  return 0;
}
