// A tensor in GPU memory gets its Metal buffer when the program allocates it, and keeps it until
// the program frees it. A tensor smaller than a page (16 KiB) gets a whole page. A batch is the
// launches that the GPU runs at one wait.
//
// The GPU run and the CPU copy of each kernel (VX_METAL=0) print the same numbers.
//
// REQUIRES: macos
// RUN: env VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.gpu | FileCheck %s --check-prefix=OUT
// RUN: FileCheck %s --check-prefix=GPU --input-file=%t.gpu
// RUN: env VX_METAL=0 vxc %s --host default --machine fleet/m4-uma.vx | FileCheck %s --check-prefix=OUT
//
// `a` starts as a copy of a host tensor of ones, so first b = a + 1 = 2. Then a = position, and
// b = a + 1. Each line prints the last element.
// OUT: {{^}}first 2{{$}}
// OUT-NEXT: {{^}}second 63999{{$}}
// OUT-NEXT: {{^}}third 64000{{$}}
// tmp = 2 * position, out = tmp + 1, and again = out + 1.
// OUT-NEXT: {{^}}temporary 127999{{$}}
// OUT-NEXT: {{^}}again 128000{{$}}
// OUT-NEXT: {{^}}row 1{{$}}
// OUT-NEXT: {{^}}row 2{{$}}
// Each tensor of the chain starts at 1, and gets the one before it added: 1, 2, 3, 4, 5, 6.
// OUT-NEXT: {{^}}chain 6, sum 21{{$}}
//
// `a` and `b` (256000 bytes, so 16 pages) get their buffers before the first launch. The three
// batches that use them make no buffer.
// GPU: [Vx Metal] made a buffer of 262144 bytes of GPU memory
// GPU-NEXT: [Vx Metal] made a buffer of 262144 bytes of GPU memory
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 1 kernel,
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 1 kernel,
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 1 kernel,
//
// The free of `tmp` waits for its two kernels, and then frees its memory. `again` gets a new
// buffer, and its batch makes none.
// GPU: [Vx Metal] waited for 2 kernels,
// GPU-NEXT: [Vx Metal] freed 262144 bytes of GPU memory
// GPU-NEXT: [Vx Metal] made a buffer of 262144 bytes of GPU memory
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 1 kernel,
//
// `row` (4000 bytes) gets a buffer of one page, and its two batches make none.
// GPU: [Vx Metal] made a buffer of 16384 bytes of GPU memory
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 1 kernel,
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 1 kernel,
//
// The six tensors of the chain (14000 bytes each) get a page each. From `malloc`, two of them
// could share a page, and a buffer over that page would end the batch. Here the five launches
// run at one wait.
// GPU-COUNT-6: [Vx Metal] made a buffer of 16384 bytes of GPU memory
// GPU-NOT: buffer
// GPU: [Vx Metal] waited for 5 kernels,

import core::convert;

// dst = position * scale
fn fill(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for y in 0..h across blocks {
      for x in 0..w across lanes(256) {
        dst[y][x] = ((y * w + x) as f32) * scale;
      }
    }
  }
  return;
}

// dst = src + 1
fn add_one(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..h across blocks {
      for x in 0..w across lanes(256) {
        dst[y][x] = src[y][x] + 1.0;
      }
    }
  }
  return;
}

// dst[i] = dst[i] + 1
fn add_one_to_row(dst : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          dst[i] = dst[i] + 1.0;
        }
      }
    }
  }
  return;
}

// dst[i] = dst[i] + src[i]
fn add_row(dst : &mut Tensor<f32, [?], Memory::HBM>, src : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes(256) {
        let i = g * 256 + l;
        if i < n {
          dst[i] = dst[i] + src[i];
        }
      }
    }
  }
  return;
}

// The last element of `t`, read in place after a wait.
fn last(t : &Tensor<f32, [?, ?], Memory::HBM>) -> f32 {
  let host = transfer(t, Memory::CPU_DRAM);
  return host[63][999];
}

fn last_of_row(t : &Tensor<f32, [?], Memory::HBM>) -> f32 {
  let host = transfer(t, Memory::CPU_DRAM);
  return host[999];
}

// out = 2 * position + 1. The program frees `tmp` when this function returns.
fn add_one_to_a_temporary(out : &mut Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32) -> void {
  let mut tmp = transfer(Tensor<f32, [64, 1000]>::fill(0.0), Memory::HBM);
  fill(&mut tmp, h, w, 2.0);
  add_one(out, &tmp, h, w);
  return;
}

fn main() -> i32 {
  let h : i32 = 64;
  let w : i32 = 1000;
  let mut a = transfer(Tensor<f32, [64, 1000]>::fill(1.0), Memory::HBM);
  let mut b = transfer(Tensor<f32, [64, 1000]>::fill(0.0), Memory::HBM);
  add_one(&mut b, &a, h, w);
  println!("first {}", last(&b));
  fill(&mut a, h, w, 1.0);
  println!("second {}", last(&a));
  add_one(&mut b, &a, h, w);
  println!("third {}", last(&b));

  let mut out = transfer(Tensor<f32, [64, 1000]>::fill(0.0), Memory::HBM);
  add_one_to_a_temporary(&mut out, h, w);
  println!("temporary {}", last(&out));
  let mut again = transfer(Tensor<f32, [64, 1000]>::fill(0.0), Memory::HBM);
  add_one(&mut again, &out, h, w);
  println!("again {}", last(&again));

  let mut row = transfer(Tensor<f32, [1000]>::fill(0.0), Memory::HBM);
  add_one_to_row(&mut row, 1000);
  println!("row {}", last_of_row(&row));
  add_one_to_row(&mut row, 1000);
  println!("row {}", last_of_row(&row));

  let c0 = transfer(Tensor<f32, [3500]>::fill(1.0), Memory::HBM);
  let mut c1 = transfer(Tensor<f32, [3500]>::fill(1.0), Memory::HBM);
  let mut c2 = transfer(Tensor<f32, [3500]>::fill(1.0), Memory::HBM);
  let mut c3 = transfer(Tensor<f32, [3500]>::fill(1.0), Memory::HBM);
  let mut c4 = transfer(Tensor<f32, [3500]>::fill(1.0), Memory::HBM);
  let mut c5 = transfer(Tensor<f32, [3500]>::fill(1.0), Memory::HBM);
  add_row(&mut c1, &c0, 3500);
  add_row(&mut c2, &c1, 3500);
  add_row(&mut c3, &c2, 3500);
  add_row(&mut c4, &c3, 3500);
  add_row(&mut c5, &c4, 3500);
  // The program reads the other tensors after `c5`, so it frees none of them before the wait.
  let end = last_of_row(&c5);
  let sum = last_of_row(&c0) + last_of_row(&c1) + last_of_row(&c2) + last_of_row(&c3) + last_of_row(&c4) + end;
  println!("chain {}, sum {}", end, sum);
  return 0;
}
