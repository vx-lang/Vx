// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// No code generator can launch the levels of the `x86_64` topology `Cores`. With
// `-fauto-schedule-levels`, the region has no launch shape. Each `across` loop runs as a plain
// `for`, and the branch back to its header carries `vx.across` with its level. A loop over lanes
// or subgroups also asks LLVM to vectorize it, and each loop has loop metadata of its own. The
// program gives the same sum with both code generators and with `-j`. A region with no launch
// may have a matmul of whole tensors, which a launched region may not.
//
// RUN: vxc %s -fauto-schedule-levels --host default --emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR --implicit-check-not=vx.launch_dim --implicit-check-not=vx.across_id
// RUN: vxc %s -fauto-schedule-levels --host default --emit-llvm 2>&1 | mlir-translate --mlir-to-llvmir | FileCheck %s --check-prefix=IR
// RUN: vxc %s -fauto-schedule-levels --host default --run 2>&1 | FileCheck %s --check-prefix=OUT
// RUN: vxc %s -fauto-schedule-levels -j 2 --host default --run 2>&1 | FileCheck %s --check-prefix=OUT
// RUN: vxc %s -fauto-schedule-levels --legacy-codegen --host default --run 2>&1 | FileCheck %s --check-prefix=OUT
// MLIR: #[[VEC:.*]] = #llvm.loop_vectorize<disable = false>
// MLIR: #[[LANES:.*]] = #llvm.loop_annotation<vectorize = #[[VEC]], parallelAccesses = #{{.*}}>
// MLIR: #[[SUB:.*]] = #llvm.loop_annotation<vectorize = #[[VEC]], parallelAccesses = #{{.*}}>
// MLIR: cf.br ^bb{{[0-9]+}} {loop_annotation = #[[LANES]], vx.across = "lanes"}
// MLIR: cf.br ^bb{{[0-9]+}} {loop_annotation = #[[SUB]], vx.across = "subgroups"}
// MLIR: cf.br ^bb{{[0-9]+}} {vx.across = "blocks"}
// IR: br label %{{[0-9]+}}, !llvm.loop ![[L1:[0-9]+]]
// IR: br label %{{[0-9]+}}, !llvm.loop ![[L2:[0-9]+]]
// IR: ![[L1]] = distinct !{![[L1]], ![[VEC:[0-9]+]], !{{[0-9]+}}}
// IR: ![[VEC]] = !{!"llvm.loop.vectorize.enable", i1 true}
// IR: ![[L2]] = distinct !{![[L2]], ![[VEC]], !{{[0-9]+}}}
// OUT: sum 4560
// OUT-NEXT: matmul 8

Topology Cores {
  arch: x86_64,
  memory: Memory::CPU_DRAM,
  visible: [Memory::CPU_DRAM],
  levels: [blocks(max_lanes: 64), subgroups(lanes: 8), lanes]
}

fn main() -> i32 {
  let n = 3;
  let mut y = Tensor<f32, [96]>::fill(0.0);
  spawn on(Topology::Cores) {
    for b in 0..n across blocks {
      for w in 0..4 across subgroups {
        for t in 0..8 across lanes {
          y[b * 32 + w * 8 + t] = (b * 32 + w * 8 + t) as f32;
        }
      }
    }
  }
  let mut s = 0.0;
  for i in 0..96 {
    s = s + y[i];
  }
  println!("sum {}", s);

  let a = Tensor<f32, [4, 4]>::fill(1.0);
  let b = Tensor<f32, [4, 4]>::fill(2.0);
  let mut c = Tensor<f32, [8, 4]>::fill(0.0);
  spawn on(Topology::Cores) {
    for blk in 0..2 across blocks {
      let p = &a @ &b;
      for i in 0..4 across lanes {
        for j in 0..4 across lanes {
          c[blk * 4 + i][j] = p[i][j];
        }
      }
    }
  }
  println!("matmul {}", c[7][3]);
  return 0;
}
