//===----------------------------------------------------------------------===//
// An `if` whose value reads a tensor element, assigned to an element of another tensor.
// Both code generators compile it on the CPU and in a GPU region.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --run 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error
// OUT: cpu 3 5
// OUT-NEXT: region 7
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx 2>&1 | FileCheck %s --check-prefix=WARN --implicit-check-not=Warning: '--implicit-check-not=Warning in'
// WARN: Warning[W1029]
// RUN: FileCheck %s --check-prefix=PTX < %t.ptx
// PTX-LABEL: .entry pick_on_the_gpu(
// PTX-DAG: ld.global.nc.b32
// PTX-DAG: st.global.b32
// The AST code generator (`--legacy-codegen`) cannot write PTX, so its MLIR is checked. The
// value that the `if` gives is the value that is stored.
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h100-sxm.vx --emit-mlir 2>&1 | FileCheck %s --check-prefix=AST --implicit-check-not=unrealized_conversion_cast --implicit-check-not=Warning: '--implicit-check-not=Warning in'
// AST-LABEL: func.func @pick_on_the_gpu(
// AST: ^bb{{[0-9]+}}(%[[V:[0-9]+]]: f32):
// AST: memref.store %[[V]],

pub fn pick_on_the_gpu(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..n across blocks {
      for t in 0..1 across lanes {
        out[b] = if n > 1 {
          x[t]
        } else {
          0.0
        };
      }
    }
  }
  return;
}

fn pick(out : &mut Tensor<f32, [2]>, x : &Tensor<f32, [4]>, m : &Tensor<f32, [2, 2]>, n : i32) -> void {
  out[0] = if n > 1 {
    x[0]
  } else {
    0.0
  };
  out[1] = if n > 1 {
    m[1][0]
  } else {
    0.0
  };
  return;
}

fn main() -> i32 {
  let x = Tensor<f32, [4]>::fill(3.0);
  let m = Tensor<f32, [2, 2]>::fill(5.0);
  let mut out = Tensor<f32, [2]>::fill(0.0);
  pick(&mut out, &x, &m, 2);
  println!("cpu {} {}", out[0], out[1]);

  let src = transfer(Tensor<f32, [4]>::fill(7.0), Memory::HBM);
  let mut dst = transfer(Tensor<f32, [4]>::fill(0.0), Memory::HBM);
  pick_on_the_gpu(&mut dst, &src, 2);
  let back = transfer(dst, Memory::CPU_DRAM);
  println!("region {}", back[1]);
  return 0;
}
