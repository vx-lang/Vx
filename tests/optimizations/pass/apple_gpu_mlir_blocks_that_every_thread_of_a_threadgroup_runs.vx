// An `mlir!` block with `threads : 64` is the body of a threadgroup of 64 threads. Each thread
// writes its own number into the shared tile `t`, waits at a barrier, and writes the number of the
// thread opposite it, plus 1000 times the block, to `out`. After a second barrier, each thread
// writes 3 times its number into `t`. A barrier follows the block, so in the lane loop after it,
// each lane reads the element of `t` that the opposite thread wrote. The CPU cannot run such a
// block, so the program stops with a message when no GPU runs the kernel. Lane 0 of each subgroup
// of 32 threads also writes the sum of the numbers of its threads: 496 and 1520.
//
// REQUIRES: macos
// RUN: env VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.gpu | FileCheck %s
// RUN: FileCheck %s --check-prefix=GPU --input-file=%t.gpu
// RUN: env VX_DISPATCH_VERBOSE=1 vxc %s --legacy-codegen --host default --machine fleet/m4-uma.vx 2>%t.ast.gpu | FileCheck %s
// RUN: FileCheck %s --check-prefix=GPU --input-file=%t.ast.gpu
// RUN: env VX_METAL=0 not vxc %s --host default --machine fleet/m4-uma.vx 2>&1 | FileCheck %s --check-prefix=CPU
// RUN: env VX_METAL=0 not vxc %s --legacy-codegen --host default --machine fleet/m4-uma.vx 2>&1 | FileCheck %s --check-prefix=CPU
// RUN: vxc %s --host default --machine fleet/m4-uma.vx --emit-msl -o %t.metal && FileCheck %s --check-prefix=MSL --input-file=%t.metal
// RUN: vxc %s --legacy-codegen --host default --machine fleet/m4-uma.vx --emit-msl -o %t.ast.metal && FileCheck %s --check-prefix=MSL --input-file=%t.ast.metal
//
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 2 x 1 x 1, block 64
// CHECK: {{^}}mirror: 63 0 1063 1000{{$}}
// CHECK-NEXT: {{^}}twice: 378 0 378 0{{$}}
// CHECK-NEXT: {{^}}sums: 496 1520 496 1520{{$}}
// CPU: vx: the `mlir!` block with `threads` at line {{[0-9]+}}, column {{[0-9]+}} runs only on a GPU, but no GPU ran its kernel, so the CPU did
// CPU-NOT: mirror:
// The two barriers of the block, then the one after it, where the lane loop starts.
// MSL: threadgroup_barrier(
// MSL: threadgroup_barrier(
// MSL: threadgroup_barrier(
// MSL-NEXT: int {{v[0-9]+}} = (int)vx_tid.x;

pub fn mirror(out : &mut Tensor<i32, [?], Memory::HBM>, twice : &mut Tensor<i32, [?], Memory::HBM>, sums : &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..2 across blocks {
      let mut t = unsafe { Tensor<i32, [64], Memory::SMEM>::uninit() };
      let _d = mlir!( threads : 64, inputs : (%t = &mut t : memref<64xi32, 3>, %o = out : memref<?xi32>, %s = sums : memref<?xi32>, %b = b : i32), returns : i32, dialects : ["arith", "memref", "gpu", "scf"], ensures : [writes_only(t), writes_only(out[b * 64..b * 64 + 64]), writes_only(sums[b * 2..b * 2 + 2])]) {
        %tid = gpu.thread_id x
        %ti = arith.index_cast %tid : index to i32
        memref.store %ti, %t[%tid] : memref<64xi32, 3>
        gpu.barrier
        %c63 = arith.constant 63 : index
        %other = arith.subi %c63, %tid : index
        %v = memref.load %t[%other] : memref<64xi32, 3>
        %c1000 = arith.constant 1000 : i32
        %bk = arith.muli %b, %c1000 : i32
        %w = arith.addi %v, %bk : i32
        %c64 = arith.constant 64 : i32
        %base = arith.muli %b, %c64 : i32
        %bi = arith.index_cast %base : i32 to index
        %at = arith.addi %bi, %tid : index
        memref.store %w, %o[%at] : memref<?xi32>
        gpu.barrier
        %c3 = arith.constant 3 : i32
        %t3 = arith.muli %ti, %c3 : i32
        memref.store %t3, %t[%tid] : memref<64xi32, 3>
        %sum = gpu.subgroup_reduce add %ti : (i32) -> i32
        %sg = gpu.subgroup_id : index
        %lane = gpu.lane_id
        %c0 = arith.constant 0 : index
        %first = arith.cmpi eq, %lane, %c0 : index
        scf.if %first {
          %c2 = arith.constant 2 : index
          %bb = arith.index_cast %b : i32 to index
          %b2 = arith.muli %bb, %c2 : index
          %at2 = arith.addi %b2, %sg : index
          memref.store %sum, %s[%at2] : memref<?xi32>
        }
        macro.yield %w : i32
      };
      for l in 0..64 across lanes(64) {
        twice[b * 64 + l] = t[63 - l] * 2;
      }
    }
  }
  return;
}

fn main() -> i32 {
  let mut out = transfer(Tensor<i32>([128]), Memory::HBM);
  let mut twice = transfer(Tensor<i32>([128]), Memory::HBM);
  let mut sums = transfer(Tensor<i32>([4]), Memory::HBM);
  mirror(&mut out, &mut twice, &mut sums);
  let h = transfer(&out, Memory::CPU_DRAM);
  let d = transfer(&twice, Memory::CPU_DRAM);
  println!("mirror: {} {} {} {}", h[0], h[63], h[64], h[127]);
  println!("twice: {} {} {} {}", d[0], d[63], d[64], d[127]);
  let u = transfer(&sums, Memory::CPU_DRAM);
  println!("sums: {} {} {} {}", u[0], u[1], u[2], u[3]);
  return 0;
}
