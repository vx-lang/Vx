//===----------------------------------------------------------------------===//
// Matmuls with 64 columns of K, in the code of a subgroup loop. In `from_hbm` the first tile is
// `f8e4m3` in HBM, and in `from_smem` it is in shared memory. Both print the same sums.
// `e4m3_by_f16` multiplies an `f8e4m3` tile by an `f16` tile in HBM, and `f16_tiles` multiplies
// two `f16` tiles in HBM. `e4m3_from_hbm_by_f16` multiplies an `f8e4m3` tile in HBM by an `f16` tile
// in shared memory. With no GPU, the kernels run on the CPU.
//
// On the GPU, a sum over K does not depend on the order of K. So each lane takes its columns of K
// for two `mma.sync` from 16 bytes of a row of the first tile, with one `ld.v4.b32`. In
// `e4m3_by_f16`, each lane converts the fp8 values to f16, so one load gives four `mma.sync`. The
// rows of the second tile take the same order of K: in `f16_tiles`, rows 0 to 3 of a lane go to the first
// `mma.sync`, and rows 4 to 7 to the second. In `e4m3_from_hbm_by_f16`, `ldmatrix` loads the second
// tile, and each lane gives it a row in the same order, so each `mma.sync` has an `ldmatrix` of its own.
// The `cvt.rn.f16x2` from fp8 is a call of an LLVM intrinsic, so these two kernels have no inline PTX.
//
// RUN: vxc %s --host default --machine fleet/h200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen --host default --machine fleet/h200.vx --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env -u VX_GPU_CHIP vxc %s --host default --machine fleet/h200.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s --check-prefix=PTX --implicit-check-not=local_depot < %t.ptx
// RUN: env -u VX_GPU_CHIP vxc %s --legacy-codegen --host default --machine fleet/h200.vx --emit-ptx -o %t.ast.ptx
// RUN: FileCheck %s --check-prefix=PTX --implicit-check-not=local_depot < %t.ast.ptx
// CHECK: {{^}}from HBM: -5 -5 14 sum of all 1018{{$}}
// CHECK: {{^}}from shared memory: -5 -5 14 sum of all 1018{{$}}
// CHECK: {{^}}e4m3 by f16: -6 -6 13 sum of all -6{{$}}
// CHECK: {{^}}f16 tiles: -6 -6 13 sum of all -6{{$}}
// CHECK: {{^}}e4m3 from HBM by f16: -6 -6 13 sum of all -6{{$}}
// PTX-LABEL: .entry e4m3_by_f16(
// PTX-DAG: ld.shared.v4.b32 {%r[[W0:[0-9]+]], %r[[W1:[0-9]+]], %r{{[0-9]+}}, %r{{[0-9]+}}}, [%rd[[PROW:[0-9]+]]];
// PTX-DAG: ld.shared.v4.b32 {%r[[V0:[0-9]+]], %r[[V1:[0-9]+]], %r{{[0-9]+}}, %r{{[0-9]+}}}, [%rd[[PROW]]+512];
// PTX-DAG: mov.b32 {%rs[[P0:[0-9]+]], %rs[[P2:[0-9]+]]}, %r[[W0]];
// PTX-DAG: mov.b32 {%rs[[P1:[0-9]+]], %rs[[P3:[0-9]+]]}, %r[[V0]];
// PTX-DAG: mov.b32 {%rs[[P4:[0-9]+]], %rs[[P6:[0-9]+]]}, %r[[W1]];
// PTX-DAG: mov.b32 {%rs[[P5:[0-9]+]], %rs[[P7:[0-9]+]]}, %r[[V1]];
// PTX-NOT: begin inline asm
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H0:[0-9]+]], %rs[[P0]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H1:[0-9]+]], %rs[[P1]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H2:[0-9]+]], %rs[[P2]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H3:[0-9]+]], %rs[[P3]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H4:[0-9]+]], %rs[[P4]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H5:[0-9]+]], %rs[[P5]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H6:[0-9]+]], %rs[[P6]];
// PTX-DAG: cvt.rn.f16x2.e4m3x2 %r[[H7:[0-9]+]], %rs[[P7]];
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[H0]], %r[[H1]], %r[[H2]], %r[[H3]]},
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[H4]], %r[[H5]], %r[[H6]], %r[[H7]]},
// PTX-LABEL: .entry e4m3_from_hbm_by_f16(
// PTX: ld.global.nc.v4.b32 {%r{{[0-9]+}}, %r{{[0-9]+}}, %r{{[0-9]+}}, %r{{[0-9]+}}}, [%rd[[GROW:[0-9]+]]];
// PTX-NOT: mma.sync
// PTX-NOT: begin inline asm
// PTX: ld.global.nc.v4.b32 {%r{{[0-9]+}}, %r{{[0-9]+}}, %r{{[0-9]+}}, %r{{[0-9]+}}}, [%rd[[GROW]]+512];
// PTX-NOT: mma.sync
// PTX-NOT: begin inline asm
// PTX: ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16
// PTX-NOT: ldmatrix
// PTX-NOT: begin inline asm
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NOT: mma.sync
// PTX-NOT: begin inline asm
// PTX: ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16
// PTX-NOT: ldmatrix
// PTX-NOT: begin inline asm
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NOT: mma.sync
// PTX-NOT: begin inline asm
// PTX: ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16
// PTX-NOT: ldmatrix
// PTX-NOT: begin inline asm
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NOT: mma.sync
// PTX-NOT: begin inline asm
// PTX: ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16
// PTX-NOT: ldmatrix
// PTX-NOT: begin inline asm
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-LABEL: .entry f16_tiles(
// PTX: ld.global.nc.v4.b32 {%r[[F0:[0-9]+]], %r[[F2:[0-9]+]], %r[[F4:[0-9]+]], %r[[F6:[0-9]+]]}, [%rd[[FROW:[0-9]+]]];
// PTX-NEXT: ld.global.nc.v4.b32 {%r[[F1:[0-9]+]], %r[[F3:[0-9]+]], %r[[F5:[0-9]+]], %r[[F7:[0-9]+]]}, [%rd[[FROW]]+1024];
// PTX-NOT: mma.sync
// PTX: ld.global.nc.b16 %r{{[0-9]+}}, [%rd[[B:[0-9]+]]];
// PTX-NOT: mma.sync
// PTX: ld.global.nc.b16 %r{{[0-9]+}}, [%rd[[B]]+96];
// PTX-NOT: mma.sync
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[F0]], %r[[F1]], %r[[F2]], %r[[F3]]},
// PTX-NOT: mma.sync
// PTX: ld.global.nc.b16 %r{{[0-9]+}}, [%rd[[B]]+224];
// PTX-NOT: mma.sync
// PTX: mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[F4]], %r[[F5]], %r[[F6]], %r[[F7]]},
// PTX-LABEL: .entry from_hbm(
// PTX: ld.global.nc.v4.b32 {%r[[A0:[0-9]+]], %r[[A2:[0-9]+]], %r[[A4:[0-9]+]], %r[[A6:[0-9]+]]}, [%rd[[ROW:[0-9]+]]];
// PTX-NEXT: ld.global.nc.v4.b32 {%r[[A1:[0-9]+]], %r[[A3:[0-9]+]], %r[[A5:[0-9]+]], %r[[A7:[0-9]+]]}, [%rd[[ROW]]+512];
// PTX-NOT: mma.sync
// PTX: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32{{ *$}}
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[A0]], %r[[A1]], %r[[A2]], %r[[A3]]},
// PTX-NOT: mma.sync
// PTX: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32{{ *$}}
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[A4]], %r[[A5]], %r[[A6]], %r[[A7]]},
// PTX-LABEL: .entry from_smem(
// PTX: ld.shared.v4.b32 {%r[[S0:[0-9]+]], %r[[S2:[0-9]+]], %r[[S4:[0-9]+]], %r[[S6:[0-9]+]]}, [%rd[[SROW:[0-9]+]]];
// PTX-NEXT: ld.shared.v4.b32 {%r[[S1:[0-9]+]], %r[[S3:[0-9]+]], %r[[S5:[0-9]+]], %r[[S7:[0-9]+]]}, [%rd[[SROW]]+512];
// PTX-NOT: mma.sync
// PTX: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32{{ *$}}
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[S0]], %r[[S1]], %r[[S2]], %r[[S3]]},
// PTX-NOT: mma.sync
// PTX: mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32{{ *$}}
// PTX-NEXT: {{{.*}}},
// PTX-NEXT: {%r[[S4]], %r[[S5]], %r[[S6]], %r[[S7]]},

fn from_hbm(c : &mut Tensor<f32, [2, 32, 16], Memory::HBM>, a : &Tensor<f8e4m3, [2, 32, 64], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 64, 16], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe {
        Tensor<f32, [2, 32, 16], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..2 {
            for j in 0..16 {
              sb[w][i * 2 + k][j] = (((i * 2 + k) * 2 + j) % 5 - 2) as f8e4m3;
            }
          }
          for j in 0..16 {
            acc[w][i][j] = 1.0;
          }
        }
        acc[w] = acc[w] + (a[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          for j in 0..16 {
            c[w][i][j] = acc[w][i][j];
          }
        }
      }
    }
  }
  return;
}

fn from_smem(c : &mut Tensor<f32, [2, 32, 16], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sa = unsafe {
        Tensor<f8e4m3, [2, 32, 64], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 64, 16], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe {
        Tensor<f32, [2, 32, 16], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..64 {
            sa[w][i][k] = (((w * 32 + i) * 3 + k * 5) % 7 - 3) as f8e4m3;
          }
          for k in 0..2 {
            for j in 0..16 {
              sb[w][i * 2 + k][j] = (((i * 2 + k) * 2 + j) % 5 - 2) as f8e4m3;
            }
          }
          for j in 0..16 {
            acc[w][i][j] = 1.0;
          }
        }
        acc[w] = acc[w] + (sa[w] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          for j in 0..16 {
            c[w][i][j] = acc[w][i][j];
          }
        }
      }
    }
  }
  return;
}

fn e4m3_by_f16(c : &mut Tensor<f32, [2, 32, 16], Memory::HBM>, b : &Tensor<f16, [64, 16], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sa = unsafe {
        Tensor<f8e4m3, [2, 32, 64], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..64 {
            sa[w][i][k] = (((w * 32 + i) * 3 + k * 5) % 7 - 3) as f8e4m3;
          }
        }
        c[w] = (sa[w] as f32) @ (b as f32);
      }
    }
  }
  return;
}

fn e4m3_from_hbm_by_f16(c : &mut Tensor<f32, [2, 32, 16], Memory::HBM>, a : &Tensor<f8e4m3, [2, 32, 64], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sb = unsafe { Tensor<f16, [2, 64, 16], Memory::SMEM>::uninit() };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..2 {
            for j in 0..16 {
              sb[w][i * 2 + k][j] = (((i * 2 + k) * 2 + j) % 5 - 2) as f16;
            }
          }
        }
        c[w] = (a[w] as f32) @ (sb[w] as f32);
      }
    }
  }
  return;
}

fn f16_tiles(c : &mut Tensor<f32, [2, 32, 16], Memory::HBM>, a : &Tensor<f16, [2, 32, 64], Memory::HBM>, b : &Tensor<f16, [64, 16], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      for w in 0..2 across subgroups {
        c[w] = (a[w] as f32) @ (b as f32);
      }
    }
  }
  return;
}

fn say(h : &Tensor<f32, [2, 32, 16]>) -> void {
  let mut all = 0.0;
  for w in 0..2 {
    for i in 0..32 {
      for j in 0..16 {
        all = all + h[w][i][j];
      }
    }
  }
  println!("{} {} {} sum of all {}", h[0][0][0], h[1][31][15], h[1][20][5], all);
  return;
}

fn main() -> i32 {
  let mut ha = Tensor<f8e4m3, [2, 32, 64]>::fill(0.0);
  for w in 0..2 {
    for i in 0..32 {
      for k in 0..64 {
        ha[w][i][k] = (((w * 32 + i) * 3 + k * 5) % 7 - 3) as f8e4m3;
      }
    }
  }
  let a = transfer(ha, Memory::HBM);
  let mut c = transfer(Tensor<f32, [2, 32, 16]>::fill(0.0), Memory::HBM);
  from_hbm(&mut c, &a);
  let hc = transfer(c, Memory::CPU_DRAM);
  print!("from HBM: ");
  say(&hc);
  let mut d = transfer(Tensor<f32, [2, 32, 16]>::fill(0.0), Memory::HBM);
  from_smem(&mut d);
  let hd = transfer(d, Memory::CPU_DRAM);
  print!("from shared memory: ");
  say(&hd);
  let mut hb = Tensor<f16, [64, 16]>::fill(0.0);
  let mut ha16 = Tensor<f16, [2, 32, 64]>::fill(0.0);
  for k in 0..64 {
    for j in 0..16 {
      hb[k][j] = ((k * 2 + j) % 5 - 2) as f16;
    }
  }
  for w in 0..2 {
    for i in 0..32 {
      for k in 0..64 {
        ha16[w][i][k] = (((w * 32 + i) * 3 + k * 5) % 7 - 3) as f16;
      }
    }
  }
  let b16 = transfer(hb, Memory::HBM);
  let a16 = transfer(ha16, Memory::HBM);
  let mut e = transfer(Tensor<f32, [2, 32, 16]>::fill(0.0), Memory::HBM);
  e4m3_by_f16(&mut e, &b16);
  let he = transfer(e, Memory::CPU_DRAM);
  print!("e4m3 by f16: ");
  say(&he);
  let mut f = transfer(Tensor<f32, [2, 32, 16]>::fill(0.0), Memory::HBM);
  f16_tiles(&mut f, &a16, &b16);
  let hf = transfer(f, Memory::CPU_DRAM);
  print!("f16 tiles: ");
  say(&hf);
  let mut g = transfer(Tensor<f32, [2, 32, 16]>::fill(0.0), Memory::HBM);
  e4m3_from_hbm_by_f16(&mut g, &a);
  let hg = transfer(g, Memory::CPU_DRAM);
  print!("e4m3 from HBM by f16: ");
  say(&hg);
  return 0;
}
