// Kernels for the Apple GPU run there, and again on the CPU with VX_METAL=0, which runs the
// CPU copy of each kernel on 4 workers. Both runs must print the same numbers, to the last
// digit.
// The kernels: a blur of the rows and the columns of an image, the image moved by part of a
// pixel through calls to functions, a matrix product that keeps tiles in shared memory, and a
// brightness change of a BGRA frame, a u8 tensor with padded rows.
//
// REQUIRES: macos
// RUN: env VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.gpu | FileCheck %s --check-prefix=OUT
// RUN: FileCheck %s --check-prefix=GPU --input-file=%t.gpu
// RUN: env VX_METAL=0 VX_HOST_THREADS=4 VX_DISPATCH_VERBOSE=1 vxc %s --host default --machine fleet/m4-uma.vx 2>%t.cpu | FileCheck %s --check-prefix=OUT
// RUN: FileCheck %s --check-prefix=CPU --input-file=%t.cpu
//
// Eight launches: three fill the inputs, and five are the kernels above.
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 96 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 96 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 300 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 96 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 256 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 256 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 40 x 1 x 1, block 256
// GPU: [Vx Metal] {{vx_npu_kernel_[0-9]+}}: grid 40 x 1 x 1, block 256
// CPU-NOT: [Vx Metal]
// CPU: Falling back to CPU libffi dispatch on 4 workers!
//
// OUT: {{^}}blur 43195.65725585073{{$}}
// OUT-NEXT: {{^}}shift 43210.20744516142{{$}}
// OUT-NEXT: {{^}}product -4.6026072315871716{{$}}
// OUT-NEXT: {{^}}frame 5157808{{$}}

import core::convert;

// Each pixel becomes the average of 9 pixels of its row.
pub fn blur_rows(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..h across blocks {
      for x in 0..w across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..9 {
          let mut xx = x + d - 4;
          if xx < 0 {
            xx = 0;
          }
          if xx > w - 1 {
            xx = w - 1;
          }
          acc = acc + src[y][xx];
        }
        dst[y][x] = acc / 9.0;
      }
    }
  }
  return;
}

// Each pixel becomes the average of 9 pixels of its column.
pub fn blur_cols(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32) -> void {
  spawn on(Topology::Device) {
    for x in 0..w across blocks {
      for y in 0..h across lanes(256) {
        let mut acc : f32 = 0.0;
        for d in 0..9 {
          let mut yy = y + d - 4;
          if yy < 0 {
            yy = 0;
          }
          if yy > h - 1 {
            yy = h - 1;
          }
          acc = acc + src[yy][x];
        }
        dst[y][x] = acc / 9.0;
      }
    }
  }
  return;
}

// a when t is 0, b when t is 1, and a mix of the two between.
fn mix(a : f32, b : f32, t : f32) on Topology::Device -> f32
ensures writes_only()
{
  return a + (b - a) * t;
}

// v, moved into 0..=hi.
fn clamp_to(v : i32, hi : i32) on Topology::Device -> i32
ensures writes_only()
{
  if v < 0 {
    return 0;
  }
  if v > hi {
    return hi;
  }
  return v;
}

// The pixel of t at row y and column x. A row or column outside t becomes the nearest edge.
fn pixel(t : &Tensor<f32, [?, ?], Memory::HBM>, y : i32, x : i32, h : i32, w : i32) on Topology::Device -> f32
ensures reads_only(t)
{
  return t[clamp_to(y, h - 1)][clamp_to(x, w - 1)];
}

// Each pixel of dst is src read a quarter of a pixel down and three quarters right, mixed from
// the 4 nearest pixels of src.
pub fn shift_image(dst : &mut Tensor<f32, [?, ?], Memory::HBM>, src : &Tensor<f32, [?, ?], Memory::HBM>, h : i32, w : i32) -> void {
  spawn on(Topology::Device) {
    for y in 0..h across blocks {
      for x in 0..w across lanes(256) {
        let top = mix(pixel(src, y, x, h, w), pixel(src, y, x + 1, h, w), 0.75);
        let bottom = mix(pixel(src, y + 1, x, h, w), pixel(src, y + 1, x + 1, h, w), 0.75);
        dst[y][x] = mix(top, bottom, 0.25);
      }
    }
  }
  return;
}

// c = a * b for n x n matrices, n a multiple of 256. A block makes 256 elements of a row of c.
// It copies 16 elements of a and a 16 x 256 tile of b into shared memory, waits, and adds.
pub fn product(c : &mut Tensor<f32, [?, ?], Memory::HBM>, a : &Tensor<f32, [?, ?], Memory::HBM>, b : &Tensor<f32, [?, ?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for row in 0..n across blocks {
      for strip in 0..n / 256 across blocks {
        let mut ta = unsafe { Tensor<f32, [16], Memory::SMEM>::uninit() };
        let mut tb = unsafe { Tensor<f32, [4096], Memory::SMEM>::uninit() };
        let mut acc = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
        for t in 0..256 across lanes {
          acc[t] = 0.0;
        }
        for kt in 0..n / 16 {
          for t in 0..256 across lanes {
            if t < 16 {
              ta[t] = a[row][kt * 16 + t];
            }
            for r in 0..16 {
              tb[r * 256 + t] = b[kt * 16 + r][strip * 256 + t];
            }
          }
          for t in 0..256 across lanes {
            let mut s = acc[t];
            for k in 0..16 {
              s = s + ta[k] * tb[k * 256 + t];
            }
            acc[t] = s;
          }
        }
        for t in 0..256 across lanes {
          c[row][strip * 256 + t] = acc[t];
        }
      }
    }
  }
  return;
}

// A frame of BGRA bytes: each row of the tensor is a row of the frame with its padding, so
// it holds more than 4 * w bytes. The kernel scales the colors of each pixel by `gain`, keeps
// the alpha byte, and leaves the padding alone. It widens a byte with `f32::from`.
pub fn brighten(dst : &mut Tensor<u8, [?, ?], Memory::HBM>, src : &Tensor<u8, [?, ?], Memory::HBM>, h : i32, w : i32, gain : f32) -> void {
  spawn on(Topology::Device) {
    for y in 0..h across blocks {
      for x in 0..w across lanes(256) {
        for c in 0..4 {
          let mut v = f32::from(src[y][x * 4 + c]);
          if c < 3 {
            v = v * gain;
          }
          if v > 255.0 {
            v = 255.0;
          }
          dst[y][x * 4 + c] = v as u8;
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  let mut image = transfer(Tensor<f32, [96, 300]>::fill(0.0), Memory::HBM);
  let mut rows_done = transfer(Tensor<f32, [96, 300]>::fill(0.0), Memory::HBM);
  let mut blurred = transfer(Tensor<f32, [96, 300]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for y in 0..96 across blocks {
      for x in 0..300 across lanes(256) {
        image[y][x] = ((x * 7 + y * 13) % 256) as f32 / 255.0;
      }
    }
  }
  blur_rows(&mut rows_done, &image, 96, 300);
  blur_cols(&mut blurred, &rows_done, 96, 300);
  let host = transfer(blurred, Memory::CPU_DRAM);
  let mut sum : f64 = 0.0;
  for y in 0..96 {
    for x in 0..300 {
      sum = sum + (host[y][x] as f64) * ((y * 300 + x) % 5 + 1) as f64;
    }
  }
  println!("blur {}", sum);

  let mut shifted = transfer(Tensor<f32, [96, 300]>::fill(0.0), Memory::HBM);
  shift_image(&mut shifted, &image, 96, 300);
  let shifted_host = transfer(shifted, Memory::CPU_DRAM);
  let mut shift_sum : f64 = 0.0;
  for y in 0..96 {
    for x in 0..300 {
      shift_sum = shift_sum + (shifted_host[y][x] as f64) * ((y * 300 + x) % 5 + 1) as f64;
    }
  }
  println!("shift {}", shift_sum);

  let mut a = transfer(Tensor<f32, [256, 256]>::fill(0.0), Memory::HBM);
  let mut b = transfer(Tensor<f32, [256, 256]>::fill(0.0), Memory::HBM);
  let mut c = transfer(Tensor<f32, [256, 256]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for i in 0..256 across blocks {
      for j in 0..256 across lanes(256) {
        a[i][j] = ((i * 3 + j * 5) % 17) as f32 / 16.0 - 0.5;
        b[i][j] = ((i * 7 + j * 11) % 13) as f32 / 12.0 - 0.5;
      }
    }
  }
  product(&mut c, &a, &b, 256);
  let product_host = transfer(c, Memory::CPU_DRAM);
  let mut total : f64 = 0.0;
  for i in 0..256 {
    for j in 0..256 {
      total = total + (product_host[i][j] as f64) * ((i * 256 + j) % 7 + 1) as f64;
    }
  }
  println!("product {}", total);

  // 40 rows of 100 pixels, 448 bytes in each row.
  let mut frame = transfer(Tensor<u8, [40, 448]>::fill(0), Memory::HBM);
  let mut bright = transfer(Tensor<u8, [40, 448]>::fill(7), Memory::HBM);
  spawn on(Topology::Device) {
    for y in 0..40 across blocks {
      for x in 0..448 across lanes(256) {
        frame[y][x] = ((x * 5 + y * 3) % 256) as u8;
      }
    }
  }
  brighten(&mut bright, &frame, 40, 100, 1.5);
  let frame_host = transfer(bright, Memory::CPU_DRAM);
  let mut bytes : i64 = 0;
  for y in 0..40 {
    for x in 0..448 {
      bytes = bytes + (frame_host[y][x] as i64) * (((y * 448 + x) % 3 + 1) as i64);
    }
  }
  println!("frame {}", bytes);
  return 0;
}
