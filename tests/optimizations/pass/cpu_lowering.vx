// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=HOST
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" 2>&1 | FileCheck %s --check-prefix=HOST

fn dummy(x : i32) on Topology::CPU -> i32 {
  return x;
}

fn process(t : DynTensor<f32>) -> DynTensor<f32> {
  let mut res = Tensor<i32>([ 4, 4 ]).with_memory(Memory::CPU_DRAM);
  let val = spawn on(Topology::CPU) {
    dummy(0)
  };
  return t;
}

// CHECK-LABEL: func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK: vx.spawn topology(0)

// A CPU spawn stays on the host: convert-vx-to-standard turns it into an async.execute, so
// there is no kernel to outline and no plugin dispatch. vx-to-llvm then leaves this module
// untouched, which is why both pipelines above check the same prefix.
// HOST-LABEL: func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// HOST: %[[BUF:.*]] = memref.alloc(%{{.*}}, %{{.*}}) : memref<?x?xi32>
// HOST: %[[SLOT:.*]] = memref.alloca() : memref<memref<?x?xi32>>
// HOST: memref.store %[[BUF]], %[[SLOT]][] : memref<memref<?x?xi32>>
// HOST: async.execute {
// HOST: func.call @dummy(%{{.*}}) : (i32) -> i32
// HOST: async.yield
// HOST: return %arg0 : memref<?x?xf32>
// HOST-NOT: vx.launch
// HOST-NOT: vx_plugin_dispatch_async
