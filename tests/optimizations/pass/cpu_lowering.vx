// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=HOST
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" | FileCheck %s --check-prefix=VXLLVM

fn dummy(x: i32) on Topology::Host -> i32 {
  return x;
}

fn process(t: Tensor<f32>) -> Tensor<f32> {
  let mut res = Tensor<i32>([4, 4]).with_memory(Memory::Host_DRAM);
  let val = spawn on (Topology::Host) {
    dummy(0)
  };
  return t;
}

// FRONTEND: module {
// FRONTEND:   func.func private @printMemrefF32(memref<*xf32>)
// FRONTEND:   func.func private @printMemrefF64(memref<*xf64>)
// FRONTEND:   func.func private @printMemrefI32(memref<*xi32>)
// FRONTEND:   func.func private @printMemrefI64(memref<*xi64>)
// FRONTEND:   func.func private @printMemrefBF16(memref<*xbf16>)
// FRONTEND:   func.func @dummy(%arg0: i32) -> i32 {
// FRONTEND:     return %arg0 : i32
// FRONTEND:   }
// FRONTEND:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// FRONTEND:     %c4_i32 = arith.constant 4 : i32
// FRONTEND:     %0 = arith.index_cast %c4_i32 : i32 to index
// FRONTEND:     %c4_i32_0 = arith.constant 4 : i32
// FRONTEND:     %1 = arith.index_cast %c4_i32_0 : i32 to index
// FRONTEND:     %alloc = memref.alloc(%0, %1) : memref<?x?xi32>
// FRONTEND:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// FRONTEND:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// FRONTEND:     %2 = vx.spawn topology(0) {
// FRONTEND:       %c0_i32 = arith.constant 0 : i32
// FRONTEND:       %3 = func.call @dummy(%c0_i32) : (i32) -> i32
// FRONTEND:       vx.yield %3 : i32
// FRONTEND:     } : i32
// FRONTEND:     return %arg0 : memref<?x?xf32>
// FRONTEND:   }
// FRONTEND: }

// HOST: module {
// HOST:   func.func private @printMemrefF32(memref<*xf32>)
// HOST:   func.func private @printMemrefF64(memref<*xf64>)
// HOST:   func.func private @printMemrefI32(memref<*xi32>)
// HOST:   func.func private @printMemrefI64(memref<*xi64>)
// HOST:   func.func private @printMemrefBF16(memref<*xbf16>)
// HOST:   func.func @dummy(%arg0: i32) -> i32 {
// HOST:     return %arg0 : i32
// HOST:   }
// HOST:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// HOST:     %c0_i32 = arith.constant 0 : i32
// HOST:     %c4 = arith.constant 4 : index
// HOST:     %alloc = memref.alloc(%c4, %c4) : memref<?x?xi32>
// HOST:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// HOST:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// HOST:     %token = async.execute {
// HOST:       %0 = func.call @dummy(%c0_i32) : (i32) -> i32
// HOST:       async.yield
// HOST:     }
// HOST:     return %arg0 : memref<?x?xf32>
// HOST:   }
// HOST: }

// VXLLVM: module {
// VXLLVM:   func.func private @printMemrefF32(memref<*xf32>)
// VXLLVM:   func.func private @printMemrefF64(memref<*xf64>)
// VXLLVM:   func.func private @printMemrefI32(memref<*xi32>)
// VXLLVM:   func.func private @printMemrefI64(memref<*xi64>)
// VXLLVM:   func.func private @printMemrefBF16(memref<*xbf16>)
// VXLLVM:   func.func @dummy(%arg0: i32) -> i32 {
// VXLLVM:     return %arg0 : i32
// VXLLVM:   }
// VXLLVM:   func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// VXLLVM:     %c0_i32 = arith.constant 0 : i32
// VXLLVM:     %c4 = arith.constant 4 : index
// VXLLVM:     %alloc = memref.alloc(%c4, %c4) : memref<?x?xi32>
// VXLLVM:     %alloca = memref.alloca() : memref<memref<?x?xi32>>
// VXLLVM:     memref.store %alloc, %alloca[] : memref<memref<?x?xi32>>
// VXLLVM:     %token = async.execute {
// VXLLVM:       %0 = func.call @dummy(%c0_i32) : (i32) -> i32
// VXLLVM:       async.yield
// VXLLVM:     }
// VXLLVM:     return %arg0 : memref<?x?xf32>
// VXLLVM:   }
// VXLLVM: }
