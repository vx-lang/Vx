// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=HOST
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard,vx-to-llvm)" 2>&1 | FileCheck %s --check-prefix=HOST

fn dummy(x : i32) on Topology::CPU -> i32 {
  return x;
}

fn process(t : DynTensor<f32>) -> DynTensor<f32> {
  let mut res = Tensor<i32, [4, 4], Memory::CPU_DRAM>::uninit();
  let val = spawn on(Topology::CPU) {
    dummy(0)
  };
  return t;
}

// CHECK-LABEL: func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK: vx.spawn topology(0)

// A CPU spawn stays on the host, and convert-vx-to-standard inlines the region where it
// was written: the parent block splits around the spawn, the region's block lands in
// between, and the `vx.yield` becomes a branch to the continuation. So there is no kernel
// to outline and no plugin dispatch. vx-to-llvm then leaves this module untouched, which is
// why both pipelines above check the same prefix.
//
// It used to be wrapped in `async.execute` instead, which nothing lowered -- the module
// reached `mlir-translate` still holding an async op and translation refused it, so no host
// region ran. The absence of async below is the point, not an incidental detail.
// HOST-LABEL: func.func @process(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// HOST: %[[BUF:.*]] = memref.alloc(%{{.*}}, %{{.*}}) : memref<?x?xi32>
// HOST: %[[SLOT:.*]] = memref.alloca() : memref<memref<?x?xi32>>
// HOST: memref.store %[[BUF]], %[[SLOT]][] : memref<memref<?x?xi32>>
// HOST: cf.br ^[[BODY:.*]]
// HOST: ^[[BODY]]:
// HOST: call @dummy(%{{.*}}) : (i32) -> i32
// HOST: cf.br ^[[CONT:.*]]
// HOST: ^[[CONT]]:
// HOST: return %arg0 : memref<?x?xf32>
// HOST-NOT: async.execute
// HOST-NOT: vx.launch
// HOST-NOT: vx_plugin_dispatch_async
