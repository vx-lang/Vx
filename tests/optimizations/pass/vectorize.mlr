// RUN: vxc %s -a emit-mlir > %t.mlir
// RUN: FileCheck %s < %t.mlir

fn test_vectorize(a: Tensor<f32, [16, 16]>, b: Tensor<f32, [16, 16]>) -> Tensor<f32, [16, 16]> {
    return a + b;
}

// CHECK: llvm.func @test_vectorize
// CHECK: llvm.intr.masked.load
// CHECK: llvm.fadd
// CHECK: vector<16xf32>
