//===----------------------------------------------------------------------===//
// An outlined region that computes a matmul is labelled as such, so a plugin can
// route it to a vendor kernel instead of inferring the operation from buffer
// shapes (#325). Shapes cannot answer it: for square operands every operand
// assignment conforms, and swapping them yields a plausible matrix of wrong
// numbers rather than a failure.
//
// The label rides on both ops -- `vx.kernel` names the outlined body, and
// `vx.launch` is what lowers to the dispatch call, so that is the one that has
// to carry the fact to a runtime.
//
// `c = a @ b` emits a zero-fill of the accumulator followed by the matmul, which
// is GEMM with beta = 0, so both are subsumed by one library call and the region
// still classifies. `kernel_kind_unrecognized.vx` covers the other direction.
//
// The pass pipeline is pinned to the vx lowering alone: the attribute is created
// there, and the later conversion to a dispatch call consumes it, so a default
// pipeline would show nothing.
//
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s
// CHECK-DAG: vx.kernel {{.*}}vx.kernel_kind = "matmul"
// CHECK-DAG: vx.launch {{.*}}vx.kernel_kind = "matmul"

fn gemm(a : Tensor<f32>, b : Tensor<f32>) -> Tensor<f32> {
  let mut c : Tensor<f32> = Tensor<f32>([ 2, 3 ]);
  spawn on(Topology::GPU) {
    c = a @b;
  }
  return c;
}
