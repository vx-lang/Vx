//===----------------------------------------------------------------------===//
// A CUDA kernel can declare at most 48 KiB of static shared memory. `stage` uses 160 KiB, so its
// two tensors are views into dynamic shared memory: `a` at offset 0 and `b` at offset 131072.
// The launch passes the size (`shared=` in the payload), and so does a host program that launches
// the PTX (`dynamic_shared_bytes` in the manifest). `small` uses 4 KiB and keeps static storage.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s --check-prefix=PTX < %t.ptx
// RUN: FileCheck %s --check-prefix=JSON < %t.json
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --check-prefix=PAYLOAD
// PTX: .extern .shared .align 16 .b8 __dynamic_shmem__0[];
// PTX-LABEL: .entry stage(
// PTX: st.shared{{.*}}[%rd{{[0-9]+}}+131072]
// PTX-LABEL: .entry small(
// PTX: .shared .align 16 .b8 vx_npu_kernel_{{[0-9]+}}_smem_0[4096];
// JSON: "dynamic_shared_bytes": 163840,
// JSON-NEXT: "name": "stage"
// JSON-NOT: dynamic_shared_bytes
// PAYLOAD: shared=163840\00image=

pub fn stage(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    let mut a = unsafe { Tensor<f32, [32768], Memory::SMEM>::uninit() };
    let mut b = unsafe { Tensor<f32, [8192], Memory::SMEM>::uninit() };
    for i in 0..32768 {
      a[i] = x[i];
    }
    for i in 0..8192 {
      b[i] = a[i] + a[i + 8192];
    }
    for i in 0..8192 {
      out[i] = b[i];
    }
  }
  return;
}

pub fn small(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    let mut a = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
    for i in 0..1024 {
      a[i] = x[i];
    }
    for i in 0..1024 {
      out[i] = a[1023 - i];
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
