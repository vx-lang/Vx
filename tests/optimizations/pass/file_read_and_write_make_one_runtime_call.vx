//===----------------------------------------------------------------------===//
// After `opt -O3`, `File::read` and `File::write` call the Rust runtime once. They make no other
// call. Calls of LLVM intrinsics, such as `llvm.lifetime.start`, are left out of the list.
//
// Each RUN line cuts one function out of the IR, and keeps each call and each store in it. A
// sorted list has a fixed order, so the CHECK-NEXT lines must match the whole list:
//
// - one call of the runtime (`_vx_file_try_read` or `_vx_file_try_write`)
// - 3 stores that set the outputs of the runtime call (count, code and flag) before the call
// - 1 store that makes the `FileError` after a failure
//
// A new call or store in these functions, such as an allocation, makes this test fail. Then
// measure the cost, and update the checks if the new code is needed.
//
// RUN: vxc %s --action emit-llvm 2>/dev/null | ${MLIR_TRANSLATE_PATH:-mlir-translate} --mlir-to-llvmir | ${OPT_PATH:-opt} -O3 -S | awk '/^define .*File\$read"\(/,/^}/' | grep -o -E '(call [^@]*@[A-Za-z_]+|store [a-z0-9]+)' | grep -v '@llvm$' | LC_ALL=C sort | FileCheck %s --check-prefix=READ --implicit-check-not='call ' --implicit-check-not='store ' # flat-codegen
// RUN: vxc %s --action emit-llvm 2>/dev/null | ${MLIR_TRANSLATE_PATH:-mlir-translate} --mlir-to-llvmir | ${OPT_PATH:-opt} -O3 -S | awk '/^define .*File\$write"\(/,/^}/' | grep -o -E '(call [^@]*@[A-Za-z_]+|store [a-z0-9]+)' | grep -v '@llvm$' | LC_ALL=C sort | FileCheck %s --check-prefix=WRITE --implicit-check-not='call ' --implicit-check-not='store ' # flat-codegen

// READ: call i32 @_vx_file_try_read
// READ-NEXT: store i1
// READ-NEXT: store i32
// READ-NEXT: store i32
// READ-NEXT: store i64

// WRITE: call i32 @_vx_file_try_write
// WRITE-NEXT: store i1
// WRITE-NEXT: store i32
// WRITE-NEXT: store i32
// WRITE-NEXT: store i64

import core::result;
import std::fs;
import std::string;
import std::vec;

fn main(root : Root) -> i32 {
  let path = unsafe {
    String::from_c_str("/tmp/vx_file_read_and_write_codegen.txt")
  };
  let mut file = File::open(&root.files, &path, OpenMode::ReadWriteCreate()).unwrap();
  let mut bytes = Vec<u8>::new();
  bytes.push(65u8);
  let wrote = file.write(&bytes).unwrap();
  let read = file.read(&mut bytes).unwrap();
  return (wrote + read) as i32;
}
