//===----------------------------------------------------------------------===//
// `aligned(N)` in a tensor type makes the tensor start at a multiple of N bytes. In `stage`, the
// tensors are in dynamic shared memory: `a` takes 131040 bytes, so `b`, aligned to 1024, starts at
// 131072, and the dynamic shared memory is declared `.align 1024`. In `small`, the tensor is static
// `.shared` storage, declared `.align 256`.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx
// CHECK: .extern .shared .align 1024 .b8 __dynamic_shmem__0[];
// CHECK-LABEL: .entry stage(
// CHECK: st.shared{{.*}}[%rd{{[0-9]+}}+131072]
// CHECK-LABEL: .entry small(
// CHECK: .shared .align 256 .b8 vx_npu_kernel_{{[0-9]+}}_smem_0[4096];

pub fn stage(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    let mut a = unsafe { Tensor<f32, [32760], Memory::SMEM>::uninit() };
    let mut b = unsafe {
      Tensor<f32, [8192], Memory::SMEM, aligned(1024)>::uninit()
    };
    for i in 0..32760 {
      a[i] = x[i];
    }
    for i in 0..8192 {
      b[i] = a[i] + a[i + 8192];
    }
    for i in 0..8192 {
      out[i] = b[i];
    }
  }
  return;
}

pub fn small(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    let mut a = unsafe {
      Tensor<f32, [1024], Memory::SMEM, aligned(256)>::uninit()
    };
    for i in 0..1024 {
      a[i] = x[i];
    }
    for i in 0..1024 {
      out[i] = a[1023 - i];
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
