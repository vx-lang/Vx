// Float arithmetic, and a float tensor whose first element is a whole number.

fn halves() -> Tensor<f64, [4]> {
  let mut t : Tensor<f64, [4]> = [ 0.0f64, 0.0f64, 0.0f64, 0.0f64 ];
  let mut x : f64 = 0.0;
  for i in 0..4 {
    t[i] = x;
    x = x + 0.5f64;
  }
  return t;
}

fn main() -> i32 {
  let a : f64 = comptime {
    0.1f64 * 3.0f64
  };
  println!("{}", a);
  let b : f32 = comptime {
    0.1f32 + 0.2f32
  };
  println!("{}", b);
  let c : f32 = comptime {
    16777216.0f32 + 1.0f32
  };
  println!("{}", c);
  let t : Tensor<f64, [4]> = comptime {
    halves()
  };
  println!("{}", t[1] + t[3]);
  return 0;
}
