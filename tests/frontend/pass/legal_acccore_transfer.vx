//===- legal_acccore_transfer.vx - Vx Compiler ---------------------------*- Vx
//-*-===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);

  spawn on(Topology::NPU[0]) {
    // Legal transfer from NPU HBM to Local SRAM
    let t_sram = transfer(t_npu, Memory::Local_SRAM);
    spawn on(Topology::AccCore[0]) {
      // CHECK-NOT: error
      let valid = t_sram;
    }
  }

  return 0;
}

