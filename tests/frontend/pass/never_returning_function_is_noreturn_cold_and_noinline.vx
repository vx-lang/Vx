//===----------------------------------------------------------------------===//
// A function declared `-> !` is marked `noreturn`, `cold` and `noinline` for LLVM, on both code
// generators. It runs only when the program fails, so LLVM keeps it out of its callers.
//
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s
// RUN: vxc %s --action emit-llvm --legacy-codegen 2>&1 | FileCheck %s
// CHECK: llvm.func hidden @fail(%arg0: !llvm.ptr) attributes {dso_local, passthrough = ["noreturn", "cold", "noinline", ["probe-stack", "inline-asm"]]}
fn fail(msg : *const i8) -> ! {
  panic(msg);
}

fn main() -> i32 {
  fail("stop");
}
