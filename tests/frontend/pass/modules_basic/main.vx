// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The imported module's function is emitted into this module under its own name, and the
// call here resolves to it -- which is the whole claim of importing a sibling file.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @add(%{{.*}}, %{{.*}}) : (f32, f32) -> f32
// CHECK-LABEL: func.func @add(%arg0: f32, %arg1: f32) -> f32
// CHECK: arith.addf
import tests::frontend::pass::modules_basic::math;

fn main() -> i32 {
  let result = add(1.0, 2.0);
  return 0;
}
