// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// An imported module's function is emitted under its own name with its own body.
// CHECK-LABEL: func.func @add
// CHECK: arith.addf
fn add(a : f32, b : f32) -> f32 {
  return a + b;
}

struct Matrix {
  data : f32
}
