//===----------------------------------------------------------------------===//
// Test enum definitions, variant construction, and pattern matching.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// `Result` is a data-carrying enum with no generics: a `{ tag, payload }` value, constructed
// in place, returned by value, and matched by tag. The program compiles on the flat path; the
// AST path still fails on the payload extraction (Vx#398).
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @classify(%{{.*}}) : (i32) -> !llvm.struct<(i32, i32)>
// CHECK: call @unwrap_or(%{{.*}}, %{{.*}}) : (!llvm.struct<(i32, i32)>, i32) -> i32
// CHECK-LABEL: func.func @unwrap_or(%arg0: !llvm.struct<(i32, i32)>, %arg1: i32) -> i32
// CHECK: %[[TAG:.*]] = llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK: %[[OK:.*]] = arith.cmpi eq, %[[TAG]], %{{.*}} : i32
// CHECK: cf.cond_br %[[OK]], ^bb1, ^bb2
// CHECK-LABEL: func.func @classify(%arg0: i32) -> !llvm.struct<(i32, i32)>
// CHECK: arith.cmpi sge, %arg0, %{{.*}} : i32

enum Result {
  Ok(i32),
  Err(i32),
}

enum Color {
  Red, Green, Blue,
}

fn classify(x: i32) -> Result {
  if x >= 0 {
    return Result::Ok(x);
  }
  return Result::Err(0 - x);
}

fn unwrap_or(r: Result, default: i32) -> i32 {
  let mut out = default;
  match r {
    Result::Ok(val) => {
      out = val;
    }
    , Result::Err(code) => {
      out = 0 - code;
    }
  }
  return out;
}

fn main() -> i32 {
  let a = classify(42);
  let b = classify(0 - 7);
  let c = Color::Green;

  let x = unwrap_or(a, 0);
  let y = unwrap_or(b, 0);
  // 42 + (-7) = 35
  return x + y;
}
