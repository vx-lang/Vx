// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s --check-prefix=UNUSED
//
// The legacy code generator emits only what the program uses. It prints an f32 tensor, so
// only the f32 tensor print helper is declared; it calls `stdout_write` from `std::io`, so
// that function and the extern it calls are emitted, and the rest of `std::io` is not.

// CHECK-DAG: func.func private @printMemrefF32(
// CHECK-DAG: func.func private @vx_stdout_write(
// CHECK-DAG: func.func @stdout_write(
// UNUSED-NOT: @printMemrefF64
// UNUSED-NOT: @printMemrefI32
// UNUSED-NOT: @printMemrefI64
// UNUSED-NOT: @printMemrefBF16
// UNUSED-NOT: @stderr_write
// UNUSED-NOT: @stdin_read
// UNUSED-NOT: @vx_stderr_write
// UNUSED-NOT: @vx_stdin_read

import std::io;

fn main() -> i32 {
  let t = Tensor<f32, [2]>::new();
  print(t);
  unsafe { let n = stdout_write("ok
", 3); }
  return 0;
}
