// Test: Multi-hop transfer to Remote_HBM via NPU_HBM and NIC_RAM.
// Dijkstra's algorithm should find: CPUDRAM -> NPUHBM -> NicRam -> RemoteHbm

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;

  // Transfer from host DRAM to remote HBM
  // The compiler should auto-insert multi-hop transfers
  // CHECK-NOT: error
  let t_remote = transfer(t_host, Memory::Remote_HBM);

  return 0;
}

// CHECK: module
