fn custom_matmul(a : Tensor<f32>, b : Tensor<f32>) -> Tensor<f32> {
  let mut result : Tensor<f32> = Tensor([ a.shape[0], b.shape[1] ]);
  for
  i in 0..a.shape [0] {
    for
    j in 0..b.shape [1] {
      result[i][j] = 0;
      for
      k in 0..a.shape [1] { result[i][j] += a[i][k] * b[k][j]; }
    }
  }
  return result;
}

fn distributed_matmul(a : Tensor<f32>, b : Tensor<f32>) -> Tensor<f32> {
  let local_a = transfer(a, Memory::NPU_HBM);
  let local_b = transfer(b, Memory::NPU_HBM);
  spawn on(Topology::NPU[0]) {
    let result = local_a;
    // Testing the compiler frontend syntax parsing and typechecking without
    // custom_matmul to avoid cross-device implicit coercion errors.
  }
  return a;
}
