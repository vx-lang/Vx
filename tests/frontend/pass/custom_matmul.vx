// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @custom_matmul(%arg0: memref<?x?xf32>, %arg1: memref<?x?xf32>) -> memref<?x?xf32>
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : index
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C1:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : index
// CHECK: cf.cond_br %[[C1]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C2:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : index
// CHECK: cf.cond_br %[[C2]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @distributed_matmul(%arg0: memref<?x?xf32>, %arg1: memref<?x?xf32>) -> memref<?x?xf32>
// CHECK: arith.constant 0 : index
// CHECK: return %{{.*}} : memref<?x?xf32>
fn custom_matmul(a : DynTensor<f32>, b : DynTensor<f32>) -> DynTensor<f32> {
  let mut result : DynTensor<f32> = DynTensor<f32>::uninit([a.extent(0), b.extent(1)]);
  for i in 0..a.extent(0) {
    for j in 0..b.extent(1) {
      result[i][j] = 0.0;
      for k in 0..a.extent(1) {
        result[i][j] += a[i][k] * b[k][j];
      }
    }
  }
  return result;
}

fn distributed_matmul(a : DynTensor<f32>, b : DynTensor<f32>) -> DynTensor<f32> {
  let local_a = transfer(a, Memory::NPU_HBM);
  let local_b = transfer(b, Memory::NPU_HBM);
  spawn on(Topology::NPU[0]) {
    let result = local_a;
    // Testing the compiler frontend syntax parsing and typechecking without
    // custom_matmul to avoid cross-device implicit coercion errors.
  }
  return a;
}
