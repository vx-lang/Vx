fn test_nested_loops() -> i32 {
  let mut i = 0;
  let mut sum = 0;

  loop {
    if i == 5 {
      break;
    }

    let mut j = 0;
    loop {
      if j == 3 {
        break;
      }
      if j == 1 {
        j = j + 1;
        continue;
      }
      sum = sum + j;
      j = j + 1;
    }

    i = i + 1;
  }
  return sum;
}

fn test_early_return() -> i32 {
  let mut i = 0;
  loop {
    if i == 10 {
      return 42;
    }

    let mut j = 0;
    loop {
      if j == 5 {
        return i + j;
      }
      j = j + 1;
    }
  }
  return 0;
}

fn main() -> i32 {
  let s1 = test_nested_loops();
  let s2 = test_early_return();
  return s1 + s2;
}
