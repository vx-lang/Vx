//===----------------------------------------------------------------------===//
// bf16 `erf` and `rsqrt`, which LLVM libc does not have in bf16: the double results of `core::libm`
// (`erff`'s polynomial, and the double `rsqrt`) rounded once to bf16, on every bf16 bit pattern: a
// hash of the result bits of each (every NaN counted as 32704). The expected hashes are the
// correctly rounded values, from 113-bit libquadmath.
//
// It runs at -O2: at the default level, LLVM's x86 back end flushes a subnormal bf16 to zero
// when it is passed between functions on a CPU with AVX512-BF16.
//
// RUN: vxc %s -O2 2>&1 | FileCheck %s
// RUN: vxc %s -O2 --legacy-codegen 2>&1 | FileCheck %s
// CHECK: 15595143277473071244 5726953958650581599
import core::num;

fn hash(f : i32) -> u64 {
  let mut h : u64 = 0u64;
  for i in 0..65536 {
    let x = libm_bf16_from_bits(i as u16);
    let mut r = x.erf();
    if f == 1 {
      r = x.rsqrt();
    }
    let mut rb = libm_bf16_to_bits(r) as u64;
    if r != r {
      rb = 32704u64;
    }
    h = (h ^ rb).wrapping_mul(1099511628211u64);
  }
  return h;
}

fn main() -> i32 {
  print(hash(0));
  print!(" ");
  print(hash(1));
  return 0;
}
