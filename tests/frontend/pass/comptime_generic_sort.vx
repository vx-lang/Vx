//===----------------------------------------------------------------------===//
// One sort, written once, generic over the length, called with a literal, evaluated
// while compiling.
//
// A call carrying type arguments used to be skipped: the evaluator's call arm matched
// only a call without them, so `sort<4>(input)` was never run and an assert about its
// result quietly became a run-time check. A build passed while proving nothing.
//
// The reason it was skipped is worth writing down, because it is not the obvious one.
// By the time the evaluator sees this call the checker has already instantiated it and
// rewritten the name to the instance -- so the name is a mangled one that neither table
// of bodies has heard of, and the instance carries no generics because the arguments
// were substituted into it when it was made. Looking the instance up is most of the fix.
//
// Both spellings are here. `sort<4>` gives the length explicitly and `sort` leaves it to
// be deduced from the argument; both end up at the same instance, and a change that
// handled only the explicit one would pass half this file.
//
// Every element is asserted, and each was confirmed to go red on its own. What this file
// cannot catch is the evaluator giving up -- an assert it does not run is silently
// accepted -- so fail/comptime_generic_sort_wrong.vx is what holds that.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32

fn sort<const N : i32>(a : Tensor<i64, [N]>) -> Tensor<i64, [N]> {
  let mut w : Tensor<i64, [N]> = a;
  for i in 0..N {
    for j in 0..N - 1 {
      if w[j] > w[j + 1] {
        let t : i64 = w[j];
        w[j] = w[j + 1];
        w[j + 1] = t;
      }
    }
  }
  return w;
}

fn main() -> i32 {
  comptime {
    // The length written out.
    let input : Tensor<i64, [4]> = [ 3i64, 1i64, 4i64, 2i64 ];
    let out : Tensor<i64, [4]> = sort<4>(input);
    assert(out[0] == 1i64, "explicit length, element 0");
    assert(out[1] == 2i64, "explicit length, element 1");
    assert(out[2] == 3i64, "explicit length, element 2");
    assert(out[3] == 4i64, "explicit length, element 3");

    // The same function with the length deduced from the argument.
    let other : Tensor<i64, [4]> = [ 9i64, 7i64, 8i64, 6i64 ];
    let sorted : Tensor<i64, [4]> = sort(other);
    assert(sorted[0] == 6i64, "deduced length, element 0");
    assert(sorted[3] == 9i64, "deduced length, element 3");
  }
  return 0;
}
