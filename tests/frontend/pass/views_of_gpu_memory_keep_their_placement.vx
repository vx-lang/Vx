//===----------------------------------------------------------------------===//
// A row, a row of a row, a reshape and a field of a tensor in GPU memory keep the tensor's
// placement in their type, and code running on the GPU reads them. Each `let` declares the
// placed type, so a view that lost its placement would not match it. A pointer into a row
// points into GPU memory.

Memory CPU_DRAM {}
Memory GPU_HBM {
  capacity: 40 GiB, bandwidth: 1555 GB/s, managed: explicit
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::GPU_HBM,
  visible: [ Memory::GPU_HBM ],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 10,
  transfer Memory::GPU_HBM -> Memory::CPU_DRAM : 10
}

struct H {
  t : Tensor<f32, [4], Memory::GPU_HBM>,
}

fn main() -> i32 {
  let host = Tensor<f32, [4, 4]>::fill(1.0);
  let on_gpu = transfer(host, Memory::GPU_HBM);
  let host3 = Tensor<f32, [2, 4, 4]>::fill(1.0);
  let on_gpu3 = transfer(host3, Memory::GPU_HBM);
  let host_row = Tensor<f32, [4]>::fill(1.0);
  let h = H {
    t : transfer(host_row, Memory::GPU_HBM)
  };

  spawn on(Topology::Dev) {
    let row : Tensor<f32, [4], Memory::GPU_HBM> = on_gpu[1];
    let inner : Tensor<f32, [4], Memory::GPU_HBM> = on_gpu3[1][2];
    let flat : Tensor<f32, [16], Memory::GPU_HBM> = on_gpu.reshape([16]);
    let t : Tensor<f32, [4], Memory::GPU_HBM> = h.t;
    let p : *const f32 in Memory::GPU_HBM = on_gpu[1].as_ptr();
    let _sum = row[0] + inner[1] + flat[2] + t[3] + h.t[0] + unsafe { *p };
  }
  return 0;
}
