// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn reassigned_to_local(n : i32) -> i32 {
  let mut outside : i32 = 0i32;
  let value = comptime {
    let mut alias = &mut outside;
    let mut local : i32 = 0i32;
    alias = &mut local;
    let _ignored = if n > 0i32 {
      touch(alias)
    } else {
      1i32
    };
    7i32
  };
  return value;
}

fn shadowed_local(n : i32) -> i32 {
  let mut outside : i32 = 0i32;
  let value = comptime {
    let _scope_only = if true {
      let alias = &mut outside;
      0i32
    } else {
      1i32
    };
    let mut alias : i32 = 0i32;
    let _ignored = if n > 0i32 {
      touch(&mut alias)
    } else {
      1i32
    };
    7i32
  };
  return value;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func @shadowed_local(%arg0: i32) -> i32 {
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %c7_i32 = arith.constant 7 : i32
// CHECK:     return %c7_i32 : i32
// CHECK:   }
// CHECK:   func.func @reassigned_to_local(%arg0: i32) -> i32 {
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %c7_i32 = arith.constant 7 : i32
// CHECK:     return %c7_i32 : i32
// CHECK:   }
// CHECK:   func.func @touch(%arg0: !llvm.ptr {llvm.noalias}) -> i32 {
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = llvm.getelementptr %arg0[%c0_i32] : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK:     %c9_i32 = arith.constant 9 : i32
// CHECK:     llvm.store %c9_i32, %0 : i32, !llvm.ptr
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     return %c1_i32 : i32
// CHECK:   }
// CHECK: }
