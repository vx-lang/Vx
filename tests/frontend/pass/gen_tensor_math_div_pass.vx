fn main() -> Tensor<f32, [16, 16]> {
  let a: Tensor<f32, [16, 16]> = Tensor_f32(16, 16);
  let b: Tensor<f32, [16, 16]> = Tensor_f32(16, 16);
  return a / b;
}




