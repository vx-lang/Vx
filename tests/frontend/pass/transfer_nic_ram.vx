// Test: Transfer to NIC_RAM memory space.

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;
  // Transfer to NPU HBM first, then to NIC
  let t_npu = transfer(t_host, Memory::NPU_HBM);
  // CHECK-NOT: error
  let t_nic = transfer(t_npu, Memory::NIC_RAM);

  return 0;
}

// CHECK: module
