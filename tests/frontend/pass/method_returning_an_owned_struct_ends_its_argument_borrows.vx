// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// `a.rest(&b)` returns a new `N` that holds no reference, so `b` is not borrowed after the
// call, as for a function call. Euclid's loop then moves `b` into `a`.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main
import std::vec;

struct N {
  v : Vec<i32>,
}

impl N {
  fn rest(self : &N, b : &N) -> N {
    let mut v = Vec<i32>::new();
    if b.v.len() > 1 {
      v.push((self.v.len() % b.v.len()) as i32);
    }
    return N {
      v : v
    };
  }
}

fn main() -> i32 {
  let mut a = N {
    v : Vec<i32>::new()
  };
  let mut b = N {
    v : Vec<i32>::new()
  };
  b.v.push(1i32);
  while b.v.len() > 0 {
    let r = a.rest(&b);
    a = b;
    b = r;
  }
  return a.v.len() as i32;
}
