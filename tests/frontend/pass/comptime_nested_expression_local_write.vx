// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

fn main() -> i32 {
  let result = comptime {
    let value = if true {
      let mut inner : i32 = 0i32;
      inner = 4i32;
      inner
    } else {
      2i32
    };
    value
  };
  return result;
}
