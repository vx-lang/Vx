//===----------------------------------------------------------------------===//
// `-j N` compiles through the parallel frontend and then the ordinary backend. The note on
// stderr says which frontend ran; the function in the MLIR says the backend got its output.
//
// RUN: vxc -j 4 --emit-mlir %s 2>&1 | FileCheck %s

fn double(x: i32) -> i32 {
  return x + x;
}

fn main() -> i32 {
  return double(21);
}

// CHECK: [parallel-frontend] emitted module with -j 4
// CHECK: func.func @double
// CHECK: func.func @main
