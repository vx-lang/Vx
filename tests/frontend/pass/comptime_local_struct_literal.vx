// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

struct Holder {
  value : &mut i32,
}

fn touch(value : &mut i32) -> i32 {
  *value = 9i32;
  return 1i32;
}

fn main(n : i32) -> i32 {
  let value = comptime {
    let mut local : i32 = 0i32;
    let holder = Holder {
      value : &mut local
    };
    let _ignored = if n > 0i32 {
      touch(holder.value)
    } else {
      1i32
    };
    7i32
  };
  return value;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @main(%arg0: i32) -> i32 {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %c7_i32 = arith.constant 7 : i32
// CHECK:     return %c7_i32 : i32
// CHECK:   }
// CHECK:   func.func @touch(%arg0: !llvm.ptr {llvm.noalias}) -> i32 {
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = llvm.getelementptr %arg0[%c0_i32] : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK:     %c9_i32 = arith.constant 9 : i32
// CHECK:     llvm.store %c9_i32, %0 : i32, !llvm.ptr
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     return %c1_i32 : i32
// CHECK:   }
// CHECK: }
