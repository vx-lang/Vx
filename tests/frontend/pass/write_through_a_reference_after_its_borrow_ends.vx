// `x` borrows what `m` points at, but `*m = 1` comes after the last use of `x`.

fn main() -> i32 {
  let mut v = 0;
  let m = &mut v;
  let x = &*m;
  print(*x);
  *m = 1;
  print(*m);
  return 0;
}
