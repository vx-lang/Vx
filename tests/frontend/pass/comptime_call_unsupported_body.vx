//===----------------------------------------------------------------------===//
// A call whose body holds a statement that the run-time assert check cannot run has no value
// there.
//
// `pick` returns 5. Its body holds a call statement, `noop();`, which the evaluator behind a
// run-time assert does not run. Answering with what the other statements leave would be a
// guess. The two asserts in `_guess` contradict each other, so this file compiles only while
// that evaluator has no value for `pick()`. Nothing calls `_guess`, so they never run.
//
// The `comptime` interpreter does run call statements, so the assert in `main` is decided,
// and it is true.
//
// A deep recursion is in here too, at 200 calls: under the limit, so it must still be
// evaluated. That is the other half of the depth rule, whose refusing half is in
// fail/comptime_call_depth_limit.vx.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32

fn noop() -> void {
  return;
}

fn pick() -> i64 {
  let mut total : i64 = 0;
  noop();
  total = 5;
  return total;
}

fn countdown(n : i64) -> i64 {
  return if n <= 0 {
    0
  } else {
    countdown(n - 1) + 1
  };
}

fn _guess() -> void {
  assert(pick() == 5, "the call answered, and not with the 5 it assigns");
  assert(pick() != 5, "the call answered with 5, so call statements now run");
}

fn main() -> i32 {
  comptime {
    assert(pick() == 5, "the interpreter ran the call statement");
    assert(countdown(200) == 200, "a recursion under the limit still evaluates");
  }
  return 0;
}
