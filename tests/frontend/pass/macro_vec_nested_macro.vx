// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vx_vec_grow(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<(ptr, i32, i32)>
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK-LABEL: func.func @ref$mut$Vec$i32$push$i32(%arg0: !llvm.ptr {llvm.noalias}, %arg1: i32) -> i32
// CHECK: call @vx_vec_grow(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, i64, i64) -> !llvm.ptr
import std::vec;
import std::closure;

macro_rules get_val { ($v : expr) => {
    $v + 10
  }; }
fn main() -> i32 {
  let mut v = vec![ get_val!(5), get_val!(10) ];
  return 0;
}