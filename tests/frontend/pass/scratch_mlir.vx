// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
impl<T: Float, const N: i32, const M: i32> Tensor<T, [N, M]> {
  fn compare(self: &Tensor<T, [N, M]>, other: &Tensor<T, [N, M]>) -> bool {
    let res = mlir!(
    inputs: (%lhs = self: memref<N x M x f32>, %rhs = other: memref<N x M x f32>),
    clobbers: [],
    returns: bool,
    dialects: ["linalg", "arith", "memref", "func"]
    ) {
      ^bb0(%lhs: memref<N x M x f32>, %rhs: memref<N x M x f32>):
      %true = arith.constant 1 : i1
      %res = memref.alloca() : memref<i1>
      memref.store %true, %res[] : memref<i1>
      linalg.generic {
        indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> ()>
        ],
        iterator_types = ["reduction", "reduction"]
      } ins(%lhs, %rhs : memref<N x M x f32>, memref<N x M x f32>) outs(%res : memref<i1>) {
        ^bb0(%a: f32, %b: f32, %out: i1):
        %cmp = arith.cmpf oeq, %a, %b : f32
        %and = arith.andi %out, %cmp : i1
        linalg.yield %and : i1
      }
      %val = memref.load %res[] : memref<i1>
      func.return %val : i1
    };
    return res;
  }
}
