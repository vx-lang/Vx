// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: llvm.mlir.addressof @".str.0" : !llvm.ptr
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
macro_rules get_str { () => {
    "hello from macro!"
  }; }

fn main() -> i32 {
  let s = get_str!();
  return 0;
}
