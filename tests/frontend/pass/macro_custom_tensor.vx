// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = memref.alloc() : memref<10x20xf32>
// CHECK: %[[V1:.*]] = arith.constant 0 : i32
// CHECK: %[[V2:.*]] = arith.index_cast %[[V1]] : i32 to index
// CHECK: %[[V3:.*]] = memref.dim %[[V0]], %[[V2]] : memref<10x20xf32>
// CHECK: %[[V4:.*]] = arith.index_cast %[[V3]] : index to i32
// CHECK: return %[[V4]] : i32
import std::vec;
import std::closure;

macro_rules shape_zero { ($t : expr) => {
    $t.shape[0]
  }; }
fn main() -> i32 {
  let t = Tensor<f32, [10, 20]>::uninit();
  let s = shape_zero!(t);
  return s;
}