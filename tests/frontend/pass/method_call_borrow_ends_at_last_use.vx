// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// The borrow a method call makes of its receiver ends at the last use of what it returned,
// as in Rust. A number or a raw pointer holds no borrow, so the vector can grow afterwards.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main
import std::vec;

fn slice_used_before_the_push() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(7i32);
  let first = v.as_slice();
  let k = *first;
  v.push(8i32);
  return k;
}

fn number_result_then_push() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(1i32);
  let n = v.len();
  v.push(2i32);
  return n;
}

fn keep(_p : *mut i32) -> i32 {
  return 1i32;
}

// A raw pointer has no lifetime, as in Rust. After the push it may point at freed memory, so
// it is only passed on here, not read.
fn raw_pointer_then_push() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(1i32);
  let p = v.as_mut_ptr();
  v.push(2i32);
  return keep(p);
}

fn main() -> i32 {
  return slice_used_before_the_push() + number_result_then_push() + raw_pointer_then_push();
}
