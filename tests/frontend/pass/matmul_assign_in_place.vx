// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// `c = a @ b` fills the buffer `c` already names. It used to allocate a second one and rebind
// `c` to it, leaving the declared buffer written by nothing and freed by nothing (Vx#391).
//
// Three tensors are declared and three are allocated. A fourth allocation here would be the
// orphan, so the count is the assertion.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[A:.*]] = memref.alloc() : memref<2x3xf32>
// CHECK: %[[B:.*]] = memref.alloc() : memref<3x4xf32>
// CHECK: %[[C:.*]] = memref.alloc() : memref<2x4xf32>
// CHECK-NOT: memref.alloc(
// The product is written into `c`'s own buffer, zeroed first because matmul accumulates.
// CHECK: linalg.fill ins(%{{.*}} : f32) outs(%[[C]] : memref<2x4xf32>)
// CHECK: linalg.matmul ins(%[[A]], %[[B]] : memref<2x3xf32>, memref<3x4xf32>) outs(%[[C]] : memref<2x4xf32>)

fn main() -> i32 {
  let mut a = Tensor<f32, [2, 3]>::uninit();
  let mut b = Tensor<f32, [3, 4]>::uninit();
  let mut c = Tensor<f32, [2, 4]>::uninit();
  for i in 0..2 {
    for k in 0..3 {
      a[i][k] = ((i * 3 + k) as f32);
    }
  }
  for k in 0..3 {
    for j in 0..4 {
      b[k][j] = ((k * 4 + j) as f32);
    }
  }
  c = a @ b;
  print(c[0][0]);
  print(c[1][3]);
  return 0;
}
