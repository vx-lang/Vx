// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module


fn gen_math_f32_add() -> f32 {
  let a: f32 = 10f32;
  let b: f32 = 5f32;
  return a + b;
}

fn gen_math_f32_div() -> f32 {
  let a: f32 = 10f32;
  let b: f32 = 5f32;
  return a / b;
}

fn gen_math_f32_mul() -> f32 {
  let a: f32 = 10f32;
  let b: f32 = 5f32;
  return a * b;
}

fn gen_math_f32_sub() -> f32 {
  let a: f32 = 10f32;
  let b: f32 = 5f32;
  return a - b;
}

