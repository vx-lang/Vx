// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// A function named like C's `abs`. Compiled alone, nothing else has the name, so it keeps it.
// CHECK: func.func @abs(
fn abs(x : i32) -> i32 {
  return x + 100;
}
