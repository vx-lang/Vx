// RUN: vxc --package tests=tests %s --action emit-mlir 2>&1 | FileCheck %s
// This module imports `plus`, which has a function `abs`, and declares C's `abs`. Its own
// declaration comes first, so `abs` here is the C function.
// CHECK: func.func private @abs(i32) -> i32
// CHECK-LABEL: func.func @c_abs(
// CHECK: call @abs(
import tests::frontend::pass::modules_c_function::plus;

extern "C" {
  fn abs(x : i32) -> i32;
}

fn c_abs(x : i32) -> i32 {
  return unsafe { abs(x) };
}
