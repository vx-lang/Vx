//===----------------------------------------------------------------------===//
// Test generic structs, generic enums, and generic function instantiation.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// `Pair<i32>` is a synthesized instance layout, read through the method's receiver;
// `Maybe<i32>` a `{ tag, payload }` matched by tag. The program compiles on the flat path; the
// AST path still fails on the payload extraction (Vx#398).
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @make_pair(%{{.*}}, %{{.*}}) : (i32, i32) -> !llvm.struct<(i32, i32)>
// CHECK: call @Pair$i32$sum(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: %[[TAG:.*]] = llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK: %[[JUST:.*]] = arith.cmpi eq, %[[TAG]], %{{.*}} : i32
// CHECK: cf.cond_br %[[JUST]], ^bb1, ^bb2
// CHECK-LABEL: func.func @make_pair(%arg0: i32, %arg1: i32) -> !llvm.struct<(i32, i32)>
// CHECK-LABEL: func.func @Pair$i32$sum(%arg0: !llvm.ptr {llvm.readonly}) -> i32
// CHECK: llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK: llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK: arith.addi

struct Pair<T> {
  first: T,
  second: T,
}

enum Maybe<T> {
  Just(T),
  Nothing,
}

impl Pair<i32> {
  fn sum(self: &Pair<i32>) -> i32 {
    return self.first + self.second;
  }
}

fn make_pair(a: i32, b: i32) -> Pair<i32> {
  return Pair<i32> {
    first: a, second: b
  };
}

fn main() -> i32 {
  let p = make_pair(10, 32);
  let s = p.sum();

  let m = Maybe<i32>::Just(42);
  let mut result = 0;
  match m {
    Maybe<i32>::Just(val) => {
      result = val;
    }
    , Maybe<i32>::Nothing => {
      result = 0;
    }
  }
  // s = 42, result = 42 → 84
  return s + result;
}
