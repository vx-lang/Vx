//===----------------------------------------------------------------------===//
// Test generic structs, generic enums, and generic function instantiation.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// The IR assertion this file used to carry could not run: the program does not
// compile on the default path (Vx#398), so there is no module to match against.
// It is restored when that is fixed. The semantic check below is what this file
// verifies today.

struct Pair<T> {
  first: T,
  second: T,
}

enum Maybe<T> {
  Just(T),
  Nothing,
}

impl Pair<i32> {
  fn sum(self: &Pair<i32>) -> i32 {
    return self.first + self.second;
  }
}

fn make_pair(a: i32, b: i32) -> Pair<i32> {
  return Pair<i32> {
    first: a, second: b
  };
}

fn main() -> i32 {
  let p = make_pair(10, 32);
  let s = p.sum();

  let m = Maybe<i32>::Just(42);
  let mut result = 0;
  match m {
    Maybe<i32>::Just(val) => {
      result = val;
    }
    , Maybe<i32>::Nothing => {
      result = 0;
    }
  }
  // s = 42, result = 42 → 84
  return s + result;
}
