// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// The IR assertions this file carried could not run: it does not compile as a
// standalone program (the checker rejects it on N), which is why the corpus
// sweep also excludes it. They are restored when that is fixed.


struct Buffer<T, const N : i32> {
  val : T
}

impl<T, const N : i32>
Buffer<T, N> {
  fn get_size(self : &Buffer<T, N>) -> i32 {
    return N;
  }
}

fn test_const_generics_methods() -> void {
  let b = Buffer<f32, 25> {
    val : 3.14
  };
  let sz = b.get_size();
  assert(true);
}
