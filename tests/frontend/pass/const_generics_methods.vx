// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// CHECK: module
// CHECK: func.func @"Buffer_{{.*}}get_size_{{.*}}"
// CHECK: %c25_i32 = arith.constant 25 : i32
// CHECK: return %c25_i32 : i32

struct Buffer<T, const N : i32> {
  val : T
}

impl<T, const N : i32>
Buffer<T, N> {
  fn get_size(self : &Buffer<T, N>) -> i32 {
    return N;
  }
}

fn test_const_generics_methods() -> void {
  let b = Buffer<f32, 25> {
    val : 3.14
  };
  let sz = b.get_size();
  assert(true);
}
