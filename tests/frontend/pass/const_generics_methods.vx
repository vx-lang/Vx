// RUN: vxc %s --action emit-mlir
// XFAIL: *
//
// The IR assertions this file carried could not run: it does not compile as a standalone
// program (the checker rejects it on N), which is why the corpus sweep also excludes it.
// The XFAIL above reports the day that changes, and the assertions go back.


struct Buffer<T, const N : i32> {
  val : T
}

impl<T, const N : i32>
Buffer<T, N> {
  fn get_size(self : &Buffer<T, N>) -> i32 {
    return N;
  }
}

fn test_const_generics_methods() -> void {
  let b = Buffer<f32, 25> {
    val : 3.14
  };
  let sz = b.get_size();
  assert(true);
}
