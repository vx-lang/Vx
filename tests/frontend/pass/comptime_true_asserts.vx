//===----------------------------------------------------------------------===//
// Every assert in this `comptime` block is true, so the block folds to its value, 2.
// The last assert is inside an `if` on `argc`, and it is true whether or not that branch runs.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK-LABEL: func.func @main
// CHECK: arith.constant 2 : i64

fn bump(x : &mut i64) -> void {
  *x = *x + 1i64;
}

fn main(argc : i32) -> i32 {
  let x = comptime {
    let mut v : i64 = 1i64;
    bump(&mut v);
    assert(v == 2i64, "v is 2");
    for i in 0..3 {
      assert(i < 3, "i is in the range");
    }
    if argc > 1i32 {
      assert(v == 2i64, "v is still 2");
    };
    v
  };
  print(x);
  return 0;
}
