//===----------------------------------------------------------------------===//
// `Box::new` gets its memory from C's `malloc`, and the `Box`'s drop gives it back with C's
// `free`. The compiler calls both for `vx.heap_alloc` and `vx.heap_free`. This program also has
// its own `malloc` and `free`. The C functions keep their names, so the program's functions get
// new ones, and each call reaches the function it names. The program prints 5, 6 and 42.
//
// RUN: vxc %s --emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func @function_with_the_name_of_a_c_function__malloc(
// CHECK-DAG: func.func @function_with_the_name_of_a_c_function__free(
// CHECK-DAG: vx.heap_alloc
// CHECK-DAG: vx.heap_free
// EXPECT: 5
// EXPECT: 6
// EXPECT: 42

import std::box;

fn malloc(n : i64) -> i64 {
  return n + 1;
}

fn free(n : i64) -> i64 {
  return n * 2;
}

fn main() -> i32 {
  println!("{}", malloc(4));
  println!("{}", free(3));
  let b = Box<i32>::new (42);
  unsafe { println!("{}", *b.ptr); }
  return 0;
}
