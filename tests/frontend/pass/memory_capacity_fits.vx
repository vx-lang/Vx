//===----------------------------------------------------------------------===//
// A tensor that fits its target memory space's capacity is accepted: a 64x64 f32 tile
// (16 KiB) transferred into a 1 MiB NPU_HBM.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

Memory NPU_HBM {
  capacity: 1 MiB
}

fn main() -> i32 {
  let big: Tensor<f32, [64, 64]> = Tensor<f32>([64, 64]);
  let staged = transfer(big, Memory::NPU_HBM);
  return 0;
}

// CHECK: func.func @main
