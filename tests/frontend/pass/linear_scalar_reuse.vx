//===----------------------------------------------------------------------===//
// Scalars (i32, f32, bool) are NOT linear types and can be reused freely.
// This test confirms that scalar values survive multiple uses without
// triggering "moved or consumed" errors.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @test_float_reuse() -> i32
// CHECK: %[[V0:.*]] = arith.constant 3.140000e+00 : f32
// CHECK: %[[V1:.*]] = arith.constant 2.000000e+00 : f32
// CHECK: arith.mulf %[[V0]], %[[V1]] : f32
// CHECK: %[[V2:.*]] = arith.constant 4.000000e+00 : f32
// CHECK: arith.mulf %[[V0]], %[[V2]] : f32
// CHECK: %[[V3:.*]] = arith.constant 0 : i32
// CHECK: return %[[V3]] : i32
// CHECK-LABEL: func.func @test_bool_reuse() -> i32
// CHECK-LABEL: func.func @test_scalar_reuse() -> i32
// CHECK: %[[V0:.*]] = arith.constant 42 : i32
// CHECK: %[[V1:.*]] = arith.constant 1 : i32
// CHECK: arith.addi %[[V0]], %[[V1]] : i32
// CHECK: %[[V2:.*]] = arith.constant 2 : i32
// CHECK: arith.addi %[[V0]], %[[V2]] : i32
// CHECK: %[[V3:.*]] = arith.constant 3 : i32
// CHECK: %[[V4:.*]] = arith.muli %[[V0]], %[[V3]] : i32
// CHECK: return %[[V4]] : i32

fn test_scalar_reuse() -> i32 {
  let x = 42;
  let y = x + 1;
  let z = x + 2;
  let w = x * 3;
  return w;
}

fn test_bool_reuse() -> i32 {
  let flag = true;
  if flag {
    let a = 1;
  }
  if flag {
    let b = 2;
  }
  return 0;
}

fn test_float_reuse() -> i32 {
  let pi = 3.14;
  let area = pi * 2.0;
  let circumference = pi * 4.0;
  return 0;
}
