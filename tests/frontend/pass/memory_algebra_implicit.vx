//===- memory_algebra_implicit.vx - Vx Compiler --------------------------*- Vx -*-===//
// RUN: vxc %s --action print-ast 2>&1 | FileCheck %s

trait Relocatable {
  fn relocate(self: CustomHostData) -> CustomHostData;
}

struct CustomHostData {
  id: i32,
  host_tensor: Tensor<f32>,
}

impl Relocatable for CustomHostData {
  fn relocate(self: CustomHostData) -> CustomHostData {
    let new_tensor = transfer(self.host_tensor, Memory::NPU_HBM);
    // Cast to avoid type mismatch
    return self;
  }
}

fn main() -> i32 {
  let host_data = CustomHostData {
    id: 1,
    host_tensor: Tensor<f32>(),
  };

  spawn on(Topology::NPU[0]) {
    let x = host_data.host_tensor[0];
  }
  return 0;
}

// CHECK: Function: main
// CHECK: name: "CustomHostData$relocate"
