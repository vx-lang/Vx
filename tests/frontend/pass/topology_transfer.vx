//===----------------------------------------------------------------------===//
// Unified transfer tests: exercises NIC_RAM, Remote_HBM, and multi-hop
// transfers through Dijkstra's shortest-path solver.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// --- Transfer to NIC_RAM ---
fn test_transfer_nic_ram() -> i32 {
  let t_host : Tensor<f32, []> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);
  // CHECK-NOT: error
  let t_nic = transfer(t_npu, Memory::NIC_RAM);

  return 0;
}

// --- Multi-hop transfer to Remote_HBM ---
// Dijkstra should find: CPUDRAM -> NPUHBM -> NicRam -> RemoteHbm
fn test_transfer_remote_hbm() -> i32 {
  let t_host : Tensor<f32, []> = 1.0;
  // CHECK-NOT: error
  let t_remote = transfer(t_host, Memory::Remote_HBM);

  return 0;
}

// --- Multi-hop transfer CPUDRAM -> NPUHBM -> LocalSRAM and back ---
fn test_multi_hop_sram() -> void {
  let host_tensor = Tensor<f32>();
  let acc_tensor = transfer(host_tensor, Memory::Local_SRAM);
  let host_tensor_2 = transfer(acc_tensor, Memory::CPU_DRAM);
}

fn main() -> i32 {
  test_transfer_nic_ram();
  test_transfer_remote_hbm();
  test_multi_hop_sram();
  return 0;
}

// CHECK: module
