// RUN: vxc %s 2>&1 | FileCheck %s
//
// The branches of an `if` or a `match` run after its condition, so what they use is in use while
// the condition runs. These programs stay valid:
//
// - `read_in_arm`: the arm reads `s`, which the value of the `match` borrowed;
// - `borrow_after_condition`: the condition reads a copy of `s.x`, so the branch may borrow `s`;
// - `name_hidden_by_arm`: the arm's own `m` hides the outer `&mut`, which nothing uses after;
// - `let_in_branch`: the branch's own `let m` is a different variable, so the outer `m` is not
//   in use while the condition reads `s`.

struct S {
  x : i32,
}

enum Held {
  R(&i32),
  Nothing,
}

fn get(s : &S) -> Held {
  return Held::R(&s.x);
}

fn read_in_arm() -> i32 {
  let s = S {
    x : 1
  };
  match get(&s) {
    Held::R(r) => {
      return *r + s.x;
    }
    Held::Nothing => {
      return 0;
    }
  }
}

fn borrow_after_condition() -> i32 {
  let mut s = S {
    x : 1
  };
  if s.x == 1 {
    let m = &mut s;
    m.x = 3;
  }
  return s.x;
}

fn name_hidden_by_arm() -> i32 {
  let mut s = S {
    x : 4
  };
  let m = &mut s;
  m.x = 5;
  match get(&s) {
    Held::R(m) => {
      return *m;
    }
    Held::Nothing => {
      return 0;
    }
  }
}

fn let_in_branch() -> i32 {
  let mut s = S {
    x : 1
  };
  let m = &mut s;
  m.x = 2;
  if s.x == 2 {
    let m = &mut s;
    m.x = 3;
  }
  return s.x;
}

fn main() -> i32 {
  // CHECK: 2 3 5 3
  println!("{} {} {} {}", read_in_arm(), borrow_after_condition(), name_hidden_by_arm(), let_in_branch());
  return 0;
}
