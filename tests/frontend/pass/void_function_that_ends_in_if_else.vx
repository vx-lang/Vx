//===----------------------------------------------------------------------===//
// A `void` function can end in an `if`/`else` with no value. The program prints 1 0.
//
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s
// RUN: vxc %s 2>&1 | FileCheck %s
// CHECK: 1 0

fn set(flag : &mut bool, yes : bool) -> void {
  if yes {
    *flag = true;
  } else {
    *flag = false;
  }
}

fn main() -> i32 {
  let mut a = false;
  let mut b = true;
  set(&mut a, true);
  set(&mut b, false);
  println!("{} {}", a as i32, b as i32);
  return 0;
}
