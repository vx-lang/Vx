// RUN: vxc --package geometry=tests/modules/a_package_dir %s --run 2>&1 | FileCheck %s
// RUN: vxc -j 2 --package geometry=tests/modules/a_package_dir %s --run 2>&1 | FileCheck %s
// `--package name=dir` reads `name::..` imports from `dir`, at any depth, with or without `-j`,
// and the stdlib still resolves beside it.
// CHECK: area 9
// CHECK-NEXT: sides 4

import std::box;
import geometry::area;
import geometry::shapes::sides;

fn main() -> i32 {
  print!("area ");
  print!(square_area(3));
  print!("
sides ");
  print!(square_sides());
  print!("
");
  return 0;
}
