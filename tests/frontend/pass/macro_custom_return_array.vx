// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 1 : i32
// CHECK: arith.constant 2 : i32
// CHECK: memref.alloc() : memref<2xi32>
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: arith.index_cast %[[V0]] : i32 to index
// CHECK: %[[V1:.*]] = arith.constant 1 : i32
// CHECK: arith.index_cast %[[V1]] : i32 to index
// CHECK: %[[V2:.*]] = arith.constant 0 : i32
// CHECK: arith.index_cast %[[V2]] : i32 to index
// CHECK: %[[V3:.*]] = memref.load %{{.*}} : memref<2xi32>
// CHECK: %[[V4:.*]] = arith.constant 1 : i32
// CHECK: arith.cmpi eq, %[[V3]], %[[V4]] : i32
// CHECK: %[[V5:.*]] = arith.constant 1 : i32
// CHECK: arith.index_cast %[[V5]] : i32 to index
// CHECK: %[[V6:.*]] = memref.load %{{.*}} : memref<2xi32>
// CHECK: %[[V7:.*]] = arith.constant 2 : i32
// CHECK: arith.cmpi eq, %[[V6]], %[[V7]] : i32
// CHECK: %[[V8:.*]] = arith.constant 0 : i32
// CHECK: return %[[V8]] : i32
macro_rules create_arr { ($x : expr, $y : expr) => {
    [$x, $y]
  }; }

fn main() -> i32 {
  let arr = create_arr!(1, 2);
  assert(arr[0] == 1);
  assert(arr[1] == 2);
  return 0;
}
