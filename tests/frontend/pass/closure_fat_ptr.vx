// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @Closure_1_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Closure_1", (i32)>
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: memref.alloca() : memref<i32>
// CHECK: %[[V1:.*]] = memref.load %{{.*}}[] : memref<i32>
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @Closure_2_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Closure_2", (i32)>
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: memref.alloca() : memref<i32>
// CHECK: %[[V1:.*]] = memref.load %{{.*}}[] : memref<i32>
// CHECK: %[[V2:.*]] = arith.constant 1 : i32
// CHECK: %[[V3:.*]] = arith.addi %[[V1]], %[[V2]] : i32
// CHECK: return %[[V3]] : i32
// CHECK-LABEL: func.func @Closure_3_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Closure_3", (i32)>
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: memref.alloca() : memref<i32>
// CHECK: %[[V1:.*]] = memref.load %{{.*}}[] : memref<i32>
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @Closure_4_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Closure_4", (i32)>
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: memref.alloca() : memref<i32>
// CHECK: %[[V1:.*]] = memref.load %{{.*}}[] : memref<i32>
// CHECK: %[[V2:.*]] = arith.constant 1 : i32
// CHECK: %[[V3:.*]] = arith.addi %[[V1]], %[[V2]] : i32
// CHECK: return %[[V3]] : i32
// CHECK-LABEL: func.func @Closure_5_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Closure_5", (i32)>
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: memref.alloca() : memref<i32>
// CHECK: %[[V1:.*]] = memref.load %{{.*}}[] : memref<i32>
// CHECK: %[[V2:.*]] = arith.constant 2 : i32
// CHECK: %[[V3:.*]] = arith.addi %[[V1]], %[[V2]] : i32
// CHECK: return %[[V3]] : i32
// CHECK-LABEL: func.func @create_closure() -> !llvm.struct<(ptr, ptr)>
// CHECK: %[[V0:.*]] = arith.constant 42 : i32
// CHECK: llvm.mlir.undef : !llvm.struct<"Closure_1", (i32)>
// CHECK: llvm.insertvalue %[[V0]], %{{.*}} : !llvm.struct<"Closure_1", (i32)>
// CHECK: llvm.mlir.undef : !llvm.struct<(ptr, ptr)>
// CHECK: llvm.insertvalue %{{.*}}, %{{.*}} : !llvm.struct<(ptr, ptr)>
// CHECK: %[[V1:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: %[[V2:.*]] = llvm.alloca %[[V1]] x !llvm.struct<"Closure_1", (i32)> : (i32) -> !llvm.ptr
// CHECK: %[[V3:.*]] = llvm.insertvalue %[[V2]], %{{.*}} : !llvm.struct<(ptr, ptr)>
// CHECK: return %[[V3]] : !llvm.struct<(ptr, ptr)>
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @Closure_3_call(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @Closure_4_call(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @Closure_5_call(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @create_closure() : () -> !llvm.struct<(ptr, ptr)>
fn create_closure() -> ||->i32 {
  let text = 42;

  // In Vx, closures capture by value implicitly, so no 'move' is needed!
  let my_closure = || text;
  return my_closure as ||->i32;
}

fn main() -> i32 {
  let mut x = 10;

  // Create a closure that captures `x` by reference (implicit in Vx)
  let my_closure = || x + 1;

  // Cast the closure to a fat pointer
  let fat_ptr = my_closure as ||->i32;

  // Call the fat pointer via func.call_indirect
  let result = fat_ptr();

  let name = 99;
  let print_name = || name; // Inferred: value capture

  print_name();
  let y = name; // Works because name was copied into the closure

  let mut score = 0;
  let increment = || score + 1;

  let s = increment();
  // Cannot borrow `score` while closure holds &mut (not implemented yet in Vx)

  let consume_data = || score + 2; // Inferred: data is moved into the closure

  consume_data();

  assert(result == 11);
  assert(create_closure()() == 42);

  return 0;
}
