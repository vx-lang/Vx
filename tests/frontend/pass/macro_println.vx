// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s # flat-codegen
// CHECK-DAG: func.func private @vx_print_str(
// CHECK-DAG: func.func private @vx_print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @vx_print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @vx_print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @vx_print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @vx_print_i32(%{{.*}}) : (i32) -> i32
// CHECK: call @vx_print_str(%{{.*}}) : (!llvm.ptr) -> i32
fn main() -> i32 {
  println!("Hello Vx!");
  println!("Printing a number: %d", 42);
  return 0;
}
