// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
//
// In each function, the borrow `r` of `d` is last used before `d` is read. A block later
// declares a new `r`, and uses it. That `r` is a different variable, so the borrow of `d` has
// already ended when `d` is read. The compiler used to count the inner `r` as a use of the
// outer one, and gave E4002 at the read of `d`.

struct P {
  x : i64,
}

fn in_an_if_block() -> i64 {
  let mut d : Tensor<i64, [3]> = [ 1i64, 2i64, 3i64 ];
  let r : &mut Tensor<i64, [3]> = &mut d;
  r[0] = 9i64;
  let first = d[0];
  let mut p = P {
    x : 1i64
  };
  if true {
    let r : &mut P = &mut p;
    r.x = 5i64;
  };
  return first * 10i64 + p.x;
}

fn in_a_for_loop() -> i64 {
  let mut d : Tensor<i64, [3]> = [ 1i64, 2i64, 3i64 ];
  let r : &mut Tensor<i64, [3]> = &mut d;
  r[1] = 7i64;
  let second = d[1];
  let mut p = P {
    x : 0i64
  };
  for i in 0..3 {
    let r : &mut P = &mut p;
    r.x = r.x + 1i64;
  }
  return second * 10i64 + p.x;
}

fn in_an_unsafe_block_that_ends_in_a_value() -> i64 {
  let mut d : Tensor<i64, [3]> = [ 1i64, 2i64, 3i64 ];
  let r : &mut Tensor<i64, [3]> = &mut d;
  r[2] = 4i64;
  let third = d[2];
  let mut p = P {
    x : 6i64
  };
  let x = unsafe { let r : &mut P = &mut p; r.x };
  return third * 10i64 + x;
}

fn main() -> i32 {
  // CHECK: 95 73 46
  print(in_an_if_block());
  print!(" ");
  print(in_a_for_loop());
  print!(" ");
  print(in_an_unsafe_block_that_ends_in_a_value());
  return 0;
}
