//===----------------------------------------------------------------------===//
// bf16 `sin`, `cos` and `tan` on every one of the 65,536 bf16 inputs. For each function this prints a hash
// of all its results, given by their bits (every NaN counted as 32704). The expected hashes come
// from the correctly rounded results: each function computed to 120 digits with Python's
// decimal module and rounded to the nearest bf16, ties to even.
//
// It runs at -O2: at the default level, LLVM's x86 back end flushes a subnormal bf16 to zero
// when it is passed between functions on a CPU with AVX512-BF16.
//
// RUN: vxc %s -O2 2>&1 | FileCheck %s
// RUN: vxc %s -O2 --legacy-codegen 2>&1 | FileCheck %s
// CHECK: 17387414034770660048 10107767965654382912 4756872406405682924
import core::num;

fn bits(r : bf16) -> u16 {
  if r != r {
    return 32704u16;
  }
  return libm_bf16_to_bits(r);
}

fn run(which : i32) -> i32 {
  let mut h : u64 = 0u64;
  for i in 0..65536 {
    let x = libm_bf16_from_bits(i as u16);
    let mut r : bf16 = x;
    if which == 0 {
      r = x.sin();
    } else if which == 1 {
      r = x.cos();
    } else {
      r = x.tan();
    }
    h = (h ^ (bits(r) as u64)).wrapping_mul(1099511628211u64);
  }
  print(h);
  print!(" ");
  return 0;
}

fn main() -> i32 {
  let _a = run(0);
  let _b = run(1);
  let _c = run(2);
  return 0;
}
