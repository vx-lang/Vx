//===- legal_pinned_ane.vx - Vx Compiler -----------------------------------*- Vx -*-===//
// RUN: vxc %s | FileCheck %s

fn main() -> i32 {
  // Transfer a variable to ANE pinned memory
  let t_host: Tensor<f32> = 1.0;

  // Note: transfer to NPU/ANE returns a Pinned type.
  let t_ane = transfer(t_host, Memory::NPU_HBM);

  spawn on (Topology::ANE) {
    // CHECK-NOT: error
    // Pinned to NPU/ANE is accessible from ANE natively
    let valid = t_ane;
  }

  return 0;
}
