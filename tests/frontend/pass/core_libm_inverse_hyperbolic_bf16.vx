//===----------------------------------------------------------------------===//
// bf16 `asinh`, `acosh` and `atanh`, the f64 results of `core::libm` rounded once to bf16, on
// every bf16 bit pattern: a hash of the result bits of each (every NaN counted as 32704). The
// expected hashes are the correctly rounded values, from 113-bit libquadmath.
//
// It runs at -O2: at the default level, LLVM's x86 back end flushes a subnormal bf16 to zero
// when it is passed between functions on a CPU with AVX512-BF16.
//
// RUN: vxc %s -O2 2>&1 | FileCheck %s
// RUN: vxc %s -O2 --legacy-codegen 2>&1 | FileCheck %s
// CHECK: 4560418179406113144 13649706389641472594 13928767599328374240
import core::num;

fn hash(f : i32) -> u64 {
  let mut h : u64 = 0u64;
  for i in 0..65536 {
    let x = libm_bf16_from_bits(i as u16);
    let mut r = x.asinh();
    if f == 1 {
      r = x.acosh();
    } else if f == 2 {
      r = x.atanh();
    }
    let mut rb = libm_bf16_to_bits(r) as u64;
    if r != r {
      rb = 32704u64;
    }
    h = (h ^ rb).wrapping_mul(1099511628211u64);
  }
  return h;
}

fn main() -> i32 {
  print(hash(0));
  print!(" ");
  print(hash(1));
  print!(" ");
  print(hash(2));
  return 0;
}
