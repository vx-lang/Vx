//===- unused_functions_with_type_errors_in_the_standard_library.vx - Vx Compiler *- Vx -*-===//
// RUN: vxc --std-path . --emit-mlir %s 2>&1 | FileCheck %s
// RUN: vxc --std-path . --legacy-codegen --emit-mlir %s 2>&1 | FileCheck %s
// RUN: vxc --std-path . -j 4 --emit-mlir %s 2>&1 | FileCheck %s --check-prefixes=CHECK,JOBS
import tests::modules::library_with_type_errors;

fn main() -> i32 {
  return add_one(41);
}

// `--std-path .` makes the repository a root of the standard library, so the library is a file
// of the standard library. The program uses only `add_one`. In the standard library, a function
// with a type error that the program does not use is not reported, and no code is generated for
// it. So none of them appears in the generated code. `calls_wrong_field` calls `wrong_field`,
// but nothing uses `calls_wrong_field`, so that call does not count.
// errors_in_functions_of_a_package_that_nothing_calls.vx imports the same library as a package.
// CHECK-NOT: Error
// JOBS-NOT: using the sequential driver
// CHECK: func.func @main
// CHECK-NOT: wrong_field
// CHECK-NOT: calls_a_missing_function
