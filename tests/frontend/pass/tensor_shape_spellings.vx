//===----------------------------------------------------------------------===//
// The three replacements for the dims-less `Tensor` (Vx#399), each lowering to what it says:
// a stated shape to that memref, an empty shape to rank 0, and a run-time shape to a fully
// dynamic memref. `Tensor<f32, []>` and `DynTensor<f32>` are different types, which is the
// distinction the one spelling could not draw.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// CHECK-LABEL: func.func @shaped(%arg0: memref<2x3xf32>) -> i32
fn shaped(t : Tensor<f32, [2, 3]>) -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @rank0(%arg0: memref<f32>) -> i32
fn rank0(t : Tensor<f32, []>) -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @dynamic(%arg0: memref<?x?xf32>) -> i32
fn dynamic(t : DynTensor<f32>) -> i32 {
  return 0;
}

fn main() -> i32 {
  let a = Tensor<f32>([2, 3]);
  let s : Tensor<f32, []> = 1.0;
  // A stated shape is accepted where a run-time one is declared: passing it forgets the shape.
  // Tensors are linear, so each call gets its own value.
  let b = Tensor<f32>([2, 3]);
  return shaped(a) + rank0(s) + dynamic(b);
}
