//===----------------------------------------------------------------------===//
// A `drop` runs with cancellation off, so a `send` or `recv` in it can wait until the limit of the
// drop. The compiler warns about each one (W1036). `send_for` and `recv_for` have a time limit, and
// the same `send` in a normal method gets no warning.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Warning --implicit-check-not=Error
// CHECK: Warning[W1036] at {{.*}}a_drop_that_waits_with_no_time_limit.vx:[[@LINE+14]]:{{[0-9]+}}: 'send' waits with no time limit of its own in a 'drop'. A drop runs with cancellation off, so if the other end of the channel never acts, this wait holds up the drop until the limit of the drop: VX_DROP_WAIT_SECONDS, or 10 seconds. Use 'send_for' with a time limit
// CHECK: Warning[W1036] at {{.*}}a_drop_that_waits_with_no_time_limit.vx:[[@LINE+14]]:{{[0-9]+}}: 'recv' waits with no time limit of its own in a 'drop'. {{.*}} Use 'recv_for' with a time limit

import std::sync::channel;

struct SlotGuard {
  slot : i64,
  to_pool : Sender<i64>,
  from_pool : Receiver<i64>,
}

impl Drop for SlotGuard {
  fn drop(self : &mut SlotGuard) -> void {
    // Each of these two calls waits with no time limit.
    let _sent = self.to_pool.send(self.slot);
    let _got = self.from_pool.recv();
    // These two calls have a time limit.
    let _sent_for = self.to_pool.send_for(self.slot, 0.1);
    let _got_for = self.from_pool.recv_for(0.1);
  }
}

impl SlotGuard {
  fn give_back(self : &SlotGuard) -> void {
    // Not a drop, so a cancel can stop this wait.
    let _sent = self.to_pool.send(self.slot);
  }
}

fn main() -> i32 {
  let (tx, rx) = channel<i64>(4);
  let g = SlotGuard {
    slot: 1, to_pool: tx, from_pool: rx
  };
  g.give_back();
  return 0;
}
