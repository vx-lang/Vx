// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @Closure_1_call(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Closure_2_call(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i32, i32) -> i32
// CHECK: call @Closure_3_call(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i32, i32, i32) -> i32
// CHECK: call @Closure_4_call(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i32, i32) -> i32
// CHECK: call @Closure_5_call(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i32, i32) -> i32
// CHECK: call @Closure_6_call(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @Closure_8_call(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @apply_lambda$Closure_9(%{{.*}}, %{{.*}}) : (!llvm.struct<(struct<(i32)>, i32)>, i32) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
// CHECK-LABEL: func.func @apply_lambda$Closure_9(%arg0: !llvm.struct<(struct<(i32)>, i32)>, %arg1: i32) -> i32
// CHECK: call @Closure_9_call(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// The capture's slot is allocated in the entry block, ahead of the loads that
// fill it: a slot emitted where it is first needed sits inside whatever loop
// encloses it, and an alloca is only given back when the function returns.
// CHECK-LABEL: func.func @Closure_9_call(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: %[[V1:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: llvm.alloca %[[V1]] x !llvm.struct<(i32)> : (i32) -> !llvm.ptr
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(struct<(i32)>, i32)>
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> !llvm.struct<(i32)>
// CHECK: %[[V2:.*]] = llvm.getelementptr %{{.*}}, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(struct<(i32)>, i32)>
// CHECK: %[[V3:.*]] = llvm.load %[[V2]] : !llvm.ptr -> i32
// CHECK: %[[V4:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V5:.*]] = llvm.load %[[V4]] : !llvm.ptr -> i32
// CHECK: %[[V6:.*]] = arith.addi %{{.*}}, %[[V5]] : i32
// CHECK: %[[V7:.*]] = arith.addi %[[V6]], %[[V3]] : i32
// CHECK: return %[[V7]] : i32
// CHECK-LABEL: func.func @Closure_8_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @Closure_6_call(%arg0: !llvm.ptr) -> i32
// CHECK: call @Closure_7_call(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK-LABEL: func.func @Closure_5_call(%arg0: !llvm.ptr, %arg1: i32, %arg2: i32) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = arith.addi %[[V1]], %{{.*}} : i32
// CHECK: %[[V3:.*]] = arith.addi %[[V2]], %{{.*}} : i32
// CHECK: return %[[V3]] : i32
// CHECK-LABEL: func.func @Closure_4_call(%arg0: !llvm.ptr, %arg1: i32, %arg2: i32) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = llvm.getelementptr %{{.*}}, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: %[[V3:.*]] = llvm.load %[[V2]] : !llvm.ptr -> i32
// CHECK: %[[V4:.*]] = arith.addi %{{.*}}, %{{.*}} : i32
// CHECK: %[[V5:.*]] = arith.addi %[[V4]], %[[V1]] : i32
// CHECK: %[[V6:.*]] = arith.addi %[[V5]], %[[V3]] : i32
// CHECK: return %[[V6]] : i32
// CHECK-LABEL: func.func @Closure_3_call(%arg0: !llvm.ptr, %arg1: i32, %arg2: i32, %arg3: i32) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = arith.addi %{{.*}}, %{{.*}} : i32
// CHECK: %[[V3:.*]] = arith.addi %[[V2]], %{{.*}} : i32
// CHECK: %[[V4:.*]] = arith.addi %[[V3]], %[[V1]] : i32
// CHECK: return %[[V4]] : i32
// CHECK-LABEL: func.func @Closure_2_call(%arg0: !llvm.ptr, %arg1: i32, %arg2: i32) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = arith.addi %{{.*}}, %{{.*}} : i32
// CHECK: %[[V3:.*]] = arith.addi %[[V2]], %[[V1]] : i32
// CHECK: return %[[V3]] : i32
// CHECK-LABEL: func.func @Closure_1_call(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = arith.addi %[[V1]], %{{.*}} : i32
// CHECK: return %[[V2]] : i32
// CHECK-LABEL: func.func @Closure_7_call(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = llvm.getelementptr %{{.*}}, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: %[[V3:.*]] = llvm.load %[[V2]] : !llvm.ptr -> i32
// CHECK: %[[V4:.*]] = arith.constant 30 : i32
// CHECK: %[[V5:.*]] = arith.addi %[[V1]], %[[V3]] : i32
// CHECK: %[[V6:.*]] = arith.addi %[[V5]], %[[V4]] : i32
// CHECK: return %[[V6]] : i32
// EXPECT: 1

import std::io;
fn apply_lambda<F>(f : F, val : i32) -> i32 {
  return f(val);
}

struct Captures {
  i : i32,
}

fn main() -> i32 {
  // closure_basic
  let x1 = 40;
  let closure_basic = | y : i32 | x1 + y;
  assert(closure_basic(2) == 42);

  // closure_multi_arg
  let base2 = 50;
  let adder2 = | a : i32, b : i32 | a + b + base2;
  let adder3 = | a : i32, b : i32, c : i32 | a + b + c + base2;
  assert(adder2(20, 30) + adder3(1, 2, 3) == 156);

  // closure_multi_capture
  let mc_base1 = 50;
  let mc_base2 = 40;
  let mc_adder = | a : i32, b : i32 | a + b + mc_base1 + mc_base2;
  assert(mc_adder(20, 30) == 140);

  // closure_multi_param
  let mp_x = 10;
  let mp_closure = | y : i32, z : i32 | mp_x + y + z;
  assert(mp_closure(12, 20) == 42);

  // closure_nested
  let cn_x = 10;
  let outer = || comptime {
    let cn_y = 20;
    let inner = || comptime {
      let cn_z = 30;
      return cn_x + cn_y + cn_z;
    };
    return inner() + 40;
  };
  assert(outer() == 100);

  // closure_no_args
  let cna_base = 42;
  let get_base = || cna_base;
  assert(get_base() == 42);

  // closure_passed
  let i = 10;
  let cap = Captures {
    i : 10
  };
  let cp_lambda = | x : i32 | x + cap.i + i;
  // x(32) + cap.i(10) + i(10) = 52
  assert(apply_lambda(cp_lambda, 32) == 52);

  print!(1);
  return 1;
}
