//===----------------------------------------------------------------------===//
// A function declared `-> !` is marked `noreturn` for LLVM, on both code generators.
//
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s
// RUN: vxc %s --action emit-llvm --legacy-codegen 2>&1 | FileCheck %s
// CHECK: llvm.func hidden @fail(%arg0: !llvm.ptr) attributes {dso_local, passthrough = ["noreturn", ["probe-stack", "inline-asm"]]}
fn fail(msg : *const i8) -> ! {
  panic(msg);
}

fn main() -> i32 {
  fail("stop");
}
