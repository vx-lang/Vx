//===----------------------------------------------------------------------===//
// A constant generic argument may be an expression, not just a literal.
//
// The checks read the instance names, because the argument is folded to a number
// before the instance is named: `pick<1 + 1>` reaches the instance called 2, not one
// called `1 + 1`. That is also what lets `countdown<N - 1>` terminate -- unfolded, every
// round would name a new instance. The runaway case is in
// fail/const_generic_runaway_instantiation.vx.
//
// Comptime asserts would say this more directly, but evaluating a call that carries type
// arguments is a separate change (#560) and is not on main yet, so they would pass here
// without being evaluated at all.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn pick<const N : i32>() -> i32 {
  return N;
}

fn countdown<const N : i32>() -> i32 {
  if comptime N == 0 {
    return 0;
  } else {
    return countdown<N - 1>() + 1;
  }
}

fn main() -> i32 {
  return pick<3 + 4>() + countdown<3>();
}

// `3 + 4` reached the instance named 7, and its body returns that number.
// CHECK: func.func @pick$const${{.*}}value___7
// CHECK: arith.constant 7 : i32

// One instance per step down to the base case, and none past it.
// CHECK-DAG: func.func @countdown$const${{.*}}value___3
// CHECK-DAG: func.func @countdown$const${{.*}}value___2
// CHECK-DAG: func.func @countdown$const${{.*}}value___1
// CHECK-DAG: func.func @countdown$const${{.*}}value___0
