// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// `cb` holds the function `set_to_41`, and calling it writes through `&mut x`. The block must
// fold to the value written, 41, and not to the value `x` started with, 7.
//
// CHECK-LABEL: func.func @main
// CHECK: %[[VALUE:.*]] = arith.constant 41 : i32
// CHECK-NEXT: return %[[VALUE]] : i32

fn set_to_41(p : &mut i32) -> void {
  *p = 41i32;
}

fn main() -> i32 {
  let value = comptime {
    let mut x = 7i32;
    let cb = set_to_41;
    cb(&mut x);
    x
  };
  return value;
}
