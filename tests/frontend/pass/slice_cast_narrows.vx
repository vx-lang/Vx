//===----------------------------------------------------------------------===//
// `as` over a slice: the elementwise cast that stores a widened row back.
//
// A half slice is storage. It widens to f32 on load, the arithmetic happens in
// f32, and getting back to half storage is a narrowing conversion the program
// has to write -- the fail sibling pins that omitting it is E3004.
//
// What the lowering has to get right, and did not:
//
//   The row widens on load (`arith.extf` over the vector).
//   A half *scalar* widens too, before it is broadcast. Broadcasting it as if
//   it were already f32 names the wrong type for the value and the module does
//   not parse.
//   The result narrows on the way out (`arith.truncf`), and the store is
//   `vector<Nxf16>` into `memref<Nxf16>` rather than a f32 vector into half
//   storage.
//
// f32 slices are unchanged: no conversion appears around them at all, which is
// the regression this file also pins.
//
// Every row is filled with distinct non-zero values, and each differs per lane.
// A zero-filled row makes the arithmetic return zero whatever the conversion
// did, and a uniform row cannot tell a correct lane order from a broadcast of
// one element. This tier compiles rather than executes, so the values are here
// for the reader and for whatever runs the file next; run with `--action
// run-jit` and the four rows print 0.75, 6, 1.25 and 2.
//
// Flat path only. The legacy walk builds a scalar conversion and has nothing to
// do with a vector, so it says so rather than failing in the MLIR parser.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut h = Tensor<f16, [ 2, 4 ]>::new();
  let mut b = Tensor<bf16, [ 2, 4 ]>::new();
  let mut f = Tensor<f32, [ 2, 4 ]>::new();
  for d in 0..4 {
    h[0][d] = 1.5 + (d as f16);
    h[1][d] = 3.0 + (d as f16);
    b[0][d] = 2.5 + (d as bf16);
    f[0][d] = 4.0 + (d as f32);
  }

  // An f16 row against an f32 scalar: the row widens, the result narrows back.
  let s32 : f32 = 0.5;
  // CHECK: arith.extf {{.*}} : vector<4xf16> to vector<4xf32>
  // CHECK: vector.broadcast {{.*}} : f32 to vector<4xf32>
  // CHECK: arith.mulf {{.*}} : vector<4xf32>
  // CHECK: arith.truncf {{.*}} : vector<4xf32> to vector<4xf16>
  // CHECK: vector.store {{.*}} vector<4xf16>
  h[0] = (h[0] * s32) as f16;

  // An f16 row against an f16 scalar: the scalar widens before the broadcast.
  let s16 : f16 = 2.0;
  // CHECK: arith.extf {{.*}} : vector<4xf16> to vector<4xf32>
  // CHECK: arith.extf {{.*}} : f16 to f32
  // CHECK: vector.broadcast {{.*}} : f32 to vector<4xf32>
  // CHECK: arith.truncf {{.*}} : vector<4xf32> to vector<4xf16>
  h[1] = (h[1] * s16) as f16;

  // bf16 is half storage on the same terms.
  // CHECK: arith.extf {{.*}} : vector<4xbf16> to vector<4xf32>
  // CHECK: arith.truncf {{.*}} : vector<4xf32> to vector<4xbf16>
  // CHECK: vector.store {{.*}} vector<4xbf16>
  b[0] = (b[0] * s32) as bf16;

  // f32 needs no conversion, and must not grow one.
  // CHECK: vector.broadcast {{.*}} : f32 to vector<4xf32>
  // CHECK-NOT: arith.truncf
  // CHECK: vector.store {{.*}} vector<4xf32>
  f[0] = f[0] * s32;

  print(h[0][0]);
  print(h[1][0]);
  print(b[0][0]);
  print(f[0][0]);
  return 0;
}
