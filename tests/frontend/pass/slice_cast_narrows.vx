//===----------------------------------------------------------------------===//
// `as` over a slice: the elementwise cast that stores a row back into a half tensor.
//
// A half row with an f32 value computes in f32. The row widens on load (`arith.extf`), and
// `as f16` narrows the result (`arith.truncf`), so the store is `vector<Nxf16>` into
// `memref<Nxf16>`. A half scalar with an f32 row widens before it is broadcast. A half row
// with a scalar of the same half type computes in that type, and nothing converts.
//
// Every row is filled with distinct non-zero values, and each differs per lane.
// A zero-filled row makes the arithmetic return zero whatever the conversion
// did, and a uniform row cannot tell a correct lane order from a broadcast of
// one element. This tier compiles rather than executes, so the values are here
// for the reader and for whatever runs the file next; run with `--action
// run-jit` and the four rows print 0.75, 6, 1.25 and 2.
//
// The RUN line checks the MLIR of the default code generator.
// a_cast_over_a_half_slice.vx checks the values on both code generators.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s # flat-codegen

fn main() -> i32 {
  let mut h = Tensor<f16, [ 2, 4 ]>::new();
  let mut b = Tensor<bf16, [ 2, 4 ]>::new();
  let mut f = Tensor<f32, [ 2, 4 ]>::new();
  for d in 0..4 {
    h[0][d] = 1.5 + (d as f16);
    h[1][d] = 3.0 + (d as f16);
    b[0][d] = 2.5 + (d as bf16);
    f[0][d] = 4.0 + (d as f32);
    f[1][d] = 5.0 + (d as f32);
  }

  // An f16 row against an f32 scalar: the row widens, the result narrows back.
  let s32 : f32 = 0.5;
  // CHECK: arith.extf {{.*}} : vector<4xf16> to vector<4xf32>
  // CHECK: vector.broadcast {{.*}} : f32 to vector<4xf32>
  // CHECK: arith.mulf {{.*}} : vector<4xf32>
  // CHECK: arith.truncf {{.*}} : vector<4xf32> to vector<4xf16>
  // CHECK: vector.store {{.*}} vector<4xf16>
  h[0] = (h[0] * s32) as f16;

  // An f16 row against an f16 scalar: the product is f16, and `as f16` changes nothing.
  let s16 : f16 = 2.0;
  // CHECK-NOT: arith.extf
  // CHECK: vector.broadcast {{.*}} : f16 to vector<4xf16>
  // CHECK: arith.mulf {{.*}} : vector<4xf16>
  // CHECK-NOT: arith.truncf
  // CHECK: vector.store {{.*}} vector<4xf16>
  h[1] = (h[1] * s16) as f16;

  // A bf16 row against an f32 scalar works the same way.
  // CHECK: arith.extf {{.*}} : vector<4xbf16> to vector<4xf32>
  // CHECK: arith.truncf {{.*}} : vector<4xf32> to vector<4xbf16>
  // CHECK: vector.store {{.*}} vector<4xbf16>
  b[0] = (b[0] * s32) as bf16;

  // f32 needs no conversion, and must not grow one.
  // CHECK: vector.broadcast {{.*}} : f32 to vector<4xf32>
  // CHECK-NOT: arith.truncf
  // CHECK: vector.store {{.*}} vector<4xf32>
  f[0] = f[0] * s32;

  // An f32 row against an f16 scalar: the scalar widens before the broadcast.
  // CHECK: arith.extf {{.*}} : f16 to f32
  // CHECK-NEXT: vector.broadcast {{.*}} : f32 to vector<4xf32>
  f[1] = f[1] * s16;

  print(h[0][0]);
  print(h[1][0]);
  print(b[0][0]);
  print(f[0][0]);
  return 0;
}
