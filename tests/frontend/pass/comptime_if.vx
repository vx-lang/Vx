// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut val = 0;

  // Evaluate comptime if blocks
  if comptime
  Topology::Current == Topology::CPU {
    val = 1;
  } else if comptime
  Topology::Current == Topology::CPU_AVX512 {
    // This block will be pruned out if the active topology is Host
    val = 2;
    invalid_function_that_does_not_exist(); // Semantic analysis should
    // completely skip this if pruned!
  } else {
    val = 3;
  }

  if comptime
  Topology::Current!= Topology::CPU {
    return 1; // Should be pruned out
  }

  // Since our default compiler configuration executes as Topology::CPU,
  // val must be 1.
  return if val == 1 {
    0
  } else {
    1
  };
}

// The comptime branch is not folded away in the frontend module: the comparison and both
// arms are still there for a later pass to resolve.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.cmpi
// CHECK: cf.cond_br
