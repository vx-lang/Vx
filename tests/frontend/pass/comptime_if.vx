// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: %t 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut val = 0;

  // Evaluate comptime if blocks
  if comptime
    Topology::Current == Topology::Host { val = 1; }
  else if comptime
    Topology::Current == Topology::Host_AVX512 {
      // This block will be pruned out if the active topology is Host
      val = 2;
      invalid_function_that_does_not_exist(); // Semantic analysis should
                                              // completely skip this if pruned!
    }
  else {
    val = 3;
  }

  if comptime
    Topology::Current != Topology::Host {
      return 1; // Should be pruned out
    }

  // Since our default compiler configuration executes as Topology::Host,
  // val must be 1.
  return if val == 1 {0} else {1};
}

// CHECK: module
