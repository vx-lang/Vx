// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// After `let x = p.a`, the other fields of `p` can still be read and moved, `p.a` can be
// given a value again, and a new variable named `p` starts with every field. A field with
// nothing to drop is copied, so it can be read any number of times.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

import core::ops;

struct Noisy {
  id : i32,
}

impl Drop for Noisy {
  fn drop(self : &mut Noisy) -> void {
    print(self.id);
  }
}

struct Pair {
  a : Noisy,
  b : Noisy,
}

fn take(n : Noisy) -> i32 {
  return n.id;
}

struct Point {
  x : i32,
  y : i32,
}

struct Line {
  from : Point,
  to : Point,
}

fn other_fields() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.a;
  let id = p.b.id;
  return id + take(p.b) + x.id;
}

fn field_given_a_value_again() -> i32 {
  let mut p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.a;
  p.a = Noisy {
    id: 3
  };
  let q = p;
  return x.id + q.a.id;
}

fn declared_again() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.a;
  let p = Pair {
    a: Noisy {
      id: 3
    }, b: Noisy {
      id: 4
    }
  };
  return x.id + take(p.a);
}

fn nothing_to_drop() -> i32 {
  let l = Line {
    from: Point {
      x: 1, y: 2
    }, to: Point {
      x: 3, y: 4
    }
  };
  let a = l.from;
  let b = l.from;
  let whole = l;
  return a.x + b.y + whole.to.x;
}

fn main() -> i32 {
  return other_fields() + field_given_a_value_again() + declared_again() + nothing_to_drop();
}
