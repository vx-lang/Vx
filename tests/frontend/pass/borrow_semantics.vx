//===----------------------------------------------------------------------===//
// Test borrow and pointer semantics: immutable borrows, mutable borrows,
// pointer operations, and unsafe blocks.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @read_value(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @increment(%{{.*}}) : (!llvm.ptr) -> ()
// CHECK: call @swap(%{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr) -> ()
// CHECK-LABEL: func.func @swap(%arg0: !llvm.ptr {llvm.noalias}, %arg1: !llvm.ptr {llvm.noalias})
// CHECK: arith.constant 0 : i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: arith.constant 0 : i32
// CHECK: llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: arith.constant 0 : i32
// CHECK: %[[V1:.*]] = llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: llvm.load %[[V1]] : !llvm.ptr -> i32
// CHECK: arith.constant 0 : i32
// CHECK: llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK-LABEL: func.func @read_value(%arg0: !llvm.ptr {llvm.readonly}) -> i32
// CHECK: arith.constant 0 : i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @increment(%arg0: !llvm.ptr {llvm.noalias})
// CHECK: arith.constant 0 : i32
// CHECK: llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: arith.constant 0 : i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}} : (!llvm.ptr, i32) -> !llvm.ptr, i32
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: %[[V2:.*]] = arith.constant 1 : i32
// CHECK: arith.addi %[[V1]], %[[V2]] : i32

fn read_value(x: &i32) -> i32 {
  return *x;
}

fn increment(x: &mut i32) -> void {
  *x = *x + 1;
}

fn swap(a: &mut i32, b: &mut i32) -> void {
  let tmp = *a;
  *a = *b;
  *b = tmp;
}

fn main() -> i32 {
  let mut x = 10;
  let mut y = 20;

  // Immutable borrow
  let val = read_value(&x);

  // Mutable borrow
  increment(&mut x);

  // Swap via mutable borrows
  swap(&mut x, &mut y);

  // After swap: x=20, y=11
  return x + y;
}
