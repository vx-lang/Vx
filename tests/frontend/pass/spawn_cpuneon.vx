// Test: CpuNeon topology spawn with local computation.

fn main() -> i32 {
  // CpuNeon spawns use DRAM, but variables must be
  // defined inside the spawn block (not crossed from CPU).
  spawn on(Topology::CpuNeon) {
    // CHECK-NOT: error
    let neon_val : Tensor<f32> = 3.0;
  }

  return 0;
}

// CHECK: module
