// `DynTensor<T>` is the tensor whose shape is a run-time value (Vx#399). It
// carries no extents, lowers to a dynamic memref, and accepts a statically
// shaped tensor -- passing one forgets the shape, which is the whole point of
// keeping the two spellings apart.
//
// This runner checks semantics only and never emits MLIR, so the lowering is
// asserted in tests/optimizations/pass/dyntensor_element_types.vx instead. What
// this file pins is that a statically shaped tensor is accepted where a dynamic
// one is declared.
//
// RUN: vxc %s --action emit-mlir

fn takes_dyn(t : DynTensor<f32>) -> i32 {
  return 0;
}

fn main() -> i32 {
  let mut a : Tensor<f32, [2, 3]> = Tensor<f32>([2, 3]);
  a[0][0] = 1.0;
  let r = takes_dyn(a);
  return r;
}
