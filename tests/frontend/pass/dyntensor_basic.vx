// `DynTensor<T>` is the tensor whose shape is a run-time value (Vx#399). It
// carries no extents, lowers to a dynamic memref, and accepts a statically
// shaped tensor -- passing one forgets the shape, which is the whole point of
// keeping the two spellings apart.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// The declared parameter is dynamic, so the callee takes a fully dynamic memref, and the
// shaped argument is accepted there -- passing it forgets the shape, which is the point.
// CHECK-LABEL: func.func @takes_dyn(%arg0: memref<?x?xf32>) -> i32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @takes_dyn(%{{.*}}) : (memref<?x?xf32>) -> i32

fn takes_dyn(t : DynTensor<f32>) -> i32 {
  return 0;
}

fn main() -> i32 {
  let mut a : Tensor<f32, [2, 3]> = Tensor<f32>([2, 3]);
  a[0][0] = 1.0;
  let r = takes_dyn(a);
  return r;
}
