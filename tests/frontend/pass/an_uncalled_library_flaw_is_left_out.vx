//===- an_uncalled_library_flaw_is_left_out.vx - Vx Compiler ----*- Vx -*-===//
// RUN: vxc --emit-mlir %s 2>&1 | FileCheck %s
// RUN: vxc --legacy-codegen --emit-mlir %s 2>&1 | FileCheck %s
// RUN: vxc -j 4 --emit-mlir %s 2>&1 | FileCheck %s --check-prefixes=CHECK,JOBS
import tests::modules::flawed_library;

fn main() -> i32 {
  return library_good(41);
}

// Nothing compiled calls a flawed function, so none is reported, and none reaches code
// generation, which could not compile it. `uncalled_flawed` calls `only_called_by_flawed`, but
// is not compiled itself.
// CHECK-NOT: imported module
// The parallel driver compiles it itself rather than falling back to the sequential one.
// JOBS-NOT: using the sequential driver
// CHECK: func.func @main
// CHECK-NOT: uncalled_flawed
// CHECK-NOT: only_called_by_flawed
// CHECK-NOT: inner_flawed
