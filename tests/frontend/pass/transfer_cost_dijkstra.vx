// RUN: %vxc %s | FileCheck %s
//
// The IR assertion this file used to carry could not run: the program does not
// compile on the default path (Vx#398), so there is no module to match against.
// It is restored when that is fixed. The semantic check below is what this file
// verifies today.

// Verify that a multi-hop transfer across topologies completes successfully
// using Dijkstra's algorithm.

fn test_multi_hop_transfer() -> void {
  let a : Tensor<f32, [10]> = Tensor<f32>::zeros([10]);
  // Local_SRAM requires routing: CPU_DRAM -> NPU_HBM -> Local_SRAM
  // Costs: 50 + 10 = 60
  let b = transfer(a, Memory::Local_SRAM);
}

