// RUN: %vxc %s | FileCheck %s

// Verify that a multi-hop transfer across topologies completes successfully
// using Dijkstra's algorithm.

fn test_multi_hop_transfer() -> void {
  let a : Tensor<f32, [10]> = Tensor::zeros([10]);
  // Local_SRAM requires routing: Host_DRAM -> NPU_HBM -> Local_SRAM
  // Costs: 50 + 10 = 60
  let b = transfer(a, Memory::Local_SRAM);
}

// CHECK: func.func @test_multi_hop_transfer
// CHECK: vx.transfer %{{.*}} : !vx.tensor<*xf32>
