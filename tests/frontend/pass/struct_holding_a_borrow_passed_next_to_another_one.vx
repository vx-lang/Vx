// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A struct that holds a borrow can be passed to a call together with another borrow when
// both are shared, or when they borrow different variables.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

struct View {
  r : &i64,
}

fn read_both(s : View, b : &i64) -> i64 {
  return *s.r + *b;
}

fn read_then_write_other(s : View, a : &mut i64) -> i64 {
  *a = 5i64;
  return *s.r;
}

fn both_shared() -> i64 {
  let x = 1i64;
  let s = View {
    r : &x
  };
  return read_both(s, &x);
}

fn different_variables() -> i64 {
  let x = 1i64;
  let mut y = 2i64;
  let s = View {
    r : &x
  };
  return read_then_write_other(s, &mut y);
}

fn main() -> i32 {
  print(both_shared());
  print(different_variables());
  return 0;
}
