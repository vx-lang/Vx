// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// The const arguments reach the emitted type: one instantiation at <2, 3> names its
// struct Grid_i32_2_3, and R * C folds against the same two constants. The symbol name
// still spells its const arguments as a Debug-printed AST (Vx#408), so match past it.
// CHECK-LABEL: func.func @initialize$const${{.*}}() -> !llvm.struct<"Grid_i32_2_3", (i32)>
// CHECK: %[[R:.*]] = arith.constant 2 : i32
// CHECK: %[[C:.*]] = arith.constant 3 : i32
// CHECK: arith.muli %[[R]], %[[C]] : i32
// CHECK-LABEL: func.func @test_multiple_const_generics()
// CHECK: call @initialize$const${{.*}} : () -> !llvm.struct<"Grid_i32_2_3", (i32)>

struct Grid<T, const R : i32, const C : i32> {
  val : T
}

fn initialize<const R : i32, const C : i32>()
->Grid<i32, R, C> {
  let m = Grid<i32, R, C> {
    val : 0
  };
  let area = R * C;
  return m;
}

fn test_multiple_const_generics() -> void {
  let mat = initialize<2, 3>();
  assert(true);
}
