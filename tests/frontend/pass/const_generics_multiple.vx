// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// CHECK: module
// CHECK: func.func @"initialize_{{.*}}"() -> !llvm.struct<"Grid_i32_2_3",
// (i32)> CHECK: %c2_i32 = arith.constant 2 : i32 CHECK: %c3_i32 =
// arith.constant 3 : i32 CHECK: %{{.*}} = arith.muli %c2_i32, %c3_i32 : i32

struct Grid<T, const R : i32, const C : i32>{
  val : T
}

fn initialize<const R : i32, const C : i32>()
->Grid<i32, R, C> {
  let m = Grid<i32, R, C>{
    val : 0
  };
  let area = R * C;
  return m;
}

fn test_multiple_const_generics() -> void {
  let mat = initialize<2, 3>();
  assert(true);
}
