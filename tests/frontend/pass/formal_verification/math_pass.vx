//===- math_pass.vx ---------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn test_linear_scaling(N : i32)->i32
requires N > 5 && N < 20 ensures return > 15 && return < 60 {let x = N * 3;
  return x;
}

fn test_distributive_property(A : i32, B : i32) -> i32
requires A > 0 && B > 0
ensures return > 0 {
  let sum = A + B;
  let res = sum * 2;
  return res;
}

fn test_cancellation(X : i32, Y : i32) -> i32
requires X > 0 && Y > 0
ensures return ==
X {
  let a = X + Y;
  let b = a - Y;
  return b;
}

fn test_unary_negation(A : i32) -> i32
requires A < 0 ensures return > 0
{
  let neg = -A;
  return neg;
}

fn main() -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_unary_negation(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: %[[V1:.*]] = arith.subi %[[V0]], %{{.*}} : i32
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @test_cancellation(%arg0: i32, %arg1: i32) -> i32
// CHECK: %[[V0:.*]] = arith.addi %{{.*}}, %{{.*}} : i32
// CHECK: %[[V1:.*]] = arith.subi %[[V0]], %{{.*}} : i32
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @test_distributive_property(%arg0: i32, %arg1: i32) -> i32
// CHECK: %[[V0:.*]] = arith.addi %{{.*}}, %{{.*}} : i32
// CHECK: %[[V1:.*]] = arith.constant 2 : i32
// CHECK: %[[V2:.*]] = arith.muli %[[V0]], %[[V1]] : i32
// CHECK: return %[[V2]] : i32
// CHECK-LABEL: func.func @test_linear_scaling(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 3 : i32
// CHECK: %[[V1:.*]] = arith.muli %{{.*}}, %[[V0]] : i32
// CHECK: return %[[V1]] : i32
