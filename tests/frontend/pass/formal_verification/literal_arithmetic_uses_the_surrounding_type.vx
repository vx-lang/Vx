// CHECK:     %9 = arith.cmpi ne, %8, %c2147483649_i64 : i64
// CHECK:     memref.store %9, %alloca[] : memref<i1>
// CHECK:     cf.br ^bb9
// CHECK:   ^bb8:  // pred: ^bb6
// CHECK:     %true_11 = arith.constant true
// CHECK:     memref.store %true_11, %alloca[] : memref<i1>
// CHECK:     cf.br ^bb9
