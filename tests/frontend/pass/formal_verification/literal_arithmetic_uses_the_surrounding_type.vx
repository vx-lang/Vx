// CHECK:     %10 = memref.load %alloca[] : memref<i1>
// CHECK:     cf.cond_br %10, ^bb10, ^bb11
// CHECK:   ^bb10:  // pred: ^bb9
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     return %c1_i32 : i32
// CHECK:   ^bb11:  // pred: ^bb9
// CHECK:     %11 = call @difference() : () -> i64
// CHECK:     %c2147483649_i64_12 = arith.constant 2147483649 : i64
// CHECK:     %c0_i64 = arith.constant 0 : i64
// CHECK:     %12 = arith.subi %c0_i64, %c2147483649_i64_12 : i64
// CHECK:     %13 = arith.cmpi ne, %11, %12 : i64
// CHECK:     cf.cond_br %13, ^bb13, ^bb12
