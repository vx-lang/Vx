// CHECK:   }
// CHECK:   func.func @argument_context() -> i64 {
// CHECK:     %c2147483647_i64 = arith.constant 2147483647 : i64
// CHECK:     %c1_i64 = arith.constant 1 : i64
// CHECK:     %0 = arith.addi %c2147483647_i64, %c1_i64 : i64
// CHECK:     %1 = call @_argument_identity(%0) : (i64) -> i64
// CHECK:     return %1 : i64
// CHECK:   }
// CHECK:   func.func @_argument_identity(%arg0: i64) -> i64 {
// CHECK:     return %arg0 : i64
// CHECK:   }
// CHECK:   func.func @_identity32(%arg0: i32) -> i32 {
// CHECK:     return %arg0 : i32
// CHECK:   }
// CHECK:   func.func @_argument_clause() -> i64 {
// CHECK:     %c2147483648_i64 = arith.constant 2147483648 : i64
// CHECK:     return %c2147483648_i64 : i64
// CHECK:   }
