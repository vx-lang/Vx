// CHECK:   ^bb2:  // pred: ^bb0
// CHECK:     %true = arith.constant true
// CHECK:     memref.store %true, %alloca_1[] : memref<i1>
// CHECK:     cf.br ^bb3
// CHECK:   ^bb3:  // 2 preds: ^bb1, ^bb2
// CHECK:     %4 = memref.load %alloca_1[] : memref<i1>
// CHECK:     cf.cond_br %4, ^bb5, ^bb4
// CHECK:   ^bb4:  // pred: ^bb3
// CHECK:     %5 = call @exact_sum() : () -> i64
// CHECK:     %c2147483648_i64_9 = arith.constant 2147483648 : i64
// CHECK:     %6 = arith.cmpi ne, %5, %c2147483648_i64_9 : i64
// CHECK:     memref.store %6, %alloca_0[] : memref<i1>
