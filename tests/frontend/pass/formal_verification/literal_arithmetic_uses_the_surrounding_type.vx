// CHECK:   func.func @unsigned_sum() -> i64 {
// CHECK:     %c4294967296_i64 = arith.constant 4294967296 : i64
// CHECK:     return %c4294967296_i64 : i64
// CHECK:   }
// CHECK:   func.func @unsigned_negation() -> i32 {
// CHECK:     %c-1_i32 = arith.constant -1 : i32
// CHECK:     return %c-1_i32 : i32
// CHECK:   }
// CHECK:   func.func @remainder() -> i64 {
// CHECK:     %c8_i64 = arith.constant 8 : i64
// CHECK:     return %c8_i64 : i64
// CHECK:   }
// CHECK:   func.func @product() -> i64 {
// CHECK:     %c4294967296_i64 = arith.constant 4294967296 : i64
// CHECK:     return %c4294967296_i64 : i64
// CHECK:   }
// CHECK:   func.func @nested_sum() -> i64 {
// CHECK:     %c2147483649_i64 = arith.constant 2147483649 : i64
// CHECK:     return %c2147483649_i64 : i64
// CHECK:   }
// CHECK:   func.func @explicit_width() -> i64 {
// CHECK:     %c2147483648_i64 = arith.constant 2147483648 : i64
// CHECK:     %c0_i64 = arith.constant 0 : i64
// CHECK:     %0 = arith.subi %c0_i64, %c2147483648_i64 : i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @exact_sum() -> i64 {
// CHECK:     %c2147483647_i64 = arith.constant 2147483647 : i64
// CHECK:     %c1_i64 = arith.constant 1 : i64
// CHECK:     %0 = arith.addi %c2147483647_i64, %c1_i64 : i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @difference() -> i64 {
// CHECK:     %c2147483649_i64 = arith.constant 2147483649 : i64
// CHECK:     %c0_i64 = arith.constant 0 : i64
// CHECK:     %0 = arith.subi %c0_i64, %c2147483649_i64 : i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @declared_unary_type(%arg0: i32) -> i64 {
// CHECK:     %c2147483648_i64 = arith.constant 2147483648 : i64
// CHECK:     %c0_i64 = arith.constant 0 : i64
// CHECK:     %0 = arith.subi %c0_i64, %c2147483648_i64 : i64
