// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning

fn correct_value() -> i64
ensures return == 2147483647 + 1 {
  return 2147483648i64;
}

fn exact_sum() -> i64
ensures return == 2147483647 + 1 {
  return 2147483647 + 1;
}

fn nested_sum() -> i64
ensures return == (2147483647 + 1) + 1 {
  return 2147483649i64;
}

fn difference() -> i64
ensures return == -2147483648 - 1 {
  return -2147483649i64;
}

fn product() -> i64
ensures return == 65536 * 65536 {
  return 4294967296i64;
}

fn unsigned_sum() -> u64
ensures return == 4294967295 + 1 {
  return 4294967296u64;
}

fn remainder() -> i64
ensures return == (2147483647 + 1) % 10 {
  return 8i64;
}

fn cast_source_keeps_its_default() -> i64
ensures return == ((2147483647 + 1) as i64) {
  return -2147483648i64;
}

fn explicit_width() -> i64
ensures return == 2147483647i32 + 1 {
  return -2147483648i64;
}

fn caller() -> i64
ensures return == 2147483648i64 {
  return correct_value();
}

fn _argument_identity(value : i64) -> i64
ensures return == value {
  return value;
}

fn _argument_clause() -> i64
ensures return == _argument_identity(2147483647 + 1) {
  return 2147483648i64;
}

fn argument_context() -> i64
ensures return == 2147483648i64 {
  return _argument_identity(2147483647 + 1);
}

fn _identity32(value : i32) -> i32
ensures return == value {
  return value;
}

fn declared_unary_type(value : i32) -> i64
requires value == -2147483648i64
ensures return == -_identity32(value) {
  return -2147483648i64;
}

fn unsigned_negation() -> u32
ensures return == -1 {
  return 4294967295u32;
}

fn main() -> i32 {
  if argument_context() != 2147483648i64 || correct_value() != 2147483648i64 || exact_sum() != 2147483648i64 || nested_sum() != 2147483649i64 {
    return 1;
  }
  if difference() != -2147483649i64 || product() != 4294967296i64 || unsigned_sum() != 4294967296u64 {
    return 2;
  }
  if remainder() != 8i64 || cast_source_keeps_its_default() != -2147483648i64 || explicit_width() != -2147483648i64 || caller() != 2147483648i64 {
    return 3;
  }
  if declared_unary_type(-2147483647 - 1) != -2147483648i64 || unsigned_negation() != 4294967295u32 {
    return 4;
  }
  return 0;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @main() -> i32 {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %alloca = memref.alloca() : memref<i1>
// CHECK:     %alloca_0 = memref.alloca() : memref<i1>
// CHECK:     %alloca_1 = memref.alloca() : memref<i1>
// CHECK:     %alloca_2 = memref.alloca() : memref<i1>
// CHECK:     %alloca_3 = memref.alloca() : memref<i1>
// CHECK:     %alloca_4 = memref.alloca() : memref<i1>
// CHECK:     %alloca_5 = memref.alloca() : memref<i1>
// CHECK:     %alloca_6 = memref.alloca() : memref<i1>
// CHECK:     %alloca_7 = memref.alloca() : memref<i1>
// CHECK:     %0 = call @argument_context() : () -> i64
// CHECK:     %c2147483648_i64 = arith.constant 2147483648 : i64
// CHECK:     %1 = arith.cmpi ne, %0, %c2147483648_i64 : i64
// CHECK:     cf.cond_br %1, ^bb2, ^bb1
