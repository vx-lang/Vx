//===- complex_ineq_pass.vx ---------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn test_transitive_ineq(X : i32, Y : i32, Z : i32) -> i32
requires X >
Y &&Y > Z ensures return > 1 {
  let diff = X - Z;
  return diff;
}

fn test_four_vars(A : i32, B : i32, C : i32, D : i32) -> i32
requires A >=
B &&B >= C &&C >= D ensures return >= 0 {
  let diff = A - D;
  return diff;
}

fn main() -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_four_vars(%arg0: i32, %arg1: i32, %arg2: i32, %arg3: i32) -> i32
// CHECK: %[[V0:.*]] = arith.subi %{{.*}}, %{{.*}} : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_transitive_ineq(%arg0: i32, %arg1: i32, %arg2: i32) -> i32
// CHECK: %[[V0:.*]] = arith.subi %{{.*}}, %{{.*}} : i32
// CHECK: return %[[V0]] : i32
