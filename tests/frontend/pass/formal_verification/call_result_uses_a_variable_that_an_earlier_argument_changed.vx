//===----------------------------------------------------------------------===//
// `halve(&mut c)` changes `c` in the first argument, and nothing reads `c` before that.
// So the result is at most the new `c.n`, and the compiler proves it.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error

struct Counter {
  n : i32,
}

fn halve(c : &mut Counter) -> i32
ensures return == c.n {
  c.n = c.n / 2;
  return c.n;
}

fn read(c : &Counter) -> i32
ensures return == c.n {
  return c.n;
}

fn first(n : i32, m : i32, other : &mut i32) -> i32
ensures return <= n {
  *other = m;
  return n;
}

fn consume_index(limit : i32, index : i32) -> i32
requires index <= limit {
  return index;
}

fn no_argument_reads_the_variable() -> i32 {
  let mut c = Counter {
    n: 8
  };
  let mut other = 0;
  let index = first(halve(&mut c), 0, &mut other);
  return consume_index(read(&c), index);
}

fn later_argument_reads_the_variable() -> i32 {
  let mut c = Counter {
    n: 8
  };
  let mut other = 0;
  let index = first(halve(&mut c), read(&c), &mut other);
  return consume_index(read(&c), index);
}

fn main() -> i32 {
  return no_argument_reads_the_variable() + later_argument_reads_the_variable();
}

// CHECK: func.func @main
