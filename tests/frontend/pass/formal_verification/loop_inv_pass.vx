//===- loop_inv_pass.vx ---------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn test_loop_increment(N : i32) -> i32
requires N == 0
ensures return == 0 {
  // The invariant must be true before the loop and after the loop body.
  for i in 0..10 invariant(N == 0) {
    let x = N;
  }
  return N;
}

fn test_loop_range(N : i32) -> i32
requires N > 5 && N < 15 ensures return > 5
{
  for i in 0..5 invariant(N > 5) {
    let dummy = N;
  }
  return N;
}

fn main() -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_loop_range(%arg0: i32) -> i32
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @test_loop_increment(%arg0: i32) -> i32
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
