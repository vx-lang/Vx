// RUN: vxc --package tests=tests %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
//
// Code in another file can read the fields of a type with an invariant. It changes a value of the
// type through the functions of the type's file. The file that declares a type with an invariant
// can write its fields and build it with a struct literal.
import std::vec;
import tests::modules::interval_with_an_invariant;

struct Wrapper {
  v : Vec<i64>,
}

struct Pair
invariant self.a <= self.b
{
  a : i64,
  b : i64,
}

fn shift(p : &mut Pair) -> i32 {
  p.a = p.a + 1i64;
  p.b = p.b + 1i64;
  return 0;
}

fn main() -> i32 {
  let mut w = Wrapper {
    v : Vec<i64>::new()
  };
  w.v.push(1i64);
  // `v` is a field of `Wrapper`, which has no invariant.
  w.v = Vec<i64>::new();
  w.v.push(2i64);
  w.v.push(3i64);
  // This writes the buffer of the `Vec`, and no field of it.
  unsafe { w.v.data[1] = 4i64; }
  let mut i = Interval::new();
  i.widen();
  let mut p = Pair {
    a : 1i64, b : 2i64
  };
  shift(&mut p);
  let b = &mut p.b;
  *b = 10i64;
  // CHECK: 2 4 2 1 1 2 10{{$}}
  println!(
  "{} {} {} {} {} {} {}", w.v.len, w.v.get(1), i.hi, i.count.value, i.items.len, p.a, p.b
  );
  return 0;
}
