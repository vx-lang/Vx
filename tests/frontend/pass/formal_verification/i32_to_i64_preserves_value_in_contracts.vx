// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning # flat-codegen

import core::convert;

fn preserve_value(value : i32) -> i64
ensures return == value {
  return i64::from(value);
}

fn bounded_index(index : i32) -> i64
requires index >= 0 && index < 100
ensures return >= 0 && return < 100 {
  return i64::from(index);
}

fn main() -> i32 {
  return (preserve_value(-17) + bounded_index(99)) as i32;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @main() -> i32 {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %c17_i32 = arith.constant 17 : i32
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.subi %c0_i32, %c17_i32 : i32
// CHECK:     %1 = call @preserve_value(%0) : (i32) -> i64
// CHECK:     %c99_i32 = arith.constant 99 : i32
// CHECK:     %2 = call @bounded_index(%c99_i32) : (i32) -> i64
// CHECK:     %3 = arith.addi %1, %2 : i64
// CHECK:     %4 = arith.trunci %3 : i64 to i32
// CHECK:     return %4 : i32
// CHECK:   }
// CHECK:   func.func @preserve_value(%arg0: i32) -> i64 {
// CHECK:     %0 = call @"i64::From$i32$from"(%arg0) : (i32) -> i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @"i64::From$i32$from"(%arg0: i32) -> i64 {
// CHECK:     %0 = arith.extsi %arg0 : i32 to i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @bounded_index(%arg0: i32) -> i64 {
// CHECK:     %0 = call @"i64::From$i32$from"(%arg0) : (i32) -> i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK: }
