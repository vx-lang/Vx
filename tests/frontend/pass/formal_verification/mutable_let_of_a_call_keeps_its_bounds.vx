//===----------------------------------------------------------------------===//
// `let mut index = f(..)` keeps the `ensures` bounds of `f`, as `let index = f(..)` does. The
// pointer argument matters: the compiler cannot keep `index == f(p, k)` for a call that takes one.
// The bounds still hold after `index = index - 1` when `index > 0`.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error

fn bounded_from_buffer(_data : *const i32, k : i32) -> i32
requires k > 0
ensures return >= 0 && return < k {
  return k - 1;
}

fn consume_index(limit : i32, index : i32) -> i32
requires limit > 0 && index >= 0 && index < limit {
  return index;
}

fn immutable_let(p : *mut i32, k : i32) -> i32
requires valid(p, 1)
requires k > 0 {
  let index = bounded_from_buffer(p as *const i32, k);
  return consume_index(k, index);
}

fn mutable_let(p : *mut i32, k : i32) -> i32
requires valid(p, 1)
requires k > 0 {
  let mut index = bounded_from_buffer(p as *const i32, k);
  if index > 0 {
    index = index - 1;
  }
  return consume_index(k, index);
}

fn main() -> i32 {
  let mut cell = 0;
  let p : *mut i32 = &mut cell;
  return immutable_let(p, 4) + mutable_let(p, 4);
}

// CHECK: func.func @main
