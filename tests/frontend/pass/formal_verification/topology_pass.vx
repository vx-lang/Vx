//===- topology_pass.vx ---------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn test_topology_npu(T : i32) -> i32
requires Topology::NPU
[0] == Topology::NPU[0] ensures return == 1 {
  return 1;
}

fn test_topology_host(T : i32) -> i32
requires Topology::CPU ==
Topology::CPU ensures return == 1 {
  return 1;
}

fn test_topology_acc_core(T : i32) -> i32
requires Topology::AccCore
[3] == Topology::AccCore[3] ensures return == 1 {
  return 1;
}

fn test_topology_gpu(T : i32) -> i32
requires Topology::GPU ==
Topology::GPU ensures return == 1 {
  return 1;
}

fn test_topology_amx(T : i32) -> i32
requires Topology::AMX ==
Topology::AMX ensures return == 1 {
  return 1;
}

fn test_topology_ane(T : i32) -> i32
requires Topology::ANE ==
Topology::ANE ensures return == 1 {
  return 1;
}

fn main() -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_topology_ane(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_topology_amx(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_topology_gpu(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_topology_acc_core(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_topology_host(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_topology_npu(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 1 : i32
// CHECK: return %[[V0]] : i32
