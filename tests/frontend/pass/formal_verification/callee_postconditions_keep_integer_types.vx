// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefixes=WARN,CHECK --implicit-check-not=Error --implicit-check-not=Warning
// WARN: Warning[W1014]
// WARN-SAME: 255 does not fit in i8

fn identity(value : i32) -> i32
ensures (return as i64) == (value as i64) {
  return value;
}

fn caller(value : i32) -> i32
ensures return == value {
  return identity(value);
}

fn residue(value : i32) -> i32
requires value >= 0 && value < 10
ensures return % 10 == value
ensures return >= 0 && return < 10 {
  return value;
}

fn caller_residue(value : i32) -> i32
requires value >= 0 && value < 10
ensures return == value {
  return residue(value);
}

fn remainder_constant() -> i32
ensures return == 5 % 2 {
  return 5 % 2;
}

fn cast_constant() -> i8
ensures return == (255 as i8) {
  return 255 as i8;
}

fn _wide_literal_cast() -> i64
ensures return == (3000000000 as i64) {
  return 3000000000;
}

struct Small {
  field : i32,
}

fn _field_identity(value : Small) -> i32
ensures (return as i64) == (value.field as i64) {
  return value.field;
}

fn _field_caller(value : Small) -> i32
ensures (return as i64) == (value.field as i64) {
  return _field_identity(value);
}

fn consume(value : i64) -> i32
requires value >= 0i64 && value < 100i64
requires (value as i32) == 5 % 2
ensures (return as i64) == value {
  return value as i32;
}

fn main() -> i32 {
  if caller(-17) != -17 || caller_residue(9) != 9 || remainder_constant() != 1 || cast_constant() != -1 {
    return 1;
  }
  return consume(1i64) - 1;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @main() -> i32 {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %alloca = memref.alloca() : memref<i1>
// CHECK:     %alloca_0 = memref.alloca() : memref<i1>
// CHECK:     %alloca_1 = memref.alloca() : memref<i1>
// CHECK:     %c17_i32 = arith.constant 17 : i32
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.subi %c0_i32, %c17_i32 : i32
// CHECK:     %1 = call @caller(%0) : (i32) -> i32
// CHECK:     %c17_i32_2 = arith.constant 17 : i32
// CHECK:     %c0_i32_3 = arith.constant 0 : i32
// CHECK:     %2 = arith.subi %c0_i32_3, %c17_i32_2 : i32
// CHECK:     %3 = arith.cmpi ne, %1, %2 : i32
// CHECK:     cf.cond_br %3, ^bb2, ^bb1
// CHECK:   ^bb1:  // pred: ^bb0
// CHECK:     %c9_i32 = arith.constant 9 : i32
// CHECK:     %4 = call @caller_residue(%c9_i32) : (i32) -> i32
// CHECK:     %c9_i32_4 = arith.constant 9 : i32
// CHECK:     %5 = arith.cmpi ne, %4, %c9_i32_4 : i32
// CHECK:     memref.store %5, %alloca_1[] : memref<i1>
// CHECK:     cf.br ^bb3
// CHECK:   ^bb2:  // pred: ^bb0
// CHECK:     %true = arith.constant true
// CHECK:     memref.store %true, %alloca_1[] : memref<i1>
// CHECK:     cf.br ^bb3
// CHECK:   ^bb3:  // 2 preds: ^bb1, ^bb2
// CHECK:     %6 = memref.load %alloca_1[] : memref<i1>
// CHECK:     cf.cond_br %6, ^bb5, ^bb4
// CHECK:   ^bb4:  // pred: ^bb3
// CHECK:     %7 = call @remainder_constant() : () -> i32
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %8 = arith.cmpi ne, %7, %c1_i32 : i32
// CHECK:     memref.store %8, %alloca_0[] : memref<i1>
// CHECK:     cf.br ^bb6
// CHECK:   ^bb5:  // pred: ^bb3
// CHECK:     %true_5 = arith.constant true
// CHECK:     memref.store %true_5, %alloca_0[] : memref<i1>
// CHECK:     cf.br ^bb6
// CHECK:   ^bb6:  // 2 preds: ^bb4, ^bb5
// CHECK:     %9 = memref.load %alloca_0[] : memref<i1>
// CHECK:     cf.cond_br %9, ^bb8, ^bb7
// CHECK:   ^bb7:  // pred: ^bb6
// CHECK:     %10 = call @cast_constant() : () -> i8
// CHECK:     %c1_i8 = arith.constant 1 : i8
// CHECK:     %c0_i8 = arith.constant 0 : i8
// CHECK:     %11 = arith.subi %c0_i8, %c1_i8 : i8
// CHECK:     %12 = arith.cmpi ne, %10, %11 : i8
// CHECK:     memref.store %12, %alloca[] : memref<i1>
// CHECK:     cf.br ^bb9
// CHECK:   ^bb8:  // pred: ^bb6
// CHECK:     %true_6 = arith.constant true
// CHECK:     memref.store %true_6, %alloca[] : memref<i1>
// CHECK:     cf.br ^bb9
// CHECK:   ^bb9:  // 2 preds: ^bb7, ^bb8
// CHECK:     %13 = memref.load %alloca[] : memref<i1>
// CHECK:     cf.cond_br %13, ^bb10, ^bb11
// CHECK:   ^bb10:  // pred: ^bb9
// CHECK:     %c1_i32_7 = arith.constant 1 : i32
// CHECK:     return %c1_i32_7 : i32
// CHECK:   ^bb11:  // pred: ^bb9
// CHECK:     %c1_i64 = arith.constant 1 : i64
// CHECK:     %14 = call @consume(%c1_i64) : (i64) -> i32
// CHECK:     %c1_i32_8 = arith.constant 1 : i32
// CHECK:     %15 = arith.subi %14, %c1_i32_8 : i32
// CHECK:     return %15 : i32
// CHECK:   }
// CHECK:   func.func @remainder_constant() -> i32 {
// CHECK:     %c5_i32 = arith.constant 5 : i32
// CHECK:     %c2_i32 = arith.constant 2 : i32
// CHECK:     %0 = arith.remsi %c5_i32, %c2_i32 : i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @consume(%arg0: i64) -> i32 {
// CHECK:     %0 = arith.trunci %arg0 : i64 to i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @cast_constant() -> i8 {
// CHECK:     %c255_i32 = arith.constant 255 : i32
// CHECK:     %0 = arith.trunci %c255_i32 : i32 to i8
// CHECK:     return %0 : i8
// CHECK:   }
// CHECK:   func.func @caller_residue(%arg0: i32) -> i32 {
// CHECK:     %0 = call @residue(%arg0) : (i32) -> i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @residue(%arg0: i32) -> i32 {
// CHECK:     return %arg0 : i32
// CHECK:   }
// CHECK:   func.func @caller(%arg0: i32) -> i32 {
// CHECK:     %0 = call @identity(%arg0) : (i32) -> i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @identity(%arg0: i32) -> i32 {
// CHECK:     return %arg0 : i32
// CHECK:   }
// CHECK:   func.func @_field_caller(%arg0: !llvm.struct<(i32)>) -> i32 {
// CHECK:     %0 = llvm.mlir.constant(1 : i32) : i32
// CHECK:     %1 = llvm.alloca %0 x !llvm.struct<(i32)> : (i32) -> !llvm.ptr
// CHECK:     llvm.store %arg0, %1 : !llvm.struct<(i32)>, !llvm.ptr
// CHECK:     %2 = llvm.load %1 : !llvm.ptr -> !llvm.struct<(i32)>
// CHECK:     %3 = call @_field_identity(%2) : (!llvm.struct<(i32)>) -> i32
// CHECK:     return %3 : i32
// CHECK:   }
// CHECK:   func.func @_field_identity(%arg0: !llvm.struct<(i32)>) -> i32 {
// CHECK:     %0 = llvm.mlir.constant(1 : i32) : i32
// CHECK:     %1 = llvm.alloca %0 x !llvm.struct<(i32)> : (i32) -> !llvm.ptr
// CHECK:     llvm.store %arg0, %1 : !llvm.struct<(i32)>, !llvm.ptr
// CHECK:     %2 = llvm.getelementptr %1[0, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK:     %3 = llvm.load %2 : !llvm.ptr -> i32
// CHECK:     return %3 : i32
// CHECK:   }
// CHECK:   func.func @_wide_literal_cast() -> i64 {
// CHECK:     %c3000000000_i64 = arith.constant 3000000000 : i64
// CHECK:     return %c3000000000_i64 : i64
// CHECK:   }
// CHECK: }
