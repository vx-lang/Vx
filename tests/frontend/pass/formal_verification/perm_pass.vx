// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn test_group1_0(X : i32) -> i32
requires Topology::NPU
[0] == Topology::CPU ensures return == X {
  return X;
}

fn test_group1_1(X : i32) -> i32
requires Topology::CPU <=
Topology::NPU[0] ensures return == X {
  return X;
}

fn main() -> i32 {
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @test_group1_1(%arg0: i32) -> i32
// CHECK-LABEL: func.func @test_group1_0(%arg0: i32) -> i32
