// CHECK:   func.func @unsigned_to_signed(%arg0: i8) -> i8 {
// CHECK:     return %arg0 : i8
// CHECK:   }
// CHECK:   func.func @unsigned_remainder(%arg0: i64, %arg1: i64) -> i64 {
// CHECK:     %0 = arith.remui %arg0, %arg1 : i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @source_width_before_cast(%arg0: i32) -> i64 {
// CHECK:     %c1_i32 = arith.constant 1 : i32
// CHECK:     %0 = arith.addi %arg0, %c1_i32 : i32
// CHECK:     %1 = call @"i64::From$i32$from"(%0) : (i32) -> i64
// CHECK:     return %1 : i64
// CHECK:   }
// CHECK:   func.func @"i64::From$i32$from"(%arg0: i32) -> i64 {
// CHECK:     %0 = arith.extsi %arg0 : i32 to i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @signed_to_unsigned(%arg0: i8) -> i16 {
// CHECK:     %0 = arith.extsi %arg0 : i8 to i16
// CHECK:     return %0 : i16
// CHECK:   }
// CHECK:   func.func @signed_remainder(%arg0: i32, %arg1: i32) -> i32 {
// CHECK:     %0 = arith.remsi %arg0, %arg1 : i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @sample_row(%arg0: i32, %arg1: i32, %arg2: i32, %arg3: i32) -> i32 {
// CHECK:     %0 = call @"i64::From$i32$from"(%arg2) : (i32) -> i64
// CHECK:     %1 = call @"i64::From$i32$from"(%arg0) : (i32) -> i64
// CHECK:     %2 = call @"i64::From$i32$from"(%arg3) : (i32) -> i64
// CHECK:     %3 = arith.muli %1, %2 : i64
// CHECK:     %4 = arith.addi %0, %3 : i64
// CHECK:     %5 = call @"i64::From$i32$from"(%arg1) : (i32) -> i64
// CHECK:     %6 = arith.remsi %4, %5 : i64
// CHECK:     %7 = arith.trunci %6 : i64 to i32
// CHECK:     return %7 : i32
// CHECK:   }
// CHECK:   func.func @negative_divisor(%arg0: i32) -> i32 {
// CHECK:     %c7_i32 = arith.constant 7 : i32
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     %0 = arith.subi %c0_i32, %c7_i32 : i32
// CHECK:     %1 = arith.remsi %arg0, %0 : i32
// CHECK:     return %1 : i32
// CHECK:   }
// CHECK:   func.func @narrow_wrapping(%arg0: i64) -> i32 {
// CHECK:     %0 = arith.trunci %arg0 : i64 to i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @narrow_in_range(%arg0: i64) -> i32 {
// CHECK:     %0 = arith.trunci %arg0 : i64 to i32
// CHECK:     return %0 : i32
// CHECK:   }
// CHECK:   func.func @consume_index(%arg0: i32) -> i32 {
// CHECK:     return %arg0 : i32
// CHECK:   }
// CHECK:   func.func @cast_argument(%arg0: i64) -> i32 {
// CHECK:     %0 = arith.trunci %arg0 : i64 to i32
// CHECK:     %1 = call @consume_index(%0) : (i32) -> i32
// CHECK:     return %1 : i32
// CHECK:   }
// CHECK: }
