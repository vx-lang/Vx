// CHECK:     %alloca_6 = memref.alloca() : memref<i1>
// CHECK:     %c2147483647_i32 = arith.constant 2147483647 : i32
// CHECK:     %0 = call @source_width_before_cast(%c2147483647_i32) : (i32) -> i64
// CHECK:     %c9_i64 = arith.constant 9 : i64
// CHECK:     %1 = call @cast_argument(%c9_i64) : (i64) -> i32
// CHECK:     %c8_i32 = arith.constant 8 : i32
