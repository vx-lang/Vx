// CHECK:     %c7_i32 = arith.constant 7 : i32
// CHECK:     %3 = call @signed_remainder(%2, %c7_i32) : (i32, i32) -> i32
// CHECK:     %c8_i32_7 = arith.constant 8 : i32
// CHECK:     %4 = call @negative_divisor(%c8_i32_7) : (i32) -> i32
// CHECK:     %c-1_i64 = arith.constant -1 : i64
// CHECK:     %c7_i64 = arith.constant 7 : i64
// CHECK:     %5 = call @unsigned_remainder(%c-1_i64, %c7_i64) : (i64, i64) -> i64
// CHECK:     %c2147483648_i64 = arith.constant 2147483648 : i64
// CHECK:     %c0_i64 = arith.constant 0 : i64
// CHECK:     %6 = arith.subi %c0_i64, %c2147483648_i64 : i64
// CHECK:     %7 = call @narrow_in_range(%6) : (i64) -> i32
// CHECK:     %c2147483647_i64 = arith.constant 2147483647 : i64
// CHECK:     %8 = call @narrow_in_range(%c2147483647_i64) : (i64) -> i32
