// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning

import core::convert;

fn sample_row(position : i32, rows : i32, offset : i32, stride : i32) -> i32
requires rows > 0
requires position >= 0 && position < rows
requires offset >= 0 && offset < rows
requires stride >= 0 && stride < rows
ensures return >= 0 && return < rows {
  let index = i64::from(offset) + i64::from(position) * i64::from(stride);
  return (index % i64::from(rows)) as i32;
}

fn signed_remainder(value : i32, divisor : i32) -> i32
requires value <= 0 && divisor > 0
ensures return <= 0 && return > -divisor {
  return value % divisor;
}

fn negative_divisor(value : i32) -> i32
requires value >= 0
ensures return >= 0 && return < 7 {
  return value % -7;
}

fn unsigned_remainder(value : u64, divisor : u64) -> u64
requires divisor > 0u64
ensures return >= 0u64 && return < divisor {
  return value % divisor;
}

fn narrow_in_range(value : i64) -> i32
requires value >= -2147483648i64 && value <= 2147483647i64
ensures return == value {
  return value as i32;
}

fn narrow_wrapping(value : i64) -> i32
requires value == 2147483648i64
ensures return == -2147483648i64 {
  return value as i32;
}

fn unsigned_to_signed(value : u8) -> i8
requires value == 255u8
ensures return == -1 {
  return value as i8;
}

fn signed_to_unsigned(value : i8) -> u16
requires value == -1
ensures return == 65535u16 {
  return value as u16;
}

fn source_width_before_cast(value : i32) -> i64
requires value == 2147483647
ensures return == -2147483648i64 {
  return i64::from(value + 1);
}

fn consume_index(index : i32) -> i32
requires index >= 0 && index < 10
ensures return == index {
  return index;
}

fn cast_argument(value : i64) -> i32
requires value >= 0i64 && value < 10i64
ensures return == value {
  return consume_index(value as i32);
}

fn main() -> i32 {
  let _source_width = source_width_before_cast(2147483647);
  let _argument = cast_argument(9i64);
  let _signed = signed_remainder(-8, 7);
  let _negative = negative_divisor(8);
  let _unsigned = unsigned_remainder(18446744073709551615u64, 7u64);
  let _minimum = narrow_in_range(-2147483648i64);
  let _maximum = narrow_in_range(2147483647i64);
  let _wrapped = narrow_wrapping(2147483648i64);
  let _signed_byte = unsigned_to_signed(255u8);
  let _unsigned_word = signed_to_unsigned(-1);
  let row = consume_index(sample_row(2, 10, 1, 3));
  if row != 7 || _signed != -1 || _negative != 1 || _unsigned != 1u64 {
    return 1;
  }
  if _minimum != (-2147483647 - 1) || _maximum != 2147483647 || _wrapped != (-2147483647 - 1) {
    return 2;
  }
  if _signed_byte != -1 || _unsigned_word != 65535u16 || _source_width != -2147483648i64 || _argument != 9 {
    return 3;
  }
  return 0;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @main() -> i32 {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %alloca = memref.alloca() : memref<i1>
// CHECK:     %alloca_0 = memref.alloca() : memref<i1>
// CHECK:     %alloca_1 = memref.alloca() : memref<i1>
// CHECK:     %alloca_2 = memref.alloca() : memref<i1>
// CHECK:     %alloca_3 = memref.alloca() : memref<i1>
// CHECK:     %alloca_4 = memref.alloca() : memref<i1>
