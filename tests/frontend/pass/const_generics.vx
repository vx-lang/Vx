// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The flat path compiles this: the instance `Array<f32, 10>` has a layout synthesized from
// the declaration with `N` bound, the construction stores into it, and the value is returned
// whole. The const argument reaches the emitted symbol, which carries it by value.
// CHECK-LABEL: func.func @test_const_generics()
// CHECK: call @initialize$const${{.*}}value___10{{.*}}() : () -> !llvm.struct<(f32)>
// CHECK-LABEL: func.func @initialize$const${{.*}}value___10{{.*}}() -> !llvm.struct<(f32)>
// CHECK: %[[S:.*]] = llvm.alloca %{{.*}} x !llvm.struct<(f32)> : (i32) -> !llvm.ptr
// CHECK: llvm.getelementptr %[[S]][0, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(f32)>
// CHECK: arith.addi %c10_i32, %c1_i32 : i32
// CHECK: %[[V:.*]] = llvm.load %[[S]] : !llvm.ptr -> !llvm.struct<(f32)>
// CHECK: return %[[V]] : !llvm.struct<(f32)>
struct Array<T, const N : i32> {
  val : T
}

fn initialize<const N : i32>()
->Array<f32, N> {
  let a = Array<f32, N> {
    val : 1.0
  };
  let x = N + 1;
  return a;
}

fn test_const_generics() -> void {
  let array = initialize<10>();
  assert(true);
}
