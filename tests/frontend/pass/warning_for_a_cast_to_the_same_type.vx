// RUN: vxc %s --action print-ast 2>&1 | FileCheck %s
//
// `x as i32` when `x` is already an `i32` does nothing (W1013). A widening cast, a cast of a
// literal, and `v as T` in a generic function used with `T = i32` get no warning.

// CHECK: Warning[W1013] at 22:16: this value is already i32, so the cast does nothing
// CHECK-NOT: Warning[W1013]

fn convert<T>(v : i32) -> T {
  return v as T;
}

fn main() -> i32 {
  let x : i32 = 1;
  let same = x as i32;
  let wide = x as i64;
  let one = 1 as i32;
  let minus_one = -1 as i32;
  let y : i32 = convert(x);
  print(wide);
  return same + one + minus_one + y;
}
