// RUN: vxc %s --run 2>&1 | FileCheck %s
// `unsafe { .. } as T` casts the block's value. The `let` types only check if every cast is
// applied, and `+ 1` applies to the cast value.
// CHECK: one cast 7
// CHECK-NEXT: two casts 7
// CHECK-NEXT: cast then add 8

unsafe fn seven() -> i32 {
  return 7;
}

fn main() -> i32 {
  let one : i64 = unsafe { seven() } as i64;
  let two : i32 = unsafe { seven() } as i64 as i32;
  let sum : i64 = unsafe { seven() } as i64 + 1;
  print!("one cast ");
  print!(one);
  print!("
two casts ");
  print!(two);
  print!("
cast then add ");
  print!(sum);
  print!("
");
  return 0;
}
