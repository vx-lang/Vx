// Test: CpuAvx512 topology spawn with local computation.

fn main() -> i32 {
  // CpuAvx512 spawns use DRAM, but variables must be
  // defined inside the spawn block (not crossed from CPU).
  spawn on(Topology::CpuAvx512) {
    // CHECK-NOT: error
    let avx_val : Tensor<f32> = 2.0;
  }

  return 0;
}

// CHECK: module
