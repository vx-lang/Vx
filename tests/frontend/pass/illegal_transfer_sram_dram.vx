//===- illegal_transfer_sram_dram.vx - Vx Compiler ---------------------------*-
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// Vx -*-===//

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);
  let t_sram = transfer(t_npu, Memory::Local_SRAM);

  // This is illegal! Direct SRAM to DRAM transfer bypasses HBM.
  // CHECK: Cannot transfer from LocalSRAM to CPUDRAM: no hardware path exists
  let invalid = transfer(t_sram, Memory::CPU_DRAM);

  return 0;
}

