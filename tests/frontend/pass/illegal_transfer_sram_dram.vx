//===- illegal_transfer_sram_dram.vx - Vx Compiler ---------------------------*-
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// Vx -*-===//

fn main() -> i32 {
  let t_host : Tensor<f32, []> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);
  let t_sram = transfer(t_npu, Memory::Local_SRAM);

  // SRAM has no direct edge to DRAM, so this does not bypass HBM: the transfer
  // is routed, and three written transfers emit four `vx.transfer` ops -- 200
  // (SRAM) to 100 (NPU_HBM) to 0 (CPU_DRAM). The file asserted a rejection here
  // for a long time without anyone noticing, because the runner never executed
  // its CHECK lines (Vx#407). Routing is the better answer and is what happens.
  // CHECK: target_topology = 200
  // CHECK: target_topology = 100
  // CHECK: target_topology = 0
  let routed = transfer(t_sram, Memory::CPU_DRAM);

  return 0;
}
