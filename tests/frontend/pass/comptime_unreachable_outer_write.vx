// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  let value = comptime {
    let chosen = if true {
      1i32
    } else {
      outside = 4i32;
      2i32
    };
    chosen
  };
  return value;
}
