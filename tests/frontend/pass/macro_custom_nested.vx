// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 10 : i32
// CHECK: %[[V1:.*]] = arith.constant 1 : i32
// CHECK: %[[V2:.*]] = arith.addi %[[V0]], %[[V1]] : i32
// CHECK: %[[V3:.*]] = arith.constant 1 : i32
// CHECK: %[[V4:.*]] = arith.addi %[[V2]], %[[V3]] : i32
// CHECK: return %[[V4]] : i32
import std::vec;
import std::closure;

macro_rules add_one { ($x : expr) => {
    $x + 1
  }; }
macro_rules add_two { ($x : expr) => {
    add_one!(add_one!($x))
  }; }
fn main() -> i32 {
  let a = add_two!(10);
  return a;
}