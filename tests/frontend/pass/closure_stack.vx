// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
//
// The closure environment struct these CHECK lines name is the AST codegen's
// shape; the flat path (the default since Vx#201) lowers a closure differently
// and emits no such struct. The RUN line pins the path the assertions were
// written against. Nothing noticed the mismatch because this runner did not
// execute CHECK lines until Vx#407.

/// comment for foo to see in hover.
fn foo(x: i32) -> i32 {
  return x + x;
}

fn main() -> i32 {
  let i = 1;
  let captured = 2;
  let _l = 42 + i;

  // The closure should be lowered to an anonymous struct allocated on the stack
  // (alloca)
  let _my_closure = | x : i32 | x + captured + foo(x);

  return 0;
}


// CHECK: func.func @main
// CHECK: llvm.mlir.undef : !llvm.struct<"Closure_
// CHECK: llvm.insertvalue
