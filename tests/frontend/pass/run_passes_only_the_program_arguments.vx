// RUN: vxc %s --run -- first second 2>&1 | FileCheck %s
// A program run by `vxc --run` sees the arguments after `--`, as a built binary would:
// argument 0 is the program, and the `.vx` file is not one of them.
// CHECK: 3 arguments
// CHECK-NEXT: first
// CHECK-NEXT: second
import std::root;
import std::string;
import std::vec;

fn main(_root : Root, args : Vec<String>) -> i32 {
  println!("{} arguments", args.len());
  let mut i = 1;
  while i < args.len() {
    println!("{}", args.get_ref(i));
    i = i + 1;
  }
  return 0;
}
