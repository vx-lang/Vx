// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
//
// In the body of `for i in 0..b`, the prover knows `i < b` also when `b` is a call, or a `let`
// that holds the result of a call. `i < b` also means that `i + 1` fits in an `i32`.

// CHECK: 3 3 10

import std::vec;

fn need_below(i : i32, n : i32) -> i32
requires i < n {
  return i;
}

// Each pass adds at most one, so `count <= i` holds for the next `i`.
fn count_even(v : &Vec<i64>) -> i32 {
  let mut count : i32 = 0;
  for i in 0..v.len() invariant 0 <= count && count <= i {
    if i % 2 == 0 {
      count = count + 1;
    }
  }
  return count;
}

fn count_even_from_a_let(v : &Vec<i64>) -> i32 {
  let n = v.len();
  let mut count : i32 = 0;
  for i in 0..n invariant 0 <= count && count <= i {
    if i % 2 == 0 {
      count = count + 1;
    }
  }
  return count;
}

// The body does not change `v`, so `v.len()` is still the end of the loop.
fn sum_of_the_indices(v : &Vec<i64>) -> i32 {
  let mut total : i32 = 0;
  for i in 0..v.len() {
    total = total + need_below(i, v.len());
  }
  return total;
}

fn main() -> i32 {
  let mut v = Vec<i64>::new();
  for k in 0..5 {
    v.push(k as i64);
  }
  println!("{} {} {}", count_even(&v), count_even_from_a_let(&v), sum_of_the_indices(&v));
  return 0;
}
