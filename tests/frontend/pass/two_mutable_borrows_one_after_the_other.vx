// The default code generator does not support a borrow of a value that is not a tensor yet, so this uses the AST one.
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s
//
// What stays allowed next to two_mutable_borrows_of_elements_of_one_tensor.vx: a second `&mut`
// element borrow once the first is finished, and `&mut` borrows of two different fields of a
// struct.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

struct P {
  x : i32,
  y : i32,
}

fn one_after_the_other() -> i32 {
  let mut arr = Tensor<i32>([4]);
  let a = &mut arr[0];
  *a = 1;
  let b = &mut arr[1];
  *b = 2;
  return arr[0];
}

fn two_fields() -> i32 {
  let mut p = P {
    x: 1, y: 2
  };
  let a = &mut p.x;
  let b = &mut p.y;
  *a = 3;
  *b = 4;
  return p.x + p.y;
}

fn main() -> i32 {
  return one_after_the_other() + two_fields();
}
