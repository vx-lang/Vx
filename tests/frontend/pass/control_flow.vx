// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// A loop with a break, a match over an integer literal, and a match over a data-carrying
// enum: each is a compare-and-branch chain. The program compiles on the flat path; the AST
// path still fails verification on the payload match (Vx#398).
// CHECK-LABEL: func.func @test_match_enum() -> i32
// CHECK: %[[TAG:.*]] = llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK: %[[IS_SOME:.*]] = arith.cmpi eq, %[[TAG]], %{{.*}} : i32
// CHECK: cf.cond_br %[[IS_SOME]], ^bb1, ^bb2
// CHECK: llvm.load %{{.*}} : !llvm.ptr -> i32
// CHECK-LABEL: func.func @test_match(%arg0: i32) -> i32
// CHECK: %[[IS_ZERO:.*]] = arith.cmpi eq, %arg0, %{{.*}} : i32
// CHECK: cf.cond_br %[[IS_ZERO]], ^bb1, ^bb2
// CHECK-LABEL: func.func @test_loop() -> i32
// CHECK: %[[DONE:.*]] = arith.cmpi sge, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[DONE]], ^bb2, ^bb3
fn test_loop() -> i32 {
  let mut sum = 0;
  loop {
    sum += 1;
    if sum >= 10 {
      break;
    }
  }
  return sum;
}

fn test_match(x : i32) -> i32 {
  let mut res = 0;
  match x {
    0 => {
      res = 1;
    }
    , _ => {
      res = 2;
    }
  }
  return res;
}

enum Option {
  Some(i32),
  None,
}

fn test_match_enum() -> i32 {

  let x = Option::Some(42);
  let mut out = 0;
  match x {
    Option::Some(val) => {
      out = val;
    }
    , Option::None => {
      out = 0 - 1;
    }
  }
  return out;
}

fn main() -> i32 {
  let a = test_loop();
  let b = test_match(0);
  let c = test_match_enum();

  // 10 + 1 + 42 = 53
  return a + b + c;
}
