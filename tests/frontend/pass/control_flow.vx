fn test_loop() -> i32 {
  let mut sum = 0;
  loop {
    sum += 1;
    if sum >= 10 {
      break;
    }
  }
  return sum;
}

fn test_match(x: i32) -> i32 {
  let mut res = 0;
  match x {
    0 => {
      res = 1;
    },
    _ => {
      res = 2;
    }
  }
  return res;
}

enum Option {
  Some(i32),
  None,
}

fn test_match_enum() -> i32 {

  let x = Option::Some(42);
  let mut out = 0;
  match x {
    Option::Some(val) => {
      out = val;
    },
    Option::None => {
      out = 0 - 1;
    }
  }
  return out;
}

fn main() -> i32 {
  let a = test_loop();
  let b = test_match(0);
  let c = test_match_enum();

  // 10 + 1 + 42 = 53
  return a + b + c;
}
