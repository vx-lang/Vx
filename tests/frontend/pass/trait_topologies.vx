// RUN: vxc %s --action parse

struct CPU {}
struct NPU {}

trait ExecuteArith<T> {
  fn add_array(self: T, topo: Topology, a: f32[4], b: f32[4]) -> f32[4];
  fn add_vector(self: T, topo: Topology, a: vec<f32, 4>, b: vec<f32, 4>) -> vec<f32, 4>;
  fn add_tensor(self: T, topo: Topology, a: Tensor<f32>, b: Tensor<f32>) -> Tensor<f32>;
}

impl ExecuteArith<CPU> for CPU {
  fn add_array(self: CPU, topo: Topology, a: f32[4], b: f32[4]) -> f32[4] { return a + b; }
  fn add_vector(self: CPU, topo: Topology, a: vec<f32, 4>, b: vec<f32, 4>) -> vec<f32, 4> { return a + b; }
  fn add_tensor(self: CPU, topo: Topology, a: Tensor<f32>, b: Tensor<f32>) -> Tensor<f32> { return a + b; }
}

impl ExecuteArith<NPU> for NPU {
  fn add_array(self: NPU, topo: Topology, a: f32[4], b: f32[4]) -> f32[4] { return a + b; }
  fn add_vector(self: NPU, topo: Topology, a: vec<f32, 4>, b: vec<f32, 4>) -> vec<f32, 4> { return a + b; }
  fn add_tensor(self: NPU, topo: Topology, a: Tensor<f32>, b: Tensor<f32>) -> Tensor<f32> { return a + b; }
}

trait TransferDMA<T> {
  fn transfer_array(self: T, src_topo: Topology, dst_topo: Topology, data: f32[4]) -> f32[4];
  fn transfer_vector(self: T, src_topo: Topology, dst_topo: Topology, data: vec<f32, 4>) -> vec<f32, 4>;
  fn transfer_tensor(self: T, src_topo: Topology, dst_topo: Topology, data: Tensor<f32>) -> Tensor<f32>;
}

impl TransferDMA<CPU> for CPU {
  fn transfer_array(self: CPU, src_topo: Topology, dst_topo: Topology, data: f32[4]) -> f32[4] { return transfer(data, dst_topo); }
  fn transfer_vector(self: CPU, src_topo: Topology, dst_topo: Topology, data: vec<f32, 4>) -> vec<f32, 4> { return transfer(data, dst_topo); }
  fn transfer_tensor(self: CPU, src_topo: Topology, dst_topo: Topology, data: Tensor<f32>) -> Tensor<f32> { return transfer(data, dst_topo); }
}

impl TransferDMA<NPU> for NPU {
  fn transfer_array(self: NPU, src_topo: Topology, dst_topo: Topology, data: f32[4]) -> f32[4] { return transfer(data, dst_topo); }
  fn transfer_vector(self: NPU, src_topo: Topology, dst_topo: Topology, data: vec<f32, 4>) -> vec<f32, 4> { return transfer(data, dst_topo); }
  fn transfer_tensor(self: NPU, src_topo: Topology, dst_topo: Topology, data: Tensor<f32>) -> Tensor<f32> { return transfer(data, dst_topo); }
}

fn main() -> void {}
