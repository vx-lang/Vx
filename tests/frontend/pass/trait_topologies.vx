// CHECK:   func.func private @printMemrefBF16(memref<*xbf16>)
// CHECK:   func.func @CPU$add_vector(%arg0: !llvm.struct<"CPU", ()>, %arg1: vector<4xf32>, %arg2: vector<4xf32>) -> vector<4xf32> {
// CHECK:     %0 = arith.addf %arg1, %arg2 : vector<4xf32>
// CHECK:     return %0 : vector<4xf32>
// CHECK:   }
// CHECK:   func.func @NPU$add_vector(%arg0: !llvm.struct<"NPU", ()>, %arg1: vector<4xf32>, %arg2: vector<4xf32>) -> vector<4xf32> {
// CHECK:     %0 = arith.addf %arg1, %arg2 : vector<4xf32>
// CHECK:     return %0 : vector<4xf32>
// CHECK:   }
// CHECK:   func.func @CPU$transfer_vector(%arg0: !llvm.struct<"CPU", ()>, %arg1: vector<4xf32>) -> vector<4xf32> {
// CHECK:     return %arg1 : vector<4xf32>
// CHECK:   }
// CHECK:   func.func @NPU$transfer_vector(%arg0: !llvm.struct<"NPU", ()>, %arg1: vector<4xf32>) -> vector<4xf32> {
// CHECK:     return %arg1 : vector<4xf32>
// CHECK:   }
// CHECK:   func.func @CPU$add_array(%arg0: !llvm.struct<"CPU", ()>, %arg1: memref<4xf32>, %arg2: memref<4xf32>) -> memref<4xf32> {
// CHECK:     %alloc = memref.alloc() : memref<4xf32>
// CHECK:     linalg.add ins(%arg1, %arg2 : memref<4xf32>, memref<4xf32>) outs(%alloc : memref<4xf32>)
// CHECK:     return %alloc : memref<4xf32>
// CHECK:   }
// CHECK:   func.func @CPU$add_tensor(%arg0: !llvm.struct<"CPU", ()>, %arg1: memref<?x?xf32>, %arg2: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     %c0 = arith.constant 0 : index
// CHECK:     %dim = memref.dim %arg1, %c0 : memref<?x?xf32>
// CHECK:     %c1 = arith.constant 1 : index
// CHECK:     %dim_0 = memref.dim %arg1, %c1 : memref<?x?xf32>
// CHECK:     %alloc = memref.alloc(%dim, %dim_0) : memref<?x?xf32>
// CHECK:     linalg.add ins(%arg1, %arg2 : memref<?x?xf32>, memref<?x?xf32>) outs(%alloc : memref<?x?xf32>)
// CHECK:     return %alloc : memref<?x?xf32>
// CHECK:   }
