//===----------------------------------------------------------------------===//
// `t.extent(i)` is the typed read of a run-time extent: an `i32`, from
// `memref.dim`, for a literal `i` below the rank. It replaces `.shape[i]`,
// which answered on any value and typed its answer as a rank-0 tensor.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @size(
// CHECK: memref.dim
// CHECK: arith.index_cast %{{.*}} : index to i32

fn size(m : Tensor<f32, [?, 3]>) -> i32 {
  let r : i32 = m.extent(0);
  let c : i32 = m.extent(1);
  return r * c;
}

fn build(n : i32) -> Tensor<f32, [?, 3]> {
  let mut m = Tensor<f32>([n, 3]);
  m[0][0] = 1.0;
  return m;
}

fn main() -> i32 {
  return size(build(2)) - 6;
}
