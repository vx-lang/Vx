// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 5 : i32
// CHECK: %[[V1:.*]] = arith.constant 1 : i32
// CHECK: %[[V2:.*]] = arith.addi %[[V0]], %[[V1]] : i32
// CHECK: return %[[V2]] : i32
import std::vec;
import std::closure;

macro_rules do_thing { ($x : expr) => {
    $x + 1
  }; }
fn main() -> i32 {
  let a = do_thing!(5);
  return a;
}