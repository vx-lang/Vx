// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// Each arithmetic operator is a named linalg op over the two operands into a fresh buffer
// of the static shape, and the function returns that buffer.
// CHECK-LABEL: func.func @gen_tensor_math_sub() -> memref<16x16xf32>
// CHECK: %[[A:.*]] = memref.alloc() : memref<16x16xf32>
// CHECK: %[[B:.*]] = memref.alloc() : memref<16x16xf32>
// CHECK: %[[C:.*]] = memref.alloc() : memref<16x16xf32>
// CHECK: linalg.sub ins(%[[A]], %[[B]] : memref<16x16xf32>, memref<16x16xf32>) outs(%[[C]] : memref<16x16xf32>)
// CHECK: return %[[C]] : memref<16x16xf32>
// CHECK-LABEL: func.func @gen_tensor_math_mul() -> memref<16x16xf32>
// CHECK: linalg.mul ins(%{{.*}}, %{{.*}} : memref<16x16xf32>, memref<16x16xf32>) outs(%[[M:.*]] : memref<16x16xf32>)
// CHECK: return %[[M]] : memref<16x16xf32>
// CHECK-LABEL: func.func @gen_tensor_math_div() -> memref<16x16xf32>
// CHECK: linalg.div ins(%{{.*}}, %{{.*}} : memref<16x16xf32>, memref<16x16xf32>) outs(%[[D:.*]] : memref<16x16xf32>)
// CHECK: return %[[D]] : memref<16x16xf32>
// CHECK-LABEL: func.func @gen_tensor_math_add() -> i32
// CHECK: linalg.add ins(%{{.*}}, %{{.*}} : memref<16x16xf32>, memref<16x16xf32>) outs(%{{.*}} : memref<16x16xf32>)
// CHECK: %[[R:.*]] = arith.constant 0 : i32
// CHECK: return %[[R]] : i32

fn gen_tensor_math_add() -> i32 {
  let a : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  let b : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  let c = a + b;
  return 0;
}

fn gen_tensor_math_div() -> Tensor<f32, [ 16, 16 ]> {
  let a : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  let b : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  return a / b;
}

fn gen_tensor_math_mul() -> Tensor<f32, [ 16, 16 ]> {
  let a : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  let b : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  return a * b;
}

fn gen_tensor_math_sub() -> Tensor<f32, [ 16, 16 ]> {
  let a : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  let b : Tensor<f32, [ 16, 16 ]> = Tensor<f32, [16, 16]>::uninit();
  return a - b;
}
