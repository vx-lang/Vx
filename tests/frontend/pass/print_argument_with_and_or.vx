//===----------------------------------------------------------------------===//
// An argument of `print!` or `println!` can be `a && b` or `a || b`, which evaluate `b` only
// when they need it. The arguments after it are still printed.
//
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s
// RUN: vxc %s 2>&1 | FileCheck %s
// CHECK: print true 7
// CHECK-NEXT: println false 7
// CHECK-NEXT: done

fn main() -> i32 {
  let a = true;
  let n = 7;
  print!("print ", a && n > 3, " ", n, "\n");
  println!("println {} {}", !a || n > 9, n);
  println!("done");
  return 0;
}
