// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
fn check_top() on Topology::NPU[0] -> void {
  // If comptime returns an expression
  let a = if comptime true {
    1
  } else {
    0
  };

  // Topology::Current should evaluate to NPU here
  let t = Topology::Current;
  let t2 = Topology::NPU[0];

  spawn on(Topology::Current) {
    let mut x = 10;
  };

  comptime {
    assert(t == Topology::NPU[0]);
    assert(t2 == Topology::NPU[0]);
  }
}

fn check_top2() on Topology::GPU -> void {
  let t = if comptime true {
    Topology::Current
  } else {
    Topology::CPU
  };
  comptime {
    assert(t == Topology::GPU);
  }
}

fn main() -> i32 {
  spawn on(Topology::NPU[0]) {
    check_top();
  };
  spawn on(Topology::GPU) {
    check_top2();
  };
  return 0;
}
