// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @check_top() : () -> ()
// CHECK: call @check_top2() : () -> ()
// `if comptime` picks its branch while compiling, and the topology each branch names folds
// to the number for that topology: 500 for GPU, 100 for NPU[0].
//
// The `comptime` blocks that assert those topologies leave nothing behind, so no comparison
// is emitted for the program to make again. That is the part that changed -- each assert
// used to be spliced in as a constant and an `arith.cmpi`, after the compiler had already
// decided the answer. A false one stops the build, so no comparison reaching codegen does
// not mean the assert went unchecked.
// CHECK-LABEL: func.func @check_top2()
// CHECK: arith.constant 500 : i32
// CHECK-NOT: arith.cmpi
// CHECK: return
// CHECK-LABEL: func.func @check_top()
// CHECK: arith.constant 1 : i32
// CHECK: arith.constant 100 : i32
// CHECK-NOT: arith.cmpi
// CHECK: return
fn check_top() on Topology::NPU[0] -> void {
  // If comptime returns an expression
  let a = if comptime true {
    1
  } else {
    0
  };

  // Topology::Current should evaluate to NPU here
  let t = Topology::Current;
  let t2 = Topology::NPU[0];

  spawn on(Topology::Current) {
    let mut x = 10;
  };

  comptime {
    assert(t == Topology::NPU[0]);
    assert(t2 == Topology::NPU[0]);
  }
}

fn check_top2() on Topology::GPU -> void {
  let t = if comptime true {
    Topology::Current
  } else {
    Topology::CPU
  };
  comptime {
    assert(t == Topology::GPU);
  }
}

fn main() -> i32 {
  spawn on(Topology::NPU[0]) {
    check_top();
  };
  spawn on(Topology::GPU) {
    check_top2();
  };
  return 0;
}
