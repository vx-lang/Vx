//===----------------------------------------------------------------------===//
// A write through a mutable borrow reaches the array it borrows. This holds when the borrow
// is passed to a call, and when it is kept in a variable. Each assert checks a value after
// such a write.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32

fn touch(p : &mut Tensor<i64, [3]>) -> void {
  p[0] = 9i64;
}

fn fill(p : &mut Tensor<i64, [3]>, with : i64) -> void {
  for i in 0..3 {
    p[i] = with;
  }
  return;
}

fn main() -> i32 {
  comptime {
    // The write through the borrow lands on the caller's array.
    let mut a : Tensor<i64, [3]> = [ 1i64, 2i64, 3i64 ];
    touch(&mut a);
    assert(a[0] == 9i64, "the write through the borrow reached the caller's array");
    assert(a[1] == 2i64, "an element the callee did not write is unchanged");

    // A loop inside the callee writes through the borrow too.
    let mut b : Tensor<i64, [3]> = [ 0i64, 0i64, 0i64 ];
    fill(&mut b, 7i64);
    assert(b[0] == 7i64, "the callee's loop wrote the first element");
    assert(b[2] == 7i64, "the callee's loop wrote the last element");

    // A write through a borrow kept in a variable.
    let mut d : Tensor<i64, [3]> = [ 1i64, 2i64, 3i64 ];
    let r : &mut Tensor<i64, [3]> = &mut d;
    r[0] = 9i64;
    assert(d[0] == 9i64, "the write through `r` reached `d`");
    assert(d[1] == 2i64, "an element `r` did not write is unchanged");
  }
  return 0;
}
