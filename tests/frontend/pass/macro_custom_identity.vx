// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 42 : i32
// CHECK: return %[[V0]] : i32
import std::vec;
import std::closure;

macro_rules identity { ($x : expr) => {
    $x
  }; }
fn main() -> i32 {
  let a = identity!(42);
  return a;
}