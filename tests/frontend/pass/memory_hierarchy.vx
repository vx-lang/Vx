// A well-formed memory hierarchy: SMEM and TMEM are siblings inside HBM (peers within a
// device, not nested), each fits within its parent. Coherence accepts it.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

Memory Hbm {
  capacity: 192 GiB, bandwidth: 8 TB/s
}
Memory Smem {
  within: Memory::Hbm, capacity: 228 KiB, bandwidth: 128 B/cyc, managed: explicit
}
Memory Tmem {
  within: Memory::Hbm, capacity: 256 KiB, granule: 16 KiB, managed: explicit
}

fn main() -> i32 {
  return 0;
}

// CHECK: func.func @main
