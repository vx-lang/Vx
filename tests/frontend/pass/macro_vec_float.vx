// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vx_vec_grow(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::new$f32"() : () -> !llvm.struct<(ptr, i32, i32)>
// CHECK: call @ref$mut$Vec$f32$push$f32(%{{.*}}, %{{.*}}) : (!llvm.ptr, f32) -> i32
// CHECK: call @ref$mut$Vec$f32$push$f32(%{{.*}}, %{{.*}}) : (!llvm.ptr, f32) -> i32
// CHECK: call @ref$mut$Vec$f32$push$f32(%{{.*}}, %{{.*}}) : (!llvm.ptr, f32) -> i32
// CHECK-LABEL: func.func @ref$mut$Vec$f32$push$f32(%arg0: !llvm.ptr {llvm.noalias}, %arg1: f32) -> i32
// CHECK: call @vx_vec_grow(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, i64, i64) -> !llvm.ptr
import std::vec;
import std::closure;
fn main() -> i32 {
  let mut v = vec![ 1.0, 2.5, 3.14 ];
  return 0;
}