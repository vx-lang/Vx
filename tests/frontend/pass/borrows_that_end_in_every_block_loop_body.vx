// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// Each borrow rule in a `loop` body, with the borrow used before the code that would break the
// rule, so it has ended in time and the program is accepted. borrow_rule_*_in_every_block.vx
// has the same code with the borrow still in use.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

struct Holder {
  r : &i32,
}

fn pass_mut(r : &mut i32) -> &mut i32 {
  return r;
}

fn two_mutable_borrows_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let a = &mut x;
    *a = 3;
    let b = &mut x;
    *b = 2;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn two_mutable_borrows_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &mut x;
  *a = 3;
  loop {
    let b = &mut x;
    *b = 2;
    break;
  }
  return x + y;
}

fn mutable_borrow_while_shared_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let a = &x;
    y = *a;
    let b = &mut x;
    *b = 2;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn mutable_borrow_while_shared_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &x;
  y = *a;
  loop {
    let b = &mut x;
    *b = 2;
    break;
  }
  return x + y;
}

fn read_while_mutably_borrowed_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let a = &mut x;
    *a = 2;
    y = x;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn read_while_mutably_borrowed_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &mut x;
  *a = 2;
  loop {
    y = x;
    break;
  }
  return x + y;
}

fn assign_while_shared_borrow_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let a = &x;
    y = *a;
    x = 2;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn assign_while_shared_borrow_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &x;
  y = *a;
  loop {
    x = 2;
    break;
  }
  return x + y;
}

fn assign_while_mutable_borrow_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let a = &mut x;
    *a = 3;
    x = 2;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn assign_while_mutable_borrow_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &mut x;
  *a = 3;
  loop {
    x = 2;
    break;
  }
  return x + y;
}

fn read_while_a_returned_reference_is_in_use_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let a = pass_mut(&mut x);
    *a = 2;
    y = x;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn read_while_a_returned_reference_is_in_use_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = pass_mut(&mut x);
  *a = 2;
  loop {
    y = x;
    break;
  }
  return x + y;
}

fn assign_while_a_struct_holds_a_borrow_loop_body(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  loop {
    let h = Holder {
      r: &x
    };
    y = *h.r;
    x = 2;
    break;
  }
  return x + y;
}

// Borrowed before a `loop` body, used after it.
fn assign_while_a_struct_holds_a_borrow_loop_body_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let h = Holder {
    r: &x
  };
  y = *h.r;
  loop {
    x = 2;
    break;
  }
  return x + y;
}

fn main() -> i32 {
  return 0;
}
