// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 1 : i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
fn main() -> i32 {
  let mode = PadMode::Trim;
  return 0;
}

enum PadMode {
  Pad, Trim
}
