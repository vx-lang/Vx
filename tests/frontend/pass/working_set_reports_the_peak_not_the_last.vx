//===----------------------------------------------------------------------===//
// The half of the shadowing bug that no refusal would have caught.
//
// Both tiles fit, so nothing is refused either way and the verdict is the same
// before and after the fix. What was wrong was the number. The working set was
// keyed by the binding name, so the second placement overwrote the first, and a
// space holding 16 MiB and then 16 KiB reported 16 KiB -- the size of the last
// placement rather than the peak.
//
// The figure is not decoration. `--diagnostics-json` resident sets are what a
// consumer reads to compute the utilization an engine must be given, so a wrong
// one is a wrong input to something else rather than a missing warning.
//
// Two placements bound to one name never coexist: rebinding makes the first
// unreachable, and a tile is released once nothing can read it. So the peak here
// is the larger of them, 16777216 -- and the bug would have reported 16384, which
// is what makes this worth a test rather than an assertion about a refusal.
//
// `fills_the_space` is the other boundary: 4096*4096*4 is 67108864, exactly the
// declared capacity. The cumulative check refuses on `total > cap`, so a tile that
// fills a space to the byte is admitted and reports a utilization of 1.
//
// RUN: vxc %s --action emit-mlir -o /dev/null --diagnostics-json 2>/dev/null | FileCheck %s
// CHECK: "resident_sets"
// Exactly at capacity: admitted, and reported as full.
// CHECK: "space": "W"
// CHECK-SAME: "total_bytes": 67108864
// CHECK-SAME: "capacity_bytes": 67108864
// CHECK-SAME: "utilization": 1
// CHECK-SAME: "tiles": 1
// The larger of the two shadowed placements, not the size of the last one.
// CHECK: "space": "W"
// CHECK-SAME: "total_bytes": 16777216
// CHECK-SAME: "utilization": 0.25
// CHECK-SAME: "tiles": 1

Memory CPU_DRAM {}
Memory W {
  within: Memory::CPU_DRAM, capacity: 64 MiB, managed: explicit
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::W,
  visible: [Memory::W],
  transfer Memory::CPU_DRAM -> Memory::W : 10
}

// A single tile the exact size of the space it is placed in.
fn fills_the_space() -> i32 {
  let whole = Tensor<f32, [4096, 4096]>::uninit();
  let _w = transfer(whole, Memory::W);
  return 0;
}

fn main() -> i32 {
  let big = Tensor<f32, [2048, 2048]>::uninit();
  let s = transfer(big, Memory::W);
  let small = Tensor<f32, [64, 64]>::uninit();
  let s = transfer(small, Memory::W);
  return fills_the_space();
}
