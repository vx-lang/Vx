// RUN: vxc --package tests=tests %s --action emit-mlir 2>&1 | FileCheck %s # flat-codegen
// An iterator that hands out pointers one at a time. The enum `Option<*mut i8>` keeps its payload
// in an integer field, and its `Some` arm stores the pointer there.
// CHECK-LABEL: func.func @Words$Iterator$Words$ptr$mut$i8$next(%arg0: !llvm.struct<(i32, i32)>) -> !llvm.struct<(i32, i64)>
// CHECK: %[[P:.*]] = call @word(%{{.*}}) : (i32) -> !llvm.ptr
// The `Some` arm tags 0 and carries the pointer; the `None` arm tags 1 and carries nothing.
// CHECK: %[[TAG:.*]] = llvm.getelementptr %{{.*}}[0, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i64)>
// CHECK: llvm.store %c0_i32, %[[TAG]] : i32, !llvm.ptr
// CHECK: %[[PAY:.*]] = llvm.getelementptr %{{.*}}[0, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i64)>
// CHECK: llvm.store %[[P]], %[[PAY]] : !llvm.ptr, !llvm.ptr
// CHECK: llvm.store %c1_i32{{.*}}, %{{.*}} : i32, !llvm.ptr

import tests::modules::iter;

// The word at `_idx`. Each word is a null pointer, because the test checks only the code that
// puts a pointer in an `Option`.
fn word(_idx : i32) -> *mut i8 {
  return unsafe { 0 as *mut i8 };
}

struct Words {
  current : i32, count : i32,
}

impl Iterator<Words, *mut i8> for Words {
  fn next(mut self : Words) -> Option<*mut i8> {
    if self.current < self.count {
      let val : *mut i8 = word(self.current);
      self.current = self.current + 1;
      return Option<*mut i8>::Some(val);
    }
    return Option<*mut i8>::None;
  }
}

fn main() -> i32 {
  let it = Words {
    current : 0, count : 2
  };
  let _first = it.next();
  return 0;
}
