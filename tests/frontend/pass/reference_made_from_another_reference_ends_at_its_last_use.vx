//===----------------------------------------------------------------------===//
// A reference made from another reference keeps the borrow only until its last use. Each
// function writes the variable after that use, so the program is accepted.

struct S {
  x : i32,
}

struct H {
  r : &i32,
}

struct M {
  r : &mut S,
}

fn bump(p : &mut S) -> void {
  p.x = p.x + 1;
}

fn field_through_a_shared_reference() -> void {
  let mut v = S {
    x : 1
  };
  let t = &v;
  let x = &t.x;
  print(*x);
  v = S {
    x : 2
  };
  print(v.x);
}

fn mut_reference_copied_by_let() -> void {
  let mut s = S {
    x : 1
  };
  let a = &mut s;
  let b = a;
  b.x = 2;
  a.x = 5;
  print(a.x);
}

fn mut_reference_copied_into_a_struct() -> void {
  let mut s = S {
    x : 1
  };
  let a = &mut s;
  let mut m = M {
    r : a
  };
  m.r.x = 2;
  a.x = 5;
  print(a.x);
}

fn mut_reference_given_to_two_calls() -> void {
  let mut s = S {
    x : 1
  };
  let a = &mut s;
  bump(a);
  bump(a);
  print(a.x);
}

fn reference_copied_out_of_a_field() -> void {
  let mut x = 1;
  let h = H {
    r : &x
  };
  let w = h.r;
  print(*w);
  x = 2;
  print(x);
}

fn main() -> i32 {
  field_through_a_shared_reference();
  mut_reference_copied_by_let();
  mut_reference_copied_into_a_struct();
  mut_reference_given_to_two_calls();
  reference_copied_out_of_a_field();
  return 0;
}
