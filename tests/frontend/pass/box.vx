// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-DAG: func.func private @free(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Box::new$i32"(%{{.*}}) : (i32) -> !llvm.struct<(ptr)>
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
// CHECK: call @Box$i32$free$i32(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK-LABEL: func.func @Box$i32$free$i32(%arg0: !llvm.ptr {llvm.noalias}) -> i32
// CHECK: call @free(%{{.*}}) : (!llvm.ptr) -> i32

import std::box;
import std::io;

fn main() -> i32 {
  let mut b = Box<i32>::new (42);

  unsafe { print!("Value: "); print!(*b.ptr); }

  unsafe { *b.ptr = 100; }

  unsafe { print!("Updated: "); print!(*b.ptr); }

  b.free();
  return 0;
}

// EXPECT: Value: 42
// EXPECT: Updated: 100
