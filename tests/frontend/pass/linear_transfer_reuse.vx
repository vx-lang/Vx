// See LICENSE for license information.
// SPDX-License-Identifier: BSD-3-Clause
//
//===----------------------------------------------------------------------===//
// transfer() does NOT consume the source variable (the Vx transfer model
// uses non-destructive copy semantics at the sema level — the DMA copies
// data to the destination memory space). The source remains accessible
// in its original memory space.
//===----------------------------------------------------------------------===//

fn main() -> i32 {
  let t : Tensor<f32> = 1.0;

  // Transfer a copy to NPU_HBM
  let npu_t = transfer(t, Memory::NPU_HBM);

  // Source tensor remains valid and accessible on CPU
  let reused = t;

  return 0;
}
