// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
fn parser_logical_pass() -> bool {
  let a = 1;
  let b = 2;
  let c = a < b;
  let d = a == b;
  let e = c && d;
  let f = c || !d;
  return f;
}
