// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vx_vec_grow(
// CHECK-DAG: func.func private @vx_vec_bounds_check(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<(ptr, i32, i32)>
// CHECK: %[[V0:.*]] = call @get_val(%{{.*}}) : (i32) -> i32
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %[[V0]]) : (!llvm.ptr, i32) -> i32
// CHECK: %[[V1:.*]] = call @get_val(%{{.*}}) : (i32) -> i32
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %[[V1]]) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK-LABEL: func.func @ref$mut$Vec$i32$push$i32(%arg0: !llvm.ptr {llvm.noalias}, %arg1: i32) -> i32
// CHECK: call @vx_vec_grow(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, i64, i64) -> !llvm.ptr
// CHECK-LABEL: func.func @get_val(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.constant 2 : i32
// CHECK: %[[V1:.*]] = arith.muli %{{.*}}, %[[V0]] : i32
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @Vec$i32$get$i32(%arg0: !llvm.ptr {llvm.readonly}, %arg1: i32) -> i32
// CHECK: call @vx_vec_bounds_check(%{{.*}}, %{{.*}}) : (i64, i64) -> i32
import std::vec;

fn get_val(x : i32) -> i32 {
  return x * 2;
}

fn main() -> i32 {
  let mut v : Vec<i32> = vec![ get_val(10), get_val(20) ];
  assert(v.len == 2);
  assert(v[0] == 20);
  assert(v[1] == 40);
  return 0;
}