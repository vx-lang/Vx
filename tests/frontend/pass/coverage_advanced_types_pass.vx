//===- coverage_advanced_types_pass.vx ------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

enum MyEnum {
  VariantA,
  VariantB,
}

struct TestStruct {
  a : <4 x f32>, b : Pinned<f32, Topology::AccCore[0]>,
}

fn test_for_loop() -> i64 {
  let mut sum : i64 = 0i64;
  for i in 0i64..10i64 {
    sum = sum + i;
  }
  return sum;
}

fn test_enum_variant() -> MyEnum {
  let e = MyEnum::VariantA;
  return e;
}

fn main() -> i32 {
  let a : i64 = test_for_loop();
  let b = test_enum_variant();
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @test_for_loop() : () -> i64
// CHECK: call @test_enum_variant() : () -> i32
// CHECK-LABEL: func.func @test_for_loop() -> i64
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : i64
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @test_enum_variant() -> i32
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: return %[[V0]] : i32
