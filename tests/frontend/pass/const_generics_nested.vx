// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

// N reaches both the outer struct and the Array it wraps, and stays available as a value
// inside the body. On the flat path each instance's layout is synthesized, the inner one
// embedded by value in the outer's `!llvm.struct`. The symbol spells its const argument as
// a Debug-printed AST (Vx#408), so match past it.
// CHECK-LABEL: func.func @test_nested_const_generics()
// CHECK: call @create_wrapper$const${{.*}}() : () -> !llvm.struct<(struct<(f32)>)>
// CHECK-LABEL: func.func @create_wrapper$const${{.*}}() -> !llvm.struct<(struct<(f32)>)>
// CHECK: %[[A:.*]] = llvm.alloca %{{.*}} x !llvm.struct<(f32)> : (i32) -> !llvm.ptr
// CHECK: %[[W:.*]] = llvm.alloca %{{.*}} x !llvm.struct<(struct<(f32)>)> : (i32) -> !llvm.ptr
// CHECK: %[[AV:.*]] = llvm.load %[[A]] : !llvm.ptr -> !llvm.struct<(f32)>
// CHECK: %[[F:.*]] = llvm.getelementptr %[[W]][0, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(struct<(f32)>)>
// CHECK: llvm.store %[[AV]], %[[F]] : !llvm.struct<(f32)>, !llvm.ptr
// CHECK: arith.addi %{{.*}}, %{{.*}} : i32
// CHECK: %[[WV:.*]] = llvm.load %[[W]] : !llvm.ptr -> !llvm.struct<(struct<(f32)>)>
// CHECK: return %[[WV]] : !llvm.struct<(struct<(f32)>)>

struct Array<T, const N : i32> {
  val : T
}

struct Wrapper<const N : i32> {
  inner : Array<f32, N>
}

fn create_wrapper<const N : i32>()
->Wrapper<N> {
  let a = Array<f32, N> {
    val : 1.0
  };
  let w = Wrapper<N> {
    inner : a
  };

  // Verify N evaluates properly in nested context
  let double_n = N + N;

  return w;
}

fn test_nested_const_generics() -> void {
  let w = create_wrapper<10>();
  assert(true);
}
