// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @Box$get(%{{.*}}) : (!llvm.struct<(i32)>) -> i32
// CHECK-LABEL: func.func @Box$get(%arg0: !llvm.struct<(i32)>) -> i32
// CHECK: %[[V0:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: llvm.alloca %[[V0]] x !llvm.struct<(i32)> : (i32) -> !llvm.ptr
// CHECK: %[[V1:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32)>
// CHECK: %[[V2:.*]] = llvm.load %[[V1]] : !llvm.ptr -> i32
// CHECK: return %[[V2]] : i32
import std::vec;
import std::closure;

struct Box {
  val : i32
} impl Box {
  fn get(self : Box) -> i32 {
    return self.val;
  }
}
macro_rules get_val { ($obj : expr) => {
    $obj.get()
  }; }
fn main() -> i32 {
  let b = Box {
    val : 100
  };
  let v = get_val!(b);
  return v;
}