//===----------------------------------------------------------------------===//
// Byte buffers while compiling. Inside a `comptime` block a string literal is a buffer that
// can be read and written through a pointer, every copy of the pointer sees the same bytes,
// and a pointer result becomes a string constant in the program.
//
// RUN: vxc %s 2>&1 | FileCheck %s
// CHECK: read=98; high_byte=-61; alias=Ay; callee=By; fresh=q; min=-9223372036854775808; max=9223372036854775807;
import core::num;

fn put(p : *mut i8, c : i8) -> i64 {
  unsafe { p[0i64] = c; }
  return 0i64;
}

fn fresh() -> *mut i8 {
  return "q" as *mut i8;
}

fn show(name : *const i8, s : *const i8) -> i32 {
  print!(name);
  print!("=");
  print!(s);
  print!("; ");
  return 0;
}

fn main() -> i32 {
  let read = comptime {
    let s : *const i8 = "abc";
    unsafe { s[1i64] as i64 }
  };
  print!("read=");
  print(read);
  print!("; ");
  // The first byte of the UTF-8 for `é` is 0xC3, which an `i8` reads as -61.
  let high = comptime {
    let s : *const i8 = "é";
    unsafe { s[0i64] as i64 }
  };
  print!("high_byte=");
  print(high);
  print!("; ");

  let alias = comptime {
    let a = "xy" as *mut i8;
    let b = a;
    unsafe { b[0i64] = 65i8; }
    a as *const i8
  };
  show("alias", alias);

  let callee = comptime {
    let a = "xy" as *mut i8;
    put(a, 66i8);
    a as *const i8
  };
  show("callee", callee);

  let separate = comptime {
    let a = fresh();
    let b = fresh();
    unsafe { a[0i64] = 66i8; }
    b as *const i8
  };
  show("fresh", separate);

  let min = comptime {
    let v : i64 = -9223372036854775807i64 - 1i64;
    let buf = "                    " as *mut i8;
    unsafe { buf[v.write_decimal(buf, 0i64)] = 0i8; }
    buf as *const i8
  };
  show("min", min);
  let max = comptime {
    let v : i64 = 9223372036854775807i64;
    let buf = "                    " as *mut i8;
    unsafe { buf[v.write_decimal(buf, 0i64)] = 0i8; }
    buf as *const i8
  };
  show("max", max);
  return 0;
}
