// RUN: mkdir -p %t.d
// RUN: printf 'Memory Pad {\n  capacity: 1 MiB, bandwidth: 2 TB/s, managed: explicit, scope: device\n}\n' > %t.d/machine.vx
// RUN: vxc --machine %t.d/machine.vx %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// The program declares the memory space `Pad` in the same words as its machine file. Two
// declarations that say the same thing are one declaration, even in two files.
// CHECK: 7

Memory Pad {
  capacity: 1 MiB, bandwidth: 2 TB/s, managed: explicit, scope: device
}

fn main() -> i32 {
  print(7);
  return 0;
}
