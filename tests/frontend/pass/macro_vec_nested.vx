// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vx_vec_grow(
// CHECK-DAG: func.func private @vx_vec_bounds_check(
// CHECK-LABEL: func.func @ref$mut$Vec$i32$push$i32(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: call @vx_vec_grow(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, i64, i64) -> !llvm.ptr
// CHECK-LABEL: func.func @ref$mut$Vec$Vec$i32$push$Vec$i32(%arg0: !llvm.ptr, %arg1: !llvm.struct<"Vec_i32", (ptr, i32, i32)>) -> i32
// CHECK: call @vx_vec_grow(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, i64, i64) -> !llvm.ptr
// CHECK-LABEL: func.func @Vec$Vec$i32$get$Vec$i32(%arg0: !llvm.ptr, %arg1: i32) -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @vx_vec_bounds_check(%{{.*}}, %{{.*}}) : (i64, i64) -> i32
// CHECK-LABEL: func.func @Vec$i32$get$i32(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: call @vx_vec_bounds_check(%{{.*}}, %{{.*}}) : (i64, i64) -> i32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::new$Vec$i32"() : () -> !llvm.struct<"Vec_llvm_struct_Vec_i32___ptr__i32__i32__", (ptr, i32, i32)>
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @ref$mut$Vec$Vec$i32$push$Vec$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.struct<"Vec_i32", (ptr, i32, i32)>) -> i32
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @ref$mut$Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @ref$mut$Vec$Vec$i32$push$Vec$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.struct<"Vec_i32", (ptr, i32, i32)>) -> i32
// CHECK: call @Vec$Vec$i32$get$Vec$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
import std::vec;

fn main() -> i32 {
  let mut v : Vec<Vec<i32>> = vec![ vec![ 1, 2 ], vec![ 3, 4 ] ];
  assert(v.len == 2);
  assert(v[0][0] == 1);
  assert(v[0][1] == 2);
  assert(v[1][0] == 3);
  assert(v[1][1] == 4);
  return 0;
}
