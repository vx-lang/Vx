// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A `reshape` of a placed tensor is a view of the same buffer, so the capacity check counts
// one 64 MiB tile in a 100 MiB space, not two.
//
// CHECK-NOT: E6010
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 100 MiB, bandwidth: 300 GB/s, managed: cached, scope: device
}

fn fill<const R : i32, const C : i32>(t : &mut Tensor<f32, [R, C], Memory::GPU_HBM>) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      for c in 0..C {
        t[r][c] = 1.0;
      }
    }
  }
  return;
}

fn main() -> i32 {
  let h = Tensor<f32, [4096, 4096]>::new();
  let mut t = transfer(h, Memory::GPU_HBM);
  let mut v = t.reshape([16384, 1024]);
  fill<16384, 1024>(&mut v);
  return 0;
}
