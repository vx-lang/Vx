// RUN: vxc %s --action print-ast 2>&1 | FileCheck %s
//
// `Transfer<A, B>` is a compile-time boolean -- true iff a transfer path exists in the
// cost graph -- usable as a `if comptime` condition. The false branch is pruned before
// type-checking, so an otherwise-undefined call inside it is never resolved: this file
// only type-checks because the second `if comptime` is statically false and dropped.

Topology Island {
  memory: Memory::IslandRAM
}

fn main() -> i32 {
  // True: a GPU -> CPU transfer path exists, so this branch is kept and checked.
  if comptime Transfer<Topology::GPU, Topology::CPU> {
    let ok = 1;
  }

  // False: IslandRAM is unreachable, so GPU -> Island has no path. The branch (with an
  // undefined call) is statically pruned -- no "undefined function" error.
  if comptime Transfer<Topology::GPU, Topology::Island> {
    let bad = undefined_pruned_away();
  }

  return 0;
}

// CHECK: Function: main
