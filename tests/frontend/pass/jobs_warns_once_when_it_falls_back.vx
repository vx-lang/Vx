// A program that both warns and falls back. Two frontends check it -- the parallel one, which
// declines, and the sequential one, which compiles it -- and a warning the programmer wrote once
// must be reported once. The parallel frontend used to print its warnings as it found them, so
// every warning in a declining program appeared twice.
//
// The match over an i64 puts it outside the flat subset. The unused binding produces the warning.
//
// This test checks the fallback, so it unsets VX_NO_AST_FALLBACK, which the test runner sets.
// RUN: (env -u VX_NO_AST_FALLBACK vxc -j 2 --emit-mlir %s 2>&1; echo "exit=$?") | FileCheck %s

fn seven_or_nine(n : i64) -> i32 {
  return match n {
    0i64 => {
      7
    }
    _ => {
      9
    }
  };
}

fn main() -> i32 {
  let unused_here = 5;
  return seven_or_nine(0i64);
}

// Reported once. The sequential driver is what prints it on this path -- it re-checks the whole
// program -- so the claim here is only that the parallel frontend did not print it as well.
// Whether the parallel frontend prints the warnings it holds is a different program's to state,
// because this one never uses that frontend's output: see
// `jobs_warns_on_the_path_it_took.vx`.
// CHECK: W1001
// CHECK-NOT: W1001
// The fallback still compiled the program, so the warning was not silenced by dropping it.
// CHECK: func.func @main
// CHECK: exit=0
