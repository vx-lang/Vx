// Test: Nested spawn blocks switching topology contexts.

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);

  // Outer: NPU context can access NPU HBM
  spawn on(Topology::NPU[0]) {
    // CHECK-NOT: error
    let local = t_npu;

    // Inner: Host context can access host DRAM
    // Note: The inner spawn switches back to CPU context
    spawn on(Topology::CPU) {
      let cpu_val : i32 = 42;
    }
  }

  return 0;
}

// CHECK: module
