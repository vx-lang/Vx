// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = arith.constant 21 : i32
// CHECK: %[[V1:.*]] = arith.constant 2 : i32
// CHECK: %[[V2:.*]] = arith.muli %[[V0]], %[[V1]] : i32
// CHECK: return %[[V2]] : i32
import std::vec;
import std::closure;

macro_rules double { ($x : expr) => {
    $x * 2
  }; }
fn main() -> i32 {
  let a = double!(21);
  return a;
}