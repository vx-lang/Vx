// Precision (#269): a sound closure-return whose result derives from a reference parameter must
// type-check. `|q: &Map| &q.slot` returns a reference into `*q`, and `f(m)` roots that in the
// caller-owned `m`, so nothing escapes. The return-escape rule used to reject this because the
// synthetic closure-env argument (a local) poisoned the provenance join; it now consults the
// closure's own return summary and sees the result derives from a real parameter, not the env.
// (Codegen for this shape works and is covered by tests/middle_end/pass/closure_return_ref.vx.)
struct Map {
  slot : i32, present : i32
}
fn good(m : &Map) -> &i32 {
  let f = |q : &Map| &q.slot;
  return f(m);
}
fn main() -> i32 {
  let x = Map {
    slot : 7, present : 1
  };
  return *good(&x);
}
