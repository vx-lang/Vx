//===----------------------------------------------------------------------===//
// Reading and writing one element of a fixed-size array during compilation.
//
// What this file asserts is that the compiler accepts these values: a comptime assert the
// evaluator finds false stops the build, so a wrong element value here is a build failure.
// It cannot tell an evaluated assert from one the evaluator gave up on, because both
// compile. The matching fail fixtures are the other half of the claim:
// fail/comptime_array_element.vx pins the read and fail/comptime_array_stale_read.vx pins
// the write, and neither can pass unless the evaluator holds the value.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32

fn main() -> i32 {
  comptime {
    let a : Tensor<i64, [3]> = [ 3i64, 1i64, 2i64 ];
    assert(a[0] == 3, "first element");
    assert(a[1] == 1, "second element");
    assert(a[2] == 2, "third element");

    let mut b : Tensor<i64, [3]> = [ 3i64, 1i64, 2i64 ];
    b[0] = 9i64;
    assert(b[0] == 9, "the write landed");
    assert(b[1] == 1, "a write leaves the other elements alone");
    assert(b[2] == 2, "a write leaves the other elements alone");
  }
  return 0;
}
