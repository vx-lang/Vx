//===----------------------------------------------------------------------===//
// A rank-1 tensor with a run-time extent, expressible for the first time:
// `Tensor<f32, [?]>`. The rank is the length of the list, so the parameter
// lowers to `memref<?xf32>` and nothing in the module assumes rank 2.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @total(
// CHECK-SAME: memref<?xf32>
// CHECK: memref.dim
// CHECK-LABEL: func.func @build(
// CHECK: memref.alloc(%{{.*}}) : memref<?xf32>
// CHECK-NOT: memref<?x?xf32>

// Not `sum`: the AST path dispatches a call by that name as its slice reduction.
fn total(t : Tensor<f32, [?]>) -> f32 {
  let mut s = 0.0;
  for i in 0..t.extent(0) {
    s = s + t[i];
  }
  return s;
}

// The extent is a parameter, so nothing folds it: this is a run-time shape.
fn build(n : i32) -> Tensor<f32, [?]> {
  let mut a = Tensor<f32>([n]);
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  return a;
}

fn main() -> i32 {
  let a = build(3);
  if total(a) as i32 == 6 {
    return 0;
  }
  return 1;
}
