// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// Each borrow rule in an `unsafe` block, with the borrow used before the code that would break
// the rule, so it has ended in time and the program is accepted.
// borrow_rule_*_in_every_block.vx has the same code with the borrow still in use.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

struct Holder {
  r : &i32,
}

fn pass_mut(r : &mut i32) -> &mut i32 {
  return r;
}

fn two_mutable_borrows_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let a = &mut x; *a = 3; let b = &mut x; *b = 2; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn two_mutable_borrows_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &mut x;
  *a = 3;
  unsafe { let b = &mut x; *b = 2; }
  return x + y;
}

fn mutable_borrow_while_shared_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let a = &x; y = *a; let b = &mut x; *b = 2; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn mutable_borrow_while_shared_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &x;
  y = *a;
  unsafe { let b = &mut x; *b = 2; }
  return x + y;
}

fn read_while_mutably_borrowed_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let a = &mut x; *a = 2; y = x; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn read_while_mutably_borrowed_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &mut x;
  *a = 2;
  unsafe { y = x; }
  return x + y;
}

fn assign_while_shared_borrow_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let a = &x; y = *a; x = 2; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn assign_while_shared_borrow_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &x;
  y = *a;
  unsafe { x = 2; }
  return x + y;
}

fn assign_while_mutable_borrow_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let a = &mut x; *a = 3; x = 2; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn assign_while_mutable_borrow_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = &mut x;
  *a = 3;
  unsafe { x = 2; }
  return x + y;
}

fn read_while_a_returned_reference_is_in_use_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let a = pass_mut(&mut x); *a = 2; y = x; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn read_while_a_returned_reference_is_in_use_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let a = pass_mut(&mut x);
  *a = 2;
  unsafe { y = x; }
  return x + y;
}

fn assign_while_a_struct_holds_a_borrow_unsafe_block(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  unsafe { let h = Holder { r: &x }; y = *h.r; x = 2; }
  return x + y;
}

// Borrowed before an `unsafe` block, used after it.
fn assign_while_a_struct_holds_a_borrow_unsafe_block_borrowed_outside(k : i32) -> i32 {
  let mut x = 1;
  let mut y = 0;
  let h = Holder {
    r: &x
  };
  y = *h.r;
  unsafe { x = 2; }
  return x + y;
}

fn main() -> i32 {
  return 0;
}
