// RUN: vxc %s --action emit-mlir
// XFAIL: *
//
// The IR assertion this file used to carry could not run: the program does not compile on
// the default path -- a multi-payload variant binding panics the AST lowering (Vx#398,
// Vx#233). The XFAIL above reports the day that changes, and the assertions go back.
enum Result {
  Ok(i32, f32),
  Err,
}

fn test_loop_nested() -> i32 {
  let mut i = 0;
  let mut sum = 0;
  loop {
    if i >= 5 {
      break;
    }
    let mut j = 0;
    loop {
      if j >= 5 {
        break;
      }
      sum += 1;
      j += 1;
    }
    i += 1;
  }
  return sum; // Should be 25
}

fn test_match_multi_payload() -> f32 {
  let r = Result::Ok(10, 2.5);
  let mut out = 0.0;
  match r {
    Result::Ok(a, b) => {
      out = b;
    }
    , Result::Err => {
      out = 0.0 - 1.0;
    }
  }
  return out; // Should be 2.5
}

fn test_match_no_braces() -> i32 {
  let x = 1;
  let mut out = 0;
  match x {
    1 => out = 10;
    , _ => out = 20;
    ,
  }
  return out; // Should be 10
}

fn test_match_string() -> i32 {
  let s = "hello";
  let mut out = 0;
  match s {
    "hello" => {
      out = 1;
    }
    , _ => {
      out = 2;
    }
  }
  return out; // Should be 1
}

fn main() -> i32 {
  let a = test_loop_nested();
  let b = test_match_no_braces();
  let c = test_match_string();

  // 25 + 10 + 1 = 36
  return a + b + c;
}
