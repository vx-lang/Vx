// Nested loops, a match on a variant with two payloads, a match whose arms have no braces, and
// a match on a string. Each function returns the answer its comment gives.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}25 10 1 2.5{{$}}
enum Result {
  Ok(i32, f32),
  Err,
}

fn test_loop_nested() -> i32 {
  let mut i = 0;
  let mut sum = 0;
  loop {
    if i >= 5 {
      break;
    }
    let mut j = 0;
    loop {
      if j >= 5 {
        break;
      }
      sum += 1;
      j += 1;
    }
    i += 1;
  }
  return sum; // Should be 25
}

fn test_match_multi_payload() -> f32 {
  let r = Result::Ok(10, 2.5);
  let mut out = 0.0;
  match r {
    Result::Ok(a, b) => {
      out = b;
    }
    , Result::Err => {
      out = 0.0 - 1.0;
    }
  }
  return out; // Should be 2.5
}

fn test_match_no_braces() -> i32 {
  let x = 1;
  let mut out = 0;
  match x {
    1 => out = 10;
    , _ => out = 20;
    ,
  }
  return out; // Should be 10
}

fn test_match_string() -> i32 {
  let s = "hello";
  let mut out = 0;
  match s {
    "hello" => {
      out = 1;
    }
    , _ => {
      out = 2;
    }
  }
  return out; // Should be 1
}

fn main() -> i32 {
  let a = test_loop_nested();
  let b = test_match_no_braces();
  let c = test_match_string();

  let d = test_match_multi_payload();
  println!("{} {} {} {}", a, b, c, d);
  return 0;
}
