// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// An inline MLIR block inside a generic impl. The block is source text, so the const generics
// are substituted word by word -- and the wrapper's signature has to get the same treatment as
// its body, or the two disagree about the shape they name (Vx#414).
// CHECK-LABEL: func.func private @vx_macro_mlir_L{{[0-9]+}}_C{{[0-9]+}}_0(%arg0: memref<2x2xf32>, %arg1: memref<2x2xf32>) -> i1
// CHECK: %[[ACC:.*]] = memref.alloca() : memref<i1>
// CHECK: linalg.generic {{.*}} ins(%arg0, %arg1 : memref<2x2xf32>, memref<2x2xf32>) outs(%[[ACC]] : memref<i1>)
// CHECK: arith.cmpf oeq
// CHECK: linalg.yield
// The instantiated method calls the wrapper the block was lifted into.
// CHECK-LABEL: func.func @Tensor$f32$2x2$compare$2$2$f32(%arg0: memref<2x2xf32>, %arg1: memref<2x2xf32>) -> i1
// CHECK: call @vx_macro_mlir_L{{[0-9]+}}_C{{[0-9]+}}_0(%arg0, %arg1) : (memref<2x2xf32>, memref<2x2xf32>) -> i1
impl<T : Float, const N : i32, const M : i32> Tensor<T, [N, M]> {
  fn compare(self : Tensor<T, [N, M]>, other : Tensor<T, [N, M]>) -> bool {
    let res = mlir!(inputs : (%lhs = self : memref<N x M x f32>,
    %rhs = other : memref<N x M x f32>),
    clobbers : [],
    returns : bool,
    dialects : ["linalg", "arith", "memref", "func"]) {
      %true = arith.constant 1 : i1
      %acc = memref.alloca() : memref<i1>
      memref.store %true, %acc[] : memref<i1>
      linalg.generic {indexing_maps = [affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> ()>],
        iterator_types = ["reduction", "reduction"]}
      ins(%lhs, %rhs : memref<N x M x f32>, memref<N x M x f32>)
      outs(%acc : memref<i1>) {
        ^bb0(%a : f32, %b : f32, %out : i1):
        %cmp = arith.cmpf oeq, %a, %b : f32
        %and = arith.andi %out, %cmp : i1
        linalg.yield %and : i1
      }
      %val = memref.load %acc[] : memref<i1>
      func.return %val : i1
    };
    return res;
  }
}

fn main() -> i32 {
  let mut a : Tensor<f32, [2, 2]> = Tensor<f32, [2, 2]>::uninit();
  let mut b : Tensor<f32, [2, 2]> = Tensor<f32, [2, 2]>::uninit();
  for i in 0..2 {
    for j in 0..2 {
      a[i][j] = ((i + j) as f32);
      b[i][j] = ((i + j) as f32);
    }
  }
  let _same = a.compare(b);
  return 0;
}
