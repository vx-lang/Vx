//===----------------------------------------------------------------------===//
// An integer computation that overflows has no compile-time value.
//
// The alternative is a wrapped value, which would be folded into the program as though
// the compiler had worked something out, and nothing would say otherwise.
//
// The two asserts contradict each other, so this file only compiles while the evaluator
// has no value for `over`. Their messages differ so a failure says which way it broke.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32

fn main() -> i32 {
  comptime {
    let big : i64 = 9223372036854775807i64;
    let over : i64 = big + 1;
    assert(over == 0, "the overflow produced a value, and it was not zero");
    assert(over != 0, "the overflow produced zero, most likely a wrapped value");
  }
  return 0;
}
