// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 10 : i32
// CHECK: arith.constant 20 : i32
// CHECK: arith.constant 30 : i32
// CHECK: memref.alloc() : memref<3xi32>
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: arith.index_cast %[[V0]] : i32 to index
// CHECK: %[[V1:.*]] = arith.constant 1 : i32
// CHECK: arith.index_cast %[[V1]] : i32 to index
// CHECK: %[[V2:.*]] = arith.constant 2 : i32
// CHECK: arith.index_cast %[[V2]] : i32 to index
// CHECK: %[[V3:.*]] = arith.constant 0 : i32
// CHECK: arith.index_cast %[[V3]] : i32 to index
// CHECK: %[[V4:.*]] = memref.load %{{.*}} : memref<3xi32>
// CHECK: return %[[V4]] : i32
import std::vec;
import std::closure;

macro_rules first { ($arr : expr) => {
    $arr[0]
  }; }
fn main() -> i32 {
  let arr = [ 10, 20, 30 ];
  let f = first!(arr);
  return f;
}