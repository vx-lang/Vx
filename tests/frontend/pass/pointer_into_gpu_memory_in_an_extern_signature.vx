//===----------------------------------------------------------------------===//
// A raw pointer can say which memory it points into: `*mut f32 in Memory::GPU_HBM`
// is a pointer to floats that live in GPU memory. A C library such as cuBLAS takes
// its device buffers as plain `float *`, so at the C boundary the pointer is an
// ordinary pointer, and the placement only tells the type checker where a load
// through it would read.
//
// The pointer written with the device instead of the space names the same type,
// and a pointer that says it points into host memory is the same type as a bare
// pointer. Both are passed below where the other spelling is expected.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vendor_scale(!llvm.ptr, !llvm.ptr, i32) -> i32
// CHECK-LABEL: func.func @scale_on_device(%arg0: !llvm.ptr, %arg1: !llvm.ptr, %arg2: i32) -> i32
// CHECK: call @vendor_scale(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, i32) -> i32

extern "C" {
  fn vendor_scale(data : *mut f32 in Memory::GPU_HBM, alpha : *const f32, n : i32) -> i32;
}

fn scale_on_device(data : *mut f32 in Topology::GPU, alpha : *const f32 in Memory::CPU_DRAM, n : i32) -> i32 {
  let r = unsafe { vendor_scale(data, alpha, n) };
  return r;
}

fn main() -> i32 {
  return 0;
}
