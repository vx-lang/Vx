// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A reference returned from a call given `m`, where `m` borrows `x`, keeps `x` borrowed only
// until its last use. A call that returns a number keeps nothing borrowed.
//
// CHECK-NOT: Error
// CHECK-LABEL: func.func @main

struct S {
  v : i64,
}

impl S {
  fn get_mut(self : &mut S) -> &mut i64 {
    return &mut self.v;
  }

  fn bump(self : &mut S) -> i64 {
    self.v = self.v + 1;
    return self.v;
  }
}

fn keep(m : &mut i64) -> &mut i64 {
  return m;
}

fn bump(m : &mut i64) -> i64 {
  *m = *m + 1i64;
  return *m;
}

fn result_last_used_before_the_assignment() -> i64 {
  let mut x = 1i64;
  let m = &mut x;
  let r = keep(m);
  *r = 7i64;
  x = x + 1i64;
  return x;
}

fn call_that_returns_a_number() -> i64 {
  let mut x = 1i64;
  let m = &mut x;
  let n = bump(m);
  x = x + 1i64;
  return x + n;
}

fn method_result_last_used_before_the_assignment() -> i64 {
  let mut s = S {
    v : 1
  };
  let m = &mut s;
  let r = m.get_mut();
  *r = 7;
  s.v = s.v + 1;
  return s.v;
}

fn method_that_returns_a_number() -> i64 {
  let mut s = S {
    v : 1
  };
  let m = &mut s;
  let n = m.bump();
  s.v = s.v + 1;
  return s.v + n;
}

fn main() -> i32 {
  print(result_last_used_before_the_assignment());
  print(call_that_returns_a_number());
  print(method_result_last_used_before_the_assignment());
  print(method_that_returns_a_number());
  return 0;
}
