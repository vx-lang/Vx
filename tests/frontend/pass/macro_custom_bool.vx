// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[C0:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
import std::vec;
import std::closure;

macro_rules is_equal { ($x : expr) => {
    $x == 10
  }; }
fn main() -> i32 {
  let b = is_equal!(10);
  if b {
    return 1;
  }
  return 0;
}