// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
//
// `let mut x = e` and `x = e` give the prover the fact `x == e`. A fact about the old value of `x`
// stays true after `x` changes. In `x = x + 1`, the `x` on the right is the old value.

// `y == x` is about the old value of `x`, which is 3.
fn from_a_let_mut() -> i32
ensures return == 3 {
  let mut x : i32 = 3;
  let y : i32 = x;
  x = 0;
  return y + x;
}

fn from_an_assignment() -> i32
ensures return == 5 {
  let mut x : i32 = 0;
  x = 5;
  return x;
}

// `x > 0` is a fact about the old value, which is less than 100, so `x + 1` does not wrap.
fn add_one(y : i32) -> i32
requires y > 0 && y < 100
ensures return > 1 {
  let mut x : i32 = y;
  x = x + 1;
  return x;
}

fn two_changes() -> i32
ensures return == 8 {
  let mut x : i32 = 3;
  x = x + 1;
  x = x * 2;
  return x;
}

fn add_in_place() -> i32
ensures return == 7 {
  let mut x : i32 = 3;
  x += 4;
  return x;
}

// The invariant holds when the loop starts, from `i == 0`.
fn count_to_three() -> i32 {
  let mut i : i32 = 0;
  loop invariant(i >= 0) {
    if i >= 3 {
      break;
    }
    i = i + 1;
  }
  return i;
}

fn main() -> i32 {
  // CHECK: 3 5 6 8 7 3
  println!("{} {} {} {} {} {}", from_a_let_mut(), from_an_assignment(), add_one(5), two_changes(), add_in_place(), count_to_three());
  return 0;
}
