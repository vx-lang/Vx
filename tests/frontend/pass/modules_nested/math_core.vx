// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
fn multiply(a : f32, b : f32) -> f32 {
  return a * b;
}

fn subtract(a : f32, b : f32) -> f32 {
  return a - b;
}

