// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// A nested module's functions are emitted under their own names.
// CHECK-DAG: arith.subf
// CHECK-DAG: arith.mulf
fn multiply(a : f32, b : f32) -> f32 {
  return a * b;
}

fn subtract(a : f32, b : f32) -> f32 {
  return a - b;
}
