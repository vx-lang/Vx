// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vx_macro_mlir_L0_C0_0(
// CHECK-DAG: func.func private @vx_macro_mlir_L0_C0_1(
// CHECK-DAG: func.func private @vx_macro_mlir_L0_C0_2(
// CHECK-DAG: func.func private @print_str(
// CHECK-LABEL: func.func @Tensor$f32$10x10$fill$f32(%arg0: memref<memref<?x?xf32>>, %arg1: f32)
// CHECK: call @vx_macro_mlir_L0_C0_0(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, f32) -> ()
// CHECK-LABEL: func.func @Tensor$f32$10x10$compare$f32(%arg0: memref<memref<?x?xf32>>, %arg1: memref<memref<?x?xf32>>) -> i1
// CHECK: call @vx_macro_mlir_L0_C0_1(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, memref<?x?xf32>) -> i1
// CHECK-LABEL: func.func @Tensor$f32$10x10$copy$f32(%arg0: memref<memref<?x?xf32>>, %arg1: memref<memref<?x?xf32>>)
// CHECK: call @vx_macro_mlir_L0_C0_2(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, memref<?x?xf32>) -> ()
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @Tensor$f32$10x10$fill$f32(%{{.*}}, %{{.*}}) : (memref<memref<?x?xf32>>, f32) -> ()
// CHECK: call @Tensor$f32$10x10$fill$f32(%{{.*}}, %{{.*}}) : (memref<memref<?x?xf32>>, f32) -> ()
// CHECK: call @Tensor$f32$10x10$compare$f32(%{{.*}}, %{{.*}}) : (memref<memref<?x?xf32>>, memref<memref<?x?xf32>>) -> i1
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @Tensor$f32$10x10$copy$f32(%{{.*}}, %{{.*}}) : (memref<memref<?x?xf32>>, memref<memref<?x?xf32>>) -> ()
// CHECK: call @Tensor$f32$10x10$compare$f32(%{{.*}}, %{{.*}}) : (memref<memref<?x?xf32>>, memref<memref<?x?xf32>>) -> i1
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
import std::tensor;

fn main() -> i32 {
  let mut t1 = Tensor<f32>(10, 10);
  let mut t2 = Tensor<f32>(10, 10);

  t1.fill(1.0);
  t2.fill(2.0);

  if t1.compare(&t2) {
    print!("Error: Tensors should not be equal
");
  };

  t2.copy(&t1);
  if!t1.compare(&t2) {
    print!("Error: Tensors should be equal after copy
");
  };
  return 0;
}
