// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @Tensor$f32$10x10$fill$f32(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, f32) -> ()
// CHECK: call @Tensor$f32$10x10$fill$f32(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, f32) -> ()
// CHECK: call @Tensor$f32$10x10$compare$f32(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, memref<?x?xf32>) -> i1
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @Tensor$f32$10x10$copy$f32(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, memref<?x?xf32>) -> ()
// CHECK: call @Tensor$f32$10x10$compare$f32(%{{.*}}, %{{.*}}) : (memref<?x?xf32>, memref<?x?xf32>) -> i1
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK-LABEL: func.func @Tensor$f32$10x10$fill$f32(%arg0: memref<?x?xf32> {llvm.noalias}, %arg1: f32)
// CHECK: call @[[FILL:vx_flat_mlir_[0-9]+]](%arg0, %arg1) : (memref<?x?xf32>, f32) -> ()
// CHECK: func.func private @[[FILL]](
// CHECK-LABEL: func.func @Tensor$f32$10x10$copy$f32(%arg0: memref<?x?xf32> {llvm.noalias}, %arg1: memref<?x?xf32> {llvm.readonly})
// CHECK: call @[[COPY:vx_flat_mlir_[0-9]+]](%arg0, %arg1) : (memref<?x?xf32>, memref<?x?xf32>) -> ()
// CHECK: func.func private @[[COPY]](
// CHECK-LABEL: func.func @Tensor$f32$10x10$compare$f32(%arg0: memref<?x?xf32> {llvm.readonly}, %arg1: memref<?x?xf32> {llvm.readonly}) -> i1
// CHECK: call @[[CMP:vx_flat_mlir_[0-9]+]](%arg0, %arg1) : (memref<?x?xf32>, memref<?x?xf32>) -> i1
// CHECK: func.func private @[[CMP]](
import std::tensor;

fn main() -> i32 {
  let mut t1 = Tensor<f32, [10, 10]>::uninit();
  let mut t2 = Tensor<f32, [10, 10]>::uninit();

  t1.fill(1.0);
  t2.fill(2.0);

  if t1.compare(&t2) {
    print!("Error: Tensors should not be equal
");
  };

  t2.copy(&t1);
  if!t1.compare(&t2) {
    print!("Error: Tensors should be equal after copy
");
  };
  return 0;
}
