// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import std::tensor;

fn main() -> void {
  let mut t1: Tensor<f32> = Tensor_f32(10, 10);
  let mut t2: Tensor<f32> = Tensor_f32(10, 10);

  t1.fill(1.0);
  t2.fill(2.0);

  if t1.compare(&t2) {
    print!("Error: Tensors should not be equal
");
  };

  t2.copy(&t1);
  if !t1.compare(&t2) {
    print!("Error: Tensors should be equal after copy
");
  };
}
