//===----------------------------------------------------------------------===//
// A macro call can be an argument of `print!` and of `println!`.
//
// RUN: vxc %s 2>&1 | FileCheck %s
// CHECK: print 14
// CHECK-NEXT: println 21

macro_rules times_seven {
  ($x:expr) => {
    ($x) * 7
  };
}

fn main() -> i32 {
  print!("print ", times_seven!(2), "\n");
  println!("println {}", times_seven!(3));
  return 0;
}
