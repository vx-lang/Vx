//===----------------------------------------------------------------------===//
// A macro call can end the condition of an `if`, an `else if` and a `while`: the `{` after
// the call opens the body. Only `mlir!` takes a `{ .. }` block after its arguments.
//
// RUN: vxc %s 2>&1 | FileCheck %s
// CHECK: if
// CHECK-NEXT: else if
// CHECK-NEXT: while 3
// CHECK-NEXT: mlir 8

macro_rules sum_as_f32 {
  ($a:expr, $b:expr) => {
    (($a) + ($b)) as f32
  };
}

macro_rules three {
  () => {
    3
  };
}

fn count_ones(x : i32) -> i32 {
  return mlir!(inputs : (%a = x : i32), returns : i32, dialects : ["math"]) {
    %r = math.ctpop %a : i32
    macro.yield %r : i32
  };
}

fn main() -> i32 {
  let x : f32 = 4.0;
  if x == sum_as_f32!(1, 3) {
    println!("if");
  }
  let y : f32 = 5.0;
  if y == 4.0 {
    println!("wrong branch");
  } else if y == sum_as_f32!(2, 3) {
    println!("else if");
  }
  let mut n = 0;
  while n < three!() {
    n = n + 1;
  }
  println!("while {}", n);
  println!("mlir {}", count_ones(255));
  return 0;
}
