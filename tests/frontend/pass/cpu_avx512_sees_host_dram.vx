// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A CPU vector topology reads host memory. `CpuAvx512`'s visible set is exactly `[CPU_DRAM]`
// (`arch.rs`, `builtin_descriptors`), which is also its default space, so this is not a
// cross-topology access and no transfer is needed.
//
// This was a `fail` fixture asserting the opposite. It never ran, because nothing walked its
// directory (Vx#493), so it outlived the model it was written against.

fn main() -> i32 {
  let t_host : Tensor<f32, []> = 1.0;
  spawn on(Topology::CpuAvx512) {
    let seen = t_host;
  }
  return 0;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: vx.spawn topology(600)
