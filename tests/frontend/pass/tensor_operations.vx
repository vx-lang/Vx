//===----------------------------------------------------------------------===//
// Test tensor creation, element types, and matmul operator.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @tensor_add()
// CHECK: %[[V0:.*]] = arith.constant 4 : i32
// CHECK: %[[V1:.*]] = arith.index_cast %[[V0]] : i32 to index
// CHECK: %[[V2:.*]] = arith.constant 4 : i32
// CHECK: arith.index_cast %[[V2]] : i32 to index
// CHECK: %[[V3:.*]] = memref.alloc(%[[V1]], %{{.*}} : memref<?x?xf32>
// CHECK: %[[V4:.*]] = arith.constant 4 : i32
// CHECK: %[[V5:.*]] = arith.index_cast %[[V4]] : i32 to index
// CHECK: %[[V6:.*]] = arith.constant 4 : i32
// CHECK: arith.index_cast %[[V6]] : i32 to index
// CHECK: memref.alloc(%[[V5]], %{{.*}} : memref<?x?xf32>
// CHECK: %[[V7:.*]] = arith.constant 0 : index
// CHECK: %[[V8:.*]] = memref.dim %[[V3]], %[[V7]] : memref<?x?xf32>
// CHECK: %[[V9:.*]] = arith.constant 1 : index
// CHECK: memref.dim %[[V3]], %[[V9]] : memref<?x?xf32>
// CHECK: memref.alloc(%[[V8]], %{{.*}} : memref<?x?xf32>
// CHECK-LABEL: func.func @matmul_basic()
// CHECK: %[[V0:.*]] = arith.constant 2 : i32
// CHECK: %[[V1:.*]] = arith.index_cast %[[V0]] : i32 to index
// CHECK: %[[V2:.*]] = arith.constant 3 : i32
// CHECK: arith.index_cast %[[V2]] : i32 to index
// CHECK: %[[V3:.*]] = memref.alloc(%[[V1]], %{{.*}} : memref<?x?xf32>
// CHECK: %[[V4:.*]] = arith.constant 3 : i32
// CHECK: %[[V5:.*]] = arith.index_cast %[[V4]] : i32 to index
// CHECK: %[[V6:.*]] = arith.constant 4 : i32
// CHECK: arith.index_cast %[[V6]] : i32 to index
// CHECK: %[[V7:.*]] = memref.alloc(%[[V5]], %{{.*}} : memref<?x?xf32>
// CHECK: %[[V8:.*]] = arith.constant 0 : index
// CHECK: %[[V9:.*]] = memref.dim %[[V3]], %[[V8]] : memref<?x?xf32>
// CHECK: %[[V10:.*]] = arith.constant 1 : index
// CHECK: memref.dim %[[V7]], %[[V10]] : memref<?x?xf32>
// CHECK: memref.alloc(%[[V9]], %{{.*}} : memref<?x?xf32>
// CHECK: arith.constant 0.000000e+00 : f32
// CHECK-LABEL: func.func @tensor_scalar()
// CHECK: memref.alloc() : memref<f64>
// CHECK: memref.alloc() : memref<f64>
// CHECK: %[[V0:.*]] = memref.load %{{.*}}[] : memref<f64>
// CHECK: %[[V1:.*]] = memref.load %{{.*}}[] : memref<f64>
// CHECK: arith.mulf %[[V0]], %[[V1]] : f64
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @tensor_add() : () -> ()
// CHECK: call @matmul_basic() : () -> ()
// CHECK: call @tensor_scalar() : () -> ()
import std::tensor;

fn tensor_add() -> void {
  let a = Tensor<f32>(4, 4);
  let b = Tensor<f32>(4, 4);
  let c = a + b;
}

fn matmul_basic() -> void {
  let x = Tensor<f32>(2, 3);
  let y = Tensor<f32>(3, 4);
  let z = x @ y;
}

fn tensor_scalar() -> void {
  let t1 = Tensor<f64>(10);
  let t2 = Tensor<f64>(10);
  let s = t1 * t2;
}

fn main() -> i32 {
  tensor_add();
  matmul_basic();
  tensor_scalar();
  return 0;
}
