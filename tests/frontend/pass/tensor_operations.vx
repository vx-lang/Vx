//===----------------------------------------------------------------------===//
// Test tensor creation, element types, and matmul operator.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import std::tensor;

fn tensor_add() -> void {
  let a = Tensor<f32>(4, 4);
  let b = Tensor<f32>(4, 4);
  let c = a + b;
}

fn matmul_basic() -> void {
  let x = Tensor<f32>(2, 3);
  let y = Tensor<f32>(3, 4);
  let z = x @ y;
}

fn tensor_scalar() -> void {
  let t1 = Tensor<f64>(10);
  let t2 = Tensor<f64>(10);
  let s = t1 * t2;
}

fn main() -> i32 {
  tensor_add();
  matmul_basic();
  tensor_scalar();
  return 0;
}
