//===----------------------------------------------------------------------===//
// Test tensor creation, element types, and matmul operator.
//
// `elementwise_f64` used to be written `Tensor<f64>(10)`, a single bare extent, and that spelling
// meant two different things at once: the checker and the flat path read it as a 10-element rank-1
// tensor, while the AST emitter matched only the bracketed form and dropped the extent, allocating
// rank 0. The CHECK lines below pin the flat path, which compiles this now: rank 2 as a
// named linalg op into a fresh buffer, rank 1 on the vector path.
// Writing the shape in the type leaves nothing to match on, and the function is now the
// elementwise multiply it always read as (Vx#429).
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @tensor_add() : () -> ()
// CHECK: call @matmul_basic() : () -> ()
// CHECK: call @elementwise_f64() : () -> ()
// CHECK-LABEL: func.func @tensor_add()
// CHECK: %[[A:.*]] = memref.alloc() : memref<4x4xf32>
// CHECK: %[[B:.*]] = memref.alloc() : memref<4x4xf32>
// CHECK: %[[C:.*]] = memref.alloc() : memref<4x4xf32>
// CHECK: linalg.add ins(%[[A]], %[[B]] : memref<4x4xf32>, memref<4x4xf32>) outs(%[[C]] : memref<4x4xf32>)
// CHECK-LABEL: func.func @matmul_basic()
// CHECK: %[[X:.*]] = memref.alloc() : memref<2x3xf32>
// CHECK: %[[Y:.*]] = memref.alloc() : memref<3x4xf32>
// CHECK: %[[Z:.*]] = memref.alloc() : memref<2x4xf32>
// CHECK: linalg.fill ins(%{{.*}} : f32) outs(%[[Z]] : memref<2x4xf32>)
// CHECK: linalg.matmul ins(%[[X]], %[[Y]] : memref<2x3xf32>, memref<3x4xf32>) outs(%[[Z]] : memref<2x4xf32>)
// CHECK-LABEL: func.func @elementwise_f64()
// CHECK: %[[E0:.*]] = memref.alloc() : memref<10xf64>
// CHECK: %[[E1:.*]] = memref.alloc() : memref<10xf64>
// CHECK: vector.load %[[E0]]
// CHECK: vector.load %[[E1]]
// CHECK: arith.mulf %{{.*}}, %{{.*}} : vector<10xf64>

fn tensor_add() -> void {
  let a = Tensor<f32, [4, 4]>::uninit();
  let b = Tensor<f32, [4, 4]>::uninit();
  let c = a + b;
}

fn matmul_basic() -> void {
  let x = Tensor<f32, [2, 3]>::uninit();
  let y = Tensor<f32, [3, 4]>::uninit();
  let z = x @ y;
}

fn elementwise_f64() -> void {
  let t1 = Tensor<f64, [10]>::uninit();
  let t2 = Tensor<f64, [10]>::uninit();
  let s = t1 * t2;
}

fn main() -> i32 {
  tensor_add();
  matmul_basic();
  elementwise_f64();
  return 0;
}
