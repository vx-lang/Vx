// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK: llvm.alloca %[[V0]] x !llvm.struct<(i32, i32)> : (i32) -> !llvm.ptr
// CHECK: arith.constant 10 : i32
// CHECK: llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: arith.constant 0 : i32
// CHECK: llvm.getelementptr %{{.*}}, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: %[[V1:.*]] = llvm.getelementptr %{{.*}}, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32)>
// CHECK: %[[V2:.*]] = llvm.load %[[V1]] : !llvm.ptr -> i32
// CHECK: return %[[V2]] : i32
import std::vec;
import std::closure;

struct Point {
  x : i32, y : i32
} macro_rules new_point {
  ($x : expr) => {Point {
      x : $x, y : 0
    }};
}
fn main() -> i32 {
  let p = new_point!(10);
  return p.x;
}