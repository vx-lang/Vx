//===----------------------------------------------------------------------===//
// Host code can move a tensor that lives in the GPU memory `W`, but it cannot read an element.
// An index, an operator and `print` read the elements. A generic parameter that names no memory,
// such as `Tensor<T, [4]>`, makes the function read the tensor on the host, by value or by
// reference. A struct field and an enum payload only store the tensor, so they get no E6003.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//===----------------------------------------------------------------------===//

Memory CPU_DRAM {}
Memory W {
  within: Memory::CPU_DRAM, capacity: 4 MiB, managed: explicit, scope: device
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::W,
  visible: [Memory::W],
  transfer Memory::CPU_DRAM -> Memory::W : 10,
  transfer Memory::W -> Memory::CPU_DRAM : 10
}

struct Holder {
  t : Tensor<f32, [4], Memory::W>,
}

enum Payload {
  Placed(Tensor<f32, [4], Memory::W>),
}

fn first<T>(t : Tensor<T, [4]>) -> T {
  return t[0];
}

fn first_of_a_reference<T>(t : &Tensor<T, [4]>) -> T {
  return t[0];
}

fn on_gpu() -> Tensor<f32, [4], Memory::W> {
  return transfer(Tensor<f32, [4]>::fill(1.0), Memory::W);
}

fn main() -> i32 {
  let a = on_gpu();
  // CHECK: Error[E6003] at {{.*}}.vx:[[@LINE+1]]:12: 'a' lives in W but CPU sees only
  let _x = a[0];
  let b = on_gpu();
  // CHECK: Error[E6003] at {{.*}}.vx:[[@LINE+1]]:12: 'b' lives in W but CPU sees only
  let _y = b + Tensor<f32, [4]>::fill(1.0);
  let c = on_gpu();
  // CHECK: Error[E6003] at {{.*}}.vx:[[@LINE+2]]:9: 'c' lives in W but CPU sees only
  // CHECK: Error[E6003] at {{.*}}.vx:[[@LINE+1]]:3: `print` reads its argument on CPU
  print(c);
  let d = on_gpu();
  // CHECK: Error[E6003] at {{.*}}.vx:[[@LINE+1]]:12: argument 1 of 'first' is a tensor in W, and CPU cannot see W. The parameter type Tensor<T, [4]> names no memory, so 'first' reads the tensor on CPU
  let _z = first(d);
  let e = on_gpu();
  // CHECK: Error[E6003] at {{.*}}.vx:[[@LINE+1]]:12: argument 1 of 'first_of_a_reference' is a tensor in W, and CPU cannot see W. The parameter type &Tensor<T, [4]> names no memory
  let _w = first_of_a_reference(&e);
  let f = on_gpu();
  let _h = Holder {
    t : f
  };
  let g = on_gpu();
  // CHECK: Error[E3021] at {{.*}}.vx:[[@LINE+1]]:12: payload argument 1 of Payload::Placed
  let _p = Payload::Placed(g);
  return 0;
}

// CHECK: {{^}}Semantic check failed on {{.*}}: 7 error(s) emitted
