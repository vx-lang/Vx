//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// `write_buffer(w, p, n)` reads `n` bytes at `p`. Safe code must prove that `p` has them. The
// pointer of a `Vec` has `len()` bytes, and "hi" has 2 bytes and a NUL.

import core::fmt;
import core::result;
import std::vec;

struct Counter {
  bytes : i32,
}

impl Write for Counter {
  fn write_u8(self : &mut Counter, _b : u8) -> Result<i32, Error> {
    self.bytes = self.bytes + 1;
    return Result<i32, Error>::Ok(0);
  }
}

// An empty `Vec` has no bytes to read.
// CHECK-DAG: Error[E8006] at {{.*}}.vx:[[@LINE+4]]:12: this call to 'write_buffer' may not meet its precondition `valid(p, n)`
// CHECK-DAG: Error[E8006] at {{.*}}.vx:[[@LINE+3]]:12: this call to 'write_buffer' may not meet its precondition `initialized(p, n)`
fn past_the_end_of_a_vec(c : &mut Counter) -> i32 {
  let v = Vec<u8>::new();
  let _r = write_buffer(c, v.as_mut_ptr() as *const u8, 6);
  return c.bytes;
}

// The fourth byte may not exist.
// CHECK-DAG: Error[E8006] at {{.*}}.vx:[[@LINE+3]]:12: this call to 'write_buffer' may not meet its precondition `valid(p, n)`
// CHECK-DAG: Error[E8006] at {{.*}}.vx:[[@LINE+2]]:12: this call to 'write_buffer' may not meet its precondition `initialized(p, n)`
fn one_byte_past_the_nul(c : &mut Counter) -> i32 {
  let _r = write_buffer(c, "hi" as *const u8, 4);
  return c.bytes;
}

// The 2 bytes of "hi", its NUL and all of a `Vec` are there to read, so these calls get no error.
// CHECK: 4 error(s) emitted
fn all_of_the_bytes(c : &mut Counter) -> i32 {
  let _r = write_buffer(c, "hi" as *const u8, 3);
  let mut v = Vec<u8>::new();
  v.push(1u8);
  let _s = write_buffer(c, v.as_mut_ptr() as *const u8, v.len());
  return c.bytes;
}

fn main() -> i32 {
  let mut c = Counter {
    bytes : 0
  };
  return past_the_end_of_a_vec(&mut c) + one_byte_past_the_nul(&mut c) + all_of_the_bytes(&mut c);
}
