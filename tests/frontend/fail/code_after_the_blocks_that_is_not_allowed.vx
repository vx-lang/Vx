//===----------------------------------------------------------------------===//
// Code after the `across` nest of blocks runs in the block of the last pass to end. So it may hold
// lane loops, but not a loop of blocks (E6032). A nest with two axes of blocks cannot have code
// after it yet. Code of a group, in the outer loop of blocks, comes after the inner loop, and its
// nest has two axes, not three.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: not vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Error[E6032] at {{.*}}code_after_the_blocks_that_is_not_allowed.vx:29:21: the `across` loop of blocks is directly in the `spawn on` region, not in an `if`, a loop or a block
// CHECK: Error[E6032] at {{.*}}code_after_the_blocks_that_is_not_allowed.vx:46:5: code after an `across` nest of blocks with more than one axis is not built yet. Make the blocks one axis, or put the code in the outer loop of blocks, after the inner one, where it runs once for each pass of the outer loop
// CHECK: Error[E6032] at {{.*}}code_after_the_blocks_that_is_not_allowed.vx:55:23: a nest of blocks with code of a group has two axes, not three
// CHECK: Error[E6032] at {{.*}}code_after_the_blocks_that_is_not_allowed.vx:71:21: a block loop inside another one is the whole body of the outer loop


pub fn blocks_in_an_if_after_the_nest(t : &mut Tensor<i32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..4 across blocks {
      for l in 0..32 across lanes {
        t[b * 32 + l] = l;
      }
    }
    if n > 0 {
      for c in 0..2 across blocks {
        t[c] = 0;
      }
    }
  }
  return;
}

pub fn two_axes(t : &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for y in 0..2 across blocks {
      for x in 0..2 across blocks {
        for l in 0..32 across lanes {
          t[(y * 2 + x) * 32 + l] = l;
        }
      }
    }
    t[0] = 1;
  }
  return;
}

pub fn three_axes_with_a_group(t : &mut Tensor<i32, [?], Memory::HBM>, u : &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for z in 0..2 across blocks {
      for y in 0..2 across blocks {
        for x in 0..2 across blocks {
          for l in 0..32 across lanes {
            t[((z * 2 + y) * 2 + x) * 32 + l] = l;
          }
        }
      }
      u[z] = 1;
    }
  }
  return;
}

pub fn code_before_the_inner_loop(t : &mut Tensor<i32, [?], Memory::HBM>, u : &mut Tensor<i32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for y in 0..2 across blocks {
      u[y] = 1;
      for x in 0..2 across blocks {
        for l in 0..32 across lanes {
          t[(y * 2 + x) * 32 + l] = l;
        }
      }
    }
  }
  return;
}
