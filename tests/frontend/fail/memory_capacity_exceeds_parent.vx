// A sub-space cannot be larger than the space that contains it (E6007).
//
// RUN: not vxc %s 2>&1 | FileCheck %s

Memory SmemBlk {
  capacity: 228 KB
}
Memory TooBig {
  within: Memory::SmemBlk, capacity: 512 KB
}

fn main() -> i32 {
  return 0;
}

// CHECK: E6007
