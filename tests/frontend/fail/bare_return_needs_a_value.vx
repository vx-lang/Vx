// RUN: not vxc %s 2>&1 | FileCheck %s
//
// `return;` is an exit, not a value. A function that promises one has to produce it.

// CHECK-DAG: E3002{{.*}}this function returns i32, so `return` needs a value
fn promises_an_i32(x : i32) -> i32 {
  if x > 0 {
    return;
  }
  return 1;
}

// CHECK-DAG: E3002{{.*}}this function returns Tensor<f32, [4]>, so `return` needs a value
fn promises_a_tensor(x : i32) -> Tensor<f32, [4]> {
  return;
}

fn main() -> i32 {
  return 0;
}
