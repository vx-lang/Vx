//===----------------------------------------------------------------------===//
// Vx converts a typed number only with `as`. An array literal's elements must all have one
// type, and the value given to `Tensor<T, ..>::fill` must have the type `T`.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let f : f32 = 1.5;
  let d : f64 = 2.5;
  let i : i32 = 3;
  let l : i64 = 4;
  // CHECK: Error[E3018] at [[@LINE+1]]:15: this array literal's elements are f64, but one is f32
  let a = [d, f];
  // CHECK: Error[E3018] at [[@LINE+1]]:15: this array literal's elements are i64, but one is i32
  let b = [l, i];
  // CHECK: Error[E3003] at [[@LINE+1]]:34: 'Tensor::fill' fills a tensor of f64, but the value is f32
  let t = Tensor<f64, [2]>::fill(f);
  // CHECK: Error[E3003] at [[@LINE+1]]:34: 'Tensor::fill' fills a tensor of i64, but the value is i32
  let u = Tensor<i64, [2]>::fill(i);
  return 0;
}

// CHECK: 4 error(s) emitted
