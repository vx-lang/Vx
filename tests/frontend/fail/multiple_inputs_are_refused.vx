// vxc compiles one file at a time, and says so when given more.
//
// It used to compile the first input and drop the rest without a word, so a
// command that omitted half a program still reported success.
//
// The second file here is not Vx at all. If it were ever read, the parser would
// reject it with its own message -- so the error below is evidence the extra
// input is refused up front, rather than accepted and found to be empty.
//
// RUN: mkdir -p %t.d
// RUN: printf 'this is not valid vx syntax at all @@@\n' > %t.d/not_vx.vx
// RUN: not vxc %s %t.d/not_vx.vx --action emit-mlir -o /dev/null 2>&1 | FileCheck %s

fn alpha(a: i32) -> i32 {
  return a + 1;
}

// CHECK: vxc compiles one file at a time, but 2 were given
// CHECK: not compiled: {{.*}}not_vx.vx
// CHECK-NOT: Unexpected token at top level
