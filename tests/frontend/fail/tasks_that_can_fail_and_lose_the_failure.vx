//===----------------------------------------------------------------------===//
// A task whose body gives `Result<T, E>` can fail. Its join gives the failure to its `tasks`
// block. Each function here could lose a failure, so each one gets E3060.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

import core::result;

fn fetch(n : i32) -> Result<i32, i32> {
  return Result<i32, i32>::Ok(n);
}

// CHECK-DAG: Error[E3060] at {{.*}}.vx:[[@LINE+3]]:{{[0-9]+}}: the task of 'h' can fail, so the `tasks` block must join it
fn never_joined() -> Result<i32, i32> {
  let r = tasks {
    let h = spawn {
      fetch(1)
    };
    Result<i32, i32>::Ok(0)
  };
  return r;
}

// The join runs only when `c` is true.
// CHECK-DAG: Error[E3060] at {{.*}}.vx:[[@LINE+4]]:{{[0-9]+}}: the task of 'h' can fail, so the `tasks` block must join it
fn joined_in_a_branch(c : bool) -> Result<i32, i32> {
  let mut total = 0;
  let r = tasks {
    let h = spawn {
      fetch(1)
    };
    if c {
      total = h.join();
    }
    Result<i32, i32>::Ok(total)
  };
  return r;
}

// CHECK-DAG: Error[E3060] at {{.*}}.vx:[[@LINE+3]]:{{[0-9]+}}: this task can fail with 'i32', so it needs a handle
fn no_handle() -> i32 {
  tasks {
    spawn {
      fetch(1)
    };
  }
  return 0;
}

// CHECK-DAG: Error[E3060] at {{.*}}.vx:[[@LINE+3]]:{{[0-9]+}}: the task of 'h' can fail with 'i32', so its `tasks` block must give a `Result<_, i32>`. The block gives 'i32'
fn not_a_result() -> i32 {
  let mut total = 0;
  tasks {
    let h = spawn {
      fetch(1)
    };
    total = h.join();
    total
  }
}

// CHECK-DAG: Error[E3060] at {{.*}}.vx:[[@LINE+8]]:{{[0-9]+}}: the task of 'h' can fail, so a join of it must be in its own `tasks` block
fn joined_in_an_inner_block() -> Result<i32, i32> {
  let mut total = 0;
  let r = tasks {
    let h = spawn {
      fetch(1)
    };
    tasks {
      total = h.join();
    }
    Result<i32, i32>::Ok(total)
  };
  return r;
}

fn main() -> i32 {
  return 0;
}
