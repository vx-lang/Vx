//===----------------------------------------------------------------------===//
// A function with an access clause tells the race proof of an `across` loop what it does with
// each tensor. A `&` tensor that no clause names is a read. So the function may only read it.
// `scribble` writes `u` with an `mlir!` block, and `pass_on` gives `u` to a function that may
// write it (E8007). `count_and_read` only reads `u`, so it gets no error.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error

fn bump(c : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> void
ensures atomic(c)
{
  mlir!( inputs : (%c = c : memref<?xi32>), dialects : ["memref", "arith"], ensures : [atomic(c)]) {
    %k = arith.constant 0 : index
    %one = arith.constant 1 : i32
    %old = memref.atomic_rmw addi %one, %c[%k] : (i32, memref<?xi32>) -> i32
    macro.yield
  };
  return;
}

fn scribble(c : &Tensor<i32, [?], Memory::HBM>, u : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> void
ensures atomic(c)
{
  bump(c);
  // CHECK: Error[E8007] at {{.*}}a_tensor_that_no_clause_names_is_only_read.vx:[[# @LINE + 1]]:25: no clause of `scribble` names `u`, so it may only read an element or a field of `u`, or pass it to an `mlir!` block with `ensures : [reads_only(u)]`, or to a function that says `reads_only` for that argument
  mlir!( inputs : (%u = u : memref<?xi32>), dialects : ["memref", "arith"]) {
    %k = arith.constant 0 : index
    %z = arith.constant 7 : i32
    memref.store %z, %u[%k] : memref<?xi32>
    macro.yield
  };
  return;
}

fn first(t : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> i32 {
  return t[0];
}

fn pass_on(c : &Tensor<i32, [?], Memory::HBM>, u : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> i32
ensures atomic(c)
{
  bump(c);
  // CHECK: Error[E8007] at {{.*}}a_tensor_that_no_clause_names_is_only_read.vx:[[# @LINE + 1]]:16: no clause of `pass_on` names `u`
  return first(u);
}

fn count_and_read(c : &Tensor<i32, [?], Memory::HBM>, u : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> i32
ensures atomic(c)
{
  bump(c);
  return u[0] + u.len();
}

fn main() -> i32 {
  return 0;
}
