// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A `for` loop reads its end once, when it starts. The prover knows the end, but each call
// below asks for a fact that the end does not give.

import std::vec;

fn need_below(i : i32, n : i32) -> i32
requires i < n {
  return i;
}

fn need_one(a : i32) -> i32
requires a == 1 {
  return a;
}

// `pop` makes `v` shorter, so the second pass calls `need_below(1, 1)`.
fn pop_in_each_pass() -> i32 {
  let mut v = Vec<i64>::new();
  v.push(1);
  v.push(2);
  v.push(3);
  let mut total : i32 = 0;
  for i in 0..v.len() {
    v.pop();
    // CHECK: Error[E8006] at {{.*}}prover_facts_about_the_end_of_a_for_loop.vx:[[@LINE+1]]:{{[0-9]+}}: this call to 'need_below' may not meet its precondition `i < n`
    total = total + need_below(i, v.len());
  }
  return total;
}

// `n = 0` does not change the end of the loop. The first pass calls `need_below(0, 0)`.
fn change_the_end(n0 : i32) -> i32 {
  let mut n = n0;
  let mut total : i32 = 0;
  for i in 0..n {
    n = 0;
    // CHECK: Error[E8006] at {{.*}}prover_facts_about_the_end_of_a_for_loop.vx:[[@LINE+1]]:{{[0-9]+}}: this call to 'need_below' may not meet its precondition `i < n`
    total = total + need_below(i, n);
  }
  return total;
}

// The end is the parameter `i`, not the variable of the loop. A fact `end == i` about the variable
// of the loop, with `i < end`, would prove anything, also `2 == 1`.
fn end_with_the_name_of_the_variable(i : i32) -> i32 {
  let mut total : i32 = 0;
  for i in 0..i {
    // CHECK: Error[E8006] at {{.*}}prover_facts_about_the_end_of_a_for_loop.vx:[[@LINE+1]]:{{[0-9]+}}: this call to 'need_one' may not meet its precondition `a == 1`
    total = total + need_one(2);
  }
  return total;
}

fn main() -> i32 {
  println!("{} {} {}", pop_in_each_pass(), change_the_end(1), end_with_the_name_of_the_variable(1));
  return 0;
}
