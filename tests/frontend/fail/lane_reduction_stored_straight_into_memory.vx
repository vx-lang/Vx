// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A lane reduction must be the whole value of a `let`, so `y[r] = lanes::sum(..)` gets E6032.
// That is the only error. `y[r]` is an `f32`, which cannot point into a stack frame, so the
// store gets no E4005. The compiler used to give E4005 first.

pub fn matvec_by_block(y : &mut Tensor<f32, [?], Memory::HBM>, w : &Tensor<f32, [?, 512], Memory::HBM>, x : &Tensor<f32, [512], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for r in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for l in 0..256 across lanes {
        part[l] = w[r][l] * x[l] + w[r][256 + l] * x[256 + l];
      }
      // CHECK: Error[E6032] at {{.*}}.vx:[[@LINE+1]]:14: `lanes::sum` must be the whole value of a `let`
      y[r] = lanes::sum(&part, 256);
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
