// `Matrix` is the name of a built-in type, and each use of the name means that
// type. So a program cannot declare a struct with that name.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error at {{.*}}struct_named_matrix.vx:14:8: `Matrix` is a built-in type, so a program cannot declare a type with this name. Choose another name.{{$}}

struct Matrix {
  rows : i32,
  cols : i32,
}

fn size(m : &Matrix) -> i32 {
  return m.rows * m.cols;
}

fn main() -> i32 {
  let m = Matrix {
    rows: 2, cols: 3
  };
  println!("{}", size(&m));
  return 0;
}
