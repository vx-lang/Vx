//===----------------------------------------------------------------------===//
// `max_registers` must be between 1 and 255 (PTX allows at most 255 registers
// per thread). The compiler reports error E6044 when the value is 0 or
// greater than 255.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  // CHECK: Error[E6044] at {{.*}}max_registers_out_of_range.vx:[[@LINE+1]]:3: `max_registers` must be between 1 and 255, got 0
  spawn on(Topology::GPU[0], max_registers: 0) {
    let mut x: i32 = 0;
    x = x + 1;
  }
  // CHECK: Error[E6044] at {{.*}}max_registers_out_of_range.vx:[[@LINE+1]]:3: `max_registers` must be between 1 and 255, got 300
  spawn on(Topology::GPU[0], max_registers: 300) {
    let mut z: i32 = 0;
    z = z + 1;
  }
  // CHECK: Error[E6044] at {{.*}}max_registers_out_of_range.vx:[[@LINE+1]]:3: `max_registers` must be between 1 and 255, got 256
  spawn on(Topology::GPU[0], max_registers: 256) {
    let mut y: i32 = 0;
    y = y + 1;
  }
  return 0;
}

