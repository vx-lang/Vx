// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A struct value can outlive the function that made it, so it cannot hold a stack tensor.

// CHECK: stores a stack tensor in a struct
struct Holder {
  t : Tensor<f32, [4]>,
}

fn main() -> i32 {
  let t : Tensor<f32, [4], Storage::Stack> = Tensor<f32, [4], Storage::Stack>::new();
  let h = Holder {
    t: t
  };
  return 0;
}
