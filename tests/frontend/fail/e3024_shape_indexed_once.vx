// `.shape` is gone. Indexing it must still report E3024 once, not twice: the
// index check probes its base through `operand_type` before the real check.
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error[E3024] at {{.*}}e3024_shape_indexed_once.vx:{{[0-9]+}}:{{[0-9]+}}: `.shape` is gone; write `extent(i)` for the run-time extent of dimension i
// CHECK-NOT: Error[E3024]
// CHECK: 1 error(s) emitted

fn main() -> i32 {
  let t = Tensor<f32, [4]>::fill(0.0f32);
  return t.shape[0];
}
