// RUN: not vxc %s 2>&1 | FileCheck %s
//
// The storage is part of a tensor's type. A stack tensor cannot be given to a name that
// does not say `Storage::Stack`, since that name would treat the buffer as heap memory.

// CHECK: is declared Tensor<f32, [4]> but its initializer is

fn main() -> i32 {
  let t : Tensor<f32, [4], Storage::Stack> = Tensor<f32, [4], Storage::Stack>::new();
  let u : Tensor<f32, [4]> = t;
  return 0;
}
