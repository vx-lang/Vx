//===----------------------------------------------------------------------===//
// A call of a generic function must meet its `requires`, as a call of a plain function must.
// Each call is checked: the first call of an instance, a later call of it, and a call of another
// instance.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

fn not_three<T>(_x : T, n : i32) -> i32
requires n != 3
{
  return n;
}

fn caller_proves_it(n : i32) -> i32
requires n > 3
{
  return not_three(1, n);
}

fn main() -> i32 {
  // CHECK: Error[E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'not_three' may not meet its precondition `n != 3`
  let a = not_three(1, 3);
  // CHECK: Error[E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'not_three' may not meet its precondition `n != 3`
  let b = not_three(1, 3);
  // CHECK: Error[E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'not_three' may not meet its precondition `n != 3`
  let c = not_three(true, 3);
  let d = not_three(1, 4);
  return a + b + c + d + caller_proves_it(5);
}
// CHECK: 3 error(s) emitted
