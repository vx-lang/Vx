// `Memory::M` names a memory parameter only in a function with `<M : Memory>`. In any other
// function it must name a memory, and the machine has no memory called `M`.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: not vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Error[E6025]: `Memory::M` in function 'no_parameter' names no location: no declared topology holds `Memory::M`

fn with_parameter<M : Memory>(t : &Tensor<i32, [?], Memory::M>) -> i32 {
  return t[0];
}

fn no_parameter(t : &Tensor<i32, [?], Memory::M>) -> i32 {
  return t[0];
}

fn main() -> i32 {
  let h = Tensor<i32, [2]>::fill(3);
  return with_parameter(&h);
}
