//===- type_mismatch.vx - Vx Compiler ----------------------------*- Vx -*-===//
// CHECK: Type mismatch on return.
// The wrapper is named in Vx's own syntax. This line used to read `Verified(` -- the Rust debug
// form -- because `Type`'s Display had a `{:?}` fallback that five variants fell through.
// CHECK-SAME: Verified<Tensor<f32, [10]>>
//
// Part of the Vx Project, under the BSD 3-Clause License.
// See LICENSE for license information.
// SPDX-License-Identifier: BSD-3-Clause
//
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
fn should_fail() -> Tensor<f32, [10]> {
  let mut a = Tensor([10]);
  return Verified(a);
}
