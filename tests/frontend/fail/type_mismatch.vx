//===- type_mismatch.vx - Vx Compiler ----------------------------*- Vx -*-===//
// CHECK: Type mismatch on return. Expected Tensor(F32, [], None), got
// Verified(Tensor(F32, [Number(NumberExpr { value: "10", ty: Some(I32), span:
// Span { line: 0, column: 0, length: 0 } })], None))
//
// Part of the Vx Project, under the BSD 3-Clause License.
// See LICENSE for license information.
// SPDX-License-Identifier: BSD-3-Clause
//
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
fn should_fail() -> Tensor {
  let mut a = Tensor([10]);
  return Verified(a);
}
