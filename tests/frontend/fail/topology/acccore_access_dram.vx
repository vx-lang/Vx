// RUN: not vxc %s 2>&1 | FileCheck %s
// Test: AccCore cannot access host DRAM variables — only LocalSRAM.

fn main() -> i32 {
  let t_host : Tensor<f32, []> = 1.0;

  spawn on(Topology::AccCore[0]) {
    // AccCore can only see LocalSRAM, not CPU DRAM
    // CHECK: E6003{{.*}}'t_host' lives in CPU_DRAM but AccCore[0] sees only [Local_SRAM]
    let invalid = t_host;
  }

  return 0;
}
