//===----------------------------------------------------------------------===//
// Test: CpuAvx512 cannot access variables defined in CPU topology.
// Even though both use DRAM, they are distinct topology contexts.

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;

  spawn on(Topology::CpuAvx512) {
    // CHECK: Cross-topology access error
    let invalid = t_host;
  }

  return 0;
}
