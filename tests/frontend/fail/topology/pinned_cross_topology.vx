// Test: Pinned<Tensor, NPU> cannot be accessed from GPU topology.
// GPU can see CPUDRAM (unified), but not NPU_HBM. A tensor pinned to NPU
// lives in NPU_HBM, making it inaccessible from GPU.

fn main() -> i32 {
  let t : Tensor<f32> = 1.0;
  let t_npu = transfer(t, Memory::NPU_HBM);

  spawn on(Topology::GPU) {
    // Pinned<Tensor, NPU> — GPU cannot access NPU_HBM
    // CHECK: Cross-topology access error
    let invalid = t_npu;
  }

  return 0;
}
