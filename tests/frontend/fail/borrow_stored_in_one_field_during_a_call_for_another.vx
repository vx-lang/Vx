// RUN: not vxc %s 2>&1 | FileCheck %s
//
// An argument of `count` stores a borrow of `a` in `w.r`, and the result goes to `w.n`. The
// result does not replace `w.r`, so `w` still borrows `a` after the call.

import std::vec;

struct W {
  n : i32,
  r : &i64,
}

fn count(v : &Vec<i64>, x : i64) -> i32 {
  return v.len();
}

fn main() -> i32 {
  let mut a = Vec<i64>::with_capacity(1);
  a.push(1i64);
  let zero : i64 = 0i64;
  let mut w = W {
    n : 0,
    r : &zero
  };
  w.n = count(&a, if true {
    w.r = a.get_ref(0);
    0i64
  } else {
    0i64
  });
  // CHECK: Error[E4003] at {{.*}}.vx:[[@LINE+1]]:5: Cannot borrow 'a' as mutable because it is also borrowed as immutable.
  a.push(5i64);
  return (*w.r) as i32;
}

// CHECK: 1 error(s) emitted
