// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A generic function cannot be `extern`. The compiler makes one copy of it for each type it
// is called with, and each copy has a different name, so there is no one name to export.

extern fn first<T>(a : T, b : T) -> T {
  return a;
}
// CHECK: Error at {{.*}}extern_on_a_generic_function.vx:[[@LINE-3]]:1: a generic function cannot be `extern`

fn main() -> i32 {
  return first(1, 2);
}
