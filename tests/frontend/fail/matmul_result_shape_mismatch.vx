//===----------------------------------------------------------------------===//
// `[2, 3] @ [3, 4]` is `[2, 4]`, so this declaration lies. It was accepted
// because the matmul typed dims-less, and `is_assignable` skips the dimension
// comparison when the source carries no dims -- the annotation was checked
// against nothing (Vx#397).
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut a : Tensor<f32, [2, 3]> = Tensor<f32>([2, 3]);
  let mut b : Tensor<f32, [3, 4]> = Tensor<f32>([3, 4]);
  a[0][0] = 1.0;
  b[0][0] = 1.0;
  // CHECK: Type mismatch in variable declaration 'c'
  let c : Tensor<f32, [9, 9]> = a @ b;
  return 0;
}
