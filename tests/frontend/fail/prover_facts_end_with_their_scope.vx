// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A fact about a variable ends with the variable's scope, and a new variable of the same name
// starts with no facts. Each function below has a false `ensures` or calls `need_one` with a value
// that is not 1. The prover used to read a fact about one variable as a fact about another, so
// all of them compiled.

import core::option;

fn need_one(a : i32) -> i32
requires a == 1 {
  return a;
}

// `let_in_a_branch(-5)` returns 1.
fn let_in_a_branch(c : i32) -> i32
ensures return == 500 {
  let y : i32 = 1;
  if c > 0 {
    return 500;
  } else {
    let y : i32 = 500;
    print(y);
  }
  // CHECK: Error[E8001] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:3: Function 'let_in_a_branch' cannot prove postcondition
  return y;
}

// `let_in_an_unsafe_block()` returns 1.
fn let_in_an_unsafe_block() -> i32
ensures return == 500 {
  let y : i32 = 1;
  unsafe { let y : i32 = 500; print(y); }
  // CHECK: Error[E8001] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:3: Function 'let_in_an_unsafe_block' cannot prove postcondition
  return y;
}

// `let_in_a_closure()` returns 1.
fn let_in_a_closure() -> i32
ensures return == 500 {
  let y : i32 = 1;
  let g = |a : i32| -> i32 {
    let y : i32 = 500;
    a + y
  };
  print(g(0));
  // CHECK: Error[E8001] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:3: Function 'let_in_a_closure' cannot prove postcondition
  return y;
}

// The `assert` runs only when something calls `g`. `assert_in_a_closure(-5)` returns -5.
fn assert_in_a_closure(y : i32) -> i32
ensures return > 0 {
  let g = |a : i32| -> i32 {
    assert(y > 0, "positive");
    a
  };
  print(g(0));
  // CHECK: Error[E8001] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:3: Function 'assert_in_a_closure' cannot prove postcondition
  return y;
}

// The `y` of `Some(y)` is not the `y` that is 1. `pattern_hides_a_variable(Some(7))` calls
// `need_one(7)`.
fn pattern_hides_a_variable(o : Option<i32>) -> i32 {
  let y : i32 = 1;
  print(y);
  match o {
    Option<i32>::Some(y) => {
      // CHECK: Error[E8006] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:{{[0-9]+}}: this call to 'need_one' may not meet its precondition `a == 1`
      return need_one(y);
    }
    Option<i32>::None => {
      return 0;
    }
  }
}

// The closure's parameter `y` is not the `y` that is 1. `g(7)` calls `need_one(7)`.
fn parameter_hides_a_variable() -> i32 {
  let y : i32 = 1;
  print(y);
  let g = |y : i32| -> i32 {
    // CHECK: Error[E8006] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:5: this call to 'need_one' may not meet its precondition `a == 1`
    need_one(y)
  };
  return g(7);
}

// The `y` on the right is the old `y`, so the fact `y == y + 1` is false and proves anything.
// `let_names_the_variable_it_hides()` returns 2.
fn let_names_the_variable_it_hides() -> i32
ensures return == 500 {
  let y : i32 = 1;
  let y : i32 = y + 1;
  // CHECK: Error[E8001] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:3: Function 'let_names_the_variable_it_hides' cannot prove postcondition
  return y;
}

// The same for the fact `i < i`. `range_names_the_variable_it_hides()` returns 0.
fn range_names_the_variable_it_hides() -> i64
ensures return == 500 {
  let i : i64 = 3;
  for i in 0..i {
    // CHECK: Error[E8001] at {{.*}}prover_facts_end_with_their_scope.vx:[[@LINE+1]]:5: Function 'range_names_the_variable_it_hides' cannot prove postcondition
    return i;
  }
  return 500;
}

fn main() -> i32 {
  print(let_in_a_branch(-5));
  print(let_in_an_unsafe_block());
  print(let_in_a_closure());
  print(assert_in_a_closure(-5));
  print(pattern_hides_a_variable(Option<i32>::Some(7)));
  print(parameter_hides_a_variable());
  print(let_names_the_variable_it_hides());
  print(range_names_the_variable_it_hides() as i32);
  return 0;
}
// CHECK: 8 error(s) emitted
