//===----------------------------------------------------------------------===//
// The value of a `match` has one type, so every arm that gives a value must give that type.
// An arm that returns, or that gives a number with no suffix such as `0`, is fine.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

enum Size {
  Circle(i64),
  Square(i64),
  Triangle(i64),
}

fn wrong_second_arm(s : Size) -> i64 {
  let a = match s {
    Size::Circle(r) => {
      r
    }
    // CHECK: Error[E3068] at {{.*}}match_arms_that_give_values_of_different_types.vx:[[@LINE+1]]:5: this `match` arm gives a value of type i32, but an earlier arm gives a value of type i64. Make every arm give the same type.
    Size::Square(w) => {
      0i32
    }
    Size::Triangle(t) => {
      t
    }
  };
  return a;
}

fn wrong_last_arm(s : Size) -> i64 {
  let a = match s {
    Size::Circle(r) => {
      r
    }
    Size::Square(w) => {
      w * w
    }
    // CHECK: Error[E3068] at {{.*}}match_arms_that_give_values_of_different_types.vx:[[@LINE+1]]:5: this `match` arm gives a value of type bool
    Size::Triangle(t) => {
      t > 0
    }
  };
  return a;
}

// CHECK-NOT: Error[E3068]
fn arms_that_agree(s : Size) -> i64 {
  let a = match s {
    Size::Circle(r) => {
      r * 3
    }
    Size::Square(w) => {
      return w;
    }
    Size::Triangle(t) => {
      0
    }
  };
  return a;
}

fn main() -> i32 {
  let n = wrong_second_arm(Size::Circle(1)) + wrong_last_arm(Size::Square(2));
  return (n + arms_that_agree(Size::Triangle(3))) as i32;
}

// CHECK: 2 error(s) emitted
