//===----------------------------------------------------------------------===//
// A `File` holds a handle of the host operating system, so a `spawn on` body for a device must not
// use it. The code before and after the `spawn on` can use it.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

import core::result;
import std::fs;

fn seek_on_the_gpu(file : &mut File) -> void {
  let mut r = unsafe { Tensor<f32, [4], Memory::GPU_HBM>::uninit() };
  let _before = file.stream_position();
  spawn on(Topology::GPU) {
    r[0] = 1.0;
    // CHECK: Error[E6038] at {{.*}}.vx:[[@LINE+1]]:14: the body of the `spawn on` at line [[@LINE-2]] runs on GPU[0], and it uses 'file': {{.*}}'File'
    let _p = file.stream_position();
  }
  let _after = file.stream_position();
}

fn main() -> i32 {
  return 0;
}
