//===----------------------------------------------------------------------===//
// `x` borrows what `m` points at, so `*m = 1` cannot change it while `x` is used.
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut v = 0;
  let m = &mut v;
  let x = &*m;
  // CHECK: Error[E4009] at [[# @LINE + 1]]:3: `*m` is assigned while it is borrowed
  *m = 1;
  print(*x);
  return 0;
}
// CHECK: 1 error(s) emitted
