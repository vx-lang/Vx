// A `main` that takes a `Root` can take one more parameter: the words of the command line, as a
// `Vec<String>`. A number there is an error at `main`.
// RUN: not vxc %s 2>&1 | FileCheck %s
import std::root;

// CHECK: main_takes_a_root_and_a_number.vx:[[@LINE+1]]:4{{.*}}A `main` that takes a `Root` can take one more parameter only: the words of the command line, as a `Vec<String>`
fn main(_root : Root, count : i32) -> i32 {
  return count;
}
