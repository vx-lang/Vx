//===----------------------------------------------------------------------===//
// A `spawn` region is a scope the lowering does not free at the end of. E6010.
//
// The working-set check treats a tile as gone once its block closes, which is why
// two tiles in sibling `if` arms are allowed to exceed a space between them. That
// rule follows the lowering, and the lowering's rule is dominance, not nesting: a
// block that dominates the function's exits has its frees hoisted there. A `spawn`
// region ends in an unconditional branch, so it dominates, and its tile lives to
// the return:
//
//   ^bb1:                                    // the region
//     %11 = call @vx_plugin_alloc_and_transfer(...)
//     br ^bb2                                // no free here
//   ^bb2:
//     %17 = call @vx_plugin_alloc_and_transfer(...)
//     call @vx_plugin_free(%11, ...)
//     call @vx_plugin_free(%17, ...)
//
// Both tiles are resident together, so 6 MiB has to be refused against a 4 MiB
// space. Reading the region as releasing admitted this program, which is the one
// direction a capacity check must not be wrong in -- it would have run and
// exceeded the space.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: E6010
// CHECK-SAME: (2 tiles)
// CHECK-SAME: sums to 6291456 bytes

Memory CPU_DRAM {}
Memory W {
  within: Memory::CPU_DRAM, capacity: 4 MiB, managed: explicit
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::W,
  visible: [Memory::W],
  transfer Memory::CPU_DRAM -> Memory::W : 10
}

fn main() -> i32 {
  spawn on(Topology::CPU) {
    let a = Tensor<f32, [1024, 768]>::uninit();
    let _sa = transfer(a, Memory::W);
  }
  let b = Tensor<f32, [1024, 768]>::uninit();
  let _sb = transfer(b, Memory::W);
  return 0;
}
