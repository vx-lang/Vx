//===----------------------------------------------------------------------===//
// A const whose value does not fit its type is reported once at the declaration,
// even when the const is used more than once (Vx#2094).
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

// CHECK: Error[E3044] at [[@LINE+1]]:1: const 'A' has a value that does not fit its declared type
const A : i32 = 2147483647 + 1;

fn main() -> i32 {
  println!(A);
  println!(A / 2);
  return 0;
}
