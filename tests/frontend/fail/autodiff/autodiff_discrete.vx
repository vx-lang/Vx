// RUN: not vxc %s 2>&1 | FileCheck %s
// The check below was stale long before this edit -- the compiler has said `got void` for a
// while, and nothing noticed because this directory is never walked (Vx#493).
// CHECK: Type mismatch on return. Expected i32, got void
fn discrete_func(x : f32) -> i32 {
  if x > 0.0 { return 1;
  } else {
    return 0;
  }
}

fn main() -> f32 {
  let x = 2.0;
  // This should fail semantic analysis because discrete_func returns i32, which
  // is discrete.
  let dx = grad(discrete_func, x);
  return 0.0;
}
