// The seed of vjp has the type of the function's result, and the seed of jvp the type of its
// first parameter. An f32 seed for an f64 function is refused at the call.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Type mismatch in the seed for vjp target half_square
// CHECK-SAME: expected Scalar(F64), got Scalar(F32)
// CHECK: Type mismatch in the seed for jvp target half_square
// CHECK-SAME: expected Scalar(F64), got Scalar(F32)

fn half_square(x : f64) -> f64 {
  return 0.5 * x * x;
}

fn main() -> i32 {
  let seed : f32 = 1.0;
  let _r = vjp(half_square, 3.0, seed);
  let _f = jvp(half_square, 3.0, seed);
  return 0;
}
