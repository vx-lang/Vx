// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A Rust programmer writes `use core::option;`. Vx has no `use`. The error says to write `import`.

// CHECK: Vx has no `use`: write `import core::option;` to import a module
use core::option;

fn main() -> i32 {
  return 0;
}
