// `while ... else` is not a construct: the `else` after the loop body is an error.
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error at {{.*}}parser_while_else.vx:16:5: {{.*}}Expected expression, found Else

fn main() -> i32 {
  let c : bool = false;
  while c {
    let a : i32 = 1;
  } else {
    return 1;
  }
  return 0;
}
