// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A `"` is the last character of the file. It opens a string with no end, which used to crash
// the compiler.
//
// CHECK: Error at 18:1: this string has no closing `"`: the file ends inside it

fn main() -> i32 {
  return 0;
}
"