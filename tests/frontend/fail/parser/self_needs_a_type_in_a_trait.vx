// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A trait method's `self` needs a type too. The message must name `Self`, not a
// placeholder like `T`.

trait Get {
  // CHECK: Error at {{.*}}self_needs_a_type_in_a_trait.vx:[[@LINE+1]]:10: `self` needs a type. Write `self : &Self`, `self : &mut Self` or `self : Self`.
  fn get(self) -> i64;
}
