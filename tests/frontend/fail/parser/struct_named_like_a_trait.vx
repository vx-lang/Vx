// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A struct is given the name of a trait declared before it. Structs, enums and
// traits share one set of names, so the second declaration is refused, and the error points
// at it.

trait Shape {
  fn sides(self : &Self) -> i32;
}
// CHECK: Error at {{.*}}struct_named_like_a_trait.vx:[[@LINE+1]]:1: the type `Shape` is already defined at 14:1
struct Shape {
  sides : i32,
}

fn main() -> i32 {
  return 0;
}
