// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A reserved word used as a let name should say that word is a keyword and
// point at that token (not at the next one). for/fn cases are covered by the
// unit test; the parser stops at the first error, so they are not in this
// fixture.
//
fn main() -> i32 {
  // CHECK: Error at {{.*}}parser_keyword_as_name.vx:[[@LINE+1]]:11: `across` is a keyword and cannot be used as a name
  let mut across = 3;
  return 0;
}
