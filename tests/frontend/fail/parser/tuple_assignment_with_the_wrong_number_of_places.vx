// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A tuple assigned to a tuple of places needs one place per element.
//
// CHECK: the left side has 2 elements, but the tuple has 3

fn main() -> i32 {
  let mut a : i32 = 0;
  let mut b : i32 = 0;
  (a, b) = (1, 2, 3);
  return a + b;
}
