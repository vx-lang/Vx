// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A trait with no name: the error points at the bad token `{`, not at the
// next line.
//
// CHECK: Expected trait name
// CHECK: trait {
// CHECK: ~~~~^~~~~
trait {
  fn dim(self: Tensor<f32, [?, ?]>) -> Tensor<i32, [?, ?]>;
}
