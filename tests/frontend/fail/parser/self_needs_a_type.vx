// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A method's `self` needs a type. Rust accepts a bare `self`. Vx does not.
// The message names the forms with `Self`.

struct P {
  a : i64,
}

impl P {
  // CHECK: Error at {{.*}}self_needs_a_type.vx:[[@LINE+1]]:10: `self` needs a type. Write `self : &Self`, `self : &mut Self` or `self : Self`.
  fn get(self) -> i64 {
    return self.a;
  }
}

fn main() -> i32 {
  return 0;
}
