// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A trait is given the name of an enum declared before it. Structs, enums and
// traits share one set of names, so the second declaration is refused, and the error points
// at it.

enum Shape {
  Square, Circle,
}
// CHECK: Error at {{.*}}trait_named_like_an_enum.vx:[[@LINE+1]]:1: the type `Shape` is already defined at 14:1
trait Shape {
  fn sides(self : &Self) -> i32;
}

fn main() -> i32 {
  return 0;
}
