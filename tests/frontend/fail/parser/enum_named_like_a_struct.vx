// RUN: not vxc %s 2>&1 | FileCheck %s
//
// An enum is given the name of a struct declared before it. Structs, enums and
// traits share one set of names, so the second declaration is refused, and the error points
// at it.

struct Shape {
  sides : i32,
}
// CHECK: Error at {{.*}}enum_named_like_a_struct.vx:[[@LINE+1]]:1: the type `Shape` is already defined at 14:1
enum Shape {
  Square, Circle,
}

fn main() -> i32 {
  return 0;
}
