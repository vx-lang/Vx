// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// An impl is for a type. An impl for a raw pointer to the type is an error, because no method
// call finds its methods.

struct Cap {
  x : i64,
}

impl *mut Cap {
  fn first(self : Self) -> i64 {
    return 1i64;
  }
}

fn main() -> i32 {
  return 0;
}

// CHECK: Error at {{.*}}an_impl_for_a_raw_pointer.vx:17:6: an impl is for a type, not for a reference or a raw pointer to it. Write `impl Cap`
