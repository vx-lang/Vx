// RUN: not vxc %s 2>&1 | FileCheck %s

// CHECK: Expected '{'
// CHECK: fn dim(self: Tensor<f32>) -> Tensor<i32>;
// CHECK: ^^~~~~
trait MissingBraces
fn dim(self: DynTensor<f32>) -> DynTensor<i32>;
}
