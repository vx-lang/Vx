//===----------------------------------------------------------------------===//
// A rank-1 value handed to a rank-2 parameter is a type error at the call.
// It used to be accepted, because `DynTensor` carried no rank and both codegen
// paths assumed 2: the value kept its real rank, the parameter did not, and
// the module failed to verify on a `memref.cast` from `memref<?xf32>` to
// `memref<?x?xf32>`. Rank is static, and no cast changes it.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: rank 1
// CHECK-SAME: rank 2
// CHECK-NOT: memref.cast

fn takes(t : Tensor<f32, [?, ?]>) -> i32 {
  return 0;
}

fn f(n : i32) -> i32 {
  let mut a = Tensor<f32>([n]);
  a[0] = 1.0;
  return takes(a);
}

fn main() -> i32 {
  return f(3);
}
