//===----------------------------------------------------------------------===//
// A program that calls `Option<i64>::Some` without `import core::option;` gets an
// error that names the import.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Undefined static method 'Option<i64>::Some'. 'Option' is in 'core::option'; add `import core::option;`.

fn main() -> i32 {
  let o = Option<i64>::Some(3i64);
  return o.unwrap() as i32;
}
