//===----------------------------------------------------------------------===//
// The same quicksort as pass/comptime_recursive_quicksort.vx, asked for a wrong answer.
//
// The pass fixture cannot catch the evaluator giving up: an assert it does not run is
// silently accepted, so that file compiles whether the sort was evaluated or not. Here
// the error disappearing is the failure, which is what makes "this actually ran" a thing
// the suite checks rather than a thing the reader assumes.
//
// `out[0]` is 1. Asking whether it is 99 has to be refused while compiling.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn qsort(a : Tensor<i64, [8]>, lo : i64, hi : i64) -> Tensor<i64, [8]> {
  let mut w : Tensor<i64, [8]> = a;
  if lo >= hi {
    return w;
  }
  let pivot : i64 = w[hi];
  let mut i : i64 = lo - 1i64;
  for j in lo..hi {
    if w[j] <= pivot {
      i = i + 1i64;
      let t : i64 = w[i];
      w[i] = w[j];
      w[j] = t;
    }
  }
  let p : i64 = i + 1i64;
  let s : i64 = w[p];
  w[p] = w[hi];
  w[hi] = s;
  return qsort(qsort(w, lo, p - 1i64), p + 1i64, hi);
}

fn main() -> i32 {
  comptime {
    let input : Tensor<i64, [8]> = [ 5i64, 3i64, 8i64, 1i64, 9i64, 2i64, 7i64, 4i64 ];
    let out : Tensor<i64, [8]> = qsort(input, 0i64, 7i64);
    // CHECK: Error[E8002]{{.*}}the sorted value is 1, not 99
    assert(out[0] == 99i64, "the sorted value is 1, not 99");
  }
  return 0;
}
