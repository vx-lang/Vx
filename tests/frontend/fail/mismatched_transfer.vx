//===- mismatched_transfer.vx - Vx Compiler ----------------------*- Vx -*-===//
// CHECK: Type mismatch in argument 1 for function 'expects_host'. Expected
// Tensor(F32, [], None), got Pinned(Tensor(F32, [], None),
// NPU(Number(NumberExpr { value: "0", ty: Some(I32), span: Span { line: 0,
// column: 0, length: 0 } })))
