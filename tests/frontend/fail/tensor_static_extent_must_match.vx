//===----------------------------------------------------------------------===//
// Widening is per dimension: a static extent may become `?`, and a static
// extent may stay itself. It may not become a different static extent.
// `Tensor<f32>([n, 3])` is `[?, 3]`, and `[?, 3]` is not assignable to
// `[?, 4]`, so this is the ordinary argument type mismatch.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: E3003
// CHECK-SAME: 'g'

fn g(x : Tensor<f32, [?, 4]>) -> i32 {
  return 0;
}

fn f(n : i32) -> i32 {
  let m = Tensor<f32>([n, 3]);
  return g(m);
}

fn main() -> i32 {
  return f(2);
}
