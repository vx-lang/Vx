// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// Safe code cannot free a block twice, or write past the end of a buffer, through `std`.
// `dealloc` and `grow` are `unsafe`, because no clause can say that a block is not freed yet.
// `Rng::fill_f32` requires `valid(out, count)`, so a call in safe code must prove that `out` has
// room for `count` values.
import std::alloc;
import std::rand;
import std::vec;

fn free_twice() -> void {
  let p = alloc(64, 8);
  // CHECK: Error[E5001] at {{.*}}.vx:[[@LINE+1]]:3: Call to unsafe function 'dealloc' is unsafe and requires unsafe function or block
  dealloc(p, 8);
  // CHECK: Error[E5001] at {{.*}}.vx:[[@LINE+1]]:3: Call to unsafe function 'dealloc' is unsafe and requires unsafe function or block
  dealloc(p, 8);
}

fn grow_a_freed_block() -> void {
  let p = alloc(64, 8);
  unsafe { dealloc(p, 8) };
  // CHECK: Error[E5001] at {{.*}}.vx:[[@LINE+1]]:12: Call to unsafe function 'grow' is unsafe and requires unsafe function or block
  let _q = grow(p, 64, 128, 8);
}

fn fill_past_the_end() -> void {
  let mut v : Vec<f32> = Vec::new();
  v.push(1.0);
  let mut rng = Rng::seeded(1);
  // CHECK: Error[E8006] at {{.*}}.vx:[[@LINE+1]]:7: this call to 'Rng::fill_f32' may not meet its precondition `valid(out, count)`: the compiler cannot prove it from what is known here
  rng.fill_f32(v.data, 1000000);
}

// The vector has room for each of its elements, so this call proves `valid(out, count)`.
fn fill_each_element() -> void {
  let mut v : Vec<f32> = Vec::new();
  v.push(1.0);
  v.push(2.0);
  let mut rng = Rng::seeded(1);
  rng.fill_f32(v.as_mut_ptr(), v.len());
}

fn main() -> i32 {
  return 0;
}
// CHECK: 4 error(s) emitted
