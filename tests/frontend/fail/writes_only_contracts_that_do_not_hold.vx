//===----------------------------------------------------------------------===//
// `ensures writes_only()` says that a function writes no memory, as a fence does. Each function
// here breaks that, or writes the clause wrong (E8007). A call counts when the callee says
// `writes_only()` too, or when the compiler has shown that it writes only its own variables, so
// the function that calls `makes_and_writes_a_tensor` breaks the clause: that callee writes a
// tensor it makes, and says nothing. The kernel at the end calls `quiet`, which has the clause,
// and `write_first`, which does not (E6032), in an `across` loop.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: not vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Error[E8007] at {{.*}}writes_only_contracts_that_do_not_hold.vx:35:9: `takes_a_tensor` says `writes_only()`, so it may take no tensor, reference or pointer, but `t` is `&mut Tensor<i32, [?], Memory::HBM>`
// CHECK: Error[E8007] at {{.*}}writes_only_contracts_that_do_not_hold.vx:41:9: `writes_only` takes no arguments here: `writes_only()` says that `names_a_tensor` writes no memory
// CHECK: Error[E8007] at {{.*}}writes_only_contracts_that_do_not_hold.vx:49:10: `block_without_the_clause` says `writes_only()`, so each `mlir!` block in it must say `ensures : [writes_only()]`
// CHECK: Error[E8007] at {{.*}}writes_only_contracts_that_do_not_hold.vx:59:10: `calls_a_function_without_the_clause` says `writes_only()`, so it may call only a function that says it too or that the compiler has shown writes only its own variables, but `makes_and_writes_a_tensor` is neither
// CHECK: Error[E8007] at {{.*}}writes_only_contracts_that_do_not_hold.vx:69:10: a block that says `writes_only()` may take no memref or pointer input, but `%t` is `memref<?xi32>`
// CHECK: Error[E6032] at {{.*}}writes_only_contracts_that_do_not_hold.vx:85:18: the call to `write_first` writes memory that another pass can see, or the compiler cannot show that it writes only its own variables. Write its work in the loop

fn quiet() on Topology::Device -> void
ensures writes_only()
{
  mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
    llvm.fence syncscope("device") release
    macro.yield
  };
  return;
}

fn takes_a_tensor(t : &mut Tensor<i32, [?], Memory::HBM>) on Topology::Device -> void
ensures writes_only()
{
  return;
}

fn names_a_tensor(t : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> void
ensures writes_only(t)
{
  return;
}

fn block_without_the_clause() on Topology::Device -> void
ensures writes_only()
{
  mlir!( inputs : (), dialects : ["llvm"]) {
    llvm.fence release
    macro.yield
  };
  return;
}

fn calls_a_function_without_the_clause() on Topology::Device -> i32
ensures writes_only()
{
  return makes_and_writes_a_tensor();
}

fn makes_and_writes_a_tensor() on Topology::Device -> i32 {
  let mut t = unsafe { Tensor<i32, [4], Memory::HBM>::uninit() };
  t[0] = 7;
  return t[0];
}

fn block_with_a_memory_input(t : &Tensor<i32, [?], Memory::HBM>) on Topology::Device -> void {
  mlir!( inputs : (%t = t : memref<?xi32>), dialects : ["memref"], ensures : [writes_only()]) {
    macro.yield
  };
  return;
}

fn write_first(t : &mut Tensor<i32, [?, 32], Memory::HBM>) on Topology::Device -> i32 {
  t[0][0] = 8;
  return 7;
}

pub fn calls_in_the_loop(o : &mut Tensor<i32, [?, 32], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..4 across blocks {
      for l in 0..32 across lanes {
        quiet();
        let _s = write_first(o);
      }
    }
  }
  return;
}
