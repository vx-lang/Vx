// RUN: not vxc %s 2>&1 | FileCheck %s
//
// `rr` points at `r`, so `*rr = v` gives `r` a new value, and a use of `rr` uses what `r`
// borrows. Each function breaks one of the rules that follow from that.

// `r` now points at `y`, which is gone once the function returns.
fn returned_after_a_store(p : &mut i32) -> &mut i32 {
  let mut y = 1;
  let mut r = p;
  let rr = &mut r;
  *rr = &mut y;
  // CHECK-NOT: Error
  // CHECK: Error[E4005] at [[# @LINE + 1]]:3: this returns a value that points into this function's stack frame.
  return r;
}

// `y` is gone once the block ends, and `r` outlives the block.
fn variable_of_an_inner_block() -> i32 {
  let mut x = 5;
  let mut r = &mut x;
  let rr = &mut r;
  if true {
    let mut y = 7;
    // CHECK-NEXT: Error[E3004] at [[# @LINE + 2]]:5: Type mismatch in assignment: both sides are &mut i32, but they are valid in different blocks.
    // CHECK-NEXT: Error[E4005] at [[# @LINE + 1]]:5: `r` is given a value that points at a variable of an inner block, and `r` outlives that block.
    *rr = &mut y;
  }
  return *r;
}

// `r` holds `&mut y` and is used after `y` is read.
fn read_while_borrowed() -> i32 {
  let mut x = 5;
  let mut y = 7;
  let mut r = &mut x;
  let rr = &mut r;
  *rr = &mut y;
  // CHECK-NEXT: Error[E4002] at [[# @LINE + 1]]:11: Cannot access 'y' because it is mutably borrowed.
  let a = y;
  *r = 1;
  return a;
}

// `rr` reaches `&mut y` through `r`, so `z` would be a second `&mut y`.
fn second_mut_after_a_store() -> i32 {
  let mut x = 5;
  let mut y = 7;
  let mut r = &mut x;
  let rr = &mut r;
  *rr = &mut y;
  // CHECK-NEXT: Error[E4004] at [[# @LINE + 1]]:11: Cannot borrow 'y' because it is already borrowed as mutable.
  let z = &mut y;
  *z = 3;
  **rr = 1;
  return y;
}

// The same with no store: `rr` reaches `&mut x` through `r`.
fn second_mut_through_a_reference_to_a_reference() -> i32 {
  let mut x = 5;
  let mut r = &mut x;
  let rr = &mut r;
  // CHECK-NEXT: Error[E4004] at [[# @LINE + 1]]:11: Cannot borrow 'x' because it is already borrowed as mutable.
  let z = &mut x;
  *z = 3;
  **rr = 1;
  return x;
}

fn main() -> i32 {
  return 0;
}
