// `Tensor` is the name of a built-in type, so a program cannot declare a struct
// with that name.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error at {{.*}}struct_named_tensor.vx:14:8: `Tensor` is a built-in type, so a program cannot declare a type with this name. Choose another name.{{$}}

struct Tensor {
  x : i32,
}

fn main() -> i32 {
  return 0;
}
