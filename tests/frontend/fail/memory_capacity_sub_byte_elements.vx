//===----------------------------------------------------------------------===//
// A tensor stores each `bool`, `i4`, `u4` or `f4e2m1` element in a whole byte, so the
// capacity check counts a byte per element. Each tensor below is over 1 KiB that way, and
// would fit if its elements were counted as packed bits. The sizes differ so that each
// error names its tensor.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

Memory CPU_DRAM {}
Memory NPU_SRAM {
  within: Memory::CPU_DRAM, capacity: 1 KiB, managed: explicit
}
Topology Npu {
  memory: Memory::NPU_SRAM, visible: [Memory::NPU_SRAM],
  transfer Memory::CPU_DRAM -> Memory::NPU_SRAM : 10
}

fn main() -> i32 {
  let flags = transfer(Tensor<bool, [1100]>::uninit(), Memory::NPU_SRAM);
  let weights = transfer(Tensor<i4, [30, 40]>::uninit(), Memory::NPU_SRAM);
  let codes = transfer(Tensor<u4, [1300]>::uninit(), Memory::NPU_SRAM);
  let scales = transfer(Tensor<f4e2m1, [1400]>::uninit(), Memory::NPU_SRAM);
  return 0;
}

// CHECK: E6009
// CHECK-SAME: 1100 bytes
// CHECK: E6009
// CHECK-SAME: 1200 bytes
// CHECK: E6009
// CHECK-SAME: 1300 bytes
// CHECK: E6009
// CHECK-SAME: 1400 bytes
// CHECK: 4 error(s) emitted
