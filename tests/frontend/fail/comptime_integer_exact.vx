// 2^53 + 1 and 2^53 are different numbers, and the evaluator has to say so.
//
// An f64 cannot tell them apart, so while compile-time integers went through one this
// assert was accepted and the build passed. A fixture asserting they differ would have
// kept passing after a regression back to f64, because the assert would simply stop
// being evaluated. Asserting that they are equal is what goes red.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Comptime assert failed: 2^53 + 1 is not 2^53

fn main() -> i32 {
  comptime {
    let big : i64 = 9007199254740993i64;
    assert(big == 9007199254740992, "2^53 + 1 is not 2^53");
  }
  return 0;
}
