// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A value whose type has a `drop` that can read its references is dropped at the end of its
// block, so what it borrows stays borrowed until then, also inside another struct. A function
// cannot return a reference held in a `&mut` of a value dropped as it returns.

import core::ops;
import std::vec;

struct Reader {
  r : &i32,
}

impl Drop for Reader {
  fn drop(self : &mut Reader) -> void {
    println!("reader sees {}", *self.r);
  }
}

struct Outer {
  inner : Reader,
}

struct Setter {
  r : &mut u8,
}

impl Drop for Setter {
  fn drop(self : &mut Setter) -> void {
    *self.r = 0u8;
  }
}

fn first(v : &Vec<i32>) -> &i32 {
  return v.get_ref(0);
}

fn push_while_a_reader_holds_an_element() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(11);
  let rd = Reader {
    r : first(&v)
  };
  // CHECK: Error[E4003] at {{.*}}.vx:[[@LINE+1]]:5: Cannot borrow 'v' as mutable because it is also borrowed as immutable.
  v.push(12);
  return 0;
}

fn assign_while_a_reader_holds_it() -> i32 {
  let mut x = 1;
  let rd = Reader {
    r : &x
  };
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `x` is assigned while it is borrowed
  x = 5;
  return x;
}

fn assign_while_a_field_holds_a_reader() -> i32 {
  let mut x = 1;
  let o = Outer {
    inner : Reader {
      r : &x
    }
  };
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `x` is assigned while it is borrowed
  x = 5;
  return x;
}

fn get(s : Setter) -> &u8 {
  // CHECK: Error[E4005] at {{.*}}.vx:[[@LINE+1]]:3: this returns a reference that `s` holds in a `&mut`
  return s.r;
}

fn main() -> i32 {
  let mut x : u8 = 64u8;
  let r = get(Setter {
    r : &mut x
  });
  return push_while_a_reader_holds_an_element() + assign_while_a_reader_holds_it()
  + assign_while_a_field_holds_a_reader() + ((*r) as i32);
}

// CHECK: 4 error(s) emitted
