// RUN: not vxc %s 2>&1 | FileCheck %s '--implicit-check-not=Error['
//
// A field whose value has something to drop is moved out by `let x = p.a` or `take(p.a)`.
// After that, `p.a` has no value, and `p` cannot be used whole. A field cannot be moved out
// through a reference, which does not own it, or out of a value whose type implements `Drop`.
// fields_moved_out_leave_the_rest_usable.vx has what stays allowed.

import core::ops;

struct Noisy {
  id : i32,
}

impl Drop for Noisy {
  fn drop(self : &mut Noisy) -> void {
    print(self.id);
  }
}

struct Pair {
  a : Noisy,
  b : Noisy,
}

fn take(n : Noisy) -> i32 {
  return n.id;
}

struct Guarded {
  a : Noisy,
}

impl Drop for Guarded {
  fn drop(self : &mut Guarded) -> void {
    print(self.a.id);
  }
}

fn moved_twice() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.a;
  // CHECK: Error[E4001] at [[@LINE+1]]:{{.*}}`p.a` was moved out of `p`
  let y = p.a;
  return 0;
}

fn read_inside_a_moved_field() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.b;
  // CHECK: Error[E4001] at [[@LINE+1]]:{{.*}}`p.b` was moved out of `p`
  return p.b.id;
}

fn used_whole_after() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.a;
  // CHECK: Error[E4001] at [[@LINE+1]]:{{.*}}`p` is used whole, but `p.a` was moved out of it
  let q = p;
  return 0;
}

fn borrowed_whole_after() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  let x = p.a;
  // CHECK: Error[E4001] at [[@LINE+1]]:{{.*}}`p` is used whole, but `p.a` was moved out of it
  let r = &p;
  return 0;
}

fn moved_in_a_loop() -> i32 {
  let p = Pair {
    a: Noisy {
      id: 1
    }, b: Noisy {
      id: 2
    }
  };
  // CHECK: Error[E4001] at [[@LINE+1]]:{{.*}}`p.a` is moved inside this loop
  for _i in 0..2 {
    print(take(p.a));
  }
  return 0;
}

fn through_a_reference(p : &Pair) -> i32 {
  // CHECK: Error[E4008] at [[@LINE+1]]:{{.*}}`p.a` cannot be moved out: `p` is a reference
  return take(p.a);
}

fn out_of_a_type_with_drop() -> i32 {
  let g = Guarded {
    a: Noisy {
      id: 1
    }
  };
  // CHECK: Error[E4013] at [[@LINE+1]]:{{.*}}`g.a` cannot be moved out: `Guarded` implements `Drop`
  return take(g.a);
}

fn main() -> i32 {
  return 0;
}
