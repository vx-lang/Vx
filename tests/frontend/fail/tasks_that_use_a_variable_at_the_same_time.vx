// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A task runs at the same time as the code after its `spawn`, until its `join()` or the end of
// its `tasks` block. It holds each variable that it writes, and each one that it reads and does
// not copy, for that time. A task in a loop also runs at the same time as the next pass.
//
// A task that writes a value, or moves it into itself, needs the value to be `Send`. A task that
// reads a variable in place needs it to be `Sync`.

import core::cell;
import std::vec;

// CHECK: Error[E4002] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+7]]:13: Cannot access 'x' because it is mutably borrowed. A task that is not joined yet uses it.
fn read_while_a_task_writes() -> i32 {
  let mut x = 0;
  tasks {
    spawn {
      x += 1;
    };
    let y = x;
  }
  return x;
}

// CHECK: Error[E4002] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+8]]:7: Cannot access 'x' because it is mutably borrowed. A task that is not joined yet uses it.
fn two_tasks_write() -> i32 {
  let mut x = 0;
  tasks {
    spawn {
      x += 1;
    };
    spawn {
      x += 2;
    };
  }
  return x;
}

// CHECK: Error[E4009] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+7]]:5: `v` is assigned while it is borrowed, and the borrow is used after the assignment. A task that is not joined yet uses it.
fn change_what_a_task_reads() -> i32 {
  let mut v = Vec<i32>::new();
  tasks {
    let h = spawn {
      v.len()
    };
    v = Vec<i32>::new();
    h.join();
  }
  return 0;
}

// CHECK: Error[E4014] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+4]]:5: a task that this loop starts writes 'x'
fn task_in_a_loop_writes() -> i32 {
  let mut x = 0;
  tasks {
    for i in 0..4 {
      spawn {
        x += i;
      };
    }
  }
  return x;
}

// CHECK: Error[E4014] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+4]]:5: a task that this loop starts reads 'v'
fn loop_changes_what_a_task_reads() -> void {
  let mut v = Vec<i32>::new();
  tasks {
    for i in 0..3 {
      v.push(i);
      spawn {
        v.len();
      };
    }
  }
}

// A task moves `v`, because `v` ends before the task's join. So the pass cannot use `v` again.
// CHECK: Error[E4001] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+9]]:16: Use of moved or consumed linear variable: v
fn use_a_local_that_a_task_moved() -> void {
  tasks {
    for i in 0..3 {
      let mut v = Vec<i32>::new();
      v.push(i);
      spawn {
        v.len();
      };
      let _w = v;
    }
  }
}

// CHECK: Error[E4014] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+6]]:7: the task uses 'r', which points at 'n', but 'n' ends before its `tasks` block does
fn task_outlives_what_a_reference_points_at() -> void {
  tasks {
    for i in 0..3 {
      let n = i;
      let r = &n;
      spawn {
        *r;
      };
    }
  }
}

// CHECK: Error[E4001] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+9]]:15: Use of moved or consumed linear variable: v
fn use_after_moving_into_a_task() -> i32 {
  let v = Vec<i32>::new();
  tasks {
    spawn {
      let w = v;
      w.len();
    };
  }
  let again = v;
  return 0;
}

// CHECK: Error[E3055] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+4]]:5: the task reads 'c', which the code around the task can read at the same time, so its type 'SharedCell<i32>' must be `Sync`: 'SharedCell<i32>' is never `Sync`
fn share_a_shared_cell() -> void {
  let c = SharedCell<i32>::new(1);
  tasks {
    spawn {
      c.get();
    };
  }
}

// CHECK: Error[E3055] at {{.*}}tasks_that_use_a_variable_at_the_same_time.vx:[[@LINE+5]]:5: the task copies 'p' into itself, so its type '*mut i32' must be `Send`: '*mut i32' is a raw pointer, which is not `Send`
fn copy_a_raw_pointer() -> i32 {
  let mut x = 0;
  let p = (&mut x) as *mut i32;
  tasks {
    spawn {
      unsafe { *p = 1; }
    };
  }
  return x;
}

fn main() -> i32 {
  return 0;
}

// The errors above are all the errors.
// CHECK: {{^}}Semantic check failed on {{.*}}: 10 error(s) emitted
