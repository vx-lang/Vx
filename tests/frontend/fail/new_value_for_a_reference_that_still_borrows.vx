// `r` gets a new value that still points at `x`, so `x` cannot change while `r` is used.
// RUN: not vxc %s 2>&1 | FileCheck %s

fn same_place_again() -> i32 {
  let mut x : i32 = 1;
  let mut r = &x;
  r = &x;
  // CHECK: Error[E4009] at {{.*}}new_value_for_a_reference_that_still_borrows.vx:[[# @LINE + 1]]:3: `x` is assigned while it is borrowed
  x = 5;
  return *r;
}

fn copied_from_another_reference() -> i32 {
  let mut x : i32 = 1;
  let y : i32 = 2;
  let q = &x;
  let mut r = &y;
  r = q;
  // CHECK-NEXT: Error[E4009] at {{.*}}new_value_for_a_reference_that_still_borrows.vx:[[# @LINE + 1]]:3: `x` is assigned while it is borrowed
  x = 5;
  return *r;
}
// CHECK-NEXT: 2 error(s) emitted

fn main() -> i32 {
  return same_place_again() + copied_from_another_reference();
}
