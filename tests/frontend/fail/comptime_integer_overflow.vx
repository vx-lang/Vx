// An integer computation that overflows has no compile-time value.
//
// The alternative is a wrapped value, which the compiler would fold into the program as if it
// had worked something out. With no value, the assert cannot be decided (E3033). A wrapped
// value would decide it instead: true gives no error, and false gives E8002.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

fn main() -> i32 {
  comptime {
    let big : i64 = 9223372036854775807i64;
    let over : i64 = big + 1;
    // CHECK: Error[E3033] at [[@LINE+1]]:5: this `comptime` block cannot be evaluated: this assert depends on a value known only when the program runs
    assert(over == 0, "the overflow produced a value");
  }
  return 0;
}
