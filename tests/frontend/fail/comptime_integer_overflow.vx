//===----------------------------------------------------------------------===//
// An integer computation that overflows its type has no compile-time value.
//
// The alternative is a wrapped value, which the compiler would fold into the program as if it
// had worked something out. With no value, the assert cannot be decided (E3033). A wrapped
// value would decide it instead: true gives no error, and false gives E8002. The `i32` and
// `u32` blocks check that the limit is the one of the operands' type, not of `i64`.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

fn main() -> i32 {
  comptime {
    let big : i64 = 9223372036854775807i64;
    let over : i64 = big + 1;
    // CHECK-DAG: Error[E3033] at {{.*}}comptime_integer_overflow.vx:[[@LINE+1]]:5: this `comptime` block cannot be evaluated: this assert depends on a value known only when the program runs
    assert(over == 0, "the overflow produced a value");
  }
  comptime {
    let over : i32 = 2147483647i32 + 1i32;
    // CHECK-DAG: Error[E3033] at {{.*}}comptime_integer_overflow.vx:[[@LINE+1]]:5: this `comptime` block cannot be evaluated: this assert depends on a value known only when the program runs
    assert(over == 0i32, "the i32 overflow produced a value");
  }
  comptime {
    let under : u32 = 3u32 - 5u32;
    // CHECK-DAG: Error[E3033] at {{.*}}comptime_integer_overflow.vx:[[@LINE+1]]:5: this `comptime` block cannot be evaluated: this assert depends on a value known only when the program runs
    assert(under == 0u32, "the u32 subtraction produced a value");
  }
  return 0;
}
