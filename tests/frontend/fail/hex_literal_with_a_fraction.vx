// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A hex, octal or binary literal is an integer. Write a fraction in decimal.

fn main() -> i32 {
  // CHECK: a hex literal cannot have a fraction: '0x1.5'
  let a : f32 = 0x1.5;
  return 0;
}
