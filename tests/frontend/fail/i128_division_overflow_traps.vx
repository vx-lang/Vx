// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen -O2 2>&1 | FileCheck %s
//
// The smallest `i128` divided by -1 is one more than the largest `i128`, so it
// stops the program. The overflow guard must use a full-width -1, not a 64-bit
// ones constant.
//
// Build MIN as (i64::MIN as i128) << 64 so the test does not need a 39-digit
// literal. Run under --legacy-codegen only: flat-codegen still declines on
// `print` of i128 (`type-not-modelled`).

// CHECK: attempt to divide with overflow
// CHECK-NOT: wrong answer
fn div(a : i128, b : i128) -> i128 {
  return a / b;
}

fn main() -> i32 {
  let min64 : i64 = -9223372036854775807 - 1;
  let min : i128 = (min64 as i128) << 64;
  print(div(min, -1i128));
  print!(" wrong answer");
  return 0;
}
