// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
// File::open accepts named modes, not raw integer values.
// CHECK: Error[E3003]{{.*}}'File::open'. Expected OpenMode, got i32
import std::fs;

fn main() -> i32 {
  unsafe { let _file = File::open("unused", 3); }
  return 0;
}
