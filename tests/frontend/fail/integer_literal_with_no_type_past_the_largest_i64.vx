// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc -j 2 %s 2>&1 | FileCheck %s
//
// A literal with no suffix, where nothing around it gives it a type, is at most an `i64`. A
// literal from 2^63 up to 2^64 - 1 is an error that suggests a `u64` suffix. It used to crash
// the code generator.

fn id<T>(x : T) -> T {
  return x;
}

fn main() -> i32 {
  // CHECK: Error[E3045] at [[@LINE+3]]:3: 0x8000_0000_0000_0000 does not fit `i64`, which holds -9223372036854775808 up to 9223372036854775807
  // CHECK-NEXT: note: an integer literal with no suffix is at most an `i64`, unless the code around it gives it a type
  // CHECK-NEXT: note: write `0x8000_0000_0000_0000u64` for a `u64`
  let hex = 0x8000_0000_0000_0000;
  // CHECK: Error[E3045] at [[@LINE+2]]:3: 18446744073709551615 does not fit `i64`
  // CHECK: note: write `18446744073709551615u64` for a `u64`
  let decimal = 18446744073709551615;
  // CHECK: Error[E3045] at [[@LINE+2]]:3: -0x8000_0000_0000_0001 does not fit `i64`
  // CHECK-NEXT: note: an integer literal with no suffix
  let below = -0x8000_0000_0000_0001;
  // A negative literal cannot be a `u64`, so the next error follows with no `u64` note.
  // CHECK-NEXT: Error[E3045] at [[@LINE+1]]:3: 0xFFFF_FFFF_FFFF_FFFF does not fit `i64`
  print(0xFFFF_FFFF_FFFF_FFFF);
  // A type parameter and an `as` give no type to the literal.
  // CHECK: Error[E3045] at [[@LINE+1]]:3: 0x8000_0000_0000_0000 does not fit `i64`
  let same = id(0x8000_0000_0000_0000);
  // CHECK: Error[E3045] at [[@LINE+1]]:3: 0xFFFF_FFFF_FFFF_FFFF does not fit `i64`
  let mask = 0xFFFF_FFFF_FFFF_FFFF as u64;
  return 0;
}
// CHECK: 6 error(s) emitted
