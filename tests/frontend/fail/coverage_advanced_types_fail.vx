//===- coverage_advanced_types_fail.vx ------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Enum MyEnum does not have variant VariantB

enum MyEnum {
  VariantA,
}

fn test_missing_variant() -> MyEnum {
  // EXPECT: Enum MyEnum does not have variant VariantB
  let e: MyEnum = MyEnum::VariantB;
  return e;
}
