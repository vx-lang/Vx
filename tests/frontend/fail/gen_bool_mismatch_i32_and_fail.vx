//===- gen_bool_mismatch_i32_and_fail.vx ---------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Type mismatch in logical operation: Scalar(Bool) vs Scalar(I32)

fn main() -> Bool {
  let a: Bool = true;
  let b: i32 = 1i32;
  // EXPECT: Type mismatch
  return a && b;
}
