// Ops of an `mlir!` block that the Metal code generator cannot print. Each one is an error that
// gives the reason.
// - `vector_of_8`: Metal has vectors of 2, 3 or 4 elements only.
// - `lead_dimension_zero_in_one_dimension`: `leadDimension = 0` means the row stride of a memref
//   of 2 dimensions.
// - `unaligned_bf16_vector`: Metal has no packed vector of bf16, so the load needs an `alignment`.
// - `maximumf_on_vectors`: `arith.maximumf` becomes a comparison that tests for NaN, which Metal
//   does not apply to each element of a vector.
// - `matrix_of_16`: a simdgroup matrix of the Apple GPU is 8 x 8.
//
// RUN: split-file %s %t
// RUN: not vxc %t/vector_of_8.vx --host default --machine fleet/m4-uma.vx --emit-msl -o /dev/null 2>&1 | FileCheck %s --check-prefix=EIGHT
// RUN: not vxc %t/lead_dimension_zero_in_one_dimension.vx --host default --machine fleet/m4-uma.vx --emit-msl -o /dev/null 2>&1 | FileCheck %s --check-prefix=LEAD
// RUN: not vxc %t/unaligned_bf16_vector.vx --host default --machine fleet/m4-uma.vx --emit-msl -o /dev/null 2>&1 | FileCheck %s --check-prefix=BF16
// RUN: not vxc %t/maximumf_on_vectors.vx --host default --machine fleet/m4-uma.vx --emit-msl -o /dev/null 2>&1 | FileCheck %s --check-prefix=NAN
// RUN: not vxc %t/matrix_of_16.vx --host default --machine fleet/m4-uma.vx --emit-msl -o /dev/null 2>&1 | FileCheck %s --check-prefix=SIXTEEN
//
// EIGHT: cannot compile kernel `k`: 'vector.load': a vector of other than 2, 3 or 4 elements, which Metal has no type for
// LEAD: cannot compile kernel `k`: 'gpu.subgroup_mma_load_matrix': `leadDimension = 0` in a memref that does not have 2 dimensions
// BF16: cannot compile kernel `k`: 'vector.load': a vector load or store of bf16, i1 or i64 with no alignment attribute of the size of the vector
// NAN: cannot compile kernel `k`: 'arith.cmpf': a comparison of vectors that tests for NaN. Metal compares vectors only with ==, !=, <, <=, > and >=
// SIXTEEN: cannot compile kernel `k`: 'gpu.subgroup_mma_load_matrix': a simdgroup matrix that is not 8 x 8

//--- vector_of_8.vx
pub fn k(out : &mut Tensor<f32, [?], Memory::HBM>, a : &Tensor<f16, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for l in 0..32 across lanes(32) {
        let _v = mlir!( inputs : (%o = out : memref<?xf32>, %a = a : memref<?xf16>, %l = l : i32), returns : f32, dialects : ["arith", "vector", "gpu", "memref"], ensures : [reads_only(a), writes_only(out[l])]) {
          %c0 = arith.constant 0 : index
          %k = arith.index_cast %l : i32 to index
          %v = vector.load %a[%k] : memref<?xf16>, vector<8xf16>
          %h = vector.extract %v[0] : f16 from vector<8xf16>
          %r = arith.extf %h : f16 to f32
          memref.store %r, %o[%k] : memref<?xf32>
          macro.yield %r : f32
        };
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}

//--- lead_dimension_zero_in_one_dimension.vx
pub fn k(out : &mut Tensor<f32, [?], Memory::HBM>, a : &Tensor<f16, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for l in 0..32 across lanes(32) {
        let _v = mlir!( inputs : (%o = out : memref<?xf32>, %a = a : memref<?xf16>, %l = l : i32), returns : f32, dialects : ["arith", "vector", "gpu", "memref"], ensures : [reads_only(a), writes_only(out[l])]) {
          %c0 = arith.constant 0 : index
          %k = arith.index_cast %l : i32 to index
          %m = gpu.subgroup_mma_load_matrix %a[%c0] {
            leadDimension = 0 : index
          } : memref<?xf16> -> !gpu.mma_matrix<8x8xf16, "AOp">
          %mb = gpu.subgroup_mma_load_matrix %a[%c0] {
            leadDimension = 8 : index
          } : memref<?xf16> -> !gpu.mma_matrix<8x8xf16, "BOp">
          %z = arith.constant 0.0 : f32
          %c = gpu.subgroup_mma_constant_matrix %z : !gpu.mma_matrix<8x8xf32, "COp">
          %d = gpu.subgroup_mma_compute %m, %mb, %c : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
          gpu.subgroup_mma_store_matrix %d, %o[%c0] {
            leadDimension = 8 : index
          } : !gpu.mma_matrix<8x8xf32, "COp">, memref<?xf32>
          %r = arith.constant 0.0 : f32
          memref.store %r, %o[%k] : memref<?xf32>
          macro.yield %r : f32
        };
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}

//--- unaligned_bf16_vector.vx
pub fn k(out : &mut Tensor<f32, [?], Memory::HBM>, a : &Tensor<bf16, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for l in 0..32 across lanes(32) {
        let _v = mlir!( inputs : (%o = out : memref<?xf32>, %a = a : memref<?xbf16>, %l = l : i32), returns : f32, dialects : ["arith", "vector", "gpu", "memref"], ensures : [reads_only(a), writes_only(out[l])]) {
          %c0 = arith.constant 0 : index
          %k = arith.index_cast %l : i32 to index
          %v = vector.load %a[%k] : memref<?xbf16>, vector<4xbf16>
          %h = vector.extract %v[0] : bf16 from vector<4xbf16>
          %r = arith.extf %h : bf16 to f32
          memref.store %r, %o[%k] : memref<?xf32>
          macro.yield %r : f32
        };
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}

//--- maximumf_on_vectors.vx
pub fn k(out : &mut Tensor<f32, [?], Memory::HBM>, a : &Tensor<f32, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for l in 0..32 across lanes(32) {
        let _v = mlir!( inputs : (%o = out : memref<?xf32>, %a = a : memref<?xf32>, %l = l : i32), returns : f32, dialects : ["arith", "vector", "gpu", "memref"], ensures : [reads_only(a), writes_only(out[l])]) {
          %c0 = arith.constant 0 : index
          %k = arith.index_cast %l : i32 to index
          %v = vector.load %a[%k] : memref<?xf32>, vector<4xf32>
          %u = arith.constant dense<1.0> : vector<4xf32>
          %w = arith.maximumf %v, %u : vector<4xf32>
          %r = vector.extract %w[0] : f32 from vector<4xf32>
          memref.store %r, %o[%k] : memref<?xf32>
          macro.yield %r : f32
        };
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}

//--- matrix_of_16.vx
pub fn k(out : &mut Tensor<f32, [?], Memory::HBM>, a : &Tensor<f16, [?], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      for l in 0..32 across lanes(32) {
        let _v = mlir!( inputs : (%o = out : memref<?xf32>, %a = a : memref<?xf16>, %l = l : i32), returns : f32, dialects : ["arith", "vector", "gpu", "memref"], ensures : [reads_only(a), writes_only(out[l])]) {
          %c0 = arith.constant 0 : index
          %k = arith.index_cast %l : i32 to index
          %m = gpu.subgroup_mma_load_matrix %a[%c0] {
            leadDimension = 16 : index
          } : memref<?xf16> -> !gpu.mma_matrix<16x16xf16, "AOp">
          %mb = gpu.subgroup_mma_load_matrix %a[%c0] {
            leadDimension = 16 : index
          } : memref<?xf16> -> !gpu.mma_matrix<16x16xf16, "BOp">
          %z = arith.constant 0.0 : f32
          %c = gpu.subgroup_mma_constant_matrix %z : !gpu.mma_matrix<16x16xf32, "COp">
          %d = gpu.subgroup_mma_compute %m, %mb, %c : !gpu.mma_matrix<16x16xf16, "AOp">, !gpu.mma_matrix<16x16xf16, "BOp"> -> !gpu.mma_matrix<16x16xf32, "COp">
          gpu.subgroup_mma_store_matrix %d, %o[%c0] {
            leadDimension = 16 : index
          } : !gpu.mma_matrix<16x16xf32, "COp">, memref<?xf32>
          %r = arith.constant 0.0 : f32
          memref.store %r, %o[%k] : memref<?xf32>
          macro.yield %r : f32
        };
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
