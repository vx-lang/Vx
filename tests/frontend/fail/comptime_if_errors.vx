// RUN: not vxc %s 2>&1 | FileCheck %s

// From comptime_active_branch_error.vx
fn test_0() on Topology::CPU -> void {
  if comptime
  Topology::Current == Topology::CPU {
    // This branch is ACTIVE because Topology::Current is Topology::CPU
    // This type mismatch SHOULD trigger a compiler error.
    let x : f32 = "this is a string, not a float";
  } else {
    // This branch is PRUNED.
    // This type mismatch should NOT trigger a compiler error.
    let y : f32 = "world";
  }
}

// From comptime_if_not_bool.vx
fn test_1() -> void {
  if comptime
  5 { let x = 1; }
}

// From comptime_if_pruned_syntax_error.vx
fn test_2() -> void {
  if comptime
  false {
    let x = ; // Syntax error should be caught in parsing before comptime eval
  }
}

// From comptime_if_runtime_cond.vx
fn test_3() -> void {
  let condition = true;
  if comptime
  condition { let x = 1; }
}

