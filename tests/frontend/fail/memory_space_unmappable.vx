//===----------------------------------------------------------------------===//
// A declared memory with no `scope:` has no address space on the target. A
// tensor placed there is an error on both code generators, whether the type
// names the device or the memory. TMEM is the motivating case: Blackwell
// tensor memory has no plain GPU analogue, so it needs an explicit decision.
//
// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: not vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s

Memory TMEM {
  within: Memory::GPU_HBM, capacity: 256 KiB, granule: 16 KiB, managed: explicit
}
Topology TmemDev {
  memory: Memory::TMEM,
  visible: [Memory::TMEM]
}

// CHECK: Error[E6037] at {{.*}}memory_space_unmappable.vx:[[@LINE+1]]:4: `Topology::TmemDev` in parameter 'p' of function 'by_device' has no address space on the target: `Memory::TMEM` has no `scope:`
fn by_device(p : Tensor<f32, [4, 4], Topology::TmemDev>) -> i32 {
  return 0;
}

// CHECK: Error[E6037] at {{.*}}memory_space_unmappable.vx:[[@LINE+1]]:4: `Memory::TMEM` in parameter 'p' of function 'by_memory' has no address space on the target: `Memory::TMEM` has no `scope:`
fn by_memory(p : Tensor<f32, [4, 4], Memory::TMEM>) -> i32 {
  return 0;
}

fn main() -> i32 {
  return 0;
}
