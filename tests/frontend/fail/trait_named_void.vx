// `void` is the built-in type with one value, so a program cannot declare a
// trait with that name.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error at 14:7: `void` is a built-in type and cannot be declared

trait void {
  fn f(self : &Self) -> i32;
}

fn main() -> i32 {
  return 0;
}
