// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A `Processes` is the right to start other programs. Only `std::process` can make one, and a
// program gets one in its `Root`. Code in another file cannot:
// - copy a `Processes` with an `impl Copy` (E3066),
// - make a `Processes` with a struct literal (E8014),
// - get the process right of the program, even in `unsafe`: only `std` can call
//   `processes_of_the_program` (E5005).
import std::process;

impl Copy for Processes {}

fn forged() -> Processes {
  return Processes {};
}

fn taken() -> Processes {
  return unsafe { processes_of_the_program() };
}

fn main() -> i32 {
  return 0;
}

// CHECK: Error[E3066] at {{.*}}.vx:18:1: `impl Copy for Processes` is in `the_process_right_cannot_be_forged.vx`, and `process.vx` declares `Processes`
// CHECK: Error[E8014] at {{.*}}.vx:21:10: this struct literal builds a `Processes`. `Processes` has an invariant, so only code in `process.vx` can build it
// CHECK: Error[E5005] at {{.*}}.vx:25:19: `processes_of_the_program` is `pkg` in `process.vx`, so only the package `std` can call it
