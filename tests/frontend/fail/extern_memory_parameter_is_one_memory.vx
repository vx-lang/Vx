//===----------------------------------------------------------------------===//
// Two parameters of an extern function that name the same memory parameter `M` take pointers
// into the same memory. The first pointer argument decides `M`, so a second pointer into
// another memory is E6029.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK-DAG: argument 2 of 'vendor_copy' is a pointer into host memory, but the parameter wants a pointer into Memory::GPU_HBM
// CHECK-DAG: argument 2 of 'vendor_copy' is a pointer into Memory::GPU_HBM, but the parameter wants a pointer into host memory

extern "C" {
  fn vendor_copy<M : Memory>(from : *const f32 in Memory::M, to : *mut f32 in Memory::M, n : i64) -> void;
}

fn main() -> i32 {
  let mut host = Tensor<f32, [4]>::fill(0.0);
  let mut gpu = transfer(Tensor<f32, [4]>::fill(1.0), Memory::GPU_HBM);
  unsafe {
    vendor_copy(gpu.as_ptr(), host.as_mut_ptr(), 4);
    vendor_copy(host.as_ptr(), gpu.as_mut_ptr(), 4);
  }
  return 0;
}
