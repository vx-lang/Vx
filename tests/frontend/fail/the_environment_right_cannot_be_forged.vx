// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// An `Environment` is the right to read the environment variables. Only `std::env` can make one,
// and a program gets one in its `Root`. Code in another file cannot:
// - copy an `Environment` with an `impl Copy` (E3066),
// - make an `Environment` with a struct literal (E8014),
// - get the environment right of the program, even in `unsafe`: only `std` can call
//   `environment_of_the_program` (E5005).
import std::env;

impl Copy for Environment {}

fn forged() -> Environment {
  return Environment {};
}

fn taken() -> Environment {
  return unsafe { environment_of_the_program() };
}

fn main() -> i32 {
  return 0;
}

// CHECK: Error[E3066] at {{.*}}.vx:18:1: `impl Copy for Environment` is in `the_environment_right_cannot_be_forged.vx`, and `env.vx` declares `Environment`
// CHECK: Error[E8014] at {{.*}}.vx:21:10: this struct literal builds an `Environment`. `Environment` has an invariant, so only code in `env.vx` can build it
// CHECK: Error[E5005] at {{.*}}.vx:25:19: `environment_of_the_program` is `pkg` in `env.vx`, so only the package `std` can call it
