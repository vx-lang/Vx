// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=E3005
//
// A comparison of two values of different types is error E3005 at the comparison.
// The message names the type on the left, then the type on the right. A comparison of
// two values of the same type, such as `c < y` below, has no error.
//
// CHECK: E3005{{.*}}:18:8: Type mismatch in relational operation: i32 vs i64
// CHECK: E3005{{.*}}:27:12: Type mismatch in relational operation: f32 vs f64

fn less_than(a: i32, b: i64) -> i32 {
  if a < b {
    return 1;
  }
  return 0;
}

fn equal(x: f32, y: f64) -> bool {
  let c = 1.0f64;
  let same_type = c < y;
  return x == y && same_type;
}
