// `void` is the built-in type with one value, so a program cannot declare a
// struct with that name.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error at 14:8: `void` is a built-in type and cannot be declared

struct void {
  x : i32,
}

fn main() -> i32 {
  return 0;
}
