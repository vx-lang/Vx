// RUN: not vxc %s 2>&1 | FileCheck %s
// The old spelling, `impl transfer Memory::A -> Memory::B`, has nowhere to name a
// topology -- which is the whole reason it changed. A program still carrying it is
// out of date rather than wrong, so it gets a message that says where to go (Vx#353).
// CHECK: is now
// CHECK: impl Transfer<Memory::A, Memory::B> for Topology::X
Topology Dev {
  memory: Memory::L2,
  visible: [Memory::L2, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::L2 : 10 GB/s,
  transfer Memory::L2 -> Memory::SMEM
}
impl transfer Memory::L2 -> Memory::SMEM {
  fn move_tile(src: &Tensor<f32, [4]>, dst: &mut Tensor<f32, [4]>) -> i32 {
    raw::barrier();
    return 0;
  }
}
fn main() -> i32 {
  return 0;
}
