//===----------------------------------------------------------------------===//
// `let mut index = f(..)` keeps the `ensures` bounds of `f` only until `index` changes. After
// `index = index + k`, the bound `index < k` is false, so the call to `consume_index` is an error.
//
// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn bounded_from_buffer(_data : *const i32, k : i32) -> i32
requires k > 0
ensures return >= 0 && return < k {
  return k - 1;
}

fn consume_index(limit : i32, index : i32) -> i32
requires limit > 0 && index >= 0 && index < limit {
  return index;
}

fn changed_after_the_let(p : *mut i32, k : i32) -> i32
requires valid(p, 1)
requires k > 0 && k < 1000 {
  let mut index = bounded_from_buffer(p as *const i32, k);
  index = index + k;
  // CHECK: E8006] at {{.*}}.vx:[[@LINE+1]]:10: this call to 'consume_index' may not meet its precondition
  return consume_index(k, index);
}

fn main() -> i32 {
  let mut cell = 0;
  let p : *mut i32 = &mut cell;
  return changed_after_the_let(p, 4);
}
// CHECK: 1 error(s) emitted
