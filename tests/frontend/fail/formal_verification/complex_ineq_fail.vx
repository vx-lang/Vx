//===- complex_ineq_fail.vx ---------------------------------===//
fn test_complex_fail_0(X: i32, Y: i32, Z: i32) -> i32
requires X > Y && Y > Z
ensures return < 0
{
    let diff = X - Z;
    return diff;
}

