// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn wrong_sum() -> i64
ensures return == 2147483647 + 1 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_sum' cannot prove postcondition
  return -2147483648i64;
}

fn wrong_product() -> i64
ensures return == 65536 * 65536 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_product' cannot prove postcondition
  return 0i64;
}

fn wrong_unsigned_sum() -> u64
ensures return == 4294967295 + 1 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_unsigned_sum' cannot prove postcondition
  return 0u64;
}

fn wrong_remainder() -> i64
ensures return == (2147483647 + 1) % 10 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_remainder' cannot prove postcondition
  return -8i64;
}

fn wrong_cast_source() -> i64
ensures return == ((2147483647 + 1) as i64) {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_cast_source' cannot prove postcondition
  return 2147483648i64;
}

fn _argument_identity(value : i64) -> i64
ensures return == value {
  return value;
}

fn wrong_argument_context() -> i64
ensures return == _argument_identity(2147483647 + 1) {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_argument_context' cannot prove postcondition
  return -2147483648i64;
}

fn _identity32(value : i32) -> i32
ensures return == value {
  return value;
}

fn wrong_declared_unary_type(value : i32) -> i64
requires value == -2147483648i64
ensures return == -_identity32(value) {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_declared_unary_type' cannot prove postcondition
  return 2147483648i64;
}

fn wrong_unsigned_negation() -> u32
ensures return == -1 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_unsigned_negation' cannot prove postcondition
  return 0u32;
}

fn main() -> i32 {
  return 0;
}
