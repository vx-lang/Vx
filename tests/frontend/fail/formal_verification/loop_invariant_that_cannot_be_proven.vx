// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// Each invariant below is false when its loop starts, and the loop body does not keep it. So each
// invariant gets two errors: E8008 for the start of the loop and E8009 for the end of the body.
// Each error points at the invariant and quotes it.

fn count_with_while() -> i32 {
  let mut i : i32 = 0;
  // CHECK: Error[E8008] at {{.*}}.vx:[[@LINE+2]]:28: this loop invariant `i < 0` may not hold when the loop starts: the compiler cannot prove it from what it knows before the loop{{$}}
  // CHECK: Error[E8009] at {{.*}}.vx:[[@LINE+1]]:28: this loop invariant `i < 0` may not hold after a pass through the loop body: the compiler cannot prove it from what it knows at the end of the body{{$}}
  while i < 10 invariant(i < 0) {
    i = i + 1;
  }
  return i;
}

fn count_with_for() -> i32 {
  let mut k : i32 = 5;
  // CHECK: Error[E8008] at {{.*}}.vx:[[@LINE+2]]:29: this loop invariant `k < 5` may not hold when the loop starts: the compiler cannot prove it from what it knows before the loop{{$}}
  // CHECK: Error[E8009] at {{.*}}.vx:[[@LINE+1]]:29: this loop invariant `k < 5` may not hold after a pass through the loop body: the compiler cannot prove it from what it knows at the end of the body{{$}}
  for j in 0..3 invariant(k < 5) {
    k = k + 1;
  }
  return k;
}

fn main() -> i32 {
  return 0;
}
