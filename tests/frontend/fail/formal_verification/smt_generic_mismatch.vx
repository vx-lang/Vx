//===- smt_generic_mismatch.vx ---------------------------------*- Vx -*-===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Contract violated for Verified return type: Must be square

fn wrap<N, M>(val : Tensor<f32, [ N, M ]>) -> Verified<Tensor<f32, [N, M]>> {
  assert(N == M, "Must be square");
  return Verified(val);
}

fn outer<A, B>(t : Tensor<f32, [ A, B ]>)
    ->Verified<Tensor<f32, [A, B]>> { return wrap(t); }

fn main()
    ->i32 {
  let n : i32 = 10;
  let m : i32 = 20; // Deliberate mismatch
  // assert(n == m, "Pre-condition for outer"); // If we omit the assert, SMT
  // solver fails to prove it!
  let t : Tensor<f32, [ n, m ]> = Tensor_f32(n, m);
  let v : Verified<Tensor<f32, [ n, m ]>> = outer(t);
  return 0;
}
