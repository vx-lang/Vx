//===- loop_inv_fail.vx ---------------------------------===//
fn test_loop_fail_0(N: i32) -> i32
requires N > 73
ensures return > 73
{
    // FAILS because invariant requires more than N provides
    for j in 0..10 invariant(N > 83) {
        let dummy = N;
    }
    return N;
}

