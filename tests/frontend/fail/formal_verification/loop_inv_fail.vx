//===- loop_inv_fail.vx ---------------------------------===//
fn test_loop_fail_0(N: i32) -> i32
requires N > 5
ensures return > 0
{
    // FAILS because invariant N > 10 is not guaranteed by N > 5
    for i in 0..10 invariant(N > 10) {
        let dummy = N;
    }
    return N;
}

