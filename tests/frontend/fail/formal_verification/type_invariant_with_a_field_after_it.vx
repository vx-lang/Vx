// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// The invariants of a struct come after its last field. A field after an invariant is an error.

struct Interval {
  lo : i64,
  invariant lo <= 100i64,
  // CHECK: Error at {{.*}}type_invariant_with_a_field_after_it.vx:[[@LINE+1]]:3: a field cannot come after an invariant. Put each field of `Interval` before its first invariant.{{$}}
  hi : i64,
}

fn main() -> i32 {
  return 0;
}
