//===----------------------------------------------------------------------===//
// A call that changes `limit` through `&mut` returns a number below the old `limit`, not
// below the new one. So the compiler must not prove `index < limit` after the call.
//
// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn change_limit(limit : i32, target : &mut i32) -> i32
requires limit > 0
ensures return >= 0 && return < limit {
  *target = 0;
  return limit - 1;
}

fn consume_index(limit : i32, index : i32) -> i32
requires limit > 0 && index >= 0 && index < limit {
  return index;
}

fn a_call_changes_its_argument(k : i32) -> i32
requires k > 1 {
  let mut limit = k;
  let index = change_limit(limit, &mut limit);
  // CHECK: Error[E8006]{{.*}}this call to 'consume_index' may not meet its precondition
  return consume_index(limit, index);
}

fn main() -> i32 {
  return a_call_changes_its_argument(4);
}
