// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: not vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s
// RUN: not vxc %s --action emit-mlir -j 2 2>&1 | FileCheck %s

struct Small {
  value : i32,
}

fn wrong_signedness(p : Small) -> u32
requires p.value == -1
ensures return == p.value % 10 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_signedness' cannot prove postcondition
  return 9u32;
}

fn wrong_overflow_width(p : Small) -> i64
requires p.value == -2147483648i64
ensures return == p.value % -1 {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_overflow_width' cannot prove postcondition
  return 0i64;
}

fn wrong_cast_value(value : i64) -> i32
requires value == 2147483648i64
ensures return == (value as i32) {
  // CHECK: Error[E8001]
  // CHECK-SAME: Function 'wrong_cast_value' cannot prove postcondition
  return 0;
}

fn main() -> i32 {
  return 0;
}
