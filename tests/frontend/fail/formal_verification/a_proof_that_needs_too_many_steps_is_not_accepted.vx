// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// z3 may do a fixed number of steps on one query, not a number of seconds. So this goal fails in
// the same way on a fast machine and on a slow one.

fn cubes_differ(x : i64, y : i64, z : i64) -> i64
requires x > 0 && y > 0 && z > 0 && x < 1000 && y < 1000 && z < 1000
ensures x * x * x + y * y * y != z * z * z {
  // CHECK: z3 found neither a proof nor a counterexample. It may have reached its limit of 1000000 steps
  // CHECK: Error[E8001] at {{.*}}.vx:[[@LINE+1]]:
  return 0;
}

fn main() -> i32 {
  return 0;
}
