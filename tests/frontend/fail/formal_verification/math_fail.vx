//===- math_fail.vx ---------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Function 'test_cancellation_fail' cannot prove postcondition (ensures)
// at compile time

fn test_cancellation_fail(X : i32, Y : i32) -> i32
requires X > 0 && Y > 0
ensures return ==
Y {
  // FAILS because return is X, not Y
  let a = X + Y;
  let b = a - Y;
  return b;
}

fn test_unary_negation_fail(A : i32) -> i32
requires A > 0
ensures return > 0 {
  // FAILS because -A will be negative
  let neg = -A;
  return neg;
}

fn main() -> i32 { return 0; }
