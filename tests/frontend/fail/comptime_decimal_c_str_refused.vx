//===----------------------------------------------------------------------===//
// A comptime function called with a value known only at run time is an error, not a
// run-time call. So is a u64 from 2^63 up, which compile-time integers (i64) cannot hold.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
import core::num;

fn show(n : i64) -> i32 {
  // CHECK: Error[E3033] at {{.*}}comptime_decimal_c_str_refused.vx:[[@LINE+1]]:{{.*}}every argument has to be known
  print!(n.decimal_c_str());
  return 0;
}

fn main() -> i32 {
  show(7i64);
  let big : u64 = 18446744073709551615u64;
  // CHECK: Error[E3033] at {{.*}}comptime_decimal_c_str_refused.vx:[[@LINE+1]]:{{.*}}every argument has to be known
  print!(big.decimal_c_str());
  // Read as a float, the literal lost its low digits and this folded to a wrong number.
  // CHECK: Error[E3033] at {{.*}}comptime_decimal_c_str_refused.vx:[[@LINE+2]]:{{.*}}cannot be evaluated
  let third = comptime {
    18446744073709551615u64 / 3u64
  };
  print(third);
  return 0;
}
