trait Transfer {
    fn transfer(self) -> Self;
}

struct CustomHostData {
    id: i32,
    host_tensor: Pinned<Tensor<f32>, Topology::CPU>,
}

impl Transfer for CustomHostData {
    fn transfer(self) -> CustomHostData {
        // Explicit transfer, but to the WRONG memory space!
        let new_tensor = transfer(self.host_tensor, Memory::CPU_DRAM);
        CustomHostData {
            id: self.id,
            host_tensor: new_tensor,
        }
    }
}

fn main() on Topology::NPU[0] -> i32 {
    let host_data = CustomHostData {
        id: 1,
        host_tensor: tensor<f32>(1024),
    };
    
    // Implicit transfer happens here because CustomHostData implements Transfer.
    // However, the transfer() method above transfers to CPU_DRAM, not NPU.
    // So accessing it on the NPU should still throw a cross-topology error!
    let x = host_data.host_tensor[0];
    return 0;
}
