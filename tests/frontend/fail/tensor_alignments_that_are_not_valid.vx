//===----------------------------------------------------------------------===//
// `aligned(N)` in a tensor type. A tensor fits where a smaller alignment is asked, so `takes_any`
// accepts `a`, and `wants_1024` refuses `b`, which has only the 128 bytes of its space. N must be
// at least the `alignment:` of the space, the space must be one whose storage the compiler lays
// out, and N must be a power of two.
//
// RUN: split-file %s %t
// RUN: not vxc %t/types.vx 2>&1 | FileCheck %s --check-prefix=TYPES --implicit-check-not=Error
// RUN: not vxc %t/parse.vx 2>&1 | FileCheck %s --check-prefix=PARSE
// TYPES-DAG: Error[E3003]{{.*}}wants_1024{{.*}}Tensor<f32, [16], Memory::SMEM, aligned(1024)>{{.*}}Tensor<f32, [16], Memory::SMEM>
// TYPES-DAG: Error[E6034]{{.*}}`aligned(1024)` needs a space whose storage the compiler lays out, one declared with `scope: sm`, `cta` or `thread`, and 'HBM' is not
// TYPES-DAG: Error[E6034]{{.*}}`aligned(64)` is less than the `alignment: 128 B` of 'SMEM', which every tensor there has
// PARSE: `aligned(N)` needs N to be a power of two, such as 1024

//--- types.vx
Memory CPU_DRAM {}
Memory HBM {
  within: Memory::CPU_DRAM, capacity: 8 GiB, managed: explicit
}
Memory SMEM {
  within: Memory::HBM, capacity: 64 KiB, managed: explicit, alignment: 128 B, scope: sm
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::HBM,
  visible: [Memory::HBM, Memory::SMEM],
  transfer Memory::CPU_DRAM -> Memory::HBM : 63 GB/s
}

fn wants_1024(t : &mut Tensor<f32, [16], Memory::SMEM, aligned(1024)>) on Topology::Dev -> void {
  t[0] = 1.0;
  return;
}

fn takes_any(t : &mut Tensor<f32, [16], Memory::SMEM>) on Topology::Dev -> void {
  t[0] = 2.0;
  return;
}

fn caller() on Topology::Dev -> void {
  let mut a = unsafe {
    Tensor<f32, [16], Memory::SMEM, aligned(1024)>::uninit()
  };
  takes_any(&mut a);
  let mut b = unsafe { Tensor<f32, [16], Memory::SMEM>::uninit() };
  wants_1024(&mut b);
  let mut c = unsafe {
    Tensor<f32, [16], Memory::HBM, aligned(1024)>::uninit()
  };
  c[0] = 3.0;
  let mut d = unsafe {
    Tensor<f32, [16], Memory::SMEM, aligned(64)>::uninit()
  };
  d[0] = 4.0;
  return;
}

fn main() -> i32 {
  return 0;
}

//--- parse.vx
fn main() -> i32 {
  let t = unsafe { Tensor<f32, [16], Memory::SMEM, aligned(1000)>::uninit() };
  return 0;
}
