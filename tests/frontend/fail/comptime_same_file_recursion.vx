//===----------------------------------------------------------------------===//
// Recursion is followed, and the recursive function may live in the file being compiled.
// fact(5) is 120, so asserting 999 stops the build.
//
// Recursion is the only repetition compile-time evaluation has: a `for` inside a called
// body is not run, and a body holding one produces no value at all.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Comptime assert failed: fact(5) is 120, not 999

fn fact(n : i64) -> i64 {
  return if n <= 1 {
    1
  } else {
    n * fact(n - 1)
  };
}

fn main() -> i32 {
  comptime {
    assert(fact(5) == 999, "fact(5) is 120, not 999");
  }
  return 0;
}
