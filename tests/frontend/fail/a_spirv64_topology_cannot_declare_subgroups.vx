//===----------------------------------------------------------------------===//
// An Intel GPU (`arch: spirv64`) runs block and lane loops, but no subgroups
// yet. A subgroup of Vx has 32 lanes, and the driver chooses 8, 16 or 32 lanes
// for each kernel. A SPIR-V kernel cannot ask for 32 yet, so a topology that
// declares a `subgroups` level is an error.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: `subgroups`: the code generator of `spirv64` cannot launch subgroups yet

Memory CPU_DRAM {}

Memory DEV_HBM {
  capacity: 8 GiB, bandwidth: 400 GB/s, managed: cached, scope: device
}

Topology Simd {
  arch: spirv64,
  levels: [blocks(max_lanes: 1024), subgroups(lanes: 32), lanes],
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 60 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 60 GB/s
}

fn main() -> i32 {
  return 0;
}
