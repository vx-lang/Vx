// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Enum variant Option::Some expects 1 payload arguments, got 2
enum Option<T> {
  Some(T),
  None
}

fn main() -> i32 {
  let a = Option::Some(10);
  let b = Option::None;
  let c = Option::Some(10, 20); // fail: expects 1 argument
  let d = Option::None(10);     // fail: expects no argument
  return 0;
}
