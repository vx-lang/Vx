//===----------------------------------------------------------------------===//
// An `across` loop calls `add_one`, which runs on any topology and has no contract. The compiler
// makes a copy of `add_one` for the GPU. The error names `add_one`, not that copy, and it says
// which contract makes the call legal.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: not vxc %s -j 2 --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Error[E6032] at {{.*}}a_call_in_an_across_loop_to_a_function_on_any_topology.vx:25:27: the call to `add_one` may write through an argument, and the checker does not read its body. If `add_one` writes no memory, give it `ensures writes_only()`. If it only reads a tensor parameter `t`, give it `ensures reads_only(t)`. Or write its work in the loop

fn add_one(x : i32) on Topology::Any -> i32 {
  return x + 1;
}

fn main() -> i32 {
  let mut out = transfer(Tensor<i32, [64]>::fill(0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..2 across blocks {
      for l in 0..32 across lanes {
        out[b * 32 + l] = add_one(l);
      }
    }
  }
  let o = transfer(out, Memory::CPU_DRAM);
  println!("{}", o[63]);
  return 0;
}
