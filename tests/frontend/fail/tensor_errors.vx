//===- tensor_errors.vx - Vx Compiler ------------------------------*- Vx -*-===//
// CHECK: Type mismatch in variable declaration 't_host'
// CHECK: Missing generic argument for Tensor initialization.
// CHECK: Generic argument to Tensor must be a scalar type.
// CHECK: reshape arithmetic mismatch: source has 16384 elements, target has 256
// CHECK: transpose permutation map must not contain duplicates
// CHECK: Type mismatch in argument 1 for function 'requires_specific_layout'.
//
// Part of the Vx Project, under the BSD 3-Clause License.
// See LICENSE for license information.
// SPDX-License-Identifier: BSD-3-Clause
//
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn requires_specific_layout(t : Tensor<f32, [ 128, 256 ]>) -> i32 {
  return 0;
}

fn main() -> i32 {
  // 1. Invalid tensor init
  let t_host : Tensor<f32> = true;

  // 2. Generic missing
  let a = Tensor([10]);

  // 3. Generic not scalar
  let b = Tensor<Tensor<f32>>([10]);

  // 4. Invalid reshape
  let c : Tensor<f32, [ 128, 128 ]> = 1.0;
  let d = c.reshape([256]);

  // 5. Invalid transpose
  let e = c.transpose([ 0, 0 ]);

  // 6. Layout mismatch
  requires_specific_layout(c);

  return 0;
}
