// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc -j 2 %s 2>&1 | FileCheck %s
//
// A literal has no position of its own, so a literal that does not fit its type is reported
// at the statement that holds it. Each statement kind below holds one such literal.

fn give() -> u8 {
  // CHECK: Error[E3045] at [[@LINE+1]]:3: 0x1FF does not fit `u8`
  return 0x1FF;
}

fn main() -> i32 {
  let mut x : u8 = 0;
  // CHECK: Error[E3045] at [[@LINE+1]]:3: 0x100 does not fit `u8`
  x = 0x100;
  // CHECK: Error[E3045] at [[@LINE+1]]:3: 0b1_0000_0000 does not fit `u8`
  if x == 0b1_0000_0000 {
    // CHECK: Error[E3045] at [[@LINE+1]]:5: 0o777 does not fit `u8`
    let inner : u8 = 0o777;
    print(inner);
  }
  // CHECK: Error[E3045] at [[@LINE+1]]:3: 0x1_FF does not fit `u8`
  let t = Tensor<u8, [2]>::fill(0x1_FF);
  print(t[0]);
  print(give());
  return 0;
}
// CHECK: 5 error(s) emitted
