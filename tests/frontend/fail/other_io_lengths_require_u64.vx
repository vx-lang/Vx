// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
// Every remaining public byte-count method rejects a signed length.
// CHECK: Error[E3003]{{.*}}'stderr_write'. Expected u64, got i64
// CHECK: Error[E3003]{{.*}}'stdin_read'. Expected u64, got i64
// CHECK: Error[E3003]{{.*}}'TcpStream::write_raw'. Expected u64, got i64
// CHECK: Error[E3003]{{.*}}'UdpSocket::send_to_raw'. Expected u64, got i64
import std::io;
import std::net;

fn use_an_i64_length(stream : &mut TcpStream, socket : &mut UdpSocket) -> void {
  unsafe {
    let length : i64 = 1;
    let _stderr_count = stderr_write(0 as *const u8, length);
    let _stdin_count = stdin_read(0 as *mut u8, length);
    let _write_count = (*stream).write_raw(0 as *const u8, length);
    let _send_count = (*socket).send_to_raw(0 as *const u8, length, "127.0.0.1:0");
  }
}

fn main() -> i32 {
  return 0;
}
