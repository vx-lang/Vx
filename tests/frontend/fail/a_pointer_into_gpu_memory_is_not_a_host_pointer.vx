//===----------------------------------------------------------------------===//
// `add_mut` on a pointer into GPU memory gives a pointer into GPU memory, never a host pointer.
// A memory parameter `M` stands for one memory in each call. `read` takes only a host pointer.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

import core::ptr;

fn both<T, M : Memory>(a : *mut T in Memory::M, b : *mut T in Memory::M) -> *mut T in Memory::M {
  return a;
}

fn lose_the_memory(p : *mut f32 in Memory::GPU_HBM) -> *mut f32 {
  // CHECK: Error[E3002] at {{.*}}.vx:[[@LINE+1]]:3: Type mismatch on return. Expected *mut f32, got *mut f32 in Memory::GPU_HBM
  return add_mut(p, 1usize);
}

fn two_memories(p : *mut f32 in Memory::GPU_HBM, q : *mut f32) -> *mut f32 in Memory::GPU_HBM {
  // CHECK: Error[E3003] at {{.*}}.vx:[[@LINE+1]]:10: Failed to deduce types for generic function 'both': Expected *mut T in Memory::M, got *mut f32
  return both(p, q);
}

fn read_on_the_gpu(p : *const f32 in Memory::GPU_HBM) -> f32 {
  // CHECK: Error[E3003] at {{.*}}.vx:[[@LINE+1]]:19: Failed to deduce types for generic function 'read': Expected *const T, got *const f32 in Memory::GPU_HBM
  return unsafe { read(add(p, 1usize)) };
}

fn main() -> i32 {
  return 0;
}
