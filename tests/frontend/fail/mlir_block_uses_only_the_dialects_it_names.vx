// RUN: not vxc %s 2>&1 | FileCheck %s
//
// The `dialects` list of an `mlir!` block names the dialects that its operations come from, and
// only real dialects. This program used to compile and print 824.

// The block uses `math.ctpop`, but its list names only `linalg`.
fn count_ones(x : i32) -> i32 {
  // CHECK-DAG: E8010{{.*}}vx:[[@LINE+1]]:{{.*}}uses `%r = math.ctpop %a : i32`, but its `dialects` list does not name `math`
  return mlir!(inputs : (%a = x : i32), returns : i32, dialects : ["linalg"]) {
    %r = math.ctpop %a : i32
    macro.yield %r : i32
  };
}

// The list names a dialect that does not exist, and not `math`.
fn count_zeros(x : i32) -> i32 {
  // CHECK-DAG: E8010{{.*}}vx:[[@LINE+2]]:{{.*}}names `no_such_dialect`, which is not a dialect
  // CHECK-DAG: E8010{{.*}}vx:[[@LINE+1]]:{{.*}}uses `%r = math.ctlz %a : i32`, but its `dialects` list does not name `math`
  return mlir!(inputs : (%a = x : i32), returns : i32, dialects : ["no_such_dialect"]) {
    %r = math.ctlz %a : i32
    macro.yield %r : i32
  };
}

fn main() -> i32 {
  print(count_ones(255));
  print(count_zeros(255));
  return 0;
}
// CHECK: 3 error(s) emitted
