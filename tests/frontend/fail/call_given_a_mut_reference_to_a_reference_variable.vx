// RUN: not vxc %s 2>&1 | FileCheck %s
//
// `set(slot, v)` stores `v` into `*slot`. Each function gives it a `v` that does not live
// as long as the place `slot` points at.

fn set(slot : &mut &i32, v : &i32) -> i32 {
  *slot = v;
  return 0;
}

// `r` now points at `y`, which is gone once the function returns.
fn returned_after_the_call(p : &i32) -> &i32 {
  let y = 1;
  let mut r = p;
  set(&mut r, &y);
  // CHECK-NOT: Error
  // CHECK: Error[E4005] at {{.*}}call_given_a_mut_reference_to_a_reference_variable.vx:[[# @LINE + 1]]:3: this returns a value that points into this function's stack frame.
  return r;
}

// `y` is gone once the block ends, and `r` outlives the block.
fn variable_of_an_inner_block() -> i32 {
  let x = 5;
  let mut r = &x;
  if true {
    let y = 7;
    // CHECK-NEXT: Error[E4005] at {{.*}}call_given_a_mut_reference_to_a_reference_variable.vx:[[# @LINE + 1]]:5: `r` is given a value that points at a variable of an inner block, and `r` outlives that block.
    set(&mut r, &y);
  }
  return *r;
}

// `slot` points at a variable of the caller, which outlives `y`.
fn through_a_parameter(slot : &mut &i32) -> i32 {
  let y = 7;
  // CHECK-NEXT: Error[E4005] at {{.*}}call_given_a_mut_reference_to_a_reference_variable.vx:[[# @LINE + 1]]:3: this call is given a value that points into this function's stack frame, and a reference through `slot`
  set(slot, &y);
  return 0;
}

fn main() -> i32 {
  return 0;
}
