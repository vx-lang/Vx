//===- formal_verification_bypass_fail.vx -----------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Cannot statically prove assertion for Verified return type

fn verify_bypass<N, M>(val : Tensor<f32, [ N, M ]>, dyn_var : i32)
-> Verified<Tensor<f32, [N, M]>> {
  // EXPECT: Cannot statically prove assertion for Verified return type
  assert(dyn_var == 5, "Dynamic variable constraint failed");
  return val;
}

fn main()
->i32 {
  let t : Tensor<f32, [ 16, 32 ]> = Tensor<f32, [16, 32]>::uninit();
  let dyn : i32 = 5;
  let v : Verified<Tensor<f32, [ 16, 32 ]>> = verify_bypass(t, dyn);
  return 0;
}
