// A computed const whose value does not fit its type is reported even when unused.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

// CHECK: Error[E3044] at {{.*}}const_overflow_unused.vx:[[@LINE+1]]:1: const 'A' has a value that does not fit its declared type
const A : i32 = 2147483647 + 1;

fn main() -> i32 {
  return 0;
}
