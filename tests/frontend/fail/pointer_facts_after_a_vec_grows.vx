//===----------------------------------------------------------------------===//
// `push` can move the buffer of a vector to a new address. So after a `push`, the pointer from
// `as_mut_ptr` has no facts, and a call that requires `valid` or `initialized` gets E8006. The
// note gives the line of the `push`. In a loop, a `push` anywhere in the body ends the facts at
// the start of the body, because the push of one pass comes before the next pass. The error has
// no note when the length is a variable set before the loop. After a `push`, that variable is
// not the length.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

import std::vec;

fn sum(p : *const i64, n : i64) -> i64
requires valid(p, n)
requires initialized(p, n)
{
  let mut total = 0i64;
  for i in 0i64..n {
    total = total + unsafe { p[i] };
  }
  return total;
}

// CHECK: E8006] at {{.*}}pointer_facts_after_a_vec_grows.vx:[[@LINE+7]]:10: this call to 'sum' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `v` (at [[@LINE+5]]:5)
// CHECK: E8006] at {{.*}}pointer_facts_after_a_vec_grows.vx:[[@LINE+5]]:10: this call to 'sum' may not meet its precondition `initialized(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `v` (at [[@LINE+3]]:5)
fn total_after_push(v : &mut Vec<i64>) -> i64 {
  let p = v.as_mut_ptr();
  v.push(1i64);
  return sum(p as *const i64, v.len() as i64);
}

// CHECK: E8006] at {{.*}}pointer_facts_after_a_vec_grows.vx:[[@LINE+8]]:5: this call to 'sum' may not meet its precondition `valid(p, n)`
// CHECK-NOT: note:
// CHECK: E8006] at {{.*}}pointer_facts_after_a_vec_grows.vx:[[@LINE+6]]:5: this call to 'sum' may not meet its precondition `initialized(p, n)`
// CHECK-NOT: note:
fn total_in_a_loop(v : &mut Vec<i64>) -> i64 {
  let p = v.as_mut_ptr();
  let n = v.len() as i64;
  for i in 0i64..3i64 {
    sum(p as *const i64, n);
    v.push(i);
  }
  return 0i64;
}

// CHECK: E8006] at {{.*}}pointer_facts_after_a_vec_grows.vx:[[@LINE+7]]:5: this call to 'sum' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `v`, in a pass of the loop (at [[@LINE+7]]:7)
// CHECK: E8006] at {{.*}}pointer_facts_after_a_vec_grows.vx:[[@LINE+5]]:5: this call to 'sum' may not meet its precondition `initialized(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `v`, in a pass of the loop (at [[@LINE+5]]:7)
fn total_in_a_loop_with_len(v : &mut Vec<i64>) -> i64 {
  let p = v.as_mut_ptr();
  for i in 0i64..3i64 {
    sum(p as *const i64, v.len() as i64);
    v.push(i);
  }
  return 0i64;
}

fn main() -> i32 {
  let mut v = Vec<i64>::new();
  total_after_push(&mut v);
  total_in_a_loop(&mut v);
  total_in_a_loop_with_len(&mut v);
  return 0;
}
