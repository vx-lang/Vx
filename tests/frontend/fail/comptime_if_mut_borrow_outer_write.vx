// RUN: not vxc %s 2>&1 | FileCheck %s

fn touch(p : &mut Tensor<i64, [1]>) -> void {
  p[0] = 9i64;
}

fn main() -> i32 {
  let mut outside : Tensor<i64, [1]> = [ 0i64 ];
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    let chosen = if true {
      touch(&mut outside);
      1i32
    } else {
      2i32
    };
    chosen
  };
  return value;
}
