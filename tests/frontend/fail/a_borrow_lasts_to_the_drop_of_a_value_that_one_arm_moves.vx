//===----------------------------------------------------------------------===//
// `Gone(_)` moves nothing, so when it runs, `t` drops at the end of `main`. Its `drop` reads `x`,
// so `x` stays borrowed until then. Rust refuses this program too.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

struct Reader {
  r : &i32,
}

impl Drop for Reader {
  fn drop(self : &mut Reader) -> void {
    print!("sees {} ", *self.r);
  }
}

enum Two {
  Has(Reader),
  Gone(Reader),
}

fn main() -> i32 {
  let mut x = 1;
  let t = Two::Has(Reader {
    r: &x
  });
  match t {
    Two::Has(a) => {
      print!("h ");
    }
    Two::Gone(_) => {
      print!("g ");
    }
  }
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `x` is assigned while it is borrowed
  x = 2;
  print!("x{} ", x);
  return 0;
}
