// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// After `y = 0 - 5`, the fact `y > 0` is no longer true. It comes from the assert in `pos` and
// from the `if` in `pos_in_branch`. So nothing proves either `ensures` (E8001). The prover used
// to keep the fact, so this compiled, and both functions returned -5.

fn pos(x : i32) -> i32
ensures return > 0 {
  let mut y = x;
  assert(y > 0, "y is positive");
  y = 0 - 5;
  // CHECK: Error[E8001] at [[@LINE+1]]:3: Function 'pos' cannot prove postcondition (ensures) at compile time
  return y;
}

fn pos_in_branch(x : i32) -> i32
ensures return > 0 {
  let mut y = x;
  if y > 0 {
    y = 0 - 5;
    // CHECK: Error[E8001] at [[@LINE+1]]:5: Function 'pos_in_branch' cannot prove postcondition (ensures) at compile time
    return y;
  }
  return 1;
}

fn main() -> i32 {
  print(pos(3) + pos_in_branch(3));
  return 0;
}
