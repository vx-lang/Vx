// RUN: not vxc %s 2>&1 | FileCheck %s

fn main(n : i32) -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}cannot be evaluated{{.*}}holds a statement the evaluator cannot run
  let value = comptime {
    let chosen = if n > 0i32 {
      outside = 4i32;
      1i32
    } else {
      2i32
    };
    7i32
  };
  return value;
}
