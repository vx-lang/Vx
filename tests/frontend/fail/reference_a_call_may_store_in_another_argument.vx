// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A call may store a reference it is given in another argument it is given as a `&mut`. After
// `set_r(&mut h, &y)` or `v.push(&x)`, `h` and `v` borrow what they may hold.

import std::vec;

struct Holder {
  r : &i64,
}

fn set_r(h : &mut Holder, b : &i64) -> void {
  h.r = b;
}

fn stored_by_a_function() -> i64 {
  let x = 1i64;
  let mut h = Holder {
    r : &x
  };
  let mut y = 2i64;
  set_r(&mut h, &y);
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `y` is assigned while it is borrowed
  y = 5i64;
  return *h.r;
}

fn stored_by_a_method() -> i64 {
  let mut x = 1i64;
  let mut v = Vec<&i64>::new();
  v.push(&x);
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `x` is assigned while it is borrowed
  x = 5i64;
  return *v.get(0);
}

fn stored_from_a_reference_variable() -> i64 {
  let x = 1i64;
  let mut h = Holder {
    r : &x
  };
  let mut y = 2i64;
  let ry = &y;
  set_r(&mut h, ry);
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `y` is assigned while it is borrowed
  y = 5i64;
  return *h.r;
}

fn main() -> i32 {
  return (stored_by_a_function() + stored_by_a_method() + stored_from_a_reference_variable())
  as i32;
}

// CHECK: 3 error(s) emitted
