// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A closure parameter needs a type. The error says so and shows the type that `map` wants.
// CHECK: Error[E3003]
// CHECK-SAME: argument 1 of 'Option<i64>::map' is a closure whose parameter 1 has no type
// CHECK-SAME: A closure parameter needs a type, as in `| x : i64 | ...`
import core::option;

fn main() -> i32 {
  let o = Option<i64>::Some(3i64);
  let _p = o.map(|x| x + 1i64);
  return 0;
}
