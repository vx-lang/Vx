// `-j` refuses a flag whose meaning it does not implement rather than dropping it: the
// parallel frontend does not run the seam checks of `--verify-seams`, and a compile that
// quietly skipped them would report success for the wrong thing.
//
// RUN: (vxc -j 2 --verify-seams --emit-mlir %s 2>&1; echo "exit=$?") | FileCheck %s

fn main() -> i32 {
  return 0;
}

// CHECK: -j does not support --verify-seams yet
// CHECK: exit=1
