//===----------------------------------------------------------------------===//
// A `static mut` is refused, with a message that names the item.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

// CHECK: Error at {{.*}}static_mut_is_not_supported.vx:[[@LINE+1]]:1: Vx has no `static mut` yet, so a program cannot change `COUNTER`. Remove `mut` to make `COUNTER` a read-only `static`
static mut COUNTER : i32 = 40;

fn main() -> i32 {
  unsafe { COUNTER += 2; }
  return unsafe { COUNTER };
}
