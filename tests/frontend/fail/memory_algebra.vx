//===- memory_algebra.vx - Vx Compiler -----------------------------------*- Vx -*-===//
// RUN: not vxc %s --action print-ast 2>&1 | FileCheck %s

fn main() -> i32 {
  let host_data = Tensor<f32>();

  spawn on(Topology::NPU[0]) {
    let x = host_data[0];
  }
  return 0;
}

// The NPU cannot see host DRAM: E6003 names where the value lives, what the
// topology sees, and the costed fix (#253).
// CHECK: E6003
// CHECK-SAME: 'host_data' lives in CPU_DRAM
// CHECK-SAME: NPU[0] sees only [NPU_HBM]
// CHECK-SAME: insert an explicit transfer to NPU_HBM
