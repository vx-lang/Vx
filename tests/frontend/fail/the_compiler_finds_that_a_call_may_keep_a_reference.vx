// RUN: not vxc %s 2>&1 | FileCheck %s
//
// The compiler finds `!keeps(b)` only for a body that stores `b` nowhere. `via` stores it through
// a call of `set_r`, and `push_it` through `push`, so a caller keeps the borrow. `via_unknown`
// stores a value that the compiler cannot follow, which may be `b`. `kept` stores nothing, but
// its clause `keeps(x)` keeps the default for `x`.

import std::vec;

struct Holder {
  r : &i64,
}

fn set_r(h : &mut Holder, b : &i64) -> void {
  h.r = b;
}

fn via(h : &mut Holder, b : &i64) -> void {
  set_r(h, b);
}

fn push_it(v : &mut Vec<&i64>, b : &i64) -> void {
  v.push(b);
}

// A recursive function with no clause gives a result that the compiler cannot follow.
fn again(a : &i64) -> &i64 {
  return again(a);
}

fn via_unknown(h : &mut Holder, b : &i64) -> void {
  h.r = again(b);
}

fn kept(_out : &mut Vec<&i64>, x : &i64) -> i64
ensures keeps(x)
{
  return *x;
}

fn stored_through_a_call() -> i64 {
  let x = 1i64;
  let mut h = Holder {
    r : &x
  };
  let mut y = 2i64;
  via(&mut h, &y);
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `y` is assigned while it is borrowed
  y = 5i64;
  return *h.r;
}

fn stored_through_a_method() -> i64 {
  let mut v = Vec<&i64>::new();
  let mut y = 2i64;
  push_it(&mut v, &y);
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `y` is assigned while it is borrowed
  y = 5i64;
  return *v.get(0);
}

fn stored_where_the_compiler_cannot_follow() -> i64 {
  let x = 1i64;
  let mut h = Holder {
    r : &x
  };
  let mut y = 2i64;
  via_unknown(&mut h, &y);
  // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:3: `y` is assigned while it is borrowed
  y = 5i64;
  return *h.r;
}

fn kept_by_its_clause(out : &mut Vec<&i64>) -> i64 {
  let local = 7i64;
  // CHECK: Error[E4005] at {{.*}}.vx:[[@LINE+1]]:10: this call is given a value that points into this function's stack frame
  return kept(out, &local);
}

fn main() -> i32 {
  let mut out = Vec<&i64>::new();
  return (stored_through_a_call() + stored_through_a_method()
  + stored_where_the_compiler_cannot_follow() + kept_by_its_clause(&mut out)) as i32;
}

// CHECK: 4 error(s) emitted
