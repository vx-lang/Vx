// The error names the two branch types as they are written in Vx.
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error[E3007] at {{[0-9]+}}:{{[0-9]+}}: If expression branches have incompatible types: i32 and f32{{$}}
// CHECK: Error[E3007] at {{[0-9]+}}:{{[0-9]+}}: If expression branches have incompatible types: Tensor<f32, [4]> and Tensor<f32, [8]>{{$}}
// CHECK: 2 error(s) emitted

fn main() -> i32 {
  let a = Tensor<f32, [4]>::new();
  let b = Tensor<f32, [8]>::new();
  let x : i32 = 1;
  let y : f32 = 2.0;
  let c = true;
  let _n = if c {
    x
  } else {
    y
  };
  let _t = if c {
    a
  } else {
    b
  };
  return 0;
}
