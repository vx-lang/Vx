//===----------------------------------------------------------------------===//
// A scalar initializer wraps into a tensor of the identical element only
// (Vx#396). The old rule admitted any non-bool scalar into any non-bool
// tensor, so this f32 literal sat under an i32-tensor name with no
// conversion anywhere. Under the Rust numeric model (#240) the programmer
// writes the element they mean.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  // CHECK: E3001{{.*}}'t' is declared Tensor<i32> but its initializer is f32
  let t : Tensor<i32, []> = 1.5;
  return 0;
}
