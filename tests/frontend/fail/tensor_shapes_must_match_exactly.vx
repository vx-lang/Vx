//===----------------------------------------------------------------------===//
// A tensor fits where another is expected only if they have the same rank. A rank-0 tensor
// holds one value, so it is not a `Tensor<f32, [4]>`; `take` would read past its end. An array
// literal has the shape it is written with, and `@` needs two matrices.
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK-DAG: Error[E3003] at 24:11: {{.*}}rank 0 does not match rank 1
// CHECK-DAG: Error[E3001] at 25:3: 'pairs' is declared Tensor<i32, [3, 2]> but its initializer is Tensor<i32, [2, 2]>
// CHECK-DAG: Error[E3001] at 26:3: 'four' is declared Tensor<f32, [4]> but its initializer is Tensor<f32, [2]>
// CHECK-DAG: Error[E7001] {{.*}}requires 2D tensors, got 0D and 0D

fn take(t : Tensor<f32, [4]>) -> f32 {
  return t[2];
}

fn main() -> i32 {
  let one : Tensor<f32, []> = 1.0;
  let x = take(one);
  let pairs : Tensor<i32, [3, 2]> = [[1, 2], [3, 4]];
  let four : Tensor<f32, [4]> = [1.0, 2.0];
  let two : Tensor<f32, []> = 2.0;
  let m = &two @ &two;
  return 0;
}
