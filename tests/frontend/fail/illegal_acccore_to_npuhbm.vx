// RUN: vxc %s | FileCheck %s

fn main() -> i32 {
  let t_host: Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPUHBM);
  
  spawn on (Topology::AccCore[0]) {
    // This is illegal! AccCore can only operate on LocalSRAM natively.
    // It must first explicitly transfer t_npu into LocalSRAM.
    // CHECK: Cross-topology access error
    let invalid = t_npu;
  }

  return 0;
}
