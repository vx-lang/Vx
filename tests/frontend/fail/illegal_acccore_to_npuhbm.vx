//===- illegal_acccore_to_npuhbm.vx - Vx Compiler --------------------------*-
// RUN: not vxc %s 2>&1 | FileCheck %s
// Vx -*-===//

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);

  spawn on(Topology::AccCore[0]) {
    // This is illegal! AccCore can only operate on LocalSRAM natively.
    // It must first explicitly transfer t_npu into LocalSRAM.
    // CHECK: E6003
    // CHECK-SAME: 't_npu' lives in NPU_HBM
    // CHECK-SAME: AccCore[0] sees only [Local_SRAM]
    // CHECK-SAME: insert an explicit transfer to Local_SRAM
    let invalid = t_npu;
  }

  return 0;
}
