// A `const N` dimension in a pattern binds to a compile-time extent. A `?`
// in the argument has none, so the pattern does not match; it is refused,
// not bound to a value that does not exist until run time.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// XFAIL: *
// CHECK: 'N'
// CHECK-SAME: run-time extent

fn first<const N : i32>(t : Tensor<f32, [N]>) -> f32 {
  return t[0];
}

fn f(n : i32) -> i32 {
  let mut a = Tensor<f32>([n]);
  a[0] = 1.0;
  return first(a) as i32 - 1;
}

fn main() -> i32 {
  return f(3);
}
