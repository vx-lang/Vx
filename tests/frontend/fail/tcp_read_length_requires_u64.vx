// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
// A positive signed length must not reach a TCP read.
// CHECK: Error[E3003]{{.*}}'TcpStream::read_raw'. Expected u64, got i64
import std::net;

fn read_with_an_i64(stream : &mut TcpStream) -> void {
  let length : i64 = 1;
  unsafe { let _count = (*stream).read_raw(0 as *mut u8, length); }
}

fn main() -> i32 {
  return 0;
}
