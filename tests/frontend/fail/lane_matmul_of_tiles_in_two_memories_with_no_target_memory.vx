//===----------------------------------------------------------------------===//
// A matmul of a tile in HBM by a tile in shared memory puts its product in the memory that its
// target names. Here the type of `acc` names no memory, and the compiler does not pick one, so
// it refuses the matmul. A tile that the lanes of a block share must also name a memory such as
// `Memory::SMEM`, so `acc` gets a second error.
//
// The rule is for the code of a device. On the host, a matmul of a tensor in HBM by a tensor in
// CPU memory keeps the memory of its first tensor, so `on_the_host` cannot name CPU memory.
//
// RUN: not vxc %s --host default --machine fleet/h200.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error

pub fn no_target(a : &Tensor<f8e4m3, [2, 32, 32], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sb = unsafe {
        Tensor<f8e4m3, [2, 32, 16], Memory::SMEM>::uninit()
      };
      // CHECK-DAG: Error[E6032] at {{.*}}:[[#@LINE+1]]:7: the lanes of a block share a tensor
      let mut acc = unsafe { Tensor<f32, [2, 32, 16]>::uninit() };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for j in 0..16 {
            sb[w][i][j] = 1.0 as f8e4m3;
          }
        }
        // CHECK-DAG: Error[E3004] at {{.*}}:[[#@LINE+1]]:32: the tiles of this `@` are in Memory::HBM and in Memory::SMEM, so the product needs a target that names its memory
        acc[w] = (a[w] as f32) @ (sb[w] as f32);
      }
    }
  }
  return;
}

pub fn on_the_host(a : &Tensor<f32, [4, 4], Memory::HBM>, b : &Tensor<f32, [4, 4], Memory::CPU_DRAM>) -> f32 {
  // CHECK: Error[E3001] at {{.*}}:[[#@LINE+1]]:3: 'c' is declared Tensor<f32, [4, 4], Memory::CPU_DRAM> but its initializer is Tensor<f32, [4, 4], Memory::HBM>
  let c : Tensor<f32, [4, 4], Memory::CPU_DRAM> = a @ b;
  return c[0][0];
}

fn main() -> i32 {
  return 0;
}
