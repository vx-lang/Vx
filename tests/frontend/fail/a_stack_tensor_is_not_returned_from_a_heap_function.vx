// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A stack tensor is freed when its function returns. A function that returns a heap tensor cannot return it.

// CHECK: returns a stack tensor
fn make() -> Tensor<f32, [4]> {
  let t : Tensor<f32, [4], Storage::Stack> = Tensor<f32, [4], Storage::Stack>::new();
  return t;
}

fn main() -> i32 {
  let m = make();
  return 0;
}
