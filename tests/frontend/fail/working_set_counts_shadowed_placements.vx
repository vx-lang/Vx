//===----------------------------------------------------------------------===//
// Two tiles in one space, bound to the same name. E6010.
//
// Shadowing is legal and deliberate here, and nothing releases the tile the
// shadowed name held: there is no free, and a slot lives until the function
// returns. So both tiles are resident and the working set is 6 MiB against a
// 4 MiB space.
//
// The check used to key its per-space map by the binding name, so the second
// placement overwrote the first and this program compiled. Renaming the two
// bindings apart -- changing nothing else -- refused it. A capacity verdict that
// depends on the spelling of a local is not a capacity verdict.
//
// It reached the reported figures too, not only the diagnostic: the resident set
// in `--diagnostics-json` read as one tile of the later size, so a space holding
// 16 MiB and then 16 KiB reported 16 KiB and a utilization of 0.0002.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: E6010
// CHECK-SAME: (2 tiles)
// CHECK-SAME: sums to 6291456 bytes

Memory CPU_DRAM {}
Memory W {
  within: Memory::CPU_DRAM, capacity: 4 MiB, managed: explicit
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::W,
  visible: [Memory::W],
  transfer Memory::CPU_DRAM -> Memory::W : 10
}

fn main() -> i32 {
  // 1024 * 768 * 4 = 3 MiB each.
  let x = Tensor<f32, [1024, 768]>::uninit();
  let s = transfer(x, Memory::W);
  let y = Tensor<f32, [1024, 768]>::uninit();
  let s = transfer(y, Memory::W);
  return 0;
}
