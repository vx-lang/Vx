// `DynTensor<T>` hid its rank, and both codegen paths guessed 2. The spelling
// that states it is `Tensor<T, [?, ?]>`: one type constructor, and `?` in the
// position whose extent is a run-time value. The old name is refused with the
// replacement written out, not aliased.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: `DynTensor<f32>` is spelled `Tensor<f32, [?, ?]>`
// CHECK-SAME: state the rank

fn f(t : DynTensor<f32>) -> i32 {
  return 0;
}

fn main() -> i32 {
  return 0;
}
