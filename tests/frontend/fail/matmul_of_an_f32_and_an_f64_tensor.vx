// RUN: not vxc %s 2>&1 | FileCheck %s
//
// `@` needs both tensors to have the same element type. Here one is f32 and the other f64.

fn main() -> i32 {
  let a = Tensor<f32, [2, 2]>::fill(1.0f32);
  let b = Tensor<f64, [2, 2]>::fill(1.0f64);
  let _c = a @ b;
  return 0;
}

// CHECK: Error[E7002] at {{.*}}matmul_of_an_f32_and_an_f64_tensor.vx:16:14: Tensor multiplication requires matching element types, got f32 and f64
