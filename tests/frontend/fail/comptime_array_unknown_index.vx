//===----------------------------------------------------------------------===//
// A store to an array element whose index the compiler does not work out makes the whole
// array unknown. Keeping the old contents would let a later read give a value the program
// never holds.
//
// The compiler does not use a call to work out the index of a store, so `a[one()] = 7` is
// such a store. After it, `a[0]` has no value, and the assert cannot be decided (E3033). If
// the array kept its old contents, the assert would fail with E8002 instead.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

fn one() -> i64 {
  return 1i64;
}

fn main() -> i32 {
  comptime {
    let mut a : Tensor<i64, [3]> = [ 3i64, 1i64, 2i64 ];
    a[one()] = 7i64;
    // CHECK: Error[E3033] at [[@LINE+1]]:5: this `comptime` block cannot be evaluated: this assert depends on a value known only when the program runs
    assert(a[0] != 3, "the array kept its old contents after an unknown store");
  }
  return 0;
}
