// RUN: not vxc %s 2>&1 | FileCheck %s
// `r` outlives the block of `q`, so it cannot take `&q.b`. Taking `&p.b` is allowed: see
// a_reference_can_point_at_another_field_from_an_inner_block.vx.

struct Pair {
  a : i32,
  b : i32,
}

fn main() -> i32 {
  let p = Pair {
    a : 1, b : 2
  };
  let mut r = &p.a;
  if p.a < p.b {
    let q = Pair {
      a : 3, b : 4
    };
    // CHECK: Error[E3004] at {{.*}}.vx:[[@LINE+1]]:5: Type mismatch in assignment: both sides are &i32, but they are valid in different blocks
    r = &q.b;
  }
  println!("{}", *r);
  return 0;
}
