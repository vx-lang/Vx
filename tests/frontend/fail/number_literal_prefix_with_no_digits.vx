// RUN: not vxc %s 2>&1 | FileCheck %s
//
// `0x` on its own is not a number. The `_` separators do not count as digits either.

fn main() -> i32 {
  // CHECK: '0x_' needs at least one digit after '0x'
  let a : i32 = 0x_;
  return a;
}
