// RUN: not vxc --package tests=tests %s 2>&1 | FileCheck %s --implicit-check-not='Internal Error'
// RUN: not vxc -j 1 --package tests=tests %s 2>&1 | FileCheck %s --implicit-check-not='Internal Error'
//
// A `main` that takes a `Root` makes the `Root` of the program. So an imported file cannot
// declare one, and the program gets an error that names the file. Before, the compiler stopped
// with an internal error when the program had its own `main` too. The second run loads the files
// as `vxc -j` does.
import tests::modules::a_module_with_a_main_that_takes_a_root;

fn main() -> i32 {
  print(answer());
  return 0;
}

// CHECK: a_module_with_a_main_that_takes_a_root.vx declares `fn main(root : Root)`, but only a file that vxc compiles can declare it. Such a `main` makes the `Root` of the program
