//===----------------------------------------------------------------------===//
// Declares `labs` with a 64-bit integer, as C has it. main.vx says which declarations disagree. Compiled alone, this module has no
// error.
//
// RUN: vxc %s --emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: module
extern {
  pub fn labs(n : i64) -> i64;
  pub fn atoi(s : *const i8) -> i32;
  pub fn strlen(s : *const i8) -> u64;
  pub fn abs(n : i32) -> i32;
}
