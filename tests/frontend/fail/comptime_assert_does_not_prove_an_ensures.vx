// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// An assert in a `comptime` block never runs, because the compiler removes the block. So it
// cannot be a fact that proves the `ensures` of `pick`. The compiler used to prove the
// `ensures` from it, and `pick(5)` returned 5.
//
// The assert depends on `x`, a value known only when the program runs (E3033). Without the
// assert as a fact, nothing proves the `ensures` (E8001).

fn pick(x : i32) -> i32
requires x >= 0 && x < 1000
ensures return > 100 {
  comptime {
    // CHECK-DAG: Error[E3033] at [[@LINE+1]]:5: this `comptime` block cannot be evaluated: this assert depends on a value known only when the program runs
    assert(x > 100i32, "x is a run-time value");
  }
  // CHECK-DAG: Error[E8001] at [[@LINE+1]]:3: Function 'pick' cannot prove postcondition (ensures) at compile time
  return x;
}

fn main() -> i32 {
  print(pick(5));
  return 0;
}
