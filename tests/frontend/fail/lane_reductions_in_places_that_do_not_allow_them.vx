// Every lane of the block or the subgroup must get to a lane reduction, so a call is the whole
// value of a `let` in the code of a loop of blocks or subgroups. Each function below breaks one
// rule of the place, the size or the arguments of a call, also of an argmax.
//
// RUN: not vxc %s --host default --machine fleet/a100-80.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:32:{{.*}}`lanes::sum` must be the whole value of a `let` in the code of a loop of blocks or subgroups, outside its lane loops
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:44:{{.*}}`lanes::sum` must be the whole value of a `let`
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:54:{{.*}}`lanes::sum` must be the whole value of a `let`
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:65:{{.*}}this condition decides whether the lanes reach the end of a lane loop or a lane reduction{{.*}} but it reads memory
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:78:{{.*}}`lanes::sum` in the code of a block combines at most 1024 elements, but its tensor has 2048
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:91:{{.*}}`lanes::max` in the code of a block needs a block whose lanes are a multiple of 32 and at least the 100 elements of its tensor, but the lane loops of this region give 100 lanes
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:104:{{.*}}`lanes::sum` in the code of a block needs a block whose lanes are a multiple of 32 and at least the 256 elements of its tensor, but the lane loops of this region give 64 lanes
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:118:{{.*}}`lanes::sum` in the code of a subgroup combines at most 32 elements, but its tensor has 64
// CHECK: Error[E6032] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:132:{{.*}}`lanes::min` is not a lane reduction. The lane reductions are `lanes::sum`, `lanes::max`, `lanes::sum_unordered`, `lanes::max_unordered`
// CHECK: Error[E3003] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:145:{{.*}}the first argument of `lanes::sum` must borrow a rank-1 tensor of `f32`{{.*}} but it is `&Tensor<i32, [64], Memory::SMEM>`
// CHECK: Error[E3003] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:158:{{.*}}the second argument of `lanes::sum` is the number of elements to combine, an `i32`, but it is `f32`
// CHECK: Error[E3003] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:172:{{.*}}the second argument of `lanes::argmax` must borrow a rank-1 tensor of `i32` indices of the same size as the values, but it is `&Tensor<i32, [32], Memory::SMEM>`
// CHECK: Error[E3003] at {{.*}}lane_reductions_in_places_that_do_not_allow_them.vx:185:{{.*}}`lanes::argmax` takes 3 arguments, a borrowed tensor of values, a borrowed tensor of their indices and the number of elements to combine, but it got 2

pub fn in_a_lane_loop(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      for t in 0..64 across lanes {
        let s = lanes::sum(&part, 64);
        out[b * 64 + t] = s;
      }
    }
  }
  return;
}

pub fn part_of_a_value(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      let s = lanes::sum(&part, 64) * 2.0;
      for t in 0..64 across lanes {
        out[b * 64 + t] = s;
      }
    }
  }
  return;
}

pub fn outside_a_region(x : &Tensor<f32, [64]>) -> f32 {
  let s = lanes::sum(x, 64);
  return s;
}

pub fn under_a_condition_that_lanes_may_not_share(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let mut part = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      for t in 0..64 across lanes {
        part[t] = 1.0;
      }
      if part[0] > 0.0 {
        let s = lanes::sum(&part, 64);
        out[b] = s;
      }
    }
  }
  return;
}

pub fn more_than_a_block_combines(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [2048], Memory::SMEM>::uninit() };
      let s = lanes::sum(&part, 2048);
      for t in 0..1024 across lanes {
        out[b * 1024 + t] = s;
      }
    }
  }
  return;
}

pub fn lanes_that_are_not_a_multiple_of_32(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [100], Memory::SMEM>::uninit() };
      let s = lanes::max(&part, 100);
      for t in 0..100 across lanes {
        out[b * 100 + t] = s;
      }
    }
  }
  return;
}

pub fn more_than_the_lanes_of_the_block(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      let s = lanes::sum(&part, 256);
      for t in 0..64 across lanes {
        out[b * 64 + t] = s;
      }
    }
  }
  return;
}

pub fn more_than_a_subgroup_combines(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [4, 64], Memory::SMEM>::uninit() };
      for w in 0..4 across subgroups {
        let s = lanes::sum(&part[w], 64);
        for t in 0..32 across lanes {
          out[(b * 4 + w) * 32 + t] = s;
        }
      }
    }
  }
  return;
}

pub fn not_a_reduction(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      let s = lanes::min(&part, 64);
      for t in 0..64 across lanes {
        out[b * 64 + t] = s;
      }
    }
  }
  return;
}

pub fn a_tensor_of_integers(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<i32, [64], Memory::SMEM>::uninit() };
      let s = lanes::sum(&part, 64);
      for t in 0..64 across lanes {
        out[b * 64 + t] = s;
      }
    }
  }
  return;
}

pub fn a_count_that_is_not_an_i32(out : &mut Tensor<f32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let part = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      let s = lanes::sum(&part, 1.5);
      for t in 0..64 across lanes {
        out[b * 64 + t] = s;
      }
    }
  }
  return;
}

pub fn indices_of_another_size(out : &mut Tensor<i32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let vs = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      let ix = unsafe { Tensor<i32, [32], Memory::SMEM>::uninit() };
      let best = lanes::argmax(&vs, &ix, 64);
      for t in 0..64 across lanes {
        out[b * 64 + t] = best;
      }
    }
  }
  return;
}

pub fn an_argmax_with_no_indices(out : &mut Tensor<i32, [?], Memory::HBM>, rows : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..rows across blocks {
      let vs = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      let best = lanes::argmax(&vs, 64);
      for t in 0..64 across lanes {
        out[b * 64 + t] = best;
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
