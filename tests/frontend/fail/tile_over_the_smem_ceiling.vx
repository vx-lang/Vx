//===----------------------------------------------------------------------===//
// The per-tile capacity check (E6009): one tile staged into an on-chip
// scratchpad must fit that scratchpad, and the error reports both byte numbers.
//
// Local_SRAM is declared at 16 KiB and a 128x64 f32 tile is 32 KiB, so staging
// it there is a compile error rather than a run-time surprise. The cumulative
// version of this check, where each tile fits but their sum does not, is E6010
// in memory_working_set_overflow.vx.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

Memory Local_SRAM {
  capacity: 16 KiB
}

fn main() -> i32 {
  let mut t = unsafe { Tensor<f32, [128, 64]>::uninit() };
  for i in 0..128 {
    for j in 0..64 {
      t[i][j] = 1.0;
    }
  }
  // 32768 bytes does not fit the 16384-byte scratchpad.
  let t_smem = transfer(t, Memory::Local_SRAM);
  return 0;
}

// CHECK: E6009
