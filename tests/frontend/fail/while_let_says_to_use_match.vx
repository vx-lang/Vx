// RUN: not vxc %s 2>&1 | FileCheck %s
//
// Vx has no `while let`. The error says to write a `match` with a `_` arm.
//
// CHECK: :18:9: {{.*}}Vx has no `while let`. Use a `match` with a `_` arm instead

import core::option;

fn main() -> i32 {
  let o = Option<i64>::Some(3i64);
  while let Option<i64>::Some(v) = o {
    return v as i32;
  }
  return 0;
}
