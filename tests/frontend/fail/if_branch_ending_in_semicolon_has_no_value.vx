// `2;` is a statement, so a branch ending in it has no value to give the `if`.
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error[E3007]{{.*}}incompatible types: Scalar(I32) and Struct("void", None)
// CHECK: 1 error(s) emitted

fn main() -> i32 {
  let c = true;
  let y = if c {
    40
  } else {
    2;
  };
  return y;
}
