//===- illegal_npu_to_gpu.vx - Vx Compiler -------------------------------*- Vx
// RUN: not vxc %s 2>&1 | FileCheck %s
//-*-===//

fn main() -> i32 {
  let t_host : Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);

  spawn on(Topology::GPU) {
    // This is illegal! GPU cannot natively access NPU HBM directly.
    // CHECK: E6003
    // CHECK-SAME: 't_npu' lives in NPU_HBM
    // The device is named, not just the kind: `GPU[0]`, as `NPU[0]` always
    // was. Now that a program can say `Topology::GPU[1]`, which GPU cannot
    // reach the buffer is part of the diagnostic rather than context the reader
    // has to supply.
    // CHECK-SAME: GPU[0] sees only [GPU_HBM, CPU_DRAM]
    // CHECK-SAME: insert an explicit transfer to GPU_HBM
    let invalid = t_npu;
  }

  return 0;
}
