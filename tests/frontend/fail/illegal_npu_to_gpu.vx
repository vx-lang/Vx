//===- illegal_npu_to_gpu.vx - Vx Compiler -------------------------------*- Vx -*-===//
// RUN: vxc %s | FileCheck %s

fn main() -> i32 {
  let t_host: Tensor<f32> = 1.0;
  let t_npu = transfer(t_host, Memory::NPU_HBM);
  
  spawn on (Topology::GPU) {
    // This is illegal! GPU cannot natively access NPU HBM directly.
    // CHECK: Cross-topology access error
    let invalid = t_npu;
  }

  return 0;
}
