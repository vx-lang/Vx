// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Type mismatch in logical operation: bool vs f32
// CHECK: Type mismatch in logical operation: bool vs f32
// CHECK: Type mismatch in logical operation: bool vs f32
// CHECK: Type mismatch in logical operation: bool vs f32
// CHECK: Type mismatch in logical operation: bool vs i32
// CHECK: Type mismatch in logical operation: bool vs i32
// CHECK: Type mismatch in logical operation: bool vs i32
// CHECK: Type mismatch in logical operation: bool vs i32

fn gen_bool_mismatch_f32_and() -> Bool {
  let a : Bool = true;
  let b : f32 = 1f32;
  // EXPECT: Type mismatch
  return a && b;
}

fn gen_bool_mismatch_f32_or() -> Bool {
  let a : Bool = true;
  let b : f32 = 1f32;
  // EXPECT: Type mismatch
  return a || b;
}

fn gen_bool_mismatch_i32_and() -> Bool {
  let a : Bool = true;
  let b : i32 = 1i32;
  // EXPECT: Type mismatch
  return a && b;
}

fn gen_bool_mismatch_i32_or() -> Bool {
  let a : Bool = true;
  let b : i32 = 1i32;
  // EXPECT: Type mismatch
  return a || b;
}
