//===----------------------------------------------------------------------===//
// A tensor index past the end is an error when the compiler knows the size and the largest
// value of the index: a constant, or the variable of a `for` loop over a constant range.
// A row is its own size: `t[0][j]` cannot reach into the next row.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn too_far() -> i32 {
  let mut t = Tensor<f32>([2, 3]);
  for j in 0..6 {
    // CHECK: E8003] at {{.*}}tensor_index_out_of_range.vx:[[@LINE+1]]:{{.*}}index `j` can be 5, which is out of range: this dimension has 3 elements
    t[0][j] = 1.0;
  }
  // CHECK: E8003] at {{.*}}tensor_index_out_of_range.vx:[[@LINE+1]]:{{.*}}index 3 is out of range: this dimension has 3 elements
  t[1][3] = 1.0;
  // CHECK: E8003] at {{.*}}tensor_index_out_of_range.vx:[[@LINE+1]]:{{.*}}index 2 is out of range: this dimension has 2 elements
  t[2][0] = 1.0;
  let mut v = Tensor<f32>([4]);
  for i in 0..5 {
    // CHECK: E8003] at {{.*}}tensor_index_out_of_range.vx:[[@LINE+1]]:{{.*}}index `i` can be 4, which is out of range: this dimension has 4 elements
    v[i] = 1.0;
  }
  return 0;
}

// Every index here stays in range, or has no known largest value.
fn in_range(n : i32) -> f32 {
  let mut t = Tensor<f32>([2, 3]);
  for i in 0..2 {
    for j in 0..3 {
      t[i][j] = 1.0;
    }
  }
  for j in 0..12 {
    let j = j / 4;
    t[1][j] = 2.0;
  }
  return t[1][2] + t[0][n];
}
// CHECK-NOT: E8003

fn main() -> i32 {
  return too_far();
}
