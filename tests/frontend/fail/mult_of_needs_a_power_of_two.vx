// `? mult_of N` needs N to be a power of two, as `aligned(N)` does (#3668).
//
// RUN: not vxc %s --action parse-only 2>&1 | FileCheck %s --implicit-check-not=Error

// CHECK: Error at {{.*}}:[[#@LINE+1]]:47: `? mult_of N` needs N to be a power of two, such as 4
fn fill(out : &mut Tensor<f32, [?, ? mult_of 3], Memory::CPU_DRAM>, n : i32) -> void {
  return;
}
