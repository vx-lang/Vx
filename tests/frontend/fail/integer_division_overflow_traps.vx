// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// RUN: not vxc %s -O2 2>&1 | FileCheck %s
//
// The smallest `i32` divided by -1 is one more than the largest `i32`, so it stops the program,
// on both code generators and at -O2.

// CHECK: attempt to divide with overflow
// CHECK-NOT: wrong answer
fn div(a : i32, b : i32) -> i32 {
  return a / b;
}

fn main() -> i32 {
  print(div(-2147483647 - 1, -1));
  print!(" wrong answer");
  return 0;
}
