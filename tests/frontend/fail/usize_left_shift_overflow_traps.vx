// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
//
// A `<<` on `usize` whose result leaves the range stops the program, on both code
// generators.
// `2 << 62` is one past the largest `usize`: the shift is allowed, the bit it pushes out is not.

// CHECK: usize left shift overflowed
// CHECK-NOT: wrong answer
fn apply(a : usize, b : usize) -> usize {
  return a << b;
}

fn main() -> i32 {
  print(apply(2, 62));
  print!(" wrong answer");
  return 0;
}
