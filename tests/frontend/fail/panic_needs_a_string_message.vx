// `panic` takes exactly one argument, a string message.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK-DAG: Function 'panic' expects a string message, got i32
// CHECK-DAG: Function 'panic' expects 1 argument, the message
fn number_message() -> i32 {
  panic(3);
}

fn no_message() -> i32 {
  panic();
}

fn main() -> i32 {
  return 0;
}
