//===- using_an_imported_generic_with_a_type_error.vx - Vx Compiler -*- Vx -*-===//
// RUN: not vxc --emit-mlir %s 2>&1 | FileCheck %s --check-prefixes=CHECK,SEQ
// RUN: not vxc -j 4 --emit-mlir %s 2>&1 | FileCheck %s
import tests::modules::library_with_a_generic_function_with_a_type_error;

// `first` is generic, so its body is checked when this call creates the `first<i32>`
// instance, from inside `main`. Its warning and its error still name the library's file,
// not this one. A parallel compile prints no warnings when it fails, so only the normal
// compile checks the warning.
fn main() -> i32 {
  let n = first(3);
  return n as i32;
}

// SEQ: Warning[W1009] at {{.*}}library_with_a_generic_function_with_a_type_error.vx:16:4: Unused function parameter 'v'
// CHECK: in {{.*}}library_with_a_generic_function_with_a_type_error.vx: Struct 'Point' has no field 'y'
