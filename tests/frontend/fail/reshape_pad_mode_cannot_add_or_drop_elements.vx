//===----------------------------------------------------------------------===//
// `PadMode::Trim` may only drop elements and `PadMode::Pad` may only add them. Adding
// elements is not supported yet.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error[E3047] at 24:14: PadMode::Trim keeps the first elements, so it cannot make a larger tensor: Tensor<f32, [2, 2]> has 4, the new shape has 8
// CHECK: Error[E3047] at 30:14: PadMode::Pad cannot make a smaller tensor: Tensor<f32, [4, 4]> has 16, the new shape has 8; use PadMode::Trim to keep the first elements
// CHECK: Error[E3047] at 36:14: PadMode::Pad to a larger tensor is not supported yet: Tensor<f32, [2, 2]> has 4, the new shape has 8
// CHECK: 3 error(s) emitted

enum PadMode {
  Pad,
  Trim
}

fn trim_to_more() -> i32 {
  let t = Tensor<f32, [2, 2]>::new();
  let _x = t.reshape([8], PadMode::Trim);
  return 0;
}

fn pad_to_fewer() -> i32 {
  let t = Tensor<f32, [4, 4]>::new();
  let _x = t.reshape([8], PadMode::Pad);
  return 0;
}

fn pad_to_more() -> i32 {
  let t = Tensor<f32, [2, 2]>::new();
  let _x = t.reshape([8], PadMode::Pad);
  return 0;
}

fn main() -> i32 {
  return 0;
}
