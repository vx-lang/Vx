//===----------------------------------------------------------------------===//
// A comma inside an index is a different mistake from a missing block. The error
// keeps its own message and does not say that the arm body is a block.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let a = [1, 2, 3];
  let mut out = 0;
  match out {
    // CHECK: Unexpected token Comma. Expected ']'
    // CHECK-NOT: body of a match arm
    0 => out = a[1, 2];
    _ => out = 1;
  }
  return out;
}
