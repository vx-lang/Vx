// #210: `main` is the C entry point; its return value is the process exit code,
// so it must return i32. A non-i32 `main` is a compiler error rather than a
// silently-discarded value.
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: must return i32
fn main() -> f32 {
  return 1.0;
}
