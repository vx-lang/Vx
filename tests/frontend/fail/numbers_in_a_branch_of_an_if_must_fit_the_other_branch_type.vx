//===----------------------------------------------------------------------===//
// A branch of an `if` that is only numbers takes the type of the other branch. Each number must
// fit that type: `300` in `2 * 300` and `256` in a nested `if` do not fit a `u8`. A branch with a
// suffix, as in `2i32 * 3`, keeps its own type.
// RUN: not vxc %s 2>&1 | FileCheck %s

fn product(c : bool, u : u8) -> u8 {
  let r = if c {
    u
  } else {
    // CHECK: Error[E3045] at {{.*}}.vx:[[@LINE+1]]:9: 300 does not fit `u8`{{$}}
    2 * 300
  };
  return r;
}

fn nested_if(c : bool, d : bool, u : u8) -> u8 {
  let r = if c {
    if d {
      1
    } else {
      // CHECK: Error[E3045] at {{.*}}.vx:[[@LINE+1]]:7: 256 does not fit `u8`{{$}}
      256
    }
  } else {
    u
  };
  return r;
}

fn suffixed_product(c : bool, u : u8) -> u8 {
  // CHECK: Error[E3007] at {{.*}}.vx:[[@LINE+1]]:11: If expression branches have incompatible types: u8 and i32{{$}}
  let r = if c {
    u
  } else {
    2i32 * 3
  };
  return r;
}

fn main() -> i32 {
  print(product(false, 3u8));
  print(nested_if(true, false, 3u8));
  print(suffixed_product(false, 3u8));
  return 0;
}
// CHECK: 3 error(s) emitted
