// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A call takes its by-value arguments whatever is done with its result. Inside `print(..)`,
// which only reads its argument, or an `if` condition, `take(t)` still moves `t`, so using `t`
// after it is an error.

fn take(t : Tensor<f32, [4]>) -> f32 {
  return t[0];
}

fn inside_print() -> f32 {
  let t = Tensor<f32, [4]>::new();
  print(take(t));
  return t[0];
}

fn inside_a_condition() -> f32 {
  let t = Tensor<f32, [4]>::new();
  if take(t) > 0.0 {
    print(1);
  }
  return t[0];
}

fn main() -> i32 {
  return 0;
}

// CHECK-DAG: Error[E4001] at 21:10: Use of moved or consumed linear variable: t
// CHECK-DAG: Error[E4001] at 29:10: Use of moved or consumed linear variable: t
