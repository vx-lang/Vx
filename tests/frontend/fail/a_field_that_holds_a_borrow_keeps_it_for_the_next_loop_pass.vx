// RUN: not vxc %s 2>&1 | FileCheck %s
// A field of type `&i32` that takes `&x` on one pass of a loop still holds it on the next pass.
// Changing `x` on that next pass is an error. A field that cannot hold a reference keeps no
// borrow: see a_loop_that_stores_a_call_result_in_a_field_can_assign_the_argument.vx.

struct Seen {
  at : &i32,
}

fn main() -> i32 {
  let mut x = 0;
  let y = 100;
  let mut seen = Seen {
    at : &y
  };
  let mut i = 0;
  while i < 2 {
    if i == 0 {
      seen.at = &x;
    } else {
      // CHECK: Error[E4009] at {{.*}}.vx:[[@LINE+1]]:7: `x` is assigned while it is borrowed
      x = 7;
    }
    i = i + 1;
  }
  return *seen.at;
}
