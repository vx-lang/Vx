// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A `match` on a reference gives each name a reference to a part of a value that the
// reference does not own. Moving that part out would drop it twice, so each way to move one is
// an error: a return or an assignment of the reference where the code needs the value (E3002,
// E3004), and a call or a field move that takes the value from behind it (E4008).

// CHECK-DAG: Error[E3002] at {{.*}}.vx:68:7: Type mismatch on return. Expected Noisy, got &Noisy
// CHECK-DAG: Error[E3002] at {{.*}}.vx:81:7: Type mismatch on return. Expected Noisy, got &Noisy
// CHECK-DAG: Error[E4008] at {{.*}}.vx:94:16: `into_id` takes `self` by value, so this call moves a value of type `Noisy` out from behind a reference
// CHECK-DAG: Error[E4008] at {{.*}}.vx:105:16: `p.left` cannot be moved out: `p` is a reference and does not own it
// CHECK-DAG: Error[E3004] at {{.*}}.vx:124:11: Type mismatch in assignment: cannot assign &Noisy to Noisy
// CHECK: 5 error(s) emitted

import core::ops;

struct Noisy {
  id : i32,
}

impl Drop for Noisy {
  fn drop(self : &mut Noisy) -> void {
    print(self.id);
  }
}

impl Noisy {
  fn into_id(self : Noisy) -> i32 {
    return self.id;
  }
}

struct Pair {
  left : Noisy,
  right : Noisy,
}

enum Holder {
  Full(Noisy),
  Empty,
}

enum Maybe<T> {
  Some(T),
  Nothing,
}

enum Two {
  Both(Pair),
  Neither,
}

enum Outer {
  Has(Holder),
  Nothing,
}

fn return_the_payload(h : &Holder) -> Noisy {
  match h {
    Holder::Full(n) => {
      return n;
    }
    Holder::Empty => {
      return Noisy {
        id : 0
      };
    }
  }
}

fn return_the_payload_of_a_generic_enum(h : &Maybe<Noisy>) -> Noisy {
  match h {
    Maybe<Noisy>::Some(n) => {
      return n;
    }
    Maybe<Noisy>::Nothing => {
      return Noisy {
        id : 0
      };
    }
  }
}

fn call_a_method_that_takes_the_payload(h : &Holder) -> i32 {
  match h {
    Holder::Full(n) => {
      return n.into_id();
    }
    Holder::Empty => {
      return 0;
    }
  }
}

fn return_a_field_of_the_payload(t : &Two) -> Noisy {
  match t {
    Two::Both(p) => {
      return p.left;
    }
    Two::Neither => {
      return Noisy {
        id : 0
      };
    }
  }
}

// `h` is part of the value behind `o`, so the names of a `match` on `h` are too.
fn move_out_of_a_match_on_a_payload(o : &Outer) -> Noisy {
  let mut out = Noisy {
    id : 0
  };
  match o {
    Outer::Has(h) => {
      match h {
        Holder::Full(n) => {
          out = n;
        }
        Holder::Empty => {}
      };
    }
    Outer::Nothing => {}
  }
  return out;
}

fn main() -> i32 {
  return 0;
}
