Topology NPU {
  memory: Memory::NPU_HBM,
  dtypes: [f16]
}

fn main() -> i32 {
  spawn on(Topology::NPU[0]) {
    // CHECK: Error[E6026] at {{.*}}npu_rejects_f32.vx:[[@LINE+1]]:13: this expression has element type f32, which NPU[0] cannot represent; it declares [f16]
    let a = Tensor<f32>([4, 4]);
  }
  return 0;
}
