// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A call through `&F` can run a closure many times, and from many tasks at the same time. So
// the closure must not change a value that it captures, or move one.

import std::vec;

fn apply<F>(f : &F, x : i64) -> i64 {
  // CHECK: [[@LINE+1]]:10: this call runs a closure through a `&` reference, but the closure changes `total`
  return f(x);
}

fn changes() -> void {
  let mut total : i64 = 0;
  let add = |x : i64| -> i64 {
    total = total + x;
    return total;
  };
  println!("{}", apply(&add, 1i64));
}

fn moves() -> void {
  let v = Vec<i64>::new();
  let take = |x : i64| -> i64 {
    let _w = v;
    return x;
  };
  let r = &take;
  // CHECK: [[@LINE+1]]:19: this call runs a closure through a `&` reference, but the closure moves `v`
  println!("{}", (*r)(1i64));
}

fn main() -> i32 {
  changes();
  moves();
  return 0;
}
