//===- a_library_flaw_called_from_a_closure_is_reported.vx - Vx Compiler *- Vx -*-===//
// RUN: not vxc --emit-mlir %s 2>&1 | FileCheck %s
import core::iter;
import tests::modules::flawed_library;

fn main() -> i32 {
  let mut it = range(0i64, 3i64).map(| x : i64 | closure_target(x));
  print(it.next().unwrap());
  return 0;
}

// Only the closure's body calls `closure_target`, and making a closure is not a call.
// CHECK: in `closure_target` of the imported module `tests::modules::flawed_library`, which the compiled code calls: Undefined function 'missing_function'
