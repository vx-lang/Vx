// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A literal its type cannot hold is an error, where it used to keep only its low bits. The
// type comes from the `let`, from a suffix, or from a parameter.

fn take(n : u8) -> u8 {
  return n;
}

fn main() -> i32 {
  // CHECK: Error[E3045]: 4294967295 does not fit `i32`, which holds -2147483648 up to 2147483647
  let typed : i32 = 0xFFFF_FFFF;
  // CHECK: Error[E3045]: 511 does not fit `u8`, which holds 0 up to 255
  let suffixed = 0x1FFu8;
  // CHECK: Error[E3045]: -129 does not fit `i8`, which holds -128 up to 127
  let below : i8 = -129;
  // CHECK: Error[E3045]: 128 does not fit `i8`
  let above : i8 = 128;
  // CHECK: Error[E3045]: -1 does not fit `u8`
  let negative : u8 = -1;
  // CHECK: Error[E3045]: 256 does not fit `u8`
  let passed = take(256);
  // CHECK: Error[E3045]: 18446744073709551616 needs more than 64 bits
  let wide = 0x1_0000_0000_0000_0000;
  return 0;
}
// CHECK: 7 error(s) emitted
