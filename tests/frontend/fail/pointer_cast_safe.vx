// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: Casting an integer to a raw pointer requires an unsafe block

fn main() -> i32 {
  // This should trigger an error because it's not inside an unsafe block
  let ptr: *mut i32 = 0 as *mut i32;
  return 0;
}
