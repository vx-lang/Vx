//===----------------------------------------------------------------------===//
// Test that calling extern functions outside an unsafe block is rejected.
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: unsafe

extern {
  fn dangerous_call(x: i32) -> i32;
}

fn main() -> i32 {
  // This should fail: extern fn called without unsafe block
  return dangerous_call(42);
}
