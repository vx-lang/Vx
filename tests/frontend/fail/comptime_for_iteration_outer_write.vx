// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}writes to 'outside'
  let value = comptime {
    for i in 0..2 {
      if i == 1 {
        outside = 5i32;
      }
      let outside : i32 = 0i32;
    }
    7i32
  };
  return value;
}
