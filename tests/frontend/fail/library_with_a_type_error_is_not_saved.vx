//===----------------------------------------------------------------------===//
// Saving a library as a .vxlib type-checks it first. A library with a type error is
// reported and no .vxlib is written.
//
// RUN: rm -f %t.vxlib
// RUN: not vxc %s --action emit-interface -o %t.vxlib 2>&1 | FileCheck %s
// RUN: not test -e %t.vxlib
// CHECK: Error[E3002] at {{[0-9]+}}:{{[0-9]+}}: Type mismatch on return. Expected i32, got bool
// CHECK-NOT: Wrote module interface

fn wrong() -> i32 {
  return true;
}
