//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A row, a row of a row, a reshape and a field of a tensor in GPU memory are views of that
// memory, so each keeps the tensor's placement, and the host cannot read any of them. Each
// function reads one kind of view on the host. Each check names the view, not its owner: the
// line that takes a view also reports the owner, and would do so even if the view had lost its
// placement.
//
// CHECK: E6003{{.*}}'row' lives in GPU_HBM
// CHECK: E6003{{.*}}'inner' lives in GPU_HBM
// CHECK: E6003{{.*}}'flat' lives in GPU_HBM
// CHECK: E6003{{.*}}'h.t' lives in GPU_HBM
// CHECK: E6003{{.*}}'t' lives in GPU_HBM
// CHECK: Dereferencing a raw pointer into GPU_HBM is not possible here

Memory CPU_DRAM {}
Memory GPU_HBM {
  capacity: 40 GiB, bandwidth: 1555 GB/s, managed: explicit
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::GPU_HBM,
  visible: [ Memory::GPU_HBM ],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 10,
  transfer Memory::GPU_HBM -> Memory::CPU_DRAM : 10
}

struct H {
  t : Tensor<f32, [4], Memory::GPU_HBM>,
}

fn a_row() -> f32 {
  let host = Tensor<f32, [4, 4]>::fill(1.0);
  let on_gpu = transfer(host, Memory::GPU_HBM);
  let row = on_gpu[1];
  return row[2];
}

fn a_row_of_a_row() -> f32 {
  let host = Tensor<f32, [2, 4, 4]>::fill(1.0);
  let on_gpu = transfer(host, Memory::GPU_HBM);
  let inner = on_gpu[1][2];
  return inner[3];
}

fn a_reshape() -> f32 {
  let host = Tensor<f32, [4, 4]>::fill(1.0);
  let on_gpu = transfer(host, Memory::GPU_HBM);
  let flat = on_gpu.reshape([16]);
  return flat[3];
}

fn a_field() -> f32 {
  let host = Tensor<f32, [4]>::fill(1.0);
  let h = H {
    t : transfer(host, Memory::GPU_HBM)
  };
  return h.t[3];
}

fn a_field_through_a_variable() -> f32 {
  let host = Tensor<f32, [4]>::fill(1.0);
  let h = H {
    t : transfer(host, Memory::GPU_HBM)
  };
  let t = h.t;
  return t[3];
}

fn a_pointer_into_a_row() -> f32 {
  let host = Tensor<f32, [4, 4]>::fill(1.0);
  let on_gpu = transfer(host, Memory::GPU_HBM);
  let p = on_gpu[1].as_ptr();
  return unsafe { *p };
}

fn main() -> i32 {
  return 0;
}
