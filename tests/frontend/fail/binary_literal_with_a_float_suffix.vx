// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A literal with a base prefix is an integer. The error says the suffix is the problem.

fn main() -> i32 {
  // CHECK: a binary literal cannot have a float suffix: '0b1f32'
  let a = 0b1f32;
  return 0;
}
