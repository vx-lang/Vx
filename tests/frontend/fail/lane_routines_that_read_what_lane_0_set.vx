// Lane 0 alone runs code between lane loops that writes memory. Here that code also sets `k`, so
// only lane 0 has `k`. Every lane runs a lane routine and a matmul of tiles, so neither may read
// `k` (E6032). Each function below reads it in one of them.
//
// RUN: not vxc %s --host default --machine fleet/a100-80.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=E6032
// CHECK: Error[E6032] at {{.*}}lane_routines_that_read_what_lane_0_set.vx:30:{{.*}}`lanes::max` reads `k`, which only lane 0 has: lane 0 alone runs the code that sets it. That code writes memory, or it changes a variable from outside it. Every lane runs `lanes::max`, so the other lanes would read an old value. Pass the value through memory, such as an element of a tensor in shared memory
// CHECK: Error[E6032] at {{.*}}lane_routines_that_read_what_lane_0_set.vx:50:{{.*}}`lanes::sum` reads `k`, which only lane 0 has
// CHECK: Error[E6032] at {{.*}}lane_routines_that_read_what_lane_0_set.vx:68:{{.*}}`lanes::sort` reads `k`, which only lane 0 has
// CHECK: Error[E6032] at {{.*}}lane_routines_that_read_what_lane_0_set.vx:86:{{.*}}`lanes::copy_async` reads `k`, which only lane 0 has
// CHECK: Error[E6032] at {{.*}}lane_routines_that_read_what_lane_0_set.vx:107:{{.*}}`lanes::copy_async` reads `k`, which only lane 0 has
// CHECK: Error[E6032] at {{.*}}lane_routines_that_read_what_lane_0_set.vx:143:{{.*}}a matmul of tiles reads `k`, which only lane 0 has

// The count of `lanes::max`.
pub fn the_count_of_a_reduction(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        part[t] = x[t];
      }
      out[300] = 1.0;
      let k = n + 0;
      let m = lanes::max(&part, k);
      for t in 0..256 across lanes {
        out[t] = m;
      }
    }
  }
  return;
}

// In the code of a subgroup, lane 0 of the subgroup alone has `k`.
pub fn in_a_subgroup(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut part = unsafe { Tensor<f32, [2, 32], Memory::SMEM>::uninit() };
      for s in 0..2 across subgroups {
        for l in 0..32 across lanes(32) {
          part[s][l] = x[s * 32 + l];
        }
        out[64 + s] = 1.0;
        let k = n + 0;
        let t = lanes::sum(&part[s], k);
        out[s] = t;
      }
    }
  }
  return;
}

// A sort is a statement of its own.
pub fn the_count_of_a_sort(out : &mut Tensor<i64, [?], Memory::HBM>, x : &Tensor<i64, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut part = unsafe { Tensor<i64, [256], Memory::SMEM>::uninit() };
      for t in 0..256 across lanes {
        part[t] = x[t];
      }
      out[300] = 1;
      let k = n + 0;
      lanes::sort(&mut part, k);
      for t in 0..256 across lanes {
        out[t] = part[t];
      }
    }
  }
  return;
}

// The place of a copy.
pub fn the_place_of_a_copy(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tiles = unsafe {
        Tensor<f32, [2, 8, 32], Memory::SMEM>::uninit()
      };
      out[300] = 1.0;
      let k = n + 0;
      let copy = lanes::copy_async(&mut tiles[0], x, [k, 0]);
      copy.wait();
      for t in 0..32 across lanes(32) {
        out[t] = tiles[0][0][t];
      }
    }
  }
  return;
}

// The place of the next copy of a token.
pub fn the_place_of_the_next_copy(out : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..1 across blocks {
      let mut tiles = unsafe {
        Tensor<f32, [2, 8, 32], Memory::SMEM>::uninit()
      };
      let mut copy = lanes::copy_async(&mut tiles[0], x, [0, 0]);
      copy.wait();
      out[300] = 1.0;
      let k = n + 0;
      copy = lanes::copy_async(&mut tiles[1], x, [k, 0]);
      copy.wait();
      for t in 0..32 across lanes(32) {
        out[t] = tiles[1][0][t];
      }
    }
  }
  return;
}

// The tile of a matmul in the code of a subgroup. `k` is the index of the subgroup, but only lane 0
// of the subgroup has it.
pub fn the_tile_of_a_matmul(c : &mut Tensor<f32, [?, 2, 32, 16], Memory::HBM>, a : &Tensor<bf16, [?, 32], Memory::HBM>, b : &Tensor<bf16, [32, 16], Memory::HBM>) -> void {
  spawn on(Topology::Device) {
    for blk in 0..1 across blocks {
      let mut sa = unsafe {
        Tensor<bf16, [2, 32, 32], Memory::SMEM>::uninit()
      };
      let mut sb = unsafe {
        Tensor<bf16, [2, 32, 16], Memory::SMEM>::uninit()
      };
      let mut acc = unsafe {
        Tensor<f32, [2, 32, 16], Memory::SMEM>::uninit()
      };
      for w in 0..2 across subgroups {
        for i in 0..32 across lanes {
          for k in 0..32 {
            sa[w][i][k] = a[w * 32 + i][k];
          }
          for j in 0..16 {
            sb[w][i][j] = b[i][j];
            acc[w][i][j] = 1.0;
          }
        }
        c[blk][w][0][0] = 0.0;
        let k = w;
        acc[w] = acc[w] + (sa[k] as f32) @ (sb[w] as f32);
        for i in 0..32 across lanes {
          for j in 0..16 {
            c[blk][w][i][j] = acc[w][i][j];
          }
        }
      }
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
