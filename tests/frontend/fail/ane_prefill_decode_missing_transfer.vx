//===----------------------------------------------------------------------===//
// A prefill/decode split with each handoff deleted in turn.
//
// Only the inbound direction is refused, and that is the honest result rather
// than a gap in the test. `NPU` declares `visible: [NPU_HBM]`, so a region on it
// cannot read what the host left behind, and staging is enforced. The return
// journey is not: `CPU` declares `visible: [CPU_DRAM, NPU_HBM]` because Apple
// silicon shares one physical memory, so reading the KV where the Neural Engine
// left it is legal. benchmarks/flash_attention_ane/flash_attention.vx transfers
// it home regardless, so that the program means the same thing on a part that
// does not share memory.
//
// `Topology::AMX` would have made the return journey enforceable on paper --
// it declares `visible: [CPU_DRAM]` -- and does not: a region on AMX reading an
// NPU_HBM tensor produces no diagnostic at all. That is a second finding rather
// than a property to lean on here, and it is filed separately.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: E6003{{.*}}'prompt' lives in CPU_DRAM but NPU[0] sees only [NPU_HBM]

// Prefill cannot read the prompt where the host left it.
fn prefill_without_staging() -> void {
  let prompt = Tensor<f16, [ 16, 16 ]>::new();
  let mut out = Tensor<f16, [ 16, 16 ], Memory::NPU_HBM>::new();
  spawn on(Topology::NPU[0]) {
    out[0][0] = prompt[0][0];
  }
}

fn main() -> i32 {
  return 0;
}
