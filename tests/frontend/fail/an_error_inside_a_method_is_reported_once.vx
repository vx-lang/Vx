//===----------------------------------------------------------------------===//
// An error inside a method body is reported once, even when something calls the
// method. The call rewrites the body for emission; it must not report again.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

struct S {
  x : i32,
}

impl S {
  fn reset(self : &mut S) -> i32 {
    let r = &self.x;
    // CHECK: Error[E4009] at {{.*}}an_error_inside_a_method_is_reported_once.vx:[[@LINE+1]]:{{.*}}`self.x` is assigned while it is borrowed
    self.x = 0;
    return *r;
  }
}

fn main() -> i32 {
  let mut s = S {
    x : 1
  };
  print(s.reset());
  return 0;
}
// CHECK-NOT: E4009
// CHECK: 1 error(s) emitted
