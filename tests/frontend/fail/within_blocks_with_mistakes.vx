//===----------------------------------------------------------------------===//
// Each function here gets a `within` block wrong. The time limit of a block is a number of
// seconds, an `f64`. A block is a plain block, so it does not allow what needs `unsafe`. The
// block starts its deadline with a call that the compiler writes, and a program cannot write
// that call itself.
//
// RUN: not vxc %s --action emit-mlir -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Error[E3003] at {{.*}}within_blocks_with_mistakes.vx:19:10: the time limit of `within` is a number of seconds, an `f64`, but it is `bool`
// CHECK: Error[E5002] at {{.*}}within_blocks_with_mistakes.vx:26:12: Dereferencing a raw pointer requires an unsafe block
// CHECK: Error in {{.*}}within_blocks_with_mistakes.vx: Undefined static method 'vx::within_start'.

fn a_limit_that_is_a_word(limit : bool) -> void {
  within(limit) {
    println!("waits");
  }
}

fn a_raw_pointer_in_a_block(p : *const i64) -> i64 {
  within(0.1) {
    return *p;
  }
}

fn the_start_written_by_hand() -> void {
  vx::within_start(0.1);
}

fn main() -> i32 {
  return 0;
}
