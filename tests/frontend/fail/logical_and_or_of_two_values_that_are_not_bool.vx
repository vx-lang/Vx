//===----------------------------------------------------------------------===//
// Each side of `&&` and `||` must be a `bool`. Two sides of the same other type are error E3006
// too. A reference to a `bool` is not a `bool`: write `*r`.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error

fn and_of_two_i32(a : i32, b : i32) -> i32 {
  // CHECK: Error[E3006] at {{.*}}.vx:[[@LINE+1]]:8: `&&` takes two `bool` values, but both sides are i32
  if a && b {
    return 1;
  }
  return 0;
}

fn or_of_two_i64(a : i64, b : i64) -> i32 {
  // CHECK: Error[E3006] at {{.*}}.vx:[[@LINE+1]]:8: `||` takes two `bool` values, but both sides are i64
  if a || b {
    return 1;
  }
  return 0;
}

fn and_of_two_references(a : &bool, b : &bool) -> i32 {
  // CHECK: Error[E3006] at {{.*}}.vx:[[@LINE+1]]:8: `&&` takes two `bool` values, but both sides are &bool
  if a && b {
    return 1;
  }
  return 0;
}

fn and_through_the_references(a : &bool, b : &bool) -> i32 {
  if *a && *b {
    return 1;
  }
  return 0;
}

// CHECK: 3 error(s) emitted
fn main() -> i32 {
  let t = true;
  return and_of_two_i32(1, 2) + or_of_two_i64(1i64, 2i64) + and_of_two_references(&t, &t)
  + and_through_the_references(&t, &t);
}
