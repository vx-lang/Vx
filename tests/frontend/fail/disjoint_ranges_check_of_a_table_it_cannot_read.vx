//===----------------------------------------------------------------------===//
// `DisjointRanges::check(t)` reads the integer ranges of a tensor of shape `[?, 2]`, on the CPU.
// Each call here gives it a tensor that it cannot check.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s --implicit-check-not=Error

import core::option;

fn main() -> i32 {
  // Floats.
  // CHECK: Error[E3004] at {{.*}}:[[#@LINE+1]]:17: `DisjointRanges::check(t)` takes one tensor of shape `[?, 2]` of `i32`, `i64`, `u32` or `u64`, by value
  let _floats = DisjointRanges::check(Tensor<f32, [3, 2]>::fill(0.0));
  // One dimension.
  // CHECK: Error[E3004] at {{.*}}:[[#@LINE+1]]:15: `DisjointRanges::check(t)` takes one tensor of shape `[?, 2]`
  let _flat = DisjointRanges::check(Tensor<i32, [4]>::fill(0));
  // Three columns.
  // CHECK: Error[E3004] at {{.*}}:[[#@LINE+1]]:18: `DisjointRanges::check(t)` takes one tensor of shape `[?, 2]`
  let _triples = DisjointRanges::check(Tensor<i32, [4, 3]>::fill(0));
  // GPU memory, which the CPU cannot read.
  // CHECK: Error[E3004] at {{.*}}:[[#@LINE+1]]:17: `DisjointRanges::check(t)` reads the values of `t` on the CPU, but `t` is in HBM. Check the tensor before the transfer, and transfer the `DisjointRanges` tensor
  let _on_gpu = DisjointRanges::check(transfer(Tensor<i32, [3, 2]>::fill(0), Memory::HBM));
  return 0;
}
