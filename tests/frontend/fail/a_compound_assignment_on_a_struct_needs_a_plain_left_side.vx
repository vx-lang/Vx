//===----------------------------------------------------------------------===//
// `a += b` on a struct is `a = a + b`, so it reads its left side twice. A left side with a
// function call would call the function twice, so the compiler refuses it.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Error[E3004] at {{.*}}a_compound_assignment_on_a_struct_needs_a_plain_left_side.vx:47:3: a compound assignment on a struct or an enum reads its left side twice, so the left side must be a variable, a field of one, or `*r`: put the value in a variable, or write `a = a + b`
// CHECK: 1 error(s) emitted

import core::marker;
import core::ops;

struct Money {
  cents : i64,
}

impl Copy for Money {}

impl Add for Money {
  type Output = Money;
  fn add(self : Money, other : Money) -> Money {
    return Money {
      cents : self.cents + other.cents
    };
  }
}

struct Wallet {
  cash : Money,
}

fn the_wallet(w : &mut Wallet) -> &mut Wallet {
  return w;
}

fn main() -> i32 {
  let mut w = Wallet {
    cash : Money {
      cents : 10
    }
  };
  the_wallet(&mut w).cash += Money {
    cents : 5
  };
  println!("{}", w.cash.cents);
  return 0;
}
