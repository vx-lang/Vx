//===----------------------------------------------------------------------===//
// A module that declares C's `puts`. Compiled alone, it has no error.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: func.func private @puts(
extern "C" {
  fn puts(s : *const i8) -> i32;
}

fn say(s : *const i8) -> i32 {
  return unsafe { puts(s) };
}
