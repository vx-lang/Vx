// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// The end of a `tasks` block waits for each task that it started. So a `spawn` must be in a
// `tasks` block, and a task handle must not leave it: its only use is `h.join()`. A task body
// ends with its result, so a `return` or `break` must not leave it.

// CHECK: Error[E3056] at [[@LINE+2]]:11: `spawn { .. }` must be in a `tasks { .. }` block
fn no_tasks_block() -> i32 {
  let h = spawn {
    1
  };
  return h.join();
}

// CHECK: Error[E3056] at [[@LINE+3]]:23: a `spawn` in a closure is not in a `tasks` block
fn spawn_in_a_closure() -> void {
  tasks {
    let f = |x : i32| spawn {
      x
    };
  }
}

// CHECK: Error[E3056] at [[@LINE+4]]:7: a `spawn` directly in a task is not in a `tasks` block
fn spawn_directly_in_a_task() -> void {
  tasks {
    spawn {
      spawn {
        1
      };
    };
  }
}

// CHECK: Error[E3057] at [[@LINE+6]]:5: 'h' is a task handle
fn handle_is_the_value_of_the_block() -> i32 {
  return tasks {
    let h = spawn {
      1
    };
    h
  };
}

// CHECK: Error[E3057] at [[@LINE+6]]:13: 'h' is a task handle
fn handle_given_to_a_variable() -> void {
  tasks {
    let h = spawn {
      1
    };
    let g = h;
  }
}

// CHECK: Error[E3057] at [[@LINE+3]]:11: a task must not leave its `tasks` block, so a `spawn` must be the value of a `let` or a statement of its own
fn spawn_as_an_argument() -> void {
  tasks {
    print(spawn {
      1
    });
  }
}

// CHECK: Error[E3001] at [[@LINE+3]]:5: 'h' is a task handle of type 'Task<i32>', not 'i32'
fn handle_with_a_wrong_type() -> void {
  tasks {
    let h : i32 = spawn {
      1
    };
    h.join();
  }
}

// CHECK: Error[E3058] at [[@LINE+4]]:7: a `return` cannot leave a task
fn return_from_a_task() -> i32 {
  tasks {
    spawn {
      return 1;
    };
  }
  return 0;
}

// CHECK: Error[E3058] at [[@LINE+5]]:9: a `break` cannot leave a task
fn break_out_of_a_task() -> void {
  tasks {
    for i in 0..3 {
      spawn {
        break;
      };
    }
  }
}

// CHECK: Error[E3058] at [[@LINE+7]]:9: a task cannot join another task yet
fn task_joins_a_task() -> void {
  tasks {
    let a = spawn {
      1
    };
    let b = spawn {
      a.join() + 1
    };
    b.join();
  }
}

// CHECK: Error[E4001] at [[@LINE+7]]:5: Use of moved or consumed linear variable: h
fn joined_twice() -> void {
  tasks {
    let h = spawn {
      1
    };
    h.join();
    h.join();
  }
}

fn main() -> i32 {
  return 0;
}

// The errors above are all the errors.
// CHECK: {{^}}Semantic check failed on {{.*}}: 11 error(s) emitted
