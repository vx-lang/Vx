// RUN: not vxc %s 2>&1 | FileCheck %s
//
// Outside an `mlir!` block, a string can use only the escapes that Vx knows.
//
// CHECK: :15:{{.*}}this string has the escape `\0`, which Vx does not know. A string can use `\n`, `\t`, `\r`, `\"` and `\\`

fn main() -> i32 {
  let s = "a\0b";
  return 0;
}
