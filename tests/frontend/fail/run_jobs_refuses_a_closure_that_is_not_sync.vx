// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// The tasks of `run_jobs` and `try_run_jobs` call `work` at the same time, so `work` must be
// `Sync`. Each closure here captures a `Receiver`, which only one task may use at a time.

import core::option;
import core::result;
import std::sync::channel;
import std::sync::jobs;
import std::vec;

fn main() -> i32 {
  let (tx, rx) = channel<i64>(4);
  tx.send(5);
  let mut numbers = Vec<i64>::new();
  numbers.push(1);
  numbers.push(2);
  // CHECK: Error at {{.*}}run_jobs_refuses_a_closure_that_is_not_sync.vx:[[@LINE+1]]:3: Type 'Closure_1' does not implement trait 'Sync' required by parameter 'F': field 'rx' of 'Closure_1' has type '&Receiver<i64>'
  let r : Result<Vec<i64>, RunJobsError> = run_jobs(&numbers, 2, | job : &i64 | -> i64 {
    *job + rx.recv().unwrap()
  });
  println!("{}", r.is_ok());
  // CHECK: Error at {{.*}}run_jobs_refuses_a_closure_that_is_not_sync.vx:[[@LINE+1]]:3: Type 'Closure_2' does not implement trait 'Sync' required by parameter 'F': field 'rx' of 'Closure_2' has type '&Receiver<i64>'
  let t : Result<Vec<i64>, TryRunJobsError<i64>> = try_run_jobs(&numbers, 2, | job : &i64 | -> Result<i64, i64> {
    Result<i64, i64>::Ok(*job + rx.recv().unwrap())
  });
  println!("{}", t.is_ok());
  return 0;
}

// CHECK: {{^}}Semantic check failed on {{.*}}: 2 error(s) emitted
