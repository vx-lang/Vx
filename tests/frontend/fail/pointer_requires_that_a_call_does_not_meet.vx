//===----------------------------------------------------------------------===//
// Each call here can break a pointer `requires` (E8006). For now, a call that gets a raw pointer
// can free memory, so it ends each fact about memory that the body does not name. The drop of a
// local, a `spawn` and a pass of a loop do the same. A closure body and a task body start with no
// facts. A pointer to a local that is not `Copy` is `valid`, but not `initialized`: a move can take
// the value away.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

import core::ptr;
import std::vec;

fn need_valid(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  return n;
}

fn need_initialized(p : *const Vec<i64>, n : i64) -> i64
requires initialized(p, n)
{
  return n;
}

fn copy(dst : *mut i64, src : *const i64, n : i64) -> void
requires valid(dst, n)
requires valid(src, n)
requires !overlaps(dst, src, n)
{
  return;
}

fn touch(p : *const i64) -> void {
  return;
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+4]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn one_element_too_many(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  return need_valid(p, n + 1i64);
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+5]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn past_the_end(p : *const i64, n : i64, k : i64) -> i64
requires valid(p, n)
requires 0i64 < k && k <= n
{
  return need_valid(offset(p, k), n);
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+2]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn with_no_facts(p : *const i64, n : i64) -> i64 {
  return need_valid(p, n);
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+5]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn after_a_call_that_gets_the_pointer(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  touch(p);
  return need_valid(p, n);
}

// The call on the first pass can free the memory before the call on the second pass.
// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+6]]:13: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn in_a_loop(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for i in 0i64..3i64 {
    t = t + need_valid(p, n);
  }
  return t;
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+7]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn after_a_branch_that_gets_the_pointer(p : *const i64, n : i64, c : bool) -> i64
requires valid(p, n)
{
  if c {
    touch(p);
  }
  return need_valid(p, n);
}

// The drop of `v` at the end of the branch can free memory.
// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+7]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn after_a_drop(p : *const i64, n : i64, c : bool) -> i64
requires valid(p, n)
{
  if c {
    let _v = Vec<i64>::new();
  }
  return need_valid(p, n);
}

// `q` is `p` after one branch, and a pointer to one `i64` after the other.
// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+10]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn a_pointer_that_a_branch_assigns(p : *const i64, n : i64, c : bool) -> i64
requires valid(p, n)
requires n > 1i64
{
  let x = 5i64;
  let mut q = p;
  if c {
    q = &x;
  }
  return need_valid(q, n);
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+4]]:23: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn in_a_closure(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let f = | k : i64 | need_valid(p, n) + k;
  return f(1i64);
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+9]]:9: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn after_a_spawn(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  tasks {
    let h = spawn {
      0i64
    };
    t = need_valid(p, n) + h.join();
  }
  return t;
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+6]]:3: this call to 'copy' may not meet its precondition `!overlaps(dst, src, n)`
fn windows_that_meet(p : *mut i64, n : i64) -> void
requires valid(p, n + n)
requires n > 0i64
{
  let second = offset_mut(p, n - 1i64);
  copy(p, second as *const i64, n);
}

// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+4]]:10: this call to 'need_initialized' may not meet its precondition `initialized(p, n)`
fn a_pointer_to_a_local_that_is_not_copy() -> i64 {
  let v = Vec<i64>::new();
  let p : *const Vec<i64> = &v;
  return need_initialized(p, 1i64);
}

// After the loop, `q` is null when `k` is 0.
// CHECK-DAG: E8006] at {{.*}}pointer_requires_that_a_call_does_not_meet.vx:[[@LINE+7]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
fn a_pointer_that_a_loop_assigns(k : i64) -> i64 {
  let a = 1i64;
  let mut q = null<i64>();
  for i in 0i64..k {
    q = &a;
  }
  return need_valid(q, 1i64);
}

fn main() -> i32 {
  return 0;
}

// CHECK: 13 error(s) emitted
