// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Unexpected --implicit-check-not=impl
//
// An attribute that is not `derive` gets the same first sentence, with no `impl` to suggest.

#[inline]
fn one() -> i32 {
  return 1;
}

fn main() -> i32 {
  return one();
}

// CHECK: Vx has no attributes yet, so `#[...]` does not work.
