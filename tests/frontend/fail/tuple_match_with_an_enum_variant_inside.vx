//===----------------------------------------------------------------------===//
// An enum variant inside a tuple pattern is not supported yet.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: an enum variant inside a tuple pattern is not supported yet
import core::option;

fn main() -> i32 {
  let t = (Option<i32>::Some(1), 2);
  match t {
    (Option<i32>::Some(x), y) => {
      print(x + y);
    }, _ => {
      print(0);
    }
  }
  return 0;
}
