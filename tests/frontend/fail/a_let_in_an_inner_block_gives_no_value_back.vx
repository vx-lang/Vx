// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A `let t` in an inner block declares a new variable. It does not give a value back to the
// outer `t`, which the program moved. So the outer `t` cannot be used after the block, and a
// loop cannot move it again on its next pass.

struct Noisy {
  id : i32,
}

fn take(x : Noisy) -> i32 {
  return x.id;
}

fn after_an_unsafe_block() -> i32 {
  let t = Noisy {
    id: 1
  };
  print(take(t));
  unsafe { let t = Noisy { id: 2 }; print(t.id); }
  // CHECK: Error[E4001] at {{.*}}a_let_in_an_inner_block_gives_no_value_back.vx:[[# @LINE + 1]]:10: Use of moved or consumed linear variable: t
  return t.id;
}

fn in_a_loop() -> i32 {
  let t = Noisy {
    id: 3
  };
  let mut i = 0;
  // CHECK: Error[E4001] at {{.*}}a_let_in_an_inner_block_gives_no_value_back.vx:[[# @LINE + 1]]:3: `t` is moved inside this loop and not given a new value before the loop goes round again
  while i < 2 {
    print(take(t));
    let t = Noisy {
      id: 4
    };
    print(t.id);
    i = i + 1;
  }
  return 0;
}

fn main() -> i32 {
  return 0;
}
