//===----------------------------------------------------------------------===//
// A `within:` cycle in the memory hierarchy is incoherent and rejected (E6006).
//
// RUN: not vxc %s 2>&1 | FileCheck %s

Memory Ring0 {
  within: Memory::Ring1
}
Memory Ring1 {
  within: Memory::Ring0
}

fn main() -> i32 {
  return 0;
}

// CHECK: E6006
