//===----------------------------------------------------------------------===//
// `p as *mut f32 in Memory::HBM` reads host memory as GPU memory. It is right only when the
// two are one memory, which a machine file says with a `transfer Memory::CPU_DRAM ->
// Memory::HBM : shared` edge, as the M4's file does. The H100's GPU has memory of its own, so
// both casts below are errors there. On the M4, the cast outside `unsafe` is an error.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --check-prefix=H100 --implicit-check-not=Error
// RUN: not vxc %s --host default --machine fleet/m4-uma.vx --emit-mlir -o /dev/null 2>&1 | FileCheck %s --check-prefix=M4 --implicit-check-not=Error
// H100: Error at {{.*}}pointer_casts_into_gpu_memory_need_a_shared_edge.vx:20:{{.*}}cannot cast `*mut f32` to `*mut f32 in Memory::HBM`: the machine file has no `transfer Memory::CPU_DRAM -> Memory::HBM : shared` edge, so `HBM` may be other memory. Use `transfer` to copy the data
// H100: Error at {{.*}}pointer_casts_into_gpu_memory_need_a_shared_edge.vx:24:{{.*}}cannot cast `*mut f32` to `*mut f32 in Memory::HBM`: the machine file has no
// M4: Error at {{.*}}pointer_casts_into_gpu_memory_need_a_shared_edge.vx:24:{{.*}}casting `*mut f32` to `*mut f32 in Memory::HBM` requires an unsafe block: the compiler cannot check that the memory stays valid

fn in_unsafe(p : *mut f32) -> *mut f32 in Memory::HBM {
  return unsafe { p as *mut f32 in Memory::HBM };
}

fn outside_unsafe(p : *mut f32) -> *mut f32 in Memory::HBM {
  return p as *mut f32 in Memory::HBM;
}

fn main() -> i32 {
  return 0;
}
