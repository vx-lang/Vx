// RUN: not vxc --package tests=tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// This file declares a macro `label`, and it imports macro_label_left.vx, which declares one
// too. So the call `label!` can mean either macro, and it is an error.
import tests::modules::macro_label_left;

struct Here {
  x : i64,
}

macro_rules label {
  ($t : ident) => {
    impl $t {
      fn label(self : &Self) -> i64 {
        return 3i64;
      }
    }
  };
}

label!(Here);

fn main() -> i32 {
  return 0;
}

// CHECK: `a_file_that_can_call_two_macros_with_one_name.vx` can call more than one macro `label`: it is in `a_file_that_can_call_two_macros_with_one_name.vx` and `macro_label_left.vx`. Give each macro its own name.
