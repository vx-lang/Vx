// RUN: not vxc %s 2>&1 | FileCheck %s

// The impl only applies when the holder's iterator hands out `i64`s; this one hands out `f64`s.
import core::iter;

trait Seven {
  fn seven(self : &Self) -> i64;
}

struct Holder<T> {
  v : T,
}

impl<T : Iterator<Item = i64>> Seven for Holder<T> {
  fn seven(self : &Holder<T>) -> i64 {
    return 7i64;
  }
}

fn main() -> i32 {
  let h = Holder {
    v : range(0i64, 3i64).map(| x : i64 | 1.5f64)
  };
  // CHECK: Method 'seven' not found on type Holder<Map<Range, Closure1<i64, f64>>>
  let s = h.seven();
  return 0;
}
