// RUN: env VX_NO_AST_FALLBACK=1 not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// RUN: not vxc %s -O2 2>&1 | FileCheck %s
//
// The remainder of the smallest `i128` divided by -1 overflows, as the division does, so it
// stops the program, on both code generators and at -O2.

// CHECK: attempt to calculate the remainder with overflow
// CHECK-NOT: wrong answer
fn remainder(a : i128, b : i128) -> i128 {
  return a % b;
}

fn main() -> i32 {
  let min = (1u128 << 127u128) as i128;
  print(remainder(min, -1i128) as i64);
  print!(" wrong answer");
  return 0;
}
