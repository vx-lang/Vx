// An out-of-range index inside a closure must still report E8003. The type-based
// check returns early when capturing, so the value check must cover this case.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
fn main() -> i32 {
  let a : Tensor<i64, [3]> = [ 3i64, 1i64, 2i64 ];
  let f = ||
  // CHECK: E8003] at {{.*}}tensor_index_out_of_range_in_closure.vx:[[@LINE+1]]:{{.*}}index 5 is out of range
  a[5];
  println!(f());
  return 0;
}
// CHECK-NOT: E8003
