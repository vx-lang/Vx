// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// `println` and `vec` are macros, so a call to one needs a `!`. A call without the `!` is
// a call to an undefined function (E2002), and the error says how to call the macro. A name
// that is not a macro gets only E2002.

fn main() -> i32 {
  // CHECK: Error[E2002] at {{.*}}.vx:[[@LINE+1]]:3: Undefined function 'println'. To call the macro `println`, write `println!`{{$}}
  println(1);
  // CHECK: Error[E2002] at {{.*}}.vx:[[@LINE+1]]:12: Undefined function 'vec'. To call the macro `vec`, write `vec!`{{$}}
  let _v = vec(2);
  // CHECK: Error[E2002] at {{.*}}.vx:[[@LINE+1]]:3: Undefined function 'printline'{{$}}
  printline(3);
  return 0;
}
