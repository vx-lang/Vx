// RUN: not vxc --package tests=tests --no-trusted-code tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: not vxc -j 4 --package tests=tests --no-trusted-code tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests %s 2>&1 | FileCheck %s --check-prefix=ALLOWED
// RUN: vxc --package tests=tests --audit %s 2>&1 | FileCheck %s --check-prefix=AUDIT --implicit-check-not='n > 0'
//
// C code can call `length_of` of the package `tests` with any pointer. So its two pointer
// `requires` are trusted code, and `vxc --no-trusted-code tests` refuses each one. The
// `requires n > 0` of `twice` names no pointer, so the audit does not list it, and the flag
// allows it. Without the flag, the program runs, and the audit lists the two pointer clauses.
import tests::modules::a_package_that_exports_functions_to_c;

fn main() -> i32 {
  print(twice(21));
  return 0;
}

// CHECK: Error[E5003] at {{.*}}a_package_that_exports_functions_to_c.vx:12:10: `--no-trusted-code tests` refuses trusted code in the package `tests`, and this is the `requires valid(p, n)` of the exported function `length_of`, which a call from C does not prove
// CHECK: Error[E5003] at {{.*}}a_package_that_exports_functions_to_c.vx:13:10: {{.*}}and this is the `requires initialized(p, n)` of the exported function `length_of`, which a call from C does not prove
// CHECK: Semantic check failed on '{{.*}}no_trusted_code_refuses_a_requires_that_c_does_not_prove.vx': 2 error(s) emitted

// ALLOWED: {{^}}42{{$}}

// AUDIT: a_package_that_exports_functions_to_c.vx:12:10: the exported function `length_of` requires `valid(p, n)`, and a call from C proves nothing
// AUDIT: a_package_that_exports_functions_to_c.vx:13:10: the exported function `length_of` requires `initialized(p, n)`, and a call from C proves nothing
