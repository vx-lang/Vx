// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A digit comes straight after the point, as in Rust. `1._5` is not `1.5`.

fn main() -> i32 {
  // CHECK: a digit must follow the '.' in '1._5'
  let a = 1._5;
  return 0;
}
