//===----------------------------------------------------------------------===//
// The error for a precondition that a call may not meet (E8006) quotes the precondition.
// An operand that binds less tightly than its operator keeps its parentheses, so the quote
// means what the program wrote. An operand that needs no parentheses is quoted without them.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
fn product_of_a_sum(a : i32, b : i32, c : i32) -> i32
requires (a + b) * c > 0 {
  return a;
}

fn difference_of_a_difference(a : i32, b : i32, c : i32) -> i32
requires a - (b - c) > 0 {
  return a;
}

fn sum_of_a_product(a : i32, b : i32, c : i32) -> i32
requires a + b * c > 0 {
  return a;
}

fn twice_negated(x : i32) -> i32
requires -(-x) > 0 {
  return x;
}

fn equal_comparisons(a : i32, b : i32, c : i32) -> i32
requires (a < b) == (b < c) {
  return a;
}

fn main(n : i32) -> i32 {
  // CHECK-DAG: E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'product_of_a_sum' may not meet its precondition `(a + b) * c > 0`
  let a = product_of_a_sum(n, n, n);
  // CHECK-DAG: E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'difference_of_a_difference' may not meet its precondition `a - (b - c) > 0`
  let b = difference_of_a_difference(n, n, n);
  // CHECK-DAG: E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'sum_of_a_product' may not meet its precondition `a + b * c > 0`
  let c = sum_of_a_product(n, n, n);
  // CHECK-DAG: E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'twice_negated' may not meet its precondition `-(-x) > 0`
  let d = twice_negated(n);
  // CHECK-DAG: E8006] at {{.*}}.vx:[[@LINE+1]]:11: this call to 'equal_comparisons' may not meet its precondition `(a < b) == (b < c)`
  let e = equal_comparisons(n, n + 1, n);
  return a + b + c + d + e;
}
// CHECK: 5 error(s) emitted
