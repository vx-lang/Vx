//===----------------------------------------------------------------------===//
// Byte buffers a `comptime` block must refuse rather than answer wrongly. Each error points at
// the value the block ends with.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn fresh() -> *mut i8 {
  return "twenty bytes of text" as *mut i8;
}

// `k` is only known at run time, so either branch may have run, and the byte is not known.
fn depends_on(k : i32) -> i32 {
  let s = comptime {
    let buf = "ab" as *mut i8;
    if k > 0 {
      unsafe { buf[0i64] = 65i8; }
    } else {
      unsafe { buf[0i64] = 66i8; }
    }
    // CHECK: Error[E3033] at [[@LINE+1]]:{{.*}}cannot be evaluated
    buf as *const i8
  };
  print!(s);
  return 0;
}

fn main() -> i32 {
  // A write past the end of the buffer.
  let a = comptime {
    let buf = "ab" as *mut i8;
    unsafe { buf[5i64] = 0i8; }
    // CHECK: Error[E3033] at [[@LINE+1]]:{{.*}}a statement the evaluator cannot run
    buf as *const i8
  };

  // Its NUL is overwritten, so the text has no end to be written out with.
  let b = comptime {
    let buf = "ab" as *mut i8;
    unsafe { buf[2i64] = 65i8; }
    // CHECK: Error[E3033] at [[@LINE+1]]:{{.*}}not one that can be written as a constant
    buf as *const i8
  };

  // 100000 buffers of 21 bytes is past the 1 MiB one `comptime` block may allocate.
  let c = comptime {
    let mut i = 0i64;
    let mut last = fresh();
    loop {
      if i == 100000i64 {
        break;
      }
      last = fresh();
      i = i + 1i64;
    }
    // CHECK: Error[E3033] at [[@LINE+1]]:{{.*}}cannot be evaluated
    last as *const i8
  };
  return 0;
}
