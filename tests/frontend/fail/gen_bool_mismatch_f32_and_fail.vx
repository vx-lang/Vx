//===- gen_bool_mismatch_f32_and_fail.vx ---------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Type mismatch in logical operation: Scalar(Bool) vs Scalar(F32)

fn main() -> Bool {
  let a: Bool = true;
  let b: f32 = 1f32;
  // EXPECT: Type mismatch
  return a && b;
}
