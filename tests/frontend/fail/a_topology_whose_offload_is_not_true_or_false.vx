//===----------------------------------------------------------------------===//
// `offload:` says whether the fleet may run a topology on a worker of another node, so it takes
// `true` or `false`.
//
// RUN: not vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: `offload:` expects true or false

Memory HBM {
  capacity: 96 GiB, bandwidth: 4 TB/s, managed: explicit, scope: device
}

Topology Gpu {
  arch: nvptx64,
  memory: Memory::HBM,
  visible: [Memory::HBM],
  offload: maybe,
  transfer Memory::CPU_DRAM -> Memory::HBM : 450 GB/s
}

fn main() -> i32 {
  return 0;
}
