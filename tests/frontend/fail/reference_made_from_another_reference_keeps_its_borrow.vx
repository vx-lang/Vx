//===----------------------------------------------------------------------===//
// A reference made from another reference keeps the first one's borrow while it is used.
// RUN: not vxc %s 2>&1 | FileCheck %s

struct S {
  x : i32,
}

struct H {
  r : &i32,
}

struct M {
  r : &mut S,
}

// `x` points into `v` through `t`, after `t`'s last use.
fn field_through_a_shared_reference() -> void {
  let mut v = S {
    x : 1
  };
  let t = &v;
  let x = &t.x;
  // CHECK: Error[E4009] at [[# @LINE + 1]]:3: `v` is assigned while it is borrowed
  v = S {
    x : 2
  };
  print(*x);
}

fn field_through_a_mut_reference() -> void {
  let mut a = S {
    x : 1
  };
  let keep = &mut a;
  let seen = &keep.x;
  // CHECK: Error[E4009] at [[# @LINE + 1]]:5: `a.x` is assigned while it is borrowed
  a.x = 7;
  print(*seen);
}

// `let b = a` copies the `&mut`, so `a` cannot be used while `b` is.
fn mut_reference_copied_by_let() -> void {
  let mut s = S {
    x : 1
  };
  let a = &mut s;
  let b = a;
  let r = &b.x;
  // CHECK: Error[E4009] at [[# @LINE + 1]]:5: `a.x` is assigned while it is borrowed
  a.x = 5;
  print(*r);
}

fn mut_reference_copied_into_a_struct() -> void {
  let mut s = S {
    x : 1
  };
  let a = &mut s;
  let m = M {
    r : a
  };
  // CHECK: Error[E4002] at [[# @LINE + 1]]:5: Cannot access 'a' because it is mutably borrowed
  a.x = 5;
  print(m.r.x);
}

fn reference_copied_out_of_a_field() -> void {
  let mut x = 1;
  let h = H {
    r : &x
  };
  let w = h.r;
  // CHECK: Error[E4009] at [[# @LINE + 1]]:3: `x` is assigned while it is borrowed
  x = 2;
  print(*w);
}
// CHECK: 5 error(s) emitted

fn main() -> i32 {
  field_through_a_shared_reference();
  field_through_a_mut_reference();
  mut_reference_copied_by_let();
  mut_reference_copied_into_a_struct();
  reference_copied_out_of_a_field();
  return 0;
}
