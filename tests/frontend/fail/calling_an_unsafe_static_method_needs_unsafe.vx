// RUN: not vxc %s 2>&1 | FileCheck %s
//
// Calling an `unsafe fn` through its type's name, `Cell::make(..)`, needs an `unsafe` block
// (E5001). The second call is checked differently from the first, so both are tested.

// CHECK: Error[E5001] at 30:11: Call to unsafe function 'Cell::make'
// CHECK: Error[E5001] at 31:11: Call to unsafe function 'Cell::make'
// CHECK-NOT: Error[E5001]

struct Cell {
  v : i32,
}

impl Cell {
  unsafe fn make(v : i32) -> Cell {
    return Cell {
      v : v
    };
  }
}

fn main() -> i32 {
  let a = Cell::make(1);
  let b = Cell::make(2);
  let c = unsafe { Cell::make(3) };
  return a.v + b.v + c.v;
}
