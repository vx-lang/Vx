//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A `&mut &mut i32` must not become a `&mut &i32`. A write through the `&mut &i32` could
// store a shared reference in the `&mut i32` variable, and the program could then write
// to a value that other code only reads.

fn store_shared(pp : &mut &i32, shared : &i32) -> i32 {
  *pp = shared;
  return 0;
}

fn declare_with_the_shared_type(shared : &i32) -> i32 {
  let mut dummy = 0;
  let mut slot : &mut i32 = &mut dummy;
  // CHECK-NOT: Error
  // CHECK: Error[E3001] at {{.*}}mut_reference_to_a_mut_reference_cannot_become_shared.vx:[[# @LINE + 1]]:3: 'forged' is declared &mut &i32 but its initializer is &mut &mut i32
  let forged : &mut &i32 = &mut slot;
  *forged = shared;
  *slot = 99;
  return *shared;
}

fn pass_to_a_parameter(shared : &i32) -> i32 {
  let mut dummy = 0;
  let mut slot : &mut i32 = &mut dummy;
  // CHECK: Error[E3003] at {{.*}}mut_reference_to_a_mut_reference_cannot_become_shared.vx:[[# @LINE + 1]]:11: Type mismatch in argument 1 for function 'store_shared'. Expected &mut &i32, got &mut &mut i32
  let _ = store_shared(&mut slot, shared);
  *slot = 99;
  return *shared;
}

// A shared reference cannot write, so a `&&mut i32` can be read as a `&&i32`.
fn shared_reference_to_a_mut_reference(shared : &i32) -> i32 {
  let mut dummy = 0;
  let slot : &mut i32 = &mut dummy;
  let r : &&i32 = &slot;
  return **r + *shared;
}
// CHECK-NOT: Error

fn main() -> i32 {
  let x = 7;
  return declare_with_the_shared_type(&x) + pass_to_a_parameter(&x)
  + shared_reference_to_a_mut_reference(&x);
}
