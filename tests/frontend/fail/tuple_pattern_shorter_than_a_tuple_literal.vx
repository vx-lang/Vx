//===----------------------------------------------------------------------===//
// A tuple pattern needs as many elements as the tuple literal it takes apart.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: the pattern has 2 elements, but the tuple has 3
fn main() -> i32 {
  let (p, q) = (1, 2, 3);
  print(p + q);
  return 0;
}
