// Vx has no `impl Trait` type yet. The error points at `impl`, names the trait the user wrote
// and says what to write in a parameter. A return type gets the same error, so the advice
// says "in a parameter".
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: mkdir -p %t.d
// RUN: printf 'trait Display {\n  fn show(self : &Self) -> i32;\n}\nfn f(g : impl Display) -> i32 {\n  return 0;\n}\n' > %t.d/no_borrow.vx
// RUN: not vxc %t.d/no_borrow.vx 2>&1 | FileCheck %s --check-prefix=NO-BORROW
// RUN: printf 'trait Area {\n  fn area(self : &Self) -> i32;\n}\nfn make() -> impl Area {\n  return 0;\n}\n' > %t.d/return_type.vx
// RUN: not vxc %t.d/return_type.vx 2>&1 | FileCheck %s --check-prefix=RETURN
// NO-BORROW: Error at {{.*}}no_borrow.vx:4:10: Vx has no `impl Trait` type yet. In a parameter, write a generic parameter instead, as in `fn show<T : Display>(g : &T)`
// RETURN: Error at {{.*}}return_type.vx:4:14: Vx has no `impl Trait` type yet. In a parameter, write a generic parameter instead, as in `fn show<T : Area>(g : &T)`

trait Get {
  fn get(self : &Self) -> i32;
}

// CHECK: Error at {{.*}}impl_trait_as_a_parameter_type.vx:[[@LINE+1]]:14: Vx has no `impl Trait` type yet. In a parameter, write a generic parameter instead, as in `fn show<T : Get>(g : &T)`
fn show(g : &impl Get) -> i32 {
  return g.get();
}

fn main() -> i32 {
  return 0;
}
