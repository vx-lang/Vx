//===----------------------------------------------------------------------===//
// Each call here gets E8006, because a pass of a loop can free memory before it. The compiler
// reads the loop body before it checks it, so an event anywhere in the body ends the facts at the
// start of the body. The note gives the line of the first event in the body.
//
// RUN: not vxc %s 2>&1 | FileCheck %s

import core::ptr;
import std::vec;

fn need_valid(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  return n;
}

fn need_initialized(p : *const Vec<i64>, n : i64) -> i64
requires initialized(p, n)
{
  return n;
}

fn keep(_p : *const Vec<i64>) -> void {
  return;
}

struct Holder {
  f : || -> i64,
}

// In each pass, the `push` runs before the call.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+8]]:13: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `v`, in a pass of the loop (at [[@LINE+6]]:7)
fn in_a_loop_that_calls_push(p : *const i64, n : i64, v : &mut Vec<i64>) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for i in 0i64..3i64 {
    v.push(i);
    t = t + need_valid(p, n);
  }
  return t;
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+8]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `v`, in a pass of the loop (at [[@LINE+5]]:7)
fn after_a_loop_that_calls_push(p : *const i64, n : i64, v : &mut Vec<i64>) -> i64
requires valid(p, n)
{
  for i in 0i64..3i64 {
    v.push(i);
  }
  return need_valid(p, n);
}

// The vector drops at the end of each pass.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+8]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `_w`, which drops its value, in a pass of the loop (at [[@LINE+5]]:5)
fn after_a_loop_with_a_vector_in_the_body(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    let _w = Vec<i64>::new();
  }
  return need_valid(p, n);
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+9]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at an assignment that drops the old value, in a pass of the loop (at [[@LINE+6]]:5)
fn after_a_loop_that_assigns_a_vector(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let mut w = Vec<i64>::new();
  for _i in 0i64..3i64 {
    w = Vec<i64>::new();
  }
  return need_valid(p, n);
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+9]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call of the closure `g`, which can free memory through what it captures, in a pass of the loop (at [[@LINE+6]]:13)
fn after_a_loop_that_calls_a_closure(p : *const i64, n : i64, g : || -> i64) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    t = t + g();
  }
  return need_valid(p, n) + t;
}

// The parser gives this call no place, so the note gives the line of its statement.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+9]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call of the closure `h.f`, which can free memory through what it captures, in a pass of the loop (at [[@LINE+6]]:5)
fn after_a_loop_that_calls_a_closure_in_a_field(p : *const i64, n : i64, h : Holder) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    t = t + (h.f)();
  }
  return need_valid(p, n) + t;
}

// A closure that the body makes has a type that the compiler does not know before the check.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+12]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call of the closure `f`, which can free memory through what it captures, in a pass of the loop (at [[@LINE+9]]:13)
fn after_a_loop_that_calls_a_closure_that_it_makes(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    let f = || -> i64 {
      return 1i64;
    };
    t = t + f();
  }
  return need_valid(p, n) + t;
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+8]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call through `g`, which can free memory through `p`, in a pass of the loop (at [[@LINE+5]]:5)
fn after_a_loop_that_gives_the_pointer_to_a_function_value(p : *const i64, n : i64, g : fn(*const i64) -> void) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    g(p);
  }
  return need_valid(p, n);
}

// The inner loop calls `next` on an iterator over the vector.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+11]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'next' of the `for` loop, which can free memory through `&v`, in a pass of the loop (at [[@LINE+6]]:5)
fn after_a_loop_over_a_vector(p : *const i64, n : i64, v : Vec<i64>) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    for x in &v {
      t = t + *x;
    }
  }
  return need_valid(p, n) + t;
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+13]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the `mlir!` block, which can free memory, in a pass of the loop (at [[@LINE+6]]:19)
fn after_a_loop_with_an_mlir_block(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    let z = mlir!(inputs : (%q = p : !llvm.ptr), returns : i64, dialects : ["llvm", "arith"]) {
      %z = arith.constant 0 : i64
      macro.yield %z : i64
    };
    t = t + z;
  }
  return need_valid(p, n) + t;
}

// The `let` of the task comes first, but the compiler does not know its type before the check.
// So the note gives the `spawn`, which can free memory for certain.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+14]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the `spawn`, whose task can free memory, in a pass of the loop (at [[@LINE+7]]:15)
fn after_a_loop_with_a_spawn(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    tasks {
      let h = spawn {
        0i64
      };
      t = t + h.join();
    }
  }
  return need_valid(p, n) + t;
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+10]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the `spawn`, whose task can free memory, in a pass of the loop (at [[@LINE+5]]:5)
fn after_a_loop_with_a_spawn_on_block(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    spawn on(Topology::CpuAvx512) {
      let _x = 1i64;
    }
  }
  return need_valid(p, n);
}

// In the body, `r` is a reference to a vector. The parameter `r` is a number.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+9]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `r`, in a pass of the loop (at [[@LINE+6]]:7)
fn after_a_loop_whose_variable_hides_a_parameter(p : *const i64, n : i64, r : i64, mut v : Vec<i64>) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    let r = &mut v;
    r.push(1i64);
  }
  return need_valid(p, n) + r;
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+11]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `_w`, which drops its value, in a pass of the loop (at [[@LINE+6]]:7)
fn after_a_loop_with_an_inner_loop(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    loop {
      let _w = Vec<i64>::new();
      break;
    }
  }
  return need_valid(p, n);
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+10]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `_w`, which drops its value, in a pass of the loop (at [[@LINE+6]]:7)
fn after_a_loop_with_a_branch(p : *const i64, n : i64, c : bool) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    if c {
      let _w = Vec<i64>::new();
    }
  }
  return need_valid(p, n);
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+13]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `_w`, which drops its value, in a pass of the loop (at [[@LINE+7]]:9)
fn after_a_loop_with_a_match(p : *const i64, n : i64, o : Option<i64>) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    match o {
      Option::Some(_x) => {
        let _w = Vec<i64>::new();
      }
      Option::None => {}
    }
  }
  return need_valid(p, n);
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+8]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `_w`, which drops its value, in a pass of the loop (at [[@LINE+5]]:14)
fn after_a_loop_with_an_unsafe_block(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    unsafe { let _w = Vec<i64>::new(); }
  }
  return need_valid(p, n);
}

// Before the `let`, `w` is the parameter.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+11]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `w`, in a pass of the loop (at [[@LINE+6]]:7)
fn after_a_loop_that_uses_a_parameter_before_a_let_of_its_name(p : *const i64, n : i64, mut w : Vec<i64>) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    w.push(1i64);
    let w = 5i64;
    t = t + w;
  }
  return need_valid(p, n) + t;
}

// The second `r` is a reference to a vector.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+14]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'push', which can free memory through `r`, in a pass of the loop (at [[@LINE+10]]:9)
fn after_a_loop_that_declares_a_name_twice(p : *const i64, n : i64, mut v : Vec<i64>, c : bool) -> i64
requires valid(p, n)
{
  let mut t = 0i64;
  for _i in 0i64..3i64 {
    let r = 5i64;
    t = t + r;
    if c {
      let r = &mut v;
      r.push(1i64);
    }
  }
  return need_valid(p, n) + t;
}

// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+10]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `_w`, which drops its value, in a pass of the loop (at [[@LINE+6]]:7)
fn after_a_loop_with_a_tasks_block(p : *const i64, n : i64) -> i64
requires valid(p, n)
{
  for _i in 0i64..3i64 {
    tasks {
      let _w = Vec<i64>::new();
    }
  }
  return need_valid(p, n);
}

// A `for` loop can run no pass. Then `q` is still `p`, and nothing says that `p` is valid. No
// event ended a fact, so the error has no note.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+9]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NOT: note:
fn after_a_for_loop_that_can_run_no_pass(p : *const i64, r : *const i64, n : i64) -> i64
requires valid(r, n)
{
  let mut q = p;
  for _i in 0i64..n {
    q = r;
  }
  return need_valid(q, n);
}

// `q` points at `x`, whose scope ends at the `break`.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+12]]:10: this call to 'need_valid' may not meet its precondition `valid(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the end of the scope of `x`, in the branch where `c` is true (at [[@LINE+8]]:7)
fn after_a_break_out_of_a_branch(c : bool) -> i64 {
  let x0 = 1i64;
  let mut q : *const i64 = &x0;
  loop {
    if c {
      let x = 5i64;
      q = &x;
      break;
    }
  }
  return need_valid(q, 1i64);
}

// The body of a `while` is not a branch, so the note names no branch.
// CHECK: E8006] at {{.*}}pointer_facts_that_a_loop_ends.vx:[[@LINE+9]]:13: this call to 'need_initialized' may not meet its precondition `initialized(p, n)`
// CHECK-NEXT: note: a fact that proves it ended at the call to 'keep', which can free memory through `p` (at [[@LINE+7]]:5)
fn in_the_body_of_a_while(n : i64) -> i64 {
  let mut i = 0i64;
  let mut t = 0i64;
  while i < n {
    let v = Vec<i64>::new();
    let p : *const Vec<i64> = &v;
    keep(p);
    t = t + need_initialized(p, 1i64);
    i = i + 1i64;
  }
  return t;
}

fn main() -> i32 {
  return 0;
}

// CHECK: 23 error(s) emitted
