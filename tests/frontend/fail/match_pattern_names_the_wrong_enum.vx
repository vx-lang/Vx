// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// A variant pattern must name the matched value's enum and one of its variants. The compiler
// used to look at the variant name only, so `Other::Red` and `Nonsense::Blue(n)` matched a
// `Color`, and `Color::Green` was accepted although `Color` has no `Green`.

enum Color {
  Red,
  Blue(i64),
}

enum Other {
  Red,
  Blue(i64),
}

fn by_value(c : Color) -> i64 {
  match c {
    // CHECK-DAG: Error[E3051] at [[@LINE+1]]:5: this pattern is a variant of `Other`, but the value matched is a `Color`; write `Color::Red`
    Other::Red => {
      return 1;
    }
    // CHECK-DAG: Error[E2003] at [[@LINE+1]]:5: Unknown enum Nonsense
    Nonsense::Blue(n) => {
      return n;
    }
  }
}

fn missing_variant(c : Color) -> i64 {
  match c {
    Color::Red => {
      return 1;
    }
    // CHECK-DAG: Error[E2004] at [[@LINE+1]]:5: Enum Color does not have variant Green
    Color::Green => {
      return 2;
    }
    Color::Blue(n) => {
      return n;
    }
  }
}

fn by_reference(c : &Color) -> i64 {
  match c {
    // CHECK-DAG: Error[E3051] at [[@LINE+1]]:5: this pattern is a variant of `Other`, but the value matched is a `Color`; write `Color::Red`
    Other::Red => {
      return 1;
    }
    _ => {
      return 0;
    }
  }
}

fn main() -> i32 {
  let c : Color = Color::Blue(4);
  print(by_value(c));
  return 0;
}

// CHECK: 4 error(s) emitted
