// RUN: not vxc %s 2>&1 | FileCheck %s
//
// A reference that a call returns can point into memory the caller owns. Storing a reference to
// a local through it would let the local's address outlive the function.

struct Holder {
  r : &i32,
}

fn slot(h : &mut Holder) -> &mut &i32 {
  return &mut h.r;
}

fn holder_of(h : &mut Holder) -> &mut Holder {
  return h;
}

fn through_a_returned_reference(h : &mut Holder, k : i32) -> i32 {
  let local : i32 = k + 4;
  // CHECK: Error[E4005] at {{.*}}local_stored_through_a_returned_reference.vx:[[@LINE+1]]:3: this stores a value that points into this function's stack frame where it can outlive the function
  *slot(h) = &local;
  return 0;
}

fn into_a_field_of_a_returned_reference(h : &mut Holder, k : i32) -> i32 {
  let local : i32 = k + 4;
  // CHECK: Error[E4005] at {{.*}}local_stored_through_a_returned_reference.vx:[[@LINE+1]]:16: this stores a value that points into this function's stack frame where it can outlive the function
  holder_of(h).r = &local;
  return 0;
}

fn main() -> i32 {
  return 0;
}
