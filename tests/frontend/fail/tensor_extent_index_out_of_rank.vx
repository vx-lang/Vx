//===----------------------------------------------------------------------===//
// Rank is static, so `extent(i)` is checked against it: `extent(2)` on a
// rank-2 tensor is refused at compile time rather than read past the
// descriptor at run time.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: extent(2)
// CHECK-SAME: rank 2

fn f(m : Tensor<f32, [?, 3]>) -> i32 {
  return m.extent(2);
}

fn main() -> i32 {
  return 0;
}
