//===----------------------------------------------------------------------===//
// Test that returning the wrong type produces a clear error.
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Type mismatch

fn should_return_i32() -> i32 {
  let x = Tensor<f32, [10]>::uninit();
  return x;
}
