// RUN: not vxc %s 2>&1 | FileCheck %s
//
// The struct passed to `set_through` holds `&mut outside`, and the call writes through it.
// The block cannot fold, because the write to `outside` would disappear with it.

struct Holder {
  value : &mut i32,
}

fn set_to_9(p : &mut i32) -> void {
  *p = 9i32;
}

fn set_through(h : Holder) -> void {
  set_to_9(h.value);
}

fn main() -> i32 {
  let mut outside : i32 = 0i32;
  // CHECK: Error[E3033]{{.*}}cannot be evaluated
  let value = comptime {
    set_through(Holder {
      value : &mut outside
    });
    7i32
  };
  return value + outside;
}
