// RUN: not vxc %s 2>&1 | FileCheck %s
//
// The compiler sizes a stack buffer when it compiles, so a `?` dimension is refused.

// CHECK: needs a shape the compiler knows
fn main() -> i32 {
  let t : Tensor<f32, [?], Storage::Stack> = Tensor<f32, [4]>::new();
  return 0;
}
