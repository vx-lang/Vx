// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
//
// After `y = 0 - 5`, the fact `y > 0` from the assert is no longer true, so nothing proves the
// `ensures` (E8001). The prover used to keep the fact, so this compiled, and `pos(3)` returned
// -5 although the `ensures` says the result is above 0.

fn pos(x : i32) -> i32
ensures return > 0 {
  let mut y = x;
  assert(y > 0, "y is positive");
  y = 0 - 5;
  // CHECK: Error[E8001] at [[@LINE+1]]:3: Function 'pos' cannot prove postcondition (ensures) at compile time
  return y;
}

fn main() -> i32 {
  print(pos(3));
  return 0;
}
