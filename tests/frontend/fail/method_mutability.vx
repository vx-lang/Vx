//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s
fn test_mutability(t : DynTensor<f32>) -> DynTensor<i32> {
  let imm_borrow = &t;
  let mut_ptr = imm_borrow.as_mut_ptr(); // ERROR: Cannot get mutable pointer
  // from immutable borrow
  return 0;
}
