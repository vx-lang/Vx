//===----------------------------------------------------------------------===//
// Tensors are linear types: using a Tensor value consumes it. A second use
// of the same variable must produce a "moved or consumed" error.
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s

fn main() -> i32 {
  let a : Tensor<f32, []> = 1.0;
  let b = a;
  let c = a;
  return 0;
}

// CHECK: Use of moved or consumed linear variable: a
