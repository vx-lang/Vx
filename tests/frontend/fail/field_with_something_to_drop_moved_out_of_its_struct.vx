// RUN: not vxc %s 2>&1 | FileCheck %s
//
// Moving a field out of a struct by value is refused (E4013) when the field has something to
// drop: the struct still owns the field and drops it, so it would be dropped twice. Each
// function moves such a field in a different way.

import core::ops;

struct Noisy {
  id : i32,
}

impl Drop for Noisy {
  fn drop(self : &mut Noisy) -> void {
    print(self.id);
  }
}

struct Pair {
  a : Noisy,
  b : Noisy,
}

struct Frame {
  pair : Pair,
}

struct Holder {
  t : Tensor<f32, [?]>,
}

struct Outer {
  h : Holder,
}

fn take(n : Noisy) -> i32 {
  return n.id;
}

fn make() -> Pair {
  return Pair {
    a : Noisy {
      id : 1
    },
    b : Noisy {
      id : 2
    }
  };
}

fn moved_by_let() -> i32 {
  let p = make();
  let x = p.a;
  return x.id;
}

fn moved_into_a_call() -> i32 {
  let p = make();
  return take(p.a);
}

fn moved_by_return() -> Noisy {
  let p = make();
  return p.a;
}

fn nested_field() -> i32 {
  let f = Frame {
    pair : make()
  };
  let x = f.pair.b;
  return x.id;
}

// A struct with a tensor field has something to drop too: the tensor's memory.
fn field_that_holds_a_tensor() -> i32 {
  let o = Outer {
    h : Holder {
      t : Tensor<f32>([4])
    }
  };
  let h = o.h;
  return 0;
}

// The call's result has no name and is dropped at the end of the statement.
fn field_of_a_call_result() -> i32 {
  let x = make().a;
  return x.id;
}

fn main() -> i32 {
  return 0;
}

// CHECK-DAG: Error[E4013] at {{.*}}field_with_something_to_drop_moved_out_of_its_struct.vx:60:13: `p.a` cannot be moved out of the struct that holds it
// CHECK-DAG: Error[E4013] at {{.*}}field_with_something_to_drop_moved_out_of_its_struct.vx:66:17: `p.a` cannot be moved out of the struct that holds it
// CHECK-DAG: Error[E4013] at {{.*}}field_with_something_to_drop_moved_out_of_its_struct.vx:71:12: `p.a` cannot be moved out of the struct that holds it
// CHECK-DAG: Error[E4013] at {{.*}}field_with_something_to_drop_moved_out_of_its_struct.vx:78:18: `f.pair.b` cannot be moved out of the struct that holds it
// CHECK-DAG: Error[E4013] at {{.*}}field_with_something_to_drop_moved_out_of_its_struct.vx:89:13: `o.h` cannot be moved out of the struct that holds it
// CHECK-DAG: Error[E4013] at {{.*}}field_with_something_to_drop_moved_out_of_its_struct.vx:95:18: this field cannot be moved out of the struct that holds it
// CHECK: 6 error(s) emitted
