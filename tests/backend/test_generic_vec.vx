// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import std::vec;

import std::io;
fn main() -> i32 {
  let mut v = Vec::new<i32>();
  v.push(10);
  v.push(20);
  v.push(30);

  let mut sum : i32 = 0;

  unsafe {
    print !("sizeof i32 is: ");
    print !(sizeof<i32>());
  }

  for x in v.iter() {
    unsafe {
      print !("x is: ");
      print !(x);
    }
    sum = sum + x;
  }

  unsafe {
    print !("Sum is: ");
    print !(sum);
  }
  return sum;
}
