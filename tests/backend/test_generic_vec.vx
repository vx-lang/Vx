import std::vec;



import std::io;
fn main() -> i32 {
  let mut v = Vec::new<i32>();
  v.push(10);
  v.push(20);
  v.push(30);

  let mut sum: i32 = 0;

  unsafe {
    print_str("sizeof i32 is: ");
    print_i32(sizeof<i32>());
  }

  for x in v.iter() {
    unsafe {
      print_str("x is: ");
      print_i32(x);
    }
    sum = sum + x;
  }

  unsafe {
    print_str("Sum is: ");
    print_i32(sum);
  }
  return sum;
}
