// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import tests::modules::iter;

import std::io;
struct MyList {
  len : i32,
}

struct MyListIter {
  len : i32, current : i32,
}

impl MyList {
  fn iter(self : MyList) -> MyListIter {
    return MyListIter{
      len : self.len, current : 0
    };
  }
}

impl Iterator<MyListIter, i32> for MyListIter {
  fn next(self : MyListIter) -> Option<i32> {
    if self
    .current < self.len {
      let val : i32 = self.current * 2;
      self.current = self.current + 1;
      return Option::Some(i32)(val);
    }
    return Option::None(i32)();
  }
}

fn main() -> i32 {
  let list : MyList = MyList{
    len : 5
  };
  for item in list.iter() {
    print!("Custom Struct Item: ");
    print!(item);
  }
  return 0;
}
