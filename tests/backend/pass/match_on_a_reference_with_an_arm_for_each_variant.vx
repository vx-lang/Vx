//===----------------------------------------------------------------------===//
// A `match` on a reference to an enum needs no `_` arm when it has an arm for each variant.
// `size` uses the `match` as a value, and `area` returns from each arm.
//
// EXPECT: 3, 4, 0, 9, 16, 0

enum Shape {
  Circle(i32),
  Square(i32),
  Point,
}

fn size(s : &Shape) -> i32 {
  let r : i32 = match s {
    Shape::Circle(r) => {
      r
    }
    Shape::Square(w) => {
      w
    }
    Shape::Point => {
      0
    }
  };
  return r;
}

fn area(s : &Shape) -> i32 {
  match s {
    Shape::Circle(r) => {
      return r * r;
    }
    Shape::Square(w) => {
      return w * w;
    }
    Shape::Point => {
      return 0;
    }
  }
}

fn main() -> i32 {
  let c = Shape::Circle(3);
  let q = Shape::Square(4);
  let p = Shape::Point;
  print(size(&c));
  print!(", ");
  print(size(&q));
  print!(", ");
  print(size(&p));
  print!(", ");
  print(area(&c));
  print!(", ");
  print(area(&q));
  print!(", ");
  print(area(&p));
  return 0;
}
