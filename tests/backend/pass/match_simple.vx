// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @test_match(%arg0: i32) -> i32
// CHECK: %[[C0:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C1:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C1]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C2:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C2]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @test_match(%{{.*}}) : (i32) -> i32
enum Color {
  Red,
  Green,
  Blue,
}

fn test_match(c: Color) -> i32 {
  let mut res = 0;
  match c {
    Color::Red => {
      res = 10;
    }
    Color::Green => {
      res = 20;
    }
    Color::Blue => {
      res = 30;
    }
    _ => {
      res = 40;
    }
  }
  return res;
}

fn main() -> i32 {
  let c = Color::Green;
  let val = test_match(c);
  return val - 20;
}
