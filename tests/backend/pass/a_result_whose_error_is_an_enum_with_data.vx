//===----------------------------------------------------------------------===//
// The error of a `Result` is an enum whose variant `Code` carries a number, as `NetError::Os`
// does. A `match` on the `Err` reads the error, and a `match` on the error reads the number.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}ok 5{{$}}
// CHECK-NEXT: {{^}}code 7{{$}}
// CHECK-NEXT: {{^}}empty{{$}}

import core::result;

enum Failure {
  Code(i32),
  Empty,
}

fn attempt(n : i32) -> Result<u64, Failure> {
  if n > 0 {
    return Result<u64, Failure>::Err(Failure::Code(n));
  }
  if n < 0 {
    return Result<u64, Failure>::Err(Failure::Empty);
  }
  return Result<u64, Failure>::Ok(5);
}

fn show_failure(f : Failure) -> void {
  match f {
    Failure::Code(n) => {
      println!("code {}", n);
    }
    Failure::Empty => {
      println!("empty");
    }
  }
}

fn show(r : Result<u64, Failure>) -> void {
  match r {
    Result<u64, Failure>::Ok(v) => {
      println!("ok {}", v);
    }
    Result<u64, Failure>::Err(f) => {
      show_failure(f);
    }
  }
}

fn main() -> i32 {
  show(attempt(0));
  show(attempt(7));
  show(attempt(-1));
  return 0;
}
