import std::io;

fn main() -> i32 {
  // A constructed missing-file error keeps its kind and example native code.
  let missing = Error::from_native_error(ErrorKind::NotFound(), Operation::Open(), 2);
  match missing.kind() {
    ErrorKind::NotFound() => {
      print!("missing ");
    }
    _ => {
      print!("wrong kind ");
    }
  }
  match missing.operation() {
    Operation::Open() => {
      print!("open ");
    }
    _ => {
      print!("wrong operation ");
    }
  }
  print(missing.raw_os_error().unwrap_or(-1));
  print!(" ");
  print(missing.message());
  print!(" ");

  // A constructed error with no portable kind still keeps its native code.
  let unknown = Error::from_native_error(ErrorKind::Other(), Operation::Read(), 12345);
  match unknown.kind() {
    ErrorKind::Other() => {
      print!("other ");
    }
    _ => {
      print!("wrong kind ");
    }
  }
  print(unknown.raw_os_error().unwrap_or(-1));
  print!(" ");
  print(unknown.message());
  print!(" ");

  // Errors made by Vx have no native OS code.
  let invalid = Error::new(ErrorKind::InvalidInput(), Operation::Seek());
  match invalid.kind() {
    ErrorKind::InvalidInput() => {
      print!("invalid ");
    }
    _ => {
      print!("wrong kind ");
    }
  }
  match invalid.raw_os_error() {
    Option<i32>::None() => {
      print!("no code");
    }
    Option<i32>::Some(_) => {
      print!("wrong code");
    }
  }
  print!(" ");
  print(invalid.message());
  return 0;
}
// EXPECT: missing open 2 file or resource not found other 12345 other I/O error invalid no code invalid input
