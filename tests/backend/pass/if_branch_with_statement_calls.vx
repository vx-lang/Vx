//===----------------------------------------------------------------------===//
// A call that returns a value, written as a statement with `;`, does not give an
// `if` branch that value, so the other branch need not have one.
//
//   42  the call is the last statement of the branch
//   4   the call is in the middle, in the `loop { if .. else { break } }` shape
//   44  an `if` with a value in the middle of a branch, not at its end
import std::vec;

fn bump(x : &mut i32) -> i32 {
  *x = *x + 1;
  return *x;
}

fn main() -> i32 {
  let mut i = 41;
  if i > 0 {
    bump(&mut i);
  } else {
    i = 0;
  }
  print(i);
  print!(" ");

  let mut v = Vec<i32>::new();
  loop {
    if v.len() < 4 {
      v.push(10);
      i = i + 1;
    } else {
      break;
    }
  }
  print(v.len());
  print!(" ");

  if i > 0 {
    if i > 1 {
      bump(&mut i)
    } else {
      0
    }
    let z = 1;
    i = i + z;
  } else {
    i = 0;
  }
  print(i - 4);
  return 0;
}

// EXPECT: 42 4 44
