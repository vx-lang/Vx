//
//===----------------------------------------------------------------------===//
// A `nvptx64` region that yields a value gets no device image, and the
// compiler says nothing about it. The host stack slot is news to a `spirv64`
// program, where the author expects an image and gets a local run. NVPTX never
// imaged this shape, so it has nothing to report, and one pipeline's warning
// must not arrive for the other pipeline's kernels.
//
// device_image_test.rs is what asserts the silence, next to the `spirv64`
// program that does say it.
//
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s
// The warning would come before the IR, so the payload's global is the anchor
// after it: nothing about a host stack slot may appear on the way there.
// CHECK-NOT: host stack slot
// CHECK: @vx_npu_kernel_0_str
// EXPECT: 6

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: nvptx64,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 63 GB/s
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<i32, [2, 2]>::uninit() };
  for i in 0..2 {
    for j in 0..2 {
      a[i][j] = i * 3 + j + 1;
    }
  }
  let ad = transfer(a, Memory::GPU_HBM);
  let v = spawn on(Topology::Dev) {
    ad[0][0] + ad[1][1]
  };
  let hv = transfer(v, Memory::CPU_DRAM);
  print(hv);
  return 0;
}
