// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --action run-jit 2>&1 | FileCheck %s

import std::io;
struct Config {
  dim : i32,
  hidden_dim : i32,
  n_layers : i32,
  n_heads : i32,
  vocab_size : i32,
  seq_len : i32,
  norm_eps : f32,
}

fn main() -> i32 {
  let conf = Config {
    dim : 288,
    hidden_dim : 768,
    n_layers : 6,
    n_heads : 6,
    vocab_size : 32000,
    seq_len : 256,
    norm_eps : 0.00001,
  };

  print!(conf.norm_eps);
  return 0;
}

// The f32 field survives the struct round trip.
// CHECK: 0.00001

// The struct is built field by field in one stack slot. The f32 field read back out is the one
// that reaches print. This is the round trip that the printed number measures.
// MLIR-LABEL: func.func @main() -> i32 {
// MLIR: %[[CONF:[0-9]+]] = llvm.alloca %{{.*}} x !llvm.struct<(i32, i32, i32, i32, i32, i32, f32)>
// MLIR: %[[EPS:.*]] = arith.constant 9.99999974E-6 : f32
// MLIR: %[[SLOT:[0-9]+]] = llvm.getelementptr %[[CONF]][0, 6] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32, i32, i32, i32, i32, f32)>
// MLIR: llvm.store %[[EPS]], %[[SLOT]] : f32, !llvm.ptr
// MLIR: %[[READ:[0-9]+]] = llvm.getelementptr %[[CONF]][0, 6] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(i32, i32, i32, i32, i32, i32, f32)>
// MLIR: %[[OUT:[0-9]+]] = llvm.load %[[READ]] : !llvm.ptr -> f32
// MLIR: call @print_f32(%[[OUT]])
