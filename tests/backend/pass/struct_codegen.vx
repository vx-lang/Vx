// RUN: vxc %s --action run-jit 2>&1 | FileCheck %s

import std::io;
struct Config {
  dim : i32,
  hidden_dim : i32,
  n_layers : i32,
  n_heads : i32,
  vocab_size : i32,
  seq_len : i32,
  norm_eps : f32,
}

fn main() -> i32 {
  let conf = Config {
    dim : 288,
    hidden_dim : 768,
    n_layers : 6,
    n_heads : 6,
    vocab_size : 32000,
    seq_len : 256,
    norm_eps : 0.00001,
  };

  print!(conf.norm_eps);
  return 0;
}

// The f32 field survives the struct round trip.
// CHECK: 0.00001
