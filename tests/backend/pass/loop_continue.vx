// Reproducer for `continue` inside a counted `for` loop. Prior to the fix the
// continue branch jumped to the condition block without supplying the required
// loop-index block argument (invalid IR) and skipped the loop increment.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32

fn main() -> i32 {
  // Sum only the values >= 5 in 0..10 by `continue`-ing on the smaller ones.
  // 5 + 6 + 7 + 8 + 9 = 35
  let mut sum : i32 = 0;
  for i in 0..10 {
    if i < 5 {
      continue;
    }
    sum += i;
  }
  print!("sum=");
  print!(sum);
  return 0;
}

// EXPECT: sum=35
