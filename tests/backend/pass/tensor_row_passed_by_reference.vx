//===----------------------------------------------------------------------===//
// A row of a tensor, `q[i]`, handed on as a whole: to a `&Tensor<f32, [?]>` parameter, as the
// `self` of a `std::tensor` method, and to a `&mut` parameter. Row 0 holds 1s and row 1 holds
// 100 to 103, so a function that wrongly reads row 0 prints 1s, and a wrong write changes row 0.
//
// The rows are picked by a parameter, so the compiler cannot see which row it is, and once by
// the constant 1.
//
// EXPECT: 406 406 406 614 5 1
import std::tensor;

fn total(r : &Tensor<f32, [?]>) -> f32 {
  let mut s : f32 = 0.0;
  for j in 0..r.len() {
    s = s + r[j];
  }
  return s;
}

fn total_of_row(q : &Tensor<f32, [2, 4]>, i : i32) -> f32 {
  return total(&q[i]);
}

fn dot_of_rows(q : &Tensor<f32, [2, 4]>, k : &Tensor<f32, [2, 4]>, i : i32) -> f32 {
  return q[i].dot(&k[i]);
}

fn set_first(r : &mut Tensor<f32, [?]>) -> i32 {
  r[0] = 5.0;
  return 0;
}

fn set_first_of_row(q : &mut Tensor<f32, [2, 4]>, i : i32) -> i32 {
  return set_first(&mut q[i]);
}

fn main() -> i32 {
  let mut q = Tensor<f32>([2, 4]);
  let mut k = Tensor<f32>([2, 4]);
  for j in 0..4 {
    q[0][j] = 1.0;
    q[1][j] = 100.0 + (j as f32);
    k[0][j] = 1.0;
    k[1][j] = j as f32;
  }
  print(total_of_row(&q, 1));
  print!(" ");
  print(total(&q[1]));
  print!(" ");
  print(q[1].sum());
  print!(" ");
  print(dot_of_rows(&q, &k, 1));
  print!(" ");
  set_first_of_row(&mut q, 1);
  print(q[1][0]);
  print!(" ");
  print(q[0][0]);
  return 0;
}
