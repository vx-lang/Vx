//===----------------------------------------------------------------------===//
// `-x as T` is `(-x) as T`. With x = -128i8, the negation wraps in i8 and the
// cast then yields -128. The old parse `-(x as T)` printed 128.
//
// EXPECT: -128
fn main() -> i32 {
  let x : i8 = -128i8;
  let y : i32 = -x as i32;
  println!(y);
  return 0;
}
