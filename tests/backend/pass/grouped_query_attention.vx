// Grouped-Query Attention (Ainslie et al. 2023): the interpolation between full
// multi-head (each query head has its own K/V) and multi-query (all share one).
// Query heads are partitioned into groups; each group shares one K/V head. Here
// H=4 query heads (d_head=2) in 2 groups of 2, so 2 K/V heads.
//
// The two groups get *different* keys, so the grouping is observable:
//   V row0=0, V row1=2 (both groups).  Group 0 key1 = 1; group 1 key1 = 2.
//   Q0 head0 = [1,1] over group 0 -> scores [0,1] -> ~0.731*2 = 1.46212.
//   Q0 head2 = [1,1] over group 1 -> scores [0,2] -> ~0.881*2 = 1.76159.
//   Q0 heads 1,3 = [0,0] -> uniform -> 1.0.  Q1 = 0 -> all 1.0.
//   O0 = [1.46212, 1.46212, 1, 1, 1.76159, 1.76159, 1, 1];  O1 = all 1.0.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: func.func @main

import std::math;

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 8]>::uninit();
  let mut k = Tensor<f32, [2, 4]>::uninit();
  let mut v = Tensor<f32, [2, 4]>::uninit();
  let mut o = Tensor<f32, [2, 8]>::uninit();

  for c in 0..4 {
    k[0][c] = 0.0;
    v[0][c] = 0.0;
    v[1][c] = 2.0;
  }
  // group 0 (cols 0,1) key1 = 1; group 1 (cols 2,3) key1 = 2
  k[1][0] = 1.0;
  k[1][1] = 1.0;
  k[1][2] = 2.0;
  k[1][3] = 2.0;

  // Q0: head0 = [1,1] (group 0), head2 = [1,1] (group 1), heads 1 & 3 = [0,0]; Q1 = 0.
  for c in 0..8 {
    q[0][c] = 0.0;
    q[1][c] = 0.0;
  }
  q[0][0] = 1.0;
  q[0][1] = 1.0;
  q[0][4] = 1.0;
  q[0][5] = 1.0;

  let scale : f32 = 0.5;

  for h in 0..4 {
    let qbase : i32 = h * 2; // query head h -> Q cols [qbase, qbase+2)
    let kbase : i32 = (h / 2) * 2; // group h/2 -> K/V cols [kbase, kbase+2)
    for i in 0..2 {
      let mut s0 : f32 = 0.0;
      let mut s1 : f32 = 0.0;
      for c in 0..2 {
        s0 += q[i][qbase + c] * k[0][kbase + c];
        s1 += q[i][qbase + c] * k[1][kbase + c];
      }
      s0 = s0 * scale;
      s1 = s1 * scale;
      let mut mx : f32 = s0;
      if s1 > mx {
        mx = s1;
      }
      let e0 : f32 = (s0 - mx).exp();
      let e1 : f32 = (s1 - mx).exp();
      let sum : f32 = e0 + e1;
      let w0 : f32 = e0 / sum;
      let w1 : f32 = e1 / sum;
      for c in 0..2 {
        o[i][qbase + c] = w0 * v[0][kbase + c] + w1 * v[1][kbase + c];
      }
    }
  }

  print(o);
  return 0;
}

// EXPECT: [[1.46212,   1.46212,   1,   1,   1.76159,   1.76159,   1,   1],
// EXPECT: [1,   1,   1,   1,   1,   1,   1,   1]]
