//===----------------------------------------------------------------------===//
// A struct with a field whose type is an enum with no data in its variants: returned from a
// function, passed to one, inside another struct, and with the field read and assigned. The
// flat code generator used to refuse such a struct, so the whole program went to the AST path.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --check-prefix=VALUES
// CHECK-NOT: flat-codegen

enum Side {
  Left,
  Right,
}

struct Pad {
  side : Side,
  width : i64,
}

struct Frame {
  pad : Pad,
  depth : i32,
}

fn make_pad() -> Pad {
  return Pad {
    side: Side::Right(), width: 3i64
  };
}

fn side_name(s : Side) -> i32 {
  match s {
    Side::Left() => {
      return 1;
    }
    Side::Right() => {
      return 2;
    }
  }
}

fn width_of(p : Pad) -> i64 {
  return p.width;
}

fn main() -> i32 {
  let mut p = make_pad();
  print!("returned: ");
  print(side_name(p.side));
  print!(" ");
  print(width_of(make_pad()));
  print!("
");
  // CHECK: {{^}}returned: 2 3{{$}}
  // VALUES: {{^}}returned: 2 3{{$}}

  p.side = Side::Left();
  print!("assigned: ");
  print(side_name(p.side));
  print!(" ");
  print(p.width);
  print!("
");
  // CHECK-NEXT: {{^}}assigned: 1 3{{$}}
  // VALUES-NEXT: {{^}}assigned: 1 3{{$}}

  let f = Frame {
    pad: make_pad(), depth: 7
  };
  print!("inside another struct: ");
  print(side_name(f.pad.side));
  print!(" ");
  print(f.depth);
  print!("
");
  // CHECK-NEXT: {{^}}inside another struct: 2 7{{$}}
  // VALUES-NEXT: {{^}}inside another struct: 2 7{{$}}
  return 0;
}
