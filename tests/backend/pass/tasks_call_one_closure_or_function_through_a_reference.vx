//===----------------------------------------------------------------------===//
// Three tasks share one closure, or one function, through `f : &F`. Each task takes the next
// job from a counter and adds `f` of the job to a total.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=declined
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}function 110{{$}}
// CHECK-NEXT: {{^}}closure 5500{{$}}

import core::marker;
import core::sync::atomic;
import std::vec;

fn worker<J, F : Sync>(jobs : &Vec<J>, next : &AtomicI64, total : &AtomicI64, f : &F) -> void {
  while true {
    let i = next.fetch_add(1, AtomicOrdering::Relaxed);
    if i >= i64::from(jobs.len()) {
      return;
    }
    let v : i64 = f(jobs.get_ref(i as i32));
    total.fetch_add(v, AtomicOrdering::Relaxed);
  }
}

fn run_all<J : Sync, F : Sync>(jobs : &Vec<J>, n : i64, f : F) -> i64 {
  let next = AtomicI64::new(0);
  let total = AtomicI64::new(0);
  tasks {
    let mut w : i64 = 0;
    while w < n {
      spawn {
        worker(jobs, &next, &total, &f)
      };
      w = w + 1;
    }
  };
  return total.load(AtomicOrdering::Relaxed);
}

fn double(j : &i64) -> i64 {
  return *j * 2;
}

fn main() -> i32 {
  let mut jobs = Vec<i64>::new();
  let mut i : i64 = 1;
  while i <= 10 {
    jobs.push(i);
    i = i + 1;
  }
  println!("function {}", run_all(&jobs, 3, double));
  let k : i64 = 100;
  println!("closure {}", run_all(&jobs, 3, |j : &i64| -> i64 {
    return *j * k;
  }));
  return 0;
}
