//===- npu_vector_transfer.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM

fn test_f32() -> i32 {
  let mut a = Tensor<f32>([4]);
  a[0] = 1.0; a[1] = 2.0; a[2] = 3.0; a[3] = 4.0;
  let a_npu = transfer(a, Memory::NPU_HBM);
  let a_host = transfer(a_npu, Memory::Host_DRAM);
  assert(a_host[0] == a[0], "f32 index 0 match");
  assert(a_host[1] == a[1], "f32 index 1 match");
  assert(a_host[2] == a[2], "f32 index 2 match");
  assert(a_host[3] == a[3], "f32 index 3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = Tensor<bf16>([4]);
  a[0] = 1.0; a[1] = 2.0; a[2] = 3.0; a[3] = 4.0;
  let a_npu = transfer(a, Memory::NPU_HBM);
  let a_host = transfer(a_npu, Memory::Host_DRAM);
  assert(a_host[0] == a[0], "bf16 index 0 match");
  assert(a_host[1] == a[1], "bf16 index 1 match");
  assert(a_host[2] == a[2], "bf16 index 2 match");
  assert(a_host[3] == a[3], "bf16 index 3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// NO_EXEC

