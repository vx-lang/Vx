//===- npu_vector_transfer.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=LLVM
// FileCheck %s

fn test_f32() -> i32 {
  let mut a = unsafe { Tensor<f32, [4]>::uninit() };
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  a[3] = 4.0;
  let a_npu = transfer(a, Memory::NPU_HBM);
  let a_host = transfer(a_npu, Memory::CPU_DRAM);
  assert(a_host[0] == a[0], "f32 index 0 match");
  assert(a_host[1] == a[1], "f32 index 1 match");
  assert(a_host[2] == a[2], "f32 index 2 match");
  assert(a_host[3] == a[3], "f32 index 3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = unsafe { Tensor<bf16, [4]>::uninit() };
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  a[3] = 4.0;
  let a_npu = transfer(a, Memory::NPU_HBM);
  let a_host = transfer(a_npu, Memory::CPU_DRAM);
  assert(a_host[0] == a[0], "bf16 index 0 match");
  assert(a_host[1] == a[1], "bf16 index 1 match");
  assert(a_host[2] == a[2], "bf16 index 2 match");
  assert(a_host[3] == a[3], "bf16 index 3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// NO_EXEC

// The extent is a constant, so the buffer is allocated with a static shape. The first
// transfer moves that buffer to NPU memory.
// CHECK-LABEL: func.func @test_f32() -> i32
// CHECK: %[[A:.*]] = memref.alloc() : memref<4xf32>
// CHECK: "vx.transfer"(%[[A]]) {{.*}}{space = "NPU_HBM"} : (memref<4xf32>) -> memref<4xf32>
// CHECK-LABEL: func.func @test_bf16() -> i32
// CHECK: memref.alloc() : memref<4xbf16>

// convert-vx-to-standard keeps the same allocation.
// STD-LABEL: func.func @test_f32() -> i32
// STD: memref.alloc() : memref<4xf32>

// --emit-llvm stops at the LLVM dialect, where the same function is an llvm.func. The buffer
// goes to the device runtime, so it is a heap allocation, and the runtime copies it to the NPU.
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_f32() -> i32
// LLVM: %[[BUF:.*]] = llvm.call @malloc
// LLVM: llvm.call @vx_plugin_alloc_and_transfer(%{{.*}}, %[[BUF]],
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_bf16() -> i32
