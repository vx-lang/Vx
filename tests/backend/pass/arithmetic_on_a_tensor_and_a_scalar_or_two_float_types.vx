//===----------------------------------------------------------------------===//
// Arithmetic on a rank-1 tensor and a scalar, on either side, and on two tensors of different
// float types. One float type stays. Two float types compute in f32, so 2048 + 1 is 2049 only
// when an f32 operand takes part: f16 cannot hold 2049.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}f32 tensor + f32: 2049 9{{$}}
// CHECK: {{^}}f32 - f32 tensor: -2, f32 / f32 tensor: 0.5{{$}}
// CHECK: {{^}}f16 tensor + f32: 2049{{$}}
// CHECK: {{^}}f16 tensor + f16: 2048{{$}}
// CHECK: {{^}}f16 tensor + f32 tensor: 2049{{$}}
// CHECK: {{^}}f32 tensor + f16 tensor: 2048.25{{$}}
// CHECK: {{^}}bf16 tensor * f32 tensor: 1.5{{$}}
// CHECK: {{^}}f16 tensor of run-time size - f32 tensor: 4.5{{$}}

fn tensor_and_scalar() -> i32 {
  let mut a = Tensor<f32, [2]>::new();
  a[0] = 2048.0;
  a[1] = 8.0;
  let one : f32 = 1.0;
  let sum : Tensor<f32, [2]> = a + one;
  println!("f32 tensor + f32: {} {}", sum[0], sum[1]);
  return 0;
}

fn scalar_on_the_left() -> i32 {
  let mut d = Tensor<f32>([ 2 ]);
  let mut q = Tensor<f32>([ 2 ]);
  d[1] = 4.0;
  q[1] = 4.0;
  let two : f32 = 2.0;
  let difference = two - d;
  let quotient = two / q;
  println!("f32 - f32 tensor: {}, f32 / f32 tensor: {}", difference[1], quotient[1]);
  return 0;
}

fn half_tensor_and_scalar() -> i32 {
  let mut h = Tensor<f16, [2]>::new();
  h[0] = 2048.0;
  let one : f32 = 1.0;
  let wide = h + one;
  println!("f16 tensor + f32: {}", wide[0]);
  let mut g = Tensor<f16, [2]>::new();
  g[0] = 2048.0;
  let one_half : f16 = 1.0;
  let narrow = g + one_half;
  println!("f16 tensor + f16: {}", narrow[0] as f32);
  return 0;
}

fn two_float_types() -> i32 {
  let mut x = Tensor<f16, [2]>::new();
  let mut y = Tensor<f32, [2]>::new();
  x[0] = 2048.0;
  y[0] = 1.0;
  let z : Tensor<f32, [2]> = x + y;
  println!("f16 tensor + f32 tensor: {}", z[0]);
  let mut u = Tensor<f32, [2]>::new();
  let mut v = Tensor<f16, [2]>::new();
  u[1] = 0.25;
  v[1] = 2048.0;
  let w = u + v;
  println!("f32 tensor + f16 tensor: {}", w[1]);
  let mut m = Tensor<bf16, [2]>::new();
  let mut n = Tensor<f32, [2]>::new();
  m[1] = 3.0;
  n[1] = 0.5;
  let p = m * n;
  println!("bf16 tensor * f32 tensor: {}", p[1]);
  let mut r = Tensor<f16>([ 2 ]);
  let mut s = Tensor<f32, [2]>::new();
  r[0] = 6.0;
  s[0] = 1.5;
  let t = r - s;
  println!("f16 tensor of run-time size - f32 tensor: {}", t[0]);
  return 0;
}

fn main() -> i32 {
  tensor_and_scalar();
  scalar_on_the_left();
  half_tensor_and_scalar();
  two_float_types();
  return 0;
}
