import tests::modules::llama_rt;

struct Config {
  dim: i32,
  hidden_dim: i32,
  n_layers: i32,
  n_heads: i32,
  n_kv_heads: i32,
  vocab_size: i32,
  seq_len: i32
}

struct TransformerWeights {
  token_embedding_table: *mut f32,
  rms_att_weight: *mut f32,
  rms_ffn_weight: *mut f32,
  wq: *mut f32,
  wk: *mut f32,
  wv: *mut f32,
  wo: *mut f32,
  w1: *mut f32,
  w2: *mut f32,
  w3: *mut f32,
  rms_final_weight: *mut f32,
  wcls: *mut f32
}

struct RunState {
  x: *mut f32,
  xb: *mut f32,
  xb2: *mut f32,
  hb: *mut f32,
  hb2: *mut f32,
  q: *mut f32,
  k: *mut f32,
  v: *mut f32,
  att: *mut f32,
  logits: *mut f32,
  key_cache: *mut f32,
  value_cache: *mut f32
}

fn malloc_run_state(dim: i32, hidden_dim: i32, n_layers: i32, n_heads: i32, n_kv_heads: i32, seq_len: i32, vocab_size: i32) -> RunState {
  let div_kv: i32 = dim * n_kv_heads;
  let kv_dim: i32 = div_kv / n_heads;

  let state = unsafe {
    RunState {
      x: vx_malloc_f32(dim),
      xb: vx_malloc_f32(dim),
      xb2: vx_malloc_f32(dim),
      hb: vx_malloc_f32(hidden_dim),
      hb2: vx_malloc_f32(hidden_dim),
      q: vx_malloc_f32(dim),
      k: vx_malloc_f32(dim),
      v: vx_malloc_f32(dim),
      att: vx_malloc_f32(n_heads * seq_len),
      logits: vx_malloc_f32(vocab_size),
      key_cache: vx_malloc_f32(n_layers * seq_len * kv_dim),
      value_cache: vx_malloc_f32(n_layers * seq_len * kv_dim)
    }
  };
  return state;
}

fn memory_map_weights(ptr: *mut f32, dim: i32, hidden_dim: i32, n_layers: i32, n_heads: i32, n_kv_heads: i32, seq_len: i32, vocab_size: i32) -> TransformerWeights {
  let head_size: i32 = dim / n_heads;

  let w = unsafe {
    let p0: *mut f32 = ptr;
    let p1: *mut f32 = vx_advance_ptr(p0, vocab_size * dim);
    let p2: *mut f32 = vx_advance_ptr(p1, n_layers * dim);
    let p3_offset: i32 = n_layers * dim * n_heads * head_size;
    let p3: *mut f32 = vx_advance_ptr(p2, p3_offset);
    let p4_offset: i32 = n_layers * dim * n_kv_heads * head_size;
    let p4: *mut f32 = vx_advance_ptr(p3, p4_offset);
    let p5_offset: i32 = n_layers * dim * n_kv_heads * head_size;
    let p5: *mut f32 = vx_advance_ptr(p4, p5_offset);
    let p6_offset: i32 = n_layers * n_heads * head_size * dim;
    let p6: *mut f32 = vx_advance_ptr(p5, p6_offset);
    let p7: *mut f32 = vx_advance_ptr(p6, n_layers * dim);
    let p8: *mut f32 = vx_advance_ptr(p7, n_layers * dim * hidden_dim);
    let p9: *mut f32 = vx_advance_ptr(p8, n_layers * hidden_dim * dim);
    let p10: *mut f32 = vx_advance_ptr(p9, n_layers * dim * hidden_dim);
    let p11: *mut f32 = vx_advance_ptr(p10, dim);
    let p12: *mut f32 = vx_advance_ptr(p11, seq_len * head_size);
    let wcls_ptr: *mut f32 = p0;

    TransformerWeights {
      token_embedding_table: p0,
      rms_att_weight: p1,
      wq: p2,
      wk: p3,
      wv: p4,
      wo: p5,
      rms_ffn_weight: p6,
      w1: p7,
      w2: p8,
      w3: p9,
      rms_final_weight: p10,
      wcls: wcls_ptr
    }
  };
  return w;
}

fn ptr_to_tensor_1d(ptr: *mut f32, d1: i32) -> Tensor<f32> {
  let mut t: Tensor<f32> = Tensor([1, d1]);
  for i in 0..d1 {
    unsafe { t[0][i] = ptr[i]; }
  }
  return t;
}

fn ptr_to_tensor_2d(ptr: *mut f32, d1: i32, d2: i32) -> Tensor<f32> {
  let mut t: Tensor<f32> = Tensor([d1, d2]);
  for i in 0..d1 {
    for j in 0..d2 {
      let idx: i32 = i * d2 + j;
      unsafe { t[i][j] = ptr[idx]; }
    }
  }
  return t;
}

fn tensor_to_ptr_1d(t: Tensor<f32>, ptr: *mut f32, d1: i32) -> i32 {
  for i in 0..d1 {
    unsafe { ptr[i] = t[0][i]; }
  }
  return 0;
}

fn safe_sqrtf(x: f32) -> f32 { return unsafe { vx_sqrtf(x) }; }
fn safe_cosf(x: f32) -> f32 { return unsafe { vx_cosf(x) }; }
fn safe_sinf(x: f32) -> f32 { return unsafe { vx_sinf(x) }; }
fn safe_expf(x: f32) -> f32 { return unsafe { vx_expf(x) }; }
fn safe_get_rope_freq(pos: i32, i: i32, head_size: i32) -> f32 { return unsafe { vx_get_rope_freq(pos, i, head_size) }; }

fn rmsnorm(o: *mut f32, x: *mut f32, weight: *mut f32, size: i32) -> i32 {
  let mut ss: f32 = 0.0;
  for j in 0..size {
    unsafe {
      let val: f32 = x[j];
      ss = ss + (val * val);
    }
  }
  let div: f32 = ss / size;
  let add: f32 = div + 0.00001;
  ss = 1.0 / safe_sqrtf(add);
  for j in 0..size {
    unsafe {
      let weight_val: f32 = weight[j];
      let x_val: f32 = x[j];
      o[j] = weight_val * (ss * x_val);
    }
  }
  return 0;
}

fn transformer(token: i32, pos: i32, p: &Config, s: &RunState, w: &TransformerWeights) -> *mut f32 {
  unsafe {
    let x: *mut f32 = s.x;
    let dim: i32 = p.dim;
    let kv_mul_div: i32 = p.dim * p.n_kv_heads;
    let kv_dim: i32 = kv_mul_div / p.n_heads;
    let kv_mul: i32 = p.n_heads / p.n_kv_heads;
    let hidden_dim: i32 = p.hidden_dim;
    let head_size: i32 = dim / p.n_heads;

    let content_row: *mut f32 = vx_advance_ptr(w.token_embedding_table, token * dim);
    for i in 0..dim {
      x[i] = content_row[i];
    }

    for l in 0..p.n_layers {
      let rms_w: *mut f32 = vx_advance_ptr(w.rms_att_weight, l * dim);
      rmsnorm(s.xb, x, rms_w, dim);

      let wq_l: *mut f32 = vx_advance_ptr(w.wq, l * dim * dim);
      let wk_l: *mut f32 = vx_advance_ptr(w.wk, l * dim * kv_dim);
      let wv_l: *mut f32 = vx_advance_ptr(w.wv, l * dim * kv_dim);

      // Cast to tensors
      let t_wq: Tensor<f32> = ptr_to_tensor_2d(wq_l, dim, dim);
      let t_wk: Tensor<f32> = ptr_to_tensor_2d(wk_l, dim, kv_dim);
      let t_wv: Tensor<f32> = ptr_to_tensor_2d(wv_l, dim, kv_dim);

      // Perform matmul using @ operator
      let t_q: Tensor<f32> = ptr_to_tensor_1d(s.xb, dim) @ t_wq;
      let t_k: Tensor<f32> = ptr_to_tensor_1d(s.xb, dim) @ t_wk;
      let t_v: Tensor<f32> = ptr_to_tensor_1d(s.xb, dim) @ t_wv;

      tensor_to_ptr_1d(t_q, s.q, dim);
      tensor_to_ptr_1d(t_k, s.k, kv_dim);
      tensor_to_ptr_1d(t_v, s.v, kv_dim);

      for i in 0..dim {
        let div: i32 = i / 2;
        let mul: i32 = div * 2;
        let rem: i32 = i - mul;
        if rem == 0 {
          let head_dim_div: i32 = i / head_size;
          let head_dim_mul: i32 = head_dim_div * head_size;
          let head_dim: i32 = i - head_dim_mul;
          let freq: f32 = safe_get_rope_freq(pos, head_dim, head_size);
          let fcr: f32 = safe_cosf(freq);
          let fci: f32 = safe_sinf(freq);

          let rotn_q_r: i32 = i;
          let rotn_q_i: i32 = i + 1;
          let q0: f32 = s.q[rotn_q_r];
          let q1: f32 = s.q[rotn_q_i];
          s.q[rotn_q_r] = q0 * fcr - q1 * fci;
          s.q[rotn_q_i] = q0 * fci + q1 * fcr;

          if i < kv_dim {
            let rotn_k_r: i32 = i;
            let rotn_k_i: i32 = i + 1;
            let k0: f32 = s.k[rotn_k_r];
            let k1: f32 = s.k[rotn_k_i];
            s.k[rotn_k_r] = k0 * fcr - k1 * fci;
            s.k[rotn_k_i] = k0 * fci + k1 * fcr;
          }
        }
      }

      let loff: i32 = l * p.seq_len * kv_dim;
      let key_cache_row: *mut f32 = vx_advance_ptr(s.key_cache, loff + pos * kv_dim);
      let value_cache_row: *mut f32 = vx_advance_ptr(s.value_cache, loff + pos * kv_dim);
      for i in 0..kv_dim {
        key_cache_row[i] = s.k[i];
        value_cache_row[i] = s.v[i];
      }

      for h in 0..p.n_heads {
        let q_offset: i32 = h * head_size;
        let q_head: *mut f32 = vx_advance_ptr(s.q, q_offset);
        let att_offset: i32 = h * p.seq_len;
        let att_head: *mut f32 = vx_advance_ptr(s.att, att_offset);

        for t in 0..(pos + 1) {
          let koff: i32 = loff + t * kv_dim + (h / kv_mul) * head_size;
          let k_head: *mut f32 = vx_advance_ptr(s.key_cache, koff);
          let mut score: f32 = 0.0;
          for i in 0..head_size {
            let q_val: f32 = q_head[i];
            let k_val: f32 = k_head[i];
            score = score + q_val * k_val;
          }
          let hf: f32 = head_size;
          score = score / safe_sqrtf(hf);
          att_head[t] = score;
        }

        let mut max_val: f32 = att_head[0];
        for t in 1..(pos + 1) {
          let a_val: f32 = att_head[t];
          if a_val > max_val {
            max_val = a_val;
          }
        }

        let mut sum_exp: f32 = 0.0;
        for t in 0..(pos + 1) {
          let a_val: f32 = att_head[t];
          let e: f32 = safe_expf(a_val - max_val);
          att_head[t] = e;
          sum_exp = sum_exp + e;
        }

        for t in 0..(pos + 1) {
          let a_val: f32 = att_head[t];
          att_head[t] = a_val / sum_exp;
        }

        let xb_offset: i32 = h * head_size;
        let xb_head: *mut f32 = vx_advance_ptr(s.xb, xb_offset);
        for i in 0..head_size {
          xb_head[i] = 0.0;
        }

        for t in 0..(pos + 1) {
          let voff: i32 = loff + t * kv_dim + (h / kv_mul) * head_size;
          let v_head: *mut f32 = vx_advance_ptr(s.value_cache, voff);
          let a: f32 = att_head[t];
          for i in 0..head_size {
            let v_val: f32 = v_head[i];
            let xb_val: f32 = xb_head[i];
            xb_head[i] = xb_val + a * v_val;
          }
        }
      }

      let wo_l: *mut f32 = vx_advance_ptr(w.wo, l * dim * dim);
      let t_xb_v2: Tensor<f32> = ptr_to_tensor_1d(s.xb, dim);
      let t_wo: Tensor<f32> = ptr_to_tensor_2d(wo_l, dim, dim);
      let t_xb2: Tensor<f32> = t_xb_v2 @ t_wo;
      tensor_to_ptr_1d(t_xb2, s.xb2, dim);

      for i in 0..dim {
        let x_val: f32 = x[i];
        let xb2_val: f32 = s.xb2[i];
        x[i] = x_val + xb2_val;
      }

      let rms_ffn: *mut f32 = vx_advance_ptr(w.rms_ffn_weight, l * dim);
      rmsnorm(s.xb, x, rms_ffn, dim);

      let w1_l: *mut f32 = vx_advance_ptr(w.w1, l * dim * hidden_dim);
      let w3_l: *mut f32 = vx_advance_ptr(w.w3, l * dim * hidden_dim);

      let t_w1: Tensor<f32> = ptr_to_tensor_2d(w1_l, dim, hidden_dim);
      let t_w3: Tensor<f32> = ptr_to_tensor_2d(w3_l, dim, hidden_dim);

      let t_hb: Tensor<f32> = ptr_to_tensor_1d(s.xb, dim) @ t_w1;
      let t_hb2: Tensor<f32> = ptr_to_tensor_1d(s.xb, dim) @ t_w3;
      tensor_to_ptr_1d(t_hb, s.hb, hidden_dim);
      tensor_to_ptr_1d(t_hb2, s.hb2, hidden_dim);

      for i in 0..hidden_dim {
        let mut val: f32 = s.hb[i];
        val = val * (1.0 / (1.0 + safe_expf(0.0 - val)));
        let hb2_val: f32 = s.hb2[i];
        val = val * hb2_val;
        s.hb[i] = val;
      }

      let w2_l: *mut f32 = vx_advance_ptr(w.w2, l * hidden_dim * dim);
      let t_hb_v: Tensor<f32> = ptr_to_tensor_1d(s.hb, hidden_dim);
      let t_w2: Tensor<f32> = ptr_to_tensor_2d(w2_l, hidden_dim, dim);
      let t_xb_out: Tensor<f32> = t_hb_v @ t_w2;
      tensor_to_ptr_1d(t_xb_out, s.xb, dim);

      for i in 0..dim {
        let x_val: f32 = x[i];
        let xb_val: f32 = s.xb[i];
        x[i] = x_val + xb_val;
      }
    }

    rmsnorm(x, x, w.rms_final_weight, dim);

    let t_x: Tensor<f32> = ptr_to_tensor_1d(x, dim);
    let t_wcls: Tensor<f32> = ptr_to_tensor_2d(w.wcls, p.vocab_size, dim);
    let mut t_wcls_T: Tensor<f32> = Tensor([dim, p.vocab_size]);
    for r in 0..p.vocab_size {
      for c in 0..dim {
        t_wcls_T[c][r] = t_wcls[r][c];
      }
    }
    let t_logits: Tensor<f32> = t_x @ t_wcls_T;
    tensor_to_ptr_1d(t_logits, s.logits, p.vocab_size);
  };
  return s.logits;
}

fn argmax(probabilities: *mut f32, n: i32) -> i32 {
  let mut max_i: i32 = 0;
  let mut max_p: f32 = 0.0;
  for i in 0..n {
    unsafe {
      let p_val: f32 = probabilities[i];
      if p_val > max_p {
        max_i = i;
        max_p = p_val;
      }
    }
  }
  return max_i;
}

fn main() -> i32 {
  let model_path: *const i8 = "tests/backend/pass/stories15M.bin";
  let tokenizer_path: *const i8 = "tests/backend/pass/tokenizer.bin";
  let temperature: f32 = 0.0;

  let config_ptr: *mut i32 = unsafe { vx_load_config(model_path) };
  let vocab_size: i32 = unsafe {
    let p_vocab: *mut i32 = vx_advance_ptr(config_ptr, 5);
    p_vocab[0]
  };

  let config = unsafe {
    let dim_ptr: *mut i32 = config_ptr;
    let hidden_ptr: *mut i32 = vx_advance_ptr(config_ptr, 1);
    let layers_ptr: *mut i32 = vx_advance_ptr(config_ptr, 2);
    let heads_ptr: *mut i32 = vx_advance_ptr(config_ptr, 3);
    let kv_heads_ptr: *mut i32 = vx_advance_ptr(config_ptr, 4);
    let seq_ptr: *mut i32 = vx_advance_ptr(config_ptr, 6);

    Config {
      dim: dim_ptr[0],
      hidden_dim: hidden_ptr[0],
      n_layers: layers_ptr[0],
      n_heads: heads_ptr[0],
      n_kv_heads: kv_heads_ptr[0],
      vocab_size: vocab_size,
      seq_len: seq_ptr[0]
    }
  };

  let steps: i32 = 256;
  if config.seq_len < steps {
    let s: i32 = config.seq_len;
  }

  let weights_ptr: *mut f32 = unsafe { vx_load_weights(model_path) };
  let weights = memory_map_weights(weights_ptr, config.dim, config.hidden_dim, config.n_layers, config.n_heads, config.n_kv_heads, config.seq_len, config.vocab_size);
  let state = malloc_run_state(config.dim, config.hidden_dim, config.n_layers, config.n_heads, config.n_kv_heads, config.seq_len, config.vocab_size);
  let tokenizer_ptr: *mut i8 = unsafe { vx_build_tokenizer(tokenizer_path, config.vocab_size) };

  let start: f32 = unsafe { vx_get_time() };
  let mut next: i32 = 0;
  let mut token: i32 = 1;
  for pos in 0..steps {
    let logits: *mut f32 = transformer(token, pos, &config, &state, &weights);
    next = argmax(logits, config.vocab_size);
    let piece: *mut i8 = unsafe { vx_decode_token(tokenizer_ptr, token, next) };
    unsafe { print!(piece); }
    token = next;
  }
  unsafe { print!(0.0); }
  return 0;
}



