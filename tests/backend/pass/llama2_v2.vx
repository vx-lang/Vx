// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"LlamaConfig::load"(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"LlamaConfig", (i32, i32, i32, i32, i32, i32, i32)>
// CHECK: call @"TransformerWeightOffsets::calculate"(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"TransformerWeightOffsets", (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)>
// CHECK: call @"TransformerWeightOffsets::load_all_weights"(%{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr) -> memref<?x?xf32>
// CHECK: call @malloc_run_state(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (i32, i32, i32, i32, i32, i32, i32) -> !llvm.struct<"RunState", (ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)>
// CHECK: call @"Tokenizer::load"(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> !llvm.struct<"Tokenizer", (ptr)>
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = call @transformer(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (i32, i32, !llvm.ptr, !llvm.ptr, !llvm.ptr, memref<memref<?x?xf32>>) -> !llvm.ptr
// CHECK: call @argmax(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> i32

import std::llama;
import std::io;
import std::vec;
import std::math;
import std::time;

extern {
  fn vx_get_rope_freq(pos : i32, i : i32, head_size : i32)->f32;
  fn vx_advance_ptr(ptr : &mut f32, offset : i32) -> &mut f32;
}

struct RunState {
  x : &mut f32,
  xb : &mut f32,
  xb2 : &mut f32,
  hb : &mut f32,
  hb2 : &mut f32,
  q : &mut f32,
  k : &mut f32,
  v : &mut f32,
  att : &mut f32,
  logits : &mut f32,
  key_cache : &mut f32,
  value_cache : &mut f32
}

fn malloc_run_state(dim: i32, hidden_dim: i32, n_layers: i32, n_heads: i32, n_kv_heads: i32, seq_len: i32, vocab_size: i32) -> RunState {
  let div_kv : i32 = dim * n_kv_heads;
  let kv_dim : i32 = div_kv / n_heads;

  let state = RunState {
    x : Vec<f32>::with_capacity(dim).as_mut_slice(),
    xb : Vec<f32>::with_capacity(dim).as_mut_slice(),
    xb2 : Vec<f32>::with_capacity(dim).as_mut_slice(),
    hb : Vec<f32>::with_capacity(hidden_dim).as_mut_slice(),
    hb2 : Vec<f32>::with_capacity(hidden_dim).as_mut_slice(),
    q : Vec<f32>::with_capacity(dim).as_mut_slice(),
    k : Vec<f32>::with_capacity(dim).as_mut_slice(),
    v : Vec<f32>::with_capacity(dim).as_mut_slice(),
    att : Vec<f32>::with_capacity(n_heads * seq_len).as_mut_slice(),
    logits : Vec<f32>::with_capacity(vocab_size).as_mut_slice(),
    key_cache : Vec<f32>::with_capacity(n_layers * seq_len * kv_dim).as_mut_slice(),
    value_cache : Vec<f32>::with_capacity(n_layers * seq_len * kv_dim).as_mut_slice()
  };
  return state;
}

fn ptr_to_tensor_1d(ptr : &mut f32, d1 : i32) -> DynTensor<f32> {
  let mut t : DynTensor<f32> = DynTensor<f32>::uninit([1, d1]);
  for i in 0..d1 {
    t[0][i] = ptr[i];
  }
  return t;
}

fn tensor_to_ptr_1d(t : DynTensor<f32>, ptr : &mut f32, d1 : i32) -> i32 {
  for i in 0..d1 {
    ptr[i] = t[0][i];
  }
  return 0;
}
fn safe_get_rope_freq(pos : i32, i : i32, head_size : i32) -> f32 {
  return unsafe { vx_get_rope_freq(pos, i, head_size) };
}

fn rmsnorm(o : &mut f32, x : &mut f32, weight : &DynTensor<f32>, l: i32, size : i32) -> i32 {
  let mut ss : f32 = 0.0;
  for j in 0..size {
    let val : f32 = x[j];
    ss = ss + (val * val);
  }
  let div : f32 = ss / (size as f32);
  let add : f32 = div + 0.00001;
  ss = 1.0 / add.sqrt();
  for j in 0..size {
    let weight_val : f32 = weight[l][j];
    let x_val : f32 = x[j];
    o[j] = weight_val * (ss * x_val);
  }
  return 0;
}

fn rmsnorm_1d(o : &mut f32, x : &mut f32, weight : &DynTensor<f32>, size : i32) -> i32 {
  let mut ss : f32 = 0.0;
  for j in 0..size {
    let val : f32 = x[j];
    ss = ss + (val * val);
  }
  let div : f32 = ss / (size as f32);
  let add : f32 = div + 0.00001;
  ss = 1.0 / add.sqrt();
  for j in 0..size {
    let weight_val : f32 = weight[0][j];
    let x_val : f32 = x[j];
    o[j] = weight_val * (ss * x_val);
  }
  return 0;
}

fn advance_f32_ptr(ptr: &mut f32, offset: i32) -> &mut f32 {
  return unsafe { vx_advance_ptr(ptr, offset) };
}

fn transformer(token : i32, pos : i32, p : &LlamaConfig, s : &RunState,
w : &TransformerWeightOffsets, all_weights: &DynTensor<f32>) -> &mut f32 {
  let x : &mut f32 = s.x;
  let dim : i32 = p.dim;
  let kv_mul_div : i32 = p.dim * p.n_kv_heads;
  let kv_dim : i32 = kv_mul_div / p.n_heads;
  let kv_mul : i32 = p.n_heads / p.n_kv_heads;
  let hidden_dim : i32 = p.hidden_dim;
  let head_size : i32 = dim / p.n_heads;

  let emb_off = w.token_embedding_table + token * dim;
  for i in 0..dim {
    x[i] = all_weights[0][emb_off + i];
  }

  for l in 0..p.n_layers {
    let mut rms_att_w = DynTensor<f32>::uninit([1, dim]);
    let rms_att_off = w.rms_att_weight + l * dim;
    for j in 0..dim {
      rms_att_w[0][j] = all_weights[0][rms_att_off + j];
    }
    rmsnorm_1d(s.xb, x, &rms_att_w, dim);

    let mut t_wq = DynTensor<f32>::uninit([dim, dim]);
    let wq_off = w.wq + l * dim * dim;
    for j in 0..dim * dim {
      t_wq[0][j] = all_weights[0][wq_off + j];
    }

    let mut t_wk = DynTensor<f32>::uninit([dim, kv_dim]);
    let wk_off = w.wk + l * dim * kv_dim;
    for j in 0..dim * kv_dim {
      t_wk[0][j] = all_weights[0][wk_off + j];
    }

    let mut t_wv = DynTensor<f32>::uninit([dim, kv_dim]);
    let wv_off = w.wv + l * dim * kv_dim;
    for j in 0..dim * kv_dim {
      t_wv[0][j] = all_weights[0][wv_off + j];
    }

    let t_q = ptr_to_tensor_1d(s.xb, dim) @ t_wq;
    let t_k = ptr_to_tensor_1d(s.xb, dim) @ t_wk;
    let t_v = ptr_to_tensor_1d(s.xb, dim) @ t_wv;

    tensor_to_ptr_1d(t_q, s.q, dim);
    tensor_to_ptr_1d(t_k, s.k, kv_dim);
    tensor_to_ptr_1d(t_v, s.v, kv_dim);

    for i in 0..dim {
      let div : i32 = i / 2;
      let mul : i32 = div * 2;
      let rem : i32 = i - mul;
      if rem == 0 {
        let head_dim_div : i32 = i / head_size;
        let head_dim_mul : i32 = head_dim_div * head_size;
        let head_dim : i32 = i - head_dim_mul;
        let freq : f32 = safe_get_rope_freq(pos, head_dim, head_size);
        let fcr : f32 = freq.cos();
        let fci : f32 = freq.sin();

        let rotn_q_r : i32 = i;
        let rotn_q_i : i32 = i + 1;
        let q0 : f32 = s.q[rotn_q_r];
        let q1 : f32 = s.q[rotn_q_i];
        s.q[rotn_q_r] = q0 * fcr - q1 * fci;
        s.q[rotn_q_i] = q0 * fci + q1 * fcr;

        if i < kv_dim {
          let rotn_k_r : i32 = i;
          let rotn_k_i : i32 = i + 1;
          let k0 : f32 = s.k[rotn_k_r];
          let k1 : f32 = s.k[rotn_k_i];
          s.k[rotn_k_r] = k0 * fcr - k1 * fci;
          s.k[rotn_k_i] = k0 * fci + k1 * fcr;
        }
      }
    }

    let loff : i32 = l * p.seq_len * kv_dim;
    let key_cache_row : &mut f32 = advance_f32_ptr(s.key_cache, loff + pos * kv_dim);
    let value_cache_row : &mut f32 = advance_f32_ptr(s.value_cache, loff + pos * kv_dim);
    for i in 0..kv_dim {
      key_cache_row[i] = s.k[i];
      value_cache_row[i] = s.v[i];
    }

    for h in 0..p.n_heads {
      let q_offset : i32 = h * head_size;
      let q_head : &mut f32 = advance_f32_ptr(s.q, q_offset);
      let att_offset : i32 = h * p.seq_len;
      let att_head : &mut f32 = advance_f32_ptr(s.att, att_offset);

      for t in 0..(pos + 1) {
        let koff : i32 = loff + t * kv_dim + (h / kv_mul) * head_size;
        let k_head : &mut f32 = advance_f32_ptr(s.key_cache, koff);
        let mut score : f32 = 0.0;
        for i in 0..head_size {
          let q_val : f32 = q_head[i];
          let k_val : f32 = k_head[i];
          score = score + q_val * k_val;
        }
        let hf : f32 = head_size as f32;
        score = score / hf.sqrt();
        att_head[t] = score;
      }

      let mut max_val : f32 = att_head[0];
      for t in 1..(pos + 1) {
        let a_val : f32 = att_head[t];
        if a_val > max_val {
          max_val = a_val;
        }
      }

      let mut sum_exp : f32 = 0.0;
      for t in 0..(pos + 1) {
        let a_val : f32 = att_head[t];
        let e : f32 = a_val - max_val;
        let exp_e : f32 = e.exp();
        att_head[t] = exp_e;
        sum_exp = sum_exp + exp_e;
      }

      for t in 0..(pos + 1) {
        let a_val : f32 = att_head[t];
        att_head[t] = a_val / sum_exp;
      }

      let xb_offset : i32 = h * head_size;
      let xb_head : &mut f32 = advance_f32_ptr(s.xb, xb_offset);
      for i in 0..head_size {
        xb_head[i] = 0.0;
      }

      for t in 0..(pos + 1) {
        let voff : i32 = loff + t * kv_dim + (h / kv_mul) * head_size;
        let v_head : &mut f32 = advance_f32_ptr(s.value_cache, voff);
        let a : f32 = att_head[t];
        for i in 0..head_size {
          let v_val : f32 = v_head[i];
          let xb_val : f32 = xb_head[i];
          xb_head[i] = xb_val + a * v_val;
        }
      }
    }

    let t_xb_v2 = ptr_to_tensor_1d(s.xb, dim);
    let mut t_wo = DynTensor<f32>::uninit([dim, dim]);
    let wo_off = w.wo + l * dim * dim;
    for j in 0..dim * dim {
      t_wo[0][j] = all_weights[0][wo_off + j];
    }
    let t_xb2 = t_xb_v2 @ t_wo;
    tensor_to_ptr_1d(t_xb2, s.xb2, dim);

    for i in 0..dim {
      let x_val : f32 = x[i];
      let xb2_val : f32 = s.xb2[i];
      x[i] = x_val + xb2_val;
    }

    let mut rms_ffn_w = DynTensor<f32>::uninit([1, dim]);
    let rms_ffn_off = w.rms_ffn_weight + l * dim;
    for j in 0..dim {
      rms_ffn_w[0][j] = all_weights[0][rms_ffn_off + j];
    }
    rmsnorm_1d(s.xb, x, &rms_ffn_w, dim);

    let mut t_w1 = DynTensor<f32>::uninit([dim, hidden_dim]);
    let w1_off = w.w1 + l * dim * hidden_dim;
    for j in 0..dim * hidden_dim {
      t_w1[0][j] = all_weights[0][w1_off + j];
    }

    let mut t_w3 = DynTensor<f32>::uninit([dim, hidden_dim]);
    let w3_off = w.w3 + l * dim * hidden_dim;
    for j in 0..dim * hidden_dim {
      t_w3[0][j] = all_weights[0][w3_off + j];
    }

    let t_hb = ptr_to_tensor_1d(s.xb, dim) @ t_w1;
    let t_hb2 = ptr_to_tensor_1d(s.xb, dim) @ t_w3;
    tensor_to_ptr_1d(t_hb, s.hb, hidden_dim);
    tensor_to_ptr_1d(t_hb2, s.hb2, hidden_dim);

    for i in 0..hidden_dim {
      let mut val : f32 = s.hb[i];
      let exp_val : f32 = val.exp();
      val = val * (1.0 / (1.0 + 0.0 - exp_val));
      let hb2_val : f32 = s.hb2[i];
      val = val * hb2_val;
      s.hb[i] = val;
    }

    let t_hb_v = ptr_to_tensor_1d(s.hb, hidden_dim);
    let mut t_w2 = DynTensor<f32>::uninit([hidden_dim, dim]);
    let w2_off = w.w2 + l * hidden_dim * dim;
    for j in 0..hidden_dim * dim {
      t_w2[0][j] = all_weights[0][w2_off + j];
    }
    let t_xb_out = t_hb_v @ t_w2;
    tensor_to_ptr_1d(t_xb_out, s.xb, dim);

    for i in 0..dim {
      let x_val : f32 = x[i];
      let xb_val : f32 = s.xb[i];
      x[i] = x_val + xb_val;
    }
  }

  let mut rms_final_w = DynTensor<f32>::uninit([1, dim]);
  for j in 0..dim {
    rms_final_w[0][j] = all_weights[0][w.rms_final_weight + j];
  }
  rmsnorm_1d(x, x, &rms_final_w, dim);

  let t_x = ptr_to_tensor_1d(x, dim);
  let mut t_wcls_T : DynTensor<f32> = DynTensor<f32>::uninit([dim, p.vocab_size]);
  for r in 0..p.vocab_size {
    for c in 0..dim {
      t_wcls_T[c][r] = all_weights[0][w.wcls + r * dim + c];
    }
  }
  let t_logits = t_x @ t_wcls_T;
  tensor_to_ptr_1d(t_logits, s.logits, p.vocab_size);
  return s.logits;
}

fn argmax(probabilities : &mut f32, n : i32) -> i32 {
  let mut max_i : i32 = 0;
  let mut max_p : f32 = 0.0;
  for i in 0..n {
    let p_val : f32 = probabilities[i];
    if p_val > max_p {
      max_i = i;
      max_p = p_val;
    }
  }
  return max_i;
}

fn main() -> i32 {
  let model_path : *const i8 = "tests/backend/pass/stories15M.bin";
  let tokenizer_path : *const i8 = "tests/backend/pass/tokenizer.bin";
  let temperature : f32 = 0.0;

  let config = LlamaConfig::load(model_path);
  let steps : i32 = 256;
  if config.seq_len < steps {
    let s : i32 = config.seq_len;
  }

  let weights = TransformerWeightOffsets::calculate(&config);
  let all_weights = TransformerWeightOffsets::load_all_weights(model_path, &config);

  let state = malloc_run_state(config.dim, config.hidden_dim, config.n_layers,
  config.n_heads, config.n_kv_heads,
  config.seq_len, config.vocab_size);

  let tokenizer = Tokenizer::load(tokenizer_path, config.vocab_size);

  let mut next : i32 = 0;
  let mut token : i32 = 1;

  print!("
[Assistant]: ");
  for pos in 0..steps {
    let logits : &mut f32 =
    transformer(token, pos, &config, &state, &weights, &all_weights);
    next = argmax(logits, config.vocab_size);
    let piece : String = tokenizer.decode(token, next);
    print!(piece);
    token = next;
  }
  print!("
");
  return 0;
}
