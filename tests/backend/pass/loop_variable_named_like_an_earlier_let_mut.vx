//===----------------------------------------------------------------------===//
// A `for` loop whose variable `k` has the name of a `let mut k` in an earlier loop. Inside
// the second loop, `k` is the loop's own value, 0 to 2. With `axis` 0 the first loop adds
// 5 twice, with 1 it adds 0 and 1; the second loop adds 3 either way.
//
// EXPECT: 13 4
fn total(axis : i32) -> i32 {
  let mut sum = 0;
  for i in 0..2 {
    let mut k = i;
    if axis == 0 {
      k = 5;
    }
    sum = sum + k;
  }
  for k in 0..3 {
    sum = sum + k;
  }
  return sum;
}

fn main() -> i32 {
  print(total(0));
  print!(" ");
  print(total(1));
  return 0;
}
