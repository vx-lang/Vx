//===----------------------------------------------------------------------===//
// Two regions read and write 8-bit and 4-bit floats. LLVM has no type for
// these floats, so the SPIR-V image stores each one as the integer of its
// width, as the host does. Both regions get an image. device_image_test.rs
// checks that `spirv-val` accepts it.
//
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s # flat-codegen
// CHECK: format=spirv
// CHECK: format=spirv
// EXPECT: -4 -3.5 3 1.5
// EXPECT: -0 -4 -8 -4

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached, scope: device
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 63 GB/s
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<f8e4m3, [8]>::uninit() };
  let mut b = unsafe { Tensor<f4e2m1, [8]>::uninit() };
  for i in 0..8 {
    a[i] = ((i as f32) * 0.5 - 2.0) as f8e4m3;
    b[i] = ((i as f32) * -0.5) as f4e2m1;
  }
  let ga = transfer(a, Memory::DEV_HBM);
  let gb = transfer(b, Memory::DEV_HBM);
  let mut ga2 = transfer(unsafe { Tensor<f32, [8]>::uninit() }, Memory::DEV_HBM);
  let mut g8 = transfer(unsafe { Tensor<f8e5m2, [8]>::uninit() }, Memory::DEV_HBM);
  let mut gb2 = transfer(unsafe { Tensor<f32, [8]>::uninit() }, Memory::DEV_HBM);
  let mut g4 = transfer(unsafe { Tensor<f4e2m1, [8]>::uninit() }, Memory::DEV_HBM);
  spawn on(Topology::Dev) {
    for i in 0..8 {
      ga2[i] = (ga[i] as f32) * 2.0;
      g8[i] = ((i as f32) - 3.5) as f8e5m2;
    }
  }
  spawn on(Topology::Dev) {
    for i in 0..8 {
      gb2[i] = (gb[i] as f32) * 2.0;
      g4[i] = ((i as f32) * -1.0) as f4e2m1;
    }
  }
  let a2 = transfer(ga2, Memory::CPU_DRAM);
  let e8 = transfer(g8, Memory::CPU_DRAM);
  let b2 = transfer(gb2, Memory::CPU_DRAM);
  let e4 = transfer(g4, Memory::CPU_DRAM);
  println!("{} {} {} {}", a2[0], e8[0] as f32, a2[7], e8[5] as f32);
  println!("{} {} {} {}", b2[0], b2[5], b2[7], e4[5] as f32);
  return 0;
}
