//===----------------------------------------------------------------------===//
// A function taking a statically shaped tensor by reference. This did not compile at all
// (Vx#417): the checker answered `t[i][j]` with the row rather than the element, and the
// call site cast between two memref types that `memref.cast` cannot convert.
//
// The reference is passed as the tensor's buffer. The call site and the function use the
// same static shape, so no cast is needed.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[A:.*]] = memref.alloc() : memref<2x2xf32>
// CHECK: call @fill(%[[A]], %{{.*}})
// CHECK: call @total(%[[A]])
// CHECK-LABEL: func.func @total(%arg0: memref<2x2xf32>{{[^,)]*}}) -> f32
// CHECK: %[[ROW:.*]] = memref.reinterpret_cast %arg0
// CHECK: memref.load %[[ROW]]
// CHECK-LABEL: func.func @fill(%arg0: memref<2x2xf32>{{[^,)]*}}, %arg1: f32) -> i32
// CHECK: %[[ROW0:.*]] = memref.reinterpret_cast %arg0
// CHECK: memref.store %arg1, %[[ROW0]]
//
// `fill` writes through the borrow and `main` reads the result, so a parameter that had
// somehow become a copy would show up as 0 rather than 7.
// EXPECT: 7

fn fill(t : &mut Tensor<f32, [2, 2]>, v : f32) -> i32 {
  t[0][0] = v;
  t[1][1] = v + 1.0;
  return 0;
}

fn total(t : &Tensor<f32, [2, 2]>) -> f32 {
  return t[0][0] + t[1][1];
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<f32, [2, 2]>::uninit() };
  let _r = fill(&mut a, 3.0);
  print(total(&a));
  return 0;
}
