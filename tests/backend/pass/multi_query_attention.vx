// Multi-Query Attention (Shazeer 2019): several query heads share a SINGLE
// key/value head. Cuts the KV cache by the head count -- the standard
// inference-latency win -- at the cost of representational capacity vs full
// multi-head attention. Here H=2 query heads (d_head=2, so D=4) attend over one
// shared K/V head of width 2.
//
// Hand-checkable (scale=1/2), shared K row0=0/row1=1, V row0=0/row1=2:
//   Q0 = [ [1,1] , [0,0] ]  (head0, head1)
//   Q1 = [ [0,0] , [1,1] ]
//   A [1,1] head over K -> scores [0,1] -> softmax [1,e]/(1+e) ~= [0.269,0.731]
//     -> O ~= 0.731*2 = 1.46212;  a [0,0] head -> uniform -> O = 1.0.
//   So O0 = [1.46212, 1.46212, 1, 1], O1 = [1, 1, 1.46212, 1.46212].
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: func.func @main

import std::math;

fn main() -> i32 {
  let mut q = Tensor<f32>([2, 4]);
  let mut k = Tensor<f32>([2, 2]);
  let mut v = Tensor<f32>([2, 2]);
  let mut o = Tensor<f32>([2, 4]);

  for c in 0..2 {
    k[0][c] = 0.0;
    k[1][c] = 1.0;
    v[0][c] = 0.0;
    v[1][c] = 2.0;
  }
  q[0][0] = 1.0;
  q[0][1] = 1.0;
  q[0][2] = 0.0;
  q[0][3] = 0.0;
  q[1][0] = 0.0;
  q[1][1] = 0.0;
  q[1][2] = 1.0;
  q[1][3] = 1.0;

  let scale : f32 = 0.5;

  for h in 0..2 {
    let base : i32 = h * 2;
    for i in 0..2 {
      // scores of query head (i, h) against the two shared keys
      let mut s0 : f32 = 0.0;
      let mut s1 : f32 = 0.0;
      for c in 0..2 {
        s0 += q[i][base + c] * k[0][c];
        s1 += q[i][base + c] * k[1][c];
      }
      s0 = s0 * scale;
      s1 = s1 * scale;
      // softmax over the two keys, numerically stable
      let mut mx : f32 = s0;
      if s1 > mx {
        mx = s1;
      }
      let e0 : f32 = (s0 - mx).exp();
      let e1 : f32 = (s1 - mx).exp();
      let sum : f32 = e0 + e1;
      let w0 : f32 = e0 / sum;
      let w1 : f32 = e1 / sum;
      for c in 0..2 {
        o[i][base + c] = w0 * v[0][c] + w1 * v[1][c];
      }
    }
  }

  print(o);
  return 0;
}

// EXPECT: [[1.46212,
// EXPECT: 1.46212]]
