//===----------------------------------------------------------------------===//
// The package `tests` passes closures that have no `unsafe` block in them. A closure is not
// trusted code, so `--no-trusted-code tests` allows the program, and the audit lists nothing in
// the package.
//
// RUN: vxc --package tests=tests --no-trusted-code tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests --audit %s 2>&1 | FileCheck %s --check-prefix=AUDIT --implicit-check-not=a_package_that_passes_closures
// CHECK: {{^}}2 3{{$}}
// AUDIT: core and std:

import tests::modules::a_package_that_passes_closures;

fn main() -> i32 {
  println!("{} {}", add_one(1), add_two_in_time(1));
  return 0;
}
