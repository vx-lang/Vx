//===----------------------------------------------------------------------===//
// The assertions below use the DISPATCH prefix, not EXPECT.
//
// `// EXPECT:` means two different things here: FileCheck reads it as a prefix
// for the EXEC_RUN pipeline, and the backend harness reads it as a literal line
// the program must print. These files meant the first and got both, so building
// the CoreML models made the harness demand dispatcher logs that only appear
// under VX_DISPATCH_VERBOSE -- i.e. these tests passed only while the ANE path
// was broken (Vx#366, Vx#436). Renaming the prefix separates the two meanings.
//
// EXEC_RUN itself is implemented nowhere, so nothing below runs today.
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM
//
// EXEC_RUN: vxc %s | mlir-opt -convert-scf-to-cf
// -convert-func-to-llvm="use-bare-ptr-memref-call-conv=true"
// -expand-strided-metadata -finalize-memref-to-llvm -reconcile-unrealized-casts
// | mlir-translate -mlir-to-llvmir | llc -filetype=obj -o %t.o
// EXEC_RUN: clang %t.o -Ltarget/debug/build/*/out -lnpu_dispatch -o %t
// EXEC_RUN: %t | FileCheck %s --check-prefix=DISPATCH

fn main() -> i32 {
  let mut a_host = Tensor<f32, [4, 4]>::uninit();
  let mut b_host = Tensor<f32, [4, 4]>::uninit();
  let mut result_host = Tensor<f32, [4, 4]>::uninit();

  for i in 0..4 {
    for j in 0..4 {
      a_host[i][j] = 2.0;
      b_host[i][j] = 3.0;
      result_host[i][j] = 0.0;
    }
  }

  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);
  let mut result = transfer(result_host, Memory::NPU_HBM);

  // This block will be intercepted by codegen and dispatched to our Mac
  // hardware dispatcher
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        for k in 0..4 {
          result[i][j] += a[i][k] * b[k][j];
        }
      }
    }
  }

  // Print to verify!
  // It should be 2.0 * 3.0 * 4 = 24.0 for all cells!
  print(result);

  return 0;
}

// DISPATCH: [Vx Dispatcher] Intercepted kernel dispatch: vx_npu_kernel_{{[0-9]+}} with 5 args
// DISPATCH: --- DISPATCHING VIA COREML (compute unit chosen by CoreML) ---
// DISPATCH: Unranked Memref base@
// DISPATCH: [[24,   24,   24,   24],
// DISPATCH:  [24,   24,   24,   24],
// DISPATCH:  [24,   24,   24,   24],
// DISPATCH:  [24,   24,   24,   24]]

// The dispatch shape, which holds whether or not the ANE runtime is present: the matmul
// becomes one NPU region, matching the single "Intercepted kernel dispatch" line below.
// CHECK-LABEL: func.func @main() -> i32 {
// CHECK: vx.spawn topology(100) {
// CHECK: arith.mulf
// CHECK: } {topology_name = "NPU[0]"}

// convert-vx-to-standard outlines the region: the site becomes a vx.launch naming a vx.kernel
// that carries the topology, and the operands travel as memref descriptors.
// STD: vx.launch @[[K:[a-z0-9_]+]]({{.*}}) {topology = 100 : i32, vx.topology_name = "NPU[0]"}
// STD: vx.kernel @[[K]](100) :
// STD: vx.return

// vx-to-llvm replaces the launch with the vendor-neutral plugin call and a descriptor string
// carrying the kernel name, its topology id and the topology's name -- the ABI a worker reads.
// LLVM: llvm.func @vx_plugin_dispatch_async(!llvm.ptr, i64, !llvm.ptr, !llvm.ptr, i64) -> i64
// LLVM: llvm.mlir.global internal constant @[[K:[a-z0-9_]+]]_str("[[K]]\00topo=100\00toponame=NPU[0]\00")
// LLVM: llvm.call @vx_plugin_dispatch_async(
// LLVM: llvm.func @[[K]](
