// EXEC_RUN: vxc %s | mlir-opt -convert-scf-to-cf
// -convert-func-to-llvm="use-bare-ptr-memref-call-conv=true"
// -expand-strided-metadata -finalize-memref-to-llvm -reconcile-unrealized-casts
// | mlir-translate -mlir-to-llvmir | llc -filetype=obj -o %t.o EXEC_RUN: clang
// %t.o -Ltarget/debug/build/*/out -lnpu_dispatch -o %t EXEC_RUN: %t | FileCheck
// %s --check-prefix=EXEC RUN: vxc %s --emit-mlir -O0 RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" RUN: vxc %s
// --emit-llvm

fn main() -> i32 {
  let mut a_host = Tensor<f32>([ 4, 4 ]);
  let mut b_host = Tensor<f32>([ 4, 4 ]);
  let mut result_host = Tensor<f32>([ 4, 4 ]);

  for i in 0..4 {
    for j in 0..4 {
      a_host[i][j] = 2.0;
      b_host[i][j] = 3.0;
      result_host[i][j] = 0.0;
    }
  }

  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);
  let mut result = transfer(result_host, Memory::NPU_HBM);

  // This block will be intercepted by codegen and dispatched to our Mac
  // hardware dispatcher
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        for k in 0..4 {
          result[i][j] += a[i][k] * b[k][j];
        }
      }
    }
  }

  // Print to verify!
  // It should be 2.0 * 3.0 * 4 = 24.0 for all cells!
  print(result);

  return 0;
}

// EXPECT: [Vx Dispatcher] Intercepted kernel dispatch: vx_npu_kernel_{{[0-9]+}} with 5 args
// EXPECT: --- EXECUTING ON APPLE NEURAL ENGINE ---
// EXPECT: Unranked Memref base@
// EXPECT: [[24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24]]

