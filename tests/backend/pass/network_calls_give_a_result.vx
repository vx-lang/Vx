//===----------------------------------------------------------------------===//
// Each call of `std::net` that can fail gives a `Result` with a `NetError`.
//
// - A connect to a port where nothing listens gives `Refused`, and an address with no port
//   gives `BadAddress`.
// - A second listener on the address of the first gives `InUse`.
// - A task connects to the listener and writes one byte. The code of the block accepts the
//   connection and reads the byte.
// - In `cancel_an_accept`, a task waits in `accept` for a connection that never comes. The
//   code of the block returns early, which cancels the task, so `accept` gives `Cancelled`.
//
// The port numbers are fixed, because `std::net` cannot give the port of a listener yet. The
// second RUN line runs the tasks on the shared runtime, with one worker thread, and the third
// one uses the AST code generator.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}connect to a closed port: Refused{{$}}
// CHECK-NEXT: {{^}}connect to an address with no port: BadAddress{{$}}
// CHECK-NEXT: {{^}}the first listener works{{$}}
// CHECK-NEXT: {{^}}the second listener: InUse{{$}}
// CHECK-NEXT: {{^}}the server read 1 byte, 86{{$}}
// CHECK-NEXT: {{^}}the accept gave Cancelled{{$}}

import core::result;
import std::net;

fn name(e : NetError) -> *const i8 {
  match e {
    NetError::Cancelled => {
      return "Cancelled";
    }
    NetError::BadAddress => {
      return "BadAddress";
    }
    NetError::Refused => {
      return "Refused";
    }
    NetError::Reset => {
      return "Reset";
    }
    NetError::InUse => {
      return "InUse";
    }
    NetError::Os(_n) => {
      return "Os";
    }
  }
}

fn connect_to(what : *const i8, addr : *const i8) -> void {
  match unsafe { TcpStream::connect_c_str(addr) } {
    Result<TcpStream, NetError>::Ok(_s) => {
      println!("{}: it connected", what);
    }
    Result<TcpStream, NetError>::Err(e) => {
      println!("{}: {}", what, name(e));
    }
  }
}

fn send_one_byte() -> void {
  match unsafe { TcpStream::connect_c_str("127.0.0.1:41753") } {
    Result<TcpStream, NetError>::Ok(s) => {
      let mut stream = s;
      let byte : u8 = 86;
      let one : u64 = 1;
      let _sent = unsafe { stream.write_raw((&byte) as *const u8, one) };
    }
    Result<TcpStream, NetError>::Err(e) => {
      println!("the client could not connect: {}", name(e));
    }
  }
}

fn read_one_byte(s : TcpStream) -> void {
  let mut stream = s;
  let mut byte : u8 = 0;
  let one : u64 = 1;
  match unsafe { stream.read_raw((&mut byte) as *mut u8, one) } {
    Result<u64, NetError>::Ok(n) => {
      println!("the server read {} byte, {}", n, byte);
    }
    Result<u64, NetError>::Err(e) => {
      println!("the read failed: {}", name(e));
    }
  }
}

fn accept_and_read(listener : TcpListener) -> void {
  let mut l = listener;
  match l.accept() {
    Result<TcpStream, NetError>::Ok(s) => {
      read_one_byte(s);
    }
    Result<TcpStream, NetError>::Err(e) => {
      println!("the accept failed: {}", name(e));
    }
  }
}

fn serve(listener : TcpListener) -> void {
  tasks {
    spawn {
      send_one_byte();
    };
    accept_and_read(listener);
  }
}

fn wait_for_a_connection(listener : TcpListener) -> void {
  let mut l = listener;
  match l.accept() {
    Result<TcpStream, NetError>::Ok(_s) => {
      println!("the accept got a connection");
    }
    Result<TcpStream, NetError>::Err(e) => {
      println!("the accept gave {}", name(e));
    }
  }
}

fn cancel_an_accept() -> i32 {
  match unsafe { TcpListener::bind_c_str("127.0.0.1:41754") } {
    Result<TcpListener, NetError>::Ok(listener) => {
      tasks {
        spawn {
          wait_for_a_connection(listener);
        };
        return 0;
      }
    }
    Result<TcpListener, NetError>::Err(e) => {
      println!("the listener to cancel failed: {}", name(e));
    }
  }
  return 1;
}

fn main() -> i32 {
  connect_to("connect to a closed port", "127.0.0.1:1");
  connect_to("connect to an address with no port", "127.0.0.1");
  match unsafe { TcpListener::bind_c_str("127.0.0.1:41753") } {
    Result<TcpListener, NetError>::Ok(listener) => {
      println!("the first listener works");
      match unsafe { TcpListener::bind_c_str("127.0.0.1:41753") } {
        Result<TcpListener, NetError>::Ok(_second) => {
          println!("the second listener works too");
        }
        Result<TcpListener, NetError>::Err(e) => {
          println!("the second listener: {}", name(e));
        }
      }
      serve(listener);
    }
    Result<TcpListener, NetError>::Err(e) => {
      println!("the first listener failed: {}", name(e));
    }
  }
  return cancel_an_accept();
}
