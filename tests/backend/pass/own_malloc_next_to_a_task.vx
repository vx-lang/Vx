//===----------------------------------------------------------------------===//
// A program that calls `malloc` itself can also start a task. The task code calls `malloc`
// too, and both calls use one declaration. A second declaration stopped the compile with
// "redefinition of symbol named 'malloc'".
import std::alloc;

fn main() -> i32 {
  let p : *mut i32 = unsafe { malloc(4) };
  unsafe { p[0] = 5; }
  let mut total : i32 = 0;
  tasks {
    let a = spawn {
      2
    };
    total = a.join();
  }
  print(total + unsafe { p[0] });
  unsafe { free(p); }
  return 0;
}

// EXPECT: 7
