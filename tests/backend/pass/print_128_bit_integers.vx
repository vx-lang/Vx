//===----------------------------------------------------------------------===//
// `print` and `println!` print a `u128` and an `i128`, also above 64 bits. A runtime helper
// takes the value as its low and its high 64 bits. `square` is above 2^127, so it would print as
// a negative number if it were read as an `i128`. `VX_NO_AST_FALLBACK=1` makes the default code
// generator fail rather than give a function to the AST code generator.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}18446744073709551615000{{$}}
// CHECK: {{^}}1000000000000000000000{{$}}
// CHECK: {{^}}-1000000000000000000000 -5{{$}}
// CHECK: {{^}}340282366920938463426481119284349108225{{$}}

fn main() -> i32 {
  let big : u64 = 18446744073709551615;
  let x : u128 = (big as u128) * 1000;
  print(x);
  println!("");
  let y : u128 = 1000000000000000000000;
  println!("{}", y);
  let m : i128 = 0 - (y as i128);
  let small : i128 = 0 - 5;
  println!("{} {}", m, small);
  let square : u128 = (big as u128) * (big as u128);
  println!("{}", square);
  return 0;
}
