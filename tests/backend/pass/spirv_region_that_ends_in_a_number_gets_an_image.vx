// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// A `spirv64` region that ends in a number gets a SPIR-V image. The kernel stores the number in a
// buffer in device memory, and the host copies it back. device_image_test.rs checks the image.
// Here: the spawn carries the arch and the answer is right.
//
// CHECK: vx.spawn topology({{[0-9]+}}) {
// CHECK: } {arch = "spirv64"
// EXPECT: 6

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<i32, [2, 2]>::uninit() };
  for i in 0..2 {
    for j in 0..2 {
      a[i][j] = i * 3 + j + 1;
    }
  }
  let ad = transfer(a, Memory::DEV_HBM);
  let v = spawn on(Topology::Dev) {
    ad[0][0] + ad[1][1]
  };
  let hv = transfer(v, Memory::CPU_DRAM);
  print(hv);
  return 0;
}
