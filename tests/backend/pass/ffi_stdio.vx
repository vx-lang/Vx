// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_stdout_write(
// CHECK-DAG: func.func private @vx_stderr_write(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @vx_stdout_write(%{{.*}}, %{{.*}}) : (!llvm.ptr, i64) -> i64
// CHECK: call @vx_stderr_write(%{{.*}}, %{{.*}}) : (!llvm.ptr, i64) -> i64
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
import std::io;
extern {
  fn vx_stdout_write(buffer : *const u8, len : i64) -> i64;
  fn vx_stderr_write(buffer : *const u8, len : i64) -> i64;
}

fn main() -> i32 {
  unsafe {
    let msg = "Hello Stdout!
              ";
    // msg is a string literal, which in Vx acts as a pointer to bytes?
    // Length of "Hello Stdout!\n" is 14
    vx_stdout_write(msg, 14);

    let msg2 = "Hello Stderr!
               ";
    vx_stderr_write(msg2, 14);

    print!("Stdio Success: ");
    print!(0);
  }
  return 0;
}
// EXPECT: Hello Stdout!
// EXPECT: Hello Stderr!
// EXPECT: Stdio Success: 0
