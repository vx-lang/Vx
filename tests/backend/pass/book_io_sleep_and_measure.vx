// A program of the book chapter on files, input and time (www/book/src/files-input-time.md):
// it measures a sleep with `Instant` and adds two `Duration` values.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}slept at least 50 ms: true{{$}}
// CHECK: {{^}}1 s and 500 ms{{$}}
// CHECK: {{^}}total 3500 ms{{$}}

// ANCHOR: program
import core::time;
import std::time;

fn main() -> i32 {
  let start = Instant::now();
  sleep(Duration::from_millis(50));
  let waited = start.elapsed();
  println!("slept at least 50 ms: {}", waited.as_millis() >= 50);

  let step = Duration::from_millis(1500);
  println!("{} s and {} ms", step.as_secs(), step.subsec_millis());
  let total = step + Duration::from_secs(2);
  println!("total {} ms", total.as_millis());
  return 0;
}
// ANCHOR_END: program
