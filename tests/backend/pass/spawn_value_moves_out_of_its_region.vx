//===----------------------------------------------------------------------===//
// A `spawn` region's last value moves to the function around it, as a return does.
//
// - `made`: the region creates `x` and hands it out, so `x` is created in GPU memory before
//   the region, and `main` copies 0, 1, 2 and 3 back from it;
// - `given`: the region hands out `g`, a tensor copied to GPU memory before it, so `g` moves to
//   `t`, and `main` reads 2.5 four times from the host copy of `t` without dropping `g` first.
//
// EXPECT: 6 | 10

fn made() -> f32 {
  let n = 4;
  let t = spawn on(Topology::GPU) {
    let mut x = Tensor<f32>([n]);
    for i in 0..4 {
      x[i] = i as f32;
    }
    x
  };
  let h = transfer(t, Memory::CPU_DRAM);
  return h[0] + h[1] + h[2] + h[3];
}

fn given() -> f32 {
  let mut a = unsafe { Tensor<f32, [4]>::uninit() };
  for i in 0..4 {
    a[i] = 2.5;
  }
  let g = transfer(a, Memory::GPU_HBM);
  let t = spawn on(Topology::GPU) {
    g
  };
  let h = transfer(t, Memory::CPU_DRAM);
  return h[0] + h[1] + h[2] + h[3];
}

fn main() -> i32 {
  print(made());
  print!(" | ");
  print(given());
  return 0;
}
