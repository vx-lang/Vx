import std::io;
import std::math;
extern "C" {
}

fn main() -> i32 {
  let a : f32 = 16.0;
  let b : f32 = 0.0;

  unsafe {
    let root = a.sqrt();
    let exp = b.exp();
    print!(root);
    print!(exp);
  }
  return 0;
}

