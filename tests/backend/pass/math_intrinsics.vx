// RUN: vxc %s
// RUN: %t

extern "C" {
  fn vx_sqrtf(x: f32) -> f32;
  fn vx_expf(x: f32) -> f32;
  fn print_f32(val: f32) -> i32;
}

fn main() -> i32 {
  let a: f32 = 16.0;
  let b: f32 = 0.0;

  unsafe {
    let root = vx_sqrtf(a);
    let exp = vx_expf(b);
    print_f32(root);
    print_f32(exp);
  }
  return 0;
}

// CHECK: 4.000000
// CHECK: 1.000000



