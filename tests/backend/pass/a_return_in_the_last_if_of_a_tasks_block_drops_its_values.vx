//===----------------------------------------------------------------------===//
// The last `if` of a `tasks` block is the value of the block. A `return` in that `if` must drop
// the tensor `b` and the `Loud` `l` that the block made. `l` prints when it is dropped.
//
// RUN: env VX_PRINT_DROPS=1 vxc %s --action emit-mlir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DROPS
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
//
// DROPS-DAG: drop in leaves: b, before the return on line 40
// DROPS-DAG: drop in leaves: l, before the return on line 40
//
// CHECK: {{^}}block sees 5{{$}}
// CHECK-NEXT: {{^}}drop loud 1{{$}}
// CHECK-NEXT: {{^}}returned 1{{$}}

struct Loud {
  id : i32,
}

impl Drop for Loud {
  fn drop(self : &mut Loud) -> void {
    println!("drop loud {}", self.id);
  }
}

fn leaves(leave : bool) -> i32 {
  tasks {
    let b = Tensor<f32, [4]>::fill(5.0);
    let l = Loud {
      id: 1
    };
    if leave {
      println!("block sees {}", b[0]);
      return l.id;
    }
  };
  return 0;
}

fn main() -> i32 {
  let r = leaves(true);
  println!("returned {}", r);
  return 0;
}
