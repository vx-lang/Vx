// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
//
// A view borrows its tensor only until the view's last use. Each function below makes a view
// a different way, and uses or moves the tensor once the view is no longer used.

fn take(t : Tensor<f32, [2, 4]>) -> f32 {
  return t[1][0];
}

// 1: a row chosen by an `if`.
fn chosen_by_if(c : bool) -> f32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  q[1][1] = 1.0;
  let r = if c {
    q[0]
  } else {
    q[1]
  };
  let x = r[1];
  return x + take(q);
}

// 2: a reshape.
fn reshaped() -> f32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  q[0][2] = 2.0;
  let r = q.reshape([8]);
  let x = r[2];
  return x + take(q);
}

// 3: a row taken through a reference.
fn through_a_reference() -> f32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  q[1][3] = 3.0;
  let rq = &q;
  let r = rq[1];
  let x = r[3];
  return x + take(q);
}

// 4: a `mut` row through a `&mut` reference, while the reference is used again later.
fn through_a_mut_reference() -> f32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  let rq = &mut q;
  let mut r = rq[1];
  r[0] = 1.0;
  rq[0][0] = 3.0;
  return q[1][0] + q[0][0];
}

// 5: a `&mut` reference moved to another variable writes through the new one.
fn reference_moved() -> f32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  let r = &mut q;
  let r2 = r;
  r2[0][0] = 5.0;
  return q[0][0];
}

fn main() -> i32 {
  print(chosen_by_if(false));
  print(reshaped());
  print(through_a_reference());
  print(through_a_mut_reference());
  print(reference_moved());
  return 0;
}

