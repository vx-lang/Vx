//===----------------------------------------------------------------------===//
// A false assert in a branch that runs only for some inputs is a run-time check, not a compile
// error (E8002). Each function below has one, in an `if`, an `else` and a `match` arm. With no
// arguments, `argc` is 1, so no assert runs.
// fail/a_false_assert_stops_the_program_when_its_branch_runs.vx runs one of these asserts.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}2 3 4 5{{$}}

import core::result;

fn in_an_if(x : i32) -> i32 {
  if x > 100 {
    assert(false, "x is too large");
  }
  return x + 1;
}

fn in_an_else(x : i32) -> i32 {
  if x < 100 {
    return x + 2;
  } else {
    assert(false, "x is too large");
  }
  return 0;
}

fn in_a_match_arm(r : Result<i32, i32>) -> i32 {
  match r {
    Result::Ok(v) => {
      return v + 3;
    }
    Result::Err(_e) => {
      assert(false, "there is no error");
    }
  }
  return 0;
}

// The compiler knows that `v` is 0, but not whether the branch runs.
fn with_a_known_value(x : i32) -> i32 {
  let v = 0;
  if x > 100 {
    assert(v > 1, "v is 0");
  }
  return x + 4;
}

fn main(argc : i32) -> i32 {
  let a = in_an_if(argc);
  let b = in_an_else(argc);
  let c = in_a_match_arm(Result<i32, i32>::Ok(argc));
  let d = with_a_known_value(argc);
  println!("{} {} {} {}", a, b, c, d);
  return 0;
}
