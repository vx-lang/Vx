// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_vec_new_i32(
// CHECK-DAG: func.func private @vx_vec_push_i32(
// CHECK-DAG: func.func private @vx_vec_len_i32(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-DAG: func.func private @vx_vec_drop_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_vec_new_i32() : () -> !llvm.ptr
// CHECK: call @vx_vec_push_i32(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @vx_vec_push_i32(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: %[[V1:.*]] = call @vx_vec_len_i32(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%[[V1]]) : (i32) -> i32
// CHECK: call @vx_vec_drop_i32(%[[V0]]) : (!llvm.ptr) -> i32
extern "C" {
  fn vx_vec_new_i32() -> *mut i8;
  fn vx_vec_push_i32(vec : *mut i8, val : i32) -> i32;
  fn vx_vec_len_i32(vec : *mut i8) -> i32;
  fn vx_vec_drop_i32(vec : *mut i8) -> i32;
}
import std::io;
fn main() -> i32 {
  unsafe {
    let vec = vx_vec_new_i32();
    vx_vec_push_i32(vec, 42);
    vx_vec_push_i32(vec, 100);
    let len = vx_vec_len_i32(vec);
    print!("Length: ");
    print!(len);
    vx_vec_drop_i32(vec);
  }
  return 0;
}

// EXPECT: Length: 2
