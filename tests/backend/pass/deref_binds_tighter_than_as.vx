// Regression test for #3270: *r as T must parse as (*r) as T.
import std::vec;

fn main() -> i32 {
  let mut v = Vec<u8>::new();
  v.push(7);
  let x = *v.get_ref(0) as i64;
  if x != 7 {
    return 1;
  }
  return 0;
}
