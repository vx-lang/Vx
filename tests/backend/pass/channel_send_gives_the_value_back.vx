//===----------------------------------------------------------------------===//
// A `send` to a channel whose `Receiver` was dropped does not wait. It gives the value back in
// the `SendError`. Here the channel has room for 1 value, and that room is already full, so a
// `send` that waited for room would wait forever.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}sent 1{{$}}
// CHECK-NEXT: {{^}}given back 2{{$}}

import core::mem;
import std::sync::channel;

fn try_send(tx : &Sender<i64>, v : i64) -> void {
  match tx.send(v) {
    Result<void, SendError<i64>>::Ok() => {
      println!("sent {}", v);
    }
    Result<void, SendError<i64>>::Err(e) => {
      println!("given back {}", e.value);
    }
  }
}

fn main() -> i32 {
  let (tx, rx) = channel<i64>(1);
  try_send(&tx, 1);
  drop(rx);
  try_send(&tx, 2);
  return 0;
}
