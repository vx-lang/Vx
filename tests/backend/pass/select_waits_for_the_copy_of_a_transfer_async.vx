//===----------------------------------------------------------------------===//
// `t.copy_end()` gives a source of `select` that is ready when the copy of the `transfer_async`
// with the token `t` ended. It borrows the token, so `t.wait()` still gives the tensor after it.
//
// Only a GPU copies in the background. CI has no GPU, so each copy here ended when
// `transfer_async` returned, and each `copy_end` is ready at once. A wrong source would let the
// 5-second deadline or the channel win.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}gpu: select3 gave 1, the copy{{$}}
// CHECK-NEXT: {{^}}host: select2 gave 0, the copy{{$}}
// CHECK-NEXT: {{^}}turned off: select2 gave 1, the deadline{{$}}
// CHECK-NEXT: {{^}}wait gave 4 and 13{{$}}

import core::result;
import core::time;
import std::sync::channel;
import std::sync::select;
import std::time;

fn filled(v : f32) -> Tensor<f32, [4]> {
  let mut t = unsafe { Tensor<f32, [4]>::uninit() };
  for i in 0..4 {
    t[i] = v + i as f32;
  }
  return t;
}

/// The index that a `select` gave, or -1 for a cancel.
fn index(r : Result<i32, SelectError>) -> i32 {
  match r {
    Result<i32, SelectError>::Ok(i) => {
      return i;
    }
    Result<i32, SelectError>::Err(_) => {
      return -1;
    }
  }
}

fn main() -> i32 {
  let (_tx, rx) = channel<i64>(1);
  let limit = Deadline::after(Duration::from_secs(5));
  let on_gpu = transfer_async(filled(1.0), Memory::GPU_HBM);
  println!("gpu: select3 gave {}, the copy", index(select3(&rx, &on_gpu.copy_end(), &limit)));
  let on_host = transfer_async(filled(10.0), Memory::CPU_DRAM);
  println!("host: select2 gave {}, the copy", index(select2(&on_host.copy_end(), &limit)));
  let soon = Deadline::after(Duration::from_millis(100));
  let end = on_gpu.copy_end();
  println!("turned off: select2 gave {}, the deadline", index(select2(&when(false, &end), &soon)));
  let a = transfer(on_gpu.wait(), Memory::CPU_DRAM);
  let b = on_host.wait();
  println!("wait gave {} and {}", a[3], b[3]);
  return 0;
}
