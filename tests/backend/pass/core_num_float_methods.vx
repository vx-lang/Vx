//===----------------------------------------------------------------------===//
// `mul_add`, `hypot`, `rem_euclid`, `div_euclid`, `powi`, `max`, `min` and `clamp` on the
// floats.
//
// `0.1.mul_add(10.0, -1.0)` is not zero: 0.1 is a little above a tenth, and one rounding
// keeps that, where `0.1 * 10.0 - 1.0` rounds it away. `hypot` of 3 and 4 times 2^1000 would
// overflow if it squared first. The Euclidean pair is asked every sign combination.
// `powi` with the smallest `i32` would overflow a plain negation. `max` and `min` ignore a
// NaN on either side.
//
// EXPECT: 6.5 0.00000000000000005551115123125783 0 | 5  0 inf | 1 3 1 3 | -2 -1 2 1 | 1024 0.25 -27 1 0 | 2 1 1 1 3 1 | 1 0 0.5 1 | 0.000000014901161 5 0.125 2
import core::num;

fn main() -> i32 {
  let zero : f64 = 0.0;
  let nan : f64 = zero / zero;
  let infinity : f64 = 1.0 / zero;
  let tenth : f64 = 0.1;
  let two : f64 = 2.0;
  print(two.mul_add(3.0, 0.5));
  print!(" ");
  print(tenth.mul_add(10.0, -1.0));
  print!(" ");
  print(tenth * 10.0 - 1.0);
  print!(" | ");

  let three : f64 = 3.0;
  let scale : f64 = two.powi(1000);
  let huge : f64 = -3.0 * scale;
  print(three.hypot(4.0));
  print!(" ");
  print(huge.hypot(4.0 * scale));
  print!(" ");
  print(zero.hypot(0.0));
  print!(" ");
  print(infinity.hypot(nan));
  print!(" | ");

  let seven : f64 = 7.0;
  let minus_seven : f64 = -7.0;
  print(minus_seven.rem_euclid(4.0));
  print!(" ");
  print(seven.rem_euclid(-4.0));
  print!(" ");
  print(minus_seven.rem_euclid(-4.0));
  print!(" ");
  print(seven.rem_euclid(4.0));
  print!(" | ");
  print(minus_seven.div_euclid(4.0));
  print!(" ");
  print(seven.div_euclid(-4.0));
  print!(" ");
  print(minus_seven.div_euclid(-4.0));
  print!(" ");
  print(seven.div_euclid(4.0));
  print!(" | ");

  let minus_three : f64 = -3.0;
  let one_and_a_half : f64 = 1.5;
  print(two.powi(10));
  print!(" ");
  print(two.powi(-2));
  print!(" ");
  print(minus_three.powi(3));
  print!(" ");
  print(one_and_a_half.powi(0));
  print!(" ");
  print(two.powi(-2147483647 - 1));
  print!(" | ");

  let one : f64 = 1.0;
  print(one.max(2.0));
  print!(" ");
  print(nan.max(1.0));
  print!(" ");
  print(one.max(nan));
  print!(" ");
  print(one.min(2.0));
  print!(" ");
  print(nan.min(3.0));
  print!(" ");
  print(one.min(nan));
  print!(" | ");

  let five : f64 = 5.0;
  let minus_one : f64 = -1.0;
  let half : f64 = 0.5;
  print(five.clamp(0.0, 1.0));
  print!(" ");
  print(minus_one.clamp(0.0, 1.0));
  print!(" ");
  print(half.clamp(0.0, 1.0));
  print!(" ");
  print(nan.clamp(0.0, 1.0).is_nan() as i32);
  print!(" | ");

  let zero32 : f32 = 0.0;
  let tenth32 : f32 = 0.1;
  let three32 : f32 = 3.0;
  let two32 : f32 = 2.0;
  print(tenth32.mul_add(10.0, -1.0));
  print!(" ");
  print(three32.hypot(4.0));
  print!(" ");
  print(two32.powi(-3));
  print!(" ");
  print((zero32 / zero32).max(2.0));
  return 0;
}
