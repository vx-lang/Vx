//===----------------------------------------------------------------------===//
// A `u128` literal from 2^63 to 2^64 - 1 has zeroes in its top 64 bits. It used to be
// sign-extended, so 2^64 - 1 became 2^128 - 1.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s

fn main() -> i32 {
  let max64 : u128 = 18446744073709551615;
  print!((max64 >> 64) as u64);
  print!("
");
  // CHECK: {{^}}0{{$}}
  let two : u128 = 2;
  print!(((two * max64) >> 64) as u64);
  print!("
");
  // CHECK-NEXT: {{^}}1{{$}}
  let low : u128 = 9223372036854775808;
  print!((low >> 63) as u64);
  print!("
");
  // CHECK-NEXT: {{^}}1{{$}}
  return 0;
}
