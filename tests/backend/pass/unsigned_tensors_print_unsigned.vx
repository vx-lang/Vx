// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
//
// A tensor of `u32` or `u64` prints its elements as unsigned numbers, in the same layout as
// any other tensor. MLIR has no unsigned integers, so they used to print as signed: 4000000000
// as -294967296. A signed tensor prints as before.

fn main() -> i32 {
  let mut a = Tensor<u32, [2, 2]>::new();
  a[0][0] = 4000000000;
  a[0][1] = 1;
  a[1][0] = 2;
  a[1][1] = 3;
  print(a);
  // CHECK: rank = 2 offset = 0 sizes = [2, 2] strides = [2, 1] data =
  // CHECK-NEXT: {{^}}{{\[\[}}4000000000,   1],
  // CHECK-NEXT: {{^}} [2,   3]]
  let mut b = Tensor<u64, [3]>::new();
  b[0] = 18000000000000000000;
  b[1] = 7;
  b[2] = 0;
  print(b);
  // CHECK: rank = 1 offset = 0 sizes = [3] strides = [1] data =
  // CHECK-NEXT: {{^}}[18000000000000000000,  7,  0]
  let mut one = Tensor<u32, [1, 2]>::new();
  one[0][0] = 3000000000;
  one[0][1] = 5;
  print(one);
  // CHECK: sizes = [1, 2]
  // CHECK-NEXT: {{^}}{{\[\[}}3000000000,   5]]
  let mut s = Tensor<i32, [3]>::new();
  s[0] = -5;
  s[1] = 10;
  s[2] = 200;
  print(s);
  // CHECK: sizes = [3]
  // CHECK-NEXT: {{^}}[-5,  10,  200]
  return 0;
}
