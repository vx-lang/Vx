//===----------------------------------------------------------------------===//
// A number literal takes the type around it: in an array literal, the type of the other
// elements, and in `Tensor<T, ..>::fill`, the element type `T`. A typed value of another
// type is converted with `as`.
//
// EXPECT: 1 2.25 -3 -1.5 0.5 -4 2.25 2.25

fn main() -> i32 {
  let d : f64 = 2.25;
  let l : i64 = 8;
  let a = [1.0, d];
  let b = [l, 2, -3];
  let c = [-1.5, d];
  let t = Tensor<f64, [2]>::fill(0.5);
  let u = Tensor<i64, [2]>::fill(-4);
  let v = Tensor<f64, [2]>::fill(d);
  let w = Tensor<f32, [2]>::fill(d as f32);
  print(a[0]);
  print(" ");
  print(a[1]);
  print(" ");
  print(b[2]);
  print(" ");
  print(c[0]);
  print(" ");
  print(t[1]);
  print(" ");
  print(u[0]);
  print(" ");
  print(v[1]);
  print(" ");
  print(w[0]);
  return 0;
}
