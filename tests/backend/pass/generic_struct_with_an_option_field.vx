//===----------------------------------------------------------------------===//
// A generic struct with an `Option<T>` field, the shape an iterator adaptor like `Peekable`
// needs. Built at three element types, passed to and returned from functions, with the field
// read, assigned, and used through `&self` and `&mut self`. The flat code generator used to
// refuse the struct, so the whole program went to the AST path.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --check-prefix=VALUES
// CHECK-NOT: flat-codegen

import core::option;

struct Peek<T> {
  count : i32,
  peeked : Option<T>,
}

impl<T> Peek<T> {
  fn has_value(self : &Peek<T>) -> i32 {
    if self.peeked.is_some() {
      return 1;
    }
    return 0;
  }

  fn clear(self : &mut Peek<T>) -> void {
    self.peeked = Option<T>::None();
  }
}

fn make(v : f64) -> Peek<f64> {
  return Peek<f64> {
    count: 1, peeked: Option<f64>::Some(v)
  };
}

fn peeked_or(p : Peek<f64>, d : f64) -> f64 {
  return p.peeked.unwrap_or(d);
}

fn main() -> i32 {
  let a = Peek<i32> {
    count: 3, peeked: Option<i32>::Some(9)
  };
  print!("read: ");
  print(a.count);
  print!(" ");
  print(a.peeked.unwrap());
  print!("
");
  // CHECK: {{^}}read: 3 9{{$}}
  // VALUES: {{^}}read: 3 9{{$}}

  print!("passed and returned: ");
  print(peeked_or(make(2.5), 0.0));
  print!(" ");
  let b = Peek<i8> {
    count: 4, peeked: Option<i8>::Some(-4i8)
  };
  print(b.peeked.unwrap());
  print!(" ");
  print(b.count);
  print!("
");
  // CHECK-NEXT: {{^}}passed and returned: 2.5 -4 4{{$}}
  // VALUES-NEXT: {{^}}passed and returned: 2.5 -4 4{{$}}

  let mut c = Peek<i32> {
    count: 5, peeked: Option<i32>::None()
  };
  print!("assigned: ");
  print(c.has_value());
  c.peeked = Option<i32>::Some(7);
  print!(" ");
  print(c.peeked.unwrap());
  print!("
");
  // CHECK-NEXT: {{^}}assigned: 0 7{{$}}
  // VALUES-NEXT: {{^}}assigned: 0 7{{$}}

  let mut d = Peek<i64> {
    count: 6, peeked: Option<i64>::Some(8i64)
  };
  print!("methods: ");
  print(d.has_value());
  d.clear();
  print!(" ");
  print(d.has_value());
  print!(" ");
  print(d.count);
  print!("
");
  // CHECK-NEXT: {{^}}methods: 1 0 6{{$}}
  // VALUES-NEXT: {{^}}methods: 1 0 6{{$}}
  return 0;
}
