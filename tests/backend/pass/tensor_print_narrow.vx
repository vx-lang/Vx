//===----------------------------------------------------------------------===//
// Printing a tensor of the narrow integers: i8, u8, i16, u16. Before this was
// covered, such a program stopped with `ParseType("Unsupported MLIR element
// type in: memref<?x?xi8>")` -- an internal message from the element-type
// mapping in codegen, which knew seven types and not these six.
//
// Two printers were needed, and they are not the same kind of thing:
//
//   - `printMemrefI16` is MLIR's. It prints numbers, so the shipped shim only
//     supplies the plain name MLIR does not export (`runtime/vx_mlir_shims.c`).
//   - `printMemrefI8` could not be. MLIR exports an I8 printer, and it prints
//     each element as a CHARACTER: a tensor holding 100 prints as `d`. That is
//     measured, and not what `print(t)` means here, where a scalar `i8` prints
//     as a number (`scalar_print_narrow.vx`). So the byte printer is Vx's own,
//     in the same file.
//
// The values stay inside the signed range of each type. Printing a value above
// it reads as the signed counterpart -- a `u8` of 200 prints as -56, the way a
// `u32` tensor prints today -- and that is recorded in the shim rather than
// pinned here, so making unsigned tensors honest does not have to fight a test.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @printMemrefI8(memref<*xi8>)
// CHECK-DAG: func.func private @printMemrefI16(memref<*xi16>)
// CHECK-LABEL: func.func @main() -> i32
// The shape is a hole: the AST path emits a dynamic `memref<?x?xi8>` and the
// flat path the static `memref<2x2xi8>`, and this file has to hold for the one
// the RUN line reaches (the harness runs it with `--legacy-codegen`, the AST
// path). What it asserts is the element type on both sides of the cast.
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi8> to memref<*xi8>
// CHECK: call @printMemrefI8(%{{.*}}) : (memref<*xi8>) -> ()
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi8> to memref<*xi8>
// CHECK: call @printMemrefI8(%{{.*}}) : (memref<*xi8>) -> ()
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi16> to memref<*xi16>
// CHECK: call @printMemrefI16(%{{.*}}) : (memref<*xi16>) -> ()
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi16> to memref<*xi16>
// CHECK: call @printMemrefI16(%{{.*}}) : (memref<*xi16>) -> ()
fn main() -> i32 {
  let mut bytes = Tensor<i8, [2, 2]>::uninit();
  bytes[0][0] = 7;
  bytes[0][1] = -3;
  bytes[1][0] = 100;
  bytes[1][1] = -128;
  print(bytes);

  let mut ubytes = Tensor<u8, [2, 2]>::uninit();
  ubytes[0][0] = 7;
  ubytes[0][1] = 100;
  ubytes[1][0] = 3;
  ubytes[1][1] = 120;
  print(ubytes);

  let mut shorts = Tensor<i16, [2, 2]>::uninit();
  shorts[0][0] = 300;
  shorts[0][1] = -3;
  shorts[1][0] = 100;
  shorts[1][1] = -32768;
  print(shorts);

  let mut ushorts = Tensor<u16, [2, 2]>::uninit();
  ushorts[0][0] = 300;
  ushorts[0][1] = 120;
  ushorts[1][0] = 100;
  ushorts[1][1] = 5;
  print(ushorts);

  return 0;
}

// The byte lines are Vx's own printer, so their spacing is pinned. The short
// ones come from MLIR, which pads columns to a common width: the holes keep this
// from going red if that padding changes, without letting the values slide.
// EXPECT: [[7, -3], [100, -128]]
// EXPECT: [[7, 100], [3, 120]]
// EXPECT: [[300,{{.*}}-3]
// EXPECT: [100,{{.*}}-32768]]
// EXPECT: [[300,{{.*}}120]
// EXPECT: [100,{{.*}}5]]
