//===----------------------------------------------------------------------===//
// Printing a tensor of the narrow integers: i8, u8, i16, u16. Each type needs a
// `printMemref*` helper, which is what the CHECK lines below assert.
//
// `printMemrefI16` is MLIR's. `printMemrefI8` is Vx's own
// (`runtime/vx_mlir_shims.c`), because MLIR's I8 printer prints each element as
// a character: a tensor holding 100 prints as `d`, not as the number a scalar
// `i8` prints as. `u8` and `u16` go through the unsigned printers, so a byte
// above 127 and a short above 32767 print as themselves. The OUT lines check
// that they all print in MLIR's layout.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: vxc %s --action run-jit 2>&1 | FileCheck %s --check-prefix=OUT
// CHECK-DAG: func.func private @printMemrefI8(memref<*xi8>)
// CHECK-DAG: func.func private @printMemrefU8(memref<*xi8>)
// CHECK-DAG: func.func private @printMemrefI16(memref<*xi16>)
// CHECK-DAG: func.func private @printMemrefU16(memref<*xi16>)
// CHECK-LABEL: func.func @main() -> i32
// The shape is a hole: the AST path emits a dynamic `memref<?x?xi8>` and the flat
// path the static `memref<2x2xi8>`. The RUN line reaches the flat path, so the CHECK
// lines assert only the element type on both sides of the cast.
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi8> to memref<*xi8>
// CHECK: call @printMemrefI8(%{{.*}}) : (memref<*xi8>) -> ()
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi8> to memref<*xi8>
// CHECK: call @printMemrefU8(%{{.*}}) : (memref<*xi8>) -> ()
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi16> to memref<*xi16>
// CHECK: call @printMemrefI16(%{{.*}}) : (memref<*xi16>) -> ()
// CHECK: memref.cast %{{.*}} : memref<{{.*}}xi16> to memref<*xi16>
// CHECK: call @printMemrefU16(%{{.*}}) : (memref<*xi16>) -> ()
fn main() -> i32 {
  let mut bytes = unsafe { Tensor<i8, [2, 2]>::uninit() };
  bytes[0][0] = 7;
  bytes[0][1] = -3;
  bytes[1][0] = 100;
  bytes[1][1] = -128;
  print(bytes);

  let mut ubytes = unsafe { Tensor<u8, [2, 2]>::uninit() };
  ubytes[0][0] = 7;
  ubytes[0][1] = 200;
  ubytes[1][0] = 3;
  ubytes[1][1] = 120;
  print(ubytes);

  let mut shorts = unsafe { Tensor<i16, [2, 2]>::uninit() };
  shorts[0][0] = 300;
  shorts[0][1] = -3;
  shorts[1][0] = 100;
  shorts[1][1] = -32768;
  print(shorts);

  let mut ushorts = unsafe { Tensor<u16, [2, 2]>::uninit() };
  ushorts[0][0] = 300;
  ushorts[0][1] = 40000;
  ushorts[1][0] = 100;
  ushorts[1][1] = 5;
  print(ushorts);

  return 0;
}

// All four print in MLIR's layout: one row per line, and a row after the first
// indented by one space per level of nesting. `OUT-NEXT` is what makes the line
// break part of the check -- a substring of one long line would satisfy an EXPECT
// line just as well. `u8` and `u16` go through `printMemrefU8` and
// `printMemrefU16`, so 200 and 40000 print as themselves, not as -56 and -25536.
// OUT: Unranked Memref base@ = 0x{{[0-9a-f]+}} rank = 2 offset = 0 sizes = [2, 2] strides = [2, 1] data =
// OUT-NEXT: 7, -3],
// OUT-NEXT: 100, -128]]
// OUT: Unranked Memref base@ = 0x{{[0-9a-f]+}} rank = 2 offset = 0 sizes = [2, 2] strides = [2, 1] data =
// OUT-NEXT: 7, 200],
// OUT-NEXT: 3, 120]]
// OUT: Unranked Memref base@ = 0x{{[0-9a-f]+}} rank = 2 offset = 0 sizes = [2, 2] strides = [2, 1] data =
// OUT-NEXT: 300, -3],
// OUT-NEXT: 100, -32768]]
// OUT: Unranked Memref base@ = 0x{{[0-9a-f]+}} rank = 2 offset = 0 sizes = [2, 2] strides = [2, 1] data =
// OUT-NEXT: 300, 40000],
// OUT-NEXT: 100, 5]]

// The EXPECT lines are the flat code generator's check: it runs this program too
// (flat_corpus_sweep), but it does not run the RUN lines.
// EXPECT: [[7,   -3],
// EXPECT: [100,   -128]]
// EXPECT: [[7,   200],
// EXPECT: [3,   120]]
// EXPECT: [[300,   -3],
// EXPECT: [100,   -32768]]
// EXPECT: [[300,   40000],
// EXPECT: [100,   5]]
