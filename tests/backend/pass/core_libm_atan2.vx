import core::num;

fn bits(r : f32) -> u32 {
  if r != r {
    return 2143289344u32;
  }
  return r.to_bits();
}

fn check(y : u32, x : u32) -> i32 {
  print(bits(f32::from_bits(y).atan2(f32::from_bits(x))));
  print!(" ");
  return 0;
}

