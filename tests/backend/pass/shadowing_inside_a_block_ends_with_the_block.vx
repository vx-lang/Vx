//===----------------------------------------------------------------------===//
// A `let` inside a block hides an outer variable of the same name only until the block ends.
// The compiler used to keep using the inner value after the block, and crashed.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s

fn main() -> i32 {
  let y = 42;
  if true {
    let y = 1;
    print!("inside: ");
    print!(y);
    print!("
");
  }
  print!("after: ");
  print!(y);
  print!("
");
  // CHECK: {{^}}inside: 1{{$}}
  // CHECK-NEXT: {{^}}after: 42{{$}}

  // The same in a loop body, with a different type inside.
  let mut i = 0;
  while i < 2 {
    let y = 2.5;
    i = i + 1;
  }
  print!("after loop: ");
  print!(y);
  print!("
");
  // CHECK-NEXT: {{^}}after loop: 42{{$}}
  return 0;
}
