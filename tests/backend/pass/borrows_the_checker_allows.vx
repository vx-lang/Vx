//===----------------------------------------------------------------------===//
// Borrows the borrow checker must accept, each with the value it computes. A borrow ends at
// its last use, not at the end of its block, so the variable can be used again after it.
// Two `&` borrows can be alive together, and so can `&mut` borrows of different fields.
// A reborrow `&mut *m` can be used, and then `m` again. `v.push(v.len())` reads `v`
// before the call borrows it. A moved variable can be given a new value and used, and a
// number is copied rather than moved.
//
// EXPECT: 2 3 5 3 3 5 7 2 2 2 1
import std::vec;

struct S {
  v : i64,
}

struct Pair {
  a : i64,
  b : i64,
}

fn take(s : S) -> i64 {
  return s.v;
}

fn bump(p : &mut i64) -> i32 {
  *p = *p + 1i64;
  return 0;
}

fn read_after_the_last_mutable_use() -> i64 {
  let mut x : i64 = 1i64;
  let m = &mut x;
  *m = 2i64;
  return x;
}

fn mutable_after_the_last_shared_use() -> i64 {
  let mut x : i64 = 1i64;
  let r = &x;
  let seen = *r;
  let m = &mut x;
  *m = seen + 2i64;
  return x;
}

fn borrow_inside_a_block(n : i32) -> i64 {
  let mut x : i64 = 1i64;
  if n > 0 {
    let m = &mut x;
    *m = 5i64;
  }
  return x;
}

fn borrow_on_each_iteration() -> i64 {
  let mut x : i64 = 0i64;
  let mut i = 0;
  while i < 3 {
    let m = &mut x;
    *m = *m + 1i64;
    i = i + 1;
  }
  return x;
}

fn mutable_borrow_passed_twice() -> i64 {
  let mut x : i64 = 1i64;
  bump(&mut x);
  bump(&mut x);
  return x;
}

fn reborrow_then_the_original() -> i64 {
  let mut x : i64 = 1i64;
  let m = &mut x;
  let r = &mut *m;
  *r = 4i64;
  *m = *m + 1i64;
  return x;
}

fn different_fields_at_once() -> i64 {
  let mut p = Pair {
    a : 1i64, b : 2i64
  };
  let x = &mut p.a;
  let y = &mut p.b;
  *x = 3i64;
  *y = 4i64;
  return p.a + p.b;
}

fn two_shared_borrows() -> i64 {
  let x : i64 = 1i64;
  let a = &x;
  let b = &x;
  return *a + *b;
}

fn moved_then_given_a_new_value() -> i64 {
  let mut a = S {
    v : 1i64
  };
  take(a);
  a = S {
    v : 2i64
  };
  return a.v;
}

fn number_is_copied() -> i64 {
  let a : i64 = 1i64;
  let b = a;
  return a + b;
}

fn push_its_own_length() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(7);
  v.push(v.len());
  return v.get(1);
}

fn main() -> i32 {
  print(read_after_the_last_mutable_use());
  print!(" ");
  print(mutable_after_the_last_shared_use());
  print!(" ");
  print(borrow_inside_a_block(1));
  print!(" ");
  print(borrow_on_each_iteration());
  print!(" ");
  print(mutable_borrow_passed_twice());
  print!(" ");
  print(reborrow_then_the_original());
  print!(" ");
  print(different_fields_at_once());
  print!(" ");
  print(two_shared_borrows());
  print!(" ");
  print(moved_then_given_a_new_value());
  print!(" ");
  print(number_is_copied());
  print!(" ");
  print(push_its_own_length());
  return 0;
}
