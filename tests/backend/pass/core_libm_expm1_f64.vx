//===----------------------------------------------------------------------===//
// f64 `exp_m1`, ported from LLVM libc's `expm1` into `core::libm`, against LLVM libc itself
// (f475f085bf7b, built with FMA). It prints the bits of `x.exp_m1()` (a NaN as 9221120237041090560)
// for four inputs that need the double-double pass and four that need the 128-bit pass, all from
// LLVM libc's own tests; then for special values and the edges of the range; then hashes of 2^20
// random bit patterns and of 2^20 random x from 2^-63 to 2^11 in size. The port also matched LLVM
// libc on 2^30 inputs of the second kind, and on 2^26 more with the faster passes turned off.
//
// EXPECT: 4546848307188942476 4548275098695344776 13769830496411113944 13830554455654793215 4387743423026835453 4403333987010373115 4546459091831858661 5293506108198288308 0 9223372036854775808 4610417272575012563 13827240892226439268 4336966441157787648 13560338478012563456 1 9218868437227405312 9218868437227405312 13830554455654793216 9221120237041090560 9221120237041090560 9218868437227405098 9218868437227405312 13830554455654793215 13830554455654793216 238690780250636288 9326954828284297216 1244318629130686251 1245543454594568620
import core::num;

fn bits(r : f64) -> u64 {
  if r != r {
    return 9221120237041090560u64;
  }
  return r.to_bits();
}

fn check(x : u64) -> i32 {
  print(bits(f64::from_bits(x).exp_m1()));
  print!(" ");
  return 0;
}

/// x from 2^-63 to 2^(count - 64) in size, either sign.
fn ranged(s : u64, count : u64) -> u64 {
  return (s & 9227875636482146303u64) | ((960u64 + ((s >> 52u64) & 2047u64) % count) << 52u64);
}

fn hash(kind : i32, count : i32) -> u64 {
  let mut s : u64 = 88172645463325252u64;
  let mut h : u64 = 0u64;
  for i in 0..count {
    s = s ^ (s << 13u64);
    s = s ^ (s >> 7u64);
    s = s ^ (s << 17u64);
    let mut r : f64 = 0.0;
    if kind == 0 {
      r = f64::from_bits(s).exp_m1();
    } else {
      r = f64::from_bits(ranged(s, 75u64)).exp_m1();
    }
    h = (h ^ bits(r)).wrapping_mul(1099511628211u64);
  }
  return h;
}

fn main() -> i32 {
  let _r0 = check(4546847953987671821u64);
  let _r1 = check(4548274592107732940u64);
  let _r2 = check(13769830812539119405u64);
  let _r3 = check(13853836650999914717u64);
  let _r4 = check(4387743423026835446u64);
  let _r5 = check(4403333987010373018u64);
  let _r6 = check(4546458775684343597u64);
  let _r7 = check(4637137751970150436u64);
  let _r8 = check(0u64);
  let _r9 = check(9223372036854775808u64);
  let _r10 = check(4607182418800017408u64);
  let _r11 = check(13830554455654793216u64);
  let _r12 = check(4336966441157787648u64);
  let _r13 = check(13560338478012563456u64);
  let _r14 = check(1u64);
  let _r15 = check(9218868437227405311u64);
  let _r16 = check(9218868437227405312u64);
  let _r17 = check(18442240474082181120u64);
  let _r18 = check(9221120237041090560u64);
  let _r19 = check(18444492273895866368u64);
  let _r20 = check(4649454530587146735u64);
  let _r21 = check(4649454530587146736u64);
  let _r22 = check(13853836650999914721u64);
  let _r23 = check(13853836650999914722u64);
  let _r24 = check(238690780250636288u64);
  let _r25 = check(9326954828284297216u64);
  print(hash(0, 1048576));
  print!(" ");
  print(hash(1, 1048576));
  return 0;
}
