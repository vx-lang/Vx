// `*p as i64` is `(*p) as i64`, so the pointer is loaded before the cast.
//
// EXPECT: 7
fn main() -> i32 {
  let x : i32 = 7;
  let p = &x;
  let y : i64 = *p as i64;
  println!(y);
  return 0;
}
