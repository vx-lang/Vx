//===----------------------------------------------------------------------===//
// `cycle`, which repeats an iterator's items by restarting from a clone of it.
//
//   0120120   0..3 cycled, the first seven items
//   23423     a range with two items already taken restarts from where it was cycled, as in
//             Rust, so only 2 3 4 repeat
//   102010    a `map` over a cycled range
//   1         the 100th item of 0..3 cycled, counting from zero
//   1         a cycled empty range has no items
import core::iter;

fn main() -> i32 {
  for x in range(0i64, 3i64).cycle().take(7i64) {
    print(x);
  }
  print!(" ");
  let mut r = range(0i64, 5i64);
  r.next();
  r.next();
  for x in r.cycle().take(5i64) {
    print(x);
  }
  print!(" ");
  // Built outside the loop header: there, `map` on any adaptor fails the closure check.
  let tens = range(1i64, 3i64).cycle().map(| v : i64 | v * 10i64).take(3i64);
  for x in tens {
    print(x);
  }
  print!(" ");
  let mut far = range(0i64, 3i64).cycle();
  print(far.nth(100i64).unwrap());
  print!(" ");
  let mut empty = range(0i64, 0i64).cycle();
  if empty.next().is_none() {
    print(1);
  }
  return 0;
}

// EXPECT: 0120120 23423 102010 1 1
