//===----------------------------------------------------------------------===//
// This file imports `calls_a_method_of_its_importer`, which imports this file back. So the
// compiler reads this file twice: once as the program, and once as an import. It finds the impl
// below twice. The two are one impl, so a call of `doubled` is not a call that two impls
// define.
//
// The RUN lines name this file with its full path and the package with a short path, so the
// two copies do not have the same file name.
//
// RUN: vxc --package tests=tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests %s -j 2 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
import tests::modules::calls_a_method_of_its_importer;

extern impl i64 {
  pub fn doubled(self : &i64) -> i64 {
    return *self * 2i64;
  }
}

fn main() -> i32 {
  let x = 4i64;
  // `doubled` gives 8, and `tripled` gives 12.
  // CHECK: 20
  print(x.doubled() + tripled(x));
  return 0;
}

// EXPECT: 20
