// `to_be`, `to_le`, `from_be` and `from_le` at every width, on a little-endian target.
//
// `to_be` and `from_be` swap the bytes. `to_le` and `from_le` give the value back.
// Each width gets its smallest value, its largest value and a pattern whose bytes are
// 1, 2, 3 and so on up to the width. The pattern is the one case where swapping and not
// swapping give different answers at the unsigned widths, whose smallest and largest
// values read the same in both byte orders.
import core::num;

fn show_i8(x : i8) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_i16(x : i16) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_i32(x : i32) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_i64(x : i64) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_u8(x : u8) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_u16(x : u16) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_u32(x : u32) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn show_u64(x : u64) -> i32 {
  print!("to_be=");
  print(x.to_be());
  print!(" to_le=");
  print(x.to_le());
  print!(" from_be=");
  print(x.from_be());
  print!(" from_le=");
  print(x.from_le());
  print!("; ");
  return 0;
}

fn main() -> i32 {
  print!("i8 min: ");
  let i8_min : i8 = -127 - 1;
  show_i8(i8_min);
  print!("i8 max: ");
  let i8_max : i8 = 127;
  show_i8(i8_max);
  print!("i8 pattern: ");
  let i8_pattern : i8 = 1;
  show_i8(i8_pattern);
  print!("i16 min: ");
  let i16_min : i16 = -32767 - 1;
  show_i16(i16_min);
  print!("i16 max: ");
  let i16_max : i16 = 32767;
  show_i16(i16_max);
  print!("i16 pattern: ");
  let i16_pattern : i16 = 258;
  show_i16(i16_pattern);
  print!("i32 min: ");
  let i32_min : i32 = -2147483647 - 1;
  show_i32(i32_min);
  print!("i32 max: ");
  let i32_max : i32 = 2147483647;
  show_i32(i32_max);
  print!("i32 pattern: ");
  let i32_pattern : i32 = 16909060;
  show_i32(i32_pattern);
  print!("i64 min: ");
  let i64_min : i64 = -9223372036854775807 - 1;
  show_i64(i64_min);
  print!("i64 max: ");
  let i64_max : i64 = 9223372036854775807;
  show_i64(i64_max);
  print!("i64 pattern: ");
  let i64_pattern : i64 = 72623859790382856;
  show_i64(i64_pattern);
  print!("u8 min: ");
  let u8_min : u8 = 0;
  show_u8(u8_min);
  print!("u8 max: ");
  let u8_max : u8 = 255;
  show_u8(u8_max);
  print!("u8 pattern: ");
  let u8_pattern : u8 = 1;
  show_u8(u8_pattern);
  print!("u16 min: ");
  let u16_min : u16 = 0;
  show_u16(u16_min);
  print!("u16 max: ");
  let u16_max : u16 = 65535;
  show_u16(u16_max);
  print!("u16 pattern: ");
  let u16_pattern : u16 = 258;
  show_u16(u16_pattern);
  print!("u32 min: ");
  let u32_min : u32 = 0;
  show_u32(u32_min);
  print!("u32 max: ");
  let u32_max : u32 = 4294967295;
  show_u32(u32_max);
  print!("u32 pattern: ");
  let u32_pattern : u32 = 16909060;
  show_u32(u32_pattern);
  print!("u64 min: ");
  let u64_min : u64 = 0;
  show_u64(u64_min);
  print!("u64 max: ");
  let u64_max : u64 = 18446744073709551615;
  show_u64(u64_max);
  print!("u64 pattern: ");
  let u64_pattern : u64 = 72623859790382856;
  show_u64(u64_pattern);
  return 0;
}

// EXPECT: i8 min: to_be=-128 to_le=-128 from_be=-128 from_le=-128; i8 max: to_be=127 to_le=127 from_be=127 from_le=127; i8 pattern: to_be=1 to_le=1 from_be=1 from_le=1;
// EXPECT: i16 min: to_be=128 to_le=-32768 from_be=128 from_le=-32768; i16 max: to_be=-129 to_le=32767 from_be=-129 from_le=32767; i16 pattern: to_be=513 to_le=258 from_be=513 from_le=258;
// EXPECT: i32 min: to_be=128 to_le=-2147483648 from_be=128 from_le=-2147483648; i32 max: to_be=-129 to_le=2147483647 from_be=-129 from_le=2147483647; i32 pattern: to_be=67305985 to_le=16909060 from_be=67305985 from_le=16909060;
// EXPECT: i64 min: to_be=128 to_le=-9223372036854775808 from_be=128 from_le=-9223372036854775808; i64 max: to_be=-129 to_le=9223372036854775807 from_be=-129 from_le=9223372036854775807; i64 pattern: to_be=578437695752307201 to_le=72623859790382856 from_be=578437695752307201 from_le=72623859790382856;
// EXPECT: u8 min: to_be=0 to_le=0 from_be=0 from_le=0; u8 max: to_be=255 to_le=255 from_be=255 from_le=255; u8 pattern: to_be=1 to_le=1 from_be=1 from_le=1;
// EXPECT: u16 min: to_be=0 to_le=0 from_be=0 from_le=0; u16 max: to_be=65535 to_le=65535 from_be=65535 from_le=65535; u16 pattern: to_be=513 to_le=258 from_be=513 from_le=258;
// EXPECT: u32 min: to_be=0 to_le=0 from_be=0 from_le=0; u32 max: to_be=4294967295 to_le=4294967295 from_be=4294967295 from_le=4294967295; u32 pattern: to_be=67305985 to_le=16909060 from_be=67305985 from_le=16909060;
// EXPECT: u64 min: to_be=0 to_le=0 from_be=0 from_le=0; u64 max: to_be=18446744073709551615 to_le=18446744073709551615 from_be=18446744073709551615 from_le=18446744073709551615; u64 pattern: to_be=578437695752307201 to_le=72623859790382856 from_be=578437695752307201 from_le=72623859790382856;
