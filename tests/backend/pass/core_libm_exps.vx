import core::num;

fn bits(r : f32) -> u32 {
  if r != r {
    return 2143289344u32;
  }
  return r.to_bits();
}

fn check(input : u32) -> i32 {
  let x = f32::from_bits(input);
  print(bits(x.exp()));
  print!(" ");
  print(bits(x.exp2()));
  print!(" ");
  print(bits(x.exp_m1()));
  print!(" ");
  return 0;
}

