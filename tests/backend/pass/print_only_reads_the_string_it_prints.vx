//===----------------------------------------------------------------------===//
// `println!` and `print!` only read a `String` that is a variable, a field, `*r` or `v[i]`,
// so a program can print it again. `main` drops `v` and `n` once each, and `show` drops nothing.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK-COUNT-7: call @vx_string_as_c_str(
// CHECK-NOT: call @vx_string_as_c_str(
// CHECK: call @Vec$String$drop$String(
// CHECK-NOT: drop
// CHECK: call @String$drop(
// CHECK-NOT: drop
// CHECK: return
// CHECK-LABEL: func.func @show(
// CHECK-COUNT-2: call @vx_string_as_c_str(
// CHECK-NOT: drop
// CHECK: return
import std::string;
import std::vec;

struct Named {
  name : String,
}

fn show(r : &String) -> i32 {
  println!("through a reference {}", *r);
  println!("again through a reference {}", *r);
  return 0;
}

fn main() -> i32 {
  let mut s = String::new();
  unsafe { s.push_c_str("hi"); }
  print!("first ");
  print!(s);
  println!("");
  println!("second {}", s);
  println!("third {}", s);
  let n = Named {
    name: s
  };
  println!("field {}", n.name);
  println!("again {}", n.name);
  show(&n.name);
  let mut w = String::new();
  unsafe { w.push_c_str("yo"); }
  let mut v : Vec<String> = Vec::new();
  v.push(w);
  println!("element {}", v[0]);
  println!("again element {}", v[0]);
  return 0;
}

// EXPECT: first hi
// EXPECT: second hi
// EXPECT: third hi
// EXPECT: field hi
// EXPECT: again hi
// EXPECT: through a reference hi
// EXPECT: again through a reference hi
// EXPECT: element yo
// EXPECT: again element yo
