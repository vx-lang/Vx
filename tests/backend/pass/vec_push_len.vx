//===----------------------------------------------------------------------===//
// Regression for #205: `Vec::push`'s `self.len = self.len + 1` (a field
// assignment on a monomorphized generic through `&mut self`) must persist.
// Before the fix every push wrote to index 0 and `len` stayed 0.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @vx_vec_grow(
// CHECK-DAG: func.func private @vx_googletest_expect_eq_i32(
// CHECK-DAG: func.func private @vx_vec_bounds_check(
// CHECK-LABEL: func.func @Vec$i32$push$i32(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: call @vx_vec_grow(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, i64, i64, i64) -> !llvm.ptr
// CHECK-LABEL: func.func @Vec$i32$len$i32(%arg0: !llvm.ptr) -> i32
// CHECK: %[[V0:.*]] = llvm.getelementptr %{{.*}}, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<"Vec", (ptr, i32, i32)>
// CHECK: %[[V1:.*]] = llvm.load %[[V0]] : !llvm.ptr -> i32
// CHECK: return %[[V1]] : i32
// CHECK-LABEL: func.func @i32$expect_eq(%arg0: i32, %arg1: i32) -> i32
// CHECK: call @vx_googletest_expect_eq_i32(%{{.*}}, %{{.*}}) : (i32, i32) -> i32
// CHECK-LABEL: func.func @expect_eq$i32(%arg0: i32, %arg1: i32) -> i32
// CHECK: call @i32$expect_eq(%{{.*}}, %{{.*}}) : (i32, i32) -> i32
// CHECK-LABEL: func.func @Vec$i32$get$i32(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: call @vx_vec_bounds_check(%{{.*}}, %{{.*}}) : (i64, i64) -> i32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: %[[V0:.*]] = call @Vec$i32$len$i32(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @expect_eq$i32(%[[V0]], %{{.*}}) : (i32, i32) -> i32
// CHECK: %[[V1:.*]] = call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @expect_eq$i32(%[[V1]], %{{.*}}) : (i32, i32) -> i32
// CHECK: %[[V2:.*]] = call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @expect_eq$i32(%[[V2]], %{{.*}}) : (i32, i32) -> i32
import std::vec;
import std::googletest;

fn main() -> i32 {
  let mut v: Vec<i32> = Vec<i32>::new();
  v.push(10);
  v.push(20);
  v.push(30);
  expect_eq(v.len(), 3);
  expect_eq(v.get(0), 10);
  expect_eq(v.get(2), 30);
  return 0;
}
