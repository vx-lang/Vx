// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
// EXPECT: Unranked Memref base@ =
// REQUIRES: macos
// EXPECT: rank = 2 offset = 0 sizes = [4, 4] strides = [4, 1] data =
// EXPECT: [[1,   2,   0,   0],
// EXPECT:  [3,   4,   0,   0],
// EXPECT:  [0,   0,   0,   0],
// EXPECT:  [0,   0,   0,   0]]
// EXPECT: Unranked Memref base@ =
// EXPECT: rank = 2 offset = 0 sizes = [4, 4] strides = [4, 1] data =
// EXPECT: [[10,   20,   0,   0],
// EXPECT:  [30,   40,   0,   0],
// EXPECT:  [0,   0,   0,   0],
// EXPECT:  [0,   0,   0,   0]]

fn main() -> Pinned<Tensor<i32, [ 4, 4 ]>, Topology::NPU[0]> {
  let mut a = Tensor<i32>([ 4, 4 ]);
  let mut b = Tensor<i32>([ 4, 4 ]);

  a[0][0] = 1;
  a[0][1] = 2;
  a[1][0] = 3;
  a[1][1] = 4;

  let mut a_npu = transfer(a, Memory::NPU_HBM);
  let mut b_npu = transfer(b, Memory::NPU_HBM);

  spawn on(Topology::NPU[0]) {
    b_npu[0][0] = a_npu[0][0] * 10;
    b_npu[0][1] = a_npu[0][1] * 10;
    b_npu[1][0] = a_npu[1][0] * 10;
    b_npu[1][1] = a_npu[1][1] * 10;
  };

  print(&a_npu);
  print(&b_npu);
  return b_npu;
}
// NO_EXEC

