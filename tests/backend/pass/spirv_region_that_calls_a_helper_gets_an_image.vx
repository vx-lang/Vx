//===----------------------------------------------------------------------===//
// A placed region passes two tensors to a helper. The SPIR-V image inlines the
// helper into the kernel, so the region gets an image. The loop of the helper
// counts in `index`, which the image gives the type `i64`.
// tests/integration_test/spirv_images_on_pocl.rs runs the image on the CPU with
// pocl and compares the output with this one.
//
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s --implicit-check-not=Warning # flat-codegen
// CHECK: @vx_npu_kernel_0_str("vx_npu_kernel_0\00{{.*}}format=spirv
// EXPECT: [1,  1,  1,  1]

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached, scope: device
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 63 GB/s
}

fn add_one(a: &Tensor<f32, [4], Memory::DEV_HBM>, o: &mut Tensor<f32, [4], Memory::DEV_HBM>) on Topology::Dev -> f32 {
  for i in 0..4 {
    o[i] = a[i] + 1.0;
  }
  return o[0];
}

fn main() -> i32 {
  let mut a_h = unsafe { Tensor<f32, [4]>::uninit() };
  let mut o_h = unsafe { Tensor<f32, [4]>::uninit() };
  for i in 0..4 {
    a_h[i] = 0.0;
    o_h[i] = 0.0;
  }
  let d = transfer(a_h, Memory::DEV_HBM);
  let mut o = transfer(o_h, Memory::DEV_HBM);

  spawn on(Topology::Dev) {
    add_one(&d, &mut o);
  }

  let back = transfer(o, Memory::CPU_DRAM);
  print(back);
  return 0;
}
