//===----------------------------------------------------------------------===//
// `transfer_async(x, M)` starts a copy and gives a token. `.wait()` takes the token and gives
// the placed tensor. Two copies can be in flight at the same time. On the CPU the copy is done
// when it starts, so the wait only gives the tensor. A copy to the memory that holds the data
// already gets W1022.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}first 4, second 10{{$}}
// CHECK-NEXT: {{^}}at once 21{{$}}

fn filled(v : f32) -> Tensor<f32, [4]> {
  let mut t = unsafe { Tensor<f32, [4]>::uninit() };
  for i in 0..4 {
    t[i] = v + i as f32;
  }
  return t;
}

fn main() -> i32 {
  let first = transfer_async(filled(1.0), Memory::CPU_DRAM);
  let second = transfer_async(filled(10.0), Memory::CPU_DRAM);
  let x = first.wait();
  let y = second.wait();
  println!("first {}, second {}", x[3], y[0]);
  let z = transfer_async(filled(20.0), Memory::CPU_DRAM).wait();
  println!("at once {}", z[1]);
  return 0;
}
