// #278: a nested reference (`&&i32`). `let rr = &r` takes the address of the
// reference-holding local `r`, and `**rr` derefs twice. AST codegen used to
// return `r`'s *value* for `&r` (so `rr` aliased `r`'s pointee); `**rr` then
// loaded a pointer out of an `i32` slot and the program segfaulted. `BorrowExpr`
// now materializes a slot for the reference before taking its address, so `rr`
// is a real `&&i32`. This is the AST-path oracle for `flat_runs_a_nested_reference`.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
fn main() -> i32 {
  let x = 5;
  let r = &x;    // r  : &i32
  let rr = &r;   // rr : &&i32  (address of the reference-holding local `r`)
  print(**rr);   // load `r`'s pointer, then the i32 -> 5
  return 0;
}

// EXPECT: 5
