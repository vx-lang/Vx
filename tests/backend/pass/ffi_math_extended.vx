// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// main calls each function in order; the assertion is that the chain survives to codegen
// rather than being folded away.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @f64$sin(%{{.*}}) : (f64) -> f64
// CHECK: call @f64$abs(%[[V0]]) : (f64) -> f64
// CHECK: %[[V1:.*]] = call @f64$cos(%{{.*}}) : (f64) -> f64
// CHECK: call @f64$abs(%[[V1]]) : (f64) -> f64
// CHECK: call @f64$asin(%{{.*}}) : (f64) -> f64
// CHECK: call @f64$log2(%{{.*}}) : (f64) -> f64
// CHECK: call @f64$log10(%{{.*}}) : (f64) -> f64
import std::math;

import std::io;
extern {
  // We can also define a helper to print f64 if we want, but for now we'll do
  // simple return checks.
}

fn main() -> i32 {
  let pi_f64 : f64 = 3.1415926535;
  let half_pi_f64 : f64 = 1.5707963267;

  // sin(pi/2) approx 1.0
  let s64 : f64 = half_pi_f64.sin();
  let s64_abs : f64 = s64.abs();

  // cos(pi) approx -1.0
  let c64 : f64 = pi_f64.cos();
  let c64_abs : f64 = c64.abs();

  // Check asin(1.0) approx 1.57079
  let one_f64 : f64 = 1.0;
  let asin_val : f64 = one_f64.asin();

  // Check log2(4.0) approx 2.0
  let four_f64 : f64 = 4.0;
  let l2 : f64 = four_f64.log2();

  // Check log10(100.0) approx 2.0
  let hundred_f64 : f64 = 100.0;
  let l10 : f64 = hundred_f64.log10();

  // Instead of nested ifs which might break codegen, we can just do sum checks
  let sum : f64 = s64_abs + c64_abs + l2 + l10; // ~ 1.0 + 1.0 + 2.0 + 2.0 = 6.0
  let mut ret : i32 = 1;

  if sum > 5.9 {
    ret = 0;
  }

  // Ensure all FFI math bindings we added work
  return ret;
}

// EXPECT:
