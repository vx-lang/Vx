// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The libc file entry points are declared, and main threads one handle from fopen through
// fputs to fclose. Pointers are opaque `!llvm.ptr`, so nothing here names a pointee type.
// CHECK: func.func private @fopen(!llvm.ptr, !llvm.ptr) -> !llvm.ptr
// CHECK: func.func private @fputs(!llvm.ptr, !llvm.ptr) -> i32
// CHECK: func.func private @fclose(!llvm.ptr) -> i32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[NAME:.*]] = llvm.mlir.addressof @".str.0" : !llvm.ptr
// CHECK: %[[PATH:.*]] = call @vx_get_temp_file(%[[NAME]]) : (!llvm.ptr) -> !llvm.ptr
// CHECK: %[[MODE:.*]] = llvm.mlir.addressof @".str.1" : !llvm.ptr
// CHECK: %[[FH:.*]] = call @fopen(%[[PATH]], %[[MODE]]) : (!llvm.ptr, !llvm.ptr) -> !llvm.ptr
// CHECK: %[[TEXT:.*]] = llvm.mlir.addressof @".str.2" : !llvm.ptr
// CHECK: call @fputs(%[[TEXT]], %[[FH]]) : (!llvm.ptr, !llvm.ptr) -> i32
// CHECK: call @fclose(%[[FH]]) : (!llvm.ptr) -> i32
// CHECK: call @remove(%[[PATH]]) : (!llvm.ptr) -> i32
import std::io;
extern {
  fn fopen(filename : *const i8, mode : *const i8) -> *mut i8;
  fn fputs(s : *const i8, stream : *mut i8) -> i32;
  fn fclose(stream : *mut i8) -> i32;
  fn remove(filename : *const i8) -> i32;
  fn vx_get_temp_file(filename : *const i8) -> *mut i8;
  fn vx_free_temp_file(ptr : *mut i8) -> i32;
}

fn main() -> i32 {
  unsafe {
    let path_buf : *mut i8 = vx_get_temp_file("test_output.txt");

    let f : *mut i8 = fopen(path_buf, "w");
    fputs("Hello, File I/O from Vx!
", f);
    fclose(f);
    remove(path_buf);

    vx_free_temp_file(path_buf);

    print!("Done: ");
    print!(0);
  }
  return 0;
}

