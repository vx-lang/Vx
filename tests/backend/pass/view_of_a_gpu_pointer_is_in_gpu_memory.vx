//===----------------------------------------------------------------------===//
// `tensor_view_2d` over a pointer into GPU memory gives a tensor in GPU memory,
// so code on the GPU can use the view with no copy.
//
// EXPECT: 4

fn main() -> i32 {
  let w = transfer(Tensor<f32, [2, 2]>::fill(1.0), Memory::GPU_HBM);
  let p : *mut f32 in Memory::GPU_HBM = w.as_mut_ptr();
  let wv : Tensor<f32, [2, 2], Memory::GPU_HBM> = unsafe {
    tensor_view_2d(p, 2, 2)
  };
  let x = transfer(Tensor<f32, [2, 1]>::fill(2.0), Memory::GPU_HBM);
  let mut y = unsafe { Tensor<f32, [2, 1], Memory::GPU_HBM>::uninit() };
  spawn on(Topology::GPU) {
    matmul_into(&mut y, &wv, &x);
  }
  let back = transfer(y, Memory::CPU_DRAM);
  print(back[0][0]);
  print!("\n");
  return 0;
}
