//===----------------------------------------------------------------------===//
// Each function has a `match` whose arms return, and each one is correct. A `match` on a number
// can end a function when it has a `_` arm or a name arm. With no such arm, the function needs
// code after the `match`, or it returns no value. The fail test is
// tests/frontend/fail/a_match_on_a_number_with_no_default_arm_can_end.vx.
//
// The last functions have an arm that never reaches its end, in a way that the compiler does
// not see. The compiler must not report such an arm.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error

enum Light {
  Red,
  Green,
}

struct Failure {
  code : i32,
}

impl Failure {
  fn stop(self : &Failure) -> ! {
    println!("stop {}", self.code);
    abort();
  }
}

const SHORT : bool = true;

fn with_a_default_arm(x : i32) -> i32 {
  match x {
    0 => {
      return 1;
    }
    _ => {
      return 9;
    }
  }
}

fn with_a_name_arm(x : i32) -> i32 {
  match x {
    0 => {
      return 1;
    }
    n => {
      return n + 100;
    }
  }
}

fn a_return_after_the_match(x : i32) -> i32 {
  match x {
    0 => {
      return 1;
    }
    1 => {
      return 2;
    }
  }
  return 3;
}

// The `if` does not return on every path: for a number with no arm, the last `return` runs.
fn a_return_after_an_if(x : i32, c : bool) -> i32 {
  if c {
    match x {
      0 => {
        return 1;
      }
      1 => {
        return 2;
      }
    }
  } else {
    return 5;
  }
  return 9;
}

fn returns_no_value(x : i32) -> void {
  match x {
    0 => {
      println!("zero");
      return;
    }
    1 => {
      return;
    }
  }
}

fn on_a_bool(b : bool) -> i32 {
  match b {
    true => {
      return 1;
    }
    false => {
      return 2;
    }
  }
}

fn on_an_enum(l : Light) -> i32 {
  match l {
    Light::Red => {
      return 1;
    }
    Light::Green => {
      return 2;
    }
  }
}

fn a_default_arm_that_stops(x : i32) -> i32 {
  match x {
    0 => {
      return 1;
    }
    _ => {
      panic("no arm for this number");
    }
  }
}

// The arm for 0 ends in a `match` with a `_` arm, so no path reaches the end of the function.
fn a_match_in_an_arm(x : i32, y : i32) -> i32 {
  match x {
    0 => {
      match y {
        0 => {
          return 1;
        }
        _ => {
          return 2;
        }
      }
    }
    _ => {
      return 5;
    }
  }
}

// The arm for 0 leaves the loop or starts its next turn, so it does not reach the end of the
// `match`.
fn an_arm_that_leaves_a_loop(x : i32) -> i32 {
  let mut turns : i32 = 0;
  loop {
    turns = turns + 1;
    return match x {
      0 => {
        if turns > 2 {
          break;
        } else {
          continue;
        }
      }
      _ => {
        return 7;
      }
    };
  }
  return 40 + turns;
}

// The `if` in the arm for 0 is a statement. Each of its branches leaves the loop or starts its
// next turn, so the arm does not reach the end of the `match` here either.
fn an_if_statement_that_leaves_a_loop(x : i32) -> i32 {
  let mut turns : i32 = 0;
  loop {
    turns = turns + 1;
    return match x {
      0 => {
        if turns > 2 {
          break;
        } else {
          continue;
        };
      }
      _ => {
        return 7;
      }
    };
  }
  return 40 + turns;
}

// A `match` with no `_` arm is a statement in the arm for 0, and a `return` comes after it.
fn a_return_after_a_match_in_an_arm(x : i32, y : i32) -> i32 {
  match x {
    0 => {
      match y {
        0 => {
          return 1;
        }
        1 => {
          return 2;
        }
      };
      return 3;
    }
    _ => {
      return 5;
    }
  }
}

fn an_arm_that_calls_a_method_that_never_returns(x : i32, f : &Failure) -> i32 {
  match x {
    0 => {
      return 1;
    }
    _ => {
      f.stop();
    }
  }
}

// The inner `match` has no `_` arm, but the call after it never returns.
fn a_match_and_then_a_method_that_never_returns(x : i32, y : i32, f : &Failure) -> i32 {
  match x {
    0 => {
      match y {
        0 => {
          return 1;
        }
      };
      f.stop();
    }
    _ => {
      return 5;
    }
  }
}

fn an_arm_with_a_while_true_loop(x : i32) -> i32 {
  match x {
    0 => {
      return 1;
    }
    _ => {
      let mut i = x;
      while true {
        i = i - 1;
        if i <= 0 {
          return 50;
        }
      }
    }
  }
}

// The compiler keeps one branch of an `if comptime` and leaves the other empty.
fn an_arm_with_an_if_comptime(x : i32) -> i32 {
  match x {
    0 => {
      if comptime SHORT {
        return 1;
      } else {
        return 2;
      }
    }
    _ => {
      return 5;
    }
  }
}

fn main() -> i32 {
  // CHECK: {{^}}default arm: 1 9{{$}}
  println!("default arm: {} {}", with_a_default_arm(0), with_a_default_arm(5));
  // CHECK-NEXT: {{^}}name arm: 1 105{{$}}
  println!("name arm: {} {}", with_a_name_arm(0), with_a_name_arm(5));
  // CHECK-NEXT: {{^}}return after the match: 1 2 3{{$}}
  println!("return after the match: {} {} {}", a_return_after_the_match(0), a_return_after_the_match(1), a_return_after_the_match(5));
  // CHECK-NEXT: {{^}}return after an if: 2 9 5{{$}}
  println!("return after an if: {} {} {}", a_return_after_an_if(1, true), a_return_after_an_if(5, true), a_return_after_an_if(5, false));
  // CHECK-NEXT: {{^}}zero{{$}}
  returns_no_value(0);
  returns_no_value(1);
  returns_no_value(5);
  // CHECK-NEXT: {{^}}bool and enum: 1 2 1 2{{$}}
  println!("bool and enum: {} {} {} {}", on_a_bool(true), on_a_bool(false), on_an_enum(Light::Red), on_an_enum(Light::Green));
  // CHECK-NEXT: {{^}}arm that stops: 1{{$}}
  println!("arm that stops: {}", a_default_arm_that_stops(0));
  // CHECK-NEXT: {{^}}match in an arm: 1 2 5{{$}}
  println!("match in an arm: {} {} {}", a_match_in_an_arm(0, 0), a_match_in_an_arm(0, 5), a_match_in_an_arm(5, 0));
  // CHECK-NEXT: {{^}}arm that leaves a loop: 43 7{{$}}
  println!("arm that leaves a loop: {} {}", an_arm_that_leaves_a_loop(0), an_arm_that_leaves_a_loop(1));
  // CHECK-NEXT: {{^}}if statement that leaves a loop: 43 7{{$}}
  println!("if statement that leaves a loop: {} {}", an_if_statement_that_leaves_a_loop(0), an_if_statement_that_leaves_a_loop(1));
  // CHECK-NEXT: {{^}}return after a match in an arm: 1 2 3 5{{$}}
  println!("return after a match in an arm: {} {} {} {}", a_return_after_a_match_in_an_arm(0, 0), a_return_after_a_match_in_an_arm(0, 1), a_return_after_a_match_in_an_arm(0, 5), a_return_after_a_match_in_an_arm(5, 0));
  let failure = Failure {
    code: 3
  };
  // CHECK-NEXT: {{^}}arms that the compiler does not follow: 1 1 5 1 50 1 5{{$}}
  println!("arms that the compiler does not follow: {} {} {} {} {} {} {}", an_arm_that_calls_a_method_that_never_returns(0, &failure), a_match_and_then_a_method_that_never_returns(0, 0, &failure), a_match_and_then_a_method_that_never_returns(5, 0, &failure), an_arm_with_a_while_true_loop(0), an_arm_with_a_while_true_loop(3), an_arm_with_an_if_comptime(0), an_arm_with_an_if_comptime(5));
  return 0;
}
