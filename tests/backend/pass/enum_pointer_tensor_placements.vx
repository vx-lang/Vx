//===----------------------------------------------------------------------===//
// Compile functions whose enum parameters contain pointers to host or GPU tensors.
// Two functions use the same host tensor type.
// REQUIRES: flat-codegen
// EXPECT: 3

enum Opt<T> {
  Some(T), None
}
fn host_tensor_pointer(x: Opt<*const Tensor<f32, [4]>>) -> i32 {
  return 1;
}
fn gpu_tensor_pointer(x: Opt<*const Tensor<f32, [4], Memory::GPU_HBM>>) -> i32 {
  return 2;
}
fn repeated_host_tensor_pointer(x: Opt<*const Tensor<f32, [4]>>) -> i32 {
  return 1;
}
fn main() -> i32 {
  print(3); return 0;
}
