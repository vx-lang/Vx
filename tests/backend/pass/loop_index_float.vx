//===----------------------------------------------------------------------===//
// #186: a loop index used in a float expression used to fail LLVM translation
// with an unreconciled `builtin.unrealized_conversion_cast i64 to index`. The
// index (MLIR `index`) now converts to float via `index_cast` + `sitofp`
// instead of a bitcast fallback. Also guards a computed (non-literal) loop
// bound, the sibling case from the same issue.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_f32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
fn main() -> i32 {
  // Loop index converted explicitly to f32.
  print!("floats:");
  for i in 0..5 {
    let x : f32 = (i as f32) * 0.1;
    print!(" ");
    print(x);
  }

  // Loop index in a float expression via implicit coercion (float literal * i).
  print!(" scaled:");
  for i in 0..4 {
    let x : f32 = 1.5 * (i as f32);
    print!(" ");
    print(x);
  }

  // Computed (non-literal) loop bound.
  let n : i32 = 3;
  print!(" count:");
  for _ in 0..(n + 1) {
    print!(" x");
  }
  return 0;
}

// EXPECT: floats: 0 0.1 0.2 0.3 0.4
// EXPECT: scaled: 0 1.5 3 4.5
// EXPECT: count: x x x x
