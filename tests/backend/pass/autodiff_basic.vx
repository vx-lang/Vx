fn poly(x: f32) -> f32 {
    return x * x * x;
}

extern {
    fn __enzyme_autodiff_grad_poly(x: f32) -> f32;
}

fn main() -> f32 {
    let x = 2.0;
    // Expected derivative of x^3 is 3x^2. At x=2.0, this is 12.0
    let dx = grad(poly, x);
    // Since we mock the enzyme call, this just tests that the backend emits the right call without crashing
    return 0.0;
}
