// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[C0:.*]] = arith.cmpi sge, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
fn main() -> i32 {
  let mut i = 0;
  loop {
    i = i + 1;
    if i >= 5 {
      break;
    }
  }
  return i - 5;
}
