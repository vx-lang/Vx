//===----------------------------------------------------------------------===//
// A `let` can hold an operation on two rows of a tensor, with or without a type, and the code
// after it can index the result.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}with a type: 3.5 1.5{{$}}
// CHECK: {{^}}without a type: 2.5 0.75{{$}}

fn with_a_type() -> i32 {
  let mut o = Tensor<f32, [2, 2]>::new();
  o[0][0] = 2.0;
  o[1][0] = 1.5;
  o[0][1] = 3.0;
  o[1][1] = 1.5;
  let r : Tensor<f32, [2]> = o[0] + o[1];
  println!("with a type: {} {}", r[0], r[1] - 3.0);
  return 0;
}

fn without_a_type() -> i32 {
  let mut o = Tensor<f32, [2, 3]>::new();
  o[0][2] = 2.0;
  o[1][2] = 1.25;
  let product = o[0] * o[1];
  let difference = o[0] - o[1];
  println!("without a type: {} {}", product[2], difference[2]);
  return 0;
}

fn main() -> i32 {
  with_a_type();
  without_a_type();
  return 0;
}
