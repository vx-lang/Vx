// Regression for #206: `Topology` is usable as a first-class runtime value type.
// A bare `Topology` parses in type position (so `Vec<Topology>` works), and a
// `Topology::X` value lowers to its stable i32 dispatch id (arch::topology_
// dispatch_id: GPU=500, ANE=400, CPU=0), so topologies can be stored and read
// back. Placement uses (`Pinned`, `spawn on`) are unaffected — they carry the
// topology in the type/statement, not through a value.
// RUN: vxc %s --action run-jit
import std::vec;
import std::io;

fn main() -> i32 {
  let mut v = Vec<Topology>::new();
  v.push(Topology::GPU);
  v.push(Topology::ANE);
  v.push(Topology::CPU);

  print!(v.get(0));   // 500
  print!("
");
  print!(v.get(1));   // 400
  print!("
");

  let t : Topology = Topology::GPU;
  if t == Topology::GPU {
    print!("gpu-match
");
  }
  return 0;
}

// EXPECT: 500
// EXPECT: 400
// EXPECT: gpu-match
