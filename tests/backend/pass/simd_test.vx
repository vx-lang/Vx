// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// `<N x T>` is a value of its own: N lanes of T in one register, lowered to `vector<NxT>`.
// It is not a T, and a T is not one lane of it -- the checker used to admit both directions
// so that `let v : <4 x f32> = *p;` could stand in for a vector load, which is the
// type-directed deref the design rejects. A load is spelled by the pointer's type, so this
// fixture holds only what the type itself is; the load/add/store form returns when
// `*mut align(4) <4 x f32>` exists.
//
// CHECK-DAG lines, not ordered ones: the two paths emit the functions in opposite orders, and
// the point of this fixture is that both spell the type the same way.
//
// CHECK-DAG: func.func @identity(%arg0: vector<4xf32>) -> vector<4xf32>
// CHECK-DAG: func.func @wider(%arg0: vector<8xf32>) -> vector<8xf32>
// CHECK-DAG: func.func @half(%arg0: vector<4xf16>) -> vector<4xf16>
// CHECK-DAG: func.func @ints(%arg0: vector<16xi8>) -> vector<16xi8>
// CHECK-DAG: func.func @main() -> i32

fn identity(v : <4 x f32>) -> <4 x f32> {
  return v;
}

// A different lane count is a different type, so the two never share an identity.
fn wider(v : <8 x f32>) -> <8 x f32> {
  return v;
}

// A different element likewise.
fn half(v : <4 x f16>) -> <4 x f16> {
  return v;
}

fn ints(v : <16 x i8>) -> <16 x i8> {
  return v;
}

fn main() -> i32 {
  return 0;
}
