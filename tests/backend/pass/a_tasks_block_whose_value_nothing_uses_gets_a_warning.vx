//===----------------------------------------------------------------------===//
// A `tasks` block that can fail, whose value nothing uses, gets a warning. When it fails, the code
// after it goes on. A block whose value a `let` takes, also `let _`, gets no warning, and neither
// does a block that cannot fail.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Warning --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Warning --implicit-check-not=Error

import core::result;

fn half(x : i32) -> Result<i32, i32> {
  if x % 2 == 0 {
    return Result<i32, i32>::Ok(x / 2);
  }
  return Result<i32, i32>::Err(x);
}

// CHECK: Warning[W1038] at {{.*}}.vx:[[@LINE+3]]:3: this `tasks` block can fail, but nothing uses its value, a 'Result<i32, i32>'. When the block fails, the code after it goes on, and nothing sees the error. Use the value, as in `let r = tasks { .. };`
fn failed_join(x : i32) -> i32 {
  let mut seen = 0;
  tasks {
    let h = spawn {
      Result<i32, i32>::Ok(half(x)? + 1)
    };
    seen = h.join();
    Result<i32, i32>::Ok(seen)
  };
  return seen;
}

// CHECK: Warning[W1038] at {{.*}}.vx:[[@LINE+3]]:3: this `tasks` block can fail
fn question_mark(x : i32) -> i32 {
  let mut seen = 0;
  tasks {
    seen = half(x)? + 1;
    Result<i32, i32>::Ok(seen)
  };
  return seen;
}

// CHECK: Warning[W1038] at {{.*}}.vx:[[@LINE+4]]:5: this `tasks` block can fail
fn in_an_if(x : i32, go : bool) -> i32 {
  let mut seen = 0;
  if go {
    tasks {
      seen = half(x)? + 1;
      Result<i32, i32>::Ok(seen)
    }
  }
  return seen;
}

fn used(x : i32) -> i32 {
  let r = tasks {
    let h = spawn {
      Result<i32, i32>::Ok(half(x)? + 1)
    };
    let v = h.join();
    Result<i32, i32>::Ok(v)
  };
  match r {
    Result<i32, i32>::Ok(v) => {
      return v;
    }
    Result<i32, i32>::Err(e) => {
      return -e;
    }
  }
}

fn underscore(x : i32) -> i32 {
  let mut seen = 0;
  let _ = tasks {
    let h = spawn {
      Result<i32, i32>::Ok(half(x)? + 1)
    };
    seen = h.join();
    Result<i32, i32>::Ok(seen)
  };
  return seen;
}

fn cannot_fail(x : i32) -> i32 {
  let mut seen = 0;
  tasks {
    let h = spawn {
      x + 1
    };
    seen = h.join();
    seen
  };
  return seen;
}

fn main() -> i32 {
  // CHECK: {{^}}failed_join 5 0{{$}}
  println!("failed_join {} {}", failed_join(8), failed_join(7));
  // CHECK-NEXT: {{^}}question_mark 5 0{{$}}
  println!("question_mark {} {}", question_mark(8), question_mark(7));
  // CHECK-NEXT: {{^}}in_an_if 5 0{{$}}
  println!("in_an_if {} {}", in_an_if(8, true), in_an_if(7, true));
  // CHECK-NEXT: {{^}}used 5 -7{{$}}
  println!("used {} {}", used(8), used(7));
  // CHECK-NEXT: {{^}}underscore 5 0{{$}}
  println!("underscore {} {}", underscore(8), underscore(7));
  // CHECK-NEXT: {{^}}cannot_fail 2{{$}}
  println!("cannot_fail {}", cannot_fail(1));
  return 0;
}
