//
//===----------------------------------------------------------------------===//
// `.map_err(|c : i64| AddError::NotADigit(c))` gives a `Result<i64, AddError>`, although the
// closure does not write its return type. A `?` on that value passes the `AddError` up to a
// function, to a `tasks` block and to a task that each give a `Result<_, AddError>`.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}function: ok 5{{$}}
// CHECK-NEXT: {{^}}function: not a digit 12{{$}}
// CHECK-NEXT: {{^}}tasks block: ok 5{{$}}
// CHECK-NEXT: {{^}}tasks block: not a digit 12{{$}}
// CHECK-NEXT: {{^}}task: ok 5{{$}}
// CHECK-NEXT: {{^}}task: not a digit 12{{$}}

import core::result;

enum AddError {
  NotADigit(i64),
}

fn digit(c : i64) -> Result<i64, i64> {
  if c >= 0 && c <= 9 {
    return Result<i64, i64>::Ok(c);
  }
  return Result<i64, i64>::Err(c);
}

fn in_a_function(c : i64) -> Result<i64, AddError> {
  let r = digit(c).map_err(|c : i64| AddError::NotADigit(c));
  let t = r?;
  return Result<i64, AddError>::Ok(t + 1);
}

fn in_a_tasks_block(c : i64) -> Result<i64, AddError> {
  let r = tasks {
    let t = digit(c).map_err(|c : i64| AddError::NotADigit(c))?;
    Result<i64, AddError>::Ok(t + 1)
  };
  return r;
}

fn in_a_task(c : i64) -> Result<i64, AddError> {
  let r : Result<i64, AddError> = tasks {
    let h = spawn {
      let t = digit(c).map_err(|c : i64| AddError::NotADigit(c))?;
      Result<i64, AddError>::Ok(t + 1)
    };
    let v = h.join();
    Result<i64, AddError>::Ok(v)
  };
  return r;
}

fn show(name : *const i8, r : Result<i64, AddError>) -> void {
  match r {
    Result<i64, AddError>::Ok(v) => {
      println!("{}: ok {}", name, v);
    }
    Result<i64, AddError>::Err(e) => {
      match e {
        AddError::NotADigit(c) => {
          println!("{}: not a digit {}", name, c);
        }
      }
    }
  }
}

fn main() -> i32 {
  show("function", in_a_function(4));
  show("function", in_a_function(12));
  show("tasks block", in_a_tasks_block(4));
  show("tasks block", in_a_tasks_block(12));
  show("task", in_a_task(4));
  show("task", in_a_task(12));
  return 0;
}
