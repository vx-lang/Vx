//===----------------------------------------------------------------------===//
// A `match` on an i64, a u8, an i16 and a u64, as a value and as a statement. An arm is a
// literal with the type of the subject, or with no suffix, or a name that binds the subject.
// Both code generators compile each function and give the same values.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: i64: 10 11 12 13
// CHECK: u8: 20 21 22
// CHECK: i16: 30 31 35
// CHECK: u64: 40 41

fn name_of_i64(n : i64) -> i32 {
  return match n {
    0 => {
      10
    }
    5 => {
      11
    }
    5000000000i64 => {
      12
    }
    _ => {
      13
    }
  };
}

fn name_of_u8(b : u8) -> i32 {
  return match b {
    0u8 => {
      20
    }
    255 => {
      21
    }
    _ => {
      22
    }
  };
}

fn name_of_i16(s : i16) -> i32 {
  let mut r = 0;
  match s {
    1 => {
      r = 30;
    }
    7i16 => {
      r = 31;
    }
    other => {
      r = 32 + (other as i32);
    }
  }
  return r;
}

fn name_of_u64(u : u64) -> i32 {
  return match u {
    1u64 => {
      40
    }
    _ => {
      41
    }
  };
}

fn main() -> i32 {
  println!("i64: {} {} {} {}", name_of_i64(0), name_of_i64(5), name_of_i64(5000000000i64), name_of_i64(705032704));
  println!("u8: {} {} {}", name_of_u8(0u8), name_of_u8(255u8), name_of_u8(7u8));
  println!("i16: {} {} {}", name_of_i16(1i16), name_of_i16(7i16), name_of_i16(3i16));
  println!("u64: {} {}", name_of_u64(1u64), name_of_u64(2u64));
  return 0;
}
