// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

import tests::modules::iter;

fn test_for_loop() -> i64 {
  let mut sum : i64 = 0;
  for i in 0i64..10 {
    sum += i;
  }
  return sum;
}

fn main() -> i32 {
  return 0;
}

// The for loop lowers to an affine loop. The loop variable is the loop's index, cast to
// i64, and the sum lives in a stack slot.
// CHECK-LABEL: func.func @test_for_loop() -> i64 {
// CHECK: affine.for %[[I:.*]] = 0 to 10 {
// CHECK-NEXT: %[[X:.*]] = arith.index_cast %[[I]] : index to i64
// CHECK-NEXT: %[[S:.*]] = memref.load %[[SUM:[a-z0-9_]+]][] : memref<i64>
// CHECK-NEXT: %[[NEWSUM:.*]] = arith.addi %[[S]], %[[X]] : i64
// CHECK-NEXT: memref.store %[[NEWSUM]], %[[SUM]][] : memref<i64>
// CHECK-NEXT: }
// CHECK: return %{{.*}} : i64
