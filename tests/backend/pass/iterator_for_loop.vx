// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

import tests::modules::iter;

fn test_for_loop() -> i64 {
  let mut sum : i64 = 0;
  for i in 0..10 {
    sum += i;
  }
  return sum;
}

fn main() -> i32 {
  return 0;
}

// CHECK: module
// CHECK:   func.func @test_for_loop() -> i64
// CHECK:     scf.for
// CHECK:   }
// CHECK: }
