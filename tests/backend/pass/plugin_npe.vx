// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_alloc_f32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @vx_alloc_f32(%{{.*}}) : (i32) -> !llvm.ptr
// CHECK: call @vx_alloc_f32(%{{.*}}) : (i32) -> !llvm.ptr
// CHECK: call @vx_alloc_f32(%{{.*}}) : (i32) -> !llvm.ptr
extern {
  fn vx_alloc_f32(num_elements : i32)->*mut f32;
}

fn main() -> i32 {
  unsafe {
    let n : i32 = 128;
    let d : i32 = 64;
    let xout : *mut f32 = vx_alloc_f32(d);
    let x : *mut f32 = vx_alloc_f32(n);
    let w : *mut f32 = vx_alloc_f32(n * d);

    // Use ANE topology to trigger the hardware plugin dispatch via spawn on
    spawn on(Topology::ANE) {
      // Note: Since this is just a dummy dispatch test,
      // the generated call to vx_plugin_dispatch_async_flat is what matters.
    }
  }
  return 0;
}
// NO_EXEC
