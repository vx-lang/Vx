//===----------------------------------------------------------------------===//
// `&`, `|` and `^` on integers and on `bool`.
//
// The precedence between the three is the part worth testing carefully, because a
// single expression cannot say it. Vx follows Rust: `&` binds tightest, then `^`, then
// `|`. Each pair needs a spelling on which the two possible orders disagree, and most
// spellings are not one -- 1 ^ 2 | 4 is 7 under either reading, and 0 | 3 & 2 is 2
// under either. These three do disagree:
//
//   3 ^ 1 | 2   is 2 with `^` tighter and 0 with `|` tighter
//   1 ^ 3 & 2   is 3 with `&` tighter and 2 with `^` tighter
//   1 | 3 & 2   is 3 with `&` tighter and 2 with `|` tighter
//
// The last two entries fix the operators against their neighbours in the wider table:
// `&` is looser than `+`, so 6 & 3 + 1 is 6 & 4 rather than 2 + 1, and tighter than
// `==`, so 1 & 3 == 1 compares 1 against 1 rather than anding with a `bool`.
//
// `takes_ref(&v) & 6` is here because `&` had one meaning before this and now has two.
// A prefix `&` is a borrow and an infix `&` is this operator, and the file would still
// pass if the parser confused them only in some other position -- so the borrow appears
// as a call argument on the left of a bitwise `&`, which is where they are adjacent.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: arith.andi
// CHECK-DAG: arith.ori
// CHECK-DAG: arith.xori
fn takes_ref(x : &i32) -> i32 {
  return *x;
}

fn main() -> i32 {
  let a : i32 = 12;
  let b : i32 = 10;
  print(a & b);
  print!(" ");
  print(a | b);
  print!(" ");
  print(a ^ b);
  print!(" ");
  let p = true;
  let q = false;
  if p & q {
    print(1);
  } else {
    print(0);
  }
  print!(" ");
  if p | q {
    print(1);
  } else {
    print(0);
  }
  print!(" ");
  if p ^ q {
    print(1);
  } else {
    print(0);
  }
  print!(" ");
  print(3 ^ 1 | 2);
  print!(" ");
  print(1 ^ 3 & 2);
  print!(" ");
  print(1 | 3 & 2);
  print!(" ");
  print(6 & 3 + 1);
  print!(" ");
  if 1 & 3 == 1 {
    print(1);
  } else {
    print(0);
  }
  print!(" ");
  let v : i32 = 5;
  print(takes_ref(&v) & 6);
  return 0;
}

// EXPECT: 8 14 6 0 1 1 2 3 3 4 1 4
