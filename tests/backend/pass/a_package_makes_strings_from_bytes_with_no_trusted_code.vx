//===----------------------------------------------------------------------===//
// `String::from_utf8` and `String::from_bytes` are safe, so the package `tests` calls them with
// no `unsafe` block, and `--no-trusted-code tests` allows the program.
//
// RUN: vxc --package tests=tests --no-trusted-code tests %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=declined
// RUN: vxc --package tests=tests --no-trusted-code tests --legacy-codegen %s 2>&1 | FileCheck %s --implicit-check-not=Error
// "hi" is two bytes. The copy keeps a 0 byte, and an empty `Vec` gives "".
// CHECK: {{^}}length 2 3 0{{$}}
// 255 is never UTF-8. 195 starts a two-byte letter, so "h" and then a lone 195 is UTF-8 up to 1.
// CHECK: {{^}}first bad byte -1 2 1{{$}}
// CHECK: {{^}}first bytes [hi] [h] [] []{{$}}

import std::string;
import std::vec;
import tests::modules::a_package_that_makes_strings_from_bytes;

fn bytes(a : i32, b : i32, c : i32) -> Vec<u8> {
  let mut v = Vec<u8>::new();
  for x in [a, b, c] {
    if x >= 0 {
      v.push(x as u8);
    }
  }
  return v;
}

fn main() -> i32 {
  let hi = bytes(104, 105, -1);
  let zero_in_the_middle = bytes(104, 0, 105);
  let empty = bytes(-1, -1, -1);
  println!("length {} {} {}", length_of(&hi), length_of(&zero_in_the_middle), length_of(&empty));

  let ff = bytes(104, 105, 255);
  let cut_letter = bytes(104, 195, -1);
  println!("first bad byte {} {} {}", first_bad_byte(&hi), first_bad_byte(&ff), first_bad_byte(&cut_letter));

  let a = first_bytes(&hi, 2);
  let b = first_bytes(&hi, 1);
  let c = first_bytes(&hi, 3);
  let d = first_bytes(&cut_letter, 2);
  println!("first bytes [{}] [{}] [{}] [{}]", a, b, c, d);
  return 0;
}
