import core::num;

fn bits(r : f32) -> u32 {
  if r != r {
    return 2143289344u32;
  }
  return r.to_bits();
}

fn check(input : u32) -> i32 {
  let x = f32::from_bits(input);
  print(bits(x.ln()));
  print!(" ");
  print(bits(x.log2()));
  print!(" ");
  print(bits(x.log10()));
  print!(" ");
  print(bits(x.ln_1p()));
  print!(" ");
  return 0;
}

