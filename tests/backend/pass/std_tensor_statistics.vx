// `argmax`, `argmin`, `variance`, `std_dev` and `softmax_inplace` over 1-D tensors of f64,
// f32 and f16. The expected values were computed in Python. Softmax results are
// rounded to 6 decimal places, since `exp` may differ from Python's in the last digit.
//
// Each group of values: argmax and argmin of [1, 3, -2, 3, -2, 0.5] (ties keep the first
// index), its variance and standard deviation, then softmax of [1000, 1001, 1002], which
// overflows `exp` unless the largest element is subtracted first. Then: an empty tensor
// (no argmax, NaN variance) and [NaN, 2, NaN, -4] (NaN is skipped). Last, the variance and
// standard deviation of 1000 elements in f64 and f32, long enough for the vector loops: the
// elements come in pairs x and -x, so the mean is exactly 0 and every sum is exact. Then the
// f32 argmax and argmin of the same elements. Then an f32 softmax long enough for its vector
// `exp`: 40 elements around 100, one of them negative infinity (0 after softmax), printing four
// elements and the sum; and one holding a NaN, which makes every element NaN. Last, how many of
// 65536 values of that `exp` are more than 4 ulp from `f32::exp` (none).
//
// EXPECT: 1 2 4.201388888888888 2.049728979374807 0.090031 0.244728 0.665241 | 1 2 4.201389 2.0497289 0.090031 0.244728 0.665241 | 1 2 4.201389 2.0497289 | none NaN 1 3 | 53.217375 7.295023988994141 53.217377 7.295024 30 0 0.003959 0 0.017743 0.029254 1 NaN 0
import std::tensor;

fn print_index(index : Option<i32>) -> i32 {
  match index {
    Option<i32>::Some(i) => {
      print(i);
    }
    Option<i32>::None => {
      print!("none");
    }
  }
  print!(" ");
  return 0;
}

fn report_f64() -> i32 {
  let mut a = Tensor<f64>([6]);
  a[0] = 1.0;
  a[1] = 3.0;
  a[2] = -2.0;
  a[3] = 3.0;
  a[4] = -2.0;
  a[5] = 0.5;
  let _max = print_index(a.argmax());
  let _min = print_index(a.argmin());
  print(a.variance());
  print!(" ");
  print(a.std_dev());
  print!(" ");
  let mut s = Tensor<f64>([3]);
  for i in 0..3 {
    s[i] = 1000.0 + (i as f64);
  }
  let _done = s.softmax_inplace();
  for i in 0..3 {
    print((s[i] * 1000000.0).round() / 1000000.0);
    print!(" ");
  }
  return 0;
}

fn report_f32() -> i32 {
  let mut a = Tensor<f32>([6]);
  a[0] = 1.0;
  a[1] = 3.0;
  a[2] = -2.0;
  a[3] = 3.0;
  a[4] = -2.0;
  a[5] = 0.5;
  let _max = print_index(a.argmax());
  let _min = print_index(a.argmin());
  print(a.variance());
  print!(" ");
  print(a.std_dev());
  print!(" ");
  let mut s = Tensor<f32>([3]);
  for i in 0..3 {
    s[i] = 1000.0 + (i as f32);
  }
  let _done = s.softmax_inplace();
  for i in 0..3 {
    print(((s[i] as f64) * 1000000.0).round() / 1000000.0);
    print!(" ");
  }
  return 0;
}

// f16 computes in f32 and returns f32.
fn report_f16() -> i32 {
  let mut a = Tensor<f16>([6]);
  a[0] = 1.0 as f16;
  a[1] = 3.0 as f16;
  a[2] = -2.0 as f16;
  a[3] = 3.0 as f16;
  a[4] = -2.0 as f16;
  a[5] = 0.5 as f16;
  let _max = print_index(a.argmax());
  let _min = print_index(a.argmin());
  print(a.variance());
  print!(" ");
  print(a.std_dev());
  print!(" ");
  return 0;
}

fn report_edge_cases() -> i32 {
  let empty = Tensor<f64>([0]);
  let _none = print_index(empty.argmax());
  print(empty.variance());
  print!(" ");
  let mut b = Tensor<f64>([4]);
  let zero : f64 = 0.0;
  b[0] = zero / zero;
  b[1] = 2.0;
  b[2] = zero / zero;
  b[3] = -4.0;
  let _max = print_index(b.argmax());
  print(b.argmin().unwrap());
  return 0;
}

fn report_long() -> i32 {
  let mut a = Tensor<f64>([1000]);
  let mut b = Tensor<f32>([1000]);
  for i in 0..500 {
    let x = ((((i * 37) % 101) - 50) as f64) * 0.25;
    a[i] = x;
    a[999 - i] = -x;
    b[i] = x as f32;
    b[999 - i] = -(x as f32);
  }
  print(a.variance());
  print!(" ");
  print(a.std_dev());
  print!(" ");
  print(b.variance());
  print!(" ");
  print(b.std_dev());
  print!(" ");
  let _max = print_index(b.argmax());
  let _min = print_index(b.argmin());
  let mut s = Tensor<f32>([40]);
  let mut total : f64 = 0.0;
  for i in 0..40 {
    s[i] = 100.0 + (((i % 7) - 3) as f32) * 0.5;
  }
  s[5] = f32::neg_infinity();
  let _done = s.softmax_inplace();
  for i in 0..40 {
    total += s[i] as f64;
  }
  print(((s[0] as f64) * 1000000.0).round() / 1000000.0);
  print!(" ");
  print(((s[5] as f64) * 1000000.0).round() / 1000000.0);
  print!(" ");
  print(((s[17] as f64) * 1000000.0).round() / 1000000.0);
  print!(" ");
  print(((s[39] as f64) * 1000000.0).round() / 1000000.0);
  print!(" ");
  print((total * 1000000.0).round() / 1000000.0);
  print!(" ");
  let mut with_nan = Tensor<f32>([20]);
  for i in 0..20 {
    with_nan[i] = i as f32;
  }
  let zero : f32 = 0.0;
  with_nan[3] = zero / zero;
  let _nan_done = with_nan.softmax_inplace();
  print(with_nan[0]);
  print!(" ");
  let _sweep = report_exp_accuracy();
  return 0;
}

// The f32 softmax's vector `exp` against `f32::exp`. Element 0 is 0, the largest, so its `exp`
// is 1 and `s[i] / s[0]` is `exp(x[i])` up to two roundings. Prints how many of 65536 inputs
// spread over [-80, 0] are off by more than 4 ulp (a relative 2^-21).
fn report_exp_accuracy() -> i32 {
  let n : i32 = 65536;
  let mut x = Tensor<f32>([n]);
  let mut s = Tensor<f32>([n]);
  for i in 0..n {
    x[i] = -80.0 * ((i as f32) / (n as f32));
    s[i] = x[i];
  }
  let _done = s.softmax_inplace();
  let mut off : i32 = 0;
  for i in 1..n {
    let want = x[i].exp();
    let got = s[i] / s[0];
    let error = (got - want).abs() / want;
    if error > 0.000000477 {
      off = off + 1;
    }
  }
  print(off);
  return 0;
}

fn main() -> i32 {
  let _a = report_f64();
  print!("| ");
  let _b = report_f32();
  print!("| ");
  let _c = report_f16();
  print!("| ");
  let _d = report_edge_cases();
  print!(" | ");
  let _e = report_long();
  return 0;
}
