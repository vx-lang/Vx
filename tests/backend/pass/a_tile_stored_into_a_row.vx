//===----------------------------------------------------------------------===//
// `acc[w] = acc[w] + q[0]` stores a 2-D tile into a row of a 3-D tensor. Each subgroup of a GPU
// block keeps its sum of a tiled matmul this way. Both sides of the `+` are rows, which are
// strided views of their tensors. The sum is a new tile. The store copies it into the row and
// then frees it, also in a loop. Both code generators run it.
//
// RUN: vxc %s 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// acc[0] gets q[0] twice and acc[1] three times.
// OUT: {{^}}42 30 2 63{{$}}
// OUT: {{^}}83 42{{$}}
// The store in the loop copies the sum into the row, and then frees the sum.
// MLIR: memref.copy [[SUM:%[a-z0-9_]+]], {{%[a-z0-9_]+}} : memref<3x2xf32> to memref<3x2xf32, strided<[2, 1], offset: ?>>
// MLIR-NEXT: vx.drop [[SUM]]

fn main() -> i32 {
  let mut acc = Tensor<f32, [2, 3, 2]>::new();
  let mut q = Tensor<f32, [1, 3, 2]>::new();
  for i in 0..3 {
    for j in 0..2 {
      q[0][i][j] = (10 * i + j) as f32;
    }
  }
  for w in 0..2 {
    for r in 0..2 {
      acc[w] = acc[w] + q[0];
    }
  }
  acc[1] = acc[1] + q[0];
  println!("{} {} {} {}", acc[0][2][1], acc[1][1][0], acc[0][0][1], acc[1][2][1]);

  // A matmul into a row.
  let mut r = Tensor<f32, [2, 2]>::new();
  r[0][0] = 1.0;
  r[1][0] = 3.0;
  r[1][1] = 2.0;
  acc[1] = q[0] @ r;
  println!("{} {}", acc[1][2][0], acc[1][2][1]);
  return 0;
}
