//===- cpu_vector_transfer.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=LLVM
// FileCheck %s

fn test_f32() -> i32 {
  let mut a = unsafe { Tensor<f32, [4]>::uninit() };
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  a[3] = 4.0;
  // Transfer to CPU (CPU_DRAM is default CPU memory)
  let a_cpu = transfer(a, Memory::CPU_DRAM);
  assert(a_cpu[0] == a[0], "f32 index 0 match");
  assert(a_cpu[1] == a[1], "f32 index 1 match");
  assert(a_cpu[2] == a[2], "f32 index 2 match");
  assert(a_cpu[3] == a[3], "f32 index 3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = unsafe { Tensor<bf16, [4]>::uninit() };
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  a[3] = 4.0;
  let a_cpu = transfer(a, Memory::CPU_DRAM);
  assert(a_cpu[0] == a[0], "bf16 index 0 match");
  assert(a_cpu[1] == a[1], "bf16 index 1 match");
  assert(a_cpu[2] == a[2], "bf16 index 2 match");
  assert(a_cpu[3] == a[3], "bf16 index 3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// The extent is a constant, so the buffer is allocated with a static shape. The transfer
// reads that buffer.
// CHECK-LABEL: func.func @test_f32() -> i32
// CHECK: %[[A:.*]] = memref.alloc() : memref<4xf32>
// CHECK: "vx.transfer"(%[[A]]) {{.*}}{space = "CPU_DRAM"} : (memref<4xf32>) -> memref<4xf32>
// CHECK-LABEL: func.func @test_bf16() -> i32
// CHECK: memref.alloc() : memref<4xbf16>

// convert-vx-to-standard turns the transfer into a copy to a new buffer.
// STD-LABEL: func.func @test_f32() -> i32
// STD: %[[A:.*]] = memref.alloc() : memref<4xf32>
// STD: %[[B:.*]] = memref.alloc() : memref<4xf32>
// STD: memref.copy %[[A]], %[[B]] : memref<4xf32> to memref<4xf32>

// --emit-llvm stops at the LLVM dialect, where the same function is an llvm.func. Each
// 4-element buffer becomes a stack allocation.
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_f32() -> i32
// LLVM: %[[FOUR:.*]] = llvm.mlir.constant(4 : index) : i64
// LLVM: llvm.alloca %[[FOUR]] x f32
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_bf16() -> i32
