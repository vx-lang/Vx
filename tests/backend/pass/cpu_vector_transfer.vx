//===- cpu_vector_transfer.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X
// mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 |
// FileCheck %s RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s

fn test_f32() -> i32 {
  let mut a = Tensor<f32>([4]);
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  a[3] = 4.0;
  // Transfer to CPU (CPU_DRAM is default CPU memory)
  let a_cpu = transfer(a, Memory::CPU_DRAM);
  assert(a_cpu[0] == a[0], "f32 index 0 match");
  assert(a_cpu[1] == a[1], "f32 index 1 match");
  assert(a_cpu[2] == a[2], "f32 index 2 match");
  assert(a_cpu[3] == a[3], "f32 index 3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = Tensor<bf16>([4]);
  a[0] = 1.0;
  a[1] = 2.0;
  a[2] = 3.0;
  a[3] = 4.0;
  let a_cpu = transfer(a, Memory::CPU_DRAM);
  assert(a_cpu[0] == a[0], "bf16 index 0 match");
  assert(a_cpu[1] == a[1], "bf16 index 1 match");
  assert(a_cpu[2] == a[2], "bf16 index 2 match");
  assert(a_cpu[3] == a[3], "bf16 index 3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// FRONTEND-LABEL: module {
// FRONTEND: func.func @test_f32() -> i32
// FRONTEND: memref.alloc

// MLIR-LABEL: module {
// MLIR: func.func @test_f32() -> i32

// LLVM-LABEL: module {
// LLVM: llvm.func @test_f32() -> i32

// CHECK: module
