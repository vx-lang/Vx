//===----------------------------------------------------------------------===//
// In a loop, `info.text = text_of(&u)` stores a `Vec<u8>` in `info`. That value holds no
// reference, so `info` does not borrow `u`, and the loop can then assign `u`.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=declined
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}83{{$}}
// CHECK-NEXT: {{^}}3{{$}}

import std::vec;

struct Url {
  host : Vec<u8>,
  port : i32,
}

struct Info {
  text : Vec<u8>,
  hops : i32,
}

fn text_of(u : &Url) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  out.push(u.host.len() as u8);
  return out;
}

fn next_url(u : &Url) -> Url {
  return Url {
    host : Vec<u8>::new(), port : u.port + 1
  };
}

fn follow(info : &mut Info) -> i32 {
  let mut u = Url {
    host : Vec<u8>::new(), port : 80
  };
  let mut hops = 0;
  loop {
    info.text = text_of(&u);
    if hops == 3 {
      return u.port;
    }
    hops = hops + 1;
    let next = next_url(&u);
    u = next;
    info.hops = hops;
  }
}

fn main() -> i32 {
  let mut info = Info {
    text : Vec<u8>::new(), hops : 0
  };
  println!("{}", follow(&mut info));
  println!("{}", info.hops);
  return 0;
}
