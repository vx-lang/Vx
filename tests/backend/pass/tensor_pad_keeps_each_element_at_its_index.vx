// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
//
// `t.pad(shape)` makes a new tensor of a larger shape: `big[i][j] == t[i][j]`, and every
// other element is zero. It does not borrow `t`, which can then change.

fn two_by_three() -> Tensor<i32, [2, 3]> {
  let mut t = Tensor<i32, [2, 3]>::new();
  t[0][0] = 1;
  t[0][1] = 2;
  t[0][2] = 3;
  t[1][0] = 4;
  t[1][1] = 5;
  t[1][2] = 6;
  return t;
}

fn show(big : &Tensor<i32, [3, 4]>) -> i32 {
  for i in 0..3 {
    for j in 0..4 {
      print(big[i][j]);
    }
    print(" ");
  }
  print("
");
  return 0;
}

fn padded() -> Tensor<i32, [3, 4]> {
  let t = two_by_three();
  return t.pad([3, 4]);
}

// A method of the program's own type named `pad` is still that method.
struct Text {
  len : i32,
}

impl Text {
  fn pad(self : &Text, n : i32) -> i32 {
    return self.len + n;
  }
}

fn main() -> i32 {
  // CHECK: 1230 4560 0000
  let mut t = two_by_three();
  let big = t.pad([3, 4]);
  show(&big);

  // The source changes; the padded tensor keeps its values.
  // CHECK-NEXT: 1230 4560 0000
  t[0][0] = 9;
  show(&big);

  // CHECK-NEXT: 1230 4560 0000
  let r = padded();
  show(&r);

  // One axis, and three.
  // CHECK-NEXT: 78000
  let mut row = Tensor<i32, [2]>::new();
  row[0] = 7;
  row[1] = 8;
  let longer = row.pad([5]);
  for i in 0..5 {
    print(longer[i]);
  }
  print("
");

  // CHECK-NEXT: 3 0 0
  let mut cube = Tensor<i32, [1, 2, 2]>::new();
  cube[0][1][1] = 3;
  let bigger = cube.pad([2, 3, 3]);
  print(bigger[0][1][1]);
  print(" ");
  print(bigger[0][2][2]);
  print(" ");
  print(bigger[1][1][1]);
  print("
");

  // CHECK-NEXT: 7
  let s = Text {
    len : 4
  };
  print(s.pad(3));
  print("
");
  return 0;
}
