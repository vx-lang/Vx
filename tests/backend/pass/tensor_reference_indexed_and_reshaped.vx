//===----------------------------------------------------------------------===//
// A function given a tensor by reference can index it and take a reshape view of it, written
// with or without `*`: `(*t)[i]` is `t[i]`, and `(*t).reshape(..)` is `t.reshape(..)`.
//
// EXPECT: read=2;
// EXPECT: corner=2;
// EXPECT: last=2;
// EXPECT: method=2;
// EXPECT: written=5;

fn read(t : &Tensor<f32, [2, 4]>) -> f32 {
  return (*t)[1][3];
}

fn corner(t : &Tensor<f32, [2, 4]>) -> f32 {
  let v = (*t).reshape([4, 2]);
  return v[3][1];
}

fn last(t : &mut Tensor<f32, [2, 4]>) -> f32 {
  let v = (*t).reshape([8]);
  return v[7];
}

fn method(t : &Tensor<f32, [2, 4]>) -> f32 {
  let v = t.reshape([4, 2]);
  return v[3][1];
}

fn write(t : &mut Tensor<f32, [2, 4]>) -> void {
  (*t)[0][0] = 5.0;
  return;
}

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  q[1][3] = 2.0;
  print!("read=");
  print(read(&q));
  print!("; corner=");
  print(corner(&q));
  print!("; last=");
  print(last(&mut q));
  print!("; method=");
  print(method(&q));
  write(&mut q);
  print!("; written=");
  print(q[0][0]);
  print!(";");
  return 0;
}
