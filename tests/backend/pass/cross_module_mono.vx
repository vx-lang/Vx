//===----------------------------------------------------------------------===//
// An imported function (`dijkstra`, `bellman_ford`) whose body reaches `Graph` methods and
// `Vec<i32>` generics only through other functions still gets those generated. Without that,
// compiling failed with "Function node_count not found". `main` calls both, so both are
// generated.
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=DIJKSTRA
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=BELLMAN
//
// The code generators emit the three functions in different orders, so each is checked on
// its own.
// CHECK-DAG: func.func private @vx_vec_grow(
// CHECK-DAG: func.func private @vx_vec_bounds_check(
// CHECK-DAG: func.func @graph_inf() -> i32
// DIJKSTRA-LABEL: func.func @dijkstra(
// DIJKSTRA: call @ref$const$Graph$node_count(
// DIJKSTRA: call @graph_inf()
// DIJKSTRA: call @"Vec::with_capacity$i32"(
// DIJKSTRA: call @Vec$i32$push$i32(
// DIJKSTRA: call @Vec$i32$set$i32(
// DIJKSTRA: call @Vec$i32$get$i32(
// DIJKSTRA: call @ref$const$Graph$weight(
// BELLMAN-LABEL: func.func @bellman_ford(
// BELLMAN: call @ref$const$Graph$node_count(
// BELLMAN: call @graph_inf()
// BELLMAN: call @ref$const$Graph$weight(

import std::vec;
import graph::core;
import graph::shortest_path;

fn main() -> i32 {
  let mut g: Graph = Graph::new(3);
  g.add_edge(0, 1, 5);
  g.add_edge(1, 2, 7);
  let d = dijkstra(&g, 0, 2);
  let b = bellman_ford(&g, 0, 2);
  return d - b;
}
