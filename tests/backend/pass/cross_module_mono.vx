//===----------------------------------------------------------------------===//
// Regression for #203: an entry module calls a cross-module function (`dijkstra`)
// whose body reaches `Graph` methods and `Vec<i32>` generics only *transitively*.
// Those instantiations must be collected so codegen finds them — before the fix
// this failed with "Function node_count not found".
//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import std::vec;
import graph::core;
import graph::shortest_path;

fn main() -> i32 {
  let mut g: Graph = Graph::new(3);
  g.add_edge(0, 1, 5);
  g.add_edge(1, 2, 7);
  return dijkstra(&g, 0, 2);
}
