//===----------------------------------------------------------------------===//
// `println!` and `stdout_write` write to standard output in the order of the program. The bytes
// after the last newline also come out when the program ends.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=declined
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}first line{{$}}
// CHECK-NEXT: {{^}}second line{{$}}
// CHECK-NEXT: {{^}}third line{{$}}
// CHECK-NEXT: {{^}}no newline{{$}}

import std::io;

fn main() -> i32 {
  println!("first line");
  unsafe { stdout_write("second line\n", 12u64); }
  println!("third line");
  unsafe { stdout_write("no newline", 10u64); }
  return 0;
}
