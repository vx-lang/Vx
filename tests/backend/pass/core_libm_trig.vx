import core::num;

fn bits(r : f32) -> u32 {
  if r != r {
    return 2143289344u32;
  }
  return r.to_bits();
}

fn check(input : u32) -> i32 {
  let x = f32::from_bits(input);
  print(bits(x.sin()));
  print!(" ");
  print(bits(x.cos()));
  print!(" ");
  print(bits(x.tan()));
  print!(" ");
  return 0;
}

