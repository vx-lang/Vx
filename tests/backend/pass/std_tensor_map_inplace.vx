// `map_inplace` on 1-D tensors of f64 and f32: `x * 2 + 1` over 37 elements, printing the
// sum, the first and the last element. The inputs are multiples of 0.25, so the result is
// exact; the expected values were computed in Python.
//
// EXPECT: 20 -24 -14.5 | 20 -24 -14.5
import std::tensor;

fn main() -> i32 {
  let n : i32 = 37;
  let mut a = Tensor<f64>([n]);
  let mut b = Tensor<f32>([n]);
  for i in 0..n {
    a[i] = ((((i * 37) % 101) - 50) as f64) * 0.25;
    b[i] = ((((i * 37) % 101) - 50) as f32) * 0.25;
  }
  a.map_inplace(| x : f64 | x * 2.0 + 1.0);
  b.map_inplace(| x : f32 | x * 2.0 + 1.0);
  let mut sa : f64 = 0.0;
  let mut sb : f32 = 0.0;
  for i in 0..n {
    sa = sa + a[i];
    sb = sb + b[i];
  }
  print(sa);
  print!(" ");
  print(a[0]);
  print!(" ");
  print(a[n - 1]);
  print!(" | ");
  print(sb);
  print!(" ");
  print(b[0]);
  print!(" ");
  print(b[n - 1]);
  return 0;
}
