import std::math;

fn main() -> i32 {
  let x: f64 = 1.5;
  let res: f64 = x.abs();
  let expected: f64 = 1.5;

  // allow small floating point difference
  let diff: f64 = (res - expected).abs();
  let mut ret: i32 = 1;
  if diff < 0.001 {
    ret = 0;
  }
  return ret;
}
