// `f64` and `f32` as text: `write_decimal` must print what Rust's `format!("{}", x)` prints and
// `write_scientific` what `format!("{:e}", x)` prints. Each line shows both texts, each followed
// by what `decimal_len` and `scientific_len` say their length is. The expected lines come from
// Rust itself. The cases: zeros, NaN and the infinities, whole numbers, the largest and smallest
// values and subnormals, powers of ten whose `{}` form is all zeros, two floats where the two
// shortest candidates are equally close (Rust takes the larger), and inputs from the Ryu
// algorithm's own tests. The `f32` lines must use `f32`'s shortest digits: 0.1 as an `f32` is
// `0.1`, but `0.10000000149011612` once widened to `f64`. Then a hash of every power of 5
// the algorithm multiplies by, the digits and exponent `shortest_decimal` gives, and both
// writers at an offset into a buffer.
import core::num;
import std::alloc;

unsafe fn show_text(n : i64, buf : *mut i8) -> i32 {
  unsafe { buf[n] = 0i8; }
  print!("[");
  print!(buf);
  print!("] ");
  return 0;
}

fn show_f64(name : *const i8, x : f64, buf : *mut i8) -> i32 {
  print!("|");
  print!(name);
  print!(" ");
  unsafe { show_text(x.write_decimal(buf, 0i64), buf); }
  print(x.decimal_len());
  print!(" ");
  unsafe { show_text(x.write_scientific(buf, 0i64), buf); }
  print(x.scientific_len());
  print!("
");
  return 0;
}

fn show_f32(name : *const i8, x : f32, buf : *mut i8) -> i32 {
  print!("|");
  print!(name);
  print!(" ");
  unsafe { show_text(x.write_decimal(buf, 0i64), buf); }
  print(x.decimal_len());
  print!(" ");
  unsafe { show_text(x.write_scientific(buf, 0i64), buf); }
  print(x.scientific_len());
  print!("
");
  return 0;
}

/// The digits, the power of ten and the sign of the shortest form.
fn show_parts(name : *const i8, d : FloatDecimal) -> i32 {
  print!("|parts ");
  print!(name);
  print!(" ");
  print(d.digits);
  print!(" ");
  print(d.exponent);
  if d.negative {
    print!(" negative");
  }
  print!("
");
  return 0;
}

/// A hash of 5^i (or 2^k / 5^i) for i in 0..count, in the form Ryu multiplies by.
fn table_hash(inverse : bool, count : i64) -> u64 {
  let mut h = 0u64;
  let mut i = 0i64;
  loop {
    if i >= count {
      break;
    }
    let mut v = ryu_pow5(i);
    if inverse {
      v = ryu_inv_pow5(i);
    }
    h = (h * 31u64) ^ (v as u64);
    h = (h * 31u64) ^ ((v >> 64u128) as u64);
    i = i + 1i64;
  }
  return h;
}

fn main() -> i32 {
  let buf : *mut i8 = unsafe { malloc(400i64) };
  show_f64("zero", f64::from_bits(0u64), buf);
  show_f64("negative_zero", f64::from_bits(9223372036854775808u64), buf);
  show_f64("one", f64::from_bits(4607182418800017408u64), buf);
  show_f64("minus_one_and_a_half", f64::from_bits(13832806255468478464u64), buf);
  show_f64("one_hundred", f64::from_bits(4636737291354636288u64), buf);
  show_f64("tenth", f64::from_bits(4591870180066957722u64), buf);
  show_f64("one_thousandth", f64::from_bits(4562254508917369340u64), buf);
  show_f64("third", f64::from_bits(4599676419421066581u64), buf);
  show_f64("tenth_plus_fifth", f64::from_bits(4599075939470750516u64), buf);
  show_f64("decimal_123_456", f64::from_bits(4638387860618067575u64), buf);
  show_f64("decimal_1234_5", f64::from_bits(4653144203864309760u64), buf);
  show_f64("seventeen_digits", f64::from_bits(4608238818662570491u64), buf);
  show_f64("ten_to_minus_7", f64::from_bits(4502148214488346440u64), buf);
  show_f64("ten_to_21", f64::from_bits(4921056587992461136u64), buf);
  show_f64("ten_to_23", f64::from_bits(4950912855330343670u64), buf);
  show_f64("two_to_53_minus_1", f64::from_bits(4845873199050653695u64), buf);
  show_f64("two_to_53", f64::from_bits(4845873199050653696u64), buf);
  show_f64("largest", f64::from_bits(9218868437227405311u64), buf);
  show_f64("smallest_normal", f64::from_bits(4503599627370496u64), buf);
  show_f64("largest_subnormal", f64::from_bits(4503599627370495u64), buf);
  show_f64("smallest_subnormal", f64::from_bits(1u64), buf);
  show_f64("subnormal_from_ryu_tests", f64::from_bits(605001000000u64), buf);
  show_f64("infinity", f64::from_bits(9218868437227405312u64), buf);
  show_f64("negative_infinity", f64::from_bits(18442240474082181120u64), buf);
  show_f64("nan", f64::from_bits(9221120237041090560u64), buf);
  show_f64("nan_with_sign_bit", f64::from_bits(18444492273895866368u64), buf);
  show_f64("tie_two_to_minus_25", f64::from_bits(4494592428115755008u64), buf);
  show_f64("tie_above_two_to_50", f64::from_bits(4832362400168542209u64), buf);
  show_f64("looks_like_power_of_5", f64::from_bits(5201922341567583634u64), buf);
  show_f64("bound_below_power_of_two", f64::from_bits(18014398509481984u64), buf);
  show_f64("ryu_regression", f64::from_bits(4886500000000000000u64), buf);
  show_f32("f32_tenth", f32::from_bits(1036831949u32), buf);
  show_f32("f32_negative_zero", f32::from_bits(2147483648u32), buf);
  show_f32("f32_largest", f32::from_bits(2139095039u32), buf);
  show_f32("f32_smallest_normal", f32::from_bits(8388608u32), buf);
  show_f32("f32_smallest_subnormal", f32::from_bits(1u32), buf);
  show_f32("f32_two_to_24", f32::from_bits(1266679808u32), buf);
  show_f32("f32_eight_digits", f32::from_bits(1067320913u32), buf);
  show_f32("f32_tie_two_to_minus_12", f32::from_bits(964689920u32), buf);
  show_f32("f32_ryu_regression", f32::from_bits(363742205u32), buf);
  show_f32("f32_looks_like_power_of_5", f32::from_bits(1561658105u32), buf);
  show_f32("f32_rounds_up_below_two_to_minus_120", f32::from_bits(58720255u32), buf);
  show_f32("f32_two_to_32", f32::from_bits(1333788672u32), buf);
  show_f32("f32_negative_infinity", f32::from_bits(4286578688u32), buf);
  show_f32("f32_nan", f32::from_bits(2143289344u32), buf);
  show_f64("f32_tenth_widened_to_f64", (f32::from_bits(1036831949u32)) as f64, buf);

  // Ryu builds each power of 5 it multiplies by from a small table. These hash every power
  // the f64 path can ask for and must equal the hash of Ryu's full tables, which list them all.
  print!("|pow5_table_hash ");
  print(table_hash(false, 326i64));
  print!("
|inv_pow5_table_hash ");
  print(table_hash(true, 342i64));
  print!("
");

  show_parts("decimal_123_456", f64::from_bits(4638387860618067575u64).shortest_decimal());
  show_parts("ten_to_21", f64::from_bits(4921056587992461136u64).shortest_decimal());
  show_parts("largest", f64::from_bits(9218868437227405311u64).shortest_decimal());
  show_parts("negative_zero", f64::from_bits(9223372036854775808u64).shortest_decimal());
  show_parts("f32_tenth", f32::from_bits(1036831949u32).shortest_decimal());


  let y = f64::from_bits(13728134904377344886u64);
  unsafe {
    buf[0i64] = 120i8;
    buf[1i64] = 61i8;
    let n = 2i64 + y.write_decimal(buf, 2i64);
    buf[n] = 44i8;
    let m = n + 1i64 + y.write_scientific(buf, n + 1i64);
    show_text(m, buf);
  }
  print!("
");
  unsafe { free(buf); }
  return 0;
}

