//===----------------------------------------------------------------------===//
// `within(seconds) { .. }` gives the waits in it one time limit (F6a). Each `recv` here waits for
// a value that never comes, because `main` holds the `Sender`. After the limit, a wait gives up
// as in a cancelled block, and `cancelled()` is true until the block ends.
//
// - Two waits in one block of 0.5 seconds share the 0.5 seconds, so both take less than 1
//   second together.
// - In two nested blocks, the earlier deadline counts, so 0.2 seconds inside a block of 30
//   seconds, and 30 seconds inside a block of 0.2 seconds, both give up soon.
// - A `return` and a `break` out of a block end its deadline, so a wait after them does not
//   give up at once.
// - In a `drop`, a block shortens the drop's limit, and W1036 does not warn about its wait.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning
// CHECK: {{^}}two waits gave up: true true{{$}}
// CHECK-NEXT: {{^}}they took less than 1 second together: true{{$}}
// CHECK-NEXT: {{^}}after the block, cancelled false{{$}}
// CHECK-NEXT: {{^}}the inner block gave up: true{{$}}
// CHECK-NEXT: {{^}}the outer block gave up: true{{$}}
// CHECK-NEXT: {{^}}nested blocks took less than 5 seconds: true{{$}}
// CHECK-NEXT: {{^}}after a return out of a block, cancelled false{{$}}
// CHECK-NEXT: {{^}}after a break out of a block, cancelled false{{$}}
// CHECK-NEXT: {{^}}the drop gave up, cancelled true{{$}}
// CHECK-NEXT: {{^}}the drop took less than 5 seconds: true{{$}}

import core::time;
import std::sync::channel;
import std::sync::wait;
import std::time;

/// Whether a `recv` on `rx` gave up.
fn gave_up(rx : &Receiver<i64>) -> bool {
  match rx.recv() {
    Result<i64, RecvError>::Ok(_v) => {
      return false;
    }
    Result<i64, RecvError>::Err(_e) => {
      return true;
    }
  }
}

fn returns_from_a_block(rx : &Receiver<i64>) -> i64 {
  within(0.1) {
    if !gave_up(rx) {
      return 1;
    }
    return 2;
  }
}

fn breaks_from_a_block(rx : &Receiver<i64>) -> i64 {
  let mut n = 0i64;
  loop {
    within(0.1) {
      n = n + 1i64;
      if gave_up(rx) {
        break;
      }
    }
  }
  return n;
}

struct Waiter {
  rx : Receiver<i64>,
}

impl Drop for Waiter {
  fn drop(self : &mut Waiter) -> void {
    within(0.2) {
      match self.rx.recv() {
        Result<i64, RecvError>::Ok(v) => {
          println!("the drop got {}", v);
        }
        Result<i64, RecvError>::Err(_e) => {
          println!("the drop gave up, cancelled {}", cancelled());
        }
      }
    }
  }
}

fn main() -> i32 {
  let (tx, rx) = channel<i64>(1);

  let start = Instant::now();
  within(0.5) {
    let first = gave_up(&rx);
    let second = gave_up(&rx);
    println!("two waits gave up: {} {}", first, second);
  }
  println!("they took less than 1 second together: {}", start.elapsed() < Duration::from_secs(1));
  println!("after the block, cancelled {}", cancelled());

  let nested_start = Instant::now();
  within(30.0) {
    within(0.2) {
      println!("the inner block gave up: {}", gave_up(&rx));
    }
  }
  within(0.2) {
    within(30.0) {
      println!("the outer block gave up: {}", gave_up(&rx));
    }
  }
  println!("nested blocks took less than 5 seconds: {}", nested_start.elapsed() < Duration::from_secs(5));

  // Past the 0.1 seconds of the blocks, a deadline that did not end would still count.
  returns_from_a_block(&rx);
  sleep(Duration::from_millis(200));
  println!("after a return out of a block, cancelled {}", cancelled());
  breaks_from_a_block(&rx);
  sleep(Duration::from_millis(200));
  println!("after a break out of a block, cancelled {}", cancelled());

  let (tx2, rx2) = channel<i64>(1);
  let w = Waiter {
    rx : rx2
  };
  let drop_start = Instant::now();
  drop(w);
  println!("the drop took less than 5 seconds: {}", drop_start.elapsed() < Duration::from_secs(5));
  drop(tx2);
  drop(tx);
  return 0;
}
