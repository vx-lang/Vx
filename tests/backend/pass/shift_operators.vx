//===----------------------------------------------------------------------===//
// `<<` and `>>` on integers.
//
// Nothing in this file declares a struct, and that is deliberate rather than incidental:
// the flat path declines a program holding a generic struct, and a declined program is
// emitted by the AST path instead. Both paths spell a left shift `arith.shli`, so the
// directives below would still have matched while testing the wrong emitter. The other
// meaning of `>>` -- closing two generics, which needs exactly such a struct -- is
// therefore in nested_generics_close_with_two_angles.vx.
//
// `>>` on a signed operand is arithmetic, so -16 >> 2 keeps its sign and is -4 rather
// than a large positive number. The unsigned counterpart is logical and is in
// shift_right_unsigned_is_logical.vx, for the reason the unsigned `%` needed its own
// file: only the flat path still knows the element type when the op is chosen.
//
// A spaced `a > > b` is deliberately still a syntax error rather than a shift, which is
// why adjacency and not merely order decides it. That case does not compile, so it is
// in tests/frontend/fail/spaced_angles_are_not_a_shift.vx.
//
// The three precedence entries each rule out one neighbour, and each is a spelling the
// two readings disagree on. 1 << 2 + 1 is 8 with `+` tighter and 5 with `<<` tighter.
// 1 << 3 & 8 is 8 with `<<` tighter and 1 with `&` tighter. 1 << 3 == 8 compares 8
// against 8; were `==` tighter it would try to shift by a `bool`.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: arith.shli
// CHECK-DAG: arith.shrsi
fn main() -> i32 {
  let a : i32 = 1;
  print(a << 4);
  print!(" ");
  let b : i32 = -16;
  print(b >> 2);
  print!(" ");
  print(1 << 2 + 1);
  print!(" ");
  print(1 << 3 & 8);
  print!(" ");
  if 1 << 3 == 8 {
    print(1);
  } else {
    print(0);
  }
  print!(" ");
  // A single `>` is still a comparison, not half of anything.
  if 5 > 3 {
    print(1);
  } else {
    print(0);
  }
  return 0;
}

// EXPECT: 16 -4 8 8 1 1
