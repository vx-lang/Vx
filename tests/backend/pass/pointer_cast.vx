// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

fn main() -> i32 {
  // This should succeed because it's inside an unsafe block
  let ptr: *mut i32 = unsafe { 0 as *mut i32 };

  if ptr == unsafe { 0 as *mut i32 } {
    return 1;
  }

  return 0;
}

// CHECK-LABEL: func.func @main
// CHECK: llvm.inttoptr
