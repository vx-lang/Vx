// CHECK: llvm.insertvalue %{{.*}}, %{{.*}} : !llvm.struct<"VecIter_i32", (ptr, i32)>
// CHECK: %[[V0:.*]] = arith.constant 0 : i32
// CHECK: %[[V1:.*]] = llvm.insertvalue %[[V0]], %{{.*}} : !llvm.struct<"VecIter_i32", (ptr, i32)>
// CHECK: return %[[V1]] : !llvm.struct<"VecIter_i32", (ptr, i32)>
// CHECK-LABEL: func.func @VecIter$i32$map$i32$i32(%arg0: !llvm.struct<"VecIter_i32", (ptr, i32)>, %arg1: !llvm.struct<"Closure1_i32_i32", (ptr, ptr)>) -> !llvm.struct<"VecMap_i32_i32", (struct<"VecIter_i32", (ptr, i32)>, struct<"Closure1_i32_i32", (ptr, ptr)>)>
// CHECK: llvm.mlir.undef : !llvm.struct<"VecMap_i32_i32", (struct<"VecIter_i32", (ptr, i32)>, struct<"Closure1_i32_i32", (ptr, ptr)>)>
// CHECK: llvm.insertvalue %{{.*}}, %{{.*}} : !llvm.struct<"VecMap_i32_i32", (struct<"VecIter_i32", (ptr, i32)>, struct<"Closure1_i32_i32", (ptr, ptr)>)>
// CHECK: %[[V0:.*]] = llvm.insertvalue %{{.*}}, %{{.*}} : !llvm.struct<"VecMap_i32_i32", (struct<"VecIter_i32", (ptr, i32)>, struct<"Closure1_i32_i32", (ptr, ptr)>)>
