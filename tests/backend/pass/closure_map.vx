// CHECK: call @Option$i32$unwrap$i32(%{{.*}}) : (!llvm.struct<"Option_i32", (i32, i32)>) -> i32
// CHECK-LABEL: func.func @VecMap$i32$i32$collect$i32$i32(%arg0: !llvm.ptr) -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @ref$mut$VecMap$i32$i32$next$i32$i32(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"Option_i32", (i32, i32)>
// CHECK: call @Option$i32$is_none$i32(%{{.*}}) : (!llvm.ptr) -> i1
// CHECK: %[[V0:.*]] = call @Option$i32$unwrap$i32(%{{.*}}) : (!llvm.struct<"Option_i32", (i32, i32)>) -> i32
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %[[V0]]) : (!llvm.ptr, i32) -> i32
// CHECK-LABEL: func.func @Vec$i32$get$i32(%arg0: !llvm.ptr, %arg1: i32) -> i32
// CHECK: call @vx_vec_bounds_check(%{{.*}}, %{{.*}}) : (i64, i64) -> i32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::new$i32"() : () -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$push$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: %[[V0:.*]] = call @Vec$i32$iter$i32(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"VecIter_i32", (ptr, i32)>
// CHECK: call @VecIter$i32$map$i32$i32(%[[V0]], %{{.*}}) : (!llvm.struct<"VecIter_i32", (ptr, i32)>, !llvm.struct<"Closure1_i32_i32", (ptr, ptr)>) -> !llvm.struct<"VecMap_i32_i32", (struct<"VecIter_i32", (ptr, i32)>, struct<"Closure1_i32_i32", (ptr, ptr)>)>
// CHECK: call @VecMap$i32$i32$collect$i32$i32(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"Vec_i32", (ptr, i32, i32)>
// CHECK: call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @Vec$i32$get$i32(%{{.*}}, %{{.*}}) : (!llvm.ptr, i32) -> i32
//
// A closure literal (`|x| ...`) passed to the generic stdlib iterator adapter
// `VecIter::map`, then driven by `next()` / `collect()`. The closure checks to a
// generated `Closure_N` env struct; `.map`'s parameter is the nominal
// `Closure1<T, NewItem>`. Deducing `NewItem` needs the closure's recovered call
// signature (unify), and passing it needs the `Closure_N` -> `Closure1` fat-struct
// adapter in codegen. Exercises both a non-capturing and a capturing closure.
import std::vec;
import std::closure;

fn main() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(1);
  v.push(2);
  v.push(3);

  // Capturing closure: `bump` is moved into the generated env struct.
  let bump = 10;
  let adder = |x: i32| x + bump;
  let mut m = v.iter().map(adder);

  // collect() the mapped iterator back into a Vec<i32> = [11, 12, 13].
  let out = m.collect();
  let sum = out.get(0) + out.get(1) + out.get(2); // 11 + 12 + 13 = 36
  assert(sum == 36);
  return 0;
}
