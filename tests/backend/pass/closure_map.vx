// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C1:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C1]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @Option$i32$unwrap$i32(%arg0: !llvm.struct<"Option_i32", (i32, i32)>) -> i32
