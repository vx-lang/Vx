//===----------------------------------------------------------------------===//
// The ways that `select` ends with no value:
// - A list with no channels gives `Closed` at once.
// - A task waits in `select` on two empty channels, and 0.2 seconds later the code drops both
//   `Sender`s. The drop of the last `Sender` wakes the `select`, and it gives `Closed`.
// - A task waits in `select`, and the code of the block returns early. That cancels the task, so
//   `select` gives `Cancelled`.
// - In a call of `within`, a `select` gives `Cancelled` at the time limit.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}no channels: Closed{{$}}
// CHECK-NEXT: {{^}}the Senders were dropped: Closed{{$}}
// CHECK-NEXT: {{^}}the block returned early: Cancelled{{$}}
// CHECK-NEXT: {{^}}leave gave 7{{$}}
// CHECK-NEXT: {{^}}within: Cancelled{{$}}

import core::time;
import std::sync::channel;
import std::sync::wait;
import std::time;

fn name(e : RecvError) -> *const i8 {
  match e {
    RecvError::Closed => {
      return "Closed";
    }
    RecvError::Cancelled => {
      return "Cancelled";
    }
    RecvError::TimedOut => {
      return "TimedOut";
    }
  }
}

fn say(what : *const i8, r : Result<Selected<i64>, RecvError>) -> void {
  match r {
    Result<Selected<i64>, RecvError>::Ok(s) => {
      println!("{}: the value {}", what, s.value);
    }
    Result<Selected<i64>, RecvError>::Err(e) => {
      println!("{}: {}", what, name(e));
    }
  }
}

fn two(a : Receiver<i64>, b : Receiver<i64>) -> Selector<i64> {
  let mut rs = Vec<Receiver<i64>>::new();
  rs.push(a);
  rs.push(b);
  return Selector<i64>::new(rs);
}

fn select_and_say(sel : Selector<i64>, what : *const i8) -> void {
  let mut s = sel;
  say(what, s.select());
}

fn leave(early : bool) -> i64 {
  let (tx0, rx0) = channel<i64>(1);
  let (tx1, rx1) = channel<i64>(1);
  let sel = two(rx0, rx1);
  tasks {
    spawn {
      select_and_say(sel, "the block returned early");
    };
    if early {
      return 7;
    }
    drop(tx0);
    drop(tx1);
  };
  return 0;
}

fn main() -> i32 {
  let mut none = Selector<i64>::new(Vec<Receiver<i64>>::new());
  say("no channels", none.select());

  let (tx0, rx0) = channel<i64>(1);
  let (tx1, rx1) = channel<i64>(1);
  let sel = two(rx0, rx1);
  tasks {
    spawn {
      select_and_say(sel, "the Senders were dropped");
    };
    // The task waits in `select` by the end of the sleep.
    sleep(Duration::from_millis(200));
    drop(tx0);
    drop(tx1);
  };

  let left = leave(true);
  println!("leave gave {}", left);

  let (tx2, rx2) = channel<i64>(1);
  let (tx3, rx3) = channel<i64>(1);
  let mut timed = two(rx2, rx3);
  within(Duration::from_millis(100), || -> void {
    say("within", timed.select());
  });
  drop(tx2);
  drop(tx3);
  return 0;
}
