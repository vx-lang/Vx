//===----------------------------------------------------------------------===//
// `std::tensor` over f16 and bf16 tensors. The first two groups are `sum`, `dot`, `max` and
// `min` at lengths 0, 5, 64, 70 and 200: on both sides of the 64 elements one vector step
// covers. The elements are small multiples of 0.25, so every answer is exact. The expected
// values were computed in Python.
//
// `sum` adds up in f32 and returns f32: 5000 ones sum to 5000 in both types, where adding
// up in the narrow type gives 4992, and 100 f16 elements of 1000 sum to 100000, which f16
// cannot hold.
//
// The last group is element-wise: `abs`, `scale` and `add_assign` on f16, `sqrt` and
// `clamp` on bf16.
//
// EXPECT: 0 0 -inf inf -1.75 -0.875 0.75 -1.25 0 0.375 1.25 -1.25 -1.75 -2.875 1.25 -1.25 -1.5 2.875 1.25 -1.25 | 0 0 -inf inf -1.75 -0.875 0.75 -1.25 0 0.375 1.25 -1.25 -1.75 -2.875 1.25 -1.25 -1.5 2.875 1.25 -1.25 | 5000 5000 100000 | 5 3 1 3 5 1 1 2 3 3 |
import std::tensor;

fn report_f16(n : i32) -> i32 {
  let mut a = Tensor<f16>([n]);
  let mut b = Tensor<f16>([n]);
  for i in 0..n {
    a[i] = ((((i * 37) % 11) - 5) as f16) * 0.25;
    b[i] = ((i % 7) as f16) * 0.5;
  }
  let s : f32 = a.sum();
  let d : f32 = a.dot(&b);
  let hi : f16 = a.max();
  let lo : f16 = a.min();
  print(s);
  print!(" ");
  print(d);
  print!(" ");
  print(hi);
  print!(" ");
  print(lo);
  print!(" ");
  return 0;
}

fn report_bf16(n : i32) -> i32 {
  let mut a = Tensor<bf16>([n]);
  let mut b = Tensor<bf16>([n]);
  for i in 0..n {
    a[i] = ((((i * 37) % 11) - 5) as bf16) * 0.25;
    b[i] = ((i % 7) as bf16) * 0.5;
  }
  let s : f32 = a.sum();
  let d : f32 = a.dot(&b);
  let hi : bf16 = a.max();
  let lo : bf16 = a.min();
  print(s);
  print!(" ");
  print(d);
  print!(" ");
  print(hi);
  print!(" ");
  print(lo);
  print!(" ");
  return 0;
}

fn main() -> i32 {
  report_f16(0);
  report_f16(5);
  report_f16(64);
  report_f16(70);
  report_f16(200);
  print!("| ");
  report_bf16(0);
  report_bf16(5);
  report_bf16(64);
  report_bf16(70);
  report_bf16(200);
  print!("| ");

  let mut ones = Tensor<f16>([5000]);
  for i in 0..5000 {
    ones[i] = 1.0;
  }
  print(ones.sum());
  print!(" ");
  let mut bf_ones = Tensor<bf16>([5000]);
  for i in 0..5000 {
    bf_ones[i] = 1.0;
  }
  print(bf_ones.sum());
  print!(" ");
  let mut big = Tensor<f16>([100]);
  for i in 0..100 {
    big[i] = 1000.0;
  }
  print(big.sum());
  print!(" | ");

  let mut a = Tensor<f16>([5]);
  let mut b = Tensor<bf16>([5]);
  for i in 0..5 {
    a[i] = (i as f16) - 2.0;
    b[i] = (i * i) as bf16;
  }
  let mut one = Tensor<f16>([5]);
  for i in 0..5 {
    one[i] = 1.0;
  }
  a.abs_inplace();
  a.scale(2.0);
  a.add_assign(&one);
  b.sqrt_inplace();
  b.clamp_inplace(1.0, 3.0);
  for i in 0..5 {
    print(a[i]);
    print!(" ");
  }
  for i in 0..5 {
    print(b[i]);
    print!(" ");
  }
  print!("|");
  return 0;
}
