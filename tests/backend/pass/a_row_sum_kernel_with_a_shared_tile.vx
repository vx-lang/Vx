//===----------------------------------------------------------------------===//
// A GPU kernel sums each row of a 64x128 tensor. It runs one block per row,
// and the threads of a block keep partial sums in a tile in shared memory.
// Each code generator gives the same sums. Row r holds r + c in column c, so
// its sum is 8128 + 128 * r.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}8128 8256 16192{{$}}

Memory CPU_DRAM {}

Memory GPU_HBM {
  within: Memory::CPU_DRAM,
  capacity: 24 GiB,
  bandwidth: 300 GB/s,
  managed: cached,
  scope: device
}

Memory SMEM {
  within: Memory::GPU_HBM,
  capacity: 48 KiB,
  bandwidth: 128 B/cyc,
  granule: 1 KiB,
  managed: explicit,
  scope: sm
}

fn rowsum(out : &mut Tensor<f32, [64, 1], Memory::GPU_HBM>, x : &Tensor<f32, [64, 128], Memory::GPU_HBM>) -> void {
  spawn on(Topology::GPU) {
    let mut part = unsafe { Tensor<f32, [32, 1], Memory::SMEM>::uninit() };
    for r in 0..64 {
      for t in 0..32 {
        let mut s : f32 = 0.0;
        for j in 0..4 {
          s = s + x[r][t + j * 32];
        }
        part[t][0] = s;
      }
      barrier();
      for z in 0..1 {
        let mut s : f32 = 0.0;
        for k in 0..32 {
          s = s + part[k][0];
        }
        out[r][z] = s;
      }
      barrier();
    }
  }
  return;
}

fn main() -> i32 {
  let mut xh = Tensor<f32, [64, 128]>::new();
  for r in 0..64 {
    for c in 0..128 {
      xh[r][c] = (r + c) as f32;
    }
  }
  let x = transfer(xh, Memory::GPU_HBM);
  let oh = Tensor<f32, [64, 1]>::new();
  let mut o = transfer(oh, Memory::GPU_HBM);
  rowsum(&mut o, &x);
  let back = transfer(o, Memory::CPU_DRAM);
  println!("{} {} {}", back[0][0], back[1][0], back[63][0]);
  return 0;
}
