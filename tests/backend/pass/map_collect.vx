// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import std::option;
import std::iter;

struct Range {
  current : i32, end : i32,
}

impl Iterator<Range, i32> for Range {
  fn next(self : &mut Range) -> Option<i32> {
    let mut ret = Option<i32>::None;
    if self
    .current < self.end {
      let val = self.current;
      self.current = self.current + 1;
      ret = Option<i32>::Some(val);
    } else {
      ret = Option<i32>::None;
    }
    return ret;
  }
}

struct Map {
  iter : Range, f : fn(i32)->i32,
}

impl Iterator<Map, i32> for Map {
  fn next(self : &mut Map) -> Option<i32> {
    let val = self.iter.next();
    let mut ret = Option<i32>::None;
    match val {
      Option<i32>::Some(v) => {
        let f_ptr = self.f;
        ret = Option<i32>::Some(f_ptr(v));
      }
      Option<i32>::None => {
        ret = Option<i32>::None;
      }
    }
    return ret;
  }
}

fn map_range(iter : Range, f : fn(i32)->i32) -> Map {
  return Map{
    iter : iter, f : f
  };
}

fn square(x : i32) -> i32 {
  return x * x;
}

fn main() -> i32 {
  let mut r = Range{
    current : 0, end : 5
  };
  let mut m = map_range(r, square);

  let mut sum = 0;
  loop {
    let val = m.next();
    match val {
      Option<i32>::Some(v) => {
        sum = sum + v;
      }
      Option<i32>::None => {
        break;
      }
    }
  }
  return sum; // 0 + 1 + 4 + 9 + 16 = 30
}
