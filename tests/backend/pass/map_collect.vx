// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @Range$next(%arg0: !llvm.ptr) -> !llvm.struct<"Option_i32", (i32, i32)>
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @Map$next(%arg0: !llvm.ptr) -> !llvm.struct<"Option_i32", (i32, i32)>
// CHECK: call @Range$next(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"Option_i32", (i32, i32)>
// CHECK-LABEL: func.func @map_range(%arg0: !llvm.struct<"Range", (i32, i32)>, %arg1: !llvm.ptr) -> !llvm.struct<"Map", (struct<"Range", (i32, i32)>, ptr)>
// CHECK: llvm.mlir.undef : !llvm.struct<"Map", (struct<"Range", (i32, i32)>, ptr)>
// CHECK: llvm.insertvalue %{{.*}}, %{{.*}} : !llvm.struct<"Map", (struct<"Range", (i32, i32)>, ptr)>
// CHECK: %[[V0:.*]] = llvm.insertvalue %{{.*}}, %{{.*}} : !llvm.struct<"Map", (struct<"Range", (i32, i32)>, ptr)>
// CHECK: return %[[V0]] : !llvm.struct<"Map", (struct<"Range", (i32, i32)>, ptr)>
// CHECK-LABEL: func.func @square(%arg0: i32) -> i32
// CHECK: %[[V0:.*]] = arith.muli %{{.*}}, %{{.*}} : i32
// CHECK: return %[[V0]] : i32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @map_range(%{{.*}}, %{{.*}}) : (!llvm.struct<"Range", (i32, i32)>, !llvm.ptr) -> !llvm.struct<"Map", (struct<"Range", (i32, i32)>, ptr)>
// CHECK: call @Map$next(%{{.*}}) : (!llvm.ptr) -> !llvm.struct<"Option_i32", (i32, i32)>
import std::option;
import std::iter;

struct Range {
  current : i32, end : i32,
}

impl Iterator<Range, i32> for Range {
  fn next(self : &mut Range) -> Option<i32> {
    let mut ret = Option<i32>::None;
    if self
    .current < self.end {
      let val = self.current;
      self.current = self.current + 1;
      ret = Option<i32>::Some(val);
    } else {
      ret = Option<i32>::None;
    }
    return ret;
  }
}

struct Map {
  iter : Range, f : fn(i32)->i32,
}

impl Iterator<Map, i32> for Map {
  fn next(self : &mut Map) -> Option<i32> {
    let val = self.iter.next();
    let mut ret = Option<i32>::None;
    match val {
      Option<i32>::Some(v) => {
        let f_ptr = self.f;
        ret = Option<i32>::Some(f_ptr(v));
      }
      Option<i32>::None => {
        ret = Option<i32>::None;
      }
    }
    return ret;
  }
}

fn map_range(iter : Range, f : fn(i32)->i32) -> Map {
  return Map {
    iter : iter, f : f
  };
}

fn square(x : i32) -> i32 {
  return x * x;
}

fn main() -> i32 {
  let mut r = Range {
    current : 0, end : 5
  };
  let mut m = map_range(r, square);

  let mut sum = 0;
  loop {
    let val = m.next();
    match val {
      Option<i32>::Some(v) => {
        sum = sum + v;
      }
      Option<i32>::None => {
        break;
      }
    }
  }
  return 0; // 0 + 1 + 4 + 9 + 16 = 30
}
