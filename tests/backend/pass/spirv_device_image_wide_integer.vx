//===----------------------------------------------------------------------===//
// `high_bits` computes with an `i128`, and SPIR-V has no integer wider than
// 64 bits. So the first region gets no SPIR-V image and runs on the host. The
// compiler does not stop, and the second region keeps its image.
//
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s # flat-codegen
// CHECK: cannot become a `spirv64` device image: it computes with a 128-bit integer in `high_bits`, and a SPIR-V image holds integers of at most 64 bits
// CHECK: format=spirv
// EXPECT: 499499 998998

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached, scope: device
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 63 GB/s
}

// `x` times 9223372036854775, without its lower 64 bits: about `x` / 2000.
fn high_bits(x : i64) on Topology::Any -> i64 {
  let wide = (x as i128) * 9223372036854775i128;
  return (wide >> 64) as i64;
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<i64, [1000]>::uninit() };
  for i in 0..1000 {
    a[i] = (i as i64) * 1000000i64;
  }
  let ga = transfer(a, Memory::DEV_HBM);
  let mut gh = transfer(unsafe { Tensor<i64, [1000]>::uninit() }, Memory::DEV_HBM);
  let mut gs = transfer(unsafe { Tensor<i64, [1000]>::uninit() }, Memory::DEV_HBM);
  spawn on(Topology::Dev) {
    for i in 0..1000 {
      gh[i] = high_bits(ga[i]);
    }
  }
  spawn on(Topology::Dev) {
    for i in 0..1000 {
      gs[i] = gh[i] * 2i64;
    }
  }
  let h = transfer(gh, Memory::CPU_DRAM);
  let s = transfer(gs, Memory::CPU_DRAM);
  println!("{} {}", h[999], s[999]);
  return 0;
}
