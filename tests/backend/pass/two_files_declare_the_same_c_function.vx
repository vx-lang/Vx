//===----------------------------------------------------------------------===//
// Two imported files declare the C functions `strlen`, `labs` and `llabs`, with different
// levels. Each declaration names the same C function, so a call is fine when the calling file
// can see one of them. `length` and `length_here` call the private `strlen` of their own file.
// This file calls the `pub` `labs` of one file and the `pub` `llabs` of the other. The compiler
// may list the two files in either order, so each file has a call that its order could break.
//
// RUN: vxc --package tests=tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
import tests::modules::a_module_with_private_declarations_of_c_functions;
import tests::modules::a_module_with_its_own_declarations_of_c_functions;

fn main() -> i32 {
  // CHECK: {{^}}length 4{{$}}
  println!("length {}", length("four"));
  // CHECK-NEXT: {{^}}length here 5{{$}}
  println!("length here {}", length_here("seven"));
  // CHECK-NEXT: {{^}}labs 3{{$}}
  println!("labs {}", unsafe { labs(-3i64) });
  // CHECK-NEXT: {{^}}llabs 6{{$}}
  println!("llabs {}", unsafe { llabs(-6i64) });
  return 0;
}
