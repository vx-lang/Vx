// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// EXPECT: Vx runtime panic occurred!
// EXPECT: Caught panic!
// EXPECT: Vx runtime panic occurred!
// EXPECT: Caught panic!
// EXPECT: Vx runtime panic occurred!
// EXPECT: Caught panic!

// EXPECT: thread '<unnamed>'
// EXPECT: vx_panic
// EXPECT: stack backtrace:
// EXPECT: vx_panic
// EXPECT: f5
// EXPECT: f4
// EXPECT: f3
// EXPECT: f2
// EXPECT: f1
// EXPECT: do_test_chain

// EXPECT: thread '<unnamed>'
// EXPECT: vx_panic
// EXPECT: stack backtrace:
// EXPECT: vx_panic
// EXPECT: f5
// EXPECT: f4
// EXPECT: f3
// EXPECT: f2
// EXPECT: f1
// EXPECT: Closure
// EXPECT: do_test_lambda

// EXPECT: thread '<unnamed>'
// EXPECT: vx_panic
// EXPECT: stack backtrace:
// EXPECT: vx_panic
// EXPECT: Closure
// EXPECT: do_test_direct_panic_lambda

extern {
  fn vx_panic() -> i32;
  fn vx_catch_unwind(f: fn() -> i32) -> i32;
}

fn f5() -> i32 {
  unsafe { vx_panic(); }
  return 0;
}

fn f4() -> i32 {
  return f5();
}
fn f3() -> i32 {
  return f4();
}
fn f2() -> i32 {
  return f3();
}
fn f1() -> i32 {
  return f2();
}

fn do_test_chain() -> i32 {
  f1();
  return 0;
}

fn do_test_lambda() -> i32 {
  let capture = 42;
  let my_lambda = || f1() + capture;
  my_lambda();
  return 0;
}

fn do_test_direct_panic_lambda() -> i32 {
  let my_lambda = || f5();
  my_lambda();
  return 0;
}

fn main() -> i32 {
  unsafe {
    vx_catch_unwind(do_test_chain);
    vx_catch_unwind(do_test_lambda);
    vx_catch_unwind(do_test_direct_panic_lambda);
  }
  return 0;
}

// Each panicking body reaches vx_catch_unwind as its own symbol -- the two closure cases as
// generated Closure_N_call thunks -- so a caught panic returns to the next call, not past it.
// MLIR: func.func private @vx_catch_unwind(!llvm.ptr) -> i32
// MLIR-LABEL: func.func @main() -> i32 {
// MLIR: %[[F1:.*]] = constant @do_test_chain : () -> i32
// MLIR: %[[P1:[0-9]+]] = builtin.unrealized_conversion_cast %[[F1]]
// MLIR: call @vx_catch_unwind(%[[P1]])
// MLIR: %[[F2:.*]] = constant @do_test_lambda : () -> i32
// MLIR: %[[P2:[0-9]+]] = builtin.unrealized_conversion_cast %[[F2]]
// MLIR: call @vx_catch_unwind(%[[P2]])
// MLIR: %[[F3:.*]] = constant @do_test_direct_panic_lambda : () -> i32
// MLIR: %[[P3:[0-9]+]] = builtin.unrealized_conversion_cast %[[F3]]
// MLIR: call @vx_catch_unwind(%[[P3]])
// MLIR-DAG: func.func @Closure_1_call(
// MLIR-DAG: func.func @Closure_2_call(
