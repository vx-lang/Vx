// EXPECT: Vx runtime panic occurred!
// EXPECT: Caught panic!
// EXPECT: thread '<unnamed>'
// EXPECT: vx_panic
// EXPECT: stack backtrace:
// EXPECT: vx_panic
// EXPECT: <unknown>
// EXPECT: vx_std_core::ffi::rt::vx_catch_unwind
// EXPECT: vx_catch_unwind

extern {
  fn vx_panic() -> i32;
  fn vx_catch_unwind(f: fn() -> i32) -> i32;
}

struct Resource {
  val: i32,
}

impl Resource {
  fn drop(self: &mut Resource) -> i32 {
    printf("%d
", self.val);
    return 0;
  }
}

fn trigger_panic() -> i32 {
  unsafe {
    vx_panic();
  }
  return 0;
}

fn do_test() -> i32 {
  let mut res = Resource {
    val: 42
  };
  trigger_panic();
  res.drop();
  return 0;
}

fn main() -> i32 {
  unsafe {
    vx_catch_unwind(do_test);
  }
  return 0;
}
