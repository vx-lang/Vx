extern {
  fn vx_panic() -> i32;
  fn vx_catch_unwind(f: fn() -> i32) -> i32;
}

fn f5() -> i32 {
  unsafe {
    vx_panic();
  }
  return 0;
}

fn f4() -> i32 {
  return f5();
}
fn f3() -> i32 {
  return f4();
}
fn f2() -> i32 {
  return f3();
}
fn f1() -> i32 {
  return f2();
}

fn do_test_chain() -> i32 {
  f1();
  return 0;
}

fn do_test_lambda() -> i32 {
  let capture = 42;
  let my_lambda = || f1() + capture;
  my_lambda();
  return 0;
}

fn main() -> i32 {
  unsafe {
    vx_catch_unwind(do_test_chain);
    vx_catch_unwind(do_test_lambda);
  }
  return 0;
}
