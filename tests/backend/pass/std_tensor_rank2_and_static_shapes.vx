// std::tensor's methods on 2-D tensors, and on tensors whose shape is fixed in their type.
// The elements are multiples of 0.5, so every sum is exact in any order. The expected values
// were computed in Python.
//
// The groups, in order:
// 1. a 3-by-4 f64 tensor: sum, mean, max, min; then sum, mean, max and min along axis 0
//    (one per column) and axis 1 (one per row);
// 2. element-wise operations on it, printing row 1 after each;
// 3. max and max along axis 1 with two NaN, one of them the last element; both are ignored;
// 4. the same 3-by-4 values in f32 and in f16: sum and max along axis 0;
// 5. a `Tensor<f32, [2, 3]>`: mean, sum along axis 1;
// 6. a `Tensor<f32, [8]>` calling the 1-D methods: mean, norm, dot, max, then scale and add.
//
// EXPECT: -3.5 -0.2916666666666667 2.5 -2.5 | -2.5 -0.5 1.5 -2 | -0.8333333333333334 -0.16666666666666666 0.5 -0.6666666666666666 | 1 1.5 2.5 1 | -2.5 -2 -1.5 -2.5 | -0.5 -3 0 | -0.125 -0.75 0 | 2.5 1 1.5 | -2.5 -2.5 -1.5 | add 2 -4 1 -5 sub 0 0 0 0 mul 1 4 0.25 6.25 div 2 0.5 3 0.6 scalar 2 -1 1.5 -1.5 scale 2 -4 1 -5 abs 1 2 0.5 2.5 sqrt 1 1.4142135623730951 0.7071067811865476 1.5811388300841898 clamp 1 -0.5 0.5 -0.5 | 2.5 2.5 1 1.5 | -3.5 1 1.5 2.5 1 | -3.5 1 1.5 2.5 1 | 2.5 12 | 3.5 11.83216 28 7 14 15
import std::tensor;

fn value(i : i32, j : i32) -> f64 {
  return ((((i * 7) + (j * 5)) % 11) - 5) as f64 * 0.5;
}

fn print_1d_f64(t : &Tensor<f64, [?]>) -> i32 {
  for k in 0..t.len() {
    print(t[k]);
    print!(" ");
  }
  print!("| ");
  return 0;
}

fn print_row_1(t : &Tensor<f64, [?, ?]>) -> i32 {
  for j in 0..4 {
    print!(" ");
    print(t[1][j]);
  }
  return 0;
}

fn make_f64() -> Tensor<f64, [?, ?]> {
  let mut a = Tensor<f64>([ 3, 4 ]);
  for i in 0..3 {
    for j in 0..4 {
      a[i][j] = value(i, j);
    }
  }
  return a;
}

fn reductions_f64() -> i32 {
  let a = make_f64();
  print(a.sum());
  print!(" ");
  print(a.mean());
  print!(" ");
  print(a.max());
  print!(" ");
  print(a.min());
  print!(" | ");
  for axis in 0..2 {
    let _s = print_1d_f64(&a.sum_axis(axis));
    let _m = print_1d_f64(&a.mean_axis(axis));
    let _x = print_1d_f64(&a.max_axis(axis));
    let _n = print_1d_f64(&a.min_axis(axis));
  }
  return 0;
}

fn elementwise_f64() -> i32 {
  let b = make_f64();
  let mut a = make_f64();
  a.add_assign(&b);
  print!("add");
  let _p0 = print_row_1(&a);
  a.sub_assign(&b);
  a.sub_assign(&b);
  print!(" sub");
  let _p1 = print_row_1(&a);
  let mut c = make_f64();
  c.mul_assign(&b);
  print!(" mul");
  let _p2 = print_row_1(&c);
  let mut d = make_f64();
  d.add_scalar(1.0);
  d.div_assign(&b);
  print!(" div");
  let _p3 = print_row_1(&d);
  let mut e = make_f64();
  e.add_scalar(1.0);
  print!(" scalar");
  let _p4 = print_row_1(&e);
  let mut f = make_f64();
  f.scale(2.0);
  print!(" scale");
  let _p5 = print_row_1(&f);
  let mut g = make_f64();
  g.abs_inplace();
  print!(" abs");
  let _p6 = print_row_1(&g);
  g.sqrt_inplace();
  print!(" sqrt");
  let _p7 = print_row_1(&g);
  let mut h = make_f64();
  h.clamp_inplace(-0.5, 1.0);
  print!(" clamp");
  let _p8 = print_row_1(&h);
  print!(" | ");
  return 0;
}

fn nan_f64() -> i32 {
  let mut a = make_f64();
  let zero : f64 = 0.0;
  a[0][1] = zero / zero;
  a[2][3] = zero / zero;
  print(a.max());
  print!(" ");
  let _m = print_1d_f64(&a.max_axis(1));
  return 0;
}

fn other_widths() -> i32 {
  let mut a = Tensor<f32>([ 3, 4 ]);
  let mut b = Tensor<f16>([ 3, 4 ]);
  for i in 0..3 {
    for j in 0..4 {
      a[i][j] = value(i, j) as f32;
      b[i][j] = value(i, j) as f16;
    }
  }
  print(a.sum());
  let am = a.max_axis(0);
  for k in 0..4 {
    print!(" ");
    print(am[k]);
  }
  print!(" | ");
  print(b.sum());
  let bm = b.max_axis(0);
  for k in 0..4 {
    print!(" ");
    print(bm[k]);
  }
  print!(" | ");
  return 0;
}

fn static_shapes() -> i32 {
  let mut m = Tensor<f32, [2, 3]>::uninit();
  for i in 0..2 {
    for j in 0..3 {
      m[i][j] = (i * 3 + j) as f32;
    }
  }
  print(m.mean());
  print!(" ");
  let rows = m.sum_axis(1);
  print(rows[1]);
  print!(" | ");
  let mut v = Tensor<f32, [8]>::uninit();
  let mut ones = Tensor<f32, [8]>::uninit();
  for i in 0..8 {
    v[i] = i as f32;
    ones[i] = 1.0;
  }
  print(v.mean());
  print!(" ");
  print(v.norm());
  print!(" ");
  print(v.dot(&ones));
  print!(" ");
  print(v.max());
  print!(" ");
  v.scale(2.0);
  print(v[7]);
  print!(" ");
  v.add_assign(&ones);
  print(v[7]);
  return 0;
}

fn main() -> i32 {
  let _a = reductions_f64();
  let _b = elementwise_f64();
  let _c = nan_f64();
  let _d = other_widths();
  let _e = static_shapes();
  return 0;
}
