//===----------------------------------------------------------------------===//
// f16 `erf` and `rsqrt`, ported from LLVM libc's `erff16` and `rsqrtf16` into `core::libm`, on
// every f16 bit pattern: a hash of the result bits of each, NaNs included. The expected hashes are
// LLVM libc's (f475f085bf7b, built with FMA).
//
// EXPECT: 10795121638804074012 14925884034994341956
import core::num;

fn hash(f : i32) -> u64 {
  let mut h : u64 = 0u64;
  for i in 0..65536 {
    let x = libm_f16_from_bits(i as u16);
    let mut r = x.erf();
    if f == 1 {
      r = x.rsqrt();
    }
    h = (h ^ (libm_f16_to_bits(r) as u64)).wrapping_mul(1099511628211u64);
  }
  return h;
}

fn main() -> i32 {
  print(hash(0));
  print!(" ");
  print(hash(1));
  return 0;
}
