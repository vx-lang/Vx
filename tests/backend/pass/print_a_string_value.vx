// `print!` of a `String` prints its text. The test runs with both code generators.
import std::string;
import std::io;

fn main() -> i32 {
  let mut s : String = String::new();
  unsafe { s.push_c_str("hello, "); s.push_c_str("world"); }
  print!(s);
  println!("");
  return 0;
}

// EXPECT: hello, world
