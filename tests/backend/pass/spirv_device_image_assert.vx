//===----------------------------------------------------------------------===//
// The first region has an `assert` and calls `clamp`, which has one too. An
// OpenCL device has no `abort`, so a failed assert prints its message and sets
// a flag. The kernel takes the flag as its last parameter, and its payload says
// `assert_flag=1`. The second region has no assert, so it takes no flag.
// device_image_test.rs checks both images.
//
// RUN: vxc %s --action emit-llvm 2>&1 | FileCheck %s # flat-codegen
// CHECK: assert_flag=1\00format=spirv
// EXPECT: 2 3 1

import core::num;

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached, scope: device
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 63 GB/s
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<f32, [8]>::uninit() };
  let mut lo = unsafe { Tensor<f32, [8]>::uninit() };
  for i in 0..8 {
    a[i] = i as f32;
    lo[i] = 2.0;
  }
  let ga = transfer(a, Memory::DEV_HBM);
  let gl = transfer(lo, Memory::DEV_HBM);
  let mut go = transfer(unsafe { Tensor<f32, [8]>::uninit() }, Memory::DEV_HBM);
  let mut gs = transfer(unsafe { Tensor<f32, [8]>::uninit() }, Memory::DEV_HBM);
  spawn on(Topology::Dev) {
    for i in 0..8 {
      assert(ga[i] >= 0.0, "a negative input");
      go[i] = ga[i].clamp(gl[i], gl[i] + 1.0);
    }
  }
  spawn on(Topology::Dev) {
    for i in 0..8 {
      gs[i] = ga[i] - 2.0;
    }
  }
  let o = transfer(go, Memory::CPU_DRAM);
  let s = transfer(gs, Memory::CPU_DRAM);
  println!("{} {} {}", o[0], o[7], s[3]);
  return 0;
}
