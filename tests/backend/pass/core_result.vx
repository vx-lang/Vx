//===----------------------------------------------------------------------===//
// `core::result`, the Vx `Result<T, E>` that replaces the six C symbols in `std::result`.
//
// Every method is asked of both an `Ok` and an `Err`. One side alone does not tell a
// working method from a broken one: an `is_ok` that always answered true, an `unwrap_or`
// that ignored either the value or the default, and a `map_err` that ran its closure on
// the success instead all pass a test that only ever asks one side.
//
// The closure-taking methods are also asked with a closure whose answer varies, so a
// version that returned a fixed value would show. `and_then` gets an `f` that succeeds
// and one that fails, since its whole purpose is to flatten the second case.
//
// The pair of types differs -- `Result<i32, i64>` as well as `Result<i32, i32>` -- because
// one payload slot holds both variants. With T and E the same width, a slot sized or
// typed for the wrong one still gives the right answer, so a same-type test says nothing
// about the layout. `-3` and the widest `i64` are used for the same reason: their bits
// survive nothing but the correct width.
//
// `map` and `map_err` change the type they answer with, which is what makes the result a
// different monomorphisation from the receiver.
//
// Every value is built where it is used rather than bound first: a `Result` is an enum,
// so it is a linear value and `unwrap` takes it by value.
//
// Each method was broken in turn and reported here separately, except `and_then`: with
// only `v : T` and `f` in scope there is no type-correct way to build a wrong
// `Result<U, E>`, so its body cannot be mutated locally. Its three cases are still asked,
// and the hand-written closure call it uses is the same one `unwrap_or_else` pins.
import core::result;
import core::option;

fn show(flag : bool) -> i32 {
  if flag {
    print(1);
  } else {
    print(0);
  }
  return 0;
}

fn main() -> i32 {
  show(Result<i32, i32>::Ok(5).is_ok());
  print!(" ");
  show(Result<i32, i32>::Err(3).is_ok());
  print!(" ");
  show(Result<i32, i32>::Ok(5).is_err());
  print!(" ");
  show(Result<i32, i32>::Err(3).is_err());
  print!(" ");

  print(Result<i32, i32>::Ok(5).unwrap());
  print!(" ");
  print(Result<i32, i32>::Ok(5).unwrap_or(9));
  print!(" ");
  print(Result<i32, i32>::Err(3).unwrap_or(9));
  print!(" ");

  print(Result<i32, i32>::Ok(5).ok().unwrap());
  print!(" ");
  show(Result<i32, i32>::Err(3).ok().is_none());
  print!(" ");
  print(Result<i32, i32>::Err(3).err().unwrap());
  print!(" ");
  show(Result<i32, i32>::Ok(5).err().is_none());
  print!(" ");

  let k : i32 = 1;
  print(Result<i32, i32>::Ok(20).map(| x : i32 | x + k).unwrap_or(0));
  print!(" ");
  print(Result<i32, i32>::Err(3).map(| x : i32 | x + k).unwrap_or(-1));
  print!(" ");
  print(Result<i32, i32>::Err(3).map_err(| e : i32 | e * 10).err().unwrap());
  print!(" ");
  print(Result<i32, i32>::Ok(5).map_err(| e : i32 | e * 10).unwrap());
  print!(" ");

  print(Result<i32, i32>::Ok(5).and_then(| x : i32 | Result<i32, i32>::Ok(x * 2)).unwrap_or(0));
  print!(" ");
  print(Result<i32, i32>::Ok(5).and_then(| x : i32 | Result<i32, i32>::Err(7)).unwrap_or(-1));
  print!(" ");
  print(Result<i32, i32>::Err(3).and_then(| x : i32 | Result<i32, i32>::Ok(x * 2)).unwrap_or(-1));
  print!(" ");

  print(Result<i32, i32>::Err(3).unwrap_or_else(| e : i32 | e + 100));
  print!(" ");
  print(Result<i32, i32>::Ok(5).unwrap_or_else(| e : i32 | e + 100));
  print!(" ");

  // T and E of different widths, so the payload slot has to hold the wider one and hand
  // each variant back at its own type.
  let big : i64 = 9223372036854775807;
  print(Result<i32, i64>::Err(big).err().unwrap());
  print!(" ");
  print(Result<i32, i64>::Ok(-3).unwrap());
  print!(" ");
  print(Result<i32, i64>::Err(big).unwrap_or(-3));
  print!(" ");
  show(Result<i32, i64>::Ok(-3).err().is_none());
  return 0;
}

// EXPECT: 1 0 0 1 5 5 9 5 1 3 1 21 -1 30 5 10 -1 -1 103 5 9223372036854775807 -3 -3 1
