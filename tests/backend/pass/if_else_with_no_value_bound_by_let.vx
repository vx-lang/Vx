//===----------------------------------------------------------------------===//
// An `if`/`else` whose branches end with `;` has type `void`, and a `let` can
// still bind it. The `if` runs its branch once.
//
// EXPECT: small end

fn main() -> i32 {
  let x : i32 = 3;
  let _v = if x > 5 {
    print("huge ");
  } else {
    print("small ");
  };
  print("end");
  return 0;
}
