//===----------------------------------------------------------------------===//
// A tensor type can name its storage: `Storage::Stack` or `Storage::Heap`.
// Printed: the first element of the stack tensor, then the first element of the heap tensor.
//
// REQUIRES: flat-codegen
// RUN: vxc %s --run 2>&1 | FileCheck %s
//
// CHECK: {{^}}7 9{{$}}

fn main() -> i32 {
  let mut tile : Tensor<f32, [16384], Storage::Stack> = Tensor<f32, [16384], Storage::Stack>::new();
  tile[0] = 7.0;
  let mut small : Tensor<f32, [4], Storage::Heap> = Tensor<f32, [4], Storage::Heap>::new();
  small[0] = 9.0;
  print(tile[0]);
  print!(" ");
  print(small[0]);
  return 0;
}
