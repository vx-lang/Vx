// Regression for #208 + #207: an enum value returned from a generic method
// (`Vec<Option<i32>>::get`) resolves its methods (`is_some`/`is_none`) — the
// enum type argument keeps a nominal head — and its generic-instance type
// lowers to the concrete monomorphized enum layout.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --action run-jit
import std::vec;
import std::io;

fn main() -> i32 {
  let mut v = Vec<Option<i32>>::new();
  v.push(Option<i32>::Some(7));
  v.push(Option<i32>::None());

  let a = v.get(0);
  let b = v.get(1);
  if a.is_some() {
    print!("a=some
");
  }
  if b.is_none() {
    print!("b=none
");
  }
  return 0;
}

// EXPECT: a=some
// EXPECT: b=none

// Both option predicates reach the same `Vec<Option<i32>>` instantiation, so `some` and `none`
// are two values of one element type rather than two element types.
// MLIR: call @"Vec::new$Option$i32"
// MLIR: call @Vec$Option$i32$push$Option$i32
// MLIR: call @Vec$Option$i32$get$Option$i32
// MLIR: call @Option$i32$is_some$i32
// MLIR: call @Option$i32$is_none$i32
