//===- basic_pass.vx ---------------------------------===//
// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM
// RUN: vxc %s
fn process<N, M>(val: Tensor<f32, [N, M]>) -> Verified<Tensor<f32, [N, M]>> {
  assert(N == M, "Tensor must be square");
  return Verified(val);
}

fn main() -> i32 {
  let t: Tensor<f32, [128, 128]> = Tensor_f32(128, 128);
  let v: Verified<Tensor<f32, [128, 128]>> = process(t);
  // NO_EXEC
  return 0;
}

// FRONTEND: module {
// FRONTEND:   func.func private @printMemrefF32(memref<*xf32>)
// FRONTEND:   func.func private @printMemrefF64(memref<*xf64>)
// FRONTEND:   func.func private @printMemrefI32(memref<*xi32>)
// FRONTEND:   func.func private @printMemrefI64(memref<*xi64>)
// FRONTEND:   func.func private @printMemrefBF16(memref<*xbf16>)
// FRONTEND:   func.func @process_Generic128_Generic128(%arg0: memref<128x128xf32>) -> memref<128x128xf32> {
// FRONTEND:     return %arg0 : memref<128x128xf32>
// FRONTEND:   }
// FRONTEND:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// FRONTEND:     %c128_i32 = arith.constant 128 : i32
// FRONTEND:     %0 = arith.index_cast %c128_i32 : i32 to index
// FRONTEND:     %c128_i32_0 = arith.constant 128 : i32
// FRONTEND:     %1 = arith.index_cast %c128_i32_0 : i32 to index
// FRONTEND:     %alloc = memref.alloc(%0, %1) : memref<?x?xf32>
// FRONTEND:     %cast = memref.cast %alloc : memref<?x?xf32> to memref<128x128xf32>
// FRONTEND:     %2 = call @process_Generic128_Generic128(%cast) : (memref<128x128xf32>) -> memref<128x128xf32>
// FRONTEND:     %c0_i32 = arith.constant 0 : i32
// FRONTEND:     return %c0_i32 : i32
// FRONTEND:   }
// FRONTEND: }

// MLIR: module {
// MLIR:   func.func private @printMemrefF32(memref<*xf32>)
// MLIR:   func.func private @printMemrefF64(memref<*xf64>)
// MLIR:   func.func private @printMemrefI32(memref<*xi32>)
// MLIR:   func.func private @printMemrefI64(memref<*xi64>)
// MLIR:   func.func private @printMemrefBF16(memref<*xbf16>)
// MLIR:   func.func @process_Generic128_Generic128(%arg0: memref<128x128xf32>) -> memref<128x128xf32> {
// MLIR:     return %arg0 : memref<128x128xf32>
// MLIR:   }
// MLIR:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// MLIR:     %c0_i32 = arith.constant 0 : i32
// MLIR:     %c128 = arith.constant 128 : index
// MLIR:     %alloc = memref.alloc(%c128, %c128) : memref<?x?xf32>
// MLIR:     %cast = memref.cast %alloc : memref<?x?xf32> to memref<128x128xf32>
// MLIR:     %0 = call @process_Generic128_Generic128(%cast) : (memref<128x128xf32>) -> memref<128x128xf32>
// MLIR:     return %c0_i32 : i32
// MLIR:   }
// MLIR: }

// LLVM: ; ModuleID = 'LLVMDialectModule'
// LLVM: source_filename = "LLVMDialectModule"
// LLVM: declare ptr @malloc(i64)
// LLVM: declare void @printMemrefF32(i64, ptr)
// LLVM: declare void @printMemrefF64(i64, ptr)
// LLVM: declare void @printMemrefI32(i64, ptr)
// LLVM: declare void @printMemrefI64(i64, ptr)
// LLVM: declare void @printMemrefBF16(i64, ptr)
// LLVM: define { ptr, ptr, i64, [2 x i64], [2 x i64] } @process_Generic128_Generic128(ptr %0, ptr %1, i64 %2, i64 %3, i64 %4, i64 %5, i64 %6) {
// LLVM:   %8 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } poison, ptr %0, 0
// LLVM:   %9 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, ptr %1, 1
// LLVM:   %10 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %9, i64 %2, 2
// LLVM:   %11 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %10, i64 %3, 3, 0
// LLVM:   %12 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %11, i64 %5, 4, 0
// LLVM:   %13 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %12, i64 %4, 3, 1
// LLVM:   %14 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %13, i64 %6, 4, 1
// LLVM:   ret { ptr, ptr, i64, [2 x i64], [2 x i64] } %14
// LLVM: }
// LLVM: define i32 @main() {
// LLVM:   %1 = call ptr @malloc(i64 65536)
// LLVM:   %2 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } poison, ptr %1, 0
// LLVM:   %3 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %2, ptr %1, 1
// LLVM:   %4 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %3, i64 0, 2
// LLVM:   %5 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %4, i64 128, 3, 0
// LLVM:   %6 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %5, i64 128, 3, 1
// LLVM:   %7 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %6, i64 128, 4, 0
// LLVM:   %8 = insertvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %7, i64 1, 4, 1
// LLVM:   %9 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 0
// LLVM:   %10 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 1
// LLVM:   %11 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 2
// LLVM:   %12 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 3, 0
// LLVM:   %13 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 3, 1
// LLVM:   %14 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 4, 0
// LLVM:   %15 = extractvalue { ptr, ptr, i64, [2 x i64], [2 x i64] } %8, 4, 1
// LLVM:   %16 = call { ptr, ptr, i64, [2 x i64], [2 x i64] } @process_Generic128_Generic128(ptr %9, ptr %10, i64 %11, i64 %12, i64 %13, i64 %14, i64 %15)
// LLVM:   ret i32 0
// LLVM: }
// LLVM: define i32 @_mlir_ciface_main() {
// LLVM:   %1 = call i32 @main()
// LLVM:   ret i32 %1
// LLVM: }
// LLVM: !llvm.module.flags = !{!0}
// LLVM: !0 = !{i32 2, !"Debug Info Version", i32 3}

