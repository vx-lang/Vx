//===- basic_pass.vx ---------------------------------===//
// RUN: vxc %s
// RUN: vxc --emit-mlir %s | FileCheck %s
fn process<N, M>(val: Tensor<f32, [N, M]>) -> Verified<Tensor<f32, [N, M]>> {
  assert(N == M, "Tensor must be square");
  return Verified(val);
}

fn main() -> i32 {
  let t: Tensor<f32, [128, 128]> = Tensor_f32(128, 128);
  let v: Verified<Tensor<f32, [128, 128]>> = process(t);
  // NO_EXEC
  return 0;
}

// CHECK: "builtin.module"() ({
// CHECK:   "func.func"() <{function_type = (memref<128x128xf32>) -> memref<128x128xf32>, sym_name = "process_Generic128_Generic128"}> ({
// CHECK:   ^bb0(%arg0: memref<128x128xf32>):
// CHECK:     "func.return"(%arg0) : (memref<128x128xf32>) -> ()
// CHECK:   }) : () -> ()
// CHECK:   "func.func"() <{function_type = () -> i32, sym_name = "main"}> ({
// CHECK:     %0 = "builtin.unrealized_conversion_cast"() : () -> memref<?x?xf32>
// CHECK:     %1 = "func.call"(%0) <{callee = @process_Generic128_Generic128}> : (memref<?x?xf32>) -> memref<128x128xf32>
// CHECK:     %2 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK:     "func.return"(%2) : (i32) -> ()
// CHECK:   }) {llvm.emit_c_interface} : () -> ()
// CHECK: }) : () -> ()
