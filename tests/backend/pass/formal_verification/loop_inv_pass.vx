//===- loop_inv_pass.vx ---------------------------------===//
// RUN: vxc %s

fn test_loop_0(N: i32) -> i32
requires N > 5
ensures return > 0
{
    for i in 0..10 invariant(N > 5) {
        let dummy = N;
    }
    return N;
}

