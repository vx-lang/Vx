//===- loop_inv_pass.vx ---------------------------------===//
// RUN: vxc %s

fn test_loop_0(N: i32) -> i32
requires N > 73
ensures return > 68
{
    for j in 0..10 invariant(N > 73) {
        let dummy = N;
    }
    return N;
}

