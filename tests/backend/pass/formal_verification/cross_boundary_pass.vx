//===- cross_boundary_pass.vx ---------------------------------===//
// RUN: vxc %s
// RUN: vxc --emit-mlir %s

fn wrap<N, M>(val: Tensor<f32, [N, M]>) -> Verified<Tensor<f32, [N, M]>> {
  assert(N == M, "Must be square");
  return Verified(val);
}

fn outer<A, B>(t: Tensor<f32, [A, B]>) -> Verified<Tensor<f32, [A, B]>> {
  assert(A == B, "Pass along constraint");
  return wrap(t);
}

fn main() -> i32 {
  let n: i32 = 10;
  let m: i32 = 10;
  assert(n == m, "Proving bounds dynamically");
  let t: Tensor<f32, [n, m]> = Tensor_f32(n, m);
  let v: Verified<Tensor<f32, [n, m]>> = outer(t);
  // NO_EXEC
  return 0;
}

// CHECK: module {
// CHECK:   func.func @wrap_Genericn_Genericm(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @outer_Genericn_Genericm(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     %0 = call @wrap_Genericn_Genericm(%arg0) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     return %0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     %c10_i32 = arith.constant 10 : i32
// CHECK:     %c10_i32_0 = arith.constant 10 : i32
// CHECK:     %0 = builtin.unrealized_conversion_cast to memref<?x?xf32>
// CHECK:     %1 = call @outer_Genericn_Genericm(%0) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK: }




