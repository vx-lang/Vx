//===- advanced_pass.vx ---------------------------------===//
// RUN: vxc %s
// RUN: vxc --emit-mlir %s | FileCheck %s

fn check_complex_logic<A, B>(val: Tensor<f32, [A, B]>) -> Verified<Tensor<f32, [A, B]>> {
  assert(A == 10 || B == 20, "Logical OR constraint");
  assert(A > 0 && B > 0, "Positive bounds");
  assert(A + B == 30, "Sum constraint");
  return Verified(val);
}

fn test_inference<N, M>(val: Tensor<f32, [N, M]>) -> Verified<Tensor<f32, [N, M]>> {
  assert(N == M, "Square constraint");
  assert(N * 2 == M * 2, "Proved by arithmetic but structural for now");
  return Verified(val);
}

fn nested_verified<X, Y>(t: Tensor<f32, [X, Y]>) -> Verified<Tensor<f32, [X, Y]>> {
  assert(X == Y, "Outer condition");
  return test_inference(t);
}

fn compound_math_constraint<K, L>(t: Tensor<f32, [K, L]>) -> Verified<Tensor<f32, [K, L]>> {
  assert((K * 2) + (L * 3) == 100, "Linear equation constraint");
  return Verified(t);
}

fn multi_transitive_bounds<A, D>(t: Tensor<f32, [A, D]>, b: i32, c: i32) -> Verified<Tensor<f32, [A, D]>> {
  assert(A == b, "A equals b");
  assert(b == c, "b equals c");
  assert(c == D, "c equals D");
  // Check if our BFS solver can find A == D
  let res: Verified<Tensor<f32, [A, D]>> = test_inference(t);
  return res;
}

fn main() -> i32 {
  // Test 1: Complex logic
  let x: i32 = 10;
  let y: i32 = 20;
  assert(x == 10 || y == 20, "Dynamic logic");
  assert(x > 0 && y > 0, "Dynamic bounds");
  assert(x + y == 30, "Dynamic sum");
  let t1: Tensor<f32, [x, y]> = Tensor_f32(x, y);
  let v1 = check_complex_logic(t1);

  // Test 2: Inference and Nested
  let sixteen: i32 = 16;
  assert(sixteen == sixteen, "Dynamic square");
  assert(sixteen * 2 == sixteen * 2, "Dynamic math");
  let t2: Tensor<f32, [sixteen, sixteen]> = Tensor_f32(sixteen, sixteen);
  let v2 = nested_verified(t2);

  // Test 3: Compound Math
  let twenty: i32 = 20;
  assert((twenty * 2) + (twenty * 3) == 100, "Linear eq hold");
  let t3: Tensor<f32, [twenty, twenty]> = Tensor_f32(twenty, twenty);
  let v3 = compound_math_constraint(t3);

  // Test 4: Multi transitive bounds
  let a: i32 = 5;
  let b: i32 = 5;
  let c: i32 = 5;
  let d: i32 = 5;
  assert(a == b, "a=b");
  assert(b == c, "b=c");
  assert(c == d, "c=d");
  assert(a == d, "Needed for test_inference inner constraint");
  assert(a * 2 == d * 2, "Needed for test_inference inner constraint");
  let t4: Tensor<f32, [a, d]> = Tensor_f32(a, d);
  let v4 = multi_transitive_bounds(t4, b, c);

  // NO_EXEC
  return 0;
}

// CHECK: module {
// CHECK:   func.func @check_complex_logic_Genericx_Genericy(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @test_inference_Genericsixteen_Genericsixteen(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @nested_verified_Genericsixteen_Genericsixteen(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     %0 = call @test_inference_Genericsixteen_Genericsixteen(%arg0) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     return %0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @compound_math_constraint_Generictwenty_Generictwenty(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @test_inference_Generica_Genericd(%arg0: memref<?x?xf32>) -> memref<?x?xf32> {
// CHECK:     return %arg0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @multi_transitive_bounds_Generica_Genericd(%arg0: memref<?x?xf32>, %arg1: i32, %arg2: i32) -> memref<?x?xf32> {
// CHECK:     %0 = call @test_inference_Generica_Genericd(%arg0) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     return %0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK:     %c10_i32 = arith.constant 10 : i32
// CHECK:     %c20_i32 = arith.constant 20 : i32
// CHECK:     %0 = builtin.unrealized_conversion_cast to memref<?x?xf32>
// CHECK:     %1 = call @check_complex_logic_Genericx_Genericy(%0) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     %c16_i32 = arith.constant 16 : i32
// CHECK:     %2 = builtin.unrealized_conversion_cast to memref<?x?xf32>
// CHECK:     %3 = call @nested_verified_Genericsixteen_Genericsixteen(%2) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     %c20_i32_0 = arith.constant 20 : i32
// CHECK:     %4 = builtin.unrealized_conversion_cast to memref<?x?xf32>
// CHECK:     %5 = call @compound_math_constraint_Generictwenty_Generictwenty(%4) : (memref<?x?xf32>) -> memref<?x?xf32>
// CHECK:     %c5_i32 = arith.constant 5 : i32
// CHECK:     %c5_i32_1 = arith.constant 5 : i32
// CHECK:     %c5_i32_2 = arith.constant 5 : i32
// CHECK:     %c5_i32_3 = arith.constant 5 : i32
// CHECK:     %6 = builtin.unrealized_conversion_cast to memref<?x?xf32>
// CHECK:     %7 = call @multi_transitive_bounds_Generica_Genericd(%6, %c5_i32_1, %c5_i32_2) : (memref<?x?xf32>, i32, i32) -> memref<?x?xf32>
// CHECK:     %c0_i32 = arith.constant 0 : i32
// CHECK:     return %c0_i32 : i32
// CHECK:   }
// CHECK: }
