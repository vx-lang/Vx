//===- math_pass.vx ---------------------------------===//
// RUN: vxc %s
// RUN: vxc --emit-mlir %s | FileCheck %s

fn verify_math<N, M>(val: Tensor<f32, [N, M]>) -> Verified<Tensor<f32, [N, M]>> {
  // Test multiplication, addition, division, and logical operators
  // N=16, M=32
  assert(N * M + 8 == 520, "Math constraint failed");
  assert(520 - N * M == 8, "Inverse math constraint failed");
  assert(N > 0 && M > 0, "Dimensions must be positive");
  assert(M >= N, "M must be greater than or equal to N");
  assert((N + 4) * (M - 2) == 600, "Compound math constraint 1");
  assert((N * 2) + (M / 2) == 48, "Compound math constraint 2");
  assert((N > 0) && (M > 0) || (N == M), "Compound logical constraint");
  return Verified(val);
}

fn main() -> i32 {
  let t: Tensor<f32, [16, 32]> = Tensor_f32(16, 32);
  let v: Verified<Tensor<f32, [16, 32]>> = verify_math(t);
  // NO_EXEC
  return 0;
}

// CHECK: "builtin.module"() ({
// CHECK:   "func.func"() <{function_type = (memref<16x32xf32>) -> memref<16x32xf32>, sym_name = "verify_math_Generic16_Generic32"}> ({
// CHECK:   ^bb0(%arg0: memref<16x32xf32>):
// CHECK:     "func.return"(%arg0) : (memref<16x32xf32>) -> ()
// CHECK:   }) : () -> ()
// CHECK:   "func.func"() <{function_type = () -> i32, sym_name = "main"}> ({
// CHECK:     %0 = "builtin.unrealized_conversion_cast"() : () -> memref<?x?xf32>
// CHECK:     %1 = "func.call"(%0) <{callee = @verify_math_Generic16_Generic32}> : (memref<?x?xf32>) -> memref<16x32xf32>
// CHECK:     %2 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK:     "func.return"(%2) : (i32) -> ()
// CHECK:   }) {llvm.emit_c_interface} : () -> ()
// CHECK: }) : () -> ()
