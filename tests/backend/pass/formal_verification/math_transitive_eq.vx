//===- math_transitive_eq.vx ---------------------------------===//
// RUN: vxc %s --emit-mlir -O0
// RUN: vxc %s


fn verify_transitivity<A, B>(val: Tensor<f32, [A, B]>) -> Verified<Tensor<f32, [A, B]>> {
  let C: i32 = A;
  let D: i32 = C;
  assert(A == B, "A = B");
  assert(B == C, "B = C");
  assert(C == D, "C = D");

  assert(A == D, "A must equal D transitively");
  return Verified(val);
}

fn main() -> i32 {
  let t: Tensor<f32, [10, 10]> = Tensor_f32(10, 10);
  let v: Verified<Tensor<f32, [10, 10]>> = verify_transitivity(t);
  return 0;
}

