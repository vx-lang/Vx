//===- verified_coercion.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s

fn test_valid_verified_assignment() -> i32 {
  let dim: i32 = 10;
  let unverified: Tensor<f32, [dim, dim]> = Tensor<f32>([dim, dim]);
  // Explicit unwrap/wrap is required, but once it is verified, it can be assigned to another verified variable
  let verified1: Verified<Tensor<f32, [dim, dim]>> = Verified(unverified);
  let verified2: Verified<Tensor<f32, [dim, dim]>> = verified1;
  return 0;
}

fn main() -> i32 {
  return test_valid_verified_assignment();
}
