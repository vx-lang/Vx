//===- complex_ineq_pass.vx ---------------------------------===//
// RUN: vxc %s

fn test_complex_0(X: i32, Y: i32, Z: i32) -> i32
requires X >= Y && Y >= Z
ensures return >= 0
{
    let diff = X - Z;
    return diff;
}

