//===- complex_ineq_pass.vx ---------------------------------===//
// RUN: vxc %s

fn test_complex_0(X: i32, Y: i32, Z: i32) -> i32
requires X >= Y && Y >= Z + 20
ensures return >= 20
{
    let diff = X - Z;
    return diff;
}

