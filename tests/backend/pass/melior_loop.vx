// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
fn main() -> i32 {
  let mut sum = 0;
  for i in 0..10 {
    if i > 5 {
      sum = sum + i;
    }
  }
  return 0;
}
