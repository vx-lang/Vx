// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The loop lowers to an affine loop. Its body holds an `if`, so the body is a region of
// blocks: one that compares the loop variable, and one that stores to sum.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: memref.store %{{.*}}, %[[SUM:[a-z0-9_]+]][] : memref<i32>
// CHECK: affine.for %{{.*}} = 0 to 10 {
// CHECK: scf.execute_region {
// CHECK: arith.cmpi sgt
// CHECK: cf.cond_br
// CHECK: memref.store %{{.*}}, %[[SUM]][] : memref<i32>
// CHECK: scf.yield
fn main() -> i32 {
  let mut sum = 0;
  for i in 0..10 {
    if i > 5 {
      sum = sum + i;
    }
  }
  return 0;
}
