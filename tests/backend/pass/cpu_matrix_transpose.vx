//===- cpu_matrix_transpose.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=LLVM
// FileCheck %s

fn test_f32() -> i32 {
  let mut a = Tensor<f32, [4, 4]>::uninit();
  let mut c = Tensor<f32, [4, 4]>::uninit();

  let mut counter : f32 = 0.0;
  for i in 0..4 {
    for j in 0..4 {
      a[i][j] = counter;
      counter = counter + 1.0;
    }
  }

  for i in 0..4 {
    for j in 0..4 {
      c[j][i] = a[i][j];
    }
  }

  assert(c[0][1] == 4.0, "f32 c[0][1] match");
  assert(c[1][0] == 1.0, "f32 c[1][0] match");
  assert(c[3][2] == 11.0, "f32 c[3][2] match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = Tensor<bf16, [4, 4]>::uninit();
  let mut c = Tensor<bf16, [4, 4]>::uninit();

  let mut counter : bf16 = 0.0;
  for i in 0..4 {
    for j in 0..4 {
      a[i][j] = counter;
      counter = counter + 1.0;
    }
  }

  for i in 0..4 {
    for j in 0..4 {
      c[j][i] = a[i][j];
    }
  }

  assert(c[0][1] == 4.0, "bf16 c[0][1] match");
  assert(c[1][0] == 1.0, "bf16 c[1][0] match");
  assert(c[3][2] == 11.0, "bf16 c[3][2] match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// Before the pass the extents are still i32 values that have to be cast to index; the buffer
// is allocated from those casts.
// CHECK-LABEL: func.func @test_f32() -> i32
// CHECK: %[[N:.*]] = arith.index_cast %{{.*}} : i32 to index
// CHECK: memref.alloc(%[[N:.*]], %[[M:.*]]) : memref<?x?xf32>

// convert-vx-to-standard folds them, so the same allocation reads from index constants.
// STD-LABEL: func.func @test_f32() -> i32
// STD: %[[C:.*]] = arith.constant {{[0-9]+}} : index
// STD: memref.alloc(%[[C:.*]], %[[D:.*]]) : memref<?x?xf32>

// --emit-llvm stops at the LLVM dialect, where the same function is an llvm.func and the
// buffers are raw allocations rather than memrefs.
// LLVM-LABEL: llvm.func @test_f32() -> i32
// LLVM: llvm.call @malloc
// LLVM: llvm.func @main() -> i32
