//===----------------------------------------------------------------------===//
// `&p.b` is valid as long as `p`, so a reference declared next to `p` can take it inside an
// `if` or a loop.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=declined
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}2{{$}}
// CHECK-NEXT: {{^}}30{{$}}

struct Pair {
  a : i32,
  b : i32,
}

fn larger(p : &Pair) -> i32 {
  let mut r = &p.a;
  if p.a < p.b {
    r = &p.b;
  }
  return *r;
}

fn main() -> i32 {
  let p = Pair {
    a : 1, b : 2
  };
  println!("{}", larger(&p));
  let q = Pair {
    a : 10, b : 30
  };
  let mut r = &q.a;
  let mut i = 0;
  while i < 2 {
    if i == 1 {
      r = &q.b;
    }
    i = i + 1;
  }
  println!("{}", *r);
  return 0;
}
