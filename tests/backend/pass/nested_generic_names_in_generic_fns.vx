//===----------------------------------------------------------------------===//
// A generic function that spells a nested generic name with its own parameters in it.
//
// Monomorphizing `wrap<i64>` rewrites `Holder<Pair<T, T>>` to `Holder<Pair<i64, i64>>`. That
// rewrite substituted whole arguments after splitting on every comma, so it saw `Pair<T` and
// `T>`, matched neither, and left the `T` inside in place.
//
//   wrap     11   a struct literal whose nested argument carries `T`
//   second    9   a match pattern spelled with a nested generic, inside a generic function
import core::option;

struct Pair<A, B> {
  a : A,
  b : B,
}

struct Holder<P> {
  p : P,
}

fn wrap<T>(x : T, y : T) -> Holder<Pair<T, T>> {
  return Holder<Pair<T, T>> {
    p : Pair<T, T> {
      a : x, b : y
    }
  };
}

fn some_pair<T>(x : T, y : T) -> Option<Pair<T, T>> {
  return Option<Pair<T, T>>::Some(Pair<T, T> {
    a : x, b : y
  });
}

fn second<T>(o : Option<Pair<T, T>>, d : T) -> T {
  match o {
    Option<Pair<T, T>>::Some(p) => {
      return p.b;
    }
    Option<Pair<T, T>>::None => {
      return d;
    }
  }
  return d;
}

fn main() -> i32 {
  let h = wrap<i64>(5i64, 6i64);
  print(h.p.a + h.p.b);
  print!(" ");
  print(second<i64>(some_pair<i64>(8i64, 9i64), 0i64));
  return 0;
}

// EXPECT: 11 9
