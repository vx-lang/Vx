//
// EXPECT: file options and seek_to work
// Each `OpenOptions` choice opens the file as its doc says, and `seek_to` moves to the right
// position. Options that do not go together and a seek before the start of the file give
// `InvalidInput`. `create_new` on a file that exists gives `AlreadyExists`.
import core::result;
import std::fs;
import std::string;
import std::vec;

extern {
  fn vx_get_temp_file(name : *const i8) -> *mut i8;
  fn vx_free_temp_file(path : *mut i8) -> i32;
  fn remove(path : *const i8) -> i32;
}

fn is_invalid_input(error : FileError) -> bool {
  return match error {
    FileError::InvalidInput => {
      true
    }, _ => {
      false
    }
  };
}

fn one_byte(value : u8) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  bytes.push(value);
  return bytes;
}

fn main(root : Root) -> i32 {
  let c_path = unsafe { vx_get_temp_file("file_options_seek") };
  unsafe { remove(c_path); }
  let path = unsafe { String::from_c_str(c_path) };
  let files = &root.files;

  let empty = OpenOptions::new().open(files, &path);
  assert(empty.is_err(), "options with no choice on did not give an error");
  assert(is_invalid_input(empty.unwrap_err()), "options with no choice on did not give InvalidInput");
  let create_alone = OpenOptions::new().create(true).open(files, &path);
  assert(create_alone.is_err(), "create without write did not give an error");
  assert(is_invalid_input(create_alone.unwrap_err()), "create without write did not give InvalidInput");

  let created = OpenOptions::new().read(true).write(true).create_new(true).open(files, &path);
  assert(created.is_ok(), "create_new of a new path failed");
  let mut file = created.unwrap();
  let written = file.write(&one_byte(65u8));
  assert(written.is_ok(), "the write after create_new failed");
  assert(written.unwrap() == 1, "the write after create_new did not take one byte");

  let after_write = file.stream_position();
  assert(after_write.is_ok(), "stream_position after the write failed");
  assert(after_write.unwrap() == 1, "stream_position after the write is not 1");
  let back_one = file.seek_to(SeekFrom::Current(-1));
  assert(back_one.is_ok(), "a seek of -1 failed");
  assert(back_one.unwrap() == 0, "a seek of -1 did not go to 0");
  let to_end = file.seek_to(SeekFrom::End(0));
  assert(to_end.is_ok(), "a seek to the end failed");
  assert(to_end.unwrap() == 1, "a seek to the end did not go to 1");
  let to_start = file.seek_to(SeekFrom::Start(0));
  assert(to_start.is_ok(), "a seek to the start failed");
  assert(to_start.unwrap() == 0, "a seek to the start did not go to 0");
  let mut read_back = one_byte(0u8);
  let read = file.read(&mut read_back);
  assert(read.is_ok(), "the read failed");
  assert(read.unwrap() == 1, "the read did not get one byte");
  assert(read_back.get(0) == 65u8, "the read did not get the byte that the write took");
  let to_start_again = file.seek_to(SeekFrom::Start(0));
  assert(to_start_again.is_ok(), "a seek to the start after the read failed");
  assert(to_start_again.unwrap() == 0, "a seek to the start after the read did not go to 0");
  let before_start = file.seek_to(SeekFrom::Current(-1));
  assert(before_start.is_err(), "a seek before the start of the file did not give an error");
  assert(is_invalid_input(before_start.unwrap_err()), "a seek before the start did not give InvalidInput");
  drop(file);

  let duplicate = OpenOptions::new().write(true).create_new(true).open(files, &path);
  assert(duplicate.is_err(), "create_new of a path that exists did not give an error");
  let exists = match duplicate.unwrap_err() {
    FileError::AlreadyExists => {
      true
    }, _ => {
      false
    }
  };
  assert(exists, "create_new of a path that exists did not give AlreadyExists");

  let opened_to_write = OpenOptions::new().write(true).open(files, &path);
  assert(opened_to_write.is_ok(), "the open with write alone failed");
  let mut kept = opened_to_write.unwrap();
  let kept_end = kept.seek_to(SeekFrom::End(0));
  assert(kept_end.is_ok(), "a seek to the end with write alone failed");
  assert(kept_end.unwrap() == 1, "write alone did not keep the byte in the file");
  drop(kept);

  let opened_to_append = OpenOptions::new().append(true).open(files, &path);
  assert(opened_to_append.is_ok(), "the open with append failed");
  let mut appended = opened_to_append.unwrap();
  let append_start = appended.seek_to(SeekFrom::Start(0));
  assert(append_start.is_ok(), "a seek to the start with append failed");
  assert(append_start.unwrap() == 0, "a seek to the start with append did not go to 0");
  let append_write = appended.write(&one_byte(66u8));
  assert(append_write.is_ok(), "the write with append failed");
  assert(append_write.unwrap() == 1, "the write with append did not take one byte");
  let after_append = appended.stream_position();
  assert(after_append.is_ok(), "stream_position after the append failed");
  assert(after_append.unwrap() == 2, "the append did not write at the end of the file");
  drop(appended);

  let not_truncated = OpenOptions::new().write(true).truncate(true).truncate(false).read(true);
  let opened_not_truncated = not_truncated.open(files, &path);
  assert(opened_not_truncated.is_ok(), "the open with truncate turned off failed");
  let mut reader = opened_not_truncated.unwrap();
  let reader_end = reader.seek_to(SeekFrom::End(0));
  assert(reader_end.is_ok(), "a seek to the end with truncate turned off failed");
  assert(reader_end.unwrap() == 2, "truncate turned off did not keep the two bytes");
  drop(reader);

  let read_only = OpenOptions::new().read(true).write(true).write(false);
  let opened_read_only = read_only.open(files, &path);
  assert(opened_read_only.is_ok(), "the open with write turned off failed");
  let mut only_reads = opened_read_only.unwrap();
  assert(only_reads.write(&one_byte(67u8)).is_err(), "a write with write turned off did not give an error");
  assert(only_reads.seek_to(SeekFrom::Start(18446744073709551615u64)).is_err(), "a start offset above i64 did not give an error");
  drop(only_reads);

  let truncating = OpenOptions::new().write(true).truncate(true).open(files, &path);
  assert(truncating.is_ok(), "the open with truncate failed");
  let mut truncated = truncating.unwrap();
  let truncated_end = truncated.seek_to(SeekFrom::End(0));
  assert(truncated_end.is_ok(), "a seek to the end after truncate failed");
  assert(truncated_end.unwrap() == 0, "truncate did not make the file empty");
  drop(truncated);
  unsafe { remove(c_path); vx_free_temp_file(c_path); }
  println!("file options and seek_to work");
  return 0;
}
