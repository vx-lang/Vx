//
// EXPECT: file options and seek_to work
// Each `OpenOptions` choice opens the file as its doc says, and `seek_to` moves to the right
// position. Options that do not go together and a seek before the start of the file give
// `InvalidInput`. `create_new` on a file that exists gives `AlreadyExists`.
import core::result;
import std::fs;
import std::string;
import std::vec;

extern {
  fn vx_get_temp_file(name : *const i8) -> *mut i8;
  fn vx_free_temp_file(path : *mut i8) -> i32;
  fn remove(path : *const i8) -> i32;
}

fn is_invalid_input(error : FileError) -> bool {
  return match error {
    FileError::InvalidInput => {
      true
    }, _ => {
      false
    }
  };
}

fn one_byte(value : u8) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  bytes.push(value);
  return bytes;
}

fn main(root : Root) -> i32 {
  let c_path = unsafe { vx_get_temp_file("file_options_seek") };
  unsafe { remove(c_path); }
  let path = unsafe { String::from_c_str(c_path) };
  let files = &root.files;

  let empty = OpenOptions::new().open(files, &path);
  assert(empty.is_err(), "options with no choice on did not give an error");
  assert(is_invalid_input(empty.unwrap_err()), "options with no choice on did not give InvalidInput");
  let create_alone = OpenOptions::new().create(true).open(files, &path);
  assert(is_invalid_input(create_alone.unwrap_err()), "create without write did not give InvalidInput");

  let created = OpenOptions::new().read(true).write(true).create_new(true).open(files, &path);
  assert(created.is_ok(), "create_new of a new path failed");
  let mut file = created.unwrap();
  let written = file.write(&one_byte(65u8));
  assert(written.is_ok(), "the write after create_new failed");
  assert(written.unwrap() == 1, "the write after create_new did not take one byte");

  assert(file.stream_position().unwrap() == 1, "stream_position after the write is not 1");
  assert(file.seek_to(SeekFrom::Current(-1)).unwrap() == 0, "a seek of -1 did not go to 0");
  assert(file.seek_to(SeekFrom::End(0)).unwrap() == 1, "a seek to the end did not go to 1");
  assert(file.seek_to(SeekFrom::Start(0)).unwrap() == 0, "a seek to the start did not go to 0");
  let mut read_back = one_byte(0u8);
  assert(file.read(&mut read_back).unwrap() == 1, "the read did not get one byte");
  assert(read_back.get(0) == 65u8, "the read did not get the byte that the write took");
  assert(file.seek_to(SeekFrom::Start(0)).unwrap() == 0, "a seek to the start after the read did not go to 0");
  let before_start = file.seek_to(SeekFrom::Current(-1));
  assert(before_start.is_err(), "a seek before the start of the file did not give an error");
  assert(is_invalid_input(before_start.unwrap_err()), "a seek before the start did not give InvalidInput");
  drop(file);

  let duplicate = OpenOptions::new().write(true).create_new(true).open(files, &path);
  let exists = match duplicate.unwrap_err() {
    FileError::AlreadyExists => {
      true
    }, _ => {
      false
    }
  };
  assert(exists, "create_new of a path that exists did not give AlreadyExists");

  let mut kept = OpenOptions::new().write(true).open(files, &path).unwrap();
  assert(kept.seek_to(SeekFrom::End(0)).unwrap() == 1, "write alone did not keep the byte in the file");
  drop(kept);

  let mut appended = OpenOptions::new().append(true).open(files, &path).unwrap();
  assert(appended.seek_to(SeekFrom::Start(0)).unwrap() == 0, "a seek to the start with append failed");
  assert(appended.write(&one_byte(66u8)).unwrap() == 1, "the write with append did not take one byte");
  assert(appended.stream_position().unwrap() == 2, "the append did not write at the end of the file");
  drop(appended);

  let not_truncated = OpenOptions::new().write(true).truncate(true).truncate(false).read(true);
  let mut reader = not_truncated.open(files, &path).unwrap();
  assert(reader.seek_to(SeekFrom::End(0)).unwrap() == 2, "truncate turned off did not keep the two bytes");
  drop(reader);

  let read_only = OpenOptions::new().read(true).write(true).write(false);
  let mut only_reads = read_only.open(files, &path).unwrap();
  assert(only_reads.write(&one_byte(67u8)).is_err(), "a write with write turned off did not give an error");
  assert(only_reads.seek_to(SeekFrom::Start(18446744073709551615u64)).is_err(), "a start offset above i64 did not give an error");
  drop(only_reads);

  let truncating = OpenOptions::new().write(true).truncate(true).open(files, &path);
  let mut truncated = truncating.unwrap();
  assert(truncated.seek_to(SeekFrom::End(0)).unwrap() == 0, "truncate did not make the file empty");
  drop(truncated);
  unsafe { remove(c_path); vx_free_temp_file(c_path); }
  println!("file options and seek_to work");
  return 0;
}
