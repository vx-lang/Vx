//===----------------------------------------------------------------------===//
// A `match` on a tuple with enum variants in its patterns, used as a value.
//
// EXPECT: 1 7 2
import core::option;

fn tag(a : Option<i32>, n : i32) -> i32 {
  let t = (a, n);
  let r : i32 = match t {
    (Option<i32>::None(), 0) => {
      1
    }, (Option<i32>::Some(v), k) => {
      v + k
    }, _ => {
      2
    }
  };
  return r;
}

fn main() -> i32 {
  print(tag(Option<i32>::None(), 0));
  print!(" ");
  print(tag(Option<i32>::Some(3), 4));
  print!(" ");
  print(tag(Option<i32>::None(), 5));
  return 0;
}
