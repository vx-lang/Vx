// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// A `return` inside an `unsafe` block returns from the function, so a function
// whose last statement is such a block needs no `return` after it. This used to
// be refused with E3028, "its body can finish without returning a value".
//
// CHECK-DAG: func.func @pick(%arg0: i1) -> i32
// CHECK-DAG: func.func @main() -> i32

// One branch returns from inside `unsafe`, the other directly.
fn pick(c : bool) -> i32 {
  if c {
    unsafe { return 1; }
  } else {
    return 2;
  }
}

fn main() -> i32 {
  if pick(true) != 1 {
    return 1;
  }
  if pick(false) != 2 {
    return 2;
  }
  unsafe { return 0; }
}
