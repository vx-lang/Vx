// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

import std::io;

fn main() -> i32 {
  comptime {
    let size_f32 : i64 = sizeof<f32>();
    let size_i32 : i64 = sizeof<i32>();
    let size_f64 : i64 = sizeof<f64>();
    let size_i64 : i64 = sizeof<i64>();
    let size_i8 : i64 = sizeof<i8>();
    let size_bool : i64 = sizeof<bool>();
    assert(size_f32 == 4);
    assert(size_i32 == 4);
    assert(size_f64 == 8);
    assert(size_i64 == 8);
    assert(size_i8 == 1);
    assert(size_bool == 1);
  }

  return 0;
}

// CHECK-LABEL: func.func @main
// CHECK: arith.constant 4 : i64
// CHECK: arith.constant 4 : i64
// CHECK: arith.constant 8 : i64
// CHECK: arith.constant 8 : i64
// CHECK: arith.constant 1 : i64
// CHECK: arith.constant 1 : i64
