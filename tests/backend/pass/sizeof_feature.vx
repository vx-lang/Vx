// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

import std::io;

fn main() -> i32 {
  comptime {
    let size_f32 : i64 = sizeof<f32>();
    let size_i32 : i64 = sizeof<i32>();
    let size_f64 : i64 = sizeof<f64>();
    let size_i64 : i64 = sizeof<i64>();
    let size_i8 : i64 = sizeof<i8>();
    let size_bool : i64 = sizeof<bool>();
    assert(size_f32 == 4);
    assert(size_i32 == 4);
    assert(size_f64 == 8);
    assert(size_i64 == 8);
    assert(size_i8 == 1);
    assert(size_bool == 1);
  }

  return 0;
}

// The block worked the sizes out while compiling and left nothing behind, so none of the
// sizes it computed appear between `main` and its return. They used to be spliced in and
// recomputed at run time. A wrong size is caught by the asserts above, which stop the
// build; what is checked here is that the block itself is gone.
// CHECK-LABEL: func.func @main
// CHECK-NOT: arith.constant 4 : i64
// CHECK-NOT: arith.constant 8 : i64
// CHECK-NOT: arith.constant 1 : i64
// CHECK: return
