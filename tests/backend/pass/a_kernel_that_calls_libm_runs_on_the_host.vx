//===----------------------------------------------------------------------===//
// A placed region that calls `f32::exp` gets no SPIR-V image. The function
// reads a constant table from the stdlib, the table arrives in the device
// module as a `memref.global`, and the SPIR-V argument flattening lowers only
// the kernel's arguments. The region runs on the host, and the compiler has to
// say so and name the table, because a region that quietly left the card is
// only visible in a timing.
//
// `math.exp` through `mlir!` is the way to keep this region on the device, so
// this file pins the other side of that choice.
//
// RUN: vxc %s --emit-llvm 2>&1 >/dev/null | FileCheck %s
// CHECK: cannot become a `spirv64` device image: it reads `__vx_const_LIBM_EXP
// CHECK-SAME: A call to a libm function such as `f32::exp`
// CHECK-SAME: It will run on the host instead.
// EXPECT: [0.367879,  1,  2.71828,  7.38906]

import core::num;

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s,
  transfer Memory::DEV_HBM -> Memory::CPU_DRAM : 63 GB/s
}

fn main() -> i32 {
  let mut a = unsafe { Tensor<f32, [4]>::uninit() };
  for i in 0..4 {
    a[i] = (i as f32) - 1.0;
  }
  let ad = transfer(a, Memory::DEV_HBM);
  let o = Tensor<f32, [4]>::fill(0.0);
  let mut od = transfer(o, Memory::DEV_HBM);
  spawn on(Topology::Dev) {
    for i in 0..4 {
      od[i] = ad[i].exp();
    }
  }
  let home = transfer(od, Memory::CPU_DRAM);
  print(home);
  return 0;
}
