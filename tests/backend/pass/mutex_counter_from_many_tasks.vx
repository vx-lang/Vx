//===----------------------------------------------------------------------===//
// Eight tasks share one `Mutex` that holds a plain `i64`. Each task locks it 10000 times and
// adds 1. The read and the write of the counter are not atomic, so without the lock two tasks
// would read the same value and one add would get lost. The count must be 80000.
//
// REQUIRES: flat-codegen
// Only because the older code generator runs each task to its end at its `spawn`. A task
// that waits for a later task then waits forever.
//
// The second RUN line runs the same program on the shared runtime, with one worker thread
// for all the tasks.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}count 80000{{$}}

import std::sync::mutex;

fn add_many(m : &Mutex<i64>) -> void {
  for i in 0..10000 {
    let mut g = m.lock();
    let v = g.get();
    *v = *v + 1;
  }
}

fn main() -> i32 {
  let m = Mutex<i64>::new(0);
  tasks {
    for t in 0..8 {
      spawn {
        add_many(&m);
      };
    }
  };
  println!("count {}", m.into_inner());
  return 0;
}
