//===----------------------------------------------------------------------===//
// References that the escape check (E4005) must still allow out of a function, each read
// after another call has reused the stack so a dangling one would show.
//
// `from_parameter` returns, inside a struct, a reference it was given: the caller owns
// what it points at.
//
// `set_in_a_block` points a reference at another variable from inside a block. Both
// variables are declared outside the block, so both outlive it.

struct View {
  r : &i32,
}

fn from_parameter(p : &i32) -> View {
  return View {
    r : p
  };
}

fn set_in_a_block(k : i32) -> i32 {
  let seed : i32 = 1;
  let other : i32 = k + 4;
  let mut r : &i32 = &seed;
  if k > 0 {
    r = &other;
  }
  return *r;
}

fn reuse_the_stack(a : i32, b : i32, c : i32, d : i32) -> i32 {
  let e : i32 = a * 7 + b * 11;
  let g : i32 = c * 13 + d * 17;
  return e + g;
}

fn main() -> i32 {
  let owned : i32 = 14;
  let v : View = from_parameter(&owned);
  print(reuse_the_stack(100, 200, 300, 400));
  print!(" ");
  print(*v.r);
  print!(" ");
  print(set_in_a_block(10));
  return 0;
}

// EXPECT: 13600 14 14
