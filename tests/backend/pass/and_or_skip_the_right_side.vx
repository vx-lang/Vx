//===----------------------------------------------------------------------===//
// `a && b` does not run `b` when `a` is false, and `a || b` does not run `b` when `a` is
// true. `loud` prints when it runs, so each line shows which right sides ran. The AST
// path (`--legacy-codegen`) used to run every one of them.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s

fn loud(x : i32) -> bool {
  print!("loud ");
  return x > 0;
}

fn main() -> i32 {
  let zero = 0;
  let one = 1;
  if zero > 0 && loud(zero) {
    print!("if ");
  }
  while zero > 0 && loud(zero) {
    print!("while ");
  }
  if zero == 0 || loud(zero) {
    print!("or ");
  }
  print!("
");
  // CHECK: {{^}}or {{$}}

  // When the left side does not decide, the right side runs and gives the result.
  if one > 0 && loud(zero) {
    print!("wrong ");
  }
  if one == 0 || loud(one) {
    print!("or ");
  }
  print!("
");
  // CHECK-NEXT: {{^}}loud loud or {{$}}
  return 0;
}
