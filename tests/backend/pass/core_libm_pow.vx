import core::num;

fn bits(r : f32) -> u32 {
  if r != r {
    return 2143289344u32;
  }
  return r.to_bits();
}

fn check(x : u32, y : u32) -> i32 {
  print(bits(f32::from_bits(x).powf(f32::from_bits(y))));
  print!(" ");
  return 0;
}

