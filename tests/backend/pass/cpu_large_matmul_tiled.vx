//===- cpu_large_matmul_tiled.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=LLVM
// FileCheck %s

fn test_f32() -> i32 {
  let mut a = unsafe { Tensor<f32, [64, 64]>::uninit() };
  let mut b = unsafe { Tensor<f32, [64, 64]>::uninit() };
  let mut c = unsafe { Tensor<f32, [64, 64]>::uninit() };

  for i in 0..64 {
    for j in 0..64 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }

  for ii in 0..4 {
    for jj in 0..4 {
      for kk in 0..4 {
        for i in 0..16 {
          for j in 0..16 {
            if kk == 0 {
              c[ii * 16 + i][jj * 16 + j] = 0.0;
            }
            for k in 0..16 {
              c[ii * 16 + i][jj * 16 + j] =
              c[ii * 16 + i][jj * 16 + j] +
              a[ii * 16 + i][kk * 16 + k] * b[kk * 16 + k][jj * 16 + j];
            }
          }
        }
      }
    }
  }

  // 64 * (2.0 * 3.0) = 384.0
  assert(c[0][0] == 384.0, "f32 large matmul 0,0 match");
  assert(c[31][31] == 384.0, "f32 large matmul 31,31 match");
  assert(c[63][63] == 384.0, "f32 large matmul 63,63 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = unsafe { Tensor<bf16, [64, 64]>::uninit() };
  let mut b = unsafe { Tensor<bf16, [64, 64]>::uninit() };
  let mut c = unsafe { Tensor<bf16, [64, 64]>::uninit() };

  for i in 0..64 {
    for j in 0..64 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }

  for ii in 0..4 {
    for jj in 0..4 {
      for kk in 0..4 {
        for i in 0..16 {
          for j in 0..16 {
            if kk == 0 {
              c[ii * 16 + i][jj * 16 + j] = 0.0;
            }
            for k in 0..16 {
              c[ii * 16 + i][jj * 16 + j] =
              c[ii * 16 + i][jj * 16 + j] +
              a[ii * 16 + i][kk * 16 + k] * b[kk * 16 + k][jj * 16 + j];
            }
          }
        }
      }
    }
  }

  assert(c[0][0] == 384.0, "bf16 large matmul 0,0 match");
  assert(c[31][31] == 384.0, "bf16 large matmul 31,31 match");
  assert(c[63][63] == 384.0, "bf16 large matmul 63,63 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// The extents are constants, so each buffer is allocated with a static shape.
// CHECK-LABEL: func.func @test_f32() -> i32
// CHECK: memref.alloc() : memref<64x64xf32>
// CHECK-LABEL: func.func @test_bf16() -> i32
// CHECK: memref.alloc() : memref<64x64xbf16>

// convert-vx-to-standard keeps the same allocation.
// STD-LABEL: func.func @test_f32() -> i32
// STD: memref.alloc() : memref<64x64xf32>

// --emit-llvm stops at the LLVM dialect, where the same function is an llvm.func. The
// buffers are too large for the stack, so they are heap allocations.
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_f32() -> i32
// LLVM: llvm.call @malloc
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_bf16() -> i32
