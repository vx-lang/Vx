// A program of the book chapter on files, input and time (www/book/src/files-input-time.md):
// it writes a file, reads it back byte by byte, and moves the position with `seek_to`.
// The RUN lines give the path in NOTES. The test runner gives no such variable, so NO_EXEC.
//
// NO_EXEC
// RUN: env NOTES=%t vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env NOTES=%t vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: rm -f %t
// CHECK: {{^}}wrote 14 bytes{{$}}
// CHECK: {{^}}read 3 lines{{$}}
// CHECK: {{^}}the file ends at byte 14{{$}}
// CHECK: {{^}}byte 4 is 116, the letter t{{$}}

// ANCHOR: program
import std::fs;
import std::string;
import std::vec;

extern {
  fn getenv(name : *const i8) -> *const i8;
}

// Writes `text` to a new file at `path`. The file closes when `out` goes out of scope.
fn write_text(files : &Files, path : &String, text : *const i8) -> Result<u64, FileError> {
  let mut bytes = Vec<u8>::new();
  let length = unsafe { string_length(text) };
  for i in 0..length {
    bytes.push(unsafe { text[i] } as u8);
  }
  let mut out = File::open(files, path, OpenMode::Write())?;
  return out.write(&bytes);
}

fn write_and_read(files : &Files, path : &String) -> Result<i32, FileError> {
  let written = write_text(files, path, "one\ntwo\nthree\n")?;
  println!("wrote {} bytes", written);

  let mut input = File::open(files, path, OpenMode::Read())?;
  let mut byte = Vec<u8>::new();
  byte.push(0u8);
  let mut lines = 0;
  loop {
    let n = input.read(&mut byte)?;
    if n == 0 {
      break;
    }
    if byte.get(0) == 10 {
      lines = lines + 1;
    }
  }
  println!("read {} lines", lines);
  println!("the file ends at byte {}", input.seek_to(SeekFrom::End(0))?);

  input.seek_to(SeekFrom::Start(4))?;
  let _n = input.read(&mut byte)?;
  println!("byte 4 is {}, the letter t", byte.get(0));
  return Result<i32, FileError>::Ok(lines);
}

fn main(root : Root) -> i32 {
  let path = unsafe { String::from_c_str(getenv("NOTES")) };
  match write_and_read(&root.files, &path) {
    Result<i32, FileError>::Ok(_lines) => {
      return 0;
    }
    Result<i32, FileError>::Err(_e) => {
      println!("a file call did not work");
      return 1;
    }
  }
}
// ANCHOR_END: program
