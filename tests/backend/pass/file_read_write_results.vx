// Check that Vx receives byte counts and native error codes from the file bridge.
extern {
  fn vx_get_temp_file(filename : *const i8) -> *mut i8;
  fn vx_free_temp_file(ptr : *mut i8) -> i32;
  fn vx_file_open(path : *const i8, mode : i32) -> *mut i8;
  fn vx_file_drop(ptr : *mut i8) -> void;
  fn vx_file_try_read(ptr : *mut i8, buffer : *mut u8, len : u64, count : *mut u64, native_code : *mut i32, has_native_code : *mut bool) -> i32;
  fn vx_file_try_write(ptr : *mut i8, buffer : *const u8, len : u64, count : *mut u64, native_code : *mut i32, has_native_code : *mut bool) -> i32;
  fn remove(path : *const i8) -> i32;
}

fn main() -> i32 {
  unsafe {
    let path = vx_get_temp_file("file_read_write_results.txt");
    let input : u8 = 65;
    let mut count : u64 = 99;
    let mut native_code : i32 = 99;
    let mut has_native_code : bool = true;

    let writer = vx_file_open(path, 1);
    let write_status = vx_file_try_write(writer, (&input) as *const u8, 1, &mut count, &mut native_code, &mut has_native_code);
    let write_count = count;
    let write_native_code = native_code;
    let write_has_native_code = has_native_code;
    vx_file_drop(writer);

    count = 99;
    native_code = 99;
    has_native_code = true;
    let reader = vx_file_open(path, 0);
    let mut output : u8 = 0;
    let read_status = vx_file_try_read(reader, &mut output, 1, &mut count, &mut native_code, &mut has_native_code);
    let read_count = count;
    let read_native_code = native_code;
    let read_has_native_code = has_native_code;

    count = 99;
    native_code = 99;
    has_native_code = false;
    let failed_write_status = vx_file_try_write(reader, (&input) as *const u8, 1, &mut count, &mut native_code, &mut has_native_code);
    let failed_write_count = count;
    let failed_write_native_code = native_code;
    let failed_write_has_native_code = has_native_code;
    vx_file_drop(reader);
    remove(path);
    vx_free_temp_file(path);

    if write_status != 0 || write_count != 1 || write_native_code != 0 || write_has_native_code {
      print!("Fallible write did not report one byte");
      return 1;
    }
    if read_status != 0 || read_count != 1 || read_native_code != 0 || read_has_native_code || output != input {
      print!("Fallible read did not report the written byte");
      return 1;
    }
    if failed_write_status != 12 {
      print!("Write through a read-only file did not report Other");
      return 1;
    }
    if failed_write_count != 0 || failed_write_native_code == 0 || !failed_write_has_native_code {
      print!("Write through a read-only file did not report native error details");
      return 1;
    }
  }
  print!("file reads and writes report results to Vx");
  return 0;
}
// EXPECT: file reads and writes report results to Vx
