//===----------------------------------------------------------------------===//
// The first task loops until the second task sets a flag. The loop has no wait, so the task
// never gives its thread to another task.
//
// The third RUN line starts the shared runtime with one worker thread. The first task holds
// it, so the second task can run only when the runtime adds a worker.
//
// NO-SEED-SWEEP: a task loops with no wait until another task acts, and one thread cannot run the other task.
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}the flag is set{{$}}

import core::sync::atomic;

fn main() -> i32 {
  let flag = AtomicI64::new(0);
  tasks {
    spawn {
      let mut seen = flag.load(AtomicOrdering::Acquire);
      while seen == 0 {
        seen = flag.load(AtomicOrdering::Acquire);
      }
    };
    spawn {
      flag.store(1, AtomicOrdering::Release);
    };
  };
  println!("the flag is set");
  return 0;
}
