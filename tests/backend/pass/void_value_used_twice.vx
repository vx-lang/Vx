//===----------------------------------------------------------------------===//
// A `void` value holds nothing, so using it twice is not a move: `a` can be read by both
// `b` and `c`.
//
// EXPECT: done

fn nothing() -> void {
}

fn main() -> i32 {
  let a = nothing();
  let b = a;
  let c = a;
  print("done");
  return 0;
}
