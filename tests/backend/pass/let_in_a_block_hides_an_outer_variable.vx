//===----------------------------------------------------------------------===//
// A `let` inside a block is a new variable that ends with the block, as in Rust: an outer
// variable of the same name keeps its value, and means that value again after the block.
// Each function returns the outer variable after the block; the ones that print, print the
// inner one inside it. The expected line is what the same program prints in Rust.
//
// The blocks: an `if` branch, an `else` branch, an `if` in a function with a loop (which
// keeps its variables in memory rather than registers), a loop body, an `unsafe` block, a
// `match` arm, and the branch of an `if` used as a value. Also: an inner `let mut` assigned
// inside its block, an assignment to the outer variable inside a block (which must stay),
// a shadow of another type, and three blocks nested in a loop.
//
// The AST code generator does not scope blocks yet.
//
// REQUIRES: flat-codegen
// EXPECT: 2 1 3 1 2 1 7 6 11 3 2 1 9 1 2.5 4 133 22
fn in_if_branch(c : bool) -> i32 {
  let x = 1;
  if c {
    let x = 2;
    print(x);
    print!(" ");
  }
  return x;
}

fn in_else_branch(c : bool) -> i32 {
  let x = 1;
  if c {
    print!("");
  } else {
    let x = 3;
    print(x);
    print!(" ");
  }
  return x;
}

fn in_if_with_a_loop(c : bool) -> i32 {
  let mut x = 1;
  for i in 0..1 {
    x = x + 0;
  }
  if c {
    let x = 2;
    print(x);
    print!(" ");
  }
  return x;
}

fn in_loop_body(n : i32) -> i32 {
  let y = 7;
  for i in 0..n {
    let y = i;
  }
  return y;
}

fn shadow_then_assign(c : bool) -> i32 {
  let mut x = 1;
  if c {
    let mut x = 5;
    x = x + 1;
    print(x);
    print!(" ");
  }
  x = x + 10;
  return x;
}

fn assign_outer_in_block(c : bool) -> i32 {
  let mut x = 1;
  if c {
    x = 3;
  }
  return x;
}

fn in_unsafe_block() -> i32 {
  let x = 1;
  unsafe { let x = 2; print(x); print!(" "); }
  return x;
}

fn in_match_arm(v : i32) -> i32 {
  let x = 1;
  match v {
    0 => {
      let x = 9;
      print(x);
      print!(" ");
    }
    _ => {
      print!("");
    }
  }
  return x;
}

fn changes_type(c : bool) -> i32 {
  let x : i32 = 4;
  if c {
    let x : f32 = 2.5;
    print(x);
    print!(" ");
  }
  return x;
}

fn nested(n : i32) -> i32 {
  let z = 100;
  let mut s = 0;
  for i in 0..n {
    let z = i;
    if z > 0 {
      let z = z * 10;
      s = s + z;
    }
    s = s + z;
  }
  return s + z;
}

fn in_value_if(c : bool) -> i32 {
  let x = 1;
  let y : i32 = if c {
    let x = 20;
    x + 1
  } else {
    x
  };
  return x + y;
}

fn main() -> i32 {
  print(in_if_branch(true));
  print!(" ");
  print(in_else_branch(false));
  print!(" ");
  print(in_if_with_a_loop(true));
  print!(" ");
  print(in_loop_body(3));
  print!(" ");
  print(shadow_then_assign(true));
  print!(" ");
  print(assign_outer_in_block(true));
  print!(" ");
  print(in_unsafe_block());
  print!(" ");
  print(in_match_arm(0));
  print!(" ");
  print(changes_type(true));
  print!(" ");
  print(nested(3));
  print!(" ");
  print(in_value_if(true));
  return 0;
}
