//===- cpu_vector_add.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 |
// FileCheck %s
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s

fn test_f32() -> i32 {
  let mut a = Tensor<f32>([4]);
  let mut b = Tensor<f32>([4]);
  let mut c = Tensor<f32>([4]);

  for i in 0..4 {
    a[i] = 1.0;
    b[i] = 2.0;
  }

  for i in 0..4 { c[i] = a[i] + b[i]; }

  assert(c[0] == 3.0, "f32 index 0 match");
  assert(c[1] == 3.0, "f32 index 1 match");
  assert(c[2] == 3.0, "f32 index 2 match");
  assert(c[3] == 3.0, "f32 index 3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = Tensor<bf16>([4]);
  let mut b = Tensor<bf16>([4]);
  let mut c = Tensor<bf16>([4]);

  for i in 0..4 {
    a[i] = 1.0;
    b[i] = 2.0;
  }

  for i in 0..4 { c[i] = a[i] + b[i]; }

  assert(c[0] == 3.0, "bf16 index 0 match");
  assert(c[1] == 3.0, "bf16 index 1 match");
  assert(c[2] == 3.0, "bf16 index 2 match");
  assert(c[3] == 3.0, "bf16 index 3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// FRONTEND-LABEL: module {
// FRONTEND: func.func @test_f32() -> i32
// FRONTEND: memref.alloc

// MLIR-LABEL: module {
// MLIR: func.func @test_f32() -> i32

// LLVM-LABEL: module {
// LLVM: llvm.func @test_f32() -> i32

