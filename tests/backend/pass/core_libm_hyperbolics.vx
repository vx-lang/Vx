import core::num;

fn bits(r : f32) -> u32 {
  if r != r {
    return 2143289344u32;
  }
  return r.to_bits();
}

fn check(input : u32) -> i32 {
  let x = f32::from_bits(input);
  print(bits(x.sinh()));
  print!(" ");
  print(bits(x.cosh()));
  print!(" ");
  print(bits(x.tanh()));
  print!(" ");
  return 0;
}

