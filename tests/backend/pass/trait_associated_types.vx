//===----------------------------------------------------------------------===//
// A trait declares `type Item;` and writes `Self::Item` in its signatures; each impl binds
// it to a type of its own.
//
// Two impls binding `Item` differently is the whole point. A substitution that resolved
// `Self::Item` once, at the trait, would answer with one type for both and the second column
// is what says it did not: 42 is an i64 and 3 is an f32, from the same default body.
//
// `doubled` is inherited rather than written, so its return type arrives as `Self::Item` in
// a copied signature. That is the case a binding applied only to hand-written methods would
// miss, and it is why the answer is printed rather than the signature inspected.
trait Counts {
  type Item;
  fn value(self : Self) -> Self::Item;
  fn doubled(self : Self) -> Self::Item {
    return self.value() + self.value();
  }
}

impl Counts for i32 {
  type Item = i64;
  fn value(self : i32) -> i64 {
    return 21;
  }
}

impl Counts for f32 {
  type Item = f32;
  // Written out rather than inherited, and spelling the associated type rather than `f32`.
  // A binding that reached only the copied signatures would leave this one unsubstituted.
  fn value(self : f32) -> Self::Item {
    return 1.5;
  }
}

fn main() -> i32 {
  let a : i32 = 1;
  print(a.doubled());
  print!(" ");
  let b : f32 = 1.0;
  print(b.doubled());
  return 0;
}

// EXPECT: 42 3
