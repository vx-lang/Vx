// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// An `if/else` whose branches both return, in tail position, is a statement -- it yields nothing
// and control does not reach past it. It used to be rewritten to `return <if>` because the parser
// turns any trailing semicolon-less expression into the return value, which is right for
// `if c { 1 } else { 2 }` and wrong here: it produced `Expected i32, got void`, naming a void the
// source never wrote. Fixing the type error alone was not enough -- the emitter then left the
// merge block with no predecessor and no terminator, which the MLIR verifier rejects.
//
// Both functions must emit, and `nested` is the case that only works if the *inner* `if` reports
// that control does not leave it: the outer branch decides it is terminated by asking the
// statement, and a nested diverging `if` used to answer "control continues".
//
// CHECK-DAG: func.func @classify(%arg0: i32) -> i32
// CHECK-DAG: func.func @nested(%arg0: i32) -> i32
// CHECK-DAG: llvm.unreachable

fn classify(x : i32) -> i32 {
  if x > 0 {
    return 1;
  } else {
    return 2;
  }
}

fn nested(x : i32) -> i32 {
  if x > 5 {
    if x > 9 {
      return 1;
    } else {
      return 2;
    }
  } else {
    return 3;
  }
}

// The value form is a different construct and must keep working: here the `if` *is* the return
// value, so the rewrite still applies.
fn as_a_value(x : i32) -> i32 {
  if x > 0 {
    1
  } else {
    2
  }
}

// Exit 0 on success, so the harness's own check is the assertion: each call must return the value
// its branch names, not merely compile.
fn main() -> i32 {
  if classify(5) != 1 {
    return 1;
  }
  if classify(-5) != 2 {
    return 2;
  }
  if nested(10) != 1 {
    return 3;
  }
  if nested(7) != 2 {
    return 4;
  }
  if nested(1) != 3 {
    return 5;
  }
  if as_a_value(-1) != 2 {
    return 6;
  }
  return 0;
}
