//===----------------------------------------------------------------------===//
// The results of `run_jobs` and `try_run_jobs` are `Tracked` values. Each one owns a `Vec`, and
// its drop counts itself. `work` counts each value that it makes. So when the program no longer
// holds a value, each value that `work` made must be dropped once: a leak drops fewer, and a
// double drop more. A double drop also frees the `Vec` twice.
//
// - `run_jobs`: no value is dropped while the caller holds the results, and each value is
//   dropped after the caller drops them.
// - `try_run_jobs`: job 4 fails with a `Tracked` error, after the earlier jobs gave results. The
//   call drops those results. The error is dropped when the program drops it.
// - `run_jobs` and a cancel: the `tasks` block around the call leaves after 30 ms. The values that
//   the jobs made before the cancel are dropped.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_SEED=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}first values in job order: 0 10 20 30 40 50 60 70{{$}}
// CHECK-NEXT: {{^}}each result holds its 3 values: true{{$}}
// CHECK-NEXT: {{^}}dropped while the caller holds the results: 0{{$}}
// CHECK-NEXT: {{^}}each value dropped once after the results go: true{{$}}
// CHECK-NEXT: {{^}}try_run_jobs failed with job 4{{$}}
// CHECK-NEXT: {{^}}each value dropped once after the error goes: true{{$}}
// CHECK-NEXT: {{^}}run_jobs gave Cancelled: true{{$}}
// CHECK-NEXT: {{^}}each value dropped once after the cancel: true{{$}}

import core::mem;
import core::option;
import core::result;
import core::sync::atomic;
import core::time;
import std::sync::jobs;
import std::time;
import std::vec;

/// The `Tracked` values that `work` made, and the ones that were dropped.
struct Counts {
  made : AtomicI64,
  dropped : AtomicI64,
}

impl Counts {
  fn count_one_made(self : &Counts) -> void {
    self.made.fetch_add(1, AtomicOrdering::SeqCst);
  }

  fn count_one_dropped(self : &Counts) -> void {
    self.dropped.fetch_add(1, AtomicOrdering::SeqCst);
  }

  /// `work` made at least one value, so the check is not true only because nothing ran.
  fn each_dropped_once(self : &Counts) -> bool {
    let made = self.made.load(AtomicOrdering::SeqCst);
    return made > 0 && made == self.dropped.load(AtomicOrdering::SeqCst);
  }
}

/// An owned result. `counts` is a raw pointer, so that the value can move to another task.
struct Tracked {
  job : i64,
  values : Vec<i64>,
  counts : *mut Counts,
}

unsafe impl Send for Tracked {}

impl Drop for Tracked {
  fn drop(self : &mut Tracked) -> void {
    let counts : &Counts = unsafe { &self.counts[0] };
    counts.count_one_dropped();
  }
}

/// The data that the jobs share: where they count the values that they make.
struct Ctx {
  counts : *mut Counts,
}

unsafe impl Sync for Ctx {}

/// The counts that `ctx` points at.
fn counts_of(ctx : &Ctx) -> &Counts {
  return unsafe { &ctx.counts[0] };
}

fn make(ctx : &Ctx, job : i64) -> Tracked {
  counts_of(ctx).count_one_made();
  let mut values = Vec<i64>::new();
  for k in 0..3 {
    values.push(job * 10 + i64::from(k));
  }
  return Tracked {
    job : job,
    values : values,
    counts : ctx.counts
  };
}

fn make_one(ctx : &Ctx, job : &i64) -> Tracked {
  return make(ctx, *job);
}

/// Jobs 0 to 3 give a value at once. Job 4 waits 20 ms, so that the earlier results arrive
/// first, and then fails with a value of its own.
fn make_or_fail(ctx : &Ctx, job : &i64) -> Result<Tracked, Tracked> {
  if *job == 4 {
    sleep(Duration::from_millis(20));
    return Result<Tracked, Tracked>::Err(make(ctx, *job));
  }
  if *job > 4 {
    sleep(Duration::from_millis(50));
  }
  return Result<Tracked, Tracked>::Ok(make(ctx, *job));
}

fn make_slowly(ctx : &Ctx, job : &i64) -> Tracked {
  sleep(Duration::from_millis(10));
  return make(ctx, *job);
}

/// Starts `run_jobs` in a task, and leaves the `tasks` block after 30 ms.
fn run_and_leave(ctx : &Ctx, jobs : &Vec<i64>) -> i32 {
  tasks {
    spawn {
      let results : Result<Vec<Tracked>, RunJobsError> = run_jobs(jobs, 2, | job : &i64 | -> Tracked {
        make_slowly(ctx, job)
      });
      println!("run_jobs gave Cancelled: {}", results.is_err());
    };
    sleep(Duration::from_millis(30));
    return 1;
  };
  return 0;
}

fn main() -> i32 {
  let mut jobs = Vec<i64>::new();
  for i in 0..8 {
    jobs.push(i64::from(i));
  }

  let mut counts = Counts {
    made : AtomicI64::new(0),
    dropped : AtomicI64::new(0)
  };
  let ctx = Ctx { counts : (&mut counts) as *mut Counts };
  let made : Result<Vec<Tracked>, RunJobsError> = run_jobs(&jobs, 3, | job : &i64 | -> Tracked {
    make_one(&ctx, job)
  });
  let results = made.unwrap();
  print!("first values in job order:");
  let mut complete = true;
  for i in 0..results.len() {
    let r = results.get_ref(i);
    print!(" {}", r.values.get(0));
    complete = complete && r.values.len() == 3 && r.job == i64::from(i);
  }
  println!("");
  println!("each result holds its 3 values: {}", complete);
  let held = counts_of(&ctx);
  println!("dropped while the caller holds the results: {}", held.dropped.load(AtomicOrdering::SeqCst));
  drop(results);
  println!("each value dropped once after the results go: {}", held.each_dropped_once());

  let mut counts_two = Counts {
    made : AtomicI64::new(0),
    dropped : AtomicI64::new(0)
  };
  let ctx_two = Ctx {
    counts : (&mut counts_two) as *mut Counts
  };
  let made_two : Result<Vec<Tracked>, TryRunJobsError<Tracked>> = try_run_jobs(&jobs, 2, | job : &i64 | -> Result<Tracked, Tracked> {
    make_or_fail(&ctx_two, job)
  });
  match made_two {
    Result<Vec<Tracked>,
    TryRunJobsError<Tracked>>::Ok(_r) => {
      println!("try_run_jobs gave each result");
    }
    Result<Vec<Tracked>,
    TryRunJobsError<Tracked>>::Err(e) => {
      match e {
        TryRunJobsError<Tracked>::Failed(t) => {
          println!("try_run_jobs failed with job {}", t.job);
        }
        TryRunJobsError<Tracked>::Cancelled => {
          println!("try_run_jobs gave Cancelled");
        }
      }
    }
  }
  let two = counts_of(&ctx_two);
  println!("each value dropped once after the error goes: {}", two.each_dropped_once());

  let mut counts_three = Counts {
    made : AtomicI64::new(0),
    dropped : AtomicI64::new(0)
  };
  let ctx_three = Ctx {
    counts : (&mut counts_three) as *mut Counts
  };
  let mut many = Vec<i64>::new();
  for i in 0..20 {
    many.push(i64::from(i));
  }
  run_and_leave(&ctx_three, &many);
  let three = counts_of(&ctx_three);
  println!("each value dropped once after the cancel: {}", three.each_dropped_once());
  return 0;
}
