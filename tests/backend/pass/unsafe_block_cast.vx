// unsafe { .. } as T parses as (unsafe { .. }) as T.
fn value() -> i64 {
  unsafe { 7i32 } as i64
}

fn main() -> i32 {
  let x = value();
  if x != 7 {
    return 1;
  }
  return 0;
}
