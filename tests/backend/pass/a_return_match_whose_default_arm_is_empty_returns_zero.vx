//===----------------------------------------------------------------------===//
// Each function returns a `match` whose `_` arm is empty, and each other arm returns. When the
// `_` arm runs, the function returns 0 for a number and null for a pointer. For a struct, the
// program stops: tests/backend/fail/return_a_match_whose_default_arm_is_empty.vx.
//
// A `match` on a number with no `_` arm is an error here:
// tests/frontend/fail/a_match_on_a_number_with_no_default_arm_can_end.vx.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error

import core::ptr;

fn code_for(n : i32) -> i32 {
  return match n {
    0 => {
      return 7;
    }
    1 => {
      return 8;
    }
    _ => {}
  };
}

fn scale_for(n : i32) -> f64 {
  return match n {
    0 => {
      return 1.5;
    }
    _ => {}
  };
}

fn name_for(n : i32) -> *const i8 {
  return match n {
    0 => {
      return "zero";
    }
    _ => {}
  };
}

fn main() -> i32 {
  // CHECK: {{^}}code 8 0{{$}}
  println!("code {} {}", code_for(1), code_for(5));
  // CHECK-NEXT: {{^}}scale 1.5 0{{$}}
  println!("scale {} {}", scale_for(0), scale_for(5));
  // CHECK-NEXT: {{^}}name null false true{{$}}
  println!("name null {} {}", is_null(name_for(0)), is_null(name_for(5)));
  return 0;
}
