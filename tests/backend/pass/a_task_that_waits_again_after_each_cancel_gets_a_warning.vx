//===----------------------------------------------------------------------===//
// A task calls `recv` 2000 times, and drops each error. The code of its block returns early, so
// the block cancels the task, and each `recv` after that gives `Cancelled` at once. The runtime
// warns once, with the line of the task's `spawn`. The program still ends.
//
// First, two tasks get 600 `Cancelled` each. The count is for each task, so neither gets the
// warning, also when both run on one thread of the shared runtime.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s --run 2>&1 | FileCheck %s

import std::sync::channel;

// The loop that W1035 warns about. It ends only because it has a count.
fn recv_many(rx : Receiver<i64>, times : i64) -> i64 {
  let mut errors : i64 = 0;
  for _i in 0..times {
    match rx.recv() {
      Result<i64, RecvError>::Ok(_v) => {}
      Result<i64, RecvError>::Err(_e) => {
        errors = errors + 1;
      }
    }
  }
  return errors;
}

fn leave_early(times : i64) -> i64 {
  let (tx, rx) = channel<i64>(1);
  let (other_tx, other_rx) = channel<i64>(1);
  tasks {
    spawn {
      recv_many(rx, times);
    };
    spawn {
      recv_many(other_rx, 600);
    };
    return 7;
  };
  drop(tx);
  drop(other_tx);
  return 0;
}

// CHECK: {{^}}leave_early gave 7{{$}}
// CHECK-NEXT: {{^}}vx: warning: a task saw the cancel of its `tasks` block 1000 times. A loop may wait again after each `Cancelled`.{{$}}
// CHECK-NEXT: {{^}}  in the task from the `spawn` at {{.*}}.vx:38{{$}}
// CHECK-NOT: vx: warning
// CHECK: {{^}}leave_early gave 7{{$}}
fn main() -> i32 {
  let v = leave_early(600);
  eprintln!("leave_early gave {}", v);
  let w = leave_early(2000);
  eprintln!("leave_early gave {}", w);
  return 0;
}
