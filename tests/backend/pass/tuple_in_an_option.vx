// A tuple as a generic enum's payload, spelled as a type argument: `Option<(i64, i64)>`.
import core::option;

fn main() -> i32 {
  let o = Option<(i64, i64)>::Some((4i64, 5i64));
  let pr = o.unwrap();
  print(pr.0 * pr.1);
  return 0;
}

// EXPECT: 20
