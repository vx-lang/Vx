// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-LABEL: func.func @tile(%arg0: i32) -> i32
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : index
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @tile(%{{.*}}) : (i32) -> i32
fn tile(N : i32) -> i32
requires N > 0
ensures return > 0 {
  for i in 0..10 invariant(N > 0) {
    let x = N;
  }
  return N;
}

fn main() -> i32 {
  let result = tile(5);
  return 0;
}
