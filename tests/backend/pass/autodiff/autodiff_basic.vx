// EXPECT: callee = @__enzyme_autodiff_grad_poly
// EXPECT: [12.000000]

extern {
  fn vx_print_float(val: f32) -> i32;
}

fn poly(x: f32) -> f32 {
  return x * x * x;
}

fn main() -> i32 {
  let x = 2.0;
  // Expected derivative of x^3 is 3x^2. At x=2.0, this is 12.0
  let dx = grad(poly, x);
  unsafe {
    vx_print_float(dx);
  }
  return 0;
}
