// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: vxc --emit-mlir %s 2>&1 | FileCheck %s
// CHECK-DAG: llvm.func {{(hidden )?}}@__enzyme_autodiff_grad_poly(
// CHECK-LABEL: llvm.func {{(hidden )?}}@f32$expect_eq(%arg0: f32, %arg1: f32) -> i32
// CHECK: llvm.fcmp "une" %arg0, %arg1 : f32
// CHECK-LABEL: llvm.func {{(hidden )?}}@expect_eq$f32(%arg0: f32, %arg1: f32) -> i32
// CHECK: llvm.call @f32$expect_eq(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func {{(hidden )?}}@poly(%arg0: f32) -> f32
// CHECK: llvm.return %{{.*}} : f32
// CHECK-LABEL: llvm.func {{(hidden )?}}@main() -> i32
// CHECK: %[[V0:.*]] = llvm.call @__enzyme_autodiff_grad_poly(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @expect_eq$f32(%[[V0]], %{{.*}}) : {{.*}}
import std::googletest;

fn poly(x : f32) -> f32 {
  return x * x * x;
}

fn main() -> i32 {
  let x : f32 = 2.0;
  // Expected derivative of x^3 is 3x^2. At x=2.0, this is 12.0
  let dx : f32 = grad(poly, x);
  let expected : f32 = 12.0;
  expect_eq(dx, expected);
  return 0;
}
