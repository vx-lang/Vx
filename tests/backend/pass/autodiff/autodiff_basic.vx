// RUN: vxc %s
// RUN: vxc --emit-mlir %s | FileCheck %s
// CHECK: @__enzyme_autodiff_grad_poly
// CHECK: @vx_googletest_expect_eq_f32
import std::googletest;

fn poly(x: f32) -> f32 {
  return x * x * x;
}

fn main() -> i32 {
  let x: f32 = 2.0;
  // Expected derivative of x^3 is 3x^2. At x=2.0, this is 12.0
  let dx: f32 = grad(poly, x);
  let expected: f32 = 12.0;
  expect_eq(dx, expected);
  return 0;
}
