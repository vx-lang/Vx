//===- autodiff_higher_order.vx -----------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
import std::googletest;

// EXPECT: llvm.call @__enzyme_autodiff_grad_compute_val
// EXPECT: llvm.call @__enzyme_fwddiff_jvp_compute_val

fn compute_val(x : f32) -> f32 {
  return x * x * x; // x^3
}

// First derivative: 3x^2
// Second derivative: 6x
fn main() -> i32 {
  let val : f32 = 4.0;

  // Test grad
  let df : f32 = grad(compute_val, val);
  let expected_df : f32 = 48.0;
  expect_eq(df, expected_df);

  // Test multiple uses of grad
  let val2 : f32 = 5.0;
  let df2 : f32 = grad(compute_val, val2);
  let expected_df2 : f32 = 75.0;
  expect_eq(df2, expected_df2);

  // Test JVP
  let one_f32 : f32 = 1.0;
  let j : f32 = jvp(compute_val, val, one_f32);
  let expected_j : f32 = 48.0;
  expect_eq(j, expected_j);

  // Test VJP
  let v : f32 = vjp(compute_val, val, one_f32);
  let expected_v : f32 = 48.0;
  expect_eq(v, expected_v);

  return 0;
}

// CHECK-DAG: llvm.func @vx_googletest_expect_eq_f32(
// CHECK-DAG: llvm.func @__enzyme_autodiff_grad_compute_val(
// CHECK-DAG: llvm.func @__enzyme_fwddiff_jvp_compute_val(
// CHECK-LABEL: llvm.func @f32$expect_eq(%arg0: f32, %arg1: f32) -> i32
// CHECK: llvm.call @vx_googletest_expect_eq_f32(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func @expect_eq$f32(%arg0: f32, %arg1: f32) -> i32
// CHECK: llvm.call @f32$expect_eq(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func @compute_val(%arg0: f32) -> f32
// CHECK: llvm.return %{{.*}} : f32
// CHECK-LABEL: llvm.func @main() -> i32
// CHECK: %[[V0:.*]] = llvm.call @__enzyme_autodiff_grad_compute_val(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @expect_eq$f32(%[[V0]], %{{.*}}) : {{.*}}
// CHECK: %[[V1:.*]] = llvm.call @__enzyme_autodiff_grad_compute_val(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @expect_eq$f32(%[[V1]], %{{.*}}) : {{.*}}
// CHECK: %[[V2:.*]] = llvm.call @__enzyme_fwddiff_jvp_compute_val(%{{.*}}, %{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @expect_eq$f32(%[[V2]], %{{.*}}) : {{.*}}
// CHECK: llvm.call @__enzyme_autodiff_grad_compute_val(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @expect_eq$f32(%{{.*}}, %{{.*}}) : {{.*}}
