//===----------------------------------------------------------------------===//
// The derivatives of f64 `asin`, `acos` and `atan` at x = 0.5: 1/sqrt(0.75), -1/sqrt(0.75)
// and 1/1.25, and of `y.atan2(2)` in y at y = 1: 2/5, printed times 10^6. Enzyme cannot
// differentiate the core::libm functions themselves, which read the float's bits, so each is
// marked to be differentiated as its C function.
//
// CHECK-DAG: llvm.func @libm_asin({{.*}}passthrough = {{\[\[}}"enzyme_math", "asin"{{\]\]}}
// CHECK-DAG: llvm.func @libm_acos({{.*}}passthrough = {{\[\[}}"enzyme_math", "acos"{{\]\]}}
// CHECK-DAG: llvm.func @libm_atan({{.*}}passthrough = {{\[\[}}"enzyme_math", "atan"{{\]\]}}
// CHECK-DAG: llvm.func @libm_atan2({{.*}}passthrough = {{\[\[}}"enzyme_math", "atan2"{{\]\]}}
// EXPECT: 1154700 -1154700 800000 400000
import core::num;

fn asin_of(x : f64) -> f64 {
  return x.asin();
}

fn acos_of(x : f64) -> f64 {
  return x.acos();
}

fn atan_of(x : f64) -> f64 {
  return x.atan();
}

fn atan2_of(y : f64) -> f64 {
  return y.atan2(2.0);
}

fn main() -> i32 {
  let x : f64 = 0.5;
  let y : f64 = 1.0;
  print((grad(asin_of, x) * 1000000.0) as i64);
  print!(" ");
  print((grad(acos_of, x) * 1000000.0) as i64);
  print!(" ");
  print((grad(atan_of, x) * 1000000.0) as i64);
  print!(" ");
  print((grad(atan2_of, y) * 1000000.0) as i64);
  return 0;
}
