//===- autodiff_math_cos.vx - Vx Compiler -------------------*- Vx -*-===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// Enzyme cannot differentiate libm_cosf itself, which reads the float's bits, so the
// function is marked to be differentiated as the C `cosf`.
// CHECK-DAG: llvm.func {{(hidden )?}}@libm_cosf({{.*}}passthrough = {{\[\[}}"enzyme_math", "cosf"{{(\], \["probe-stack", "inline-asm")?}}{{\]\]}}
// CHECK-DAG: llvm.intr.fabs(
// CHECK-DAG: llvm.func {{(hidden )?}}@__enzyme_autodiff_grad_test_func(
// CHECK-LABEL: llvm.func {{(hidden )?}}@f32$cos(%arg0: f32) -> f32
// CHECK-LABEL: llvm.func {{(hidden )?}}@f32$abs(%arg0: f32) -> f32
// CHECK-LABEL: llvm.func {{(hidden )?}}@test_func(%arg0: f32) -> f32
// CHECK: llvm.call @f32$cos(%{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func {{(hidden )?}}@main() -> i32
// CHECK: llvm.call @__enzyme_autodiff_grad_test_func(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @f32$abs(%{{.*}}) : {{.*}}
import core::num;

fn test_func(x : f32) -> f32 {
  return x.cos();
}

fn main() -> i32 {
  let x : f32 = 0.0;
  let dx : f32 = grad(test_func, x);
  let expected : f32 = 0.0;

  let diff : f32 = (dx - expected).abs();
  let mut ret : i32 = 1;
  if diff < 0.001 {
    ret = 0;
  }
  return ret;
}
