//===- autodiff_math_cos.vx - Vx Compiler -------------------*- Vx -*-===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: llvm.func @cosf(
// CHECK-DAG: llvm.func @fabsf(
// CHECK-DAG: llvm.func @__enzyme_autodiff_grad_test_func(
// CHECK-LABEL: llvm.func @f32$cos(%arg0: f32) -> f32
// CHECK: llvm.call @cosf(%{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func @f32$abs(%arg0: f32) -> f32
// CHECK: llvm.call @fabsf(%{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func @test_func(%arg0: f32) -> f32
// CHECK: llvm.call @f32$cos(%{{.*}}) : {{.*}}
// CHECK-LABEL: llvm.func @main() -> i32
// CHECK: llvm.call @__enzyme_autodiff_grad_test_func(%{{.*}}, %{{.*}}) : {{.*}}
// CHECK: llvm.call @f32$abs(%{{.*}}) : {{.*}}
import std::math;

fn test_func(x : f32) -> f32 {
  return x.cos();
}

fn main() -> i32 {
  let x : f32 = 0.0;
  let dx : f32 = grad(test_func, x);
  let expected : f32 = 0.0;

  let diff : f32 = (dx - expected).abs();
  let mut ret : i32 = 1;
  if diff < 0.001 {
    ret = 0;
  }
  return ret;
}
