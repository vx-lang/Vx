//===----------------------------------------------------------------------===//
// Number literals passed to grad, vjp and jvp take the types of the function's parameters, as
// in an ordinary call, and the seeds 2.0 take the type they multiply. Printed times 10^6: grad
// of x * x / 2 at 0.25; vjp and jvp of it at 3 with seed 2; the Huber loss at -3; and the
// derivative in x of x * y * n at (2, 3, 4).
//
// EXPECT: 250000 6000000 6000000 -1000000 12000000

fn half_square(x : f64) -> f64 {
  return 0.5 * x * x;
}

fn huber(x : f64) -> f64 {
  if x < -1.0 {
    return -x - 0.5;
  }
  if x > 1.0 {
    return x - 0.5;
  }
  return 0.5 * x * x;
}

fn scaled(x : f64, y : f64, n : i32) -> f64 {
  return x * y * (n as f64);
}

fn main() -> i32 {
  print((grad(half_square, 0.25) * 1000000.0) as i64);
  print!(" ");
  print((vjp(half_square, 3.0, 2.0) * 1000000.0) as i64);
  print!(" ");
  print((jvp(half_square, 3.0, 2.0) * 1000000.0) as i64);
  print!(" ");
  print((grad(huber, -3.0) * 1000000.0) as i64);
  print!(" ");
  print((grad(scaled, 2.0, 3.0, 4) * 1000000.0) as i64);
  return 0;
}
