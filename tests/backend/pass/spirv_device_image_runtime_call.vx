// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// A placed region that calls the runtime keeps the region on the host, and the
// compiler says so, naming the function it could not bring along.
//
// A device kernel can call only what the device can run: no `extern`, no
// runtime entry, no recursion. `print` is the runtime, so nothing can come
// along, and the region runs on the host one thread at a time.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: vx.spawn topology({{[0-9]+}}) {
// CHECK: } {arch = "spirv64"
// The host runs the region, so both printfs happen: the constant the region
// asks for, then the tensor the region computed.
// EXPECT: 4321
// EXPECT: [2,  4,  6,  8]

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s
}

fn main() -> i32 {
  let mut o = unsafe { Tensor<f32, [4]>::uninit() };
  for i in 0..4 {
    o[i] = 0.0;
  }
  let mut od = transfer(o, Memory::DEV_HBM);
  spawn on(Topology::Dev) {
    for i in 0..4 {
      od[i] = ((i + 1) as f32) * 2.0;
    }
    // A call the device cannot make. Its argument is a constant, so the body
    // holds no `llvm` op before this and the warning names the callee.
    print(4321.0);
  }
  let home = transfer(od, Memory::CPU_DRAM);
  print(home);
  return 0;
}
