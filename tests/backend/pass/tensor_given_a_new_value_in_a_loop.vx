//===----------------------------------------------------------------------===//
// A tensor variable gets a new tensor in each pass of a loop, and in one arm of a `match`.
// The code after the loop or the `match` must read the last tensor.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
// CHECK: {{^}}loop 6 32 7{{$}}
// CHECK: {{^}}match 1 2 7{{$}}
// CHECK: {{^}}match 3 3 9{{$}}

fn bump(t : Tensor<i64, [3]>) -> Tensor<i64, [3]> {
  let mut u = Tensor<i64, [3]>::fill(7);
  u[0] = t[0] + 1;
  u[1] = t[1] * 2;
  return u;
}

fn after_a_loop() -> void {
  let mut t = Tensor<i64, [3]>::fill(1);
  for i in 0..5 {
    t = bump(t);
  }
  println!("loop {} {} {}", t[0], t[1], t[2]);
}

fn after_a_match(n : i32) -> void {
  let mut t = Tensor<i64, [3]>::fill(1);
  t[2] = 7;
  match n {
    0 => {
      t[1] = 2;
    }
    _ => {
      t = Tensor<i64, [3]>::fill(3);
      t[2] = 9;
    }
  }
  println!("match {} {} {}", t[0], t[1], t[2]);
}

fn main() -> i32 {
  after_a_loop();
  after_a_match(0);
  after_a_match(1);
  return 0;
}
