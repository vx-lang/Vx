//===- cpu_matmul.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=LLVM
// FileCheck %s

fn test_f32() -> i32 {
  let mut a = unsafe { Tensor<f32, [4, 4]>::uninit() };
  let mut b = unsafe { Tensor<f32, [4, 4]>::uninit() };
  let mut c = unsafe { Tensor<f32, [4, 4]>::uninit() };

  for i in 0..4 {
    for j in 0..4 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }

  for i in 0..4 {
    for j in 0..4 {
      c[i][j] = 0.0;
      for k in 0..4 {
        c[i][j] = c[i][j] + a[i][k] * b[k][j];
      }
    }
  }

  // 4 * (2.0 * 3.0) = 24.0
  assert(c[0][0] == 24.0, "f32 matmul 0,0 match");
  assert(c[2][3] == 24.0, "f32 matmul 2,3 match");
  assert(c[3][3] == 24.0, "f32 matmul 3,3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = unsafe { Tensor<bf16, [4, 4]>::uninit() };
  let mut b = unsafe { Tensor<bf16, [4, 4]>::uninit() };
  let mut c = unsafe { Tensor<bf16, [4, 4]>::uninit() };

  for i in 0..4 {
    for j in 0..4 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }

  for i in 0..4 {
    for j in 0..4 {
      c[i][j] = 0.0;
      for k in 0..4 {
        c[i][j] = c[i][j] + a[i][k] * b[k][j];
      }
    }
  }

  assert(c[0][0] == 24.0, "bf16 matmul 0,0 match");
  assert(c[2][3] == 24.0, "bf16 matmul 2,3 match");
  assert(c[3][3] == 24.0, "bf16 matmul 3,3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// The extents are constants, so each buffer is allocated with a static shape.
// CHECK-LABEL: func.func @test_f32() -> i32
// CHECK: memref.alloc() : memref<4x4xf32>
// CHECK-LABEL: func.func @test_bf16() -> i32
// CHECK: memref.alloc() : memref<4x4xbf16>

// convert-vx-to-standard keeps the same allocation.
// STD-LABEL: func.func @test_f32() -> i32
// STD: memref.alloc() : memref<4x4xf32>

// --emit-llvm stops at the LLVM dialect, where the same function is an llvm.func. Each
// 16-element buffer becomes a stack allocation.
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_f32() -> i32
// LLVM: %[[SIXTEEN:.*]] = llvm.mlir.constant(16 : index) : i64
// LLVM: llvm.alloca %[[SIXTEEN]] x f32
// LLVM-LABEL: llvm.func {{(hidden )?}}@test_bf16() -> i32
