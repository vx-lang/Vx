// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_get_temp_file(
// CHECK-DAG: func.func private @vx_file_open(
// CHECK-DAG: func.func private @vx_file_write(
// CHECK-DAG: func.func private @vx_file_drop(
// CHECK-DAG: func.func private @malloc(
// CHECK-DAG: func.func private @vx_file_read(
// CHECK-DAG: func.func private @free(
// CHECK-DAG: func.func private @remove(
// CHECK-DAG: func.func private @vx_free_temp_file(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_get_temp_file(%{{.*}}) : (!llvm.ptr) -> !llvm.ptr
// CHECK: %[[V1:.*]] = call @vx_file_open(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> !llvm.ptr
// CHECK: call @vx_file_write(%[[V1]], %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, i64) -> i64
// CHECK: call @vx_file_drop(%[[V1]]) : (!llvm.ptr) -> i32
// CHECK: %[[V2:.*]] = call @vx_file_open(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> !llvm.ptr
// CHECK: %[[V3:.*]] = call @malloc(%{{.*}}) : (i64) -> !llvm.ptr
// CHECK: call @vx_file_read(%[[V2]], %[[V3]], %{{.*}}) : (!llvm.ptr, !llvm.ptr, i64) -> i64
// CHECK: call @vx_file_drop(%[[V2]]) : (!llvm.ptr) -> i32
import std::io;
extern {
  fn vx_file_open(c_path : *const i8, mode : i32) -> *mut i8;
  fn vx_file_read(ptr : *mut i8, buffer : *mut u8, len : i64) -> i64;
  fn vx_file_write(ptr : *mut i8, buffer : *const i8, len : i64) -> i64;
  fn vx_file_seek(ptr : *mut i8, offset : i64, whence : i32) -> i64;
  fn vx_file_drop(ptr : *mut i8) -> i32;
  fn malloc(size : i64)->*mut u8;
  fn free(ptr : *mut u8) -> i32;
  fn remove(filename : *const i8) -> i32;
  fn vx_get_temp_file(filename : *const i8) -> *mut i8;
  fn vx_free_temp_file(ptr : *mut i8) -> i32;
}

fn main() -> i32 {
  unsafe {
    let path : *mut i8 = vx_get_temp_file("test_output.txt");

    let file_w = vx_file_open(path, 1);
    let msg = "Hello";
    let bytes_written = vx_file_write(file_w, msg, 5);
    vx_file_drop(file_w);

    let file_r = vx_file_open(path, 0);
    let buffer = malloc(5);
    let bytes_read = vx_file_read(file_r, buffer, 5);
    vx_file_drop(file_r);
    free(buffer);

    remove(path);

    vx_free_temp_file(path);

    let mut success : i32 = 0;
    if bytes_written!= 5 {
      success = 1;
    }
    if bytes_read!= 5 {
      success = 2;
    }
    print!("Success: ");
    print!(success);
  }
  return 0;
}
// EXPECT: Success: 0
