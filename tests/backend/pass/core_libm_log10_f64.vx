//===----------------------------------------------------------------------===//
// f64 `log10`, ported from LLVM libc into `core::libm`, against LLVM libc itself (f475f085bf7b,
// built with FMA). It prints the bits of `x.log10()` (a NaN as 9221120237041090560) for eight
// inputs whose fast result is wrong, so that the accurate pass must fix it (found by searching
// random doubles), for special values and for 10^1 to 10^22, which have exact answers; then a hash
// of 2^20 random doubles; then a hash of the accurate pass called directly on 2^16 random positive
// doubles, since few inputs reach it through `log10`. The port also matched LLVM libc on 2^30
// random doubles and the accurate pass on 2^26.
//
// EXPECT: 13861901911017048380 13860703540854913110 13860383742270406233 13860052682466040123 13859660031974738822 13867105876199381501 13858138629277135247 13857007073362044100 18442240474082181120 18442240474082181120 0 9221120237041090560 4599094494223104511 4607182418800017408 4601495173785380110 13822466531077880319 13867357308859711488 4643985272004935680 9218868437227405312 9221120237041090560 9221120237041090560 13867767316136018804 4644130490496809471 4367307993162114317 13586176430389519631 4607182418800017408 4611686018427387904 4613937818241073152 4616189618054758400 4617315517961601024 4618441417868443648 4619567317775286272 4620693217682128896 4621256167635550208 4621819117588971520 4622382067542392832 4622945017495814144 4623507967449235456 4624070917402656768 4624633867356078080 4625196817309499392 4625478292286210048 4625759767262920704 4626041242239631360 4626322717216342016 4626604192193052672 4626885667169763328 14908568408483215279 13153348034764313911
import core::num;

fn bits(r : f64) -> u64 {
  if r != r {
    return 9221120237041090560u64;
  }
  return r.to_bits();
}

fn check(x : u64) -> i32 {
  print(bits(f64::from_bits(x).log10()));
  print!(" ");
  return 0;
}

fn main() -> i32 {
  let _r0 = check(2729793816806175733u64);
  let _r1 = check(2984484693690647921u64);
  let _r2 = check(3052566893998792464u64);
  let _r3 = check(3122777932189119817u64);
  let _r4 = check(3206617310084160007u64);
  let _r5 = check(332660496164429466u64);
  let _r6 = check(3529870083008268587u64);
  let _r7 = check(3709946292523436590u64);
  let _r8 = check(0u64);
  let _r9 = check(9223372036854775808u64);
  let _r10 = check(4607182418800017408u64);
  let _r11 = check(13830554455654793216u64);
  let _r12 = check(4611686018427387904u64);
  let _r13 = check(4621819117588971520u64);
  let _r14 = check(4613303445314885481u64);
  let _r15 = check(4602678819172646912u64);
  let _r16 = check(118622047889322841u64);
  let _r17 = check(9094988921128908188u64);
  let _r18 = check(9218868437227405312u64);
  let _r19 = check(18442240474082181120u64);
  let _r20 = check(9221120237041090560u64);
  let _r21 = check(1u64);
  let _r22 = check(9218868437227405311u64);
  let _r23 = check(4607182418800017409u64);
  let _r24 = check(4607182418800017407u64);
  let _r25 = check(4621819117588971520u64);
  let _r26 = check(4636737291354636288u64);
  let _r27 = check(4652007308841189376u64);
  let _r28 = check(4666723172467343360u64);
  let _r29 = check(4681608360884174848u64);
  let _r30 = check(4696837146684686336u64);
  let _r31 = check(4711630319722168320u64);
  let _r32 = check(4726483295884279808u64);
  let _r33 = check(4741671816366391296u64);
  let _r34 = check(4756540486875873280u64);
  let _r35 = check(4771362005757984768u64);
  let _r36 = check(4786511204640096256u64);
  let _r37 = check(4801453603149578240u64);
  let _r38 = check(4816244402031689728u64);
  let _r39 = check(4831355200913801216u64);
  let _r40 = check(4846369599423283200u64);
  let _r41 = check(4861130398305394688u64);
  let _r42 = check(4876203697187506176u64);
  let _r43 = check(4891288408196988160u64);
  let _r44 = check(4906019910204099648u64);
  let _r45 = check(4921056587992461136u64);
  let _r46 = check(4936209963552724370u64);
  let mut s : u64 = 88172645463325252u64;
  let mut h : u64 = 0u64;
  for i in 0..1048576 {
    s = s ^ (s << 13u64);
    s = s ^ (s >> 7u64);
    s = s ^ (s << 17u64);
    h = (h ^ bits(f64::from_bits(s).log10())).wrapping_mul(1099511628211u64);
  }
  print(h);
  print!(" ");
  s = 88172645463325252u64;
  h = 0u64;
  for i in 0..65536 {
    s = s ^ (s << 13u64);
    s = s ^ (s >> 7u64);
    s = s ^ (s << 17u64);
    let xb = (s & 4503599627370495u64) | ((1u64 + (s >> 52u64) % 2046u64) << 52u64);
    let index = ((xb >> 45u64) & 127u64) as i64;
    let x_e = -1023 + ((xb + 35184372088832u64) >> 52u64) as i32;
    let m = f64::from_bits((xb & 4503599627370495u64) | 4607182418800017408u64);
    let r = libm_log10_accurate(x_e, index, libm_multiply_add(LIBM_COMMON_RD[index], m, -1.0));
    h = (h ^ bits(r)).wrapping_mul(1099511628211u64);
  }
  print(h);
  return 0;
}
