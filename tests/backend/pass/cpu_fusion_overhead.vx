//===- cpu_fusion_overhead.vx ------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM

extern "C" {
  fn vx_get_time() -> f32;
  fn print_f32(val: f32) -> i32;
}

fn main() -> i32 {
  let mut a = Tensor_f32(128, 128);
  let mut b = Tensor_f32(128, 128);
  let mut bias = Tensor_f32(128, 128);
  let mut out_unfused = Tensor_f32(128, 128);
  let mut out_fused = Tensor_f32(128, 128);

  for i in 0..128 {
    for j in 0..128 {
      let sum_idx = i + j;
      if sum_idx == 0 {
        a[i][j] = 1.0;
        bias[i][j] = 0.0 - 150.0;
      } else {
        a[i][j] = 0.0 - 1.0;
        bias[i][j] = 50.0;
      }
      b[i][j] = 1.0;
      out_unfused[i][j] = 0.0;
      out_fused[i][j] = 0.0;
    }
  }

  let mut temp_matmul = Tensor_f32(128, 128);
  let mut temp_bias = Tensor_f32(128, 128);

  // Warmup Unfused
  for i in 0..128 {
    for j in 0..128 {
      temp_matmul[i][j] = 0.0;
      for k in 0..128 {
         temp_matmul[i][j] += a[i][k] * b[k][j];
      }
    }
  }
  for i in 0..128 {
    for j in 0..128 {
      temp_bias[i][j] = temp_matmul[i][j] + bias[i][j];
    }
  }
  for i in 0..128 {
    for j in 0..128 {
      let val = temp_bias[i][j];
      if val > 0.0 {
         out_unfused[i][j] = val;
      } else {
         out_unfused[i][j] = 0.0;
      }
    }
  }

  // Warmup Fused
  for i in 0..128 {
    for j in 0..128 {
      let mut sum = 0.0;
      for k in 0..128 {
         sum += a[i][k] * b[k][j];
      }
      sum += bias[i][j];
      if sum > 0.0 {
         out_fused[i][j] = sum;
      } else {
         out_fused[i][j] = 0.0;
      }
    }
  }

  // Verify correctness
  for i in 0..128 {
    for j in 0..128 {
      assert(out_unfused[i][j] == out_fused[i][j], "Mismatch between fused and unfused results");
    }
  }

  unsafe {
    // Benchmark Unfused
    let t1 = vx_get_time();
    for _iter in 0..10 {
      for i in 0..128 {
        for j in 0..128 {
          temp_matmul[i][j] = 0.0;
          for k in 0..128 {
             temp_matmul[i][j] += a[i][k] * b[k][j];
          }
        }
      }
      for i in 0..128 {
        for j in 0..128 {
          temp_bias[i][j] = temp_matmul[i][j] + bias[i][j];
        }
      }
      for i in 0..128 {
        for j in 0..128 {
          let val = temp_bias[i][j];
          if val > 0.0 {
             out_unfused[i][j] = val;
          } else {
             out_unfused[i][j] = 0.0;
          }
        }
      }
    }
    let t2 = vx_get_time();
    let time_unfused = t2 - t1;

    // Benchmark Fused
    let t3 = vx_get_time();
    for _iter in 0..10 {
      for i in 0..128 {
        for j in 0..128 {
          let mut sum = 0.0;
          for k in 0..128 {
             sum += a[i][k] * b[k][j];
          }
          sum += bias[i][j];
          if sum > 0.0 {
             out_fused[i][j] = sum;
          } else {
             out_fused[i][j] = 0.0;
          }
        }
      }
    }
    let t4 = vx_get_time();
    let time_fused = t4 - t3;

    print_f32(time_unfused);
    print_f32(time_fused);
  }

  // NO_EXEC
  return 0;
}

