//===- cpu_fusion_overhead.vx ------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 | FileCheck %s --check-prefixes=MLIR,MLIR-O0
// RUN: vxc %s --emit-mlir -O3 | FileCheck %s --check-prefixes=MLIR,MLIR-O3
// RUN: vxc %s --emit-llvm -O3 | FileCheck %s --check-prefix=LLVM

import std::io;
import std::time;

fn main() -> i32 {
  let mut a = Tensor<f32, [128, 128]>::uninit();
  let mut b = Tensor<f32, [128, 128]>::uninit();
  let mut bias = Tensor<f32, [128, 128]>::uninit();
  let mut out_unfused = Tensor<f32, [128, 128]>::uninit();
  let mut out_fused = Tensor<f32, [128, 128]>::uninit();

  for i in 0..128 {
    for j in 0..128 {
      let sum_idx = i + j;
      if sum_idx == 0 {
        a[i][j] = 1.0;
        bias[i][j] = 0.0 - 150.0;
      } else {
        a[i][j] = 0.0 - 1.0;
        bias[i][j] = 50.0;
      }
      b[i][j] = 1.0;
      out_unfused[i][j] = 0.0;
      out_fused[i][j] = 0.0;
    }
  }

  let mut temp_matmul = Tensor<f32, [128, 128]>::uninit();
  let mut temp_bias = Tensor<f32, [128, 128]>::uninit();

  // Warmup Unfused
  for i in 0..128 {
    for j in 0..128 {
      temp_matmul[i][j] = 0.0;
      for k in 0..128 {
        temp_matmul[i][j] += a[i][k] * b[k][j];
      }
    }
  }
  for i in 0..128 {
    for j in 0..128 {
      temp_bias[i][j] = temp_matmul[i][j] + bias[i][j];
    }
  }
  for i in 0..128 {
    for j in 0..128 {
      let val = temp_bias[i][j];
      if val > 0.0 {
        out_unfused[i][j] = val;
      } else {
        out_unfused[i][j] = 0.0;
      }
    }
  }

  // Warmup Fused
  for i in 0..128 {
    for j in 0..128 {
      let mut sum = 0.0;
      for k in 0..128 {
        sum += a[i][k] * b[k][j];
      }
      sum += bias[i][j];
      if sum > 0.0 {
        out_fused[i][j] = sum;
      } else {
        out_fused[i][j] = 0.0;
      }
    }
  }

  // Verification
  for i in 0..128 {
    for j in 0..128 {
      assert(out_unfused[i][j] == out_fused[i][j],
      "Mismatch between fused and unfused CPU results");
    }
  }

  // Benchmark Unfused
  let t1 = now();
  for _iter in 0..10 {
    for i in 0..128 {
      for j in 0..128 {
        temp_matmul[i][j] = 0.0;
        for k in 0..128 {
          temp_matmul[i][j] += a[i][k] * b[k][j];
        }
      }
    }
    for i in 0..128 {
      for j in 0..128 {
        temp_bias[i][j] = temp_matmul[i][j] + bias[i][j];
      }
    }
    for i in 0..128 {
      for j in 0..128 {
        let val = temp_bias[i][j];
        if val > 0.0 {
          out_unfused[i][j] = val;
        } else {
          out_unfused[i][j] = 0.0;
        }
      }
    }
  }
  let t2 = now();
  let time_unfused = t2 - t1;

  // Benchmark Fused
  let t3 = now();
  for _iter in 0..10 {
    for i in 0..128 {
      for j in 0..128 {
        let mut sum = 0.0;
        for k in 0..128 {
          sum += a[i][k] * b[k][j];
        }
        sum += bias[i][j];
        if sum > 0.0 {
          out_fused[i][j] = sum;
        } else {
          out_fused[i][j] = 0.0;
        }
      }
    }
  }
  let t4 = now();
  let time_fused = t4 - t3;

  print!(time_unfused);
  print!(time_fused);

  // We expect fused to be faster or equal, but let's just log it and not
  // assert because caching effects could sometimes make them close, or O3
  // might fuse both anyway.

  return 0;
}
// NO_EXEC

// MLIR-LABEL: func.func @main() -> i32 attributes {llvm.emit_c_interface} {

// At -O0 the 128x128 extents are still runtime values: two index casts feed a dynamic alloc.
// MLIR-O0: %[[D0:.*]] = arith.index_cast %{{.*}} : i32 to index
// MLIR-O0: %[[D1:.*]] = arith.index_cast %{{.*}} : i32 to index
// MLIR-O0: memref.alloc(%[[D0]], %[[D1]]) : memref<?x?xf32>

// At -O3 they fold and the buffer is statically shaped.
// MLIR-O3: memref.alloc() : memref<128x128xf32>

// --emit-llvm stops at the LLVM dialect, so main is still an llvm.func here.
// LLVM-LABEL: llvm.func @main() -> i32 attributes {llvm.emit_c_interface} {
