//===----------------------------------------------------------------------===//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The two shapes whose flat lowering reads a memref's own parts back by name: a
// row of a rank-3 tensor (`arow` below, with `memref.extract_strided_metadata`)
// and a row of a run-time-shaped tensor (`drow` below, with `memref.dim`).
// The SPIR-V argument flattening rewrites both into the flat arguments' address
// arithmetic, so the kernel stays on the device, and this file checks the
// answer the host path computes.
//
// Flat path only: the legacy code generator lowers a `memref.dim` of a row view
// with the wrong number of indices. Both shapes are the flat emitter's.
//
// REQUIRES: flat-codegen
// CHECK: vx.spawn topology({{[0-9]+}}) {
// CHECK: } {arch = "spirv64"
// EXPECT: [[0,   4,   8],
// EXPECT:  [12,   16,   20]]

Memory CPU_DRAM {}
Memory DEV_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: spirv64,
  memory: Memory::DEV_HBM,
  visible: [Memory::DEV_HBM],
  transfer Memory::CPU_DRAM -> Memory::DEV_HBM : 63 GB/s
}

fn main() -> i32 {
  // A run-time-shaped tensor: a row of it has a run-time extent.
  let mut d = unsafe { Tensor<f32, [?, ?]>::uninit([2, 3]) };
  // A rank-3 tensor: its middle row is a strided view.
  let mut a = unsafe { Tensor<f32, [2, 3, 3]>::uninit() };
  let mut o = unsafe { Tensor<f32, [2, 3]>::uninit() };
  for i in 0..2 {
    for j in 0..3 {
      d[i][j] = ((i * 3 + j) as f32);
      o[i][j] = 0.0;
      for k in 0..3 {
        a[i][j][k] = ((i * 9 + j * 3 + k) as f32);
      }
    }
  }
  let dd = transfer(d, Memory::DEV_HBM);
  let ad = transfer(a, Memory::DEV_HBM);
  let mut od = transfer(o, Memory::DEV_HBM);
  spawn on(Topology::Dev) {
    for i in 0..2 {
      let drow = dd[i];
      let arow = ad[i];
      let mut orow = od[i];
      for j in 0..3 {
        // drow[j] is the memref.dim path. arow[j][0] is the strided-row path.
        orow[j] = drow[j] + arow[j][0];
      }
    }
  }
  let home = transfer(od, Memory::CPU_DRAM);
  print(home);
  return 0;
}
