//===----------------------------------------------------------------------===//
// REQUIRES: legacy-codegen
//
// i128::MIN / (2^64 - 1) is not overflow. A 64-bit-only -1 constant made the
// overflow guard treat this divisor as -1 and stop the program.
//
// Build MIN as (i64::MIN as i128) << 64 so the test does not need a 39-digit
// literal. Flat emit-obj / ParseType still reject i128 element types, so this
// fixture is legacy-codegen only (and skipped by the flat corpus sweep via
// REQUIRES).
//
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
//
// CHECK: -9223372036854775808
// CHECK-NEXT: ok

fn div(a : i128, b : i128) -> i128 {
  return a / b;
}

fn main() -> i32 {
  let min64 : i64 = -9223372036854775807 - 1;
  let min : i128 = (min64 as i128) << 64;
  let one : i128 = 1;
  let u64_max_as_i128 : i128 = (one << 64) - 1;
  print(div(min, u64_max_as_i128));
  println!("");
  print!("ok");
  println!("");
  return 0;
}
