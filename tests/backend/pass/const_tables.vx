//===----------------------------------------------------------------------===//
// The values `const` tables hold, on both code generators. Printed, in order: the sum of an
// `i64` table with a negative entry; the largest `u64`; an `f64` entry times 3, which an `f32`
// would print as 0.3; a negative `f64` entry; two `f32` entries, one negative; a table read
// inside another function; a local named like a table; and a table from an imported module,
// read directly and through that module's own function.
//
// EXPECT: -889 18446744073709551615 0.30000000000000004 -0.25 0.1 -2.5 16 7 7
import tests::modules::a_module_with_consts;

const POWERS : Tensor<i64, [4]> = [1, 10, 100, -1000];
const BIG : Tensor<u64, [2]> = [18446744073709551615, 7];
const HALVES : Tensor<f64, [3]> = [0.5, -0.25, 0.1];
const SMALL : Tensor<f32, [2]> = [0.1, -2.5];
const SQUARES : Tensor<i32, [5]> = [0, 1, 4, 9, 16];

fn square(i : i64) -> i32 {
  return SQUARES[i];
}

fn named_like_a_table() -> i32 {
  let SQUARES = 7;
  return SQUARES;
}

fn main() -> i32 {
  let mut sum : i64 = 0i64;
  for i in 0..4 {
    sum = sum + POWERS[i];
  }
  print(sum);
  print!(" ");
  print(BIG[0]);
  print!(" ");
  print(HALVES[2] * 3.0);
  print!(" ");
  print(HALVES[1]);
  print!(" ");
  print(SMALL[0]);
  print!(" ");
  print(SMALL[1]);
  print!(" ");
  print(square(4i64));
  print!(" ");
  print(named_like_a_table());
  print!(" ");
  print(face(5i64) + FACES[0]);
  return 0;
}
