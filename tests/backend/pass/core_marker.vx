//===----------------------------------------------------------------------===//
// `core::marker`, and the `Copy` impls the core types get from it.
//
// Every case below reads the *original* after assigning it somewhere else, which is the
// whole of what `Copy` buys. Without the impl the second read is a compile failure rather
// than a wrong answer, so that is what a broken `Copy` looks like here.
//
// Removing any of the three impls, `Ordering`'s, `Option<T>`'s or `Result<T, E>`'s, stops
// this file building.
//
// `Option<T>` and `Result<T, E>` are conditional -- they copy when what they hold does --
// so each is instantiated at a scalar, which is the case the bound admits.
//
// `PhantomData` is constructed and not read, because there is nothing in it to read. It is
// here so that a change breaking the empty generic struct is a failure in `core`'s own
// tests rather than somewhere downstream.
import core::cmp;
import core::marker;
import core::option;
import core::result;

fn show(flag : bool) -> i32 {
  if flag {
    print(1);
  } else {
    print(0);
  }
  return 0;
}

fn main() -> i32 {
  let m = PhantomData<i32> { };

  let o : Ordering = Ordering::Greater();
  let p : Ordering = o;
  show(o.is_gt());
  print!(" ");
  show(p.is_gt());
  print!(" | ");

  let a = Option<i32>::Some(5);
  let b = a;
  print(a.unwrap_or(-1));
  print!(" ");
  print(b.unwrap_or(-1));
  print!(" | ");

  let r = Result<i32, i32>::Ok(7);
  let s = r;
  print(r.unwrap_or(-1));
  print!(" ");
  print(s.unwrap_or(-1));
  return 0;
}

// EXPECT: 1 1 | 5 5 | 7 7
