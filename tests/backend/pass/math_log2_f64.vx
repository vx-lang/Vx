// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @log2(
// CHECK-DAG: func.func private @fabs(
// CHECK-LABEL: func.func @f64$log2(%arg0: f64) -> f64
// CHECK: call @log2(%{{.*}}) : (f64) -> f64
// CHECK-LABEL: func.func @f64$abs(%arg0: f64) -> f64
// CHECK: call @fabs(%{{.*}}) : (f64) -> f64
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @f64$log2(%{{.*}}) : (f64) -> f64
// CHECK: call @f64$abs(%{{.*}}) : (f64) -> f64
import std::math;

fn main() -> i32 {
  let x : f64 = 4.0;
  let res : f64 = x.log2();
  let expected : f64 = 2.0;

  // allow small floating point difference
  let diff : f64 = (res - expected).abs();
  let mut ret : i32 = 1;
  if diff < 0.001 {
    ret = 0;
  }
  return ret;
}
