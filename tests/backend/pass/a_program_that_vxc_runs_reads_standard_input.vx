//===----------------------------------------------------------------------===//
// `vxc FILE.vx` runs the program with the standard input of vxc. The program counts the lines
// and bytes that it reads. The second RUN line gives no input, so the program reads 0 bytes. It
// passes without the fix too, and shows that the program stops at end of input.
// RUN: printf 'first\nsecond\nthird\n' | vxc %s 2>&1 | FileCheck %s --check-prefix=PIPED
// RUN: vxc %s < /dev/null 2>&1 | FileCheck %s --check-prefix=EMPTY
// PIPED: {{^}}3 lines, 19 bytes{{$}}
// EMPTY: {{^}}0 lines, 0 bytes{{$}}

import std::io;
import std::vec;

fn main() -> i32 {
  let buffer = unsafe { Vec<u8>::zeroed(8) };
  let mut lines = 0;
  let mut bytes = 0u64;
  let mut count = unsafe { stdin_read(buffer.as_mut_ptr(), 8) };
  while count > 0 {
    bytes = bytes + count;
    for i in 0..count as i32 {
      if buffer.get(i) == 10u8 {
        lines = lines + 1;
      }
    }
    count = unsafe { stdin_read(buffer.as_mut_ptr(), 8) };
  }
  println!("{} lines, {} bytes", lines, bytes);
  return 0;
}
