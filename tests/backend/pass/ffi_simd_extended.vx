// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// main calls each function in order; the assertion is that the chain survives to codegen
// rather than being folded away.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @"Vec::with_capacity$f32"(%{{.*}}) : (i32) -> !llvm.struct<"Vec_f32", (ptr, i32, i32)>
// CHECK: call @"Vec::with_capacity$f32"(%{{.*}}) : (i32) -> !llvm.struct<"Vec_f32", (ptr, i32, i32)>
// CHECK: call @"Vec::with_capacity$f32"(%{{.*}}) : (i32) -> !llvm.struct<"Vec_f32", (ptr, i32, i32)>
// CHECK: call @"Vec::with_capacity$f32"(%{{.*}}) : (i32) -> !llvm.struct<"Vec_f32", (ptr, i32, i32)>
// CHECK: call @simd_add_f32x4(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, !llvm.ptr) -> i32
// CHECK: call @simd_sub_f32x4(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, !llvm.ptr) -> i32
// CHECK: call @simd_mul_f32x4(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, !llvm.ptr) -> i32
// CHECK: call @simd_div_f32x4(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, !llvm.ptr) -> i32
import std::simd;

import std::io;
import std::vec;

fn main() -> i32 {
  let mut ret : i32 = 1;
  unsafe {
    let a = Vec<f32>::with_capacity(4).data;
    let b = Vec<f32>::with_capacity(4).data;
    let c = Vec<f32>::with_capacity(4).data;
    let out = Vec<f32>::with_capacity(4).data;

    // Ideally we would initialize these, but in Vx doing pointer offset is
    // tricky without pointer arithmetic enabled in stdlib, which it might be
    // via `std::vec`. Let's just pass them to the functions to ensure they link
    // and execute successfully.

    let res1 = simd_add_f32x4(a, b, out);
    let res2 = simd_sub_f32x4(a, b, out);
    let res3 = simd_mul_f32x4(a, b, out);
    let res4 = simd_div_f32x4(a, b, out);
    let res5 = simd_fma_f32x4(a, b, c, out);

    let sum = res1 + res2 + res3 + res4 + res5;
    if sum == 0 {
      ret = 0;
    }
  }
  return ret;
}

// EXPECT:
