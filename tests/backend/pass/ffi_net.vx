// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_udp_socket_bind(
// CHECK-DAG: func.func private @vx_udp_socket_drop(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_udp_socket_bind(%{{.*}}) : (!llvm.ptr) -> !llvm.ptr
// CHECK: %[[V1:.*]] = call @vx_udp_socket_bind(%{{.*}}) : (!llvm.ptr) -> !llvm.ptr
// CHECK: call @vx_udp_socket_drop(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @vx_udp_socket_drop(%[[V1]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
import std::io;
extern {
  fn vx_udp_socket_bind(c_addr : *const i8) -> *mut i8;
  fn vx_udp_socket_recv(ptr : *mut i8, buffer : *mut u8, len : i64) -> i64;
  fn vx_udp_socket_send_to(ptr : *mut i8, buffer : *const u8, len : i64,
  c_addr : *const i8) -> i64;
  fn vx_udp_socket_drop(ptr : *mut i8) -> i32;
}

fn main() -> i32 {
  unsafe {
    let addr1 = "127.0.0.1:0";
    let socket1 = vx_udp_socket_bind(addr1);

    let addr2 = "127.0.0.1:0";
    let socket2 = vx_udp_socket_bind(addr2);

    vx_udp_socket_drop(socket1);
    vx_udp_socket_drop(socket2);
    print!("Net Success: ");
    print!(0);
  }
  return 0;
}
// EXPECT: Net Success: 0
