// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_udp_socket_bind(
// CHECK-DAG: func.func private @vx_udp_socket_drop(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @vx_udp_socket_bind(%{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr) -> i32
// CHECK: call @vx_udp_socket_bind(%{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr) -> i32
// CHECK: call @vx_udp_socket_drop(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @vx_udp_socket_drop(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
import std::io;
extern {
  fn vx_udp_socket_bind(c_addr : *const i8, out : *mut *mut i8) -> i32;
  fn vx_udp_socket_drop(ptr : *mut i8) -> i32;
}

fn main() -> i32 {
  unsafe {
    // Each bind gives its status, 0 when it worked, and the socket through `out`.
    let mut socket1 : *mut i8 = 0 as *mut i8;
    let status1 = vx_udp_socket_bind("127.0.0.1:0", (&mut socket1) as *mut *mut i8);

    let mut socket2 : *mut i8 = 0 as *mut i8;
    let status2 = vx_udp_socket_bind("127.0.0.1:0", (&mut socket2) as *mut *mut i8);

    vx_udp_socket_drop(socket1);
    vx_udp_socket_drop(socket2);
    print!("Net Success: ");
    print!(status1 + status2);
  }
  return 0;
}
// EXPECT: Net Success: 0
