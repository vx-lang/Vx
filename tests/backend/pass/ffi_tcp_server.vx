// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_tcp_listener_bind(
// CHECK-DAG: func.func private @vx_tcp_listener_drop(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_tcp_listener_bind(%{{.*}}) : (!llvm.ptr) -> !llvm.ptr
// CHECK: call @vx_tcp_listener_drop(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
import std::io;
extern {
  fn vx_tcp_listener_bind(c_addr : *const i8) -> *mut i8;
  fn vx_tcp_listener_drop(ptr : *mut i8) -> i32;
}

fn main() -> i32 {
  unsafe {
    // We bind to a random port and then drop to avoid blocking on accept
    // Since we don't have non-blocking mode or threading in our test harness
    let addr = "127.0.0.1:0";
    let listener = vx_tcp_listener_bind(addr);
    vx_tcp_listener_drop(listener);
    print!("TCP Server Success: ");
    print!(0);
  }
  return 0;
}
// EXPECT: TCP Server Success: 0
