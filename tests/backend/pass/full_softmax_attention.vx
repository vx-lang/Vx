//===----------------------------------------------------------------------===//
// Canonical (non-flash) scaled dot-product attention:
//   O = softmax(scale * Q * K^T) * V
// computed the textbook way -- materialize the score matrix, take a real
// numerically-stable row-wise softmax (subtract the row max, exp, normalize),
// then weight V. This is the reference form the flash/linear/sparse variants
// approximate or reorganize; it is the correctness anchor for the attention
// corpus (see attention_reference.vx for the 4-key oracle).
//
// Hand-checkable 2-query x 2-key, D=4, scale=1/2:
//   K row 0 = 0, K row 1 = 1;  V row 0 = 0, V row 1 = 2.
//   Query 0 = [1,1,1,1] -> raw scores [0, 4] -> scaled [0, 2].
//     softmax([0,2]) = [1, e^2]/(1+e^2) ~= [0.1192, 0.8808];
//     O0 = 0.8808 * 2 ~= 1.76159 per dim.
//   Query 1 = [0,0,0,0] -> scores [0,0] -> uniform softmax [0.5,0.5];
//     O1 = 0.5 * 2 = 1.0 per dim.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: func.func @main

import std::math;

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::uninit();
  let mut k = Tensor<f32, [2, 4]>::uninit();
  let mut v = Tensor<f32, [2, 4]>::uninit();
  let mut s = Tensor<f32, [2, 2]>::uninit();
  let mut o = Tensor<f32, [2, 4]>::uninit();

  for d in 0..4 {
    q[0][d] = 1.0;
    q[1][d] = 0.0;
    k[0][d] = 0.0;
    k[1][d] = 1.0;
    v[0][d] = 0.0;
    v[1][d] = 2.0;
  }

  let scale : f32 = 0.5;

  for i in 0..2 {
    // S_i = scale * Q_i . K_j  over the head dim
    for j in 0..2 {
      let mut acc : f32 = 0.0;
      for d in 0..4 {
        acc += q[i][d] * k[j][d];
      }
      s[i][j] = acc * scale;
    }
    // numerically-stable row softmax
    let mut mx : f32 = s[i][0];
    for j in 1..2 {
      let x : f32 = s[i][j];
      if x > mx {
        mx = x;
      }
    }
    let mut sum : f32 = 0.0;
    for j in 0..2 {
      let e : f32 = (s[i][j] - mx).exp();
      s[i][j] = e;
      sum += e;
    }
    for j in 0..2 {
      s[i][j] = s[i][j] / sum;
    }
    // O_i = P_i . V
    for c in 0..4 {
      let mut acc : f32 = 0.0;
      for j in 0..2 {
        acc += s[i][j] * v[j][c];
      }
      o[i][c] = acc;
    }
  }

  print(o);
  return 0;
}

// EXPECT: [[1.76159,
// EXPECT: [1,
