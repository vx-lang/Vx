//===----------------------------------------------------------------------===//
// A `let mut` local that holds a reference, such as `let mut s = self;`, reaches the fields of
// the value that it points to. The AST code generator took the address of `s.inner` in the stack
// slot of `s`. So `s.inner.get()` printed a pointer, and `s.inner.bump()` wrote into the slot.
// W1004 says that most of these `mut`s can go. The test needs them.
//
// EXPECT: 7 9 8 7 4 4

struct In {
  n : i64,
}

impl In {
  fn get(self : &In) -> i64 {
    return self.n;
  }

  fn bump(self : &mut In) -> i64 {
    self.n = self.n + 1;
    return 0;
  }
}

struct W {
  inner : In,
}

struct Outer {
  w : W,
}

impl W {
  fn call_on_a_field(self : &W) -> i64 {
    let mut s = self;
    return s.inner.get();
  }

  fn borrow_a_field_after_a_new_value(self : &W, other : &W) -> i64 {
    let mut s = self;
    s = other;
    let r = &s.inner;
    return r.n;
  }

  fn write_through_a_field(self : &mut W) -> i64 {
    let mut s = self;
    s.inner.bump();
    return s.inner.get();
  }
}

impl Outer {
  fn call_two_fields_deep(self : &Outer) -> i64 {
    let mut s = self;
    return s.w.inner.get();
  }
}

fn main() -> i32 {
  let w = W {
    inner: In {
      n: 7
    }
  };
  let v = W {
    inner: In {
      n: 9
    }
  };
  print!("{} ", w.call_on_a_field());
  print!("{} ", w.borrow_a_field_after_a_new_value(&v));
  let o = Outer {
    w: W {
      inner: In {
        n: 8
      }
    }
  };
  print!("{} ", o.call_two_fields_deep());
  let mut s = &w;
  print!("{} ", s.inner.get());
  let mut m = W {
    inner: In {
      n: 3
    }
  };
  print!("{} ", m.write_through_a_field());
  print!("{}\n", m.inner.n);
  return 0;
}
