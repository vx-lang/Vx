// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

import std::io;
import std::vec;

fn main() -> i32 {
  let mut v : Vec<f32> = Vec<f32>::with_capacity(4);

  // Set elements via pointer arithmetic
  let ptr = v.as_mut_ptr();
  unsafe { *ptr = 10.0; }

  v.free();

  return 0;
}

// CHECK-LABEL: func.func @main
// CHECK: call @Vec$f32$with_capacity$i32
// CHECK: call @Vec$f32$as_mut_ptr$f32
// CHECK: call @Vec$f32$free$f32
