// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The three Vec entry points are reached by call, and push/free take the address of the
// stack slot the constructed value was stored into.
// CHECK-LABEL: func.func @main
// CHECK: %[[V:.*]] = call @"Vec::with_capacity$f32"(%{{.*}}) : (i32) -> !llvm.struct<"Vec_f32", (ptr, i32, i32)>
// CHECK: %[[SLOT:.*]] = llvm.alloca %{{.*}} x !llvm.struct<"Vec_f32", (ptr, i32, i32)> : (i32) -> !llvm.ptr
// CHECK: llvm.store %[[V]], %[[SLOT]] : !llvm.struct<"Vec_f32", (ptr, i32, i32)>, !llvm.ptr
// CHECK: call @Vec$f32$push$f32(%[[SLOT]], %{{.*}}) : (!llvm.ptr, f32) -> i32
// CHECK: call @Vec$f32$free$f32(%[[SLOT]]) : (!llvm.ptr) -> i32

import std::io;
import std::vec;

fn main() -> i32 {
  let mut v : Vec<f32> = Vec<f32>::with_capacity(4);

  // Set elements safely
  v.push(10.0);

  v.free();

  return 0;
}

