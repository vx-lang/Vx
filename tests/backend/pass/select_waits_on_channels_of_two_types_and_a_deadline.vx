//===----------------------------------------------------------------------===//
// One `select3` waits on a channel of `i64`, a channel of `String` and a `Deadline`, and gives
// the index of the first that is ready. A task sends on one channel after 0.1 seconds, so the
// `select` waits first. With no send, the `Deadline` ends the wait.
//
// The last RUN line holds the timer for 0.3 seconds before each wake, so the wake of the
// deadline comes late. The `select` must still end at the deadline.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 VX_TEST_TIMER_PAUSE_MS=300 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}index 1: the String 42{{$}}
// CHECK-NEXT: {{^}}index 0: the i64 7{{$}}
// CHECK-NEXT: {{^}}index 2: the deadline{{$}}

import core::time;
import std::string;
import std::sync::channel;
import std::sync::select;
import std::time;

fn wait_once(numbers : &Receiver<i64>, texts : &Receiver<String>, quiet : &Deadline) -> void {
  match select3(numbers, texts, quiet) {
    Result<i32, SelectError>::Ok(i) => {
      if i == 0 {
        match numbers.try_recv() {
          Result<i64, TryRecvError>::Ok(v) => {
            println!("index 0: the i64 {}", v);
          }
          Result<i64, TryRecvError>::Err(_) => {
            println!("index 0 with no value");
          }
        }
      } else if i == 1 {
        match texts.try_recv() {
          Result<String, TryRecvError>::Ok(s) => {
            let mut text = s;
            println!("index 1: the String {}", text.as_c_str());
          }
          Result<String, TryRecvError>::Err(_) => {
            println!("index 1 with no value");
          }
        }
      } else {
        println!("index {}: the deadline", i);
      }
    }
    Result<i32, SelectError>::Err(_) => {
      println!("cancelled");
    }
  }
}

fn send_text_later(tx : Sender<String>) -> void {
  sleep(Duration::from_millis(100));
  let n : i64 = 42;
  let _sent = tx.send(n.to_string());
}

fn send_number_later(tx : Sender<i64>) -> void {
  sleep(Duration::from_millis(100));
  let _sent = tx.send(7);
}

fn main() -> i32 {
  let (number_tx, numbers) = channel<i64>(1);
  let (text_tx, texts) = channel<String>(1);
  let far = Deadline::after(Duration::from_secs(10));
  // Each task sends on a clone, so the channels stay open after the task ends.
  let text_clone = text_tx.clone();
  let number_clone = number_tx.clone();
  tasks {
    spawn {
      send_text_later(text_clone);
    };
    wait_once(&numbers, &texts, &far);
  };
  tasks {
    spawn {
      send_number_later(number_clone);
    };
    wait_once(&numbers, &texts, &far);
  };
  let soon = Deadline::after(Duration::from_millis(100));
  wait_once(&numbers, &texts, &soon);
  drop(number_tx);
  drop(text_tx);
  return 0;
}
