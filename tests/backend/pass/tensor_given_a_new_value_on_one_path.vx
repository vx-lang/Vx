//===----------------------------------------------------------------------===//
// A tensor gets a new value inside an `if` and is read after it. When the `if` is not taken,
// the read sees the tensor from before it: 1, then 2 when it is taken. The default code
// generator used to read the new tensor's buffer on both paths, and when the `if` was not
// taken nothing had been written there, so the first number came out wrong.
//
// EXPECT: 1 2

fn doubled(t : Tensor<f32, [4]>) -> Tensor<f32, [4]> {
  let mut u = Tensor<f32, [4]>::new();
  u[0] = t[0] * 2.0;
  return u;
}

fn first(c : bool) -> f32 {
  let mut t = Tensor<f32, [4]>::fill(1.0);
  if c {
    t = doubled(t);
  }
  return t[0];
}

fn main() -> i32 {
  print(first(false));
  print!(" ");
  print(first(true));
  return 0;
}
