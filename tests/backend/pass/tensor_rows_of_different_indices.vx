// RUN: vxc %s 2>&1 | FileCheck %s
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s
//
// Rows at different constant indices do not overlap: two `mut` rows of one tensor can be
// used together, and one row can be written while another is borrowed.

fn main() -> i32 {
  let mut q = Tensor<f32, [3, 4]>::new();
  let mut a = q[0];
  let mut b = q[1];
  a[0] = 1.0;
  b[0] = 2.0;
  q[2][0] = 4.0;
  a[1] = 8.0;
  print(q[0][0] + q[1][0] + q[2][0] + q[0][1]);
  return 0;
}

// CHECK: 15
