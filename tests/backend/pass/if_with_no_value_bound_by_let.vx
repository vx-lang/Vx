//===----------------------------------------------------------------------===//
// An `if` whose branches end with `;` has type `void`, and a `let` can still
// bind it. Each `if` runs its branch once.
//
// EXPECT: big small end

fn main() -> i32 {
  let x : i32 = 3;
  let _u = if x > 2 {
    print("big ");
  };
  let _v = if x > 5 {
    print("huge ");
  } else {
    print("small ");
  };
  print("end");
  return 0;
}
