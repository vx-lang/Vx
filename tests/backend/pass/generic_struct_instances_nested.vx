//===----------------------------------------------------------------------===//
// Two instances of one generic struct, each inside another generic struct: a `Map` over `i64`
// and a `Map` over `i32`, each inside a `Take`.
//
// Reading or writing a field through `&mut self` named the struct's LLVM type by its bare name,
// `Map`, where every other use names the instance. Two instances were then two bodies under one
// name, and MLIR refused the module.
//
// And a `for` loop called whichever `Take` `next` it found first, by prefix, for both loops.
// The `i64` items need more than 32 bits, so the `i32` one's answer is visibly wrong.
import core::iter;

fn main() -> i32 {
  let mut wide = range(0i64, 5i64).map(| x : i64 | x + 5000000000i64).take(2i64);
  for v in wide {
    print(v);
    print!(",");
  }
  print!(" ");
  let mut narrow = range(0i64, 5i64).map(| x : i64 | 5i32).take(2i64);
  for v in narrow {
    print(v);
    print!(",");
  }
  return 0;
}

// EXPECT: 5000000000,5000000001, 5,5,
