//===----------------------------------------------------------------------===//
// Read a nested struct by value with the constant argument written as 03 throughout.
// Compilation must use flat code generation.
// REQUIRES: flat-codegen
// EXPECT: 17

struct Sized<T, const N: i32> {
  value: T
}
struct Holder<T, const N: i32> {
  inner: Sized<T, N>
}
fn read(s: Sized<i32, 03>) -> i32 {
  return s.value;
}
fn main() -> i32 {
  let h = Holder<i32, 03> {
    inner: Sized<i32, 03> {
      value: 17
    }
  };
  print(read(h.inner));
  return 0;
}
