//===----------------------------------------------------------------------===//
// `p[i]` works when `p` is a reference to a struct that implements `Index` and `IndexMut`, as
// in Rust. `set_second` writes `p[1]` through a `&mut Pair`, and `first` reads `p[0]` through
// a `&Pair`. `q` starts as (1, 2) and ends as (1, 6).
//
// EXPECT: 1 6

import core::ops;

struct Pair {
  a : i32,
  b : i32,
}

impl Index for Pair {
  type Output = i32;
  fn index(self : &Pair, i : i32) -> &i32 {
    if i == 0 {
      return &self.a;
    }
    return &self.b;
  }
}

impl IndexMut for Pair {
  type Output = i32;
  fn index_mut(self : &mut Pair, i : i32) -> &mut i32 {
    if i == 0 {
      return &mut self.a;
    }
    return &mut self.b;
  }
}

fn set_second(p : &mut Pair) -> void {
  p[1] = 6;
}

fn first(p : &Pair) -> i32 {
  return p[0];
}

fn main() -> i32 {
  let mut q = Pair {
    a: 1, b: 2
  };
  set_second(&mut q);
  print(first(&q));
  print!(" ");
  print(q.b);
  return 0;
}
