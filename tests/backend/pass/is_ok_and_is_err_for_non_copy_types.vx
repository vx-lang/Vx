//===----------------------------------------------------------------------===//
// `is_ok` and `is_err` only look at which variant a `Result` holds, through a reference. They must
// not move the payload out of it, so `a` and `b` still hold their payloads after the calls.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}a failed: closed{{$}}
// CHECK-NEXT: {{^}}b succeeded: closed{{$}}

import core::result;

enum Failure {
  Closed,
}

fn failed(r : &Result<i64, Failure>) -> bool {
  return r.is_err();
}

fn succeeded(r : &Result<Failure, i64>) -> bool {
  return r.is_ok();
}

fn main() -> i32 {
  let a = Result<i64, Failure>::Err(Failure::Closed);
  let b = Result<Failure, i64>::Ok(Failure::Closed);
  if failed(&a) && succeeded(&b) {
    match a {
      Result<i64, Failure>::Ok(_) => {
        return 1;
      }
      Result<i64, Failure>::Err(f) => {
        match f {
          Failure::Closed => {
            println!("a failed: closed");
          }
        }
      }
    }
    match b {
      Result<Failure, i64>::Ok(f) => {
        match f {
          Failure::Closed => {
            println!("b succeeded: closed");
          }
        }
      }
      Result<Failure, i64>::Err(_) => {
        return 1;
      }
    }
    return 0;
  }
  return 1;
}
