// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_string_from_c_str(
// CHECK-DAG: func.func private @vx_string_push_c_str(
// CHECK-DAG: func.func private @vx_string_len(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-DAG: func.func private @vx_string_as_c_str(
// CHECK-DAG: func.func private @vx_string_free_c_str(
// CHECK-DAG: func.func private @vx_string_drop(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_string_from_c_str(%{{.*}}) : (!llvm.ptr) -> !llvm.ptr
// CHECK: call @vx_string_push_c_str(%[[V0]], %{{.*}}) : (!llvm.ptr, !llvm.ptr) -> i32
// CHECK: %[[V1:.*]] = call @vx_string_len(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%[[V1]]) : (i32) -> i32
// CHECK: %[[V2:.*]] = call @vx_string_as_c_str(%[[V0]]) : (!llvm.ptr) -> !llvm.ptr
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
import std::string;
import std::io;

fn main() -> i32 {
  unsafe {
    let s = vx_string_from_c_str("Hello ");
    vx_string_push_c_str(s, "World!");

    let len = vx_string_len(s);
    print!("Len: ");
    print!(len);

    let c_str = vx_string_as_c_str(s);
    print!("String: %s");
    print!(0); // We don't have vx_printf_str yet, but we'll test the length

    vx_string_free_c_str(c_str);
    vx_string_drop(s);
  }
  return 0;
}

// EXPECT: Len: 12
