//===----------------------------------------------------------------------===//
// Regression for the `@malloc_N` link failure (#321).
//
// `std::vec` pulls in `extern fn malloc`, which lands in the module as
// `func.func private @malloc`. `finalize-memref-to-llvm` needs a malloc for
// `memref.alloc`, cannot reuse that one because it looks for an `llvm.func`,
// and so creates its own -- whereupon the symbol table uniques the name. Every
// allocation site got a fresh `@malloc_0`, `@malloc_1`, ... none of which
// resolves at link time:
//
//   undefined reference to `malloc_11'
//
// The fix runs `symbol-dce` before memref finalization so a dead declaration
// never blocks the name. Both lowering pipelines carry it; the driver builds
// its own, separate from the one in codegen/mod.rs.
//
// The trigger is only this combination -- an `extern` declaration whose name
// MLIR also wants, plus at least one `memref.alloc` in the same module. Either
// alone is fine, which is why nothing caught it: the Llama programs were
// compile-only tests (`NO_EXEC`), and compiling never reaches the link.
//
// Two allocations, because a single one still produced a working binary in the
// broken state -- the collision needs a second site to strand a reference.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
import std::vec;

fn main() -> i32 {
  let mut a = Tensor<f32>([ 2, 2 ]);
  let mut b = Tensor<f32>([ 2, 2 ]);
  for i in 0..2 {
    for j in 0..2 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }
  let total : f32 = a[1][1] + b[1][1];
  print(total);
  return 0;
}

// EXPECT: 5
