//===----------------------------------------------------------------------===//
// A program can have functions with the names of tensor methods, such as `transpose` and
// `clone`. A call of such a function calls it, and `u.transpose([1, 0])` is still the method.
//
// EXPECT: functions 6 4 8 10 12 14 21
// EXPECT: transpose 9
// EXPECT: methods 4 7 4

fn transpose(t : &mut Tensor<i32, [2, 3]>) -> void {
  t[0][0] = 9;
  return;
}

fn reshape(x : i32, y : i32) -> i32 {
  return x * y;
}

fn pad(x : i32, y : Tensor<i32, [2]>) -> i32 {
  return x + y[1];
}

fn clone(x : i32) -> i32 {
  return x * 2;
}

fn as_ptr(x : i32) -> i32 {
  return x + 5;
}

fn as_mut_ptr(x : i32) -> i32 {
  return x + 6;
}

fn map(x : i32) -> i32 {
  return x * 7;
}

fn reduce(a : i32, b : i32, c : i32) -> i32 {
  return a * b * c;
}

fn main() -> i32 {
  println!("functions {} {} {} {} {} {} {}", reshape(2, 3), pad(1, [2, 3]), clone(4), as_ptr(5), as_mut_ptr(6), map(2), reduce(1, 3, 7));

  let mut a = Tensor<i32, [2, 3]>::new();
  transpose(&mut a);
  println!("transpose {}", a[0][0]);

  // u = [[0, 0, 7],
  //      [4, 0, 0]]
  let mut u = Tensor<f32, [2, 3]>::fill(0.0);
  u[1][0] = 4.0;
  u[0][2] = 7.0;
  let p = u.transpose([1, 0]);
  let r = u.reshape([3, 2]);
  let c = u.clone();
  println!("methods {} {} {}", p[0][1] as i32, r[1][0] as i32, c[1][0] as i32);
  return 0;
}
