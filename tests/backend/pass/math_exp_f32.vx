// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @expf(
// CHECK-DAG: func.func private @fabsf(
// CHECK-LABEL: func.func @f32$exp(%arg0: f32) -> f32
// CHECK: call @expf(%{{.*}}) : (f32) -> f32
// CHECK-LABEL: func.func @f32$abs(%arg0: f32) -> f32
// CHECK: call @fabsf(%{{.*}}) : (f32) -> f32
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @f32$exp(%{{.*}}) : (f32) -> f32
// CHECK: call @f32$abs(%{{.*}}) : (f32) -> f32
import std::math;

fn main() -> i32 {
  let x : f32 = 0.0;
  let res : f32 = x.exp();
  let expected : f32 = 1.0;

  // allow small floating point difference
  let diff : f32 = (res - expected).abs();
  let mut ret : i32 = 1;
  if diff < 0.001 {
    ret = 0;
  }
  return ret;
}
