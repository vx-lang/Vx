//===----------------------------------------------------------------------===//
// `within(limit, body)` gives the waits in `body` one time limit. Each `recv` here waits for a
// value that never comes, because `main` holds the `Sender`. After the limit, a wait gives up as
// in a cancelled block, and `cancelled()` is true until `body` returns.
//
// - Two waits in one body of 0.5 seconds share the 0.5 seconds, so both take less than 1 second
//   together.
// - In two nested calls, the earlier deadline counts, so 0.2 seconds inside 30 seconds, and 30
//   seconds inside 0.2 seconds, both give up soon.
// - `within` gives the value of `body`, and the deadline ends when `body` returns, so a wait
//   after the call does not give up at once. The same holds for a call in a loop, a body that
//   leaves with `return`, and a body that gives back an error with `?`.
// - In a `drop`, `within` shortens the drop's limit, and W1036 does not warn about its wait.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning
// CHECK: {{^}}two waits gave up: true true{{$}}
// CHECK-NEXT: {{^}}they took less than 1 second together: true{{$}}
// CHECK-NEXT: {{^}}after the call, cancelled false{{$}}
// CHECK-NEXT: {{^}}the inner call gave up: true{{$}}
// CHECK-NEXT: {{^}}the outer call gave up: true{{$}}
// CHECK-NEXT: {{^}}nested calls took less than 5 seconds: true{{$}}
// CHECK-NEXT: {{^}}the body gave 2, and after it, cancelled false{{$}}
// CHECK-NEXT: {{^}}3 calls in a loop, and after them, cancelled false{{$}}
// CHECK-NEXT: {{^}}the body returned 7 early, and after it, cancelled false{{$}}
// CHECK-NEXT: {{^}}the body gave back an error with ?: true, and after it, cancelled false{{$}}
// CHECK-NEXT: {{^}}the drop gave up, cancelled true{{$}}
// CHECK-NEXT: {{^}}the drop took less than 5 seconds: true{{$}}

import core::time;
import std::sync::channel;
import std::sync::wait;
import std::time;

/// Whether a `recv` on `rx` gave up.
fn gave_up(rx : &Receiver<i64>) -> bool {
  match rx.recv() {
    Result<i64, RecvError>::Ok(_v) => {
      return false;
    }
    Result<i64, RecvError>::Err(_e) => {
      return true;
    }
  }
}

struct Waiter {
  rx : Receiver<i64>,
}

impl Drop for Waiter {
  fn drop(self : &mut Waiter) -> void {
    within(Duration::from_millis(200), || -> void {
      match self.rx.recv() {
        Result<i64, RecvError>::Ok(v) => {
          println!("the drop got {}", v);
        }
        Result<i64, RecvError>::Err(_e) => {
          println!("the drop gave up, cancelled {}", cancelled());
        }
      }
    });
  }
}

fn main() -> i32 {
  let (tx, rx) = channel<i64>(1);

  let start = Instant::now();
  within(Duration::from_millis(500), || -> void {
    let first = gave_up(&rx);
    let second = gave_up(&rx);
    println!("two waits gave up: {} {}", first, second);
  });
  println!("they took less than 1 second together: {}", start.elapsed() < Duration::from_secs(1));
  println!("after the call, cancelled {}", cancelled());

  let nested_start = Instant::now();
  within(Duration::from_secs(30), || -> void {
    within(Duration::from_millis(200), || -> void {
      println!("the inner call gave up: {}", gave_up(&rx));
    });
  });
  within(Duration::from_millis(200), || -> void {
    within(Duration::from_secs(30), || -> void {
      println!("the outer call gave up: {}", gave_up(&rx));
    });
  });
  println!("nested calls took less than 5 seconds: {}", nested_start.elapsed() < Duration::from_secs(5));

  // Past the 0.1 seconds of the calls, a deadline that did not end would still count.
  let got = within(Duration::from_millis(100), || -> i64 {
    if gave_up(&rx) {
      2
    } else {
      1
    }
  });
  sleep(Duration::from_millis(200));
  println!("the body gave {}, and after it, cancelled {}", got, cancelled());
  let mut calls = 0i64;
  while calls < 3i64 {
    calls = calls + within(Duration::from_millis(50), || -> i64 {
      let _gave_up = gave_up(&rx);
      1i64
    });
  }
  sleep(Duration::from_millis(100));
  println!("{} calls in a loop, and after them, cancelled {}", calls, cancelled());

  let early = within(Duration::from_millis(100), || -> i64 {
    if gave_up(&rx) {
      return 7;
    }
    return 1;
  });
  sleep(Duration::from_millis(200));
  println!("the body returned {} early, and after it, cancelled {}", early, cancelled());

  let received = within(Duration::from_millis(100), || -> Result<i64, RecvError> {
    let v = rx.recv()?;
    return Result<i64, RecvError>::Ok(v);
  });
  sleep(Duration::from_millis(200));
  let mut gave_back_an_error = false;
  match received {
    Result<i64, RecvError>::Ok(_v) => {}
    Result<i64, RecvError>::Err(_e) => {
      gave_back_an_error = true;
    }
  }
  println!("the body gave back an error with ?: {}, and after it, cancelled {}", gave_back_an_error, cancelled());

  let (tx2, rx2) = channel<i64>(1);
  let w = Waiter {
    rx: rx2
  };
  let drop_start = Instant::now();
  drop(w);
  println!("the drop took less than 5 seconds: {}", drop_start.elapsed() < Duration::from_secs(5));
  drop(tx2);
  drop(tx);
  return 0;
}
