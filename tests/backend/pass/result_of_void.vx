//===----------------------------------------------------------------------===//
// `Result<void, i32>` is the result of an operation that can fail but has
// nothing to return. `check` builds both variants with the type written out.
//
// EXPECT: ok err

import core::option;
import core::result;

fn nothing() -> void {
}

fn check(x : i32) -> Result<void, i32> {
  if x > 0 {
    return Result<void, i32>::Ok(nothing());
  }
  return Result<void, i32>::Err(x);
}

fn main() -> i32 {
  if check(1).is_ok() {
    print("ok ");
  }
  if check(-1).is_err() {
    print("err");
  }
  return 0;
}
