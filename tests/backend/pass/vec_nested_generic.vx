// Regression for #207: a generic struct used as a generic element type
// (`Vec<Vec<i32>>`) must lower to the concrete monomorphized struct, not an
// opaque `!llvm.struct<"Vec<i32>">`. Also exercises #208: a value returned from
// a generic method (`outer.get(0)` : `Vec<i32>`) supports further method calls.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --action run-jit
import std::vec;
import std::io;

fn main() -> i32 {
  let mut outer = Vec<Vec<i32>>::new();

  let mut a = Vec<i32>::new();
  a.push(11);
  a.push(22);
  outer.push(a);

  let mut b = Vec<i32>::new();
  b.push(33);
  b.push(44);
  b.push(55);
  outer.push(b);

  let row0 = outer.get(0);
  let row1 = outer.get(1);
  print!(row0.get(1));   // 22
  print!("
");
  print!(row1.get(2));   // 55
  print!("
");
  print!(row1.len());    // 3
  print!("
");
  return 0;
}

// EXPECT: 22
// EXPECT: 55
// EXPECT: 3

// A `Vec<Vec<i32>>` monomorphizes at both levels: the outer vector's element is the inner
// vector's instantiation, not a second copy of `Vec<i32>`.
// MLIR: call @"Vec::new$Vec$i32"
// MLIR: call @"Vec::new$i32"
// MLIR: call @Vec$i32$push$i32
// MLIR: call @Vec$Vec$i32$push$Vec$i32
// MLIR: call @Vec$Vec$i32$get$Vec$i32
// MLIR: call @Vec$i32$get$i32
