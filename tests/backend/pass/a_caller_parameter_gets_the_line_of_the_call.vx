//===----------------------------------------------------------------------===//
// A function whose last parameter has the type `Caller` gets the file and line of each call that
// leaves the argument out. A function that gives its own `Caller` to a call reports the line of
// its caller.
//
// RUN: vxc --package tests=tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests %s -j 4 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
import core::panic;
import tests::modules::caller_lines;

struct Counter<T> {
  n : T,
}

impl<T>
Counter<T> {
  fn make(n : T, at : Caller) -> Counter<T> {
    here(4, at);
    return Counter<T> {
      n : n
    };
  }

  fn get(self : &Counter<T>, at : Caller) -> &T {
    here(5, at);
    return &self.n;
  }
}

// A wrapper gives its own `Caller` to the call.
fn wrapper(at : Caller) -> void {
  here(2, at);
}

fn first<T>(x : T, at : Caller) -> T {
  here(3, at);
  return x;
}

// CHECK:      {{^}}1 at {{.*}}a_caller_parameter_gets_the_line_of_the_call.vx:[[@LINE+7]]{{$}}
// CHECK-NEXT: {{^}}2 at {{.*}}a_caller_parameter_gets_the_line_of_the_call.vx:[[@LINE+7]]{{$}}
// CHECK-NEXT: {{^}}3 at {{.*}}a_caller_parameter_gets_the_line_of_the_call.vx:[[@LINE+7]]{{$}}
// CHECK-NEXT: {{^}}4 at {{.*}}a_caller_parameter_gets_the_line_of_the_call.vx:[[@LINE+7]]{{$}}
// CHECK-NEXT: {{^}}5 at {{.*}}a_caller_parameter_gets_the_line_of_the_call.vx:[[@LINE+7]]{{$}}
// CHECK-NEXT: {{^}}6 at {{.*}}caller_lines.vx:18{{$}}
fn main() -> i32 {
  here(1);
  wrapper();
  let x = first<i64>(7);
  let c = Counter<i64>::make(x);
  let n = *c.get();
  from_the_module();
  return (n - 7) as i32;
}
