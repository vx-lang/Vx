//===----------------------------------------------------------------------===//
// With `VX_DROPS=scope`, a tensor is freed where its owner drops it. A function owns the
// tensors it takes by value and frees them; its caller does not.
//
// EXPECT: 2 2 2 8 2 1
// RUN: env VX_DROPS=scope vxc %s 2>&1 | FileCheck %s --check-prefix=OUT
// OUT: 2 2 2 8 2 1
//
// RUN: env VX_DROPS=scope vxc %s --action emit-llvm 2>&1 | FileCheck %s
// `main` frees `a` and the tensor `ones(5)` makes, which nothing names. `b` and `f` are freed
// by the functions they are given to. `f` comes back from `four` in a buffer `main` allocates,
// on the heap because `sum_of_four` frees it.
// CHECK-LABEL: llvm.func @main(
// CHECK: llvm.call @first_two
// CHECK: llvm.call @first_two
// CHECK-NOT: llvm.call @malloc
// CHECK: llvm.call @free
// CHECK: %[[F:.*]] = llvm.call @malloc
// CHECK: llvm.call @four(%[[F]],
// CHECK: llvm.call @sum_of_four(%[[F]],
// CHECK: llvm.call @free
// CHECK-NOT: llvm.call @free
// CHECK-LABEL: llvm.func @total(
// CHECK: llvm.call @free(%arg0)
// CHECK-LABEL: llvm.func @sum_of_four(
// CHECK: llvm.call @free(%arg0)
// `ones` returns its tensor, so it frees nothing.
// CHECK-LABEL: llvm.func @ones(
// CHECK-NOT: llvm.call @free
// `t` is freed only when it was not given to `total`: after a branch on `give`, a second
// branch on the flag that records the move.
// CHECK-LABEL: llvm.func @maybe_moved(
// CHECK: llvm.cond_br %arg1
// CHECK: llvm.cond_br
// CHECK: llvm.call @free
// `first_two` only borrows.
// CHECK-LABEL: llvm.func @first_two(
// CHECK-NOT: llvm.call @free

fn total(v : Tensor<f32, [?]>) -> f32 {
  return v[0] + v[1];
}

fn first_two(v : &Tensor<f32, [?]>) -> f32 {
  return v[0] + v[1];
}

fn ones(n : i32) -> Tensor<f32, [?]> {
  let mut t = Tensor<f32>([n]);
  for i in 0..n {
    t[i] = 1.0;
  }
  return t;
}

fn four() -> Tensor<f32, [2048]> {
  let t = Tensor<f32, [2048]>::fill(4.0);
  return t;
}

fn sum_of_four(t : Tensor<f32, [2048]>) -> f32 {
  return t[0] + t[2047];
}

fn maybe_moved(n : i32, give : bool) -> f32 {
  let t = ones(n);
  let mut s = 0.0;
  if give {
    s = total(t);
  }
  return s;
}

fn main() -> i32 {
  let a = ones(3);
  let b = ones(3);
  print(first_two(&a));
  print!(" ");
  print(total(b));
  print!(" ");
  print(first_two(&ones(5)));
  print!(" ");
  let f = four();
  print(sum_of_four(f));
  print!(" ");
  print(maybe_moved(4, true) + maybe_moved(4, false));
  print!(" ");
  print(a[2]);
  return 0;
}
