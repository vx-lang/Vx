//===----------------------------------------------------------------------===//
// A tensor with no dimensions, `Tensor<f32, []>`, holds one element. Its clone holds the same
// value.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
// CHECK: the clone holds 1.5

fn main() -> i32 {
  let t : Tensor<f32, []> = 1.5;
  let c = t.clone();
  if c == 1.5 {
    print!("the clone holds 1.5");
  } else {
    print!("the clone holds another value");
  }
  return 0;
}
