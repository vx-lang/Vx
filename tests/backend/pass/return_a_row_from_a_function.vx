//===----------------------------------------------------------------------===//
// A function that returns a row of a tensor it borrows. `second_row` returns a copy of the row
// with a written shape, so a change to the copy leaves `q` alone. `any_row` returns the row
// itself as a reference, with a `?` shape.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s

fn second_row(q : &Tensor<f32, [2, 4]>) -> Tensor<f32, [4]> {
  return q[1].clone();
}

fn any_row(q : &Tensor<f32, [?, ?]>, i : i32) -> &Tensor<f32, [?]> {
  return &q[i];
}

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  q[1][0] = 5.0;
  q[1][3] = 9.0;

  let r = second_row(&q);
  print!("written shape: ");
  print(r[0]);
  print!(" ");
  print(r[3]);
  print!("
");
  // CHECK: {{^}}written shape: 5 9{{$}}

  let d = any_row(&q, 1);
  print!("any shape: ");
  print(d[0]);
  print!(" ");
  print(d[3]);
  print!("
");
  // CHECK-NEXT: {{^}}any shape: 5 9{{$}}

  // Changing the returned row leaves `q` alone.
  let mut c = second_row(&q);
  c[0] = 1.0;
  print!("q unchanged: ");
  print(q[1][0]);
  print!("
");
  // CHECK-NEXT: {{^}}q unchanged: 5{{$}}
  return 0;
}
