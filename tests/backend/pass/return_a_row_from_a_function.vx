//===----------------------------------------------------------------------===//
// A function that returns a row of a tensor it borrows, with a written shape and with `?`.
// The AST path (`--legacy-codegen`) could not compile it: it tried to cast the row, a view
// with the tensor's layout, to a plain tensor. Now the row is copied, so the function returns
// a tensor of its own.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s

fn second_row(q : &Tensor<f32, [2, 4]>) -> Tensor<f32, [4]> {
  return q[1];
}

fn any_row(q : &Tensor<f32, [?, ?]>, i : i32) -> Tensor<f32, [?]> {
  return q[i];
}

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  q[1][0] = 5.0;
  q[1][3] = 9.0;

  let r = second_row(&q);
  print!("written shape: ");
  print(r[0]);
  print!(" ");
  print(r[3]);
  print!("
");
  // CHECK: {{^}}written shape: 5 9{{$}}

  let d = any_row(&q, 1);
  print!("any shape: ");
  print(d[0]);
  print!(" ");
  print(d[3]);
  print!("
");
  // CHECK-NEXT: {{^}}any shape: 5 9{{$}}

  // Changing the returned row leaves `q` alone.
  let mut c = second_row(&q);
  c[0] = 1.0;
  print!("q unchanged: ");
  print(q[1][0]);
  print!("
");
  // CHECK-NEXT: {{^}}q unchanged: 5{{$}}
  return 0;
}
