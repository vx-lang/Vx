// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_hash_set_new_i32(
// CHECK-DAG: func.func private @vx_hash_set_insert_i32(
// CHECK-DAG: func.func private @vx_hash_set_len_i32(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-DAG: func.func private @vx_hash_set_contains_i32(
// CHECK-DAG: func.func private @vx_hash_set_drop_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_hash_set_new_i32() : () -> !llvm.ptr
// CHECK: call @vx_hash_set_insert_i32(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: call @vx_hash_set_insert_i32(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> i32
// CHECK: %[[V1:.*]] = call @vx_hash_set_len_i32(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%[[V1]]) : (i32) -> i32
// CHECK: call @vx_hash_set_contains_i32(%[[V0]], %{{.*}}) : (!llvm.ptr, i32) -> i1
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
extern "C" {
  fn vx_hash_set_new_i32() -> *mut i8;
  fn vx_hash_set_insert_i32(set : *mut i8, val : i32) -> i32;
  fn vx_hash_set_contains_i32(set : *mut i8, val : i32) -> Bool;
  fn vx_hash_set_len_i32(set : *mut i8) -> i32;
  fn vx_hash_set_drop_i32(set : *mut i8) -> i32;
}
import std::io;

fn main() -> i32 {
  unsafe {
    let set = vx_hash_set_new_i32();
    vx_hash_set_insert_i32(set, 42);
    vx_hash_set_insert_i32(set, 42);

    let len = vx_hash_set_len_i32(set);
    print!("Len: ");
    print!(len);

    let has_42 = vx_hash_set_contains_i32(set, 42);
    if has_42 {
      print!("Has 42: ");
      print!(1);
    }

    vx_hash_set_drop_i32(set);
  }
  return 0;
}

// EXPECT: Len: 1
// EXPECT: Has 42: 1
