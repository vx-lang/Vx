//===----------------------------------------------------------------------===//
// `c = &v @ &a`, where `v` is a view of `c`'s own memory and `a` is the identity, gives back
// `c`. Writing the product straight into `c` would clear `c` before `v` is read, and print
// zeros.
//
// EXPECT: 1 2 3 4

fn main() -> i32 {
  let mut a = Tensor<f32>([2, 2]);
  a[0][0] = 1.0;
  a[1][1] = 1.0;
  a[0][1] = 0.0;
  a[1][0] = 0.0;
  let mut c = Tensor<f32>([2, 2]);
  c[0][0] = 1.0;
  c[0][1] = 2.0;
  c[1][0] = 3.0;
  c[1][1] = 4.0;
  let pc = c.as_mut_ptr();
  let v : Tensor<f32, [2, 2]> = unsafe { tensor_view_2d(pc, 2, 2) };
  c = &v @ &a;
  print(c[0][0]);
  print(" ");
  print(c[0][1]);
  print(" ");
  print(c[1][0]);
  print(" ");
  print(c[1][1]);
  return 0;
}
