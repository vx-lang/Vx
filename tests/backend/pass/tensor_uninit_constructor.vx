//===----------------------------------------------------------------------===//
// A tensor is built from its type: `Tensor<f32, [2, 2]>::uninit()` (Vx#429).
//
// The older `Tensor<f32>([2, 2])` names a constructor and splits the element and the shape
// between the generic argument and the call arguments, which leaves three places in the compiler
// rebuilding the type from the call. It also has nowhere to put a placement -- `Memory::GPU_HBM`
// is part of a tensor's type, and that spelling has no slot for one.
//
// The two constructors differ only in whether the storage arrives zeroed. Zeroing is a full pass
// over the buffer, which for a weight matrix about to be overwritten is a cost with nothing to
// show for it, so which one a program wants is a real choice and is written down.
//
// `zeroed` reads what `::new()` left, but the value it prints is weak evidence on its own --
// fresh pages read as zero often enough that an unfilled buffer would pass. The CHECK line below
// is the real one: exactly the `linalg.fill` count the three `::new()`-free functions here do not
// produce.
//
// Both spellings are here because the answer must not depend on which was written: `by_type` and
// `by_call` build the same tensor and the sum below is over both.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func @by_type
// CHECK-DAG: func.func @by_call
// CHECK-COUNT-1: linalg.fill
// CHECK-NOT: linalg.fill
//
// The two paths emit the fill separately, so the AST one is pinned too -- otherwise removing it
// there would leave this file green while `::new()` handed back whatever was in the buffer.
// RUN: vxc %s --action emit-mlir --legacy-codegen 2>&1 | FileCheck %s --check-prefix=AST
// AST-COUNT-1: linalg.fill
// AST-NOT: linalg.fill
// EXPECT: 10 10 3 0

// The shape is in the type, so the constructor takes nothing.
fn by_type() -> f32 {
  let mut t = Tensor<f32, [2, 2]>::uninit();
  for i in 0..2 {
    for j in 0..2 {
      t[i][j] = (i * 2 + j + 1) as f32;
    }
  }
  return t[0][0] + t[0][1] + t[1][0] + t[1][1];
}

// The same tensor, written the older way. The corpus migration rewrote this body once, which
// left the file comparing one spelling with itself; it goes back to the old spelling until that
// spelling is gone.
fn by_call() -> f32 {
  let mut t = Tensor<f32>([ 2, 2 ]);
  for i in 0..2 {
    for j in 0..2 {
      t[i][j] = (i * 2 + j + 1) as f32;
    }
  }
  return t[0][0] + t[0][1] + t[1][0] + t[1][1];
}

// A rank-1 tensor, because the shape travels as one array argument and a single extent is the
// case a normalisation that forgets the wrapper gets wrong -- it reads as rank 0.
fn rank_one() -> f32 {
  let mut v = Tensor<f32, [3]>::uninit();
  v[0] = 1.0;
  v[1] = 1.0;
  v[2] = 1.0;
  return v[0] + v[1] + v[2];
}

// `::new()` zeroes; nothing here writes to it, so every element is the one the fill wrote.
fn zeroed() -> f32 {
  let z = Tensor<f32, [2, 2]>::new();
  return z[0][0] + z[0][1] + z[1][0] + z[1][1];
}

fn main() -> i32 {
  print(by_type());
  print!(" ");
  print(by_call());
  print!(" ");
  print(rank_one());
  print!(" ");
  print(zeroed());
  return 0;
}
