//===----------------------------------------------------------------------===//
// A function that returns a tensor of fixed shape writes it into a buffer that its caller makes.
// The 16 MB result of `make` is larger than the stack, so the caller makes the buffer on the
// heap, as for a large local tensor. A buffer on the stack overflowed it. The drop of each result
// frees its buffer, so the loop makes one buffer on each pass. The 16-byte result of `small`
// still goes on the stack.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --check-prefix=OUT --implicit-check-not=Error
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s
// OUT: {{^}}1 3 2{{$}}
// CHECK-LABEL: func.func @main(
// CHECK-DAG: memref.alloca() {{.*}}: memref<4xf32>
// CHECK-DAG: memref.alloc() {{.*}}: memref<2048x2048xf32>
// CHECK-NOT: memref.alloca() {{.*}}: memref<2048x2048xf32>

fn make() -> Tensor<f32, [2048, 2048]> {
  let m = Tensor<f32, [2048, 2048]>::fill(1.0);
  return m;
}

fn small() -> Tensor<f32, [4]> {
  let s = Tensor<f32, [4]>::fill(3.0);
  return s;
}

fn main() -> i32 {
  let m = make();
  let s = small();
  let mut total = 0.0;
  for i in 0..2 {
    let n = make();
    total = total + n[2047][2047];
  }
  println!("{} {} {}", m[2047][2047] as i32, s[3] as i32, total as i32);
  return 0;
}
