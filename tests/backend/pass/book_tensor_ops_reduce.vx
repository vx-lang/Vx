// A program of the book chapter on tensor operations (www/book/src/tensor-ops.md):
// `t.reduce(init, |acc, x| ..)` with a sum, a largest value, a captured variable and a product.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}total 18 most 7.5 sale 9{{$}}
// CHECK: {{^}}product 720{{$}}

// ANCHOR: program
fn main() -> i32 {
  let prices : Tensor<f64, [4]> = [ 3.0, 7.5, 2.0, 5.5 ];
  let total = prices.reduce(0.0, | acc, x | acc + x);
  let most = prices.reduce(0.0, | acc, x | if x > acc {
    x
  } else {
    acc
  });
  let discount : f64 = 0.5;
  let sale = prices.reduce(0.0, | acc, x | acc + x * discount);
  println!("total {} most {} sale {}", total, most, sale);

  let counts : Tensor<i32, [2, 3]> = [ [ 1, 2, 3 ], [ 4, 5, 6 ] ];
  println!("product {}", counts.reduce(1, | acc, x | acc * x));
  return 0;
}
// ANCHOR_END: program
