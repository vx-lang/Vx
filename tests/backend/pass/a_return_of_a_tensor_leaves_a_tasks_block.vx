//===----------------------------------------------------------------------===//
// A `return` of a tensor can leave the `tasks` block of `fixed` and of `sized`. In each block,
// the first task waits until the second task sets a flag, so the two tasks must run at the same
// time, or the program hangs. `fixed` returns a tensor of a fixed shape, which the caller gives
// it room for. `sized` returns a tensor whose length is known only when it runs.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}fixed 1 1 3 3{{$}}
// CHECK: {{^}}sized 1 2 3 4, lengths 3 and 4{{$}}

import core::sync::atomic;
import std::sync::wait;

fn wait_for(flag : &AtomicI64) -> void {
  let mut seen = flag.load(AtomicOrdering::Acquire);
  while seen == 0 {
    wait_while(flag, seen);
    seen = flag.load(AtomicOrdering::Acquire);
  }
}

fn set(flag : &AtomicI64) -> void {
  flag.store(1, AtomicOrdering::Release);
  wake_all(flag);
}

fn fixed(early : bool) -> Tensor<i64, [2]> {
  let flag = AtomicI64::new(0);
  tasks {
    spawn {
      wait_for(&flag);
    };
    spawn {
      set(&flag);
    };
    if early {
      return Tensor<i64, [2]>::fill(1);
    }
  };
  return Tensor<i64, [2]>::fill(3);
}

fn sized(early : bool, n : i32) -> Tensor<i64, [?]> {
  let flag = AtomicI64::new(0);
  tasks {
    spawn {
      wait_for(&flag);
    };
    spawn {
      set(&flag);
    };
    if early {
      let mut t = Tensor<i64>([n]);
      t[0] = 1;
      t[n - 1] = 2;
      return t;
    }
  };
  let mut u = Tensor<i64>([n + 1]);
  u[0] = 3;
  u[n] = 4;
  return u;
}

fn main() -> i32 {
  let a = fixed(true);
  let b = fixed(false);
  println!("fixed {} {} {} {}", a[0], a[1], b[0], b[1]);
  let p = sized(true, 3);
  let q = sized(false, 3);
  println!("sized {} {} {} {}, lengths {} and {}", p[0], p[2], q[0], q[3], p.len(), q.len());
  return 0;
}
