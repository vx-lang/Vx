//===- npu_vector_add.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" 2>&1 | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --check-prefix=LLVM
// REQUIRES: macos
// FileCheck %s

fn test_f32() -> i32 {
  let mut a = Tensor<f32>([4]);
  let mut b = Tensor<f32>([4]);
  let mut c = Tensor<f32>([4]).with_memory(Memory::NPU_HBM);
  let sum = 3.0;

  for i in 0..4 {
    a[i] = 1.0;
    b[i] = 2.0;
  }

  let a_npu = transfer(a, Memory::NPU_HBM);
  let b_npu = transfer(b, Memory::NPU_HBM);

  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      c[i] = a_npu[i] + b_npu[i];
    }
  }

  let c_host = transfer(c, Memory::CPU_DRAM);
  assert(c_host[0] == sum, "f32 index 0 match");
  assert(c_host[1] == sum, "f32 index 1 match");
  assert(c_host[2] == sum, "f32 index 2 match");
  assert(c_host[3] == sum, "f32 index 3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = Tensor<bf16>([4]);
  let mut b = Tensor<bf16>([4]);
  let mut c = Tensor<bf16>([4]).with_memory(Memory::NPU_HBM);
  let sum : bf16 = 3.0;

  for i in 0..4 {
    a[i] = 1.0;
    b[i] = 2.0;
  }

  let a_npu = transfer(a, Memory::NPU_HBM);
  let b_npu = transfer(b, Memory::NPU_HBM);

  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      c[i] = a_npu[i] + b_npu[i];
    }
  }

  let c_host = transfer(c, Memory::CPU_DRAM);
  assert(c_host[0] == sum, "bf16 index 0 match");
  assert(c_host[1] == sum, "bf16 index 1 match");
  assert(c_host[2] == sum, "bf16 index 2 match");
  assert(c_host[3] == sum, "bf16 index 3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

// NO_EXEC

// Before the pass the extents are still i32 values that have to be cast to index; the buffer
// is allocated from those casts.
// CHECK-LABEL: func.func @test_f32() -> i32
// CHECK: %[[N:.*]] = arith.index_cast %{{.*}} : i32 to index
// CHECK: memref.alloc(%[[N:.*]]) : memref<?xf32>

// convert-vx-to-standard folds them, so the same allocation reads from index constants.
// STD-LABEL: func.func @test_f32() -> i32
// STD: %[[C:.*]] = arith.constant {{[0-9]+}} : index
// STD: memref.alloc(%[[C:.*]]) : memref<?xf32>

// --emit-llvm stops at the LLVM dialect, where the same function is an llvm.func and the
// buffers are raw allocations rather than memrefs.
// LLVM-LABEL: llvm.func @test_f32() -> i32
// LLVM: llvm.call @malloc
// LLVM: llvm.func @main() -> i32 attributes {llvm.emit_c_interface}
