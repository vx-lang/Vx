// LLVM:   %16 = insertvalue { ptr, ptr, i64, [1 x i64], [1 x i64] } %15, i64 4, 3, 0
// LLVM:   %17 = insertvalue { ptr, ptr, i64, [1 x i64], [1 x i64] } %16, i64 1, 4, 0
