//===----------------------------------------------------------------------===//
// `HashMap<K, V>` with three kinds of key: `i64`, `String`, and a struct that borrows its bytes
// from a `Vec<u8>` and hashes and compares them.
//
// - ints: 1000 keys, so the table of 8 slots grows 8 times. `insert` on a key that is there
//   gives the old value, 14, and 7 then holds 2010. `get_or_insert` counts each of 0 to 9 99 more
//   times, so 3 holds 6 + 99. `remove` takes 100 to 109 out. A removed slot stays on the search
//   path of the keys after it, so each of the 990 keys left is still found. The sum of the values that are left is
//   999000 + 1996 + 990 - 2090.
// - strings: a `String` key is found through a different `String` with the same bytes.
// - bytes: the 3-byte pieces of "abcabcab", counted, as k-nucleotide counts them.
// - drops: each `Noisy` prints its number when it drops. `insert` gives back 1, and `remove`
//   gives back 2. The map drops 3 when it goes out of scope. So each value drops once.
//
// EXPECT: ints 1000 14 14 2010 105 990 990 true false 999896 990 | strings 2 7 none | bytes 3 abc 2 bca 2 cab 2 | drops 1 2 3 end

import core::hash;
import core::hash::traits;
import core::option;
import std::hash_map;
import std::string;
import std::vec;

struct Noisy {
  id : i32,
}

impl Drop for Noisy {
  fn drop(self : &mut Noisy) -> void {
    print(self.id);
    print!(" ");
  }
}

/// `k` bytes of `seq`, from `at`. Two pieces are equal when their bytes are.
struct Piece {
  seq : &Vec<u8>,
  at : i32,
  k : i32,
}

impl PartialEq for Piece {
  fn eq(self : &Piece, other : &Piece) -> bool {
    if self.k != other.k {
      return false;
    }
    for i in 0..self.k {
      if self.seq[self.at + i] != other.seq[other.at + i] {
        return false;
      }
    }
    return true;
  }
}

impl Eq for Piece {}

impl Hash for Piece {
  fn hash<H : Hasher>(self : &Piece, state : &mut H) -> i32 {
    for i in 0..self.k {
      let _b = state.write_u8(self.seq[self.at + i]);
    }
    return 0;
  }
}

fn value_of(m : &HashMap<i64, i64>, k : i64) -> i64 {
  match m.get(&k) {
    Option<&i64>::Some(v) => {
      return *v;
    },
    Option<&i64>::None() => {
      return -1i64;
    }
  }
}

fn ints() -> void {
  let mut m = HashMap<i64, i64>::new();
  for i in 0i64..1000i64 {
    let _none = m.insert(i, i * 2i64);
  }
  print!("ints ");
  print(m.len());
  print!(" ");
  print(value_of(&m, 7i64));
  print!(" ");
  match m.insert(7i64, 2010i64) {
    Option<i64>::Some(old) => {
      print(old);
    },
    Option<i64>::None() => {
      print!("none");
    }
  }
  print!(" ");
  print(value_of(&m, 7i64));
  print!(" ");
  for i in 0i64..990i64 {
    let c = m.get_or_insert(i % 10i64, 0i64);
    *c = *c + 1i64;
  }
  print(value_of(&m, 3i64));
  print!(" ");
  for i in 100i64..110i64 {
    let key : i64 = i;
    let _gone = m.remove(&key);
  }
  print(m.len());
  print!(" ");
  let mut found = 0;
  for i in 0i64..1000i64 {
    let key : i64 = i;
    if m.contains_key(&key) {
      found += 1;
    }
  }
  print(found);
  print!(" ");
  print(m.contains_key(&999i64));
  print!(" ");
  print(m.contains_key(&105i64));
  print!(" ");
  let mut sum : i64 = 0;
  for v in m.values() {
    sum += *v;
  }
  let mut keys = 0;
  for _k in m.keys() {
    keys += 1;
  }
  print(sum);
  print!(" ");
  print(keys);
  print!(" | ");
}

fn strings() -> void {
  let a = String::from_bytes("apple" as *const u8, 5).unwrap();
  let b = String::from_bytes("pear" as *const u8, 4).unwrap();
  let mut m = HashMap<String, i32>::new();
  let _a = m.insert(a, 5);
  let _b = m.insert(b, 7);
  print!("strings ");
  print(m.len());
  print!(" ");
  let pear = String::from_bytes("pear" as *const u8, 4).unwrap();
  match m.get(&pear) {
    Option<&i32>::Some(v) => {
      print(*v);
    },
    Option<&i32>::None() => {
      print!("none");
    }
  }
  print!(" ");
  let plum = String::from_bytes("plum" as *const u8, 4).unwrap();
  match m.get(&plum) {
    Option<&i32>::Some(v) => {
      print(*v);
    },
    Option<&i32>::None() => {
      print!("none");
    }
  }
  print!(" | ");
}

fn bytes() -> void {
  let text = String::from_bytes("abcabcab" as *const u8, 8).unwrap();
  let seq = text.to_bytes();
  let mut counts = HashMap<Piece, i32>::new();
  for i in 0..6 {
    let c = counts.get_or_insert(Piece {
      seq : &seq, at : i, k : 3
    }, 0);
    *c = *c + 1;
  }
  print!("bytes ");
  print(counts.len());
  for at in 0..3 {
    print!(" ");
    let name = text.byte_range(at, at + 3).unwrap();
    print!("{} ", name);
    match counts.get(&Piece {
      seq : &seq, at : at, k : 3
    }) {
      Option<&i32>::Some(c) => {
        print(*c);
      },
      Option<&i32>::None() => {
        print!("none");
      }
    }
  }
  print!(" | ");
}

fn drops() -> void {
  print!("drops ");
  let mut m = HashMap<i32, Noisy>::new();
  let _none = m.insert(1, Noisy {
    id : 1
  });
  let _none2 = m.insert(2, Noisy {
    id : 2
  });
  match m.insert(1, Noisy {
    id : 3
  }) {
    Option<Noisy>::Some(old) => {
      drop(old);
    },
    Option<Noisy>::None() => {}
  }
  match m.remove(&2) {
    Option<Noisy>::Some(v) => {
      drop(v);
    },
    Option<Noisy>::None() => {}
  }
}

fn main() -> i32 {
  ints();
  strings();
  bytes();
  drops();
  println!("end");
  return 0;
}
