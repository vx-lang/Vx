//===----------------------------------------------------------------------===//
// f64 `tan`, ported from LLVM libc's `tan` into `core::libm`, against LLVM libc itself
// (f475f085bf7b, built with FMA). It prints the bits of `x.tan()` (a NaN as 9221120237041090560)
// for four inputs that need the 128-bit pass in each of three ranges: below 2^-7 in size, below
// 2^16, where the reduction by pi/128 uses three parts of pi, and from 2^16 up, where it uses a
// table of 128/pi (all found by searching random doubles); then for special values and the edges of
// the ranges; then hashes of 2^20 random bit patterns and of 2^20 random x from 2^-63 to 2^36 in
// size. The port also matched LLVM libc on 2^30 inputs of the second kind, on 2^28 of the first,
// and on 2^27 and 2^26 more of each with the fast pass turned off.
//
// EXPECT: 4574884347192030377 13796644842064608444 4572664823094659282 4572903486150683448 4605826482816435919 4597651563082018557 13824831026180655496 13846409674482979357 13802837983818286758 4621365706614125866 13852284245006222816 13858273551110353649 0 9223372036854775808 4609692760021066662 13833064796875842470 4336966441157787648 13560338478012563456 1 13795742873816306820 9221120237041090560 9221120237041090560 9221120237041090560 9221120237041090560 13592327833376807943 4849535219099880885 13830182988376260471 13830182988376134693 4490088828488384512 4490088828488384512 4589173893529657088 4589173893529657089 13821350146292727154 12282178387014471944 2377462144944483561
import core::num;

fn bits(r : f64) -> u64 {
  if r != r {
    return 9221120237041090560u64;
  }
  return r.to_bits();
}

fn check(x : u64) -> i32 {
  print(bits(f64::from_bits(x).tan()));
  print!(" ");
  return 0;
}

/// x from 2^-63 to 2^(count - 64) in size, either sign.
fn ranged(s : u64, count : u64) -> u64 {
  return (s & 9227875636482146303u64) | ((960u64 + ((s >> 52u64) & 2047u64) % count) << 52u64);
}

fn hash(kind : i32, count : i32) -> u64 {
  let mut s : u64 = 88172645463325252u64;
  let mut h : u64 = 0u64;
  for i in 0..count {
    s = s ^ (s << 13u64);
    s = s ^ (s >> 7u64);
    s = s ^ (s << 17u64);
    let mut r : f64 = 0.0;
    if kind == 0 {
      r = f64::from_bits(s).tan();
    } else {
      r = f64::from_bits(ranged(s, 100u64)).tan();
    }
    h = (h ^ bits(r)).wrapping_mul(1099511628211u64);
  }
  return h;
}

fn main() -> i32 {
  let _r0 = check(4574884207184952215u64);
  let _r1 = check(13796644769220865295u64);
  let _r2 = check(4572664768526921383u64);
  let _r3 = check(4572903424826247682u64);
  let _r4 = check(13836043018795147750u64);
  let _r5 = check(4655149308896380220u64);
  let _r6 = check(13880014345230383836u64);
  let _r7 = check(13855410478443089614u64);
  let _r8 = check(17053433895604317189u64);
  let _r9 = check(5940053165666387985u64);
  let _r10 = check(16419152986291981526u64);
  let _r11 = check(5689769908541951933u64);
  let _r12 = check(0u64);
  let _r13 = check(9223372036854775808u64);
  let _r14 = check(4607182418800017408u64);
  let _r15 = check(13830554455654793216u64);
  let _r16 = check(4336966441157787648u64);
  let _r17 = check(13560338478012563456u64);
  let _r18 = check(1u64);
  let _r19 = check(9218868437227405311u64);
  let _r20 = check(9218868437227405312u64);
  let _r21 = check(18442240474082181120u64);
  let _r22 = check(9221120237041090560u64);
  let _r23 = check(18444492273895866368u64);
  let _r24 = check(4614256656552045848u64);
  let _r25 = check(4609753056924675352u64);
  let _r26 = check(4679240012837945343u64);
  let _r27 = check(4679240012837945344u64);
  let _r28 = check(4490088828488384511u64);
  let _r29 = check(4490088828488384512u64);
  let _r30 = check(4589168020290535423u64);
  let _r31 = check(4589168020290535424u64);
  let _r32 = check(9113033845984198656u64);
  print(hash(0, 1048576));
  print!(" ");
  print(hash(1, 1048576));
  return 0;
}
