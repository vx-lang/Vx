//===----------------------------------------------------------------------===//
// `*mut T as *const T` and back keep the address: what is written through one is read
// through the other.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
import std::string;
import std::alloc;

fn main() -> i32 {
  let buf : *mut i8 = alloc(4, 16);
  unsafe { buf[0i64] = 104i8; buf[1i64] = 105i8; buf[2i64] = 0i8; }
  let mut s = unsafe { String::from_c_str(buf as *const i8) };
  print!("from_mut=");
  print!(s.as_c_str());
  print!("; ");

  let lit : *const i8 = "xyz";
  let back : *mut i8 = lit as *mut i8;
  print!("second_byte=");
  unsafe { print(back[1i64] as i64); }
  print!(";");
  // CHECK: {{^}}from_mut=hi; second_byte=121;{{$}}
  dealloc(buf, 16);
  return 0;
}
