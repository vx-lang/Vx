// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_option_new_some_i32(
// CHECK-DAG: func.func private @vx_option_is_some_i32(
// CHECK-DAG: func.func private @vx_option_unwrap_i32(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-DAG: func.func private @vx_option_drop_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_option_new_some_i32(%{{.*}}) : (i32) -> !llvm.ptr
// CHECK: call @vx_option_is_some_i32(%[[V0]]) : (!llvm.ptr) -> i1
// CHECK: %[[V1:.*]] = call @vx_option_unwrap_i32(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%[[V1]]) : (i32) -> i32
// CHECK: call @vx_option_drop_i32(%[[V0]]) : (!llvm.ptr) -> i32
extern "C" {
  fn vx_option_new_some_i32(val : i32)->*mut i8;
  fn vx_option_new_none_i32() -> *mut i8;
  fn vx_option_is_some_i32(ptr : *mut i8) -> Bool;
  fn vx_option_unwrap_i32(ptr : *mut i8) -> i32;
  fn vx_option_drop_i32(ptr : *mut i8) -> i32;
}
import std::io;
fn main() -> i32 {
  unsafe {
    let opt1 = vx_option_new_some_i32(42);
    if vx_option_is_some_i32 (opt1) {
      let val = vx_option_unwrap_i32(opt1);
      print!("Some: ");
      print!(val);
    }
    vx_option_drop_i32(opt1);
  }
  return 0;
}

// EXPECT: Some: 42
