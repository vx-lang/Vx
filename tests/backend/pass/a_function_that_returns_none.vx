//===----------------------------------------------------------------------===//
// A function declared `-> none` returns nothing, as `-> void` does. It can end without a
// `return`, leave early with `return;`, and run inside a `spawn` region.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}2 2 -1{{$}}
// CHECK: {{^}}11{{$}}

fn add_one(t : &mut Tensor<f32, [4]>, i : i64) -> none {
  t[i] = t[i] + 1.0;
}

fn add_one_unless_negative(t : &mut Tensor<f32, [4]>, i : i64) -> none {
  if t[i] < 0.0 {
    return;
  }
  t[i] = t[i] + 1.0;
}

fn add_one_on_the_device(t : &mut Tensor<f32, [4], Memory::GPU_HBM>, i : i64) on Topology::GPU -> none {
  t[i] = t[i] + 1.0;
}

fn in_a_spawn_region() -> f32 {
  let h = Tensor<f32, [4]>::fill(10.0);
  let mut a = transfer(h, Memory::GPU_HBM);
  spawn on(Topology::GPU) {
    add_one_on_the_device(&mut a, 2);
  }
  let back = transfer(a, Memory::CPU_DRAM);
  return back[2];
}

fn main() -> i32 {
  let mut t = Tensor<f32, [4]>::fill(1.0);
  t[3] = -1.0;
  add_one(&mut t, 0);
  add_one_unless_negative(&mut t, 1);
  add_one_unless_negative(&mut t, 3);
  println!("{} {} {}", t[0], t[1], t[3]);
  println!("{}", in_a_spawn_region());
  return 0;
}
