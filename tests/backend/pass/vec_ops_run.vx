//===----------------------------------------------------------------------===//
// The Vec API, executed: every value is asserted, on the flat path and on
// the AST oracle. An MLIR check proves a call is emitted; only running it
// proves the answer.
//
// The RUN lines name each path themselves, so the runner must not pin the
// oracle on both of them.
// REQUIRES: flat-codegen
// RUN: vxc %s --action run-jit
// RUN: vxc %s --action run-jit --legacy-codegen
import std::vec;
import std::googletest;

fn main() -> i32 {
  let mut v = Vec<i32>::with_capacity(2);
  expect_eq(v.len(), 0);

  // Three pushes into a capacity of two: the second grows the buffer.
  v.push(10);
  v.push(20);
  v.push(30);
  expect_eq(v.len(), 3);
  expect_eq(v.get(0), 10);
  expect_eq(v.get(1), 20);
  expect_eq(v.get(2), 30);

  v.set(1, 25);
  expect_eq(v.get(1), 25);
  expect_eq(v.len(), 3);

  // The iterator visits every element once, in order.
  let mut it = v.iter();
  let mut sum = 0;
  let mut seen = 0;
  loop {
    let item = it.next();
    match item {
      Option<i32>::Some(x) => {
        sum = sum + x;
        seen = seen + 1;
      }
      Option<i32>::None => {
        break;
      }
    }
  }
  expect_eq(seen, 3);
  expect_eq(sum, 65);

  v.free();
  return 0;
}
