// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// Every call here is inside a `comptime` block, so none of them survive to codegen. The
// file used to check the opposite -- that the chain was still emitted -- which is what a
// `comptime` block is supposed to prevent: the compiler had already worked each assert out
// and then emitted the calls for the program to make again.
//
// A wrong assert stops the build, and so does a block the evaluator cannot finish, so this
// file compiling at all says the asserts really were checked.
// CHECK-LABEL: func.func @main() -> i32
// CHECK-NOT: call @foo()
// CHECK-NOT: call @bar()
// CHECK-NOT: call @baz()
// CHECK: return
fn foo() -> i64 {
  let a : i64 = 10;
  return a;
}

fn bar() -> i64 {
  return 10;
}

fn baz() -> i64 {
  return 20;
}

fn main() -> i32 {
  comptime {
    assert(foo() == bar(), "not equal");
    assert(foo() != baz(), "equal");
    assert(foo() < baz(), "greater");
    assert(foo() <= baz(), "greater or equal");
    assert(baz() > foo(), "less");
    assert(baz() >= foo(), "less or equal");
    assert(true == true, "true is not true");
    assert(true!= false, "true is false");
    assert(true && true == true, "true and true is not true");
    assert(true || false == true, "true or false is not true");
  }
  return 0;
}
