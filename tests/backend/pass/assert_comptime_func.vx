// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// main calls each function in order; the assertion is that the chain survives to codegen
// rather than being folded away.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @foo() : () -> i64
// CHECK: call @bar() : () -> i64
// CHECK: call @foo() : () -> i64
// CHECK: call @baz() : () -> i64
// CHECK: call @foo() : () -> i64
// CHECK: call @baz() : () -> i64
// CHECK: call @foo() : () -> i64
// CHECK: call @baz() : () -> i64
fn foo() -> i64 {
  let a : i64 = 10;
  return a;
}

fn bar() -> i64 {
  return 10;
}

fn baz() -> i64 {
  return 20;
}

fn main() -> i32 {
  comptime {
    assert(foo() == bar(), "not equal");
    assert(foo() != baz(), "equal");
    assert(foo() < baz(), "greater");
    assert(foo() <= baz(), "greater or equal");
    assert(baz() > foo(), "less");
    assert(baz() >= foo(), "less or equal");
    assert(true == true, "true is not true");
    assert(true!= false, "true is false");
    assert(true && true == true, "true and true is not true");
    assert(true || false == true, "true or false is not true");
  }
  return 0;
}
