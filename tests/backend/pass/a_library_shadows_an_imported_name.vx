// `clash_left` declares `Range` as core::iter does, so this program, which imports core::iter
// only through it, sees its `Range`. Both imports declare `Point`, which is fine while unused.
import tests::modules::clash_left;
import tests::modules::clash_right;

fn main() -> i32 {
  let r = Range {
    lo : 7i64
  };
  print(r.lo + left_count());
  print!(" ");
  print(left_x() + right_z());
  return 0;
}

// EXPECT: 10 21
