// RUN: vxc %s 2>&1 | FileCheck %s
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s
//
// `print` takes a string, written in place or held in a variable, between numbers.

fn main() -> i32 {
  let s = "b";
  print("a");
  print(s);
  print(" ");
  print(1);
  print(" ");
  print(2.5);
  return 0;
}

// CHECK: ab 1 2.5
