//===----------------------------------------------------------------------===//
// The package `tests` writes `impl Write for Counter`, which gets the default `write_c_str` of
// `core::fmt`. The `unsafe` block of that default is trusted code of `core`, not of `tests`. So
// `--no-trusted-code tests` allows the program, and the audit of the library lists the block
// once, in `fmt.vx`.
//
// RUN: vxc --package tests=tests --no-trusted-code tests %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc --package tests=tests --audit-library %s 2>&1 | FileCheck %s --check-prefix=AUDIT
// CHECK: {{^}}5{{$}}
// AUDIT: core/fmt.vx:57:20: trusted code: an `unsafe` block
// AUDIT-NOT: a_package_that_implements_write.vx{{.*}}trusted code

import tests::modules::a_package_that_implements_write;

fn main() -> i32 {
  println!("{}", counted_bytes());
  return 0;
}
