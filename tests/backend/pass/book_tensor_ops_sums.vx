// A program of the book chapter on tensor operations (www/book/src/tensor-ops.md): the
// sums and extremes of a 1-D tensor, `sum`, `dot`, `max`, `min`, `mean` and `norm`.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}sum 4 dot -0.5{{$}}
// CHECK: {{^}}max 3 min -2{{$}}
// CHECK: {{^}}mean 1 norm 4.2426405{{$}}

// ANCHOR: program
import std::tensor;

fn main() -> i32 {
  let a : Tensor<f32, [4]> = [ 1.0, -2.0, 3.0, 2.0 ];
  let b : Tensor<f32, [4]> = [ 2.0, 1.0, 0.5, -1.0 ];
  println!("sum {} dot {}", a.sum(), a.dot(&b));
  println!("max {} min {}", a.max(), a.min());
  println!("mean {} norm {}", a.mean(), a.norm());
  return 0;
}
// ANCHOR_END: program
