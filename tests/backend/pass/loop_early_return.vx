//===----------------------------------------------------------------------===//
// A `return` nested inside a loop terminates the current block, so block
// threading must stop emitting into it (statement lowering returns no
// continuation block) rather than appending after the terminator.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @classify(%arg0: i32) -> i32
// CHECK: %[[C0:.*]] = arith.cmpi slt, %{{.*}}, %{{.*}} : index
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C1:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : index
// CHECK: cf.cond_br %[[C1]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @classify(%{{.*}}) : (i32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%[[V0]]) : (i32) -> i32

fn classify(n : i32) -> i32 {
  for i in 0..n {
    if i == 4 {
      return i; // early return from inside the loop body
    }
  }
  return 0 - 1;
}

fn main() -> i32 {
  let r = classify(7);
  print!("c=");
  print!(r);
  return 0;
}

// EXPECT: c=4
