// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @vx_result_new_ok_i32_i32(
// CHECK-DAG: func.func private @vx_result_is_ok_i32_i32(
// CHECK-DAG: func.func private @vx_result_unwrap_i32_i32(
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-DAG: func.func private @vx_result_drop_i32_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: %[[V0:.*]] = call @vx_result_new_ok_i32_i32(%{{.*}}) : (i32) -> !llvm.ptr
// CHECK: call @vx_result_is_ok_i32_i32(%[[V0]]) : (!llvm.ptr) -> i1
// CHECK: %[[V1:.*]] = call @vx_result_unwrap_i32_i32(%[[V0]]) : (!llvm.ptr) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%[[V1]]) : (i32) -> i32
// CHECK: call @vx_result_drop_i32_i32(%[[V0]]) : (!llvm.ptr) -> i32
extern "C" {
  fn vx_result_new_ok_i32_i32(val : i32)->*mut i8;
  fn vx_result_new_err_i32_i32(err : i32)->*mut i8;
  fn vx_result_is_ok_i32_i32(ptr : *mut i8) -> Bool;
  fn vx_result_unwrap_i32_i32(ptr : *mut i8) -> i32;
  fn vx_result_drop_i32_i32(ptr : *mut i8) -> i32;
}
import std::io;
fn main() -> i32 {
  unsafe {
    let res = vx_result_new_ok_i32_i32(99);
    if vx_result_is_ok_i32_i32 (res) {
      let val = vx_result_unwrap_i32_i32(res);
      print!("Ok: ");
      print!(val);
    }
    vx_result_drop_i32_i32(res);
  }
  return 0;
}

// EXPECT: Ok: 99
