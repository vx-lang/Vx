// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The CHECK-NOT lines keep both calls inside main.
// CHECK-LABEL: func.func @main() -> i32
// CHECK-NOT: func.func
// CHECK: call @f32$cos(%{{.*}}) : (f32) -> f32
// CHECK-NOT: func.func
// CHECK: call @f32$abs(%{{.*}}) : (f32) -> f32
// CHECK-LABEL: func.func @f32$cos(%arg0: f32) -> f32
// CHECK-NEXT: call @libm_cosf(%arg0) : (f32) -> f32
// CHECK-LABEL: func.func @f32$abs(%arg0: f32) -> f32
// CHECK-NEXT: call @[[ABS:vx_flat_mlir_[0-9]+]](%arg0) : (f32) -> f32
// CHECK: func.func private @[[ABS]](%arg0: f32) -> f32
// CHECK-NEXT: math.absf %arg0 : f32
import core::num;

fn main() -> i32 {
  let x : f32 = 0.0;
  let res : f32 = x.cos();
  let expected : f32 = 1.0;

  // allow small floating point difference
  let diff : f32 = (res - expected).abs();
  let mut ret : i32 = 1;
  if diff < 0.001 {
    ret = 0;
  }
  return ret;
}
