// EXPECT: 156
extern {
  fn vx_printf_i32(format: *const i8, val: i32) -> i32;
}

fn main() -> i32 {
  let base = 50;
  let adder = |a: i32, b: i32| a + b + base;
  let adder3 = |a: i32, b: i32, c: i32| a + b + c + base;
  let res = adder(20, 30) + adder3(1, 2, 3);
  unsafe {
    vx_printf_i32("%d
", res);
  }
  return res;
}
