//===----------------------------------------------------------------------===//
// `rx` moves into a task of a `tasks` block that gives a value. The task drops `rx`. If `main`
// dropped it again, after `tx` freed the channel, ThreadSanitizer would report a
// heap-use-after-free.
//
// REQUIRES: thread-sanitizer
// RUN: vxc --sanitize=thread %s 2>&1 | FileCheck %s --implicit-check-not=ThreadSanitizer
// RUN: vxc --sanitize=thread --legacy-codegen %s 2>&1 | FileCheck %s --implicit-check-not=ThreadSanitizer
// CHECK: {{^}}n 1{{$}}

import std::sync::channel;

fn take(rx : Receiver<i64>) -> i64 {
  return 1;
}

fn main() -> i32 {
  let (tx, rx) = channel<i64>(1);
  let n = tasks {
    let h = spawn {
      take(rx)
    };
    h.join()
  };
  let _keep = tx;
  println!("n {}", n);
  return 0;
}
