//===----------------------------------------------------------------------===//
// A value moves into a task, in the value that the task gives. The task drops it, and `main`
// must not drop it again. This holds for a `tasks` block that gives a value and for one used
// as a statement. The `drop` of `Noisy` prints its number, so each drop must show once.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s

import core::ops;

struct Noisy {
  id : i32,
}

impl Drop for Noisy {
  fn drop(self : &mut Noisy) -> void {
    println!("drop {}", self.id);
  }
}

fn take(n : Noisy) -> i64 {
  return 10;
}

fn main() -> i32 {
  let a = Noisy {
    id: 1
  };
  let b = Noisy {
    id: 2
  };
  // A `tasks` block that gives a value.
  let n = tasks {
    let h = spawn {
      take(a)
    };
    h.join()
  };
  // CHECK: {{^}}drop 1{{$}}
  // CHECK-NEXT: {{^}}n 10{{$}}
  println!("n {}", n);
  // A `tasks` block used as a statement.
  tasks {
    let h = spawn {
      take(b)
    };
    h.join();
  }
  // CHECK-NEXT: {{^}}drop 2{{$}}
  // CHECK-NEXT: {{^}}end{{$}}
  // CHECK-NOT: drop
  println!("end");
  return 0;
}
