//===----------------------------------------------------------------------===//
// `File::map` gives the whole file in memory, read-only, as a `Mapping`. The `Mapping` stays
// valid after the `File` closes. A file open only for writing gives `PermissionDenied`, even when
// it is empty. An empty file gives a `Mapping` of 0 bytes. `byte` stops the program for an index
// outside the file. The RUN lines give the path in FILE. The test runner gives no such variable,
// so NO_EXEC.
//
// NO_EXEC
// RUN: env FILE=%t vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env FILE=%t vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env FILE=%t OUTSIDE=1 not vxc %s 2>&1 | FileCheck %s --check-prefix=OUTSIDE
// RUN: rm -f %t
// CHECK: {{^}}write: 3{{$}}
// CHECK-NEXT: {{^}}map: 3 bytes: 7 8 9{{$}}
// CHECK-NEXT: {{^}}byte 1 through the pointer: 8{{$}}
// CHECK-NEXT: {{^}}map a file open for writing: PermissionDenied{{$}}
// CHECK-NEXT: {{^}}map an empty file: 0 bytes{{$}}
// OUTSIDE: {{^}}map: 3 bytes: 7 8 9{{$}}
// OUTSIDE: the index is outside the mapped file

import core::ptr;
import core::result;
import std::fs;
import std::string;
import std::vec;

extern {
  fn getenv(name : *const i8) -> *const i8;
}

fn report_error(call : *const i8, e : FileError) -> void {
  match e {
    FileError::BadPath => {
      println!("{}: BadPath", call);
    }
    FileError::NotFound => {
      println!("{}: NotFound", call);
    }
    FileError::PermissionDenied => {
      println!("{}: PermissionDenied", call);
    }
    FileError::NotInFolder => {
      println!("{}: NotInFolder", call);
    }
    FileError::Os(code) => {
      println!("{}: Os({})", call, code);
    }
  }
}

fn write_three_bytes(files : &Files, path : &String) -> Result<u64, FileError> {
  let mut out = File::open(files, path, OpenMode::Write())?;
  let mut bytes = Vec<u8>::new();
  bytes.push(7u8);
  bytes.push(8u8);
  bytes.push(9u8);
  return out.write(&bytes);
}

// Opens the file, maps it, and closes it.
fn map_the_file(files : &Files, path : &String) -> Result<Mapping, FileError> {
  let input = File::open(files, path, OpenMode::Read())?;
  return input.map();
}

// Opening the file for writing makes it empty.
fn map_a_file_open_for_writing(files : &Files, path : &String) -> Result<Mapping, FileError> {
  let out = File::open(files, path, OpenMode::Write())?;
  return out.map();
}

fn main(root : Root) -> i32 {
  let files = &root.files;
  let path = unsafe { String::from_c_str(getenv("FILE")) };
  match write_three_bytes(files, &path) {
    Result<u64, FileError>::Ok(count) => {
      println!("write: {}", count);
    }
    Result<u64, FileError>::Err(e) => {
      report_error("write", e);
    }
  }
  match map_the_file(files, &path) {
    Result<Mapping, FileError>::Ok(m) => {
      println!("map: {} bytes: {} {} {}", m.len(), m.byte(0), m.byte(1), m.byte(2));
      let p = m.as_ptr();
      println!("byte 1 through the pointer: {}", unsafe { p[1] });
      if !is_null(unsafe { getenv("OUTSIDE") }) {
        println!("byte 3: {}", m.byte(3));
      }
    }
    Result<Mapping, FileError>::Err(e) => {
      report_error("map", e);
    }
  }
  match map_a_file_open_for_writing(files, &path) {
    Result<Mapping, FileError>::Ok(m) => {
      println!("map a file open for writing: {} bytes", m.len());
    }
    Result<Mapping, FileError>::Err(e) => {
      report_error("map a file open for writing", e);
    }
  }
  match map_the_file(files, &path) {
    Result<Mapping, FileError>::Ok(m) => {
      println!("map an empty file: {} bytes", m.len());
    }
    Result<Mapping, FileError>::Err(e) => {
      report_error("map an empty file", e);
    }
  }
  return 0;
}
