//===----------------------------------------------------------------------===//
// The body of a macro can hold statements, as in Rust. A call that is a statement of its own
// runs all of them: an assignment, two prints, a `let`, and a print followed by a value. A
// call inside a loop or an `if` runs them there.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning
// CHECK: {{^}}1{{$}}
// CHECK-NEXT: {{^}}2{{$}}
// CHECK-NEXT: {{^}}log 5{{$}}
// CHECK-NEXT: {{^}}t[1] = 5, x = 7, z = 3, sum = 106{{$}}

macro_rules set_to {
  ($place : expr, $value : expr) => {
    $place = $value;
  };
}

macro_rules say_twice {
  ($a : expr, $b : expr) => {
    println!("{}", $a);
    println!("{}", $b);
  };
}

macro_rules log_and_give {
  ($a : expr) => {
    println!("log {}", $a);
    $a
  };
}

macro_rules declare {
  ($name : ident, $v : expr) => {
    let $name = $v;
  };
}

macro_rules add_to {
  ($place : expr, $value : expr) => {
    $place = $place + $value;
  };
}

fn main() -> i32 {
  let mut t : Tensor<i32, [3]> = [0, 0, 0];
  let mut x = 0;
  set_to!(t[1], 5);
  set_to!(x, 7);
  say_twice!(1, 2);
  log_and_give!(5);
  declare!(z, 3);
  let mut sum = 0;
  for i in 0..4 {
    add_to!(sum, i);
  }
  if z > 2 {
    add_to!(sum, 100);
  }
  println!("t[1] = {}, x = {}, z = {}, sum = {}", t[1], x, z, sum);
  return 0;
}
