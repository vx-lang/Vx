// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// main calls each function in order; the assertion is that the chain survives to codegen
// rather than being folded away.
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @foo() : () -> i32
// CHECK: call @bar() : () -> i32
// CHECK: call @foo() : () -> i32
// CHECK: call @bar() : () -> i32
// CHECK: call @foo() : () -> i32
// CHECK: call @bar() : () -> i32
// CHECK: call @bar() : () -> i32
// CHECK: call @foo() : () -> i32
fn foo() -> i32 {
  return 10;
}

fn bar() -> i32 {
  return 20;
}

fn main() -> i32 {
  let x : i32 = 10;
  assert(x == 10, "Math still works at runtime");
  assert(foo() != bar(), "equal");
  assert(foo() < bar(), "greater");
  assert(foo() <= bar(), "greater or equal");
  assert(bar() > foo(), "less");
  assert(bar() >= foo(), "less or equal");
  assert(true == true, "true is not true");
  assert(true!= false, "true is false");
  assert(true && true == true, "true and true is not true");
  assert(true || false == true, "true or false is not true");
  return 0;
}
