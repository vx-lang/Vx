//===----------------------------------------------------------------------===//
// A `?` may follow an `unsafe` block, as it may follow a call: in a `let`, in a statement of its
// own, and before an `as`. An error prints as a negative number.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}in a let 5 -7{{$}}
// CHECK: {{^}}as a statement 0 -7{{$}}
// CHECK: {{^}}before an as 4{{$}}

import core::result;

unsafe fn get(ok : bool) -> Result<i64, i32> {
  if ok {
    return Result<i64, i32>::Ok(4);
  }
  return Result<i64, i32>::Err(7);
}

fn in_a_let(ok : bool) -> Result<i64, i32> {
  let v = unsafe { get(ok) }?;
  return Result<i64, i32>::Ok(v + 1);
}

fn as_a_statement(ok : bool) -> Result<i64, i32> {
  unsafe { get(ok) }?;
  return Result<i64, i32>::Ok(0);
}

fn before_an_as() -> Result<i32, i32> {
  let v = unsafe { get(true) }? as i32;
  return Result<i32, i32>::Ok(v);
}

// The value of `r`, or minus its error.
fn value(r : Result<i64, i32>) -> i64 {
  match r {
    Result<i64,
    i32>::Ok(v) => {
      return v;
    }
    Result<i64,
    i32>::Err(e) => {
      return 0 - (e as i64);
    }
  }
}

fn main() -> i32 {
  println!("in a let {} {}", value(in_a_let(true)), value(in_a_let(false)));
  println!("as a statement {} {}", value(as_a_statement(true)), value(as_a_statement(false)));
  match before_an_as() {
    Result<i32,
    i32>::Ok(v) => {
      println!("before an as {}", v);
    }
    Result<i32,
    i32>::Err(_e) => {
      println!("before an as failed");
    }
  }
  return 0;
}
