// Runtime check that `match` over an enum lowers to the correct branch. The
// existing match_simple.vx only checks that a module is emitted; this verifies
// the selected arm actually executes.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @code(%arg0: i32) -> i32
// CHECK: %[[C0:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C0]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C1:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C1]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C2:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C2]], ^{{.*}}, ^{{.*}}
// CHECK: %[[C3:.*]] = arith.cmpi eq, %{{.*}}, %{{.*}} : i32
// CHECK: cf.cond_br %[[C3]], ^{{.*}}, ^{{.*}}
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @code(%{{.*}}) : (i32) -> i32
// CHECK: call @code(%{{.*}}) : (i32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32

enum Dir {
  North,
  South,
  East,
  West,
}

fn code(d : Dir) -> i32 {
  let mut r : i32 = 0;
  match d {
    Dir::North => {
      r = 1;
    }
    Dir::South => {
      r = 2;
    }
    Dir::East => {
      r = 3;
    }
    Dir::West => {
      r = 4;
    }
  }
  return r;
}

fn main() -> i32 {
  let a = code(Dir::East);
  let b = code(Dir::West);
  let s = a + b; // 3 + 4 = 7
  print!("m=");
  print!(s);
  return 0;
}

// EXPECT: m=7
