// RUN: vxc %s --action run-jit 2>&1 | FileCheck %s

import std::io;
fn main() -> i32 {
  let a : f32 = 10.5;
  let b : f32 = 2.0;

  let c : f32 = a + b;
  let d : f32 = a - b;
  let e : f32 = a * b;
  let f : f32 = a / b;

  unsafe { print!(c); print!(d); print!(e); print!(f); }

  return 0;
}

// CHECK: 12.5
// CHECK-SAME: 8.5
// CHECK-SAME: 21
// CHECK-SAME: 5.25
