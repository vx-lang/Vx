// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The if/else chain lowers to unstructured control flow: one comparison per arm feeding a
// conditional branch, and a single load of the result slot on the way out.
// CHECK-LABEL: func.func @test_if(%arg0: i32) -> i32 {
// CHECK: %[[SLOT:.*]] = memref.alloca() : memref<i32>
// CHECK: %[[GT:.*]] = arith.cmpi sgt, %arg0, %{{.*}} : i32
// CHECK: cf.cond_br %[[GT]], ^[[THEN:bb[0-9]+]], ^[[ELSE:bb[0-9]+]]
// CHECK: ^[[THEN]]:
// CHECK: memref.store %{{.*}}, %[[SLOT]][] : memref<i32>
// CHECK: ^[[ELSE]]:
// CHECK: %[[EQ:.*]] = arith.cmpi eq, %arg0, %{{.*}} : i32
// CHECK: cf.cond_br %[[EQ]],
// CHECK: memref.load %[[SLOT]][] : memref<i32>
fn test_if(x : i32) -> i32 {
  let mut res : i32 = 0;
  if x > 10 {
    res = 1;
  } else if x == 10 {
    res = 2;
  } else {
    res = 3;
  }
  return res;
}

fn main() -> i32 {
  let a = test_if(15);
  let b = test_if(10);
  let c = test_if(5);
  return 0; // 1 + 2 + 3 = 6
}

