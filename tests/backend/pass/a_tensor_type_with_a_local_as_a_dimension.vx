//===----------------------------------------------------------------------===//
// A tensor type can name a local variable as a dimension, as `n` in `Tensor<f32, [n, n]>`. Both
// code generators allocate such a tensor with its extents known only at run time.
//
// RUN: vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s --check-prefix=MLIR
// CHECK: {{^}}square: 11, rows of four: 7{{$}}
// MLIR-LABEL: func.func @square
// MLIR: memref.alloc(%{{.*}}, %{{.*}}) : memref<?x?xf32>
// MLIR-LABEL: func.func @rows_of_four
// MLIR: memref.alloc(%{{.*}}) : memref<?x{{[?4]}}xi32>

fn square() -> f32 {
  let n = 3;
  let mut a = unsafe { Tensor<f32, [n, n]>::uninit() };
  for i in 0..n {
    for j in 0..n {
      a[i][j] = (i * n + j) as f32;
    }
  }
  return a[n - 1][n - 1] + a[1][0];
}

fn rows_of_four() -> i32 {
  let n = 5;
  let mut b = Tensor<i32, [n, 4]>::new();
  b[n - 1][3] = 7;
  return b[0][0] + b[n - 1][3];
}

fn main() -> i32 {
  println!("square: {}, rows of four: {}", square(), rows_of_four());
  return 0;
}
