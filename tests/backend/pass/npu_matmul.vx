//===- npu_matmul.vx ---------------------------------*- Vx -*-===//
// RUN: vxc %s --emit-mlir --disable-optimizations | FileCheck %s --check-prefix=FRONTEND
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=MLIR
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM

fn test_f32() -> i32 {
  let mut a = Tensor<f32>([4, 4]);
  let mut b = Tensor<f32>([4, 4]);
  let mut c = Tensor<f32>([4, 4]).with_memory(Memory::NPU_HBM);

  for i in 0..4 {
    for j in 0..4 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }

  let a_npu = transfer(a, Memory::NPU_HBM);
  let b_npu = transfer(b, Memory::NPU_HBM);

  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        c[i][j] = 0.0;
        for k in 0..4 {
          c[i][j] = c[i][j] + a_npu[i][k] * b_npu[k][j];
        }
      }
    }
  }

  // 4 * (2.0 * 3.0) = 24.0
  let c_host = transfer(c, Memory::Host_DRAM);
  assert(c_host[0][0] == 24.0, "f32 matmul 0,0 match");
  assert(c_host[2][3] == 24.0, "f32 matmul 2,3 match");
  assert(c_host[3][3] == 24.0, "f32 matmul 3,3 match");
  return 0;
}

fn test_bf16() -> i32 {
  let mut a = Tensor<bf16>([4, 4]);
  let mut b = Tensor<bf16>([4, 4]);
  let mut c = Tensor<bf16>([4, 4]).with_memory(Memory::NPU_HBM);

  for i in 0..4 {
    for j in 0..4 {
      a[i][j] = 2.0;
      b[i][j] = 3.0;
    }
  }

  let a_npu = transfer(a, Memory::NPU_HBM);
  let b_npu = transfer(b, Memory::NPU_HBM);

  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        c[i][j] = 0.0;
        for k in 0..4 {
          c[i][j] = c[i][j] + a_npu[i][k] * b_npu[k][j];
        }
      }
    }
  }

  let c_host = transfer(c, Memory::Host_DRAM);
  assert(c_host[0][0] == 24.0, "bf16 matmul 0,0 match");
  assert(c_host[2][3] == 24.0, "bf16 matmul 2,3 match");
  assert(c_host[3][3] == 24.0, "bf16 matmul 3,3 match");
  return 0;
}

fn main() -> i32 {
  test_f32();
  test_bf16();
  return 0;
}

