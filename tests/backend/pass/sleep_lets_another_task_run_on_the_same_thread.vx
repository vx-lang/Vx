//===----------------------------------------------------------------------===//
// The shared runtime runs both tasks on one OS thread. The sleeper sends on a channel and sleeps
// for 1 s. The other task waits for that value, and then prints. So the other task can print
// before the sleeper wakes only if `sleep` gives the thread to it. If `sleep` blocked the thread,
// the sleeper would print first. The check reads the order of the lines, not a time.
//
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 VX_TASK_MAX_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 VX_TASK_MAX_WORKERS=1 vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}the other task ran while the sleeper slept{{$}}
// CHECK-NEXT: {{^}}the sleeper woke after at least 1 s: true{{$}}
// CHECK-NEXT: {{^}}done{{$}}

import core::time;
import std::sync::channel;
import std::time;

// Sends one value, and then sleeps for 1 s.
fn sleeper(tx : Sender<i64>) -> void {
  let start = Instant::now();
  let _sent = tx.send(1);
  sleep(Duration::from_secs(1));
  println!("the sleeper woke after at least 1 s: {}", start.elapsed() >= Duration::from_secs(1));
}

// Waits for the value of the sleeper, and then prints.
fn other(rx : Receiver<i64>) -> void {
  let _got = rx.recv();
  println!("the other task ran while the sleeper slept");
}

fn main() -> i32 {
  let (tx, rx) = channel<i64>(1);
  tasks {
    spawn {
      sleeper(tx);
    };
    spawn {
      other(rx);
    };
  };
  println!("done");
  return 0;
}
