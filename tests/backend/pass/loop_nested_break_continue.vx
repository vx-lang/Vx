// Exercises the break/continue target stacks across nested loops: the inner
// `break` must exit only the inner loop, and the outer `continue` must advance
// the outer loop index (latch block) without affecting the inner one.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32

fn main() -> i32 {
  let mut sum : i32 = 0;
  for i in 0..4 {
    if i == 2 {
      continue; // skip the whole inner loop for i == 2
    }
    for j in 0..10 {
      if j >= 3 {
        break; // only leaves the inner loop
      }
      sum += j; // 0 + 1 + 2 = 3 per surviving outer iteration
    }
  }
  // Outer i in {0, 1, 3}: 3 iterations * 3 = 9
  print!("r=");
  print!(sum);
  return 0;
}

// EXPECT: r=9
