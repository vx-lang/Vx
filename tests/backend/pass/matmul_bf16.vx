// EXPECT:  [24.0,   24.0,   24.0,   24.0],
// EXPECT:  [24.0,   24.0,   24.0,   24.0],
// EXPECT:  [24.0,   24.0,   24.0,   24.0]]

fn custom_matmul(a : Pinned<Tensor<bf16, [ 4, 4 ]>, Topology::NPU[0]>,
b : Pinned<Tensor<bf16, [ 4, 4 ]>, Topology::NPU[0]>)
-> Verified<Ref<Tensor<bf16, [ 4, 4 ]>, Memory::NPU_HBM>> {
  let mut result = Tensor<bf16>([ 4, 4 ]).with_memory(Memory::NPU_HBM);
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        result[i][j] = 0.0;
        for k in 0..4 { result[i][j] = result[i][j] + a[i][k] * b[k][j]; }
      }
    }
  }
  return Verified(result);
}

fn main() -> Verified<Ref<Tensor<bf16, [ 4, 4 ]>, Memory::NPU_HBM>> {
  let mut a_host = Tensor<bf16>([ 4, 4 ]); // Defaults to CPU_DRAM
  let mut b_host = Tensor<bf16>([ 4, 4 ]);

  for i in 0..4 {
    for j in 0..4 {
      a_host[i][j] = 2.0;
      b_host[i][j] = 3.0;
    }
  }

  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);

  let result = custom_matmul(a, b);
  print(&result);
  return result;
}
// NO_EXEC

