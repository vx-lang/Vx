//
// EXPECT: public file operations preserve structured errors
// Public file calls distinguish errors, short reads, empty requests, and EOF.
// The bridge tests in tests/file_error_status.rs check a null buffer. A Vx caller must not pass one.
import core::mem;
import core::result;
import core::option;
import std::fs;
import std::io;

extern {
  fn malloc(size : i64) -> *mut u8;
  fn free(ptr : *mut u8) -> void;
  fn vx_get_temp_file(name : *const i8) -> *mut i8;
  fn vx_free_temp_file(path : *mut i8) -> i32;
  fn remove(path : *const i8) -> i32;
}

fn main() -> i32 {
  let path = unsafe { vx_get_temp_file("structured_file_errors") };
  unsafe { remove(path); }
  let missing_result = unsafe { File::open_raw(path) };
  assert(missing_result.is_err(), "opening a missing file did not give an error");
  let missing = missing_result.unwrap_err();
  let missing_category = match missing.kind() {
    ErrorKind::NotFound() => {
      true
    },
    _ => {
      false
    }
  };
  assert(missing_category, "missing file category");
  let missing_operation = match missing.operation() {
    Operation::Open() => {
      true
    },
    _ => {
      false
    }
  };
  assert(missing_operation, "missing file operation");
  assert(missing.raw_os_error().is_some(), "missing file native code");

  let unknown = IoError::from_raw_os_error(12345).with_operation(Operation::Read());
  let unknown_category = match unknown.kind() {
    ErrorKind::Other() => {
      true
    },
    _ => {
      false
    }
  };
  assert(unknown_category, "unknown native category");
  assert(unknown.raw_os_error().is_some(), "an unknown OS code was lost");
  assert(unknown.raw_os_error().unwrap() == 12345, "an unknown OS code changed");
  let invalid = IoError::from_kind(ErrorKind::InvalidInput()).with_operation(Operation::Seek());
  let invalid_category = match invalid.kind() {
    ErrorKind::InvalidInput() => {
      true
    },
    _ => {
      false
    }
  };
  assert(invalid_category, "Vx error category");
  let invalid_operation = match invalid.operation() {
    Operation::Seek() => {
      true
    },
    _ => {
      false
    }
  };
  assert(invalid_operation, "Vx error operation");
  assert(invalid.raw_os_error().is_none(), "Vx error has no native code");

  let byte : u8 = 65;
  let created = unsafe { File::create_raw(path) };
  assert(created.is_ok(), "create_raw failed");
  let mut writer = created.unwrap();
  let written = unsafe { writer.try_write_raw((&byte) as *const u8, 1) };
  assert(written.is_ok(), "the write to the new file failed");
  assert(written.unwrap() == 1, "the write to the new file did not take one byte");
  let output = unsafe { malloc(2) };
  let read_result = unsafe { writer.try_read_raw(output, 1) };
  assert(read_result.is_err(), "a read from a file open only for writing did not give an error");
  let read_error = read_result.unwrap_err();
  let read_operation = match read_error.operation() {
    Operation::Read() => {
      true
    },
    _ => {
      false
    }
  };
  assert(read_operation, "read error operation");
  assert(read_error.raw_os_error().is_some(), "read error native code");
  drop(writer);

  let opened = unsafe { File::open_raw(path) };
  assert(opened.is_ok(), "open_raw of the file failed");
  let mut reader = opened.unwrap();
  let short = unsafe { reader.try_read_raw(output, 2) };
  assert(short.is_ok(), "a read of two bytes from a one-byte file failed");
  assert(short.unwrap() == 1, "a read of two bytes from a one-byte file did not get one byte");
  assert(unsafe { *output } == 65u8, "read byte");
  let at_end = unsafe { reader.try_read_raw(output, 1) };
  assert(at_end.is_ok(), "a read at the end of the file failed");
  assert(at_end.unwrap() == 0, "a read at the end of the file did not return 0");
  let empty_read = unsafe { reader.try_read_raw(output, 0) };
  assert(empty_read.is_ok(), "a read of 0 bytes failed");
  assert(empty_read.unwrap() == 0, "a read of 0 bytes did not return 0");
  let empty_write = unsafe { reader.try_write_raw(output as *const u8, 0) };
  assert(empty_write.is_ok(), "a write of 0 bytes failed");
  assert(empty_write.unwrap() == 0, "a write of 0 bytes did not return 0");
  let write_result = unsafe { reader.try_write_raw((&byte) as *const u8, 1) };
  assert(write_result.is_err(), "a write to a file open only for reading did not give an error");
  let write_error = write_result.unwrap_err();
  let write_operation = match write_error.operation() {
    Operation::Write() => {
      true
    },
    _ => {
      false
    }
  };
  assert(write_operation, "write error operation");
  assert(write_error.raw_os_error().is_some(), "write error native code");
  drop(reader);
  unsafe { free(output); remove(path); vx_free_temp_file(path); }
  println!("public file operations preserve structured errors");
  return 0;
}
