//===----------------------------------------------------------------------===//
// `break` and `continue` inside an infinite `loop`. Unlike the counted `for`
// loop, here `continue` targets the loop entry directly (no index latch), so
// this guards that distinct lowering path.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_str(
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32

fn main() -> i32 {
  let mut i : i32 = 0;
  let mut acc : i32 = 0;
  loop {
    i += 1;
    if i > 5 {
      break;
    }
    if i == 3 {
      continue; // skip adding 3
    }
    acc += i; // 1 + 2 + 4 + 5 = 12
  }
  print!("acc=");
  print!(acc);
  return 0;
}

// EXPECT: acc=12
