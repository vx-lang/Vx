//===----------------------------------------------------------------------===//
// A closure value is two pointers: its captured values and its function. An `Option` of a
// closure type must hold both, and no declared type in this program has a closure field.
// The pattern `Option::Some(g)` names no type arguments, so the type of `g` comes from the
// matched value, and the call of `g` needs it.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}the closure in the option gives 6{{$}}

import core::option;

fn wrap(g : |i32| -> i32) -> Option<|i32| -> i32> {
  return Option<|i32| -> i32>::Some(g);
}

fn main() -> i32 {
  let k : i32 = 1;
  match wrap(|x : i32| x + k * 4) {
    Option::Some(g) => {
      println!("the closure in the option gives {}", g(2));
    }
    Option::None => {
      println!("the option is empty");
    }
  }
  return 0;
}
