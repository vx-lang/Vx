// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module

import tests::modules::llama_rt;
import std::io;
import std::vec;
import std::math;

struct Config {
  dim : i32,
  hidden_dim : i32,
  n_layers : i32,
  n_heads : i32,
  n_kv_heads : i32,
  vocab_size : i32,
  seq_len
  : i32
}

struct TransformerWeights {
  token_embedding_table : *mut f32,
  rms_att_weight : *mut f32,
  rms_ffn_weight : *mut f32,
  wq : *mut f32,
  wk : *mut f32,
  wv
  : *mut f32,
  wo : *mut f32,
  w1 : *mut f32,
  w2 : *mut f32,
  w3 : *mut f32,
  rms_final_weight : *mut f32,
  wcls : *mut f32
}

struct RunState {
  x : *mut f32,
  xb : *mut f32,
  xb2 : *mut f32,
  hb : *mut f32,
  hb2 : *mut f32,
  q : *mut f32,
  k : *mut f32,
  v : *mut f32,
  att : *mut f32,
  logits : *mut f32,
  key_cache : *mut f32,
  value_cache
  : *mut f32
}

fn malloc_run_state(dim: i32, hidden_dim: i32, n_layers: i32, n_heads: i32, n_kv_heads: i32, seq_len: i32, vocab_size: i32) -> RunState {
  let div_kv : i32 = dim * n_kv_heads;
  let kv_dim : i32 = div_kv / n_heads;

  let state = unsafe {
    let s_x : *mut f32 = Vec<f32>::with_capacity(dim).data;
    let s_xb : *mut f32 = Vec<f32>::with_capacity(dim).data;
    let s_xb2 : *mut f32 = Vec<f32>::with_capacity(dim).data;
    let s_hb : *mut f32 = Vec<f32>::with_capacity(hidden_dim).data;
    let s_hb2 : *mut f32 = Vec<f32>::with_capacity(hidden_dim).data;
    let s_q : *mut f32 = Vec<f32>::with_capacity(dim).data;
    let s_k : *mut f32 = Vec<f32>::with_capacity(dim).data;
    let s_v : *mut f32 = Vec<f32>::with_capacity(dim).data;
    let s_att : *mut f32 = Vec<f32>::with_capacity(n_heads * seq_len).data;
    let s_logits : *mut f32 = Vec<f32>::with_capacity(vocab_size).data;
    let s_key_cache
    : *mut f32 = Vec<f32>::with_capacity(n_layers * seq_len * kv_dim).data;
    let s_value_cache
    : *mut f32 = Vec<f32>::with_capacity(n_layers * seq_len * kv_dim).data;

    RunState {
      x:
      s_x, xb : s_xb,
      xb2 : s_xb2,
      hb : s_hb,
      hb2 : s_hb2,
      q : s_q,
      k : s_k,
      v : s_v,
      att : s_att,
      logits : s_logits,
      key_cache
      : s_key_cache,
      value_cache : s_value_cache
    }
  };
  return state;
}

// `topology_id` is the device whose memory the projection weights are staged
// into. A disaggregated run calls this twice, once per device, because prefill
// and decode are two workers each holding a full copy of the model -- that is
// what disaggregation *is*, as distinct from sharding, where one copy is split
// and #290's per-instance accounting would be needed to reason about it.
//
// Unlike `D` on `matmul`, this is a plain runtime parameter: it selects which
// memory an allocation lands in, which the plugin decides when the call
// happens. Only *placement* has to be constant.
fn memory_map_weights(ptr : *mut f32, dim : i32, hidden_dim : i32,
n_layers : i32, n_heads : i32, n_kv_heads : i32,
seq_len : i32, vocab_size : i32, topology_id : i32) -> TransformerWeights {
  let head_size : i32 = dim / n_heads;

  let w = unsafe {
    let p0 : *mut f32 = ptr;
    let p1 : *mut f32 = vx_advance_ptr(p0, vocab_size * dim);
    let p2 : *mut f32 = vx_advance_ptr(p1, n_layers * dim);
    let p3_offset : i32 = n_layers * dim * n_heads * head_size;
    let p3 : *mut f32 = vx_advance_ptr(p2, p3_offset);
    let p4_offset : i32 = n_layers * dim * n_kv_heads * head_size;
    let p4 : *mut f32 = vx_advance_ptr(p3, p4_offset);
    let p5_offset : i32 = n_layers * dim * n_kv_heads * head_size;
    let p5 : *mut f32 = vx_advance_ptr(p4, p5_offset);
    let p6_offset : i32 = n_layers * n_heads * head_size * dim;
    let p6 : *mut f32 = vx_advance_ptr(p5, p6_offset);
    let p7 : *mut f32 = vx_advance_ptr(p6, n_layers * dim);
    let p8 : *mut f32 = vx_advance_ptr(p7, n_layers * dim * hidden_dim);
    let p9 : *mut f32 = vx_advance_ptr(p8, n_layers * hidden_dim * dim);
    let p10 : *mut f32 = vx_advance_ptr(p9, n_layers * dim * hidden_dim);
    let p11 : *mut f32 = vx_advance_ptr(p10, dim);
    let p12 : *mut f32 = vx_advance_ptr(p11, seq_len * head_size);
    let wcls_ptr : *mut f32 = p0; // assuming shared weights

    // Stage the projection weights into the memory of the topology that reads
    // them, once, before any token is generated.
    //
    // These seven blobs are the only weights a `spawn` touches -- the norms and
    // the embedding table are read by host code, so they stay where they are.
    // Moving those too would put them out of the host's reach, which on a real
    // device means a bad dereference rather than a slow one.
    //
    // Once, not per call, is the whole point. `matmul` is invoked seven times
    // per layer per token; staging inside it would move `wq` across the bus
    // 6 x N times for an N-token generation. A pointer into device memory
    // instead means the plugin finds the operand already where it needs to be
    // (`is_device_ptr` in runtime/cuda_dispatch.cpp) and stages nothing.
    //
    // The per-layer slicing below is unchanged: these are contiguous blobs, and
    // `vx_advance_ptr` offsets into device memory exactly as it did into host
    // memory. What changed is which memory it is.
    let f32_bytes : i64 = 4;
    let wq_n : i64 = (n_layers * dim * n_heads * head_size) as i64;
    let wk_n : i64 = (n_layers * dim * n_kv_heads * head_size) as i64;
    let wv_n : i64 = (n_layers * dim * n_kv_heads * head_size) as i64;
    let wo_n : i64 = (n_layers * n_heads * head_size * dim) as i64;
    let w1_n : i64 = (n_layers * dim * hidden_dim) as i64;
    let w2_n : i64 = (n_layers * hidden_dim * dim) as i64;
    let w3_n : i64 = (n_layers * dim * hidden_dim) as i64;

    let d_wq : *mut f32 = vx_plugin_alloc_and_transfer(wq_n * f32_bytes, p2, topology_id);
    let d_wk : *mut f32 = vx_plugin_alloc_and_transfer(wk_n * f32_bytes, p3, topology_id);
    let d_wv : *mut f32 = vx_plugin_alloc_and_transfer(wv_n * f32_bytes, p4, topology_id);
    let d_wo : *mut f32 = vx_plugin_alloc_and_transfer(wo_n * f32_bytes, p5, topology_id);
    let d_w1 : *mut f32 = vx_plugin_alloc_and_transfer(w1_n * f32_bytes, p7, topology_id);
    let d_w2 : *mut f32 = vx_plugin_alloc_and_transfer(w2_n * f32_bytes, p8, topology_id);
    let d_w3 : *mut f32 = vx_plugin_alloc_and_transfer(w3_n * f32_bytes, p9, topology_id);

    TransformerWeights {
      token_embedding_table:
      p0, rms_att_weight : p1,
      wq : d_wq,
      wk : d_wk,
      wv : d_wv,
      wo : d_wo,
      rms_ffn_weight : p6,
      w1 : d_w1,
      w2 : d_w2,
      w3
      : d_w3,
      rms_final_weight : p10,
      wcls : wcls_ptr
    }
  };
  return w;
}

// One decoder step, on device `D`. Every projection inside forwards `D` to
// `matmul<D>`, so instantiating this function at 0 and at 1 is what makes
// prefill and decode run on different GPUs -- there is no other difference
// between the two phases' arithmetic.
//
// Everything that is not a projection still runs on the host: RMSNorm, RoPE,
// the attention loops, SwiGLU. They are correct and they are invisible in a
// device trace, which is why the KV cache below lives in host memory and has
// to be moved explicitly rather than simply being on the right device already.
// Closing that is kernel emission (#251) and strided views of a placed tensor
// (#344).
fn transformer<const D : i32>(token : i32, pos : i32, p : &Config, s : &RunState,
w : &TransformerWeights) -> *mut f32 {
  unsafe {
    let x : *mut f32 = s.x;
    let dim : i32 = p.dim;
    let kv_mul_div : i32 = p.dim * p.n_kv_heads;
    let kv_dim : i32 = kv_mul_div / p.n_heads;
    let kv_mul : i32 = p.n_heads / p.n_kv_heads;
    let hidden_dim : i32 = p.hidden_dim;
    let head_size : i32 = dim / p.n_heads;

    let content_row : *mut f32 =
    vx_advance_ptr(w.token_embedding_table, token * dim);
    for i in 0..dim {
      x[i] = content_row[i];
    }

    let n_layers : i32 = p.n_layers;
    let seq_len : i32 = p.seq_len;

    for l in 0..n_layers {
      let rms_w_off : i32 = l * dim;
      let rms_w : *mut f32 = vx_advance_ptr(w.rms_att_weight, rms_w_off);

      let dim_f : f32 = dim as f32;
      let hidden_dim_f : f32 = hidden_dim as f32;

      let status1 : i32 = rmsnorm(s.xb, x, rms_w, dim, dim_f);

      let loff : i32 = l * seq_len * kv_dim;
      let cache_off : i32 = loff + pos * kv_dim;
      let s_k : *mut f32 = vx_advance_ptr(s.key_cache, cache_off);
      let s_v : *mut f32 = vx_advance_ptr(s.value_cache, cache_off);

      let wq_off : i32 = l * dim * dim;
      let wq_l : *mut f32 = vx_advance_ptr(w.wq, wq_off);
      let status2 : i32 = matmul<D>(s.q, s.xb, wq_l, dim, dim);

      let wk_off : i32 = l * dim * kv_dim;
      let wk_l : *mut f32 = vx_advance_ptr(w.wk, wk_off);
      let status3 : i32 = matmul<D>(s_k, s.xb, wk_l, dim, kv_dim);

      let wv_off : i32 = l * dim * kv_dim;
      let wv_l : *mut f32 = vx_advance_ptr(w.wv, wv_off);
      let status4 : i32 = matmul<D>(s_v, s.xb, wv_l, dim, kv_dim);

      // RoPE relative positional encoding
      for i in 0..kv_dim {
        let div : i32 = i / 2;
        let mul : i32 = div * 2;
        let rem : i32 = i - mul;
        if rem == 0 {
          // The rotation frequency depends on the index *within* the head, so
          // every head repeats the same frequency ladder. Passing the global
          // index instead pushes each subsequent head far down the ladder.
          let head_idx : i32 = i / head_size;
          let head_base : i32 = head_idx * head_size;
          let head_dim : i32 = i - head_base;
          let fcr : f32 = vx_get_rope_freq(pos, head_dim, head_size);
          let fci : f32 = fcr.cos();
          let fsi : f32 = fcr.sin();

          let roff : i32 = i;
          let roff_1 : i32 = i + 1;

          let q0 : f32 = s.q[roff];
          let q1 : f32 = s.q[roff_1];
          s.q[roff] = q0 * fci - q1 * fsi;
          s.q[roff_1] = q0 * fsi + q1 * fci;

          let k0 : f32 = s_k[roff];
          let k1 : f32 = s_k[roff_1];
          s_k[roff] = k0 * fci - k1 * fsi;
          s_k[roff_1] = k0 * fsi + k1 * fci;
        }
      }

      // Multi-head self-attention
      let pos_1 : i32 = pos + 1;
      for h in 0..p.n_heads {
        let q_off : i32 = h * head_size;
        let att_off : i32 = h * seq_len;
        let att_h : *mut f32 = vx_advance_ptr(s.att, att_off);

        for t in 0..pos_1 {
          let h_kv_mul : i32 = h / kv_mul;
          let k_cache_off : i32 = l * seq_len * kv_dim + t * kv_dim +
          h_kv_mul * head_size;
          let k_t : *mut f32 = vx_advance_ptr(s.key_cache, k_cache_off);
          let mut score : f32 = 0.0;
          for i in 0..head_size {
            let qv : f32 = s.q[q_off + i];
            let kv : f32 = k_t[i];
            score += qv * kv;
          }

          let head_size_f : f32 = head_size as f32;
          let factor : f32 = 1.0 / head_size_f.sqrt();
          score = score * factor;
          att_h[t] = score;
        }

        let mut max_val : f32 = att_h[0];
        for t in 1..pos_1 {
          let val : f32 = att_h[t];
          if val > max_val {
            max_val = val;
          }
        }

        let mut sum : f32 = 0.0;
        for t in 0..pos_1 {
          let val : f32 = att_h[t];
          // `val - max_val.exp()` parses as `val - exp(max_val)`: the method
          // call binds tighter than the subtraction, so this was not a softmax
          // at all. Subtract first, then exponentiate.
          let shifted : f32 = val - max_val;
          let exp_val : f32 = shifted.exp();
          att_h[t] = exp_val;
          sum += exp_val;
        }

        for t in 0..pos_1 {
          let val : f32 = att_h[t];
          att_h[t] = val / sum;
        }

        let xb_off : i32 = h * head_size;
        for i in 0..head_size {
          let mut val : f32 = 0.0;
          for t in 0..pos_1 {
            let h_kv_mul : i32 = h / kv_mul;
            let v_cache_off : i32 = l * seq_len * kv_dim + t * kv_dim +
            h_kv_mul * head_size;
            let v_t : *mut f32 = vx_advance_ptr(s.value_cache, v_cache_off);
            let a : f32 = att_h[t];
            let v : f32 = v_t[i];
            val += a * v;
          }
          s.xb[xb_off + i] = val;
        }
      }

      // final matmul
      let wo_off : i32 = l * dim * dim;
      let wo_l : *mut f32 = vx_advance_ptr(w.wo, wo_off);
      let status5 : i32 = matmul<D>(s.xb2, s.xb, wo_l, dim, dim);

      for i in 0..dim {
        let x_val : f32 = x[i];
        let xb2_val : f32 = s.xb2[i];
        x[i] = x_val + xb2_val;
      }

      let rms_ffn_off : i32 = l * dim;
      let rms_ffn_w : *mut f32 = vx_advance_ptr(w.rms_ffn_weight, rms_ffn_off);
      let status6 : i32 = rmsnorm(s.xb, x, rms_ffn_w, dim, dim_f);

      let w1_off : i32 = l * dim * hidden_dim;
      let w1_l : *mut f32 = vx_advance_ptr(w.w1, w1_off);
      let w3_off : i32 = l * dim * hidden_dim;
      let w3_l : *mut f32 = vx_advance_ptr(w.w3, w3_off);
      let status7 : i32 = matmul<D>(s.hb, s.xb, w1_l, dim, hidden_dim);
      let status8 : i32 = matmul<D>(s.hb2, s.xb, w3_l, dim, hidden_dim);

      // SwiGLU
      for i in 0..hidden_dim {
        let mut val : f32 = s.hb[i];
        let neg_val : f32 = 0.0 - val;
        let exp_val : f32 = neg_val.exp();
        let denom : f32 = 1.0 + exp_val;
        let factor : f32 = 1.0 / denom;
        val = val * factor;
        let hb2_val : f32 = s.hb2[i];
        s.hb[i] = val * hb2_val;
      }

      let w2_off : i32 = l * dim * hidden_dim;
      let w2_l : *mut f32 = vx_advance_ptr(w.w2, w2_off);
      let status9 : i32 = matmul<D>(s.xb, s.hb, w2_l, hidden_dim, dim);

      for i in 0..dim {
        let x_val : f32 = x[i];
        let xb_val : f32 = s.xb[i];
        x[i] = x_val + xb_val;
      }
    }

    let dim_f : f32 = dim as f32;
    let status10 : i32 = rmsnorm(x, x, w.rms_final_weight, dim, dim_f);
    let status11 : i32 = matmul<D>(s.logits, x, w.wcls, p.dim, p.vocab_size);
  };

  return s.logits;
}

// Move the KV cache from the device that produced it to the device that will
// read it -- the one edge a disaggregated placement is made of (#347).
//
// The path is host -> src device -> dst device -> host, and only the middle leg
// is the interesting one. The two outer legs exist because attention runs on
// the host (#251), so the cache's working copy is host memory; when the
// attention loops move onto the device those legs disappear and this becomes a
// single peer copy. What is already real is that the bytes cross between two
// devices' memories through `cudaMemcpyPeer`, over whichever link the box
// actually has.
//
// The transfer is *load-bearing*, which is the property that makes this worth
// showing. `dst` is a second RunState with its own KV arrays, untouched by
// prefill; decode reads a cache it can only have obtained here. Sharing one
// array between the phases and copying it device-to-device on the side would
// produce identical output with this function deleted, and would be theatre.
// Deleting it now produces garbage, and that is the acceptance test.
fn handoff_kv(src : &RunState, dst : &RunState, bytes : i64, src_topology : i32,
dst_topology : i32) -> i32 {
  unsafe {
    let d_k_src : *mut f32 =
    vx_plugin_alloc_and_transfer(bytes, src.key_cache, src_topology);
    let d_v_src : *mut f32 =
    vx_plugin_alloc_and_transfer(bytes, src.value_cache, src_topology);

    let d_k_dst : *mut f32 =
    vx_plugin_transfer_peer(d_k_src, src_topology, dst_topology, bytes);
    let d_v_dst : *mut f32 =
    vx_plugin_transfer_peer(d_v_src, src_topology, dst_topology, bytes);

    let k_ok : i32 =
    vx_plugin_transfer_device_to_host(d_k_dst, dst.key_cache, bytes,
    dst_topology);
    let v_ok : i32 =
    vx_plugin_transfer_device_to_host(d_v_dst, dst.value_cache, bytes,
    dst_topology);

    // Both staging buffers were ours; the caches they fed are the RunStates'.
    vx_plugin_free(d_k_src, src_topology);
    vx_plugin_free(d_v_src, src_topology);
    vx_plugin_free(d_k_dst, dst_topology);
    vx_plugin_free(d_v_dst, dst_topology);
  };
  return 0;
}

fn sample_argmax(probabilities : *mut f32, n : i32) -> i32 {
  let mut max_i : i32 = 0;
  let mut max_p : f32 = probabilities[0];
  for i in 1..n {
    let prob : f32 = probabilities[i];
    if prob > max_p {
      max_i = i;
      max_p = prob;
    }
  }
  return max_i;
}

fn rmsnorm(o : *mut f32, x : *mut f32, weight : *mut f32, size : i32,
size_f : f32) -> i32 {
  let mut ss : f32 = 0.0;
  for j in 0..size {
    let val : f32 = x[j];
    ss += val * val;
  }

  ss = ss / size_f + 0.00001;
  ss = 1.0 / ss.sqrt();

  for j in 0..size {
    let val : f32 = x[j];
    let w : f32 = weight[j];
    let temp : f32 = ss * val;
    o[j] = w * temp;
  }

  return 0;
}

fn softmax(x : *mut f32, size : i32) -> i32 {
  let mut max_val : f32 = x[0];
  for i in 1..size {
    let val : f32 = x[i];
    if val > max_val {
      max_val = val;
    }
  }

  let mut sum : f32 = 0.0;
  for i in 0..size {
    let val : f32 = x[i];
    let diff : f32 = val - max_val;
    x[i] = diff.exp();
    let exp_val : f32 = x[i];
    sum += exp_val;
  }

  for i in 0..size {
    let val : f32 = x[i];
    x[i] = val / sum;
  }
  return 0;
}

// W[d,n] @ x[n,1] -> xout[d,1], which is every projection in a decoder.
//
// Written as tensors rather than as a loop nest so the outlined region is a
// `linalg.matmul` the compiler can classify (#325) and a plugin can hand to
// cuBLAS. The loop-nest form computed the same numbers and was ineligible: a
// plugin saw an unrecognised kernel and ran it on the host, so a placed Llama
// stayed on the CPU no matter which device it named.
//
// Three things had to exist for this to be writable. The weights are `*mut f32`
// offsets into an mmap'd blob, so they become tensors through a view that
// copies nothing (#336). They are read once per token, so `@` had to be able to
// read an operand without consuming it (#335). And `xout` is the caller's
// buffer, which an assignment would rebind rather than fill (#319 Track A), so
// the result is written in place.
//
// `D` is the device this projection runs on. It is a const generic rather than
// a parameter because placement is a compile-time fact: `spawn on` has to name
// a device the compiler can resolve, and an index that arrives at runtime
// cannot select one -- it silently becomes device 0, which W1030 now says out
// loud (#345).
//
// So prefill and decode are one function body instantiated twice. `matmul<0>`
// and `matmul<1>` emit two kernels with identical `kind=matmul` and
// `roles=a:0,b:1,out:2` payloads differing only in `topo=500` against
// `topo=501`, and that difference is the whole of running the two phases on two
// devices (#347). One program text, one placement discipline, one index.
fn matmul<const D : i32>(xout : *mut f32, x : *mut f32, w : *mut f32, n : i32,
d : i32) -> i32 {
  let wt : Tensor<f32> = unsafe { tensor_view_2d(w, d, n) };
  let xt : Tensor<f32> = unsafe { tensor_view_2d(x, n, 1) };
  let mut yt : Tensor<f32> = unsafe { tensor_view_2d(xout, d, 1) };
  spawn on(Topology::GPU[D]) {
    matmul_into(&mut yt, &wt, &xt);
  }
  return 0;
}

fn main() -> i32 {
  unsafe {
    let config_ptr : *mut i32 =
    vx_load_config("tests/backend/pass/stories15M.bin");

    let dim_f : f32 = config_ptr[0] as f32;
    let hidden_dim_f : f32 = config_ptr[1] as f32;
    let n_layers_f : f32 = config_ptr[2] as f32;
    let n_heads_f : f32 = config_ptr[3] as f32;
    let n_kv_heads_f : f32 = config_ptr[4] as f32;
    let vocab_size_f : f32 = config_ptr[5] as f32;
    let seq_len_f : f32 = config_ptr[6] as f32;

    let llama_config : *mut i32 = vx_get_llama_config();
    let max_tokens : i32 = llama_config[0];
    let steps : i32 = llama_config[1];

    // Which device decodes. `VX_LLAMA_DISAGG=1` puts decode on GPU 1 and leaves
    // prefill on GPU 0; anything else keeps both on GPU 0.
    //
    // The two modes run the *same* code -- same handoff, same two RunStates,
    // same two weight replicas -- and differ only in whether the destination
    // index is 1 or 0. So the single-device run is the disaggregated program
    // with both indices equal, which is what makes it a usable oracle: if the
    // two modes disagree on a token, the difference is the second device and
    // nothing else. It also means the default run exercises the handoff, so a
    // broken transfer fails the existing parity test rather than waiting for a
    // pod.
    let disagg : i32 = llama_config[2];
    let mut decode_topology : i32 = 500;
    if disagg == 1 {
      decode_topology = 501;
    }

    let config = Config {
      dim : 288,
      hidden_dim : 768,
      n_layers : 6,
      n_heads : 6,
      n_kv_heads : 6,
      vocab_size : 32000,
      seq_len : max_tokens
    };

    let weights_ptr : *mut f32 =
    vx_load_weights("tests/backend/pass/stories15M.bin");

    // Two workers, each with the whole model in its own device's memory. The
    // second copy is not redundancy: prefill's GPU cannot read decode's HBM, so
    // a decode step that reached for the prefill replica's `wq` would be
    // dereferencing an address that is valid on another device.
    let prefill_weights = memory_map_weights(
    weights_ptr, config.dim, config.hidden_dim, config.n_layers,
    config.n_heads, config.n_kv_heads, config.seq_len, config.vocab_size, 500);
    let decode_weights = memory_map_weights(
    weights_ptr, config.dim, config.hidden_dim, config.n_layers,
    config.n_heads, config.n_kv_heads, config.seq_len, config.vocab_size,
    decode_topology);

    // Two RunStates, and specifically two KV caches. See `handoff_kv`: decode's
    // cache starts empty and is filled only by the transfer, which is what
    // makes the transfer provable rather than decorative.
    let prefill_state = malloc_run_state(
    config.dim, config.hidden_dim, config.n_layers, config.n_heads,
    config.n_kv_heads, config.seq_len, config.vocab_size);
    let decode_state = malloc_run_state(
    config.dim, config.hidden_dim, config.n_layers, config.n_heads,
    config.n_kv_heads, config.seq_len, config.vocab_size);

    let tokenizer_ptr
    : *mut i8 = vx_build_tokenizer("tests/backend/pass/tokenizer.bin",
    config.vocab_size);

    let prompt_str : *mut i8 =
    vx_read_prompt_file("tests/backend/pass/prompt.txt");
    let prompt_tokens : *mut i32 = vx_encode_prompt(tokenizer_ptr, prompt_str);
    let num_prompt_tokens : i32 = prompt_tokens[0];

    // Generation Loop! (Token 1 is BOS)
    let mut token : i32 = prompt_tokens[1]; // Usually BOS
    let mut pos : i32 = 0;

    // We'll generate max_tokens for testing to avoid slowing down cargo test
    let iterations : i32 = max_tokens / steps;

    // Where the phases divide. Prefill consumes the prompt, so it runs for as
    // many steps as it takes `pos` to reach the last prompt token; decode runs
    // the rest. This is the same boundary the original single-phase loop tested
    // for on every iteration -- it has only been lifted out, because a phase
    // boundary that a *placement* changes at has to be a boundary between
    // loops rather than a branch inside one.
    let prefill_span : i32 = num_prompt_tokens - 1 + steps - 1;
    let mut prefill_iterations : i32 = prefill_span / steps;
    if prefill_iterations > iterations {
      prefill_iterations = iterations;
    }

    // --- Prefill, on GPU 0 ---------------------------------------------------
    for step in 0..prefill_iterations {
      let logits : *mut f32 =
      transformer<0>(token, pos, &config, &prefill_state, &prefill_weights);

      // Take the next token from the prompt (shifted by 1: index 0 is the
      // length).
      let next_idx : i32 = pos + 2;
      let next : i32 = prompt_tokens[next_idx];

      let piece : *mut i8 = vx_decode_token(tokenizer_ptr, token, next);
      let print_status : i32 = print!(piece);

      token = next;
      pos += steps;
    }

    // --- The handoff ---------------------------------------------------------
    //
    // Everything prefill computed that decode needs is here: `n_layers` x
    // `seq_len` x `kv_dim` floats of keys and as many of values. Nothing else
    // crosses -- the weights are already on both devices, and the activations
    // are per-token scratch.
    let div_kv : i32 = config.dim * config.n_kv_heads;
    let kv_dim : i32 = div_kv / config.n_heads;
    let kv_elems : i64 = (config.n_layers * config.seq_len * kv_dim) as i64;
    let kv_bytes : i64 = kv_elems * 4;
    let moved : i32 =
    handoff_kv(&prefill_state, &decode_state, kv_bytes, 500, decode_topology);

    // The decode worker continues from prefill's last token, so it needs the
    // running activation too. `x` is rebuilt from the embedding table on every
    // step, so only the cache above is genuinely state.

    // --- Decode, on GPU 1 (or GPU 0 when not disaggregating) -----------------
    //
    // Two calls rather than one because `D` is a compile-time index: both
    // instantiations are emitted and the runtime picks which to enter. That is
    // the honest shape of a compile-time placement -- the choice of device is
    // made when the program is built, and what a flag can choose between is
    // which built placement runs.
    for step in prefill_iterations..iterations {
      let mut logits : *mut f32 = decode_state.logits;
      if disagg == 1 {
        logits =
        transformer<1>(token, pos, &config, &decode_state, &decode_weights);
      } else {
        logits =
        transformer<0>(token, pos, &config, &decode_state, &decode_weights);
      }

      let next : i32 = sample_argmax(logits, config.vocab_size);

      let piece : *mut i8 = vx_decode_token(tokenizer_ptr, token, next);
      let print_status : i32 = print!(piece);

      token = next;
      pos += steps;
    }
  };

  return 0;
}
// NO_EXEC
