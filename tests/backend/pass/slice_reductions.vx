//===----------------------------------------------------------------------===//
// S2 (docs/discussions/implementation_plans/slice_operators.md): slice reductions over the
// rank-1 row views from S1. `dot(a,b)`, `sum(a)`, `max(a)`, `min(a)` lower to `vector.load`
// (+ `arith.mulf` for dot) + `vector.reduction`, which the pipeline's convert-vector-to-llvm
// turns into `@llvm.intr.vector.reduce.*` -- SIMD by construction, not by hoping the
// autovectorizer recovers a scalar loop. The reductions *read* their operands (a zero-copy
// view), so a slice can feed several reductions and is not consumed.
//
// Correctness: `dot(a,b)` must equal the hand-written scalar reduction loop.
//   a = [1,2,3,4], b = [5,6,7,8]
//   dot = 1*5+2*6+3*7+4*8 = 70;  sum(a) = 10;  max(b) = 8;  min(a) = 1.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: vector.reduction

fn main() -> i32 {
  let mut q = Tensor<f32>([2, 4]);
  q[0][0] = 1.0; q[0][1] = 2.0; q[0][2] = 3.0; q[0][3] = 4.0;
  q[1][0] = 5.0; q[1][1] = 6.0; q[1][2] = 7.0; q[1][3] = 8.0;

  let a : Tensor<f32,[4]> = q[0];
  let b : Tensor<f32,[4]> = q[1];

  let d : f32 = dot(a, b);   // vectorized

  // Scalar-loop oracle for the same dot product.
  let mut d_scalar : f32 = 0.0;
  for k in 0..4 { d_scalar = d_scalar + q[0][k] * q[1][k]; }

  let mut o = Tensor<f32>([1, 5]);
  o[0][0] = d;
  o[0][1] = d_scalar;   // must equal o[0][0]
  o[0][2] = sum(a);
  o[0][3] = max(b);
  o[0][4] = min(a);
  print(o);
  return 0;
}

// EXPECT: [[70,   70,   10,   8,   1]]
