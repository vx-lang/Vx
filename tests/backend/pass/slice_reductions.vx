//===----------------------------------------------------------------------===//
// `dot`, `sum`, `max` and `min` from `std::tensor` on rows of a tensor, `q[0]` and `q[1]`
// copied into tensors of their own. The rows are only read, so one row can feed several of
// them. The dot product is checked against a loop written out by hand.
//   a = [1,2,3,4], b = [5,6,7,8]
//   a.dot(&b) = 1*5+2*6+3*7+4*8 = 70;  a.sum() = 10;  b.max() = 8;  a.min() = 1.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: vector.reduction
import std::tensor;

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::uninit();
  q[0][0] = 1.0; q[0][1] = 2.0; q[0][2] = 3.0; q[0][3] = 4.0;
  q[1][0] = 5.0; q[1][1] = 6.0; q[1][2] = 7.0; q[1][3] = 8.0;

  let a : Tensor<f32,[4]> = q[0];
  let b : Tensor<f32,[4]> = q[1];

  let d : f32 = a.dot(&b);

  // The same dot product, written out.
  let mut d_scalar : f32 = 0.0;
  for k in 0..4 {
    d_scalar = d_scalar + q[0][k] * q[1][k];
  }

  let mut o = Tensor<f32, [1, 5]>::uninit();
  o[0][0] = d;
  o[0][1] = d_scalar;   // must equal o[0][0]
  o[0][2] = a.sum();
  o[0][3] = b.max();
  o[0][4] = a.min();
  print(o);
  return 0;
}

// EXPECT: [[70,   70,   10,   8,   1]]
