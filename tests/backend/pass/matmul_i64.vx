// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @printMemrefI64(
// CHECK-LABEL: func.func @main() -> i32
//
// The result carries NPU_HBM's address space, because the return type says the tensor lives there.
// It used to be spelled `Ref<Tensor<..>, Memory::NPU_HBM>`, and the AST lowering of `Ref` dropped
// the space -- while a placement on the same tensor kept it, which is what
// tests/frontend/fail/gpu_address_spaces.vx pins. Folding the two spellings into one had to pick a
// side, and the type's word is the side worth keeping (Vx#429).
// CHECK: call @custom_matmul(%{{.*}}, %{{.*}}) : (memref<4x4xi64>, memref<4x4xi64>) -> memref<4x4xi64, 1>
// CHECK: call @printMemrefI64(%{{.*}}) : (memref<*xi64>) -> ()
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24]]

fn custom_matmul(a : Pinned<Tensor<i64, [ 4, 4 ]>, Topology::NPU[0]>,
b : Pinned<Tensor<i64, [ 4, 4 ]>, Topology::NPU[0]>)
-> Verified<Tensor<i64, [ 4, 4 ], Memory::NPU_HBM>> {
  let mut result = Tensor<i64, [4, 4], Memory::NPU_HBM>::uninit();
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        result[i][j] = 0;
        for k in 0..4 {
          result[i][j] = result[i][j] + a[i][k] * b[k][j];
        }
      }
    }
  }
  return Verified(result);
}

fn main() -> i32 {
  let mut a_host = Tensor<i64, [4, 4]>::uninit(); // Defaults to CPU_DRAM
  let mut b_host = Tensor<i64, [4, 4]>::uninit();

  for i in 0..4 {
    for j in 0..4 {
      a_host[i][j] = 2;
      b_host[i][j] = 3;
    }
  }

  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);

  let result = custom_matmul(a, b);
  print(&result);
  return 0;
}
// NO_EXEC
