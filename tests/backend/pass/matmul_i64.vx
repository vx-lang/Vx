// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// The externs this program pulls in are declared, and main calls them in order with the
// values threaded between them -- the dataflow the run below scores, stated in the IR.
// CHECK-DAG: func.func private @printMemrefI64(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @custom_matmul(%{{.*}}, %{{.*}}) : (memref<4x4xi64>, memref<4x4xi64>) -> memref<4x4xi64>
// CHECK: call @printMemrefI64(%{{.*}}) : (memref<*xi64>) -> ()
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24]]

fn custom_matmul(a : Pinned<Tensor<i64, [ 4, 4 ]>, Topology::NPU[0]>,
b : Pinned<Tensor<i64, [ 4, 4 ]>, Topology::NPU[0]>)
-> Verified<Ref<Tensor<i64, [ 4, 4 ]>, Memory::NPU_HBM>> {
  let mut result = Tensor<i64, [4, 4]>::uninit().with_memory(Memory::NPU_HBM);
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        result[i][j] = 0;
        for k in 0..4 {
          result[i][j] = result[i][j] + a[i][k] * b[k][j];
        }
      }
    }
  }
  return Verified(result);
}

fn main() -> i32 {
  let mut a_host = Tensor<i64, [4, 4]>::uninit(); // Defaults to CPU_DRAM
  let mut b_host = Tensor<i64, [4, 4]>::uninit();

  for i in 0..4 {
    for j in 0..4 {
      a_host[i][j] = 2;
      b_host[i][j] = 3;
    }
  }

  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);

  let result = custom_matmul(a, b);
  print(&result);
  return 0;
}
// NO_EXEC
