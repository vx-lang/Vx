//===----------------------------------------------------------------------===//
// `&v[i]` on a `Vec` of tensors is a reference to the tensor in the vector, which
// `Vec::get_ref` gives. A reference to a tensor shares the tensor's memory, so the function that
// takes it reads the elements that the vector holds. `VX_NO_AST_FALLBACK=1` makes the default
// code generator fail rather than give a function to the AST code generator.
//
// RUN: env VX_NO_AST_FALLBACK=1 vxc %s --run 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}first: 7, second: 8 9{{$}}

import std::vec;

fn first_value(t : &Tensor<i32, [?]>) -> i32 {
  return t[0];
}

fn main() -> i32 {
  let mut v = Vec<Tensor<i32, [?]>>::new();
  let mut h = Tensor<i32>([1]);
  h[0] = 7;
  v.push(h);
  let mut k = Tensor<i32>([2]);
  k[0] = 8;
  k[1] = 9;
  v.push(k);
  let second = v.get_ref(1);
  println!("first: {}, second: {} {}", first_value(&v[0]), second[0], second[1]);
  return 0;
}
