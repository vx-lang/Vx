// EXPECT: case 112 :*<3 -42i32 [-42]
// EXPECT: case 113 :#06b -42i32 [0b11111111111111111111111111010110]
// EXPECT: case 114 :#<10x -42i32 [ffffffd6##]
// EXPECT: case 115 :+^9 -42i32 [+++-42+++]
// EXPECT: case 116 :#08o -42i32 [0o37777777726]
// EXPECT: case 117 :8 255u8 [     255]
// EXPECT: case 118 :<8 255u8 [255     ]
// EXPECT: case 119 :^8 255u8 [  255   ]
// EXPECT: case 120 :^9 255u8 [   255   ]
// EXPECT: case 121 :*^9 255u8 [***255***]
// EXPECT: case 122 :-<7 255u8 [255----]
// EXPECT: case 123 :_>7 255u8 [____255]
// EXPECT: case 124 :+ 255u8 [+255]
