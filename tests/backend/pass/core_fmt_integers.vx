  // Four bytes of memory hold three bytes and the NUL.
  let small_mem = unsafe { malloc(4i64) };
  let mut small = unsafe { ByteBuf::new(small_mem, 4i64) };
  let refused : bool = (1234i32).fmt_decimal(&mut small, &FormatSpec::new()).is_err();
  if refused {
    print!("refused ");
  }
  print!("len ");
  print(small.len());
  print!(" last ");
  print(small.byte(2i64));
  print!(" ");
  show(&mut small, "full buffer");
  unsafe { free(small_mem); free(mem); }
  return 0;
