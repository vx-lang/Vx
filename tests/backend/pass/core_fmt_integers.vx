// EXPECT: case 155 :08b -128i8 [10000000]
// EXPECT: case 156 :#10b -128i8 [0b10000000]
// EXPECT: case 157 :^#12o -128i8 [   0o200    ]
// EXPECT: case 158 :^+#012X -128i8 [+0x000000080]
