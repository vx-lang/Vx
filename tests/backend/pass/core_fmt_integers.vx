// EXPECT: case 91 :+^9 42i32 [+++42++++]
// EXPECT: case 92 :#08o 42i32 [0o000052]
// EXPECT: case 93 :8 -42i32 [     -42]
// EXPECT: case 94 :<8 -42i32 [-42     ]
// EXPECT: case 95 :^8 -42i32 [  -42   ]
// EXPECT: case 96 :^9 -42i32 [   -42   ]
// EXPECT: case 97 :*^9 -42i32 [***-42***]
// EXPECT: case 98 :-<7 -42i32 [-42----]
// EXPECT: case 99 :_>7 -42i32 [____-42]
// EXPECT: case 100 :+ -42i32 [-42]
// EXPECT: case 101 :<+6 -42i32 [-42   ]
// EXPECT: case 102 :+08 -42i32 [-0000042]
// EXPECT: case 103 :08 -42i32 [-0000042]
// EXPECT: case 104 :02 -42i32 [-42]
// EXPECT: case 105 :#010x -42i32 [0xffffffd6]
// EXPECT: case 106 :#X -42i32 [0xFFFFFFD6]
// EXPECT: case 107 :08b -42i32 [11111111111111111111111111010110]
// EXPECT: case 108 :#10b -42i32 [0b11111111111111111111111111010110]
// EXPECT: case 109 :^#12o -42i32 [0o37777777726]
// EXPECT: case 110 :^+#012X -42i32 [+0x0FFFFFFD6]
