// EXPECT: case 163 :+^9 -128i8 [++-128+++]
// EXPECT: case 164 :#08o -128i8 [0o000200]
// EXPECT: write_c_str [hello, 42]
// EXPECT: refused len 3 last 51 full buffer [123]
import core::fmt;
import std::alloc;

/// Print the case's label and what the buffer holds, then empty the buffer.
fn show(b : &mut ByteBuf, label : *const i8) -> i32 {
  print!(label);
  print!(" [");
  print!(b.as_c_str());
  print!("] ");
  b.clear();
  return 0;
}

fn main() -> i32 {
  let mem = unsafe { malloc(128i64) };
  let mut b = unsafe { ByteBuf::new(mem, 128i64) };
  (0i8).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 0 : 0i8");
  (-127i8 - 1i8).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 1 : -128i8");
  (-127i8 - 1i8).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 2 :#x -128i8");
  (-127i8 - 1i8).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 3 :#b -128i8");
  (-127i8 - 1i8).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 4 :o -128i8");
  (127i8).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 5 : 127i8");
  (127i8).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 6 :#x 127i8");
  (127i8).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 7 :#b 127i8");
  (127i8).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 8 :o 127i8");
  (-1i8).fmt_hex(&mut b, &FormatSpec::new());
  show(&mut b, "case 9 :x -1i8");
  (-1i8).fmt_decimal(&mut b, &FormatSpec::new().sign_plus());
  show(&mut b, "case 10 :+ -1i8");
  (0i16).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 11 : 0i16");
  (-32767i16 - 1i16).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 12 : -32768i16");
  (-32767i16 - 1i16).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 13 :#x -32768i16");
  (-32767i16 - 1i16).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 14 :#b -32768i16");
  (-32767i16 - 1i16).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 15 :o -32768i16");
  (32767i16).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 16 : 32767i16");
  (32767i16).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 17 :#x 32767i16");
  (32767i16).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 18 :#b 32767i16");
  (32767i16).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 19 :o 32767i16");
  (-1i16).fmt_hex(&mut b, &FormatSpec::new());
  show(&mut b, "case 20 :x -1i16");
  (-1i16).fmt_decimal(&mut b, &FormatSpec::new().sign_plus());
  show(&mut b, "case 21 :+ -1i16");
  (0i32).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 22 : 0i32");
  (-2147483647i32 - 1i32).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 23 : -2147483648i32");
  (-2147483647i32 - 1i32).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 24 :#x -2147483648i32");
  (-2147483647i32 - 1i32).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 25 :#b -2147483648i32");
  (-2147483647i32 - 1i32).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 26 :o -2147483648i32");
  (2147483647i32).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 27 : 2147483647i32");
  (2147483647i32).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 28 :#x 2147483647i32");
  (2147483647i32).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 29 :#b 2147483647i32");
  (2147483647i32).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 30 :o 2147483647i32");
  (-1i32).fmt_hex(&mut b, &FormatSpec::new());
  show(&mut b, "case 31 :x -1i32");
  (-1i32).fmt_decimal(&mut b, &FormatSpec::new().sign_plus());
  show(&mut b, "case 32 :+ -1i32");
  (0i64).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 33 : 0i64");
  (-9223372036854775807i64 - 1i64).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 34 : -9223372036854775808i64");
  (-9223372036854775807i64 - 1i64).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 35 :#x -9223372036854775808i64");
  (-9223372036854775807i64 - 1i64).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 36 :#b -9223372036854775808i64");
  (-9223372036854775807i64 - 1i64).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 37 :o -9223372036854775808i64");
  (9223372036854775807i64).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 38 : 9223372036854775807i64");
  (9223372036854775807i64).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 39 :#x 9223372036854775807i64");
  (9223372036854775807i64).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 40 :#b 9223372036854775807i64");
  (9223372036854775807i64).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 41 :o 9223372036854775807i64");
  (-1i64).fmt_hex(&mut b, &FormatSpec::new());
  show(&mut b, "case 42 :x -1i64");
  (-1i64).fmt_decimal(&mut b, &FormatSpec::new().sign_plus());
  show(&mut b, "case 43 :+ -1i64");
  (0u8).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 44 : 0u8");
  (255u8).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 45 : 255u8");
  (255u8).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 46 :#x 255u8");
  (255u8).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 47 :#b 255u8");
  (255u8).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 48 :o 255u8");
  (0u16).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 49 : 0u16");
  (65535u16).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 50 : 65535u16");
  (65535u16).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 51 :#x 65535u16");
  (65535u16).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 52 :#b 65535u16");
  (65535u16).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 53 :o 65535u16");
  (0u32).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 54 : 0u32");
  (4294967295u32).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 55 : 4294967295u32");
  (4294967295u32).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 56 :#x 4294967295u32");
  (4294967295u32).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 57 :#b 4294967295u32");
  (4294967295u32).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 58 :o 4294967295u32");
  (0u64).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 59 : 0u64");
  (18446744073709551615u64).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 60 : 18446744073709551615u64");
  (18446744073709551615u64).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 61 :#x 18446744073709551615u64");
  (18446744073709551615u64).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 62 :#b 18446744073709551615u64");
  (18446744073709551615u64).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 63 :o 18446744073709551615u64");
  (0usize).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 64 : 0usize");
  (9223372036854775807usize).fmt_decimal(&mut b, &FormatSpec::new());
  show(&mut b, "case 65 : 9223372036854775807usize");
  (9223372036854775807usize).fmt_hex(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 66 :#x 9223372036854775807usize");
  (9223372036854775807usize).fmt_binary(&mut b, &FormatSpec::new().alternate());
  show(&mut b, "case 67 :#b 9223372036854775807usize");
  (9223372036854775807usize).fmt_octal(&mut b, &FormatSpec::new());
  show(&mut b, "case 68 :o 9223372036854775807usize");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().width(8i64));
  show(&mut b, "case 69 :8 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().align(Alignment::Left()).width(8i64));
  show(&mut b, "case 70 :<8 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().align(Alignment::Center()).width(8i64));
  show(&mut b, "case 71 :^8 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().align(Alignment::Center()).width(9i64));
  show(&mut b, "case 72 :^9 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().fill(42u8).align(Alignment::Center()).width(9i64));
  show(&mut b, "case 73 :*^9 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().fill(45u8).align(Alignment::Left()).width(7i64));
  show(&mut b, "case 74 :-<7 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().fill(95u8).align(Alignment::Right()).width(7i64));
  show(&mut b, "case 75 :_>7 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().sign_plus());
  show(&mut b, "case 76 :+ 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().align(Alignment::Left()).sign_plus().width(6i64));
  show(&mut b, "case 77 :<+6 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().sign_plus().zero_pad().width(8i64));
  show(&mut b, "case 78 :+08 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().zero_pad().width(8i64));
  show(&mut b, "case 79 :08 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().zero_pad().width(2i64));
  show(&mut b, "case 80 :02 42i32");
  (42i32).fmt_hex(&mut b, &FormatSpec::new().alternate().zero_pad().width(10i64));
  show(&mut b, "case 81 :#010x 42i32");
  (42i32).fmt_hex(&mut b, &FormatSpec::new().alternate().upper());
  show(&mut b, "case 82 :#X 42i32");
  (42i32).fmt_binary(&mut b, &FormatSpec::new().zero_pad().width(8i64));
  show(&mut b, "case 83 :08b 42i32");
  (42i32).fmt_binary(&mut b, &FormatSpec::new().alternate().width(10i64));
  show(&mut b, "case 84 :#10b 42i32");
  (42i32).fmt_octal(&mut b, &FormatSpec::new().align(Alignment::Center()).alternate().width(12i64));
  show(&mut b, "case 85 :^#12o 42i32");
  (42i32).fmt_hex(&mut b, &FormatSpec::new().align(Alignment::Center()).sign_plus().alternate().zero_pad().width(12i64).upper());
  show(&mut b, "case 86 :^+#012X 42i32");
  (42i32).fmt_hex(&mut b, &FormatSpec::new().sign_plus().alternate());
  show(&mut b, "case 87 :+#x 42i32");
  (42i32).fmt_decimal(&mut b, &FormatSpec::new().fill(42u8).align(Alignment::Left()).width(3i64));
  show(&mut b, "case 88 :*<3 42i32");
  (42i32).fmt_binary(&mut b, &FormatSpec::new().alternate().zero_pad().width(6i64));
  show(&mut b, "case 89 :#06b 42i32");
