// EXPECT: case 63 :o 18446744073709551615u64 [1777777777777777777777]
// EXPECT: case 64 : 0usize [0]
// EXPECT: case 65 : 9223372036854775807usize [9223372036854775807]
// EXPECT: case 66 :#x 9223372036854775807usize [0x7fffffffffffffff]
// EXPECT: case 67 :#b 9223372036854775807usize [0b111111111111111111111111111111111111111111111111111111111111111]
// EXPECT: case 68 :o 9223372036854775807usize [777777777777777777777]
