// EXPECT: case 139 :+^9 255u8 [+++255+++]
// EXPECT: case 140 :#08o 255u8 [0o000377]
// EXPECT: case 141 :8 -128i8 [    -128]
// EXPECT: case 142 :<8 -128i8 [-128    ]
// EXPECT: case 143 :^8 -128i8 [  -128  ]
// EXPECT: case 144 :^9 -128i8 [  -128   ]
// EXPECT: case 145 :*^9 -128i8 [**-128***]
// EXPECT: case 146 :-<7 -128i8 [-128---]
// EXPECT: case 147 :_>7 -128i8 [___-128]
// EXPECT: case 148 :+ -128i8 [-128]
// EXPECT: case 149 :<+6 -128i8 [-128  ]
// EXPECT: case 150 :+08 -128i8 [-0000128]
// EXPECT: case 151 :08 -128i8 [-0000128]
// EXPECT: case 152 :02 -128i8 [-128]
// EXPECT: case 153 :#010x -128i8 [0x00000080]
