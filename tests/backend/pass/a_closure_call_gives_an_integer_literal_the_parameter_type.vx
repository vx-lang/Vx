//===----------------------------------------------------------------------===//
// A literal given to a closure or a function pointer takes the type of the parameter, as it
// does in a direct call of a function. The first four calls pass `2` to an `i64` parameter, in
// a different way each. The last two pass a float literal and a closure literal.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}closure in a variable 3{{$}}
// CHECK: {{^}}closure in parentheses 13{{$}}
// CHECK: {{^}}closure value 102{{$}}
// CHECK: {{^}}function pointer 4{{$}}
// CHECK: {{^}}float literal 1.5{{$}}
// CHECK: {{^}}closure literal 5{{$}}

fn double(x : i64) -> i64 {
  return x * 2;
}

fn main() -> i32 {
  let add_one = | x : i64 | x + 1;
  println!("closure in a variable {}", add_one(2));
  let add_ten = | x : i64 | x + 11;
  println!("closure in parentheses {}", (add_ten)(2));
  let add_hundred = | x : i64 | -> i64 {
    x + 100
  } as | i64 | -> i64;
  println!("closure value {}", add_hundred(2));
  let f = double;
  println!("function pointer {}", f(2));
  let half = | x : f64 | x / 2.0;
  println!("float literal {}", half(3.0));
  let apply = | g : | i64 | -> i64, x : i64 | g(x);
  println!("closure literal {}", apply(| y : i64 | -> i64 {
    y + 1
  }, 4i64));
  return 0;
}
