// A reference to a reference variable (`rr : &mut &mut i32`). Writing `**rr = 10`
// changes `x` through `r`, so `x` prints 10. Both code generators run this file.
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_i32(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_i32(%{{.*}}) : (i32) -> i32
fn main() -> i32 {
  let mut x = 5;
  let mut r = &mut x;   // r  : &mut i32
  let rr = &mut r;  // rr : &mut &mut i32
  **rr = 10;        // mutate x through the pointer-to-pointer
  print(x);         // 10
  return 0;
}

// EXPECT: 10
