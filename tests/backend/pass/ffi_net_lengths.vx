// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s # flat-codegen
// Calls through each public std::net byte-count method keep u64 at the FFI boundary. Each
// call gives a status, and its count through the last pointer. Each method gives a `Result`.
// CHECK-DAG: func.func private @vx_tcp_stream_read(!llvm.ptr, !llvm.ptr, i64, !llvm.ptr) -> i32
// CHECK-DAG: func.func private @vx_tcp_stream_write(!llvm.ptr, !llvm.ptr, i64, !llvm.ptr) -> i32
// CHECK-DAG: func.func private @vx_udp_socket_recv(!llvm.ptr, !llvm.ptr, i64, !llvm.ptr) -> i32
// CHECK-DAG: func.func private @vx_udp_socket_send_to(!llvm.ptr, !llvm.ptr, i64, !llvm.ptr, !llvm.ptr) -> i32
// CHECK-LABEL: func.func @use_each_length(
// CHECK: call @TcpStream$read_raw(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, i64) -> !llvm.struct<(i32, i64)>
// CHECK: call @TcpStream$write_raw(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, i64) -> !llvm.struct<(i32, i64)>
// CHECK: call @UdpSocket$recv_raw(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, i64) -> !llvm.struct<(i32, i64)>
// CHECK: call @UdpSocket$send_to_raw(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, i64, !llvm.ptr) -> !llvm.struct<(i32, i64)>
import core::result;
import std::net;

// A `TcpStream` or a `UdpSocket` comes only from a call that opens one, so the calls are in a
// function that `main` does not call. Rust tests in tests/ffi_io_lengths.rs give the core null handles.
fn use_each_length(stream : &mut TcpStream, socket : &mut UdpSocket) -> bool {
  let mut byte : u8 = 0;
  let length : u64 = 1;
  unsafe {
    let read = (*stream).read_raw((&mut byte) as *mut u8, length);
    let write = (*stream).write_raw((&byte) as *const u8, length);
    let recv = (*socket).recv_raw((&mut byte) as *mut u8, length);
    let send = (*socket).send_to_raw((&byte) as *const u8, length, "127.0.0.1:0");
    return read.is_err() && write.is_err() && recv.is_err() && send.is_err();
  }
}

fn main() -> i32 {
  return 0;
}
