//===----------------------------------------------------------------------===//
// A `pub fn` is exported under its own name, so a shared library built from this program gives
// `add_one` to C. `increment` has no `pub`, so it stays hidden. `main` does not call `add_one`,
// but code outside the program can, so neither function gets the "never called" warning (W1002).
//
// RUN: vxc %s --emit-llvm 2>&1 | FileCheck %s --implicit-check-not=W1002
// RUN: vxc %s --emit-llvm --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=W1002
// EXPECT: 1

// CHECK-DAG: llvm.func @add_one({{.*}}) -> i32 {
// CHECK-DAG: llvm.func hidden @increment({{.*}}) -> i32 attributes {dso_local} {

pub fn add_one(x : i32) -> i32 {
  return increment(x);
}

fn increment(x : i32) -> i32 {
  return x + 1;
}

fn main() -> i32 {
  println!("{}", 1);
  return 0;
}
