//===----------------------------------------------------------------------===//
// `pkg` and `ws` are levels of visibility only before `fn`, `unsafe`, `extern` or `safe`. So a
// macro can still have either name, and a call of it can stand where an item goes.
// EXPECT: 3 4

macro_rules pkg {
  ($name : ident) => {
    fn $name() -> i32 {
      return 3;
    }
  };
}

macro_rules ws {
  ($name : ident) => {
    fn $name() -> i32 {
      return 4;
    }
  };
}

pkg!(three);
ws!(four);

fn main() -> i32 {
  print(three());
  print!(" ");
  print(four());
  return 0;
}
