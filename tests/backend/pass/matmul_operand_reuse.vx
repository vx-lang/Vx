//===----------------------------------------------------------------------===//
// A borrowed tensor can be an operand of `@` more than once (#335).
//
// `a @b` moves its operands, as a linear type system says it should: the value
// is used, and using it again is an error. What was missing was any way to say
// "read this without taking it". `&a @ &b` did not typecheck, and the stdlib
// `copy` is a copy-*into* rather than a duplication, so a tensor could be an
// operand of `@` exactly once in a program and no spelling changed that.
//
// That is enough for a test, which multiplies once, and never enough for a
// model, which reads every weight once per token. It is also why llama2.vx
// writes its matmuls as hand-written loops over `*mut f32` -- and therefore why
// none of its arithmetic is eligible for the GEMM routing in #325. The two
// facts look unrelated and are not: the model is not written in tensors because
// tensors could not express it.
//
// Borrowing rather than a non-consuming `@` keeps the discipline intact and
// visible: the moving form still moves, and a read says so at the call site.
// No copy is created, so none has to be elided later, and capacity admission
// still sees one tensor rather than two.
//
// Both cases below matter. The first is reuse at all; the second is reuse
// across two devices, which is what disaggregated inference is -- prefill and
// decode read the same weights on different GPUs. That case additionally needs
// `Topology::GPU` to carry a device index (#331).
//
// The expected numbers are the answer whichever backend computes them, as in
// gpu_matmul_roles.vx: the host loop nest and cuBLAS have to agree.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK-DAG: func.func private @print_f32(
// CHECK-DAG: func.func private @print_str(
// CHECK-LABEL: func.func @main() -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// CHECK: call @print_f32(%{{.*}}) : (f32) -> i32
// CHECK: call @print_str(%{{.*}}) : (!llvm.ptr) -> i32
// EXPECT: 19 22 43 50 19 50 19 50

fn main() -> i32 {
  let mut a = Tensor<f32, [2, 2]>::uninit();
  let mut b = Tensor<f32, [2, 2]>::uninit();
  for i in 0..2 {
    for j in 0..2 {
      a[i][j] = (i * 2 + j + 1) as f32;
      b[i][j] = (i * 2 + j + 5) as f32;
    }
  }

  // Unplaced, twice over: [[1,2],[3,4]] @ [[5,6],[7,8]] = [[19,22],[43,50]].
  let c = &a @ &b;
  let e = &a @ &b;
  print(c[0][0]);
  print!(" ");
  print(c[0][1]);
  print!(" ");
  print(e[1][0]);
  print!(" ");
  print(e[1][1]);
  print!(" ");

  // The same two tensors, read by kernels placed on two different GPUs.
  let mut p = Tensor<f32, [2, 2]>::uninit();
  let mut q = Tensor<f32, [2, 2]>::uninit();
  spawn on(Topology::GPU[0]) {
    p = &a @ &b;
  }
  spawn on(Topology::GPU[1]) {
    q = &a @ &b;
  }

  print(p[0][0]);
  print!(" ");
  print(p[1][1]);
  print!(" ");
  print(q[0][0]);
  print!(" ");
  print(q[1][1]);

  return 0;
}
