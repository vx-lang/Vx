// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24]]

fn custom_matmul(a: Pinned<Tensor<f64>, Topology::NPU[0]>, b: Pinned<Tensor<f64>, Topology::NPU[0]>) -> Verified<Tensor<f64>> {
  spawn on(Topology::NPU[0]) {
    let mut result = Tensor<f64>([4, 4]).with_memory(Memory::NPU_HBM);
    for i in 0..4 {
      for j in 0..4 {
        result[i][j] = 0.0;
        for k in 0..4 {
          result[i][j] = result[i][j] + a[i][k] * b[k][j];
        }
      }
    }
    return Verified(result);
  }
}

fn main() -> Verified<Tensor<f64>> {
  let mut a_host = Tensor<f64>([4, 4]); // Defaults to Host_DRAM
  let mut b_host = Tensor<f64>([4, 4]);

  for i in 0..4 {
    for j in 0..4 {
      a_host[i][j] = 2.0;
      b_host[i][j] = 3.0;
    }
  }

  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);

  let result = custom_matmul(a, b);
  print(&result);
  return result;
}
