//===----------------------------------------------------------------------===//
// The first task waits 0.2 seconds for a value that never comes. The second task runs during
// that wait, and reads whether the first task's wait ended.
//
// The second RUN line runs both tasks on one worker thread of the shared runtime. There the
// waiting task must park and give the thread to the second task. The timer of the runtime
// must then wake it at its time limit, or the program hangs.
//
// REQUIRES: flat-codegen
// Only because the older code generator cannot lower `Result<i64, RecvError>`: its two
// variants carry payloads of different kinds.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}the first task timed out: true{{$}}
// CHECK: {{^}}the second task ran during the wait: true{{$}}

import core::sync::atomic;
import std::sync::channel;

fn main() -> i32 {
  let (tx, rx) = channel<i64>(1);
  let wait_ended = AtomicI64::new(0);
  let timed_out = AtomicI64::new(0);
  let ran_during_the_wait = AtomicI64::new(0);
  tasks {
    spawn {
      let first_in = rx;
      match first_in.recv_for(0.2) {
        Result<i64, RecvError>::Ok(_v) => {}
        Result<i64, RecvError>::Err(e) => {
          match e {
            RecvError::TimedOut => {
              timed_out.store(1, AtomicOrdering::SeqCst);
            }
            _ => {}
          }
        }
      }
      wait_ended.store(1, AtomicOrdering::SeqCst);
    };
    spawn {
      if wait_ended.load(AtomicOrdering::SeqCst) == 0 {
        ran_during_the_wait.store(1, AtomicOrdering::SeqCst);
      }
    };
  };
  // The sender lives until here, so the channel never closes.
  let _keep = tx;
  println!("the first task timed out: {}", timed_out.load(AtomicOrdering::SeqCst) == 1);
  println!("the second task ran during the wait: {}", ran_during_the_wait.load(AtomicOrdering::SeqCst) == 1);
  return 0;
}
