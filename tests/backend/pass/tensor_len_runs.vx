//===----------------------------------------------------------------------===//
// `t.len()` on a tensor is the extent of the outermost axis, the same read as
// `t.extent(0)`, so `for i in 0..t.len() { t[i] }` visits exactly the
// positions `t[i]` accepts. It used to pass the checker and crash both
// backends. Run, not just emitted: the values are asserted on the flat path
// and on the AST oracle.
//
// The RUN lines name each path themselves, so the runner must not pin the
// oracle on both of them.
// REQUIRES: flat-codegen
// RUN: vxc %s --action run-jit
// RUN: vxc %s --action run-jit --legacy-codegen
import std::googletest;

// A run-time extent: the length is read off the descriptor, not folded.
fn build(n : i32) -> Tensor<f32, [?]> {
  let mut a = Tensor<f32>([n]);
  a[0] = 0.0;
  return a;
}

// Walks every position and hands back how many there were.
fn fill(t : &mut Tensor<f32, [?]>, v : f32) -> i32 {
  for i in 0..t.len() {
    t[i] = v + (i as f32);
  }
  return t.len();
}

fn main() -> i32 {
  let a = Tensor<f32, [4]>::uninit();
  expect_eq(a.len(), 4);

  // The outermost axis, not the element count.
  let m = Tensor<f32, [2, 3]>::uninit();
  expect_eq(m.len(), 2);
  expect_eq(m.extent(1), 3);

  let mut d = build(5);
  expect_eq(fill(&mut d, 10.0), 5);
  expect_eq(d[4], 14.0);
  return 0;
}
