//===----------------------------------------------------------------------===//
// A struct with a field whose type is in another module (`Duration`) goes in a `Vec`. The `Vec`
// gives each element the full size of the struct, so the values stay as they were pushed.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}10 20 30 40 50{{$}}
import core::time;
import std::vec;

struct Timed {
  id : u64,
  took : Duration,
}

fn timed(id : u64) -> Timed {
  return Timed {
    id : id, took : Duration::from_secs(id * 10)
  };
}

fn main() -> i32 {
  let mut v = Vec<Timed>::new();
  v.push(timed(1));
  v.push(timed(2));
  v.push(timed(3));
  v.push(timed(4));
  v.push(timed(5));
  println!("{} {} {} {} {}", v.get_ref(0).took.as_secs(), v.get_ref(1).took.as_secs(), v.get_ref(2).took.as_secs(), v.get_ref(3).took.as_secs(), v.get_ref(4).took.as_secs());
  return 0;
}
