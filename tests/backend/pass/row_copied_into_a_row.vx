// RUN: vxc %s 2>&1 | FileCheck %s
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s
//
// `p[0] = q[1]` copies the elements of `q`'s row into `p`'s: a later change to `q` does not
// reach `p`, and `p`'s other row is untouched. A row can be copied within one tensor too.

fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  let mut p = Tensor<f32, [2, 4]>::new();
  q[1][0] = 7.0;
  q[1][3] = 8.0;
  p[0] = q[1];
  q[1][0] = 9.0;
  print(p[0][0]);
  print!(" ");
  print(p[0][3]);
  print!(" ");
  print(p[1][0]);
  p[1] = p[0];
  print!(" ");
  print(p[1][3]);
  return 0;
}

// CHECK: 7 8 0 8
