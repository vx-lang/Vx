//===----------------------------------------------------------------------===//
// f64 `atan`, ported from LLVM libc's `atan` into `core::libm`, against LLVM libc itself
// (f475f085bf7b, built with FMA). It prints the bits of `x.atan()` (a NaN as 9221120237041090560)
// for special values and the edges of its ranges. LLVM libc has no 128-bit pass for `atan`, so the
// last bit can be off from the true value; the port gives the same bits; then hashes of 2^20 random
// bit patterns and of 2^20 random x from 2^-63 to 2^6 in size. The port also matched LLVM libc on
// 2^30 inputs of the second kind and 2^28 of the first.
//
// EXPECT: 0 9223372036854775808 4605249457297304856 13828621494152080664 4336966441157787648 13560338478012563456 1 4609753056924675352 4609753056924675352 13833125093779451160 9221120237041090560 9221120237041090560 4605249457297304856 4605249457297304856 4605249457297304857 13832750658958499252 4609753056924675352 4609753056924675352 4485585228861014015 4490088828488384511 16795354352107198826 12656209750585853094
import core::num;

fn bits(r : f64) -> u64 {
  if r != r {
    return 9221120237041090560u64;
  }
  return r.to_bits();
}

fn check(x : u64) -> i32 {
  print(bits(f64::from_bits(x).atan()));
  print!(" ");
  return 0;
}

/// x from 2^-63 to 2^6 in size, either sign.
fn ranged(s : u64) -> u64 {
  return (s & 9227875636482146303u64) | ((960u64 + ((s >> 52u64) & 2047u64) % 70u64) << 52u64);
}

fn next(s : u64) -> u64 {
  let a = s ^ (s << 13u64);
  let b = a ^ (a >> 7u64);
  return b ^ (b << 17u64);
}

fn hash(kind : i32, count : i32) -> u64 {
  let mut s : u64 = 88172645463325252u64;
  let mut h : u64 = 0u64;
  for i in 0..count {
    s = next(s);
    let mut a = s;
    if kind == 1 {
      a = ranged(s);
    }
    let r = f64::from_bits(a).atan();
    h = (h ^ bits(r)).wrapping_mul(1099511628211u64);
  }
  return h;
}

fn main() -> i32 {
  let _r0 = check(0u64);
  let _r1 = check(9223372036854775808u64);
  let _r2 = check(4607182418800017408u64);
  let _r3 = check(13830554455654793216u64);
  let _r4 = check(4336966441157787648u64);
  let _r5 = check(13560338478012563456u64);
  let _r6 = check(1u64);
  let _r7 = check(9218868437227405311u64);
  let _r8 = check(9218868437227405312u64);
  let _r9 = check(18442240474082181120u64);
  let _r10 = check(9221120237041090560u64);
  let _r11 = check(18444492273895866368u64);
  let _r12 = check(4607182418800017407u64);
  let _r13 = check(4607182418800017408u64);
  let _r14 = check(4607182418800017409u64);
  let _r15 = check(13846317054350589952u64);
  let _r16 = check(4845873199050653695u64);
  let _r17 = check(4845873199050653696u64);
  let _r18 = check(4485585228861014015u64);
  let _r19 = check(4490088828488384512u64);
  print(hash(0, 1048576));
  print!(" ");
  print(hash(1, 1048576));
  return 0;
}
