// A program of the book chapter on files, input and time (www/book/src/files-input-time.md):
// it builds a string, compares two strings and reads a number from text.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}hello, world has 12 bytes{{$}}
// CHECK: {{^}}equal: true{{$}}
// CHECK: {{^}}parsed 124{{$}}

// ANCHOR: program
import std::string;

fn main() -> i32 {
  let mut greeting = String::new();
  unsafe { greeting.push_c_str("hello, "); greeting.push_c_str("world"); }
  let size = greeting.len();
  println!("{} has {} bytes", greeting, size);
  let n : i32 = 42;
  let text = n.to_string();
  let same = unsafe { String::from_c_str("42") };
  println!("equal: {}", text == same);
  let parsed = unsafe { parse_int("123 apples") };
  println!("parsed {}", parsed + 1);
  return 0;
}
// ANCHOR_END: program
