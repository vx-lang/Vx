//===----------------------------------------------------------------------===//
// `p[0] = q[1]` copies row 1 of `q` into row 0 of `p`, element by element.
// `p[1] = v` copies a whole rank-1 tensor into a row the same way. Afterwards
// the rows are separate memory: writing `q[1][0]` again does not change `p`.
//
// The backend tests run every program on both code generators, and the legacy
// one used to fail to compile the copy.
//
// EXPECT: 7 9 3 4 7
fn main() -> i32 {
  let mut q = Tensor<f32, [2, 4]>::new();
  let mut p = Tensor<f32, [2, 4]>::new();
  let mut v = Tensor<f32, [4]>::new();
  q[1][0] = 7.0;
  q[1][3] = 9.0;
  v[0] = 3.0;
  v[2] = 4.0;
  p[0] = q[1];
  p[1] = v;
  q[1][0] = 1.0;
  print(p[0][0] as i32);
  print!(" ");
  print(p[0][3] as i32);
  print!(" ");
  print(p[1][0] as i32);
  print!(" ");
  print(p[1][2] as i32);
  print!(" ");
  print(p[0][0] as i32);
  return 0;
}
