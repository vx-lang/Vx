// RUN: vxc %s --emit-mlir -O0 2>&1 | FileCheck %s
// RUN: vxc %s --emit-mlir -X mlir=--pass-pipeline="builtin.module(convert-vx-to-standard)" | FileCheck %s --check-prefix=STD
// RUN: vxc %s --emit-llvm | FileCheck %s --check-prefix=LLVM
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
//
// EXEC_RUN: vxc %s | mlir-opt -convert-scf-to-cf
// -convert-func-to-llvm="use-bare-ptr-memref-call-conv=true"
// -expand-strided-metadata -finalize-memref-to-llvm -reconcile-unrealized-casts
// | mlir-translate -mlir-to-llvmir | llc -filetype=obj -o %t.o
// EXEC_RUN: clang %t.o -Ltarget/debug/build/*/out -lnpu_dispatch -o %t
// EXEC_RUN: %t | FileCheck %s --check-prefix=EXPECT

fn main() -> i32 {
  let mut q_host = Tensor<f32>([ 4, 4 ]);
  let mut k_host = Tensor<f32>([ 4, 4 ]);
  let mut v_host = Tensor<f32>([ 4, 4 ]);
  let mut k_t_host = Tensor<f32>([ 4, 4 ]);
  let mut score_host = Tensor<f32>([ 4, 4 ]);
  let mut att_host = Tensor<f32>([ 4, 4 ]);
  let mut result_host = Tensor<f32>([ 4, 4 ]);

  for i in 0..4 {
    for j in 0..4 {
      q_host[i][j] = 1.0;
      k_host[i][j] = 1.0;
      v_host[i][j] = 1.0;
      score_host[i][j] = 0.0;
      result_host[i][j] = 0.0;
    }
  }

  // CPU: Transpose K
  for i in 0..4 {
    for j in 0..4 {
      k_t_host[j][i] = k_host[i][j];
    }
  }

  let q = transfer(q_host, Memory::NPU_HBM);
  let k_t = transfer(k_t_host, Memory::NPU_HBM);
  let mut score = transfer(score_host, Memory::NPU_HBM);

  // ANE Phase 1: Q * K^T (Matmul 1)
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        for k in 0..4 {
          score[i][j] += q[i][k] * k_t[k][j];
        }
      }
    }
  }

  // Sync back to CPU (implicit in Vx upon access) for Softmax
  // Q=1.0, K=1.0 -> Q*K^T = 4.0 everywhere.
  // Softmax(4.0) over 4 elements = 0.25.
  for i in 0..4 {
    for j in 0..4 {
      // In a real kernel we'd compute score[i][j].exp() / sum
      att_host[i][j] = 0.25;
    }
  }

  let att = transfer(att_host, Memory::NPU_HBM);
  let v = transfer(v_host, Memory::NPU_HBM);
  let mut result = transfer(result_host, Memory::NPU_HBM);

  // ANE Phase 2: Att * V (Matmul 2)
  spawn on(Topology::NPU[0]) {
    for i in 0..4 {
      for j in 0..4 {
        for k in 0..4 {
          result[i][j] += att[i][k] * v[k][j];
        }
      }
    }
  }

  // Result: 0.25 * 4 * 1.0 = 1.0 everywhere.
  print(result);

  return 0;
}

// EXPECT: [Vx Dispatcher] Intercepted kernel dispatch: vx_npu_kernel_{{[0-9]+}} with 5 args
// EXPECT: --- EXECUTING ON APPLE NEURAL ENGINE ---
// EXPECT: Unranked Memref base@
// EXPECT: [Vx Dispatcher] Intercepted kernel dispatch: vx_npu_kernel_{{[0-9]+}} with 5 args
// EXPECT: --- EXECUTING ON APPLE NEURAL ENGINE ---
// EXPECT: Unranked Memref base@
// EXPECT: [[1,   1,   1,   1],
// EXPECT:  [1,   1,   1,   1],
// EXPECT:  [1,   1,   1,   1],
// EXPECT:  [1,   1,   1,   1]]

// The dispatch shape, which holds whether or not the ANE runtime is present: the two matmuls
// (Q dot K-transpose, then att dot V) each become their own NPU region, one per "Intercepted
// kernel dispatch" line below.
// CHECK-LABEL: func.func @main() -> i32 attributes {llvm.emit_c_interface} {
// CHECK: vx.spawn topology(100) {
// CHECK: arith.mulf
// CHECK: } {topology_name = "NPU[0]"}
// CHECK: vx.spawn topology(100) {
// CHECK: arith.mulf
// CHECK: } {topology_name = "NPU[0]"}

// convert-vx-to-standard outlines the region: the site becomes a vx.launch naming a vx.kernel
// that carries the topology, and the operands travel as memref descriptors.
// STD: vx.launch @[[K:[a-z0-9_]+]]({{.*}}) {topology = 100 : i32, vx.topology_name = "NPU[0]"}
// STD: vx.kernel @[[K]](100) :
// STD: vx.return

// vx-to-llvm replaces the launch with the vendor-neutral plugin call and a descriptor string
// carrying the kernel name, its topology id and the topology's name -- the ABI a worker reads.
// LLVM: llvm.func @vx_plugin_dispatch_async(!llvm.ptr, i64, !llvm.ptr, !llvm.ptr, i64) -> i64
// LLVM: llvm.mlir.global internal constant @[[K:[a-z0-9_]+]]_str("[[K]]\00topo=100\00toponame=NPU[0]\00")
// LLVM: llvm.call @vx_plugin_dispatch_async(
// LLVM: llvm.func @[[K]](
