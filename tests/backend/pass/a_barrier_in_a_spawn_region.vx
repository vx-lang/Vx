//===----------------------------------------------------------------------===//
// A `spawn` region fills a tile, calls `barrier()`, and then reads the tile in the other order.
// The region runs on one thread, so the compiler warns (W1033). Both code generators run it.
//
// RUN: vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: Warning[W1033]
// CHECK: {{^}}4 3 2 1{{$}}

fn main() -> i32 {
  let mut out = Tensor<f32, [4]>::new();
  spawn on(Topology::CPU) {
    let mut part = Tensor<f32, [4]>::new();
    for t in 0..4 {
      part[t] = (t as f32) + 1.0;
    }
    barrier();
    for t in 0..4 {
      out[t] = part[3 - t];
    }
  }
  println!("{} {} {} {}", out[0], out[1], out[2], out[3]);
  return 0;
}
