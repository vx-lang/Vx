//===----------------------------------------------------------------------===//
// `p[i]` on a struct reads through its `Index` impl, `*p.index(i)`, and `p[i] = x` writes
// through `IndexMut`, `*p.index_mut(i)`. The reference `index_mut` returns lives only for its
// statement, so `p` can be used again on the next line, and the value on the right is read
// before the place is written, as in Rust: `p[0] = p[0] + 5` reads `p[0]` and then writes it.
// `p` starts as (1, 2) and ends as (6, 30).
//
// EXPECT: 6 30

import core::ops;

struct Pair {
  a : i32,
  b : i32,
}

impl Index for Pair {
  type Output = i32;
  fn index(self : &Pair, i : i32) -> &i32 {
    if i == 0 {
      return &self.a;
    }
    return &self.b;
  }
}

impl IndexMut for Pair {
  type Output = i32;
  fn index_mut(self : &mut Pair, i : i32) -> &mut i32 {
    if i == 0 {
      return &mut self.a;
    }
    return &mut self.b;
  }
}

fn main() -> i32 {
  let mut p = Pair {
    a: 1, b: 2
  };
  p[1] = 30;
  p[0] = p[0] + 5;
  print(p[0]);
  print!(" ");
  print(p[1]);
  return 0;
}
