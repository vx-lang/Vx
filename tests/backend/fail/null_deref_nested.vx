// REQUIRES: linux
// On macOS the runtime has no crash handler for now, so it prints no report there.
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: LLVM_SYMBOLIZER_PATH= not vxc %s 2>&1 | FileCheck %s --check-prefix=NO-SYMBOLIZER

// The crash report names each function of the program, from the one that crashed to `main`. An
// empty `LLVM_SYMBOLIZER_PATH` turns the symbolizer off. The report then still numbers the frames.

// CHECK: Caught SIGSEGV: Segmentation Fault!
// CHECK-NEXT: Backtrace:
// CHECK-NEXT: #0 0x{{[0-9a-f]+}} in f5{{$| at}}
// CHECK-NEXT: #1 0x{{[0-9a-f]+}} in f4{{$| at}}
// CHECK-NEXT: #2 0x{{[0-9a-f]+}} in f3{{$| at}}
// CHECK-NEXT: #3 0x{{[0-9a-f]+}} in f2{{$| at}}
// CHECK-NEXT: #4 0x{{[0-9a-f]+}} in f1{{$| at}}
// CHECK-NEXT: #5 0x{{[0-9a-f]+}} in main{{$| at}}
// NO-SYMBOLIZER: Backtrace:
// NO-SYMBOLIZER-NEXT: #0 0x{{[0-9a-f]+}} in {{.*}}temp.out
// The runtime's own handler prints the SIGSEGV above, then aborts -- so what the
// JIT sees is the abort, named. This line used to read "exited with non-zero
// code: -1", which is what an exit status reports when the process was killed
// by a signal and there is no code to report: it read as though the program
// returned -1 and said nothing about a crash.
// CHECK: Program was killed by signal 6 (SIGABRT

import std::box;

fn f5(ptr: *mut i32) -> i32 {
  unsafe { let val = ptr[0]; print!(val); }
  return 0;
}

fn f4(ptr: *mut i32) -> i32 {
  return f5(ptr);
}

fn f3(ptr: *mut i32) -> i32 {
  return f4(ptr);
}

fn f2(ptr: *mut i32) -> i32 {
  return f3(ptr);
}

fn f1(ptr: *mut i32) -> i32 {
  return f2(ptr);
}

fn main() -> i32 {
  let mut ptr: *mut i32 = unsafe { 0 as *mut i32 };
  f1(ptr);
  return 0;
}
