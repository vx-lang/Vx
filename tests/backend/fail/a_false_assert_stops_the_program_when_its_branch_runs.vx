//===----------------------------------------------------------------------===//
// A false assert in a branch that runs only for some inputs compiles. When the branch runs, the
// assert stops the program. With no arguments, `argc` is 1, so the branch runs.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// CHECK: {{^}}argc is less than 5{{$}}
// CHECK-NOT: after

fn check(x : i32) -> i32 {
  if x < 5 {
    assert(false, "argc is less than 5");
  }
  return x;
}

fn main(argc : i32) -> i32 {
  println!("after {}", check(argc));
  return 0;
}
