//===----------------------------------------------------------------------===//
// A function that returns `i32` can end with `abort()`, with no `return` after it: the program
// stops there.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// CHECK: 1
// CHECK-NEXT: abort() called
// CHECK-NOT: after the abort
fn one_or_abort(x : i32) -> i32 {
  if x > 0 {
    return 1;
  }
  abort();
}

fn main() -> i32 {
  print(one_or_abort(1));
  println!("");
  print(one_or_abort(0));
  println!("after the abort");
  return 0;
}
