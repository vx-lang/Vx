// REQUIRES: linux
// On macOS the runtime has no crash handler for now, so it prints no report there.
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: Caught SIGSEGV
// CHECK: Backtrace:
import std::box;

fn main() -> i32 {
  let mut b = Box<i32>::new(42);
  unsafe {
    let ptr = b.ptr;
    // deref past the allocation
    let bad = ptr[100000000];
    print!(bad);
  }
  return 0;
}
