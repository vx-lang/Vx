//===- a_crash_report_names_a_function_that_ends_with_a_call.vx - Vx -*- Vx -*-===//
//
// Part of the Vx Project, under the Apache License v2.0 with LLVM Exceptions.
// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// `crash` never returns, so the call to it is the last instruction of `ends_with_a_call`. The
// return address of that call is the first byte after `ends_with_a_call`. The crash report must
// still name `ends_with_a_call` from the symbol table of the program, when no symbolizer runs.
//
// REQUIRES: linux
// On macOS the runtime has no crash handler for now, so it prints no report there.
// RUN: LLVM_SYMBOLIZER_PATH= not vxc %s 2>&1 | FileCheck %s
// CHECK: Backtrace:
// CHECK-NEXT: #0 0x{{[0-9a-f]+}} in crash {{.*}}temp.out(+0x{{[0-9a-f]+}}) [0x{{[0-9a-f]+}}]{{$}}
// CHECK-NEXT: #1 0x{{[0-9a-f]+}} in ends_with_a_call {{.*}}temp.out(+0x{{[0-9a-f]+}}) [0x{{[0-9a-f]+}}]{{$}}
// CHECK-NEXT: #2 0x{{[0-9a-f]+}} in main {{.*}}temp.out(+0x{{[0-9a-f]+}}) [0x{{[0-9a-f]+}}]{{$}}

fn crash(ptr : *mut i32) -> ! {
  unsafe { let val = ptr[0]; print!(val); }
  loop {}
}

fn ends_with_a_call(ptr : *mut i32) -> i32 {
  crash(ptr);
}

fn main() -> i32 {
  let ptr : *mut i32 = unsafe { 0 as *mut i32 };
  return ends_with_a_call(ptr);
}
