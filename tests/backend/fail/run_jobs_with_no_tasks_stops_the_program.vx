//===----------------------------------------------------------------------===//
// `run_jobs` with at most 0 tasks could never run a job, so it stops the program with a message,
// and does not return.
//
// RUN: not vxc %s --run 2>&1 | FileCheck %s --implicit-check-not="after run_jobs"
// RUN: not vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not="after run_jobs"
// CHECK: {{^}}run_jobs: the number of tasks must be at least 1{{$}}

import core::result;
import std::sync::jobs;
import std::vec;

fn double(_c : &i64, job : &i64) -> i64 {
  return *job * 2;
}

fn main() -> i32 {
  let mut numbers = Vec<i64>::new();
  numbers.push(1);
  let c : i64 = 0;
  let r = run_jobs(&numbers, 0, &c, double);
  println!("after run_jobs: {}", r.is_ok());
  return 0;
}
