//===----------------------------------------------------------------------===//
// `Vec::get` with an index inside the vector reads the element. With an index equal to the
// length, it prints the index and the length, and stops the program.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: 20
// CHECK: Vec: index 3 is out of bounds for length 3
// CHECK: panic: Vec: index out of bounds
// CHECK-NOT: after the failure
import std::vec;

fn main() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(10);
  v.push(20);
  v.push(30);
  print(v.get(1));
  println!("");
  print(v.get(3));
  println!("after the failure");
  return 0;
}
