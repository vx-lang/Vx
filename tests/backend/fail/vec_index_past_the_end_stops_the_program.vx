//===----------------------------------------------------------------------===//
// `Vec::get` with an index inside the vector reads the element. With an index equal to the
// length, it prints the index and the length to standard error, and stops the program. What the
// program printed before stays on standard output.
//
// RUN: not vxc %s 2>&1 >/dev/null | FileCheck %s --check-prefix=ERR
// RUN: not vxc %s 2>/dev/null | FileCheck %s --check-prefix=OUT
// ERR: Vec: index 3 is out of bounds for length 3
// ERR-NEXT: panic: Vec: index out of bounds
// ERR-NOT: after the failure
// OUT: 20
// OUT-NOT: out of bounds
// OUT-NOT: after the failure
import std::vec;

fn main() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(10);
  v.push(20);
  v.push(30);
  print(v.get(1));
  println!("");
  print(v.get(3));
  println!("after the failure");
  return 0;
}
