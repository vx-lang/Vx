//===----------------------------------------------------------------------===//
// A range index whose ends are not literal numbers, `q[i..i + 2]`, is refused with an error
// message on both code generators, instead of crashing the compiler. The legacy code
// generator refuses every range index.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// CHECK: a range index `q[a..b]` is not supported by the legacy code generator
fn main() -> i32 {
  let q = Tensor<f32, [4, 2]>::new();
  let i = 1;
  let r = q[i..i + 2];
  print(r[0][0] as i32);
  return 0;
}
