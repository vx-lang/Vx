// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc --legacy-codegen %s 2>&1 | FileCheck %s
//
// A byte of 128 or more is not a character by itself in UTF-8, so `push_ascii` stops the
// program before the string holds bytes that are not UTF-8.
import std::string;

fn main() -> i32 {
  let mut s = String::new();
  s.push_ascii(65u8);
  println!("{}", s);
  // CHECK: A
  // CHECK: String: push_ascii of a byte that is not ASCII
  s.push_ascii(200u8);
  println!("{}", s);
  return 0;
}
