//===----------------------------------------------------------------------===//
// `work` panics on job 3. The panic stops the program, as a panic in any task does. The message
// names the line of the panic and the task that `run_jobs` started, and `run_jobs` does not
// return, so the program prints nothing after it.
//
// RUN: not vxc %s --run 2>&1 | FileCheck %s --implicit-check-not="after run_jobs"
// RUN: not vxc %s --run --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not="after run_jobs"
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 not vxc %s --run 2>&1 | FileCheck %s --implicit-check-not="after run_jobs"

// CHECK: {{^}}panic: job 3 cannot be done{{$}}

import core::option;
import core::panic;
import std::sync::jobs;
import std::vec;

fn fails_on_three(_c : &i64, job : &i64) -> i64 {
  if *job == 3 {
    // CHECK-NEXT: {{^}}  at {{.*}}a_panic_in_a_job_of_run_jobs_stops_the_program.vx:[[@LINE+1]]{{$}}
    panic("job 3 cannot be done");
  }
  return *job * 2;
}

// CHECK-NEXT: {{^}}  in the task from the `spawn` at {{.*}}jobs.vx:{{[0-9]+}}{{$}}
// CHECK-NEXT: {{^}}Program was killed by signal 6

fn main() -> i32 {
  let mut numbers = Vec<i64>::new();
  for i in 1..9 {
    numbers.push(i64::from(i));
  }
  let c : i64 = 0;
  match run_jobs(&numbers, 3, &c, fails_on_three) {
    Result<Vec<i64>, RunJobsError>::Ok(r) => {
      println!("after run_jobs: {} results", r.len());
    }
    Result<Vec<i64>, RunJobsError>::Err(_e) => {
      println!("after run_jobs: no results");
    }
  }
  return 0;
}
