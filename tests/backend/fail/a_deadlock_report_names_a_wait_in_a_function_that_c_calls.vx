//===----------------------------------------------------------------------===//
// A task calls C's `qsort`, and `qsort` calls the Vx function `wait_for_ever`. That function
// waits on an atomic word that nothing sets. The main code waits for the end of the task. So
// each task waits, and the program stops with a deadlock report.
//
// A task that waits under a call from C stays on its thread, and does not park. The report must
// still see it, on both runtimes.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// RUN: env VX_TASK_RUNTIME=shared VX_TASK_WORKERS=1 not vxc %s 2>&1 | FileCheck %s --implicit-check-not=Error
// CHECK: {{^}}vx: deadlock: each task of the program waits, and nothing can wake one. The program stops.{{$}}
// CHECK-NEXT: {{^}}  the main code waits for the end of the task from the `spawn` at {{.*}}.vx:[[#SPAWN:]]{{$}}
// CHECK-NEXT: {{^}}  a task waits on an atomic word{{$}}
// CHECK-NEXT: {{^}}    in the task from the `spawn` at {{.*}}.vx:[[#SPAWN]]{{$}}

import core::sync::atomic;
import std::sync::wait;

extern "C" {
  fn calloc(n : i64, size : i64) -> *mut AtomicI64;
  fn free(p : *mut AtomicI64) -> void;
  fn qsort(base : *mut AtomicI64, n : i64, size : i64, compare : fn(*const AtomicI64, *const AtomicI64) -> i32) -> void;
}

// Waits while the word at `a` is 0.
fn wait_for_ever(a : *const AtomicI64, _b : *const AtomicI64) -> i32 {
  unsafe { wait_while(&*a, 0); }
  return 0;
}

fn main() -> i32 {
  tasks {
    spawn {
      unsafe { let v = calloc(2, 8); qsort(v, 2, 8, wait_for_ever); free(v); }
    };
  };
  return 0;
}
