//===----------------------------------------------------------------------===//
// A program that waits for a socket is not stuck, because data can come. So the deadlock report
// waits while the I/O poller has a socket on its list. A `select` on a listener puts the
// listener on that list, and must take it off when it returns.
//
// Here `select2` waits on a listener and a channel, and returns for the channel. Then the main
// code waits in `recv` on a channel that only it can send on. The report must come.
//
// The port number is fixed, because `std::net` cannot give the port of a listener yet.
//
// RUN: not vxc %s --run 2>&1 | FileCheck %s
// RUN: not vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
// RUN: env VX_TASK_RUNTIME=shared not vxc %s --run 2>&1 | FileCheck %s

// CHECK: {{^}}select2 gave 1{{$}}
// CHECK-NEXT: vx: deadlock: each task of the program waits, and nothing can wake one. The program stops.
// CHECK-NEXT: {{^}}  the main code waits in `recv` at {{.*}}.vx:55 on channel 1, made at {{.*}}.vx:54{{$}}

import core::result;
import core::time;
import std::net;
import std::string;
import std::sync::channel;
import std::sync::select;
import std::time;

fn send_later(tx : Sender<i64>) -> void {
  sleep(Duration::from_millis(100));
  let _sent = tx.send(1);
}

fn wait(listener : TcpListener) -> void {
  let l = listener;
  let (tx, rx) = channel<i64>(1);
  tasks {
    spawn {
      send_later(tx);
    };
    match select2(&l, &rx) {
      Result<i32, SelectError>::Ok(i) => {
        println!("select2 gave {}", i);
      }
      Result<i32, SelectError>::Err(_) => {
        println!("select2 gave Cancelled");
      }
    }
  };
  let (_tx, never) = channel<i64>(1);
  let _v = never.recv();
}

fn main() -> i32 {
  match TcpListener::bind(unsafe { &String::from_c_str("127.0.0.1:41786") }) {
    Result<TcpListener, NetError>::Ok(listener) => {
      wait(listener);
    }
    Result<TcpListener, NetError>::Err(_e) => {
      println!("bind: Error");
    }
  }
  return 0;
}
