//===----------------------------------------------------------------------===//
// A `spawn` that gives back a value gets no PTX kernel: the value goes through a
// slot on the host stack, which a GPU cannot write. So the region runs on the
// host, and it reads `d`, which is in HBM, declared `managed: explicit`. The
// host cannot read that memory, so the compiler refuses the program. The error
// names the topology as the program wrote it.
//
// RUN: not vxc %s --host default --machine fleet/h100-sxm.vx --action emit-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: this region is placed on `Topology::Device`, but the compiler cannot emit a device kernel for it and its operands are in 'HBM'

fn main() -> i32 {
  let h = Tensor<f32, [4]>::fill(2.0);
  let d = transfer(h, Memory::HBM);
  let s = spawn on(Topology::Device) {
    let mut acc = 0.0;
    for i in 0..4 {
      acc = acc + d[i];
    }
    acc
  };
  print(s);
  return 0;
}
