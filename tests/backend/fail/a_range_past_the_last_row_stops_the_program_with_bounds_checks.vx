//===----------------------------------------------------------------------===//
// `v` is a view of the first 4 rows of an `[8, 3]` buffer, and its type does not say how many
// rows it has. The first range, `q[1..3]`, is inside `v`. The second, `q[3..6]`, goes past its
// last row.
//
// With `-fbounds-checks`, the second range stops the program with an error, at -O0 and at -O2.
// Without the flag, it reads the buffer after the view, so `r[2][2]` is `buf[5][2]`, which is 1.
//
// RUN: not vxc %s -fbounds-checks 2>&1 | FileCheck %s --check-prefix=CHECKED
// RUN: not vxc %s -fbounds-checks -O2 2>&1 | FileCheck %s --check-prefix=CHECKED
// RUN: vxc %s 2>&1 | FileCheck %s --check-prefix=UNCHECKED
//
// CHECKED: {{^}}rows 1 to 2: 1{{$}}
// CHECKED-NEXT: {{^}}index out of bounds: an index is outside the shape of the tensor{{$}}
// CHECKED-NOT: rows 3 to 5
//
// UNCHECKED: {{^}}rows 1 to 2: 1{{$}}
// UNCHECKED-NEXT: {{^}}rows 3 to 5: 1{{$}}

fn inside(q : &Tensor<f32, [?, 3]>) -> f32 {
  let r = q[1..3];
  return r[1][2];
}

fn past_the_end(q : &Tensor<f32, [?, 3]>) -> f32 {
  let r = q[3..6];
  return r[2][2];
}

fn main() -> i32 {
  let mut buf = Tensor<f32, [8, 3]>::fill(0.0);
  buf[2][2] = 1.0;
  buf[5][2] = 1.0;
  let v : Tensor<f32, [?, 3]> = unsafe {
    tensor_view_2d(buf.as_mut_ptr(), 4, 3)
  };
  let a = inside(&v);
  println!("rows 1 to 2: {}", a);
  let b = past_the_end(&v);
  println!("rows 3 to 5: {}", b);
  return 0;
}
