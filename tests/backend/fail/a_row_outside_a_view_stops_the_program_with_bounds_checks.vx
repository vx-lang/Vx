//===----------------------------------------------------------------------===//
// A function writes rows of an `[8, 64]` view of a larger buffer. The first call writes the 8 rows
// of the view. The second call writes 512 rows, past the end of the view.
//
// With `-fbounds-checks`, the second call stops the program with an error, on both code
// generators and at -O2. Without the flag, it writes into the buffer after the view, so
// `buf[8][0]` changes to 1.
//
// RUN: not vxc %s -fbounds-checks 2>&1 | FileCheck %s --check-prefix=CHECKED
// RUN: not vxc %s -fbounds-checks --legacy-codegen 2>&1 | FileCheck %s --check-prefix=CHECKED
// RUN: not vxc %s -fbounds-checks -O2 2>&1 | FileCheck %s --check-prefix=CHECKED
// RUN: vxc %s 2>&1 | FileCheck %s --check-prefix=UNCHECKED
//
// CHECKED: {{^}}8 rows: 1 0{{$}}
// CHECKED-NEXT: {{^}}index out of bounds: an index is outside the shape of the tensor{{$}}
// CHECKED-NOT: 512 rows
//
// UNCHECKED: {{^}}8 rows: 1 0{{$}}
// UNCHECKED-NEXT: {{^}}512 rows: 1 1{{$}}

fn fill_rows(out : &mut Tensor<f32, [?, ?]>, rows : i64) -> void {
  for i in 0..rows {
    out[i][0] = 1.0;
  }
}

fn main() -> i32 {
  let mut buf = Tensor<f32, [600, 64]>::fill(0.0);
  let mut v : Tensor<f32, [?, ?]> = unsafe {
    tensor_view_2d(buf.as_mut_ptr(), 8, 64)
  };
  fill_rows(&mut v, 8);
  println!("8 rows: {} {}", buf[7][0], buf[8][0]);
  fill_rows(&mut v, 512);
  println!("512 rows: {} {}", buf[7][0], buf[8][0]);
  return 0;
}
