//===----------------------------------------------------------------------===//
// A `panic` writes `panic: <message>` and a newline to standard error, and nothing to standard
// output. The program's own output stays on standard output. Nothing follows the panic's line
// before the report that the program stopped.
//
// RUN: not vxc %s 2>&1 >/dev/null | FileCheck %s --check-prefix=ERR
// RUN: not vxc %s --legacy-codegen 2>&1 >/dev/null | FileCheck %s --check-prefix=ERR
// RUN: not vxc %s 2>/dev/null | FileCheck %s --check-prefix=OUT
// ERR: panic: stop here
// ERR-NEXT: Program was killed by signal 6
// ERR-NOT: before the panic
// OUT: before the panic
// OUT-NOT: panic:
// OUT-NOT: after the panic

fn main() -> i32 {
  println!("before the panic");
  panic("stop here");
  println!("after the panic");
  return 0;
}
