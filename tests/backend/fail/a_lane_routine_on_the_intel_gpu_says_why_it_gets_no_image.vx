//===----------------------------------------------------------------------===//
// A region for the Intel GPU calls `lanes::sum`, which a SPIR-V image cannot
// run yet. Its tensors are in the memory of the card, which the host cannot
// read, so the region cannot run on the host either. The error says why the
// region gets no image.
//
// RUN: not vxc %s --machine fleet/arc-a770.vx --host default --action emit-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: this region is placed on `Topology::Device`, but the compiler cannot emit a device kernel for it
// CHECK: A `spirv64` device image cannot hold it: it calls a routine of `lanes::`

fn main() -> i32 {
  let m = Tensor<f32, [4, 64]>::fill(1.0);
  let rows = transfer(m, Memory::HBM);
  let mut sums = transfer(Tensor<f32, [4]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..4 across blocks {
      let mut part = unsafe { Tensor<f32, [64], Memory::SMEM>::uninit() };
      for t in 0..64 across lanes {
        part[t] = rows[b][t];
      }
      let s = lanes::sum(&part, 64);
      sums[b] = s;
    }
  }
  let back = transfer(sums, Memory::CPU_DRAM);
  println!("{}", back[0]);
  return 0;
}
