//===----------------------------------------------------------------------===//
// A region with `grid([..]) block(n)` runs only on a GPU. This one prints, which the GPU code
// generator cannot take, so the compile fails. A region with no launch shape would run on the
// CPU instead.
//
// REQUIRES: flat-codegen
// RUN: not vxc %s --host default --emit-llvm 2>&1 | FileCheck %s
// CHECK: a GPU region with `grid([..]) block(n)` cannot run on the GPU, because the GPU code generator cannot take the call of 'print_i32'

Memory HBM {
  capacity: 40 GiB, bandwidth: 1555 GB/s, managed: explicit, scope: device
}
Topology Gpu {
  arch: nvptx64,
  memory: Memory::HBM,
  visible: [Memory::CPU_DRAM, Memory::HBM],
  transfer Memory::CPU_DRAM -> Memory::HBM : 31.5 GB/s
}

pub fn show(n: i32) -> void {
  spawn on(Topology::Gpu) grid([n]) block(1) {
    print(grid_index(0));
  }
  return;
}
