//===----------------------------------------------------------------------===//
// `panic(msg)` prints `panic: ` and the message, then stops the program. The message here is a
// parameter, not a literal. `check_positive` ends with the `panic`, with no `return` after it.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// CHECK: 5
// CHECK-NEXT: panic: minus one is not positive
// CHECK-NOT: after the panic
fn check_positive(x : i32, msg : *const i8) -> i32 {
  if x > 0 {
    return x;
  }
  panic(msg);
}

fn main() -> i32 {
  print(check_positive(5, "five is positive"));
  println!("");
  print(check_positive(-1, "minus one is not positive"));
  println!("after the panic");
  return 0;
}
