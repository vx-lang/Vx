// RUN: not vxc %s | FileCheck %s
// A wild raw-pointer read is caught by the runtime crash handler. The exact
// signal (SIGSEGV vs SIGBUS) depends on where the out-of-range address lands, so
// match the invariant: a fatal memory-access signal is caught and backtraced.
// CHECK: Caught
// CHECK: Backtrace:
import std::vec;

fn main() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(1);
  v.push(2);
  unsafe { let ptr = v.as_mut_ptr(); let bad = ptr[100000000]; print!(bad); }
  return 0;
}
