//===----------------------------------------------------------------------===//
// The main code waits in `select4` on two channels, a `Semaphore` with no permit, and the first
// channel again. It holds the `Sender` of each channel itself. A task waits in `acquire` on the
// same `Semaphore`. The report names each source of the `select4` once, with the line that made
// it, in the order of the call. The `Semaphore` has one number in the line of the `select4` and
// in the line of the `acquire`. The list of channels says that a `select` watches each one.
//
// RUN: not vxc %s --run 2>&1 | FileCheck %s
// RUN: not vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
// RUN: env VX_TASK_RUNTIME=shared not vxc %s --run 2>&1 | FileCheck %s

// CHECK: vx: deadlock: each task of the program waits, and nothing can wake one. The program stops.
// CHECK-NEXT: {{^}}  the main code waits in `select` at {{.*}}.vx:37 on channel 1, made at {{.*}}.vx:48, on channel 2, made at {{.*}}.vx:49, and on semaphore 1, made at {{.*}}.vx:50{{$}}
// CHECK-NEXT: {{^}}  a task waits in `acquire` at {{.*}}.vx:32 on semaphore 1, made at {{.*}}.vx:50{{$}}
// CHECK-NEXT: {{^}}    in the task from the `spawn` at {{.*}}.vx:52{{$}}
// CHECK-NEXT: {{^}}  the channels of these waits:{{$}}
// CHECK-NEXT: {{^}}    channel 1, made at {{.*}}.vx:48: 0 waits in `recv` and 0 in `send`. 1 `select` watches it. 1 `Sender` is not dropped.{{$}}
// CHECK-NEXT: {{^}}    channel 2, made at {{.*}}.vx:49: 0 waits in `recv` and 0 in `send`. 1 `select` watches it. 1 `Sender` is not dropped.{{$}}

import core::mem;
import std::sync::channel;
import std::sync::select;
import std::sync::semaphore;

fn take_a_permit(s : &Semaphore) -> void {
  let permit = s.acquire();
  drop(permit);
}

fn wait_on(numbers : &Receiver<i64>, flags : &Receiver<bool>, s : &Semaphore) -> void {
  match select4(numbers, flags, s, numbers) {
    Result<i32, SelectError>::Ok(i) => {
      println!("select4 gave {}", i);
    }
    Result<i32, SelectError>::Err(_) => {
      println!("select4 gave Cancelled");
    }
  }
}

fn main() -> i32 {
  let (numbers_tx, numbers) = channel<i64>(1);
  let (flags_tx, flags) = channel<bool>(1);
  let s = Semaphore::new(0);
  tasks {
    spawn {
      take_a_permit(&s);
    };
    wait_on(&numbers, &flags, &s);
  };
  drop(numbers_tx);
  drop(flags_tx);
  return 0;
}
