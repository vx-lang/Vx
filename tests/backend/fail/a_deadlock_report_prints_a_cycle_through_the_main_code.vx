//===----------------------------------------------------------------------===//
// The main code holds a lock, and at the end of the `tasks` block it waits for the end of the
// task. The task waits for the lock. The report names the main code as the holder of the lock,
// and prints the cycle through the join.
//
// RUN: not vxc %s --run 2>&1 | FileCheck %s
// RUN: not vxc %s --run --legacy-codegen 2>&1 | FileCheck %s
// RUN: env VX_TASK_RUNTIME=shared not vxc %s --run 2>&1 | FileCheck %s

// CHECK: vx: deadlock: each task of the program waits, and nothing can wake one. The program stops.
// CHECK-NEXT: {{^}}  the main code waits for the end of the task from the `spawn` at {{.*}}.vx:31{{$}}
// CHECK-NEXT: {{^}}  a task waits in `lock` at {{.*}}.vx:32 on lock 1, made at {{.*}}.vx:28, held by the main code{{$}}
// CHECK-NEXT: {{^}}    in the task from the `spawn` at {{.*}}.vx:31{{$}}
// CHECK-NEXT: {{^}}  the waits form a cycle:{{$}}
// CHECK-NEXT: {{^}}    the main code waits for the end of the task from the `spawn` at {{.*}}.vx:31{{$}}
// CHECK-NEXT: {{^}}    the task from the `spawn` at {{.*}}.vx:31 waits in `lock` at {{.*}}.vx:32 on lock 1, made at {{.*}}.vx:28, held by the main code{{$}}
// CHECK-NEXT: {{^}}Program was killed by signal 6

import std::sync::mutex;

fn main() -> i32 {
  let m = Mutex<i64>::new(0);
  let _g = m.lock();
  tasks {
    spawn {
      let _g2 = m.lock();
    };
  };
  return 0;
}
