//===----------------------------------------------------------------------===//
// `v[i].n = x` checks the index, as `v[i]` does. With an index equal to the length, it prints the
// index and the length to standard error, and stops the program.
//
// RUN: not vxc %s 2>&1 >/dev/null | FileCheck %s --check-prefix=ERR
// RUN: not vxc %s --legacy-codegen 2>&1 >/dev/null | FileCheck %s --check-prefix=ERR
// RUN: not vxc %s 2>/dev/null | FileCheck %s --check-prefix=OUT
// ERR: Vec: index 1 is out of bounds for length 1
// ERR-NEXT: panic: Vec: index out of bounds
// OUT: {{^}}5{{$}}
// OUT-NOT: after the failure
import std::vec;

struct Slot {
  n : i32,
}

fn main() -> i32 {
  let mut v = Vec<Slot>::new();
  v.push(Slot {
    n : 0
  });
  v[0].n = 5;
  println!("{}", v[0].n);
  v[1].n = 6;
  println!("after the failure");
  return 0;
}
