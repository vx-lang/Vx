//===----------------------------------------------------------------------===//
// The program calls code at an address outside every loaded image, so it faults with that
// address as its program counter. The handler of the runtime must print its message, and the
// program must end. On macOS, the unwinder of Rust used to loop on such an address, so the program
// ran at 100% CPU and printed nothing.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --implicit-check-not="after the jump"
// CHECK: {{^}}before the jump{{$}}
// CHECK: {{^}}Caught SIGSEGV: Segmentation Fault!{{$}}
// CHECK: Program was killed by signal

// Calls the code at `address`.
fn jump_to(address : i64) -> i32 {
  return mlir!( inputs : (%a = address : i64), returns : i32, dialects : ["llvm"]) {
    %p = llvm.inttoptr %a : i64 to !llvm.ptr
    %r = llvm.call %p() : !llvm.ptr, () -> i32
    macro.yield %r : i32
  };
}

fn main() -> i32 {
  println!("before the jump");
  let r = jump_to(2802867276);
  println!("after the jump: {}", r);
  return 0;
}
