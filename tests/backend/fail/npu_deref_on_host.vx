//===- npu_deref_on_host.vx - Vx Compiler ------------------------*- Vx -*-===//
// CHECK: E3001{{.*}}'t_device' is declared Tensor<f32, [?, ?]> but its initializer is Tensor<f32, [1, 1], NPU, NPUHBM>
//
// Part of the Vx Project, under the Apache License v2.0 with LLVM Exceptions.
// See LICENSE for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
// RUN: not vxc %s 2>&1 | FileCheck %s

// Expect execution trap/segfault when trying to run an NPU execution block on
// host JIT The goal is to expose that our compiler JIT backend does not yet
// sandbox NPU pointers, allowing undefined behavior.
fn strip_pin_and_deref(t : Tensor<f32, [?, ?]>) -> Tensor<f32, [?, ?]> {
  unsafe {
    let ptr : *const Tensor<f32, [?, ?]> = t.as_ptr();
    let val : Tensor<f32, [?, ?]> = *ptr; // Dereferencing an NPU pointer on CPU!
  }
  return t;
}

fn main() -> Tensor<f32, [?, ?]> {
  let t_host = Tensor([ 1, 1 ]);
  let t_device : Tensor<f32, [?, ?]> = t_host.to_device();

  // Pass the NPU tensor to a Host function to strip the Pinned wrapper
  let result = strip_pin_and_deref(t_device);

  return result;
}
