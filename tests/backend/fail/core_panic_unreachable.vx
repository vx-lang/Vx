//===----------------------------------------------------------------------===//
// `unreachable()` from `core::panic` stops the program with its message. `pick` ends with the call and
// needs no `return` after it.
//
// The first run also checks that the flat code generator, the default, compiled the program
// rather than handing it to the AST code generator.
//
// RUN: not vxc %s 2>&1 | FileCheck %s --check-prefixes=FLAT,CHECK
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// FLAT: [flat-codegen] emitted module via the flat path
// CHECK: 1
// CHECK-NEXT: panic: internal error: entered unreachable code
// CHECK-NOT: after the panic
import core::panic;

fn pick(x : i32) -> i32 {
  if x > 0 {
    return 1;
  }
  unreachable();
}

fn main() -> i32 {
  print(pick(5));
  println!("");
  print(pick(0));
  println!("after the panic");
  return 0;
}
