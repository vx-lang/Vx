// #210: `main`'s `return <expr>` is honored -- its i32 value becomes the process
// exit code (previously main always exited 0). Lives under backend/fail because
// the JIT driver treats a non-zero exit as a failing run; here that non-zero
// code IS the point, and FileCheck confirms it is exactly the returned value.
// RUN: not vxc %s | FileCheck %s
// CHECK: Program exited with code: 42
fn main() -> i32 {
  return 40 + 2;
}
