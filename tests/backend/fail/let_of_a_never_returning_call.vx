//===----------------------------------------------------------------------===//
// `let z : i32 = todo();` compiles, and stops the program where the `let` is.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// CHECK: before
// CHECK-NEXT: panic: not yet implemented
// CHECK-NOT: after the panic
import core::panic;

fn main() -> i32 {
  println!("before");
  let z : i32 = todo();
  println!("after the panic");
  return z;
}
