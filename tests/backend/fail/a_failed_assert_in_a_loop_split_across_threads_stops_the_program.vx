//===----------------------------------------------------------------------===//
// The passes of the loop run at the same time. Passes 41 to 63 fail the assert. The program
// stops with the message of the assert and its line, and does not print its result.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --check-prefix=SPLIT
// RUN: vxc %s --legacy-codegen --action emit-mlir 2>&1 | FileCheck %s --check-prefix=SPLIT
// SPLIT: vx_parallel_trip = 64
//
// The kernel runs on this machine's CPU, split across 8 threads:
//
// RUN: env CUDA_VISIBLE_DEVICES= VX_HOST_THREADS=8 VX_NO_AST_FALLBACK=1 not vxc %s 2>&1 | FileCheck %s --implicit-check-not=result
// RUN: env CUDA_VISIBLE_DEVICES= VX_HOST_THREADS=8 not vxc %s --legacy-codegen 2>&1 | FileCheck %s --implicit-check-not=result
// CHECK: a negative input

fn main() -> i32 {
  let mut h = Tensor<i32>([64]);
  for i in 0..64 {
    h[i] = 40 - i;
  }
  let a = transfer(h, Memory::GPU_HBM);
  let mut out = transfer(Tensor<i32>([64]), Memory::GPU_HBM);
  spawn on(Topology::GPU) {
    for i in 0..64 {
      // CHECK: at {{.*}}.vx:[[@LINE+1]]
      assert(a[i] >= 0, "a negative input");
      out[i] = a[i] * 2;
    }
  }
  let o = transfer(out, Memory::CPU_DRAM);
  println!("result {}", o[0]);
  return 0;
}
