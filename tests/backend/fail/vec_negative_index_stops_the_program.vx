//===----------------------------------------------------------------------===//
// `Vec::set` with index 0 writes the element. With a negative index, it prints the index and
// the length, and stops the program.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// CHECK: 7
// CHECK: Vec: index -1 is out of bounds for length 2
// CHECK: panic: Vec: index out of bounds
// CHECK-NOT: after the failure
import std::vec;

fn main() -> i32 {
  let mut v = Vec<i32>::new();
  v.push(1);
  v.push(2);
  v.set(0, 7);
  print(v.get(0));
  println!("");
  v.set(-1, 9);
  println!("after the failure");
  return 0;
}
