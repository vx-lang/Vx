//===----------------------------------------------------------------------===//
// `expect` on an `Err` stops the program with the caller's message.
//
// RUN: not vxc %s 2>&1 | FileCheck %s
// RUN: not vxc %s --legacy-codegen 2>&1 | FileCheck %s
// CHECK: panic: the parse should have worked
// CHECK-NOT: after the panic
import core::result;

fn main() -> i32 {
  let r = Result<i32, i32>::Err(9);
  print(r.expect("the parse should have worked"));
  println!("after the panic");
  return 0;
}
