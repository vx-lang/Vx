//===----------------------------------------------------------------------===//
// A region for the Intel GPU keeps a scratch array of its own. The compiler
// allocates it on the device, which a SPIR-V image cannot do yet. Its tensors are in the memory of the card, which the
// host cannot read, so the region cannot run on the host either. The error
// says why the region gets no image.
//
// RUN: not vxc %s --machine fleet/arc-a770.vx --host default --action emit-llvm -o /dev/null 2>&1 | FileCheck %s
// CHECK: this region is placed on `Topology::Device`, but the compiler cannot emit a device kernel for it
// CHECK: A `spirv64` device image cannot hold it: it allocates a buffer on the device (`memref.alloc`)

fn main() -> i32 {
  let a = transfer(Tensor<f32, [4]>::fill(1.0), Memory::HBM);
  let mut o = transfer(Tensor<f32, [4]>::fill(0.0), Memory::HBM);
  spawn on(Topology::Device) {
    let mut scratch : Tensor<f32, [4]> = [1.0, 1.0, 1.0, 1.0];
    for i in 0..4 {
      scratch[i] = a[i] * 2.0;
    }
    for i in 0..4 {
      o[i] = scratch[3 - i];
    }
  }
  let back = transfer(o, Memory::CPU_DRAM);
  println!("{}", back[0]);
  return 0;
}
