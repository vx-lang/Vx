// Declares `strlen` and `llabs` for this file only, and `labs` for every file.
extern {
  fn strlen(s : *const i8) -> i64;
  pub fn labs(n : i64) -> i64;
  fn llabs(n : i64) -> i64;
}

pub fn length(s : *const i8) -> i64 {
  return unsafe { strlen(s) };
}
