//===----------------------------------------------------------------------===//
// A module, not a test: the second wave of imports for the `vxc -j` loader fixtures. It is
// reached only through `jobs_wave_a`, never named by a test file directly.
//===----------------------------------------------------------------------===//

fn wave_b(x: i32) -> i32 {
  return x * 2;
}
