//===----------------------------------------------------------------------===//
// A library function without errors, `total`, that calls one with a type error.

struct Point {
  x : i64,
}

// `Point` has no field `y`.
fn wrong_field() -> i64 {
  let p = Point {
    x : 1i64
  };
  return p.y;
}

fn total() -> i64 {
  return wrong_field() + 1i64;
}
