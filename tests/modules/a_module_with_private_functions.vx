// A module for `a_call_of_a_private_function_from_another_file.vx`. Each function with no `pub`
// is private to this file. This file calls each of them, so a call from this file is fine. It
// also calls a `pkg` function of another file of the package `tests`.
import tests::modules::a_module_with_pkg_functions;

extern {
  fn labs(x : i64) -> i64;
}

struct Counter {
  n : i64,
}

trait Describe {
  fn describe(self : &Self) -> i64;
}

impl Counter {
  pub fn new() -> Counter {
    let mut c = Counter::zero();
    c.n = twice(1);
    return c;
  }

  fn zero() -> Counter {
    return Counter {
      n : 0
    };
  }

  fn bump(self : &mut Counter) -> void {
    self.n = self.n + 1;
  }

  pub fn get(self : &mut Counter) -> i64 {
    self.bump();
    return self.n;
  }
}

// A method of a trait impl is public, because the trait is.
impl Describe for Counter {
  fn describe(self : &Counter) -> i64 {
    return self.n;
  }
}

fn twice(x : i64) -> i64 {
  return x * 2;
}

pub fn twice_of(x : i64) -> i64 {
  return pkg_twice(x) + unsafe { labs(0) };
}

// A copy of a generic function belongs to the file of the generic function. So another file can
// call `first_of`, and its copy can call the private `twice` and `same`.
pub fn first_of<T>(a : T, b : T) -> T {
  if twice(1) > 0 {
    return same(a);
  }
  return b;
}

fn same<T>(x : T) -> T {
  return x;
}
