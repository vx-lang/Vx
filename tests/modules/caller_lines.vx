// A module for a_caller_parameter_gets_the_line_of_the_call.vx.
import core::panic;

/// Prints the file and the line of its call.
fn here(what : i32, at : Caller) -> void {
  println!("{} at {}:{}", what, at.file, at.line);
}

/// Calls `here` from this module.
fn from_the_module() -> void {
  here(6);
}
