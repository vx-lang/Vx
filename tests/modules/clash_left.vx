// Declares `Point`, as clash_right does.
import core::iter;

struct Point {
  x : i64,
}

fn left_point() -> Point {
  return Point {
    x : 1i64
  };
}

fn left_x() -> i64 {
  return left_point().x;
}

// Also `Range`, which core::iter declares too. This module and its importers see this one.
struct Range {
  lo : i64,
}

fn left_count() -> i64 {
  let mut n = 0i64;
  let mut it = range(0i64, 3i64);
  for x in it {
    n = n + 1i64;
  }
  return n;
}
