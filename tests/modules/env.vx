// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: module
//===- env.vx - Vx Standard Library ---------------------------------*- Vx
//-*-===//
//
// Provides command line arguments functionality.
//
//===----------------------------------------------------------------------===//

extern {
  fn vx_env_args_count() -> i32;
  fn vx_env_arg(idx : i32)->*mut i8;
}

fn args_count() -> i32 { return unsafe{vx_env_args_count()}; }

fn arg(idx : i32) -> *mut i8 { return unsafe{vx_env_arg(idx)}; }

import tests::modules::iter;

struct Args {
  current : i32, count : i32,
}

fn args() -> Args {
  return Args{current : 0, count : args_count()};
}

impl Iterator<Args, *mut i8> for Args {
  fn next(self : Args) -> Option<*mut i8> {
    if self
    .current < self.count {
      let val : *mut i8 = arg(self.current);
      self.current = self.current + 1;
      return Option::Some(*mut i8)(val);
    }
    return Option::None(*mut i8)();
  }
}
