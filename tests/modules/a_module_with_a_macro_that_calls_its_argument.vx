//===----------------------------------------------------------------------===//
// A module for `a_macro_calls_the_functions_of_its_file.vx` and
// `a_macro_argument_cannot_name_a_private_function.vx`. `call_it` calls the function that its
// caller names.

macro_rules call_it {
  ($f : ident) => {
    $f()
  };
}
