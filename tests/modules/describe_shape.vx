// A struct and a trait that describe_left.vx and describe_right.vx both implement for it.

struct Point {
  x : i32,
}

trait Describe {
  fn describe(self : &Self) -> i32;
}

fn make() -> Point {
  return Point {
    x: 1
  };
}
