// Two functions that C code can call. `length_of` requires facts about its pointer, which a
// call from C does not prove. `twice` requires a fact that names no pointer.

pub extern fn length_of(p : *const u8, n : i32) -> i32
requires valid(p, n)
requires initialized(p, n)
{
  return count(p, n);
}

pub extern fn twice(n : i32) -> i32
requires n > 0
{
  return n * 2;
}

/// A function of the package whose caller must prove that `p` points at `n` bytes.
fn count(p : *const u8, n : i32) -> i32
requires valid(p, n)
{
  return n;
}
