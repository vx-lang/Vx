// A module, not a test. Compiled on its own it emits an empty module -- these are
// declarations, materialized only where they are imported -- so the RUN line and the
// `CHECK: module` that used to sit here were checking nothing (Vx#412).
//
// This file declares the FFI boundary for the LLaMA2 runtime tests.
// These functions are implemented natively in Rust inside `rt.rs` and
// exposed as C-compatible symbols.

import std::io;
import std::math;
import std::time;
extern {
  fn putchar(char : i32) -> i32;
  fn vx_simd_reduce_add(v : <4 x f32>)->f32;
  fn vx_powf(x : f32, y : f32)->f32;
  fn vx_get_rope_freq(pos : i32, i : i32, head_size : i32)->f32;
  fn vx_file_open(c_path : *const i8, mode : i32) -> *mut i8;
  fn vx_file_read(ptr : *mut i8, buffer : *mut f32, len : i32) -> i32;
  fn vx_file_drop(ptr : *mut i8) -> i32;

  fn vx_load_config(filepath : *const i8) -> *mut i32;
  fn vx_load_weights(filepath : *const i8) -> *mut f32;
  fn vx_advance_ptr_const(ptr : *const f32, offset : i32) -> *const f32;
  fn vx_advance_ptr(ptr : *mut f32, offset : i32) -> *mut f32;

  // Move a weight blob into the memory of the topology that will read it, once,
  // and get back a pointer into that memory. The plugin ABI
  // (include/vx_hardware_runtime.h) rather than a CUDA call: the CUDA backend
  // answers it with cudaMalloc and an H2D copy, a CPU backend with an aligned
  // allocation and a memcpy, so the same program is correct on either.
  //
  // Weights are read once per token. Staging them per dispatch would move the
  // whole matrix across the bus for every projection of every layer, which is
  // what makes a naive GPU port slower than the CPU it replaced.
  // `space_access` reports what the program's machine model claimed about host
  // access to the target space, so a backend can notice it is handing out
  // memory the host cannot read. These calls are hand-written FFI with no
  // declared space behind them, so they pass 0 -- "unknown", checked nowhere.
  fn vx_plugin_alloc_and_transfer(bytes : i64, host_ptr : *mut f32,
  topology_id : i32, space_access : i32) -> *mut f32;

  // The three calls a disaggregated run is made of (#347).
  //
  // `transfer_peer` is the one that has no single-device equivalent: it moves a
  // buffer from the memory of the topology that produced it into the memory of
  // the topology that will read it, and returns a pointer into the second. A
  // KV cache computed by prefill on one GPU reaches the GPU that decodes from
  // it this way and no other. On a machine with one device -- or none -- both
  // topologies name one memory and the backend answers with a copy, so the
  // program is correct there too and can be checked against itself.
  //
  // `transfer_device_to_host` reads a device buffer back. It names the device
  // rather than letting the backend infer one from the address, because only
  // CUDA's unified addressing makes that inference possible.
  //
  // `free` returns the allocation to the topology that made it, which is why it
  // takes one: freeing on the wrong device is not a leak but an error.
  fn vx_plugin_transfer_peer(src_device_ptr : *mut f32, src_topology_id : i32,
  dst_topology_id : i32, bytes : i64) -> *mut f32;
  fn vx_plugin_transfer_device_to_host(device_ptr : *mut f32,
  host_ptr : *mut f32, bytes : i64, topology_id : i32) -> i32;
  fn vx_plugin_free(device_ptr : *mut f32, topology_id : i32) -> void;
  fn vx_build_tokenizer(filepath : *const i8, vocab_size : i32) -> *mut i8;
  fn vx_decode_token(tokenizer_ptr : *mut i8, prev_token : i32, token : i32)
  -> *mut i8;
  fn vx_read_prompt_file(filepath : *const i8) -> *mut i8;
  fn vx_encode_prompt(tokenizer_ptr : *mut i8, text : *const i8) -> *mut i32;

  fn vx_get_env_int(name : *const i8, default_val : i32) -> i32;
  fn vx_get_llama_config() -> *mut i32;
}
