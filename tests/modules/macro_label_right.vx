//===----------------------------------------------------------------------===//
// Declares a struct `Right` and a macro `label` that gives it a method `label`.
// macro_label_left.vx declares a macro with the same name.

struct Right {
  x : i64,
}

macro_rules label {
  ($t : ident) => {
    impl $t {
      fn label(self : &Self) -> i64 {
        return 2i64;
      }
    }
  };
}

label!(Right);
