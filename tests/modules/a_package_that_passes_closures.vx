//===----------------------------------------------------------------------===//
// A module with no trusted code. It passes closures to a generic function of its own and to
// `std::sync::wait::within`.

import core::time;
import std::sync::wait;

fn apply<T>(body : || -> T) -> T {
  return body();
}

pub fn add_one(x : i32) -> i32 {
  return apply(|| -> i32 {
    return x + 1;
  });
}

pub fn add_two_in_time(x : i32) -> i32 {
  return within(Duration::from_millis(100u64), || -> i32 {
    return x + 2;
  });
}
