// A module with no trusted code of its own. Its `impl Write` gets the default `write_c_str` of
// `core::fmt`, which has an `unsafe` block.

import core::fmt;
import core::result;

struct Counter {
  bytes : i64,
}

impl Write for Counter {
  fn write_u8(self : &mut Counter, b : u8) -> Result<i32, Error> {
    self.bytes = self.bytes + 1;
    return Result<i32, Error>::Ok(0);
  }
}

/// The number of bytes in `"hello"`, as a `Counter` counts them.
pub fn counted_bytes() -> i64 {
  let mut c = Counter {
    bytes : 0
  };
  c.write_c_str("hello");
  return c.bytes;
}
