//===----------------------------------------------------------------------===//
// Core iterator interfaces and types.
//
// A module, not a test. Compiled on its own it emits an empty module -- these are
// declarations, materialized only where they are imported -- so the RUN line and the
// `CHECK: module` that used to sit here were checking nothing (Vx#412).
//
//===----------------------------------------------------------------------===//

enum Option<T> {
  Some(T),
  None,
}

trait Iterator<Iter, Item> {
  fn next(self : Iter)->Option<Item>;
}

struct Range {
  start : i64, end : i64,
}

// Iterator implementation will be provided natively or via bootstrapping.
