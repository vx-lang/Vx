//===----------------------------------------------------------------------===//
// Imports the test that imports this file, and calls the method `doubled` that the test
// writes for `i64`.
import tests::backend::pass::a_method_of_a_file_that_is_read_twice;

pub fn tripled(x : i64) -> i64 {
  return x.doubled() + x;
}
