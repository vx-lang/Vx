// A struct with an `Option` field, for a test that uses it from another module.

import core::option;

struct Error {
  small: u8,
  code: Option<i64>
}

fn make_error(code: i64) -> Error {
  return Error {
    small: 2u8,
    code: Option<i64>::Some(code)
  };
}
