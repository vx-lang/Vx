// A module for `a_pkg_function_clashes_in_its_own_package.vx`. This file is in the package
// `tests`, so it can call both the `pub` `write_bytes` of `core::ptr` and the `pkg` one.
import core::ptr;
import tests::modules::a_module_with_a_pkg_write_bytes;

pub fn three() -> i64 {
  return write_bytes(1);
}
