//===----------------------------------------------------------------------===//
// `finish` moves a field out of `&mut self`, which is an error (E4008).

import core::result;
import std::vec;

struct Output {
  parts : Vec<Vec<u8>>,
}

impl Output {
  pub fn finish(self : &mut Output) -> Result<i32, i32> {
    let parts = self.parts;
    self.parts = Vec<Vec<u8>>::new();
    return Result<i32, i32>::Ok(parts.len());
  }
}

pub fn new_output() -> Output {
  return Output {
    parts : Vec<Vec<u8>>::new()
  };
}
