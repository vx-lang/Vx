//===----------------------------------------------------------------------===//
// Declares a capability, `AdminCap`, and a macro that writes `impl Copy` for a type.

struct AdminCap {
  invariant true,
}

macro_rules copyable {
  ($t : ident) => {
    impl Copy for $t {}
  };
}
