// A module with no trusted code. It prints with `print_s!` and `println_s!`, which take the
// right to print, and gets the rights from its caller.

import std::io;

pub fn report(out : &Stdout, err : &Stderr, n : i32) -> void {
  print_s!(out, "count {} ", n);
  println_s!(out, "and {}", n + 1);
  println_s!(out, n);
  println_s!(out);
  println_s!(out, "after an empty line");
  println_s!(err, "to standard error {}", n);
}
