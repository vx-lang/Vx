// A function that checks and calls one that does not.

struct Count {
  n : i64,
}

fn inner_flawed() -> i64 {
  let c = Count {
    n : 5i64
  };
  return c.m;
}

fn outer_good() -> i64 {
  return inner_flawed() + 1i64;
}
