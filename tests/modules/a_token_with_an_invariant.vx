//===----------------------------------------------------------------------===//
// Declares `Token`, a struct with an invariant. An `mlir!` block in this file can make a value of
// `Token`.

struct Token {
  number : i64,

  invariant 0i64 <= number,
}

fn token_from_mlir() -> Token {
  return mlir!(inputs : (), returns : Token, dialects : ["llvm"]) {
    %u = llvm.mlir.undef : !llvm.struct<(i64)>
    macro.yield %u : !llvm.struct<(i64)>
  };
}
