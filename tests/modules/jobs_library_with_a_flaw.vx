//===----------------------------------------------------------------------===//
// A module, not a test: an imported library holding one good function and one generic that does
// not type check. Nothing imports the generic, so a compile of the importer must not report it.
//===----------------------------------------------------------------------===//

fn library_good(x: i32) -> i32 {
  return x + 1;
}

fn library_flawed(x: i32) -> i32 {
  return no_such_function(x);
}
