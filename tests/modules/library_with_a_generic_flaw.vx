// A generic library function with a type error in its body. The error is only found when a
// program calls the function, which creates the instance that gets checked.

struct Point {
  x : i64,
}

// `Point` has no field `y`.
fn first<T>(v : T) -> i64 {
  let p = Point {
    x : 1i64
  };
  return p.y;
}
