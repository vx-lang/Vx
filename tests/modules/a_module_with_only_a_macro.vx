//===----------------------------------------------------------------------===//
// A module for `a_macro_calls_the_functions_of_its_file.vx`. It has no functions. Its macro calls
// `pkg_twice`, a `pkg` function of another file of the package `tests`.
import tests::modules::a_module_with_pkg_functions;

macro_rules twice_in_the_package {
  ($x : expr) => {
    pkg_twice($x)
  };
}
