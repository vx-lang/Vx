//===----------------------------------------------------------------------===//
// Declares a type with an invariant and three macros. The code that the macros write has
// errors when another file calls them.

struct Token {
  invariant true,
}

macro_rules make_token {
  () => {
    Token {}
  };
}

macro_rules add_wrong_method {
  ($t : ident) => {
    impl $t {
      fn wrong(self : &Self) -> i32 {
        return true;
      }
    }
  };
}

macro_rules make_token_through_another_macro {
  () => {
    make_token!()
  };
}
