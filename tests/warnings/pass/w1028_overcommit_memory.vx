//===----------------------------------------------------------------------===//
// The cumulative budget check is conservative -- it assumes every tile placed in a space is
// live at once. A programmer who knows their tiles do NOT all coexist (or who is exploring)
// can declare the space `overcommit`, which downgrades the working-set error (E6010) to a
// warning (W1028) and does not block compilation. Same over-budget program as
// fail/memory_working_set_overflow.vx, but with `overcommit`.
//
// WARN: W1028
// WARN: overcommit

Memory Local_SRAM {
  scope: sm, capacity: 228 KiB, overcommit
}

fn main() -> i32 {
  let mut qt = Tensor<f32, [128, 256]>::uninit();
  let mut kt = Tensor<f32, [128, 256]>::uninit();
  let mut vt = Tensor<f32, [128, 256]>::uninit();
  for i in 0..128 {
    for j in 0..256 {
      qt[i][j] = 1.0;
      kt[i][j] = 1.0;
      vt[i][j] = 1.0;
    }
  }
  let q = transfer(qt, Memory::Local_SRAM);
  let k = transfer(kt, Memory::Local_SRAM);
  let v = transfer(vt, Memory::Local_SRAM);
  // Read all three after the last is placed, which is what makes them coexist: a
  // tile's life runs to its last reader, so one nobody reads is released where it is
  // made and never joins anyone else's residency. Q/K/V are read together by the
  // matmul this space is sized for, so reading them here is the shape, not a prop.
  let _rq = transfer(q, Memory::CPU_DRAM);
  let _rk = transfer(k, Memory::CPU_DRAM);
  let _rv = transfer(v, Memory::CPU_DRAM);
  return 0;
}
