// No W1034 for tensors transferred to GPU memory before the region, for a scalar the region
// reads, for a tensor made inside the region, or for a host tensor used on the host. The one
// warning is that `unused` is not used.
// WARN: Unused variable 'unused'
// NO-WARN: W1034

fn main() -> i32 {
  let unused = 1;
  let scale : f32 = 2.0;
  let a = transfer(Tensor<f32, [4]>::new(), Memory::GPU_HBM);
  let mut o = transfer(Tensor<f32, [4]>::new(), Memory::GPU_HBM);
  spawn on(Topology::GPU) {
    let mut local = Tensor<f32, [4]>::new();
    for i in 0..4 {
      local[i] = a[i] * scale;
      o[i] = local[i];
    }
  }
  let back = transfer(o, Memory::CPU_DRAM);
  let mut h = Tensor<f32, [4]>::new();
  h[0] = back[0];
  return h[0] as i32;
}
