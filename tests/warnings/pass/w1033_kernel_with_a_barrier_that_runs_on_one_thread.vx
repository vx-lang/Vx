// W1033 for a `spawn` region that calls `barrier()`: the program asks for blocks and threads,
// but the region runs on one thread. The warning points at the first thing that stopped the
// compiler from splitting the region.
// WARN: Warning[W1033] at 40:15: this `spawn` region calls `barrier()`, but it runs on one thread: the compiler cannot show that each pass of the loop over `z` writes a different element of `out`
// WARN: Warning[W1033] at 56:11: this `spawn` region calls `barrier()`, but it runs on one thread: a `break` or `continue` leaves a loop that holds a `barrier()`
// WARN: Warning[W1033] at 69:7: this `spawn` region calls `barrier()`, but it runs on one thread: a loop writes the block-shared tensor `part`, and the next statement is not `barrier()`

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Memory SMEM {
  within: Memory::GPU_HBM, capacity: 228 KiB, bandwidth: 128 B/cyc,
  granule: 1 KiB, managed: explicit, scope: sm
}
Topology Coop {
  arch: nvptx64,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM, Memory::SMEM],
}

// Each thread adds four columns into `part`, then one pass adds `part` into column 0.
fn row_sums_into_column_zero(out : &mut Tensor<f32, [64, 1], Memory::GPU_HBM>, x : &Tensor<f32, [64, 128], Memory::GPU_HBM>) -> void {
  spawn on(Topology::Coop) {
    let mut part = unsafe { Tensor<f32, [32, 1], Memory::SMEM>::uninit() };
    for r in 0..64 {
      for t in 0..32 {
        let mut s : f32 = 0.0;
        for j in 0..4 {
          s = s + x[r][t + j * 32];
        }
        part[t][0] = s;
      }
      barrier();
      for z in 0..1 {
        let mut s : f32 = 0.0;
        for k in 0..32 {
          s = s + part[k][0];
        }
        out[r][0] = s;
      }
      barrier();
    }
  }
  return;
}

fn breaks_out_of_a_loop_with_a_barrier(out : &mut Tensor<f32, [8, 1], Memory::GPU_HBM>, x : &Tensor<f32, [6, 1], Memory::GPU_HBM>) -> void {
  spawn on(Topology::Coop) {
    let mut part = unsafe { Tensor<f32, [2, 1], Memory::SMEM>::uninit() };
    for b in 0..4 {
      for t in 0..2 {
        for k in 0..3 {
          part[t][0] = x[k * 2 + t][0];
          barrier();
          break;
        }
        out[b * 2 + t][0] = part[t][0];
      }
    }
  }
  return;
}

fn no_barrier_after_a_shared_write(out : &mut Tensor<f32, [8, 1], Memory::GPU_HBM>, x : &Tensor<f32, [8, 1], Memory::GPU_HBM>) -> void {
  spawn on(Topology::Coop) {
    let mut part = unsafe { Tensor<f32, [2, 1], Memory::SMEM>::uninit() };
    for b in 0..4 {
      for t in 0..2 {
        part[t][0] = x[b * 2 + t][0];
      }
      for t in 0..2 {
        out[b * 2 + t][0] = part[1 - t][0];
      }
      barrier();
    }
  }
  return;
}

fn main() -> i32 {
  return 0;
}
