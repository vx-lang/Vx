// W1024: a value whose type `impl`s `Relocatable` is accessed across a topology
// boundary, so the compiler implicitly inserts `.relocate()` -- a real data
// movement surfaced at the use site with its cost.
//
// `Relocatable` says this value MAY move implicitly. It is not the same thing as
// `impl Transfer<Memory::A, Memory::B> for Topology::X`, which says HOW bytes cross
// a hardware edge. Both were spelled `Transfer` before Vx#353.
// WARN: W1024
// WARN: implicit transfer of 'm_host'

struct MyModel {
  weights: Tensor<f32>,
}

impl Relocatable for MyModel {
  fn relocate(self: MyModel) -> MyModel {
    return self;
  }
}

fn process(m_host: MyModel) -> MyModel {
  spawn on(Topology::NPU[0]) {
    let m_device = m_host;
  }
  return MyModel {
    weights: Tensor<f32>()
  };
}

fn main() -> i32 {
  return 0;
}
