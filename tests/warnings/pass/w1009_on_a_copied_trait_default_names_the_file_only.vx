// W1009 on a trait default that an impl copies: the copy is built in memory, so it has no
// position of its own. The warning names the file and nothing else, not `0:0`.
// WARN: Unused function parameter 'unused'
// NO-WARN: :0:0
trait Greet {
  fn greet(self : &Self, unused : i32) -> i32 {
    return 1;
  }
}

struct Thing {
  n : i32,
}

impl Greet for Thing {}

fn main() -> i32 {
  let t = Thing {
    n : 1
  };
  return t.greet(2);
}
