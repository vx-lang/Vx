// W1034: a GPU region uses a tensor that lives in host memory. The built-in GPU lists host
// memory as visible, so it compiles, but a generated kernel is given the host pointer as it is.
// Reported once per tensor per region: `h` is used twice in the first region and once in the
// second, and a borrow of a host tensor is reported like the tensor.
// WARN: Warning[W1034] at 22:7: 'h' lives in host memory (CPU_DRAM) but is used on GPU[0]
// WARN: Warning[W1034] at 29:5: 'h' lives in host memory (CPU_DRAM) but is used on GPU[0]
// WARN: Warning[W1034] at 30:5: 'g' lives in host memory (CPU_DRAM) but is used on GPU[0]
// WARN: `transfer(h, Memory::GPU_HBM)`

fn total(g : &Tensor<f32, [4]>) -> f32 {
  let mut s : f32 = 0.0;
  for i in 0..4 {
    s += g[i];
  }
  return s;
}

fn main() -> i32 {
  let mut h = Tensor<f32, [4]>::new();
  spawn on(Topology::GPU) {
    for i in 0..4 {
      h[i] = 1.0;
      h[i] += 1.0;
    }
  }
  let k = Tensor<f32, [4]>::new();
  let g = &k;
  spawn on(Topology::GPU) {
    h[0] = 3.0;
    g[1];
  }
  return total(&h) as i32;
}
