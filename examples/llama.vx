//===- llama.vx - Clean Llama Inference -------------------------------*- Vx
//-*-===//
//
// This is a clean, high-level implementation of Llama2 inference in Vx.
// It leverages native Tensor abstractions, automatic memory management,
// and high-level control flow, discarding the raw C-pointers used in early
// testing.
//
//===----------------------------------------------------------------------===//

import std::io;
import std::vec;
import tests::modules::llama_rt;
import std::math;
import std::time;

struct Config {
  dim : i32,
  hidden_dim : i32,
  n_layers : i32,
  n_heads : i32,
  n_kv_heads : i32,
  vocab_size : i32,
  seq_len
  : i32
}

struct TransformerWeights {
  token_embedding_table : *mut f32,
  rms_att_weight : *mut f32,
  rms_ffn_weight : *mut f32,
  wq : *mut f32,
  wk : *mut f32,
  wv
  : *mut f32,
  wo : *mut f32,
  w1 : *mut f32,
  w2 : *mut f32,
  w3 : *mut f32,
  rms_final_weight : *mut f32,
  wcls : *mut f32
}

struct RunState {
  x : *mut f32,
  xb : *mut f32,
  xb2 : *mut f32,
  hb : *mut f32,
  hb2 : *mut f32,
  q : *mut f32,
  k : *mut f32,
  v : *mut f32,
  logits : *mut f32,
  key_cache : *mut f32,
  value_cache
  : *mut f32
}

fn ptr_to_tensor_1d(ptr: *mut f32, d1: i32) -> Tensor<f32> {
  let mut t : Tensor<f32> = Tensor<f32>([ 1, d1 ]);
  for i in 0..d1 {
    unsafe {
      t[0][i] = ptr[i];
    }
  }
  return t;
}

fn ptr_to_tensor_2d(ptr : *mut f32, d1 : i32, d2 : i32) -> Tensor<f32> {
  let mut t : Tensor<f32> = Tensor<f32>([ d1, d2 ]);
  for i in 0..d1 {
    for j in 0..d2 {
      let idx : i32 = i * d2 + j;
      unsafe {
        t[i][j] = ptr[idx];
      }
    }
  }
  return t;
}

fn load_weights(ptr : *mut f32, dim : i32, hidden_dim : i32, n_layers : i32,
n_heads : i32, n_kv_heads : i32, seq_len : i32,
vocab_size : i32) -> TransformerWeights {
  let head_size : i32 = dim / n_heads;

  let w = unsafe {
    let p0 : *mut f32 = ptr;
    let p1 : *mut f32 = vx_advance_ptr(p0, vocab_size * dim);
    let p2 : *mut f32 = vx_advance_ptr(p1, n_layers * dim);
    let p3 : *mut f32 =
    vx_advance_ptr(p2, n_layers * dim * n_heads * head_size);
    let p4 : *mut f32 =
    vx_advance_ptr(p3, n_layers * dim * n_kv_heads * head_size);
    let p5 : *mut f32 =
    vx_advance_ptr(p4, n_layers * dim * n_kv_heads * head_size);
    let p6 : *mut f32 =
    vx_advance_ptr(p5, n_layers * n_heads * head_size * dim);
    let p7 : *mut f32 = vx_advance_ptr(p6, n_layers * dim);
    let p8 : *mut f32 = vx_advance_ptr(p7, n_layers * dim * hidden_dim);
    let p9 : *mut f32 = vx_advance_ptr(p8, n_layers * hidden_dim * dim);
    let p10 : *mut f32 = vx_advance_ptr(p9, n_layers * dim * hidden_dim);
    let p11 : *mut f32 = vx_advance_ptr(p10, dim);

    TransformerWeights {
      token_embedding_table:
      p0, rms_att_weight : p1,
      wq : p2,
      wk : p3,
      wv : p4,
      wo : p5,
      rms_ffn_weight : p6,
      w1 : p7,
      w2 : p8,
      w3
      : p9,
      rms_final_weight : p10,
      wcls : p0
    }
  };
  return w;
}

fn init_run_state(dim : i32, hidden_dim : i32, n_layers : i32, n_heads : i32,
n_kv_heads : i32, seq_len : i32, vocab_size : i32)
-> RunState {
  let kv_dim : i32 = (dim * n_kv_heads) / n_heads;

  return unsafe{RunState{
      x : Vec<f32>::with_capacity(dim).data,
      xb : Vec<f32>::with_capacity(dim).data,
      xb2 : Vec<f32>::with_capacity(dim).data,
      hb : Vec<f32>::with_capacity(hidden_dim).data,
      hb2 : Vec<f32>::with_capacity(hidden_dim).data,
      q : Vec<f32>::with_capacity(dim).data,
      k : Vec<f32>::with_capacity(kv_dim).data,
      v : Vec<f32>::with_capacity(kv_dim).data,
      logits : Vec<f32>::with_capacity(vocab_size).data,
      key_cache : Vec<f32>::with_capacity(n_layers * seq_len * kv_dim).data,
      value_cache : Vec<f32>::with_capacity(n_layers * seq_len * kv_dim).data
    }};
}
fn safe_get_rope_freq(pos : i32, i : i32, head_size : i32) -> f32 {
  return unsafe{
    vx_get_rope_freq(pos, i, head_size)
  };
}

fn rmsnorm(o : *mut f32, x : *mut f32, weight : *mut f32, size : i32) -> i32 {
  let mut ss : f32 = 0.0;
  for j in 0..size {
    let val : f32 = unsafe{
      x[j]
    };
    ss = ss + (val * val);
  }
  let div : f32 = ss / size;
  let add : f32 = div + 0.00001;
  ss = 1.0 / add.sqrt();
  for j in 0..size {
    unsafe {
      o[j] = weight[j] * (ss * x[j]);
    }
  }
  return 0;
}

fn argmax(probabilities : *mut f32, n : i32) -> i32 {
  let mut max_i : i32 = 0;
  let mut max_p : f32 = unsafe{
    probabilities[0]
  };
  for i in 1..n {
    let p_val : f32 = unsafe{
      probabilities[i]
    };
    if p_val > max_p {
      max_i = i;
      max_p = p_val;
    }
  }
  return max_i;
}

fn transformer(token : i32, pos : i32, p : &Config, s : &RunState,
w : &TransformerWeights) -> i32 {
  let dim : i32 = p.dim;
  let hidden_dim : i32 = p.hidden_dim;
  let kv_dim : i32 = (p.dim * p.n_kv_heads) / p.n_heads;
  let head_size : i32 = dim / p.n_heads;

  unsafe {
    // 1. Token Embedding
    for i in 0..dim {
      s.x[i] = w.token_embedding_table[token * dim + i];
    }

    // 2. Forward pass over all layers
    for l in 0..p.n_layers {
      // 2.1 Attention RMSNorm
      rmsnorm(s.xb, s.x, vx_advance_ptr(w.rms_att_weight, l * dim), dim);

      // 2.2 QKV Projections (using native Tensor matmul `@`)
      let mut wq_l : Tensor<f32> = Tensor<f32>([ dim, dim ]);
      let mut wk_l : Tensor<f32> = Tensor<f32>([ dim, kv_dim ]);
      let mut wv_l : Tensor<f32> = Tensor<f32>([ dim, kv_dim ]);
      for row in 0..dim {
        for col in 0..dim {
          wq_l[row][col] = w.wq[(l * dim + row) * dim + col];
        }
        for col in 0..kv_dim {
          wk_l[row][col] = w.wk[(l * dim + row) * kv_dim + col];
        }
        for col in 0..kv_dim {
          wv_l[row][col] = w.wv[(l * dim + row) * kv_dim + col];
        }
      }

      let mut t_xb_q : Tensor<f32> = Tensor<f32>([ 1, dim ]);
      for i in 0..dim {
        t_xb_q[0][i] = s.xb[i];
      }
      let t_q : Tensor<f32> = t_xb_q @wq_l;

      let mut t_xb_k : Tensor<f32> = Tensor<f32>([ 1, dim ]);
      for i in 0..dim {
        t_xb_k[0][i] = s.xb[i];
      }
      let t_k : Tensor<f32> = t_xb_k @wk_l;

      let mut t_xb_v : Tensor<f32> = Tensor<f32>([ 1, dim ]);
      for i in 0..dim {
        t_xb_v[0][i] = s.xb[i];
      }
      let t_v : Tensor<f32> = t_xb_v @wv_l;

      for i in 0..dim {
        s.q[i] = t_q[0][i];
      }
      for i in 0..kv_dim {
        s.k[i] = t_k[0][i];
        s.v[i] = t_v[0][i];
      }

      // 2.3 RoPE (Rotary Positional Embeddings)
      for i in 0..dim {
        let div : i32 = i / 2;
        let mul : i32 = div * 2;
        let rem : i32 = i - mul;
        if rem == 0 {
          let head_dim_div : i32 = i / head_size;
          let head_dim_mul : i32 = head_dim_div * head_size;
          let head_dim : i32 = i - head_dim_mul;
          let freq : f32 = safe_get_rope_freq(pos, head_dim, head_size);
          let fcr : f32 = freq.cos();
          let fci : f32 = freq.sin();

          let rotn_q_r : i32 = i;
          let rotn_q_i : i32 = i + 1;
          let q0 : f32 = s.q[rotn_q_r];
          let q1 : f32 = s.q[rotn_q_i];
          s.q[rotn_q_r] = q0 * fcr - q1 * fci;
          s.q[rotn_q_i] = q0 * fci + q1 * fcr;

          if i < kv_dim {
            let rotn_k_r : i32 = i;
            let rotn_k_i : i32 = i + 1;
            let k0 : f32 = s.k[rotn_k_r];
            let k1 : f32 = s.k[rotn_k_i];
            s.k[rotn_k_r] = k0 * fcr - k1 * fci;
            s.k[rotn_k_i] = k0 * fci + k1 * fcr;
          }
        }
      }

      // 2.4 KV Cache update
      let l_offset : i32 = l * p.seq_len * kv_dim;
      let t_offset : i32 = pos * kv_dim;
      for i in 0..kv_dim {
        let idx : i32 = l_offset + t_offset + i;
        s.key_cache[idx] = s.k[i];
        s.value_cache[idx] = s.v[i];
      }

      // 2.5 Multi-Head Attention (FlashAttention + GQA)
      for h in 0..p.n_heads {
        let q_offset : i32 = h * head_size;
        let kv_head_idx : i32 = h / (p.n_heads / p.n_kv_heads);
        let kv_offset : i32 = kv_head_idx * head_size;

        let mut m : f32 = -999999.0;
        let mut l_sum : f32 = 0.0;

        for i in 0..head_size {
          s.xb[q_offset + i] = 0.0;
        }

        for t in 0..(pos + 1) {
          let mut score : f32 = 0.0;
          let t_cache_offset : i32 = l_offset + t * kv_dim;
          for i in 0..head_size {
            let q_val : f32 = s.q[q_offset + i];
            let k_val : f32 = s.key_cache[t_cache_offset + kv_offset + i];
            score = score + q_val * k_val;
          }
          let hf : f32 = head_size;
          score = score / hf.sqrt();

          let mut m_new : f32 = m;
          if score > m {
            m_new = score;
          }

          let diff : f32 = m - m_new;
          let correction : f32 = diff.exp();

          let diff2 : f32 = score - m_new;
          let exp_val : f32 = diff2.exp();

          l_sum = l_sum * correction + exp_val;

          for i in 0..head_size {
            let old_val : f32 = s.xb[q_offset + i];
            let v_val : f32 = s.value_cache[t_cache_offset + kv_offset + i];
            s.xb[q_offset + i] = old_val * correction + exp_val * v_val;
          }

          m = m_new;
        }

        let inv_l : f32 = 1.0 / l_sum;
        for i in 0..head_size {
          s.xb[q_offset + i] = s.xb[q_offset + i] * inv_l;
        }
      }

      // 2.6 Output Projection
      let mut wo_l : Tensor<f32> = Tensor<f32>([ dim, dim ]);
      for row in 0..dim {
        for col in 0..dim {
          wo_l[row][col] = w.wo[(l * dim + row) * dim + col];
        }
      }

      let mut t_xb_wo : Tensor<f32> = Tensor<f32>([ 1, dim ]);
      for i in 0..dim {
        t_xb_wo[0][i] = s.xb[i];
      }
      let t_xb2 : Tensor<f32> = t_xb_wo @wo_l;

      // Residual connection
      for i in 0..dim {
        s.x[i] = s.x[i] + t_xb2[0][i];
      }

      // 2.7 FFN RMSNorm
      rmsnorm(s.xb, s.x, vx_advance_ptr(w.rms_ffn_weight, l * dim), dim);

      // 2.8 FFN Projections
      let mut w1_l : Tensor<f32> = Tensor<f32>([ dim, hidden_dim ]);
      let mut w2_l : Tensor<f32> = Tensor<f32>([ hidden_dim, dim ]);
      let mut w3_l : Tensor<f32> = Tensor<f32>([ dim, hidden_dim ]);
      for row in 0..dim {
        for col in 0..hidden_dim {
          w1_l[row][col] = w.w1[(l * dim + row) * hidden_dim + col];
          w3_l[row][col] = w.w3[(l * dim + row) * hidden_dim + col];
        }
      }
      for row in 0..hidden_dim {
        for col in 0..dim {
          w2_l[row][col] = w.w2[(l * hidden_dim + row) * dim + col];
        }
      }

      let mut t_xb_w1 : Tensor<f32> = Tensor<f32>([ 1, dim ]);
      for i in 0..dim {
        t_xb_w1[0][i] = s.xb[i];
      }
      let t_hb : Tensor<f32> = t_xb_w1 @w1_l;

      let mut t_xb_w3 : Tensor<f32> = Tensor<f32>([ 1, dim ]);
      for i in 0..dim {
        t_xb_w3[0][i] = s.xb[i];
      }
      let t_hb2 : Tensor<f32> = t_xb_w3 @w3_l;

      // SwiGLU activation
      for i in 0..hidden_dim {
        let mut val : f32 = t_hb[0][i];
        val = val * (1.0 / (1.0 + 0.0 - val.exp()));
        val = val * t_hb2[0][i];
        s.hb[i] = val;
      }

      let mut t_hb_2d : Tensor<f32> = Tensor<f32>([ 1, hidden_dim ]);
      for i in 0..hidden_dim {
        t_hb_2d[0][i] = s.hb[i];
      }
      let t_xb_out : Tensor<f32> = t_hb_2d @w2_l;

      // Residual connection
      for i in 0..dim {
        s.x[i] = s.x[i] + t_xb_out[0][i];
      }
    }

    // 3. Final RMSNorm
    rmsnorm(s.x, s.x, w.rms_final_weight, dim);

    // 4. Classifier into Logits
    let mut t_x_2d : Tensor<f32> = Tensor<f32>([ 1, dim ]);
    for i in 0..dim {
      t_x_2d[0][i] = s.x[i];
    }

    let mut t_wcls_T : Tensor<f32> = Tensor<f32>([ dim, p.vocab_size ]);
    for r in 0..p.vocab_size {
      for c in 0..dim {
        t_wcls_T[c][r] = w.wcls[r * dim + c];
      }
    }

    let t_logits : Tensor<f32> = t_x_2d @t_wcls_T;
    for i in 0..p.vocab_size {
      s.logits[i] = t_logits[0][i];
    }
  }
  return 0;
}

fn main() -> i32 {
  let model_path : *const i8 = "tests/backend/pass/stories15M.bin";
  let tokenizer_path : *const i8 = "tests/backend/pass/tokenizer.bin";
  let temperature : f32 = 0.0;

  // 1. Initialize configuration via FFI
  let config_ptr : *mut i32 = unsafe{
    vx_load_config(model_path)
  };
  let vocab_size : i32 = unsafe {
    let p_vocab : *mut i32 = vx_advance_ptr(config_ptr, 5);
    p_vocab[0]
  };

  let config = unsafe {
    let dim_ptr : *mut i32 = config_ptr;
    let hidden_ptr : *mut i32 = vx_advance_ptr(config_ptr, 1);
    let layers_ptr : *mut i32 = vx_advance_ptr(config_ptr, 2);
    let heads_ptr : *mut i32 = vx_advance_ptr(config_ptr, 3);
    let kv_heads_ptr : *mut i32 = vx_advance_ptr(config_ptr, 4);
    let seq_ptr : *mut i32 = vx_advance_ptr(config_ptr, 6);

    Config {
      dim:
      dim_ptr[0], hidden_dim : hidden_ptr[0],
      n_layers : layers_ptr[0],
      n_heads : heads_ptr[0],
      n_kv_heads
      : kv_heads_ptr[0],
      vocab_size : vocab_size,
      seq_len : seq_ptr[0]
    }
  };

  let steps : i32 = 256;
  if config
  .seq_len < steps {
    let s : i32 = config.seq_len;
  }

  // 2. Map weights and allocate native Tensors
  let weights_ptr : *mut f32 = unsafe{
    vx_load_weights(model_path)
  };
  let weights = load_weights(weights_ptr, config.dim, config.hidden_dim,
  config.n_layers, config.n_heads, config.n_kv_heads,
  config.seq_len, config.vocab_size);
  let state = init_run_state(config.dim, config.hidden_dim, config.n_layers,
  config.n_heads, config.n_kv_heads, config.seq_len,
  config.vocab_size);
  let tokenizer_ptr
  : *mut i8 = unsafe{
    vx_build_tokenizer(tokenizer_path, config.vocab_size)
  };

  let start : f32 = now();
  let mut next : i32 = 0;
  let mut token : i32 = 1;

  // 3. Autoregressive Generation Loop
  for pos in 0..steps {
    transformer(token, pos, &config, &state, &weights);
    next = argmax(state.logits, config.vocab_size);
    let piece : *mut i8 = unsafe{
      vx_decode_token(tokenizer_ptr, token, next)
    };
    unsafe {
      print!(piece);
    }
    token = next;
  }

  unsafe {
    print!(0.0);
  }
  return 0;
}
