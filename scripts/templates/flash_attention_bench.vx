//===----------------------------------------------------------------------===//
//
// tests/backend/pass/flash_attention_placed.vx with its shape as parameters,
// so the fused flash forward can be timed rather than only checked (#348).
// The kernel body is that file's, unchanged apart from the bounds.
//
// __VX_BENCH_NOTE__
//
// Read what this measures carefully; what it is depends on the machine, and
// the harness prints a verdict rather than leaving the reader to assume.
// `spawn on(Topology::GPU)` places the region and the four operands really
// are transferred into GPU_HBM. Then, on a box with a device, the #251
// emission path launches the compiler's own kernel image:
//
//   [Vx CUDA] device 0 stage      x4
//   [Vx CUDA] vx_npu_kernel_0 ran on GPU 0 from its own image (28 params)
//
// -- as one thread, because the outliner emits a serial loop nest and a wide
// launch of it would race. So a GPU number from this file prices the emission
// path working, not the device's parallelism; the distance to cuBLAS is now
// parallelism, not placement. On a box with no device the same file is the
// CPU baseline (host JIT at -O0, which the log states plainly), and the two
// are directly comparable because the kernel body is identical.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: vx.transfer
// CHECK-SAME: cost =
// CHECK: vx.spawn topology(500)

import std::math;

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s
}

fn main() -> i32 {
  let mut q_h = Tensor<f32>([ __VX_SQ__, __VX_HD__ ]);
  let mut k_h = Tensor<f32>([ __VX_SK__, __VX_HD__ ]);
  let mut v_h = Tensor<f32>([ __VX_SK__, __VX_HD__ ]);
  let mut o_h = Tensor<f32>([ __VX_SQ__, __VX_HD__ ]);

  // The same pattern the fixed-size version uses, extended: row j of K and V
  // holds j, scaled down so the exponentials stay in range as the sequence
  // grows. Values that vary per row are what stop a backend from being right
  // while ignoring an operand.
  for i in 0..__VX_SQ__ {
    for d in 0..__VX_HD__ {
      q_h[i][d] = (i as f32) * 0.01;
      o_h[i][d] = 0.0;
    }
  }
  for j in 0..__VX_SK__ {
    for d in 0..__VX_HD__ {
      k_h[j][d] = (j as f32) * 0.01;
      v_h[j][d] = (j as f32) * 0.01;
    }
  }

  // Capacity-checked against GPU_HBM and costed from its bandwidth.
  let q = transfer(q_h, Memory::GPU_HBM);
  let k = transfer(k_h, Memory::GPU_HBM);
  let v = transfer(v_h, Memory::GPU_HBM);
  let mut o = transfer(o_h, Memory::GPU_HBM);
  let scale : f32 = 0.5;

  // The body is the pure online softmax, one key at a time, written in slices
  // (Vx#378 R1: `dot` is the Reduce opcode, the row updates vector arith,
  // both reaching the device as v4 accesses).
  //
  // The accumulator lives in `acc`, a thread-private row, not in `o` (R2a).
  // The R1 numbers said the o-row round trip was the traffic: rescale and
  // axpy each read and wrote the row in GLOBAL memory once per key -- 64
  // v4 transactions per key against K's 16 and V's 16. Accumulating in the
  // thread's own row keeps that in the local depot (L1-cached), and `o[i]`
  // is written once per query, at the end, already normalized. The zero at
  // the top of each query is `q[i] * 0.0` because an alloca's initial
  // contents are garbage that `* 0.0` would keep as NaN.
  spawn on(Topology::GPU) {
    // Placed where the tensors it exchanges rows with live. It used to be an
    // unplaced Tensor<f32>([..]), so `acc[0] = q[i] * 0.0` assigned a GPU_HBM row
    // to a CPU_DRAM one and the template stopped compiling; the spelling also
    // predates placement being carried in the type.
    let mut acc = Tensor<f32, [1, __VX_HD__], Memory::GPU_HBM>::uninit();
    for i in 0..__VX_SQ__ {
      acc[0] = q[i] * 0.0;
      let mut m : f32 = -1000000.0;
      let mut l : f32 = 0.0;
      for j in 0..__VX_SK__ {
        let s : f32 = dot(q[i], k[j]) * scale;
        let m_new : f32 = if s > m {
          s
        } else {
          m
        };
        let corr : f32 = (m - m_new).exp();
        let p : f32 = (s - m_new).exp();
        l = l * corr + p;
        acc[0] = acc[0] * corr;
        acc[0] = acc[0] + v[j] * p;
        m = m_new;
      }
      let inv : f32 = 1.0 / l;
      o[i] = acc[0] * inv;
    }
  }

  // Bring the result home before looking at it. `o` lives in GPU_HBM: the
  // checker refuses `o[0][0]` from the CPU, which is the memory model doing
  // its job, and `print(o)` is no better -- it walks the same device pointer
  // on the host and faults the first time a device is actually present
  // (Vx#377). The declared transfer is the path that brings it back: it
  // lowers to the plugin's read-back, and the movement is priced by the
  // algebra instead of hidden inside printing.
  //
  // The harness redirects the print and reads only the first row -- whose
  // value is a closed form: row 0 of Q is all zeros, so every score is zero,
  // the softmax is uniform, and o[0][d] is the mean of column d of V, which
  // is 0.01*(SK-1)/2.
  let o_home = transfer(o, Memory::CPU_DRAM);
  print(o_home);
  return 0;
}
