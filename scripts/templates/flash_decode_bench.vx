//===----------------------------------------------------------------------===//
//
// The decode half of the attention story (#251). Prefill is
// flash_attention_bench.vx: many queries, arithmetic-shaped, parallel over
// queries. Decode is one query per head against the whole KV cache, so there
// is no query loop to parallelize and the kernel is a read of H*SK*HD*4*2
// bytes that must come from memory. The number that matters is GB/s against
// the device's HBM, not GFLOP/s against its ALUs.
//
// __VX_BENCH_NOTE__
//
// Parallelism, since one query offers none: flash-decoding's split-K, written
// as two placed regions.
//
//   region 1  for hc in 0..H*C -- each (head, chunk) walks its SK/C keys with
//             the one-pass online softmax and writes an UNNORMALIZED partial:
//             pml[hc] = [m, l] (chunk max score, sum of exponentials against
//             it) and po[hc][d] = sum_j p_j * V[j][d], as whole-row slice
//             updates. Rows are owned by hc, so the disjointness rule admits
//             the loop and the device pipeline grid-strides it (Vx#251) --
//             H*C threads, reading K and V once each, as vectors (Vx#378 R1).
//   region 2  for x in 0..H*HD -- rescale the C partials of pair (h, d) onto
//             head h's true max and normalize: the same algebra the online
//             softmax applies per tile, applied once per chunk. Each x owns
//             one output element (`o[x][0]`), so the combine scales with the
//             split instead of bounding it (Vx#378 R4).
//
// The split changes where parallelism comes from and nothing else: C=1 is
// vanilla single-thread-per-head decode, and any C must print the same
// numbers. The harness checks that, not this file.
//
// Q is all zeros, so every score is zero, the softmax is uniform, and
// o[h][d] is the mean of column d of head h's V -- 0.01*(SK-1)/2 for the
// fill below, independent of H, C and d. A split that dropped a chunk, or
// combined two with the wrong rescale, moves the mean.
//
// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s
// CHECK: vx.transfer
// CHECK-SAME: cost =
// CHECK: vx.spawn topology(500)

import std::math;

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s
}

fn main() -> i32 {
  // One query row per head; K and V hold H heads' caches stacked: head h's
  // position j is row h*SK + j. Partials are one row per (head, chunk), split
  // into an [m, l] pair and an HD-wide accumulator so the accumulator can be
  // written as a whole row -- slice writes are the vector-load path (Vx#378).
  let mut q_h = Tensor<f32>([ __VX_H__, __VX_HD__ ]);
  let mut k_h = Tensor<f32>([ __VX_HSK__, __VX_HD__ ]);
  let mut v_h = Tensor<f32>([ __VX_HSK__, __VX_HD__ ]);
  let mut pml_h = Tensor<f32>([ __VX_HC__, 2 ]);
  let mut gml_h = Tensor<f32>([ __VX_HG__, 2 ]);
  let mut hml_h = Tensor<f32>([ __VX_H__, 2 ]);
  let mut pw_h = Tensor<f32>([ __VX_HC__, 1 ]);
  let mut pog_h = Tensor<f32>([ __VX_HG__, __VX_HD__ ]);
  let mut po_h = Tensor<f32>([ __VX_HC__, __VX_HD__ ]);
  // Flat [H*HD][1] rather than [H][HD]: the combine parallelizes over
  // (head, dim) pairs, and the disjointness rule wants each thread's write
  // led by its own induction variable -- which `o[x][0]` is and `o[h][d]`
  // is not.
  let mut o_h = Tensor<f32>([ __VX_HHD__, 1 ]);

  for h in 0..__VX_H__ {
    for d in 0..__VX_HD__ {
      q_h[h][d] = 0.0;
    }
  }
  for x in 0..__VX_HHD__ {
    o_h[x][0] = 0.0;
  }
  // The partial accumulators must start at zero: region 1's online rescale
  // multiplies the running row, so whatever is here is folded into the
  // result. Tensor allocation does not promise zeros -- `o_h` above is
  // cleared for the same reason.
  for h in 0..__VX_H__ {
    hml_h[h][0] = 0.0;
    hml_h[h][1] = 0.0;
  }
  for g in 0..__VX_HG__ {
    gml_h[g][0] = 0.0;
    gml_h[g][1] = 0.0;
    for d in 0..__VX_HD__ {
      pog_h[g][d] = 0.0;
    }
  }
  for r in 0..__VX_HC__ {
    pw_h[r][0] = 0.0;
    pml_h[r][0] = 0.0;
    pml_h[r][1] = 0.0;
    for d in 0..__VX_HD__ {
      po_h[r][d] = 0.0;
    }
  }
  // Position j carries j, scaled to keep the exponentials in range at any SK
  // -- the same fill the prefill bench uses, so the closed form matches.
  for r in 0..__VX_HSK__ {
    for d in 0..__VX_HD__ {
      k_h[r][d] = 0.01;
      v_h[r][d] = 0.0;
    }
  }
  for h in 0..__VX_H__ {
    for j in 0..__VX_SK__ {
      for d in 0..__VX_HD__ {
        v_h[h * __VX_SK__ + j][d] = (j as f32) * 0.01;
      }
    }
  }

  let q = transfer(q_h, Memory::GPU_HBM);
  let k = transfer(k_h, Memory::GPU_HBM);
  let v = transfer(v_h, Memory::GPU_HBM);
  let mut pml = transfer(pml_h, Memory::GPU_HBM);
  let mut gml = transfer(gml_h, Memory::GPU_HBM);
  let mut hml = transfer(hml_h, Memory::GPU_HBM);
  let mut pog = transfer(pog_h, Memory::GPU_HBM);
  let mut pw = transfer(pw_h, Memory::GPU_HBM);
  let mut po = transfer(po_h, Memory::GPU_HBM);
  let mut o = transfer(o_h, Memory::GPU_HBM);
  let scale : f32 = 0.5;

  // Region 1: each (head, chunk) reduces its slice of the cache to one
  // unnormalized partial, with the same one-pass online softmax the prefill
  // kernel runs -- each K row is read once, as vectors. The accumulator row
  // starts zeroed (host-side fill above), so the first rescale multiplies
  // zero and no explicit clear is needed.
  spawn on(Topology::GPU) {
    let mut acc = Tensor<f32>([ 1, __VX_HD__ ]);
    for hc in 0..__VX_HC__ {
      let h : i32 = hc / __VX_C__;
      let c : i32 = hc - h * __VX_C__;
      let base : i32 = h * __VX_SK__;

      // Accumulate in the thread's own row (R2a, same reasoning as the
      // prefill bench): the online rescale round-tripped po[hc] through
      // global memory once per key; here it stays in the local depot and
      // the partial row is written once, at the end.
      //
      // Chunk c owns keys {c, c+C, c+2C, ...}, not a contiguous block
      // (Vx#378 R3a). The online merge is associative, so the assignment is
      // free to choose -- and this one makes warp-adjacent threads
      // (adjacent hc, same h) touch ADJACENT rows at every step: one
      // contiguous span per warp-step instead of 32 spans a chunk apart.
      // The set of keys per (head, chunk) partition is unchanged, which the
      // closed form checks because V varies by position.
      acc[0] = q[h] * 0.0;
      let mut m : f32 = -1000000.0;
      let mut l : f32 = 0.0;
      for jj in 0..__VX_CHUNK__ {
        let s : f32 = dot(q[h], k[base + c + jj * __VX_C__]) * scale;
        let m_new : f32 = if s > m {
          s
        } else {
          m
        };
        let corr : f32 = (m - m_new).exp();
        let p : f32 = (s - m_new).exp();
        l = l * corr + p;
        acc[0] = acc[0] * corr;
        acc[0] = acc[0] + v[base + c + jj * __VX_C__] * p;
        m = m_new;
      }
      po[hc] = acc[0] * 1.0;
      pml[hc][0] = m;
      pml[hc][1] = l;
    }
  }

  // The combine, as a two-level reduction tree (Vx#378 R4). Every level is
  // the same online-merge algebra and the same disjointness shape: a strided
  // loop whose iteration owns one output row. The measurements forced each
  // level into existence -- the serial combine bounded the split at 8
  // threads, the flat (h, d) combine at its scalar column reads, and the
  // per-head scan at 8 threads again once everything else was parallel.
  //
  //   2a  per (head, group):  max and normalizer over the group's C/G chunks.
  //   2b  per head:           merge G group [m, l] pairs -- G reads, not C.
  //   2c  per (head, chunk):  the chunk's rescale weight, one exp.
  //   2d  per (head, group):  weighted slice-sum of the group's po rows --
  //                           vector axpys over contiguous rows.
  //   2e  per (head, dim):    sum G group columns and normalize -- G scalar
  //                           reads, not C.
  //
  // Six dispatches where one serial loop stood: this is a reduction tree
  // hand-built from the one primitive the prover admits, and the repetition
  // is the argument for a language-level parallel reduce (R3 proper).
  spawn on(Topology::GPU) {
    for hg in 0..__VX_HG__ {
      let h : i32 = hg / __VX_G__;
      let g : i32 = hg - h * __VX_G__;
      let base : i32 = h * __VX_C__ + g * __VX_CPG__;
      let mut m : f32 = -1000000.0;
      for c in 0..__VX_CPG__ {
        let pm : f32 = pml[base + c][0];
        if pm > m {
          m = pm;
        }
      }
      let mut l : f32 = 0.0;
      for c in 0..__VX_CPG__ {
        l = l + pml[base + c][1] * (pml[base + c][0] - m).exp();
      }
      gml[hg][0] = m;
      gml[hg][1] = l;
    }
  }

  spawn on(Topology::GPU) {
    for h in 0..__VX_H__ {
      let mut m : f32 = -1000000.0;
      for g in 0..__VX_G__ {
        let gm : f32 = gml[h * __VX_G__ + g][0];
        if gm > m {
          m = gm;
        }
      }
      let mut l : f32 = 0.0;
      for g in 0..__VX_G__ {
        l = l + gml[h * __VX_G__ + g][1] * (gml[h * __VX_G__ + g][0] - m).exp();
      }
      hml[h][0] = m;
      hml[h][1] = l;
    }
  }

  spawn on(Topology::GPU) {
    for hc in 0..__VX_HC__ {
      let h : i32 = hc / __VX_C__;
      pw[hc][0] = (pml[hc][0] - hml[h][0]).exp();
    }
  }

  spawn on(Topology::GPU) {
    let mut gacc = Tensor<f32>([ 1, __VX_HD__ ]);
    for hg in 0..__VX_HG__ {
      let h : i32 = hg / __VX_G__;
      let g : i32 = hg - h * __VX_G__;
      let base : i32 = h * __VX_C__ + g * __VX_CPG__;
      gacc[0] = q[h] * 0.0;
      for c in 0..__VX_CPG__ {
        gacc[0] = gacc[0] + po[base + c] * pw[base + c][0];
      }
      pog[hg] = gacc[0] * 1.0;
    }
  }

  spawn on(Topology::GPU) {
    for x in 0..__VX_HHD__ {
      let h : i32 = x / __VX_HD__;
      let d : i32 = x - h * __VX_HD__;
      let mut s : f32 = 0.0;
      for g in 0..__VX_G__ {
        s = s + pog[h * __VX_G__ + g][d];
      }
      o[x][0] = s / hml[h][1];
    }
  }

  // Home before looking -- the declared edge, priced by the algebra (Vx#377).
  let o_home = transfer(o, Memory::CPU_DRAM);
  print(o_home);
  return 0;
}
