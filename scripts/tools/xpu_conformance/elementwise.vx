  let ga1 = transfer(a1, Memory::GPU_HBM);
  let gb1 = transfer(b1, Memory::GPU_HBM);
  let gc1 = transfer(c1, Memory::GPU_HBM);
  let mut go1 = transfer(o1, Memory::GPU_HBM);
