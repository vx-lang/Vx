//===----------------------------------------------------------------------===//
// One placed region per element type the Arc machine model declares, each
// computing `o = a * b + c` over a 32x32 tensor. The values stay inside the
// narrowest type (i4), so a type the device stores differently from the host
// shows up as a wrong number rather than as an overflow.
//
// Each region's result is summed back on the host and printed, one number per
// type, so running the whole program on the CPU and on the Arc and comparing
// the two lines covers every declared type -- including i4, u4 and bool, whose
// four-bit and one-bit elements no hand-built descriptor can address.
//
// The runner (scripts/tools/vx_xpu_conformance.sh) also drives the first eleven
// types one at a time through the dispatch ABI, element by element.
//
// The regions are in this order, and the runner pairs the dispatch order with
// it: f32 f16 i8 u8 i16 u16 i32 u32 i64 u64 i4 u4 bool.

Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 40 GiB, bandwidth: 3 TB/s, managed: cached
}
Topology Dev {
  arch: spirv64,
  memory: Memory::GPU_HBM,
  visible: [Memory::GPU_HBM],
  transfer Memory::CPU_DRAM -> Memory::GPU_HBM : 63 GB/s,
  transfer Memory::GPU_HBM -> Memory::CPU_DRAM : 60 GB/s
}

fn main() -> i32 {
  let mut a0 = Tensor<f32, [32, 32]>::uninit();
  let mut b0 = Tensor<f32, [32, 32]>::uninit();
  let mut c0 = Tensor<f32, [32, 32]>::uninit();
  let mut o0 = Tensor<f32, [32, 32]>::uninit();
  for i in 0..32 {
    for j in 0..32 {
      a0[i][j] = ((i + j) % 4) as f32;
      b0[i][j] = 2 as f32;
      c0[i][j] = 1 as f32;
      o0[i][j] = 0 as f32;
    }
  }
  let ga0 = transfer(a0, Memory::GPU_HBM);
  let gb0 = transfer(b0, Memory::GPU_HBM);
  let gc0 = transfer(c0, Memory::GPU_HBM);
  let mut go0 = transfer(o0, Memory::GPU_HBM);
  spawn on(Topology::Dev) {
    for i in 0..32 {
      let ar = ga0[i];
      let br = gb0[i];
      let cr = gc0[i];
      let mut orow = go0[i];
      for j in 0..32 {
        orow[j] = ar[j] * br[j] + cr[j];
      }
    }
  }
  let back0 = transfer(go0, Memory::CPU_DRAM);

  // The whole result as a single exact integer, so one printed number covers
  // every element of this type's tensor.
  let mut sum0 = 0;
  for i in 0..32 {
    for j in 0..32 {
      sum0 = sum0 + (back0[i][j] as i32);
    }
  }
  print(sum0);
  print!(" ");

  let mut a1 = Tensor<f16, [32, 32]>::uninit();
  let mut b1 = Tensor<f16, [32, 32]>::uninit();
  let mut c1 = Tensor<f16, [32, 32]>::uninit();
