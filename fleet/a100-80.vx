//===----------------------------------------------------------------------===//
// One SKU's memory hierarchy, for `vxc --machine fleet/a100-80.vx prog.vx`.
// See fleet/README.md for the shared space vocabulary and provenance policy.
//
// HBM figures verified 2026-08-03 against the NVIDIA A100 product page (80GB
// SXM column). On-die figures (L2, SMEM) remain unverified -- see
// fleet/README.md.
//
// Same die as a100-40: identical L2 and SMEM, double the HBM at higher
// bandwidth. The pair isolates *capacity* as the admission variable, which is
// what makes it a useful adjacent column in the matrix.

// spec: NVIDIA A100 product page, 80GB SXM column (verified 2026-08-03) --
// GPU Memory "80GB HBM2e", GPU Memory Bandwidth "2,039 GB/s".
Memory HBM {
  capacity: 80 GiB, bandwidth: 2039 GB/s, managed: explicit, scope: device
}

// spec: NVIDIA Ampere Architecture Whitepaper -- 40 MB L2 cache.
Memory L2 {
  within: Memory::HBM, capacity: 40 MiB, bandwidth: 7 TB/s, managed: cached, scope: device
}

// spec: NVIDIA Ampere Architecture Whitepaper / CUDA C Programming Guide --
// 164 KB configurable shared memory per SM.
Memory SMEM {
  // replicas: UNVERIFIED: A100 SM count, vendor figure
  // clock: UNVERIFIED: A100 boost clock, vendor figure
  within: Memory::L2, capacity: 164 KiB, bandwidth: 128 B/cyc, clock: 1.41 GHz, granule: 1 KiB, managed: explicit, scope: sm, replicas: 108
}

Topology Device {
  // spec: NVIDIA Ampere GA100; LLVM's NVPTX target.
  arch: nvptx64,
  memory: Memory::HBM,
  visible: [Memory::HBM, Memory::L2, Memory::SMEM],
  // spec: NVIDIA A100 Tensor Core GPU Architecture whitepaper v1.0, p.26 and Table 2 (p.23).
  // Same GA100 die as a100-40, so the same vocabulary. No FP8; that arrives with Hopper.
  dtypes: [f64, f32, bf16, f16, i4, u4, i8, u8, i16, u16, i32, u32, i64, u64, bool],
  // spec: PCIe Gen4 x16 = 31.5 GB/s per direction (16 GT/s x 16 lanes, 128b/130b).
  // UNVERIFIED on this SKU; the host link and its achieved bandwidth are experiment M1/M4.
  // The on-die hops below declare no cost -- their `bandwidth:` figures derive it (E6013).
  transfer Memory::CPU_DRAM -> Memory::HBM : 31.5 GB/s,
  // The way home, at the same per-direction rate the spec note above gives.
  // Reading a placed tensor back is how a program says it still holds it;
  // without the edge the model can only describe one direction.
  transfer Memory::HBM -> Memory::CPU_DRAM : 31.5 GB/s,
  transfer Memory::HBM -> Memory::L2,
  // spec: Ampere's cp.async copies global memory into shared memory without passing through
  // registers (PTX ISA 8.3 section 9.7.8.24). Declaring the engine is what makes
  // `raw::async_copy` legal in an `impl Transfer` lowering for this hop (Vx#353 A2).
  transfer Memory::L2 -> Memory::SMEM copy_engine
}
