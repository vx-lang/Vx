//===----------------------------------------------------------------------===//
// One SKU's memory hierarchy, for `vxc --machine fleet/h200.vx prog.vx`.
// See fleet/README.md for the shared space vocabulary and provenance policy.
//
// HBM figures verified 2026-08-03 against NVIDIA's H200 product materials.
// On-die figures (L2, SMEM) remain unverified -- see fleet/README.md.
//
// Same Hopper die as h100-sxm with HBM3e: the on-chip budget is unchanged, so
// a config that fails on SMEM fails identically here. Only capacity-bound and
// bandwidth-bound configs move.

// spec: NVIDIA H200 Tensor Core GPU (verified 2026-08-03) -- 141 GB HBM3e at
// 4.8 TB/s. The odd capacity is the vendor figure (six stacks of 24 GB HBM3e
// less reserved), not a typo for 144.
Memory HBM {
  capacity: 141 GiB, bandwidth: 4.8 TB/s, managed: explicit, scope: device
}

// spec: NVIDIA Hopper Architecture Whitepaper -- 50 MB L2 cache.
Memory L2 {
  within: Memory::HBM, capacity: 50 MiB, bandwidth: 12 TB/s, managed: cached, scope: device
}

// spec: NVIDIA Hopper Architecture Whitepaper / CUDA C Programming Guide --
// 228 KB configurable shared memory per SM.
Memory SMEM {
  // replicas: UNVERIFIED: same GH100 die as h100-sxm
  // clock: UNVERIFIED: same GH100 die as h100-sxm
  within: Memory::L2, capacity: 228 KiB, bandwidth: 128 B/cyc, clock: 1.98 GHz, granule: 1 KiB, managed: explicit, scope: sm, replicas: 132
}

Topology Device {
  // spec: NVIDIA Hopper GH100; LLVM's NVPTX target.
  arch: nvptx64,
  memory: Memory::HBM,
  visible: [Memory::HBM, Memory::L2, Memory::SMEM],
  // spec: PCIe Gen5 x16 = 63 GB/s per direction (32 GT/s x 16 lanes, 128b/130b).
  // UNVERIFIED on this SKU; a Grace/C2C-attached part reaches the host at ~450 GB/s instead,
  // a 7x difference in every host-seam prediction. Settling it is experiment M1/M4.
  // The on-die hops below declare no cost -- their `bandwidth:` figures derive it (E6013).
  transfer Memory::CPU_DRAM -> Memory::HBM : 63 GB/s,
  transfer Memory::HBM -> Memory::L2,
  transfer Memory::L2 -> Memory::SMEM
}
