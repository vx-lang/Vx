//===----------------------------------------------------------------------===//
// One SKU's memory hierarchy, for `vxc --machine fleet/mi300x.vx prog.vx`.
// See fleet/README.md for the shared space vocabulary and provenance policy.
//
// HBM and Infinity Cache figures verified 2026-08-03 against AMD's MI300X
// product materials. LDS figure remains unverified -- see fleet/README.md.
//
// The non-NVIDIA column, and the reason the vocabulary is deliberately generic:
// AMD's names differ (LDS, not shared memory; Infinity Cache, not L2) but the
// *roles* in a placement decision are the same, so one program admits against
// this SKU unchanged. Where the mapping is a judgment call it is called out
// below rather than buried.

// spec: AMD Instinct MI300X (verified 2026-08-03) -- 192 GB HBM3, peak memory
// bandwidth 5.3 TB/s.
Memory HBM {
  capacity: 192 GiB, bandwidth: 5.3 TB/s, managed: explicit, scope: device
}

// spec: AMD Instinct MI300X (verified 2026-08-03) -- 256 MB Infinity Cache.
// Modelled under the shared name `L2` because it occupies the same slot in a
// placement decision (device-scoped, hardware-managed, last level before HBM),
// though architecturally it sits below a smaller per-XCD L2 not modelled here.
Memory L2 {
  within: Memory::HBM, capacity: 256 MiB, bandwidth: 17 TB/s, managed: cached, scope: device
}

// spec: AMD CDNA 3 Architecture Whitepaper -- 64 KB LDS per compute unit.
// Named `SMEM` for vocabulary compatibility; a CU is the scope analogue of an
// SM. Materially smaller than NVIDIA's 164-228 KB, so an on-chip tiling that
// fits every NVIDIA SKU can still be rejected here -- exactly the kind of
// cross-vendor result the matrix should surface rather than hide.
Memory SMEM {
  within: Memory::L2, capacity: 64 KiB, bandwidth: 128 B/cyc, granule: 1 KiB, managed: explicit, scope: sm
}

Topology Device {
  // spec: AMD CDNA 3; LLVM's AMDGPU target.
  arch: amdgcn,
  memory: Memory::HBM,
  visible: [Memory::HBM, Memory::L2, Memory::SMEM],
  // spec: PCIe Gen5 x16 = 63 GB/s per direction (32 GT/s x 16 lanes, 128b/130b).
  // UNVERIFIED on this SKU; a Grace/C2C-attached part reaches the host at ~450 GB/s instead,
  // a 7x difference in every host-seam prediction. Settling it is experiment M1/M4.
  // The on-die hops below declare no cost -- their `bandwidth:` figures derive it (E6013).
  transfer Memory::CPU_DRAM -> Memory::HBM : 63 GB/s,
  transfer Memory::HBM -> Memory::L2,
  transfer Memory::L2 -> Memory::SMEM
}
