//===----------------------------------------------------------------------===//
// One SKU's memory hierarchy, for `vxc --machine fleet/a100-40.vx prog.vx`.
// See fleet/README.md for the shared space vocabulary and provenance policy.
//
// HBM figures verified 2026-08-03 against the NVIDIA A100 datasheet.
// On-die figures (L2, SMEM) remain unverified -- see fleet/README.md.
//
// The smallest SKU in the fleet: the config that fits here but nowhere smaller
// is the interesting boundary case for the admission matrix.

// spec: NVIDIA A100 Tensor Core GPU Datasheet (verified 2026-08-03) -- 40 GB
// HBM2 at 1,555 GB/s. Note HBM2, not HBM2e: the 80 GB part moved to HBM2e.
Memory HBM {
  capacity: 40 GiB, bandwidth: 1555 GB/s, managed: explicit, scope: device
}

// spec: NVIDIA Ampere Architecture Whitepaper -- 40 MB L2 cache.
Memory L2 {
  within: Memory::HBM, capacity: 40 MiB, bandwidth: 7 TB/s, managed: cached, scope: device
}

// spec: NVIDIA Ampere Architecture Whitepaper / CUDA C Programming Guide --
// 164 KB configurable shared memory per SM.
Memory SMEM {
  // replicas: UNVERIFIED: A100 SM count, vendor figure
  // clock: UNVERIFIED: A100 boost clock, vendor figure
  within: Memory::L2, capacity: 164 KiB, bandwidth: 128 B/cyc, clock: 1.41 GHz, granule: 1 KiB, managed: explicit, scope: sm, replicas: 108
}

Topology Device {
  // spec: NVIDIA Ampere GA100; LLVM's NVPTX target.
  arch: nvptx64,
  memory: Memory::HBM,
  visible: [Memory::HBM, Memory::L2, Memory::SMEM],
  // spec: PCIe Gen4 x16 = 31.5 GB/s per direction (16 GT/s x 16 lanes, 128b/130b).
  // UNVERIFIED on this SKU; the host link and its achieved bandwidth are experiment M1/M4.
  // The on-die hops below declare no cost -- their `bandwidth:` figures derive it (E6013).
  transfer Memory::CPU_DRAM -> Memory::HBM : 31.5 GB/s,
  transfer Memory::HBM -> Memory::L2,
  transfer Memory::L2 -> Memory::SMEM
}
