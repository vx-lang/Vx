// Moving values around without looking at what they are.
//
// `size_of` is the existing `sizeof<T>()` intrinsic under another name. `swap` and
// `replace` are the two ways to put a value where another one was, and both are safe: the
// old value comes back rather than being lost.
//
// `drop` ends a value's life early, running its `drop` and its fields'. `forget` ends it
// without running anything, by moving it into a `ManuallyDrop`, which is never dropped.
//
// Still missing, each waiting on something outside this file:
//
//   `align_of`               wants an intrinsic beside `sizeof`, which does not exist.
//   `take`                   `T::default()` on a bounded type parameter reports an
//                            undefined static method, so there is no value to leave behind.
//   `zeroed`, `transmute`    want a bit-level cast this module cannot yet spell.
//   `MaybeUninit`            wants a value that may not hold a `T` yet.
//   `discriminant`           wants to read an enum's tag as a value.

/// The size of `T` in bytes.
fn size_of<T>() -> i64 {
  return sizeof<T>();
}

/// Each value ends up where the other one was.
fn swap<T>(a : &mut T, b : &mut T) -> void {
  let t = *a;
  *a = *b;
  *b = t;
}

/// `src` goes in, and what was there comes back.
fn replace<T>(dest : &mut T, src : T) -> T {
  let old = *dest;
  *dest = src;
  return old;
}

/// Drops the value now, rather than at the end of the caller's block.
fn drop<T>(_x : T) -> void {
}

/// Holds a value and never drops it. Its `value` can still be read, and moved out.
struct ManuallyDrop<T> {
  value : T,
}

/// Ends the value's life without dropping it: what it owns is never released.
fn forget<T>(x : T) -> void {
  let _kept = ManuallyDrop<T> {
    value : x
  };
}

/// Whether dropping a `T` does any work: runs a `drop`, or frees memory. The checker answers
/// each call with the type it names, so this body is never used.
fn needs_drop<T>() -> bool {
  return false;
}
