//====---------------------------------------------------------------------===//
// Raw pointers: making one, moving it, comparing it, and reading or writing through it.
//
// `read` and `write` are `unsafe fn` because nothing here checks that the pointer is
// valid. The others are safe: making, moving or comparing a pointer is fine, and using
// one is what they cannot promise.
//
// Vx has no pointer arithmetic, and `==` on two pointers is not in the flat code
// generator. So `offset` and `eq` are each one LLVM operation in an `mlir!` block.
//
// A pointer that `offset`, `add` or `sub` returns keeps its argument borrowed `&mut`
// while it is in use, as any result made from a parameter does. It also keeps the memory
// of its argument, such as `in Memory::GPU_HBM`. `read` and `write` take a host pointer.
//
// `NonNull<T>` is a `*mut T` that is never null. It is a struct with one pointer field,
// because a raw pointer cannot have methods. It has `new`, `new_unchecked` and `as_ptr`. `new`
// answers an `Option`, so this file imports `core::option`, and so does every file that imports
// this one.
//
// Still missing:
//
//   `copy`                   wants `llvm.intr.memmove` through `mlir!`, as
//                            `copy_nonoverlapping` uses `llvm.intr.memcpy`.
//   `read_volatile`,         want the volatile forms of the load and store.
//   `write_volatile`

import core::marker;
import core::option;

/// A pointer to nothing.
pub fn null<T>() -> *const T {
  return unsafe { 0 as *const T };
}

/// A mutable pointer to nothing.
pub fn null_mut<T>() -> *mut T {
  return unsafe { 0 as *mut T };
}

/// The value the pointer addresses. The caller promises there is one, and that only one of
/// the two copies gets dropped. Safe code cannot move a value out of `*p` (E4008).
pub unsafe fn read<T>(p : *const T) -> T {
  return unsafe { *p };
}

/// Puts a value where the pointer addresses. The caller promises it may.
pub unsafe fn write<T>(p : *mut T, v : T) -> void {
  unsafe { *p = v; }
}

/// The pointer `count` elements further on, or back for a negative `count`. Like Rust's
/// `wrapping_offset`, it only computes the address.
pub fn offset<T, M : Memory>(p : *const T in Memory::M, count : i64) -> *const T in Memory::M {
  let bytes = count * sizeof<T>();
  return unsafe { mlir!( inputs : (%p = p : !llvm.ptr, %b = bytes : i64), returns : *const T in Memory::M, dialects : ["llvm"]) {
      %r = llvm.getelementptr %p[%b] : (!llvm.ptr, i64) -> !llvm.ptr, i8
      macro.yield %r : !llvm.ptr
    } };
}

/// `offset` for a mutable pointer.
pub fn offset_mut<T, M : Memory>(p : *mut T in Memory::M, count : i64) -> *mut T in Memory::M {
  let bytes = count * sizeof<T>();
  return unsafe { mlir!( inputs : (%p = p : !llvm.ptr, %b = bytes : i64), returns : *mut T in Memory::M, dialects : ["llvm"]) {
      %r = llvm.getelementptr %p[%b] : (!llvm.ptr, i64) -> !llvm.ptr, i8
      macro.yield %r : !llvm.ptr
    } };
}

/// Copies `count` values from `src` to `dst`, as C's `memcpy` does. The two ranges must not
/// overlap. The values are copied bit for bit, so for a type that is not `Copy`, only one of the
/// two copies may be dropped.
pub unsafe fn copy_nonoverlapping<T>(src : *const T, dst : *mut T, count : usize) -> void {
  let bytes = (count as i64) * sizeof<T>();
  let _copied : i64 = mlir!( inputs : (%s = src : !llvm.ptr, %d = dst : !llvm.ptr, %b = bytes : i64), returns : i64, dialects : ["llvm"]) {
    "llvm.intr.memcpy"(%d, %s, %b) < {
      isVolatile = false
    }> : (!llvm.ptr, !llvm.ptr, i64) -> ()
    macro.yield %b : i64
  };
}

/// Sets each byte of `count` values at `dst` to `byte`, as C's `memset` does.
pub unsafe fn write_bytes<T>(dst : *mut T, byte : u8, count : usize) -> void {
  let bytes = (count as i64) * sizeof<T>();
  let _written : i64 = mlir!( inputs : (%d = dst : !llvm.ptr, %v = byte : i8, %b = bytes : i64), returns : i64, dialects : ["llvm"]) {
    "llvm.intr.memset"(%d, %v, %b) < {
      isVolatile = false
    }> : (!llvm.ptr, i8, i64) -> ()
    macro.yield %b : i64
  };
}

/// The pointer `count` elements further on.
pub fn add<T, M : Memory>(p : *const T in Memory::M, count : usize) -> *const T in Memory::M {
  return offset(p, count as i64);
}

/// `add` for a mutable pointer.
pub fn add_mut<T, M : Memory>(p : *mut T in Memory::M, count : usize) -> *mut T in Memory::M {
  return offset_mut(p, count as i64);
}

/// The pointer `count` elements back.
pub fn sub<T, M : Memory>(p : *const T in Memory::M, count : usize) -> *const T in Memory::M {
  return offset(p, -(count as i64));
}

/// `sub` for a mutable pointer.
pub fn sub_mut<T, M : Memory>(p : *mut T in Memory::M, count : usize) -> *mut T in Memory::M {
  return offset_mut(p, -(count as i64));
}

/// Whether the two pointers hold the same address.
pub fn eq<T>(a : *const T, b : *const T) -> bool {
  return unsafe { mlir!( inputs : (%a = a : !llvm.ptr, %b = b : !llvm.ptr), returns : bool, dialects : ["llvm"]) {
      %r = llvm.icmp "eq" %a, %b : !llvm.ptr
      macro.yield %r : i1
    } };
}

/// Whether the pointer is null.
pub fn is_null<T>(p : *const T) -> bool {
  return eq(p, null<T>());
}

/// `is_null` for a mutable pointer.
pub fn is_null_mut<T>(p : *mut T) -> bool {
  return is_null(p as *const T);
}

/// A `*mut T` that is never null. It copies, as a raw pointer does. It has an invariant, so only
/// code in this file can build one from its field. That keeps a null pointer out of it.
struct NonNull<T> {
  ptr : *mut T,

  invariant true,
}

impl<T> Copy for NonNull<T> {}

impl<T> NonNull<T> {
  /// `None` when `p` is null, and `Some` of the same pointer otherwise.
  pub fn new(p : *mut T) -> Option<NonNull<T>> {
    if is_null_mut(p) {
      return Option<NonNull<T>>::None;
    }
    return Option<NonNull<T>>::Some(NonNull<T> {
      ptr : p
    });
  }

  /// A `NonNull` of `p`. The caller promises that `p` is not null. A null `p` fails an `assert`
  /// rather than making a `NonNull` that holds null.
  pub unsafe fn new_unchecked(p : *mut T) -> NonNull<T> {
    assert(!is_null_mut(p), "new_unchecked: the pointer is null");
    return NonNull<T> {
      ptr : p
    };
  }

  /// The pointer.
  pub fn as_ptr(self : NonNull<T>) -> *mut T {
    return self.ptr;
  }
}
