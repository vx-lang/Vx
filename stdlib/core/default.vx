//===----------------------------------------------------------------------===//
// `Default`: the value a type starts from when nothing better is said.
//
// One static method, called through the type: `i64::default()`, `Option<f32>::default()`.
// A trait method with no `self` is what needed the static lookup to search trait impls.
//
// The answers are Rust's: zero for every number, `false`, `None`. `Ordering` has none in
// Rust either, and none here. A struct gets one by writing the impl; deriving it is not
// something the language does yet.
import core::option;

trait Default {
  /// The value this type starts from: zero for a number, `false`, `None`.
  ///
  /// A static method, so it is called through the type -- `i64::default()`, not `x.default()`.
  /// A struct gets one by writing the impl; the language does not derive it.
  fn default() -> Self;
}

/// Zero, spelled at the width by the return type.
macro_rules stamp_default {
  ($t : ident , $zero : expr) => {
    impl Default for $t {
      /// Zero, spelled at this width.
      fn default() -> $t {
        return $zero;
      }
    }
  };
}

stamp_default!(i8 , 0);
stamp_default!(i16 , 0);
stamp_default!(i32 , 0);
stamp_default!(i64 , 0);
stamp_default!(u8 , 0);
stamp_default!(u16 , 0);
stamp_default!(u32 , 0);
stamp_default!(u64 , 0);
stamp_default!(f32 , 0.0);
stamp_default!(f64 , 0.0);
stamp_default!(bool , false);

impl<T> Default for Option<T> {
  /// `None`, whatever `T` is: an option's default is the absent one.
  fn default() -> Option<T> {
    return Option<T>::None();
  }
}
