// `Hash` and `Hasher`, with SipHash-1-3 and Fx.
//
// A hasher takes one byte at a time: without slices the byte is the only unit every writer
// can agree on, and the wider writes are defaults over it.
// Bytes go in little-endian order.
import core::marker;
import core::num;

trait Hasher {
  fn write_u8(self : &mut Self, b : u8) -> i32;

  fn finish(self : &Self) -> u64;

  fn write_u16(self : &mut Self, v : u16) -> i32 {
    let mut x : u16 = v;
    let mut i : i64 = 0i64;
    loop {
      if i >= 2i64 {
        break;
      }
      self.write_u8((x & 255u16) as u8);
      x = x >> 8u16;
      i = i + 1i64;
    }
    return 0;
  }

  fn write_u32(self : &mut Self, v : u32) -> i32 {
    let mut x : u32 = v;
    let mut i : i64 = 0i64;
    loop {
      if i >= 4i64 {
        break;
      }
      self.write_u8((x & 255u32) as u8);
      x = x >> 8u32;
      i = i + 1i64;
    }
    return 0;
  }

  fn write_u64(self : &mut Self, v : u64) -> i32 {
    let mut x : u64 = v;
    let mut i : i64 = 0i64;
    loop {
      if i >= 8i64 {
        break;
      }
      self.write_u8((x & 255u64) as u8);
      x = x >> 8u64;
      i = i + 1i64;
    }
    return 0;
  }

  fn write_i8(self : &mut Self, v : i8) -> i32 {
    return self.write_u8(v as u8);
  }

  fn write_i16(self : &mut Self, v : i16) -> i32 {
    return self.write_u16(v as u16);
  }

  fn write_i32(self : &mut Self, v : i32) -> i32 {
    return self.write_u32(v as u32);
  }

  fn write_i64(self : &mut Self, v : i64) -> i32 {
    return self.write_u64(v as u64);
  }

  fn write_bool(self : &mut Self, v : bool) -> i32 {
    if v {
      return self.write_u8(1u8);
    }
    return self.write_u8(0u8);
  }
}

trait Hash {
  fn hash<H : Hasher>(self : &Self, state : &mut H) -> i32;
}

/// Stamps `Hash` for one type through the matching `write_` method.
macro_rules stamp_hash {
  ($t : ty, $wr : ident) => {
    impl Hash for $t {
      fn hash<H : Hasher>(self : &$t, state : &mut H) -> i32 {
        return state.$wr(*self);
      }
    }
  };
}

stamp_hash!(u8, write_u8);
stamp_hash!(u16, write_u16);
stamp_hash!(u32, write_u32);
stamp_hash!(u64, write_u64);
stamp_hash!(i8, write_i8);
stamp_hash!(i16, write_i16);
stamp_hash!(i32, write_i32);
stamp_hash!(i64, write_i64);
stamp_hash!(bool, write_bool);

/// rustc's hasher: fast, not resistant to a chosen-key attack.
struct FxHasher {
  acc : u64,
}

impl FxHasher {
  fn new() -> FxHasher {
    return FxHasher {
      acc : 0u64
    };
  }
}

impl Hasher for FxHasher {
  fn write_u8(self : &mut FxHasher, b : u8) -> i32 {
    let mixed : u64 = self.acc.rotate_left(5u64) ^ (b as u64);
    self.acc = mixed.wrapping_mul(5871781006564002453u64);
    return 0;
  }

  fn finish(self : &FxHasher) -> u64 {
    return self.acc;
  }
}

struct SipState {
  v0 : u64,
  v1 : u64,
  v2 : u64,
  v3 : u64,
}

impl Copy for SipState {}

/// One SipRound. Taken and returned by value because four results do not fit a return.
fn sip_round(s : SipState) -> SipState {
  let mut v0 : u64 = s.v0;
  let mut v1 : u64 = s.v1;
  let mut v2 : u64 = s.v2;
  let mut v3 : u64 = s.v3;
  v0 = v0.wrapping_add(v1);
  v1 = v1.rotate_left(13u64);
  v1 = v1 ^ v0;
  v0 = v0.rotate_left(32u64);
  v2 = v2.wrapping_add(v3);
  v3 = v3.rotate_left(16u64);
  v3 = v3 ^ v2;
  v0 = v0.wrapping_add(v3);
  v3 = v3.rotate_left(21u64);
  v3 = v3 ^ v0;
  v2 = v2.wrapping_add(v1);
  v1 = v1.rotate_left(17u64);
  v1 = v1 ^ v2;
  v2 = v2.rotate_left(32u64);
  return SipState {
    v0 : v0, v1 : v1, v2 : v2, v3 : v3
  };
}

/// SipHash-1-3: one round per block, three to finish.
///
/// Bytes are gathered into `buf` and a block is mixed in once eight are there, so the
/// answer depends on how many bytes were written, not on how they were grouped.
struct SipHasher13 {
  v0 : u64,
  v1 : u64,
  v2 : u64,
  v3 : u64,
  buf : u64,
  nbuf : u64,
  length : u64,
}

impl SipHasher13 {
  fn with_keys(k0 : u64, k1 : u64) -> SipHasher13 {
    return SipHasher13 {
      v0 : k0 ^ 8317987319222330741u64,
      v1 : k1 ^ 7237128888997146477u64,
      v2 : k0 ^ 7816392313619706465u64,
      v3 : k1 ^ 8387220255154660723u64,
      buf : 0u64,
      nbuf : 0u64,
      length : 0u64,
    };
  }

  fn new() -> SipHasher13 {
    return SipHasher13::with_keys(0u64, 0u64);
  }
}

impl Hasher for SipHasher13 {
  fn write_u8(self : &mut SipHasher13, b : u8) -> i32 {
    self.buf = self.buf | ((b as u64) << (self.nbuf * 8u64));
    self.nbuf = self.nbuf + 1u64;
    self.length = self.length + 1u64;
    if self.nbuf == 8u64 {
      let m : u64 = self.buf;
      let before : SipState = SipState {
        v0 : self.v0,
        v1 : self.v1,
        v2 : self.v2,
        v3 : self.v3 ^ m,
      };
      let after : SipState = sip_round(before);
      self.v0 = after.v0 ^ m;
      self.v1 = after.v1;
      self.v2 = after.v2;
      self.v3 = after.v3;
      self.buf = 0u64;
      self.nbuf = 0u64;
    }
    return 0;
  }

  fn finish(self : &SipHasher13) -> u64 {
    // The last block carries the byte count in its top byte.
    let b : u64 = ((self.length & 255u64) << 56u64) | self.buf;
    let a0 : SipState = SipState {
      v0 : self.v0,
      v1 : self.v1,
      v2 : self.v2,
      v3 : self.v3 ^ b,
    };
    let a1 : SipState = sip_round(a0);
    let a2 : SipState = SipState {
      v0 : a1.v0 ^ b,
      v1 : a1.v1,
      v2 : a1.v2 ^ 255u64,
      v3 : a1.v3,
    };
    let a3 : SipState = sip_round(a2);
    let a4 : SipState = sip_round(a3);
    let a5 : SipState = sip_round(a4);
    return a5.v0 ^ a5.v1 ^ a5.v2 ^ a5.v3;
  }
}
