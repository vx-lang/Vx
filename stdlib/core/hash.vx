// The hashers SipHash-1-3 and Fx. `Hash` and `Hasher` are in `core::hash::traits`, which this
// file imports.
import core::hash::traits;
import core::marker;
import core::num;

/// rustc's hasher: fast, not resistant to a chosen-key attack.
struct FxHasher {
  acc : u64,
}

impl FxHasher {
  pub fn new() -> FxHasher {
    return FxHasher {
      acc : 0u64
    };
  }
}

impl Hasher for FxHasher {
  fn write_u8(self : &mut FxHasher, b : u8) -> i32 {
    let mixed : u64 = self.acc.rotate_left(5u64) ^ (b as u64);
    self.acc = mixed.wrapping_mul(5871781006564002453u64);
    return 0;
  }

  fn finish(self : &FxHasher) -> u64 {
    return self.acc;
  }
}

struct SipState {
  v0 : u64,
  v1 : u64,
  v2 : u64,
  v3 : u64,
}

impl Copy for SipState {}

/// One SipRound. Taken and returned by value because four results do not fit a return.
pub fn sip_round(s : SipState) -> SipState {
  let mut v0 : u64 = s.v0;
  let mut v1 : u64 = s.v1;
  let mut v2 : u64 = s.v2;
  let mut v3 : u64 = s.v3;
  v0 = v0.wrapping_add(v1);
  v1 = v1.rotate_left(13u64);
  v1 = v1 ^ v0;
  v0 = v0.rotate_left(32u64);
  v2 = v2.wrapping_add(v3);
  v3 = v3.rotate_left(16u64);
  v3 = v3 ^ v2;
  v0 = v0.wrapping_add(v3);
  v3 = v3.rotate_left(21u64);
  v3 = v3 ^ v0;
  v2 = v2.wrapping_add(v1);
  v1 = v1.rotate_left(17u64);
  v1 = v1 ^ v2;
  v2 = v2.rotate_left(32u64);
  return SipState {
    v0 : v0, v1 : v1, v2 : v2, v3 : v3
  };
}

/// SipHash-1-3: one round per block, three to finish.
///
/// Bytes are gathered into `buf` and a block is mixed in once eight are there, so the
/// answer depends on how many bytes were written, not on how they were grouped.
struct SipHasher13 {
  v0 : u64,
  v1 : u64,
  v2 : u64,
  v3 : u64,
  buf : u64,
  nbuf : u64,
  length : u64,
}

impl SipHasher13 {
  pub fn with_keys(k0 : u64, k1 : u64) -> SipHasher13 {
    return SipHasher13 {
      v0 : k0 ^ 8317987319222330741u64,
      v1 : k1 ^ 7237128888997146477u64,
      v2 : k0 ^ 7816392313619706465u64,
      v3 : k1 ^ 8387220255154660723u64,
      buf : 0u64,
      nbuf : 0u64,
      length : 0u64,
    };
  }

  pub fn new() -> SipHasher13 {
    return SipHasher13::with_keys(0u64, 0u64);
  }
}

impl Hasher for SipHasher13 {
  fn write_u8(self : &mut SipHasher13, b : u8) -> i32 {
    self.buf = self.buf | ((b as u64) << (self.nbuf * 8u64));
    self.nbuf = self.nbuf + 1u64;
    self.length = self.length + 1u64;
    if self.nbuf == 8u64 {
      let m : u64 = self.buf;
      let before : SipState = SipState {
        v0 : self.v0,
        v1 : self.v1,
        v2 : self.v2,
        v3 : self.v3 ^ m,
      };
      let after : SipState = sip_round(before);
      self.v0 = after.v0 ^ m;
      self.v1 = after.v1;
      self.v2 = after.v2;
      self.v3 = after.v3;
      self.buf = 0u64;
      self.nbuf = 0u64;
    }
    return 0;
  }

  fn finish(self : &SipHasher13) -> u64 {
    // The last block carries the byte count in its top byte.
    let b : u64 = ((self.length & 255u64) << 56u64) | self.buf;
    let a0 : SipState = SipState {
      v0 : self.v0,
      v1 : self.v1,
      v2 : self.v2,
      v3 : self.v3 ^ b,
    };
    let a1 : SipState = sip_round(a0);
    let a2 : SipState = SipState {
      v0 : a1.v0 ^ b,
      v1 : a1.v1,
      v2 : a1.v2 ^ 255u64,
      v3 : a1.v3,
    };
    let a3 : SipState = sip_round(a2);
    let a4 : SipState = sip_round(a3);
    let a5 : SipState = sip_round(a4);
    return a5.v0 ^ a5.v1 ^ a5.v2 ^ a5.v3;
  }
}

/// The 128-bit product of `a` and `b`, with its two 64-bit halves joined by `^`. Each bit of the
/// result depends on many bits of both inputs. Vx has no 128-bit integer, so this multiplies the
/// 32-bit halves.
pub fn folded_multiply(a : u64, b : u64) -> u64 {
  let low : u64 = 4294967295u64;
  let a_lo = a & low;
  let a_hi = a >> 32u64;
  let b_lo = b & low;
  let b_hi = b >> 32u64;
  let lo_lo = a_lo * b_lo;
  let hi_lo = a_hi * b_lo;
  let lo_hi = a_lo * b_hi;
  let hi_hi = a_hi * b_hi;
  // At most 2^64 - 1, so the sum does not wrap.
  let cross = (lo_lo >> 32u64) + (hi_lo & low) + lo_hi;
  let lo = (cross << 32u64) | (lo_lo & low);
  let hi = hi_hi + (hi_lo >> 32u64) + (cross >> 32u64);
  return lo ^ hi;
}

/// A fast hasher with two secret seeds, in the way of Rust's foldhash. It mixes each 8 bytes into
/// its state with one `folded_multiply` by a seed. A program that does not know the seeds cannot
/// make many keys with the same hash. `std::hash_map` gives each map two random seeds.
///
/// Writing a `u64` gives the same hash as writing its 8 bytes, lowest first.
struct FoldHasher {
  acc : u64,
  fold : u64,
  // The bytes not mixed in yet, lowest first, and how many there are.
  buf : u64,
  nbuf : u64,
  // How many bytes the state holds already.
  mixed : u64,
}

impl FoldHasher {
  pub fn with_seeds(seed0 : u64, seed1 : u64) -> FoldHasher {
    return FoldHasher {
      acc : seed0, fold : seed1, buf : 0u64, nbuf : 0u64, mixed : 0u64
    };
  }
}

impl Hasher for FoldHasher {
  fn write_u8(self : &mut FoldHasher, b : u8) -> i32 {
    self.buf = self.buf | ((b as u64) << (self.nbuf * 8u64));
    self.nbuf = self.nbuf + 1u64;
    if self.nbuf == 8u64 {
      self.acc = folded_multiply(self.acc ^ self.buf, self.fold);
      self.mixed = self.mixed + 8u64;
      self.buf = 0u64;
      self.nbuf = 0u64;
    }
    return 0;
  }

  fn write_u64(self : &mut FoldHasher, v : u64) -> i32 {
    if self.nbuf == 0u64 {
      self.acc = folded_multiply(self.acc ^ v, self.fold);
      self.mixed = self.mixed + 8u64;
      return 0;
    }
    let mut x : u64 = v;
    for _i in 0..8 {
      let _byte = self.write_u8((x & 255u64) as u8);
      x = x >> 8u64;
    }
    return 0;
  }

  fn finish(self : &FoldHasher) -> u64 {
    // The count of bytes goes in the top byte, which the at most 7 bytes left never reach. So
    // "a" and "a" then a 0 byte do not hash the same.
    let count : u64 = (self.mixed + self.nbuf) & 255u64;
    let last = folded_multiply(self.acc ^ self.buf ^ (count << 56u64), self.fold);
    return folded_multiply(last, self.fold ^ 11400714819323198485u64);
  }
}
