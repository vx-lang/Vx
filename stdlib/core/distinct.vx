//===----------------------------------------------------------------------===//
// `Distinct::check(t)` is a call of the function here for the element type of `t`. A program
// that calls it gets this module without an `import`.
//
// The check copies the values into a tensor of `i64`, sorts the copy and compares each value with
// the next. An `as` from `u64` to `i64` keeps the bits, so two different values stay different.

import core::option;

/// Moves the value at `root` down the heap in `v[0..end]`, until it is not smaller than its
/// children.
fn distinct_sift_down(v : &mut Tensor<i64, [?]>, start : i64, end : i64) -> void {
  let mut root = start;
  while 2 * root + 1 < end {
    let mut child = 2 * root + 1;
    if child + 1 < end && v[child] < v[child + 1] {
      child = child + 1;
    }
    if v[root] >= v[child] {
      return;
    }
    let held = v[root];
    v[root] = v[child];
    v[child] = held;
    root = child;
  }
  return;
}

/// Whether no two of the `n` values in `v` are equal. It sorts `v` with a heap sort.
fn distinct_values_differ(v : &mut Tensor<i64, [?]>, n : i64) -> bool {
  let mut start = n / 2;
  while start > 0 {
    start = start - 1;
    distinct_sift_down(v, start, n);
  }
  let mut end = n;
  while end > 1 {
    end = end - 1;
    let held = v[0];
    v[0] = v[end];
    v[end] = held;
    distinct_sift_down(v, 0, end);
  }
  let mut i = 1i64;
  while i < n {
    if v[i - 1] == v[i] {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// `t` as a `Distinct` tensor, or `None` when two of its elements are equal.
pub fn distinct_check_i32(t : Tensor<i32, [?]>) -> Option<Distinct<Tensor<i32, [?]>>> {
  let n = t.len();
  let mut v = Tensor<i64, [?]>::new([n]);
  for i in 0..n {
    v[i] = t[i] as i64;
  }
  if distinct_values_differ(&mut v, n as i64) {
    return Option<Distinct<Tensor<i32, [?]>>>::Some(unsafe { Distinct(t) });
  }
  return Option<Distinct<Tensor<i32, [?]>>>::None;
}

/// `t` as a `Distinct` tensor, or `None` when two of its elements are equal.
pub fn distinct_check_i64(t : Tensor<i64, [?]>) -> Option<Distinct<Tensor<i64, [?]>>> {
  let n = t.len();
  let mut v = Tensor<i64, [?]>::new([n]);
  for i in 0..n {
