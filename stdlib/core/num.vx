//===----------------------------------------------------------------------===//
// The integer methods, on every signed width.
//
// These are inherent methods in Rust too -- `i32::count_ones` is not a trait method -- so
// this module needs no trait machinery at all.
//
// One macro stamps the whole set, which is how Rust's own `core::num` is written. Without
// it this is the same thirty methods copied four times, and the copies drift.
//
// `core` contains no `extern` block, and this file keeps that rule. Where Rust's `core`
// reaches for `core::intrinsics`, this reaches for `mlir!`, which every backend lowers.
// That is what lets these be called from inside a `spawn on(..)` region on a device with
// no libc.
//
// Only the signed widths. An unsigned one needs a second macro rather than another line:
// a Vx `u32` is an MLIR `i32`, so it cannot use one parameter for both the Vx type and
// the MLIR type, and several methods here mean nothing without a sign -- `abs`, `signum`,
// `checked_neg` -- while `>>` means something different.
//
// The limits are methods -- `x.max_value()` rather than `i32::MAX` -- for two reasons that
// both come from the language. Vx has no `const` item and no associated item, so there is
// nowhere to hang a constant; and a macro cannot build the name `i32_max` out of the
// parameter `i32`, so a free function per width could not be stamped. Rust spelled them
// this same way before it had associated constants.
//
// They also have to be methods for a duller reason: a bare literal is born `i32`, and
// mixing one with an `i8` is a type error rather than a widening. Returning the limit from
// a method declared `-> $t` is what gives it the right width.
//
// The `checked_` family answers with an `Option` and works because this impl is on a
// concrete type. The same methods on a generic `impl<T>` are a different matter, and
// `core::option` says so.
import core::option;

/// Stamps the integer methods for one signed width.
///
/// `$t` is both the Vx type and the MLIR type, which holds for the signed widths and is
/// exactly what does not hold for the unsigned ones.
///
/// `$bits`, `$min` and `$max` are passed rather than looked up, because a macro cannot
/// build the name `i32_max` from the parameter `i32`. The free functions above are the
/// same values under a name a caller can write.
macro_rules stamp_signed_int {
  ($t : ident , $bits : expr , $min : expr , $max : expr , $byte_mask : expr) => {
    impl $t {
      /// The smallest value of this width.
      fn min_value(self : $t) -> $t {
        return $min;
      }

      /// The largest value of this width.
      fn max_value(self : $t) -> $t {
        return $max;
      }

      /// How many bits this width has. Rust spells this `i32::BITS`.
      fn bits(self : $t) -> $t {
        return $bits;
      }

      /// How many bits are set. Counted by the hardware instruction rather than by a
      /// loop, which also means a negative operand is counted correctly: a loop shifting
      /// right would copy the sign bit and never finish.
      fn count_ones(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.ctpop %a : $t
          macro.yield %r : $t
        };
      }

      /// How many bits are clear.
      fn count_zeros(self : $t) -> $t {
        return self.bits() - self.count_ones();
      }

      /// How many zero bits sit above the highest set bit. All of them, for zero.
      fn leading_zeros(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.ctlz %a : $t
          macro.yield %r : $t
        };
      }

      /// How many zero bits sit below the lowest set bit. All of them, for zero.
      fn trailing_zeros(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.cttz %a : $t
          macro.yield %r : $t
        };
      }

      /// Is this a power of two? Zero and the negatives are not.
      fn is_power_of_two(self : $t) -> bool {
        return self > (0 as $t) && (self & (self - 1)) == (0 as $t);
      }

      fn is_positive(self : $t) -> bool {
        return self > (0 as $t);
      }

      fn is_negative(self : $t) -> bool {
        return self < (0 as $t);
      }

      /// The absolute value. The smallest value of each width has no counterpart, so that
      /// case is refused rather than wrapped back to itself, which is what the bare
      /// negation would do.
      fn abs(self : $t) -> $t {
        assert(self != self.min_value(), "abs of the smallest value has no answer at this width");
        if self < (0 as $t) {
          return -self;
        }
        return self;
      }

      /// -1, 0 or 1, by sign.
      fn signum(self : $t) -> $t {
        if self < (0 as $t) {
          return -1;
        }
        if self > (0 as $t) {
          return 1;
        }
        return 0;
      }

      /// The smaller of the two.
      fn min(self : $t, other : $t) -> $t {
        if self < other {
          return self;
        }
        return other;
      }

      /// The larger of the two.
      fn max(self : $t, other : $t) -> $t {
        if self > other {
          return self;
        }
        return other;
      }

      /// Held between two bounds, which must be the right way round.
      fn clamp(self : $t, lo : $t, hi : $t) -> $t {
        assert(lo <= hi, "clamp needs lo <= hi");
        if self < lo {
          return lo;
        }
        if self > hi {
          return hi;
        }
        return self;
      }

      /// The distance between two values, as a non-negative number.
      fn abs_diff(self : $t, other : $t) -> $t {
        if self < other {
          return other - self;
        }
        return self - other;
      }

      /// Raised to a non-negative power, by squaring. Overflow wraps, as every other
      /// arithmetic operator in the language does.
      fn pow(self : $t, exp : $t) -> $t {
        assert(exp >= (0 as $t), "pow takes a non-negative exponent");
        let mut result : $t = 1;
        let mut base : $t = self;
        let mut e : $t = exp;
        loop {
          if e == (0 as $t) {
            break;
          }
          if (e & 1) == (1 as $t) {
            result = result * base;
          }
          base = base * base;
          e = e >> (1 as $t);
        }
        return result;
      }

      /// Euclidean remainder: never negative, whatever the signs are. `%` alone takes its
      /// sign from the dividend, so -7 % 4 is -3 where this is 1.
      fn rem_euclid(self : $t, rhs : $t) -> $t {
        let r = self % rhs;
        if r < (0 as $t) {
          if rhs < (0 as $t) {
            return r - rhs;
          }
          return r + rhs;
        }
        return r;
      }

      /// The quotient that pairs with `rem_euclid`, rounded so the remainder stays
      /// non-negative.
      fn div_euclid(self : $t, rhs : $t) -> $t {
        let q = self / rhs;
        if self % rhs < (0 as $t) {
          if rhs > (0 as $t) {
            return q - 1;
          }
          return q + 1;
        }
        return q;
      }

      /// The base-2 logarithm, rounded down. Undefined at zero and below, so refused.
      fn ilog2(self : $t) -> $t {
        assert(self > (0 as $t), "ilog2 needs a positive value");
        return self.bits() - 1 - self.leading_zeros();
      }

      /// The smallest power of two at or above this value. One for anything at or below
      /// one. The top power of two does not fit in a signed width -- the bit above it is
      /// the sign -- so a value beyond it is refused rather than answered with a negative
      /// number.
      fn next_power_of_two(self : $t) -> $t {
        if self <= (1 as $t) {
          return 1;
        }
        let one : $t = 1;
        let shift = self.bits() - (self - one).leading_zeros();
        assert(shift < self.bits() - one, "next power of two does not fit at this width");
        return one << shift;
      }

      /// The bits rotated left, wrapping round rather than falling off the end. The right
      /// half is masked because `>>` on a signed value copies the sign bit.
      fn rotate_left(self : $t, n : $t) -> $t {
        let k = n % self.bits();
        if k == (0 as $t) {
          return self;
        }
        let one : $t = 1;
        let low = (self >> (self.bits() - k)) & ((one << k) - one);
        return (self << k) | low;
      }

      /// The bits rotated right.
      fn rotate_right(self : $t, n : $t) -> $t {
        let k = n % self.bits();
        if k == (0 as $t) {
          return self;
        }
        return self.rotate_left(self.bits() - k);
      }

      /// The bytes in the opposite order. Each byte is masked after shifting, because
      /// `>>` on a signed value copies the sign bit down into the bits being kept.
      ///
      /// The mask is a parameter rather than the literal 255, because 255 does not fit in
      /// an `i8`. Writing it there is currently accepted and wraps to -1, which is by luck
      /// the right mask, but a language that refuses an out-of-range literal would be
      /// right to and this would break. At one byte wide the loop runs once with no shift,
      /// which is the identity, and that is the correct answer.
      fn swap_bytes(self : $t) -> $t {
        let eight : $t = 8;
        let mask : $t = $byte_mask;
        let mut out : $t = 0;
        let mut i : $t = 0;
        loop {
          if i == self.bits() {
            break;
          }
          let byte = (self >> i) & mask;
          out = out | (byte << (self.bits() - eight - i));
          i += eight;
        }
        return out;
      }

      /// The bits in the opposite order.
      fn reverse_bits(self : $t) -> $t {
        let one : $t = 1;
        let mut out : $t = 0;
        let mut i : $t = 0;
        loop {
          if i == self.bits() {
            break;
          }
          let bit = (self >> i) & one;
          out = out | (bit << (self.bits() - one - i));
          i += one;
        }
        return out;
      }

      /// The sum, or nothing if it would not fit. The bound is rearranged so the check
      /// itself cannot overflow: comparing against `self.max_value() - rhs` is safe where computing
      /// `self + rhs` first is exactly the thing being tested.
      fn checked_add(self : $t, rhs : $t) -> Option<$t> {
        if rhs > (0 as $t) && self > self.max_value() - rhs {
          return Option<$t>::None();
        }
        if rhs < (0 as $t) && self < self.min_value() - rhs {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self + rhs);
      }

      /// The difference, or nothing if it would not fit.
      fn checked_sub(self : $t, rhs : $t) -> Option<$t> {
        if rhs < (0 as $t) && self > self.max_value() + rhs {
          return Option<$t>::None();
        }
        if rhs > (0 as $t) && self < self.min_value() + rhs {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self - rhs);
      }

      /// The product, or nothing if it would not fit. Checked after the fact by dividing
      /// back out, which is exact whenever the product did fit. The two cases where that
      /// division would itself overflow are ruled out first.
      fn checked_mul(self : $t, rhs : $t) -> Option<$t> {
        if self == (0 as $t) || rhs == (0 as $t) {
          return Option<$t>::Some(0 as $t);
        }
        if self == self.min_value() && rhs == (-1 as $t) {
          return Option<$t>::None();
        }
        if rhs == self.min_value() && self == (-1 as $t) {
          return Option<$t>::None();
        }
        let product = self * rhs;
        if product / rhs != self {
          return Option<$t>::None();
        }
        return Option<$t>::Some(product);
      }

      /// The quotient, or nothing on division by zero -- and on the one division that
      /// overflows, the smallest value divided by -1.
      fn checked_div(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        if self == self.min_value() && rhs == (-1 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self / rhs);
      }

      /// The remainder, refused in the same two cases as `checked_div`.
      fn checked_rem(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        if self == self.min_value() && rhs == (-1 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self % rhs);
      }

      /// The negation, or nothing for the smallest value, which has no counterpart.
      fn checked_neg(self : $t) -> Option<$t> {
        if self == self.min_value() {
          return Option<$t>::None();
        }
        return Option<$t>::Some(-self);
      }

      /// The sum, held at the end of the range instead of wrapping past it.
      fn saturating_add(self : $t, rhs : $t) -> $t {
        if rhs > (0 as $t) && self > self.max_value() - rhs {
          return self.max_value();
        }
        if rhs < (0 as $t) && self < self.min_value() - rhs {
          return self.min_value();
        }
        return self + rhs;
      }

      /// The difference, held at the end of the range instead of wrapping past it.
      fn saturating_sub(self : $t, rhs : $t) -> $t {
        if rhs < (0 as $t) && self > self.max_value() + rhs {
          return self.max_value();
        }
        if rhs > (0 as $t) && self < self.min_value() + rhs {
          return self.min_value();
        }
        return self - rhs;
      }
    }
  };
}

stamp_signed_int!(i8 , 8 , -127 - 1 , 127 , -1);
stamp_signed_int!(i16 , 16 , -32767 - 1 , 32767 , 255);
stamp_signed_int!(i32 , 32 , -2147483647 - 1 , 2147483647 , 255);
stamp_signed_int!(i64 , 64 , -9223372036854775807 - 1 , 9223372036854775807 , 255);
