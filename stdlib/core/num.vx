/// Stamps what needs a float width's integer twin: the bits, the neighbouring values, the
/// total order, and the constants about the format.
///
/// `$u` is the unsigned integer of the same width and `$m` the signed one, which is also
/// the MLIR type the bits are cast to. `$neg_tiny` is the bits of the negative value
/// nearest zero, and `$smax` the largest `$m`.
macro_rules stamp_float_bits {
  ($t : ident , $u : ident , $m : ident , $neg_tiny : expr , $smax : expr , $mantissa : expr , $digits : expr , $min_exp : expr , $max_exp : expr , $min_10 : expr , $max_10 : expr) => {
    impl $t {
      /// The bits of this value, as an unsigned integer of the same width.
      fn to_bits(self : $t) -> $u {
        return mlir!( inputs : (%a = self : $t), returns : $u, dialects : ["arith"]) {
          %r = "arith.bitcast"(%a) : ($t) -> $m
          macro.yield %r : $m
        };
      }

      /// The value these bits spell. Static: `f32::from_bits(1065353216)` is 1.0.
      fn from_bits(v : $u) -> $t {
        return mlir!( inputs : (%v = v : $m), returns : $t, dialects : ["arith"]) {
          %r = "arith.bitcast"(%v) : ($m) -> $t
          macro.yield %r : $t
        };
      }

      /// The smallest value greater than this one. A NaN and positive infinity give
      /// themselves, and either zero gives the smallest positive value.
      fn next_up(self : $t) -> $t {
        if self.is_nan() || self == $t::infinity() {
          return self;
        }
        if self == 0.0 {
          return $t::from_bits(1);
        }
        let bits = self.to_bits();
        if self > 0.0 {
          return $t::from_bits(bits + 1);
        }
        return $t::from_bits(bits - 1);
      }

      /// The largest value less than this one. A NaN and negative infinity give themselves,
      /// and either zero gives the negative value nearest zero.
      fn next_down(self : $t) -> $t {
        if self.is_nan() || self == $t::neg_infinity() {
          return self;
        }
        if self == 0.0 {
          return $t::from_bits($neg_tiny);
        }
        let bits = self.to_bits();
        if self > 0.0 {
          return $t::from_bits(bits - 1);
        }
        return $t::from_bits(bits + 1);
      }

      /// A total order over every value, NaNs included: negative NaNs, negative
      /// infinity, the negatives, -0.0, 0.0, the positives, positive infinity, positive NaNs.
      /// It compares the bits as signed integers, with the bits of a negative value turned
      /// round so that more negative sorts lower.
      fn total_cmp(self : &$t, other : &$t) -> Ordering {
        let x : $t = *self;
        let y : $t = *other;
        let smax : $m = $smax;
        let mut a : $m = mlir!( inputs : (%v = x : $t), returns : $m, dialects : ["arith"]) {
          %r = "arith.bitcast"(%v) : ($t) -> $m
          macro.yield %r : $m
        };
        let mut b : $m = mlir!( inputs : (%v = y : $t), returns : $m, dialects : ["arith"]) {
          %r = "arith.bitcast"(%v) : ($t) -> $m
          macro.yield %r : $m
        };
        if a < 0 {
          a = a ^ smax;
        }
        if b < 0 {
          b = b ^ smax;
        }
        if a < b {
          return Ordering::Less();
        }
        if a > b {
          return Ordering::Greater();
        }
        return Ordering::Equal();
      }

      /// The base the format counts in: 2.
      fn radix() -> u32 {
        return 2;
      }

      /// How many binary digits the significand holds, the leading one included.
      fn mantissa_digits() -> u32 {
        return $mantissa;
      }

      /// How many decimal digits survive a round trip through this width.
      fn digits() -> u32 {
        return $digits;
      }

      /// One more than the smallest power of two a normal value can have.
      fn min_exp() -> i32 {
        return $min_exp;
      }

      /// One more than the largest power of two a finite value can have.
      fn max_exp() -> i32 {
        return $max_exp;
      }

      /// The smallest power of ten that is a normal value.
      fn min_10_exp() -> i32 {
        return $min_10;
      }

      /// The largest power of ten that is a finite value.
      fn max_10_exp() -> i32 {
        return $max_10;
      }
    }
  };
}

