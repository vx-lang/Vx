//===----------------------------------------------------------------------===//
// The integer methods, stamped over the signed widths.
//
// They are inherent methods, so no trait machinery is needed: one macro stamps the set.
//
// `core` uses `mlir!` and declares no `extern`, so these work inside a `spawn on(..)` region
// on a device with no libc.
//
// There are two macros rather than one. A Vx `u32` is an MLIR `i32`, so the unsigned stamp
// takes the MLIR type as a second parameter; and `abs`, `signum`, `is_positive`,
// `is_negative` and `checked_neg` have nothing to answer without a sign, so they are absent
// from it rather than stubbed.
//
// `min`, `max` and `clamp` are not here: they belong to `Ord` in `core::cmp`, and a type
// gets them by implementing `cmp`.
//
// The limits are methods because Vx has no `const` item, and because a bare literal is
// born `i32` -- returning one from a method declared `-> $t` is what gives it the width.
//
// The float methods at the bottom need no libm in the source: each is a `math` dialect op,
// which every backend lowers on its own terms, or a call into `core::libm`.
//
// These replaced `std::math`, which declared the same names as a `Math` trait over a block
// of libm externs. That module is gone and its callers import this one: the method names
// are the same, so only the import line moved.
//
// `cbrt` and `erf` are absent. Their `math` ops lower to a libm declaration the pipeline
// then rejects.
import core::cmp;
import core::option;
import core::libm;

/// The five kinds of float value `classify` tells apart.
enum FpCategory {
  Nan,
  Infinite,
  Zero,
  Subnormal,
  Normal,
}

/// Stamps the integer methods for one signed width.
///
/// `$t` is both the Vx type and the MLIR type, which holds for the signed widths and is
/// exactly what does not hold for the unsigned ones.
///
/// `$bits`, `$min` and `$max` are passed rather than looked up, because a macro cannot
/// build the name `i32_max` from the parameter `i32`. The free functions above are the
/// same values under a name a caller can write.
macro_rules stamp_signed_int {
  ($t : ident , $bits : expr , $min : expr , $max : expr , $byte_mask : expr) => {
    impl $t {
      /// The smallest value of this width.
      fn min_value(self : $t) -> $t {
        return $min;
      }

      /// The largest value of this width.
      fn max_value(self : $t) -> $t {
        return $max;
      }

      /// How many bits this width has.
      fn bits(self : $t) -> $t {
        return $bits;
      }

      /// How many bits are set. The hardware instruction, so a negative operand is
      /// counted right; a loop shifting right would copy the sign bit forever.
      fn count_ones(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.ctpop %a : $t
          macro.yield %r : $t
        };
      }

      /// How many bits are clear.
      fn count_zeros(self : $t) -> $t {
        return self.bits() - self.count_ones();
      }

      /// Zero bits above the highest set bit. All of them, for zero.
      fn leading_zeros(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.ctlz %a : $t
          macro.yield %r : $t
        };
      }

      /// Zero bits below the lowest set bit. All of them, for zero.
      fn trailing_zeros(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.cttz %a : $t
          macro.yield %r : $t
        };
      }

      /// Zero and the negatives are not.
      fn is_power_of_two(self : $t) -> bool {
        return self > (0 as $t) && (self & (self - 1)) == (0 as $t);
      }

      /// Is this greater than zero? Zero is neither positive nor negative.
      fn is_positive(self : $t) -> bool {
        return self > (0 as $t);
      }

      /// Is this less than zero?
      fn is_negative(self : $t) -> bool {
        return self < (0 as $t);
      }

      /// Refused at the smallest value, which has no positive counterpart.
      fn abs(self : $t) -> $t {
        assert(self != self.min_value(), "abs of the smallest value has no answer at this width");
        if self < (0 as $t) {
          return -self;
        }
        return self;
      }

      /// -1, 0 or 1, by sign.
      fn signum(self : $t) -> $t {
        if self < (0 as $t) {
          return -1;
        }
        if self > (0 as $t) {
          return 1;
        }
        return 0;
      }

      /// The distance between two values.
      fn abs_diff(self : $t, other : $t) -> $t {
        if self < other {
          return other - self;
        }
        return self - other;
      }

      /// By squaring. Overflow wraps, as every arithmetic operator here does.
      fn pow(self : $t, exp : $t) -> $t {
        assert(exp >= (0 as $t), "pow takes a non-negative exponent");
        let mut result : $t = 1;
        let mut base : $t = self;
        let mut e : $t = exp;
        loop {
          if e == (0 as $t) {
            break;
          }
          if (e & 1) == (1 as $t) {
            result = result * base;
          }
          base = base * base;
          e = e >> (1 as $t);
        }
        return result;
      }

      /// Never negative, whatever the signs: -7 % 4 is -3 where this is 1.
      fn rem_euclid(self : $t, rhs : $t) -> $t {
        let r = self % rhs;
        if r < (0 as $t) {
          if rhs < (0 as $t) {
            return r - rhs;
          }
          return r + rhs;
        }
        return r;
      }

      /// The quotient pairing with `rem_euclid`.
      fn div_euclid(self : $t, rhs : $t) -> $t {
        let q = self / rhs;
        if self % rhs < (0 as $t) {
          if rhs > (0 as $t) {
            return q - 1;
          }
          return q + 1;
        }
        return q;
      }

      /// This raised to `exp`, or nothing if the answer does not fit.
      fn checked_pow(self : $t, exp : $t) -> Option<$t> {
        assert(exp >= (0 as $t), "checked_pow takes a non-negative exponent");
        // By squaring. The last square is never taken, so a base whose square would not
        // fit still gives an answer when that square is not needed.
        if exp == (0 as $t) {
          return Option<$t>::Some(1 as $t);
        }
        let mut result : $t = 1;
        let mut base : $t = self;
        let mut e : $t = exp;
        loop {
          if (e & (1 as $t)) == (1 as $t) {
            let product = result.checked_mul(base);
            if product.is_none() {
              return Option<$t>::None();
            }
            result = product.unwrap();
            if e == (1 as $t) {
              return Option<$t>::Some(result);
            }
          }
          e = e >> (1 as $t);
          let square = base.checked_mul(base);
          if square.is_none() {
            return Option<$t>::None();
          }
          base = square.unwrap();
        }
        return Option<$t>::Some(result);
      }

      /// This raised to `exp`, wrapping round at the width. The same as `pow`, under the
      /// name that says so.
      fn wrapping_pow(self : $t, exp : $t) -> $t {
        return self.pow(exp);
      }

      /// The logarithm to `base`, rounded down. Refused at zero and below, and for a base
      /// below two.
      fn ilog(self : $t, base : $t) -> $t {
        assert(self > (0 as $t), "ilog needs a positive value");
        assert(base >= (2 as $t), "ilog needs a base of at least two");
        let mut n : $t = 0;
        let mut rest : $t = self;
        loop {
          if rest < base {
            break;
          }
          rest = rest / base;
          n = n + (1 as $t);
        }
        return n;
      }

      /// The logarithm to base ten, rounded down. Refused at zero and below.
      fn ilog10(self : $t) -> $t {
        return self.ilog(10);
      }

      /// The logarithm to `base`, or nothing at zero and below or for a base below two.
      fn checked_ilog(self : $t, base : $t) -> Option<$t> {
        if self <= (0 as $t) || base < (2 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self.ilog(base));
      }

      /// The logarithm to base two, or nothing at zero and below.
      fn checked_ilog2(self : $t) -> Option<$t> {
        if self <= (0 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self.ilog2());
      }

      /// The logarithm to base ten, or nothing at zero and below.
      fn checked_ilog10(self : $t) -> Option<$t> {
        return self.checked_ilog(10);
      }

      /// This raised to `exp`, held at the end of the range it overflows towards: the
      /// bottom for a negative base to an odd power, the top otherwise.
      fn saturating_pow(self : $t, exp : $t) -> $t {
        let r = self.checked_pow(exp);
        if r.is_some() {
          return r.unwrap();
        }
        if self < (0 as $t) && (exp & (1 as $t)) == (1 as $t) {
          return self.min_value();
        }
        return self.max_value();
      }

      /// The absolute value, or nothing for the smallest value, whose positive does not fit.
      fn checked_abs(self : $t) -> Option<$t> {
        if self == self.min_value() {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self.abs());
      }

      /// The absolute value, wrapping: the smallest value gives itself.
      fn wrapping_abs(self : $t) -> $t {
        if self == self.min_value() {
          return self;
        }
        return self.abs();
      }

      /// The absolute value, held at the largest value for the smallest.
      fn saturating_abs(self : $t) -> $t {
        if self == self.min_value() {
          return self.max_value();
        }
        return self.abs();
      }

      /// The negation, held at the largest value for the smallest.
      fn saturating_neg(self : $t) -> $t {
        if self == self.min_value() {
          return self.max_value();
        }
        return -self;
      }

      /// The quotient, wrapping: the smallest value divided by -1 gives itself. Refused on
      /// a zero divisor, as `/` is.
      fn wrapping_div(self : $t, rhs : $t) -> $t {
        if self == self.min_value() && rhs == (-1 as $t) {
          return self;
        }
        return self / rhs;
      }

      /// The remainder, wrapping: the smallest value by -1 gives 0.
      fn wrapping_rem(self : $t, rhs : $t) -> $t {
        if self == self.min_value() && rhs == (-1 as $t) {
          return 0;
        }
        return self % rhs;
      }

      /// Rounded down. Refused at zero and below.
      fn ilog2(self : $t) -> $t {
        assert(self > (0 as $t), "ilog2 needs a positive value");
        return self.bits() - 1 - self.leading_zeros();
      }

      /// The square root, rounded down. Refused below zero.
      ///
      /// Digit by digit in base four, so nothing overflows and no float is involved.
      fn isqrt(self : $t) -> $t {
        assert(self >= (0 as $t), "isqrt of a negative value has no answer");
        let two : $t = 2;
        let mut rest : $t = self;
        let mut root : $t = 0;
        let mut bit : $t = (1 as $t) << (self.bits() - two);
        loop {
          if bit <= rest {
            break;
          }
          bit = bit >> two;
        }
        loop {
          if bit == (0 as $t) {
            break;
          }
          if rest >= root + bit {
            rest = rest - (root + bit);
            root = (root >> (1 as $t)) + bit;
          } else {
            root = root >> (1 as $t);
          }
          bit = bit >> two;
        }
        return root;
      }

      /// The square root rounded down, or nothing below zero.
      fn checked_isqrt(self : $t) -> Option<$t> {
        if self < (0 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self.isqrt());
      }

      /// Halfway between two values, rounded towards zero, without overflowing.
      /// `>>` rounds down, so a negative answer with a half left over is moved up by one.
      fn midpoint(self : $t, rhs : $t) -> $t {
        let down = (self & rhs) + ((self ^ rhs) >> (1 as $t));
        if down < (0 as $t) && ((self ^ rhs) & (1 as $t)) == (1 as $t) {
          return down + 1;
        }
        return down;
      }

      /// One for anything at or below one. The top power of two does not fit in a
      /// signed width, so a value beyond it is refused.
      fn next_power_of_two(self : $t) -> $t {
        if self <= (1 as $t) {
          return 1;
        }
        let one : $t = 1;
        let shift = self.bits() - (self - one).leading_zeros();
        assert(shift < self.bits() - one, "next power of two does not fit at this width");
        return one << shift;
      }

      /// Wrapping round. The right half is masked because `>>` copies the sign bit.
      fn rotate_left(self : $t, n : $t) -> $t {
        let k = n % self.bits();
        if k == (0 as $t) {
          return self;
        }
        let one : $t = 1;
        let low = (self >> (self.bits() - k)) & ((one << k) - one);
        return (self << k) | low;
      }

      /// The bits rotated right.
      fn rotate_right(self : $t, n : $t) -> $t {
        let k = n % self.bits();
        if k == (0 as $t) {
          return self;
        }
        return self.rotate_left(self.bits() - k);
      }

      /// The bytes reversed. The mask is a parameter because 255 does not fit in an
      /// `i8`; it is accepted there and wraps to -1, which is right by luck.
      fn swap_bytes(self : $t) -> $t {
        let eight : $t = 8;
        let mask : $t = $byte_mask;
        let mut out : $t = 0;
        let mut i : $t = 0;
        loop {
          if i == self.bits() {
            break;
          }
          let byte = (self >> i) & mask;
          out = out | (byte << (self.bits() - eight - i));
          i += eight;
        }
        return out;
      }

      /// The bits reversed.
      fn reverse_bits(self : $t) -> $t {
        let one : $t = 1;
        let mut out : $t = 0;
        let mut i : $t = 0;
        loop {
          if i == self.bits() {
            break;
          }
          let bit = (self >> i) & one;
          out = out | (bit << (self.bits() - one - i));
          i += one;
        }
        return out;
      }

      /// Nothing if it would not fit. The bound is rearranged so the check itself
      /// cannot overflow.
      fn checked_add(self : $t, rhs : $t) -> Option<$t> {
        if rhs > (0 as $t) && self > self.max_value() - rhs {
          return Option<$t>::None();
        }
        if rhs < (0 as $t) && self < self.min_value() - rhs {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self + rhs);
      }

      /// Nothing if it would not fit.
      fn checked_sub(self : $t, rhs : $t) -> Option<$t> {
        if rhs < (0 as $t) && self > self.max_value() + rhs {
          return Option<$t>::None();
        }
        if rhs > (0 as $t) && self < self.min_value() + rhs {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self - rhs);
      }

      /// Checked by dividing back out, exact when the product fit. The two divisions
      /// that would themselves overflow are ruled out first.
      fn checked_mul(self : $t, rhs : $t) -> Option<$t> {
        if self == (0 as $t) || rhs == (0 as $t) {
          return Option<$t>::Some(0 as $t);
        }
        if self == self.min_value() && rhs == (-1 as $t) {
          return Option<$t>::None();
        }
        if rhs == self.min_value() && self == (-1 as $t) {
          return Option<$t>::None();
        }
        let product = self * rhs;
        if product / rhs != self {
          return Option<$t>::None();
        }
        return Option<$t>::Some(product);
      }

      /// Nothing on division by zero, or on the one division that overflows.
      fn checked_div(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        if self == self.min_value() && rhs == (-1 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self / rhs);
      }

      /// Refused in the same two cases as `checked_div`.
      fn checked_rem(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        if self == self.min_value() && rhs == (-1 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self % rhs);
      }

      /// Nothing for the smallest value.
      fn checked_neg(self : $t) -> Option<$t> {
        if self == self.min_value() {
          return Option<$t>::None();
        }
        return Option<$t>::Some(-self);
      }

      /// Held at the end of the range instead of wrapping past it.
      fn saturating_add(self : $t, rhs : $t) -> $t {
        if rhs > (0 as $t) && self > self.max_value() - rhs {
          return self.max_value();
        }
        if rhs < (0 as $t) && self < self.min_value() - rhs {
          return self.min_value();
        }
        return self + rhs;
      }

      /// Held at the end of the range instead of wrapping past it.
      fn saturating_sub(self : $t, rhs : $t) -> $t {
        if rhs < (0 as $t) && self > self.max_value() + rhs {
          return self.max_value();
        }
        if rhs > (0 as $t) && self < self.min_value() + rhs {
          return self.min_value();
        }
        return self - rhs;
      }

      /// The sum, wrapping round at the width. Vx's `+` already wraps, so the body is the
      /// operator; the name is what a reader who wants that on purpose looks for, and what
      /// a hash function is written in.
      fn wrapping_add(self : $t, rhs : $t) -> $t {
        return self + rhs;
      }

      /// The difference, wrapping round at the width.
      fn wrapping_sub(self : $t, rhs : $t) -> $t {
        return self - rhs;
      }

      /// The product, keeping the low bits and discarding the rest.
      fn wrapping_mul(self : $t, rhs : $t) -> $t {
        return self * rhs;
      }

      /// Zero minus this, wrapping. The smallest value negates to itself, because its
      /// positive is one past the largest.
      fn wrapping_neg(self : $t) -> $t {
        return (0 as $t) - self;
      }

      /// Clamped to the width rather than wrapping. Which end it clamps to is the sign the
      /// product would have had, which is whether the two operands agree in sign.
      fn saturating_mul(self : $t, rhs : $t) -> $t {
        let product = self.checked_mul(rhs);
        let signs_agree = (self < (0 as $t)) == (rhs < (0 as $t));
        let mut limit = self.min_value();
        if signs_agree {
          limit = self.max_value();
        }
        return product.unwrap_or(limit);
      }

      /// How many set bits the value starts with, counting from the top.
      fn leading_ones(self : $t) -> $t {
        return (!self).leading_zeros();
      }

      /// How many set bits the value ends with, counting from the bottom.
      fn trailing_ones(self : $t) -> $t {
        return (!self).trailing_zeros();
      }

      /// The wrapped sum, and whether it wrapped.
      fn overflowing_add(self : $t, rhs : $t) -> ($t, bool) {
        return (self + rhs, self.checked_add(rhs).is_none());
      }

      /// The wrapped difference, and whether it wrapped.
      fn overflowing_sub(self : $t, rhs : $t) -> ($t, bool) {
        return (self - rhs, self.checked_sub(rhs).is_none());
      }

      /// The wrapped product, and whether it wrapped.
      fn overflowing_mul(self : $t, rhs : $t) -> ($t, bool) {
        return (self * rhs, self.checked_mul(rhs).is_none());
      }

      /// The negation, and whether it wrapped: only the smallest value does, to itself.
      fn overflowing_neg(self : $t) -> ($t, bool) {
        return ((0 as $t) - self, self == self.min_value());
      }

      /// The absolute value, and whether it wrapped: only the smallest value does, to itself.
      fn overflowing_abs(self : $t) -> ($t, bool) {
        if self == self.min_value() {
          return (self, true);
        }
        return (self.abs(), false);
      }

      /// The quotient, and whether it wrapped: the smallest value divided by -1 gives
      /// itself. Refused on a zero divisor, as `/` is.
      fn overflowing_div(self : $t, rhs : $t) -> ($t, bool) {
        if self == self.min_value() && rhs == (-1 as $t) {
          return (self, true);
        }
        return (self / rhs, false);
      }

      /// The remainder, and whether it wrapped: the smallest value by -1 gives 0 and says
      /// so, since the division beside it overflows.
      fn overflowing_rem(self : $t, rhs : $t) -> ($t, bool) {
        if self == self.min_value() && rhs == (-1 as $t) {
          return (0 as $t, true);
        }
        return (self % rhs, false);
      }
    }
  };
}

stamp_signed_int!(i8 , 8 , -127 - 1 , 127 , -1);
stamp_signed_int!(i16 , 16 , -32767 - 1 , 32767 , 255);
stamp_signed_int!(i32 , 32 , -2147483647 - 1 , 2147483647 , 255);
stamp_signed_int!(i64 , 64 , -9223372036854775807 - 1 , 9223372036854775807 , 255);

/// Stamps the integer methods for one unsigned width.
///
/// Separate from the signed macro for two reasons. A Vx `u32` is an MLIR `i32`, so the type
/// the `mlir!` blocks name is `$mlir` rather than `$t`. And the methods that read a sign --
/// `abs`, `signum`, `is_positive`, `is_negative`, `checked_neg` -- have nothing to answer
/// here, so they are absent rather than stubbed.
///
/// The bodies differ where the sign changed the arithmetic: `>>` brings in zeros, so
/// `rotate_left` needs no mask; subtraction underflows instead of going negative, so
/// `checked_sub` asks whether `rhs` is the larger; and `div_euclid` and `rem_euclid` are
/// plain `/` and `%`, since a non-negative remainder is all this width has.
macro_rules stamp_unsigned_int {
  ($t : ident , $mlir : ident , $bits : expr , $max : expr) => {
    impl $t {
      /// Zero, at every unsigned width.
      fn min_value(self : $t) -> $t {
        return 0;
      }

      /// The largest value of this width.
      fn max_value(self : $t) -> $t {
        return $max;
      }

      /// How many bits this width has.
      fn bits(self : $t) -> $t {
        return $bits;
      }

      /// How many bits are set.
      fn count_ones(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $mlir), returns : $t, dialects : ["math"]) {
          %r = math.ctpop %a : $mlir
          macro.yield %r : $mlir
        };
      }

      /// How many bits are clear.
      fn count_zeros(self : $t) -> $t {
        return self.bits() - self.count_ones();
      }

      /// Zero bits above the highest set bit. All of them, for zero.
      fn leading_zeros(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $mlir), returns : $t, dialects : ["math"]) {
          %r = math.ctlz %a : $mlir
          macro.yield %r : $mlir
        };
      }

      /// Zero bits below the lowest set bit. All of them, for zero.
      fn trailing_zeros(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $mlir), returns : $t, dialects : ["math"]) {
          %r = math.cttz %a : $mlir
          macro.yield %r : $mlir
        };
      }

      /// Zero is not a power of two.
      fn is_power_of_two(self : $t) -> bool {
        return self > (0 as $t) && (self & (self - 1)) == (0 as $t);
      }

      /// The distance between two values, which is never negative and so always fits.
      fn abs_diff(self : $t, other : $t) -> $t {
        if self < other {
          return other - self;
        }
        return self - other;
      }

      /// By squaring. Overflow wraps, as every arithmetic operator here does.
      fn pow(self : $t, exp : $t) -> $t {
        let mut result : $t = 1;
        let mut base : $t = self;
        let mut e : $t = exp;
        loop {
          if e == (0 as $t) {
            break;
          }
          if (e & 1) == (1 as $t) {
            result = result * base;
          }
          base = base * base;
          e = e >> (1 as $t);
        }
        return result;
      }

      /// Plain division: an unsigned quotient is already the Euclidean one.
      fn div_euclid(self : $t, rhs : $t) -> $t {
        return self / rhs;
      }

      /// Plain remainder, which at this width is never negative.
      fn rem_euclid(self : $t, rhs : $t) -> $t {
        return self % rhs;
      }

      /// This raised to `exp`, or nothing if the answer does not fit.
      fn checked_pow(self : $t, exp : $t) -> Option<$t> {
        assert(exp >= (0 as $t), "checked_pow takes a non-negative exponent");
        // By squaring. The last square is never taken, so a base whose square would not
        // fit still gives an answer when that square is not needed.
        if exp == (0 as $t) {
          return Option<$t>::Some(1 as $t);
        }
        let mut result : $t = 1;
        let mut base : $t = self;
        let mut e : $t = exp;
        loop {
          if (e & (1 as $t)) == (1 as $t) {
            let product = result.checked_mul(base);
            if product.is_none() {
              return Option<$t>::None();
            }
            result = product.unwrap();
            if e == (1 as $t) {
              return Option<$t>::Some(result);
            }
          }
          e = e >> (1 as $t);
          let square = base.checked_mul(base);
          if square.is_none() {
            return Option<$t>::None();
          }
          base = square.unwrap();
        }
        return Option<$t>::Some(result);
      }

      /// This raised to `exp`, wrapping round at the width. The same as `pow`, under the
      /// name that says so.
      fn wrapping_pow(self : $t, exp : $t) -> $t {
        return self.pow(exp);
      }

      /// The logarithm to `base`, rounded down. Refused at zero and below, and for a base
      /// below two.
      fn ilog(self : $t, base : $t) -> $t {
        assert(self > (0 as $t), "ilog needs a positive value");
        assert(base >= (2 as $t), "ilog needs a base of at least two");
        let mut n : $t = 0;
        let mut rest : $t = self;
        loop {
          if rest < base {
            break;
          }
          rest = rest / base;
          n = n + (1 as $t);
        }
        return n;
      }

      /// The logarithm to base ten, rounded down. Refused at zero and below.
      fn ilog10(self : $t) -> $t {
        return self.ilog(10);
      }

      /// The logarithm to `base`, or nothing at zero and below or for a base below two.
      fn checked_ilog(self : $t, base : $t) -> Option<$t> {
        if self <= (0 as $t) || base < (2 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self.ilog(base));
      }

      /// The logarithm to base two, or nothing at zero and below.
      fn checked_ilog2(self : $t) -> Option<$t> {
        if self <= (0 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self.ilog2());
      }

      /// The logarithm to base ten, or nothing at zero and below.
      fn checked_ilog10(self : $t) -> Option<$t> {
        return self.checked_ilog(10);
      }

      /// This raised to `exp`, held at the largest value if it overflows.
      fn saturating_pow(self : $t, exp : $t) -> $t {
        return self.checked_pow(exp).unwrap_or(self.max_value());
      }

      /// Does `rhs` divide this exactly? Zero is a multiple only of zero, and every value of
      /// one.
      fn is_multiple_of(self : $t, rhs : $t) -> bool {
        if rhs == (0 as $t) {
          return self == (0 as $t);
        }
        return self % rhs == (0 as $t);
      }

      /// The smallest multiple of `rhs` at or above this. Refused on a zero `rhs`, and when
      /// the answer does not fit.
      fn next_multiple_of(self : $t, rhs : $t) -> $t {
        let r = self.checked_next_multiple_of(rhs);
        assert(r.is_some(), "next_multiple_of has no answer here");
        return r.unwrap();
      }

      /// The smallest multiple of `rhs` at or above this, or nothing on a zero `rhs` or when
      /// the answer does not fit.
      fn checked_next_multiple_of(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        let r = self % rhs;
        if r == (0 as $t) {
          return Option<$t>::Some(self);
        }
        return self.checked_add(rhs - r);
      }

      /// The smallest power of two at or above this, or nothing above the top power of two.
      fn checked_next_power_of_two(self : $t) -> Option<$t> {
        if self <= (1 as $t) {
          return Option<$t>::Some(1 as $t);
        }
        let one : $t = 1;
        let shift = self.bits() - (self - one).leading_zeros();
        if shift >= self.bits() {
          return Option<$t>::None();
        }
        return Option<$t>::Some(one << shift);
      }

      /// Rounded down. Refused at zero, which has no logarithm.
      fn ilog2(self : $t) -> $t {
        assert(self > (0 as $t), "ilog2 needs a positive value");
        return self.bits() - 1 - self.leading_zeros();
      }

      /// The square root, rounded down, digit by digit in base four.
      fn isqrt(self : $t) -> $t {
        let two : $t = 2;
        let mut rest : $t = self;
        let mut root : $t = 0;
        let mut bit : $t = (1 as $t) << (self.bits() - two);
        loop {
          if bit <= rest {
            break;
          }
          bit = bit >> two;
        }
        loop {
          if bit == (0 as $t) {
            break;
          }
          if rest >= root + bit {
            rest = rest - (root + bit);
            root = (root >> (1 as $t)) + bit;
          } else {
            root = root >> (1 as $t);
          }
          bit = bit >> two;
        }
        return root;
      }

      /// Halfway between two values, rounded down, without overflowing.
      fn midpoint(self : $t, rhs : $t) -> $t {
        return (self & rhs) + ((self ^ rhs) >> (1 as $t));
      }

      /// The quotient rounded up. Refused on a zero divisor.
      fn div_ceil(self : $t, rhs : $t) -> $t {
        assert(rhs != (0 as $t), "div_ceil by zero");
        let q = self / rhs;
        if self % rhs != (0 as $t) {
          return q + 1;
        }
        return q;
      }

      /// One for anything at or below one. Refused above the top power of two, which is the
      /// half of the range that has no next power to reach.
      fn next_power_of_two(self : $t) -> $t {
        if self <= (1 as $t) {
          return 1;
        }
        let one : $t = 1;
        let shift = self.bits() - (self - one).leading_zeros();
        assert(shift < self.bits(), "next power of two does not fit at this width");
        return one << shift;
      }

      /// Wrapping round. No mask, unlike the signed rotate: `>>` brings in zeros here.
      fn rotate_left(self : $t, n : $t) -> $t {
        let k = n % self.bits();
        if k == (0 as $t) {
          return self;
        }
        return (self << k) | (self >> (self.bits() - k));
      }

      /// The bits rotated right.
      fn rotate_right(self : $t, n : $t) -> $t {
        let k = n % self.bits();
        if k == (0 as $t) {
          return self;
        }
        return self.rotate_left(self.bits() - k);
      }

      /// The bytes reversed.
      fn swap_bytes(self : $t) -> $t {
        let eight : $t = 8;
        let mask : $t = 255;
        let mut out : $t = 0;
        let mut i : $t = 0;
        loop {
          if i == self.bits() {
            break;
          }
          let byte = (self >> i) & mask;
          out = out | (byte << (self.bits() - eight - i));
          i += eight;
        }
        return out;
      }

      /// The bits reversed.
      fn reverse_bits(self : $t) -> $t {
        let one : $t = 1;
        let mut out : $t = 0;
        let mut i : $t = 0;
        loop {
          if i == self.bits() {
            break;
          }
          let bit = (self >> i) & one;
          out = out | (bit << (self.bits() - one - i));
          i += one;
        }
        return out;
      }

      /// Nothing if it would not fit. The bound is rearranged so the check cannot overflow.
      fn checked_add(self : $t, rhs : $t) -> Option<$t> {
        if self > self.max_value() - rhs {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self + rhs);
      }

      /// Nothing if it would go below zero, which is where an unsigned width ends.
      fn checked_sub(self : $t, rhs : $t) -> Option<$t> {
        if self < rhs {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self - rhs);
      }

      /// Checked by dividing back out, exact when the product fit.
      fn checked_mul(self : $t, rhs : $t) -> Option<$t> {
        if self == (0 as $t) || rhs == (0 as $t) {
          return Option<$t>::Some(0 as $t);
        }
        let product = self * rhs;
        if product / rhs != self {
          return Option<$t>::None();
        }
        return Option<$t>::Some(product);
      }

      /// Nothing on division by zero, which is the only division that fails here.
      fn checked_div(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self / rhs);
      }

      /// Refused on a zero divisor, as `checked_div` is.
      fn checked_rem(self : $t, rhs : $t) -> Option<$t> {
        if rhs == (0 as $t) {
          return Option<$t>::None();
        }
        return Option<$t>::Some(self % rhs);
      }

      /// Held at the top of the range instead of wrapping past it.
      fn saturating_add(self : $t, rhs : $t) -> $t {
        if self > self.max_value() - rhs {
          return self.max_value();
        }
        return self + rhs;
      }

      /// Held at zero instead of wrapping below it.
      fn saturating_sub(self : $t, rhs : $t) -> $t {
        if self < rhs {
          return 0;
        }
        return self - rhs;
      }

      /// The sum, wrapping round at the width. Vx's `+` already wraps.
      fn wrapping_add(self : $t, rhs : $t) -> $t {
        return self + rhs;
      }

      /// The difference, wrapping round at the width, so subtracting past zero lands near
      /// the top.
      fn wrapping_sub(self : $t, rhs : $t) -> $t {
        return self - rhs;
      }

      /// The product, keeping the low bits and discarding the rest.
      fn wrapping_mul(self : $t, rhs : $t) -> $t {
        return self * rhs;
      }

      /// Zero minus this, wrapping.
      fn wrapping_neg(self : $t) -> $t {
        return 0 - self;
      }

      /// Clamped to the top of the width rather than wrapping. There is no other end to
      /// clamp to without a sign.
      fn saturating_mul(self : $t, rhs : $t) -> $t {
        return self.checked_mul(rhs).unwrap_or(self.max_value());
      }

      /// How many set bits the value starts with, counting from the top.
      fn leading_ones(self : $t) -> $t {
        return (!self).leading_zeros();
      }

      /// How many set bits the value ends with, counting from the bottom.
      fn trailing_ones(self : $t) -> $t {
        return (!self).trailing_zeros();
      }

      /// The wrapped sum, and whether it wrapped.
      fn overflowing_add(self : $t, rhs : $t) -> ($t, bool) {
        return (self + rhs, self.checked_add(rhs).is_none());
      }

      /// The wrapped difference, and whether it went below zero.
      fn overflowing_sub(self : $t, rhs : $t) -> ($t, bool) {
        return (self - rhs, self < rhs);
      }

      /// The wrapped product, and whether it wrapped.
      fn overflowing_mul(self : $t, rhs : $t) -> ($t, bool) {
        return (self * rhs, self.checked_mul(rhs).is_none());
      }

      /// Zero minus this, wrapping, and whether it wrapped: every value but zero does.
      fn overflowing_neg(self : $t) -> ($t, bool) {
        return (0 - self, self != (0 as $t));
      }

      /// The quotient, which never wraps at an unsigned width.
      fn overflowing_div(self : $t, rhs : $t) -> ($t, bool) {
        return (self / rhs, false);
      }

      /// The remainder, which never wraps at an unsigned width.
      fn overflowing_rem(self : $t, rhs : $t) -> ($t, bool) {
        return (self % rhs, false);
      }
    }
  };
}

stamp_unsigned_int!(u8 , i8 , 8 , 255);
stamp_unsigned_int!(u16 , i16 , 16 , 65535);
stamp_unsigned_int!(u32 , i32 , 32 , 4294967295);
stamp_unsigned_int!(u64 , i64 , 64 , 18446744073709551615);

/// Stamps the float methods for one width.
///
/// Every body is one `math` dialect op, so nothing here needs libm at the source level and
/// each backend lowers the op its own way. That is why they can be in `core`: the `math`
/// dialect reaches `exp` without a libm call.
///
/// `$t` is both the Vx type and the MLIR type, as it is for the signed integers.
macro_rules stamp_float {
  ($t : ident , $one : expr , $zero : expr , $half_circle : expr) => {
    impl $t {
      // The mathematical constants, as functions until Vx has `const` items: `f64::pi()`.
      // The literal takes this width from the return type.

      /// Pi.
      fn pi() -> $t {
        return 3.14159265358979323846264338327950288;
      }

      /// 2 pi, a full turn in radians.
      fn tau() -> $t {
        return 6.28318530717958647692528676655900577;
      }

      /// Euler's number.
      fn e() -> $t {
        return 2.71828182845904523536028747135266250;
      }

      /// Pi / 2.
      fn frac_pi_2() -> $t {
        return 1.57079632679489661923132169163975144;
      }

      /// Pi / 3.
      fn frac_pi_3() -> $t {
        return 1.04719755119659774615421446109316763;
      }

      /// Pi / 4.
      fn frac_pi_4() -> $t {
        return 0.785398163397448309615660845819875721;
      }

      /// Pi / 6.
      fn frac_pi_6() -> $t {
        return 0.52359877559829887307710723054658381;
      }

      /// Pi / 8.
      fn frac_pi_8() -> $t {
        return 0.39269908169872415480783042290993786;
      }

      /// 1 / pi.
      fn frac_1_pi() -> $t {
        return 0.318309886183790671537767526745028724;
      }

      /// 2 / pi.
      fn frac_2_pi() -> $t {
        return 0.636619772367581343075535053490057448;
      }

      /// 2 / sqrt(pi).
      fn frac_2_sqrt_pi() -> $t {
        return 1.12837916709551257389615890312154517;
      }

      /// Sqrt(2).
      fn sqrt_2() -> $t {
        return 1.41421356237309504880168872420969808;
      }

      /// 1 / sqrt(2).
      fn frac_1_sqrt_2() -> $t {
        return 0.707106781186547524400844362104849039;
      }

      /// Ln(2).
      fn ln_2() -> $t {
        return 0.693147180559945309417232121458176568;
      }

      /// Ln(10).
      fn ln_10() -> $t {
        return 2.30258509299404568401799145468436421;
      }

      /// Log2(e).
      fn log2_e() -> $t {
        return 1.44269504088896340735992468100189214;
      }

      /// Log10(e).
      fn log10_e() -> $t {
        return 0.434294481903251827651128918916605082;
      }

      /// Log2(10).
      fn log2_10() -> $t {
        return 3.32192809488736234787031942948939018;
      }

      /// Log10(2).
      fn log10_2() -> $t {
        return 0.301029995663981195213738894724493027;
      }

      /// The positive square root.
      fn sqrt(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.sqrt %a : $t
          macro.yield %r : $t
        };
      }

      /// The distance from zero, so the sign is dropped.
      fn abs(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.absf %a : $t
          macro.yield %r : $t
        };
      }

      /// e raised to this.
      fn exp(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.exp %a : $t
          macro.yield %r : $t
        };
      }

      /// Two raised to this.
      fn exp2(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.exp2 %a : $t
          macro.yield %r : $t
        };
      }

      /// `exp` minus one, kept accurate for a small argument where the subtraction would
      /// lose every significant digit.
      ///
      /// Not `math.expm1`, which lowers to exactly that subtraction. This is Kahan's method:
      /// with `u = exp(x)`, `(u - 1) * x / ln(u)`, whose two rounding errors cancel.
      fn exp_m1(self : $t) -> $t {
        let u = self.exp();
        if u == $one {
          return self;
        }
        let um1 = u - $one;
        if um1 == -$one {
          return um1;
        }
        if u.is_infinite() {
          return u;
        }
        return um1 * self / u.ln();
      }

      /// The sine of this many radians.
      fn sin(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.sin %a : $t
          macro.yield %r : $t
        };
      }

      /// The cosine of this many radians.
      fn cos(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.cos %a : $t
          macro.yield %r : $t
        };
      }

      /// The tangent of this many radians.
      fn tan(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.tan %a : $t
          macro.yield %r : $t
        };
      }

      /// The angle in radians whose sine is this, between -pi/2 and pi/2.
      fn asin(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.asin %a : $t
          macro.yield %r : $t
        };
      }

      /// The angle in radians whose cosine is this, between 0 and pi.
      fn acos(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.acos %a : $t
          macro.yield %r : $t
        };
      }

      /// The angle in radians whose tangent is this. `atan2` is the form that keeps the quadrant.
      fn atan(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.atan %a : $t
          macro.yield %r : $t
        };
      }

      /// The hyperbolic sine.
      fn sinh(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.sinh %a : $t
          macro.yield %r : $t
        };
      }

      /// The hyperbolic cosine.
      fn cosh(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.cosh %a : $t
          macro.yield %r : $t
        };
      }

      /// The hyperbolic tangent.
      fn tanh(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.tanh %a : $t
          macro.yield %r : $t
        };
      }

      /// The largest whole number no greater than this.
      fn floor(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.floor %a : $t
          macro.yield %r : $t
        };
      }

      /// The smallest whole number no less than this.
      fn ceil(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.ceil %a : $t
          macro.yield %r : $t
        };
      }

      /// The nearest whole number, halves going away from zero.
      fn round(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.round %a : $t
          macro.yield %r : $t
        };
      }

      /// The whole part, so the fraction is dropped and the sign is kept.
      fn trunc(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.trunc %a : $t
          macro.yield %r : $t
        };
      }

      /// The fractional part, which carries this value's sign.
      fn fract(self : $t) -> $t {
        return self - self.trunc();
      }

      /// This raised to `n`.
      fn powf(self : $t, n : $t) -> $t {
        return mlir!( inputs : (%a = self : $t, %b = n : $t), returns : $t, dialects : ["math"]) {
          %r = math.powf %a, %b : $t
          macro.yield %r : $t
        };
      }

      /// The angle to the point (`x`, this), which is `atan` with the quadrant kept.
      fn atan2(self : $t, x : $t) -> $t {
        return mlir!( inputs : (%a = self : $t, %b = x : $t), returns : $t, dialects : ["math"]) {
          %r = math.atan2 %a, %b : $t
          macro.yield %r : $t
        };
      }

      /// This value's magnitude with `sign`'s sign.
      fn copysign(self : $t, sign : $t) -> $t {
        return mlir!( inputs : (%a = self : $t, %b = sign : $t), returns : $t, dialects : ["math"]) {
          %r = math.copysign %a, %b : $t
          macro.yield %r : $t
        };
      }

      /// `self * a + b` with one rounding instead of two.
      fn mul_add(self : $t, a : $t, b : $t) -> $t {
        return mlir!( inputs : (%x = self : $t, %y = a : $t, %z = b : $t), returns : $t, dialects : ["math"]) {
          %r = math.fma %x, %y, %z : $t
          macro.yield %r : $t
        };
      }

      /// The length of the hypotenuse, the square root of `self * self + other * other`.
      /// The smaller side is divided by the larger first, so neither square overflows or
      /// underflows. Not the libm routine, so the last bit can differ from it.
      fn hypot(self : $t, other : $t) -> $t {
        let a = self.abs();
        let b = other.abs();
        let infinity : $t = $one / $zero;
        if a == infinity || b == infinity {
          return infinity;
        }
        if a.is_nan() || b.is_nan() {
          return a + b;
        }
        let mut big = a;
        let mut small = b;
        if b > a {
          big = b;
          small = a;
        }
        if big == $zero {
          return $zero;
        }
        let ratio = small / big;
        return big * ($one + ratio * ratio).sqrt();
      }

      /// Never negative, whatever the signs: -7.0 % 4.0 is -3.0 where this is 1.0.
      fn rem_euclid(self : $t, rhs : $t) -> $t {
        let r = self % rhs;
        if r < $zero {
          return r + rhs.abs();
        }
        return r;
      }

      /// The whole quotient pairing with `rem_euclid`.
      fn div_euclid(self : $t, rhs : $t) -> $t {
        let q = (self / rhs).trunc();
        if self % rhs < $zero {
          if rhs > $zero {
            return q - $one;
          }
          return q + $one;
        }
        return q;
      }

      /// This raised to a whole power, by squaring. A negative power gives the reciprocal.
      fn powi(self : $t, n : i32) -> $t {
        // In `i64`, so the smallest `i32` can be negated.
        let mut e : i64 = n as i64;
        if e < 0 {
          e = -e;
        }
        let mut result : $t = $one;
        let mut base : $t = self;
        loop {
          if e == 0 {
            break;
          }
          if (e & 1) == 1 {
            result = result * base;
          }
          base = base * base;
          e = e >> 1;
        }
        if n < 0 {
          return $one / result;
        }
        return result;
      }

      /// The larger of the two. A NaN is ignored: the other value is the answer. A NaN on the
      /// left fails the comparison, so only the right needs a test.
      fn max(self : $t, other : $t) -> $t {
        if other.is_nan() || self > other {
          return self;
        }
        return other;
      }

      /// The smaller of the two. A NaN is ignored: the other value is the answer.
      fn min(self : $t, other : $t) -> $t {
        if other.is_nan() || self < other {
          return self;
        }
        return other;
      }

      /// Held between `lo` and `hi`. A NaN stays a NaN. Refused when `lo` is above `hi`
      /// or either bound is a NaN.
      fn clamp(self : $t, lo : $t, hi : $t) -> $t {
        assert(lo <= hi, "clamp needs lo at or below hi, and neither a NaN");
        let mut x = self;
        if x < lo {
          x = lo;
        }
        if x > hi {
          x = hi;
        }
        return x;
      }

      /// One divided by this.
      fn recip(self : $t) -> $t {
        return $one / self;
      }

      /// This many radians in degrees.
      fn to_degrees(self : $t) -> $t {
        return self * ($half_circle / 3.14159265358979323846);
      }

      /// This many degrees in radians.
      fn to_radians(self : $t) -> $t {
        return self * (3.14159265358979323846 / $half_circle);
      }

      /// Is this the value that is equal to nothing, itself included?
      fn is_nan(self : $t) -> bool {
        return self != self;
      }

      /// One with this value's sign, or the value itself when it is a NaN. A zero answers 1
      /// with the zero's sign, not 0.
      fn signum(self : $t) -> $t {
        if self.is_nan() {
          return self;
        }
        let one : $t = $one;
        return one.copysign(self);
      }

      /// Is this a real number, rather than an infinity or a NaN?
      fn is_finite(self : $t) -> bool {
        if self.is_nan() {
          return false;
        }
        let infinity : $t = $one / $zero;
        let magnitude : $t = self.abs();
        return magnitude != infinity;
      }

      /// Is this an infinity, of either sign?
      fn is_infinite(self : $t) -> bool {
        if self.is_nan() {
          return false;
        }
        let infinity : $t = $one / $zero;
        let magnitude : $t = self.abs();
        return magnitude == infinity;
      }

      /// The logarithm to `base`, as `ln(self) / ln(base)`.
      fn log(self : $t, base : $t) -> $t {
        return self.ln() / base.ln();
      }

      /// The nearest whole number, halves going to the even neighbour: 2.5 gives 2.0.
      fn round_ties_even(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.roundeven %a : $t
          macro.yield %r : $t
        };
      }

      /// The sine and the cosine, as a pair.
      fn sin_cos(self : $t) -> ($t, $t) {
        return (self.sin(), self.cos());
      }

      /// Halfway between two values, without overflowing near the largest value or losing
      /// the answer to underflow near the smallest.
      fn midpoint(self : $t, other : $t) -> $t {
        let lo : $t = $t::min_positive() * 2.0;
        let hi : $t = $t::max_value() / 2.0;
        let abs_a = self.abs();
        let abs_b = other.abs();
        if abs_a <= hi && abs_b <= hi {
          return (self + other) / 2.0;
        }
        if abs_a < lo {
          return self + other / 2.0;
        }
        if abs_b < lo {
          return self / 2.0 + other;
        }
        return self / 2.0 + other / 2.0;
      }

      /// Is the sign bit set? True for -0.0, and for a NaN whose sign bit is set.
      fn is_sign_negative(self : $t) -> bool {
        let one : $t = $one;
        return one.copysign(self) < $zero;
      }

      /// Is the sign bit clear? True for 0.0, and for a NaN whose sign bit is clear.
      fn is_sign_positive(self : $t) -> bool {
        return !self.is_sign_negative();
      }

      /// Is this neither zero, infinite, subnormal nor a NaN?
      fn is_normal(self : $t) -> bool {
        return self.is_finite() && self.abs() >= $t::min_positive();
      }

      /// Is this nonzero but smaller in size than the smallest normal value?
      fn is_subnormal(self : $t) -> bool {
        let m = self.abs();
        return m != $zero && m < $t::min_positive();
      }

      /// Which of the five kinds of float value this is.
      fn classify(self : $t) -> FpCategory {
        if self.is_nan() {
          return FpCategory::Nan();
        }
        if self.is_infinite() {
          return FpCategory::Infinite();
        }
        if self == $zero {
          return FpCategory::Zero();
        }
        if self.is_subnormal() {
          return FpCategory::Subnormal();
        }
        return FpCategory::Normal();
      }
    }
  };
}

stamp_float!(f32 , 1.0 , 0.0 , 180.0);
stamp_float!(f64 , 1.0 , 0.0 , 180.0);
stamp_float!(f16 , 1.0 , 0.0 , 180.0);
stamp_float!(bf16 , 1.0 , 0.0 , 180.0);

/// Stamps `ln`, `log2`, `log10` and `ln_1p` through the platform's `math` operations, for the
/// widths without a `core::libm` version yet: `f64`. The other widths use `core::libm`'s.
macro_rules stamp_float_logs {
  ($t : ident , $one : expr) => {
    impl $t {
      /// The natural logarithm.
      fn ln(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.log %a : $t
          macro.yield %r : $t
        };
      }

      /// The logarithm to base two.
      fn log2(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.log2 %a : $t
          macro.yield %r : $t
        };
      }

      /// The logarithm to base ten.
      fn log10(self : $t) -> $t {
        return mlir!( inputs : (%a = self : $t), returns : $t, dialects : ["math"]) {
          %r = math.log10 %a : $t
          macro.yield %r : $t
        };
      }

      /// `ln` of one plus this, kept accurate for a small argument.
      ///
      /// Not `math.log1p`, which lowers to `ln(1 + x)` and loses the small argument in the
      /// addition. With `u = 1 + x`, `ln(u) * x / (u - 1)` corrects for that rounding.
      fn ln_1p(self : $t) -> $t {
        let u = $one + self;
        if u == $one {
          return self;
        }
        if u.is_infinite() {
          return u;
        }
        return u.ln() * self / (u - $one);
      }
    }
  };
}

stamp_float_logs!(f64 , 1.0);

/// Stamps `asinh`, `acosh` and `atanh` as formulas through `ln_1p` and `ln`, for the widths
/// LLVM libc has no version of yet: `f64`, `f16` and `bf16`. `f32` uses `core::libm`'s, below.
macro_rules stamp_float_inverse_hyperbolic {
  ($t : ident , $one : expr , $zero : expr) => {
    impl $t {
      /// The inverse hyperbolic sine, `ln(|x| + sqrt(x^2 + 1))` with the sign of `x`, written
      /// as `ln_1p` of `|x| + |x| / (hypot(1, 1/|x|) + 1/|x|)` so it stays accurate near zero.
      fn asinh(self : $t) -> $t {
        let ax = self.abs();
        let one : $t = $one;
        let ix = one / ax;
        return (ax + (ax / (one.hypot(ix) + ix))).ln_1p().copysign(self);
      }

      /// The inverse hyperbolic cosine, NaN below one: `ln(x + sqrt(x - 1) * sqrt(x + 1))`.
      /// Below two, `ln` of a number just above one loses digits, so with `t = x - 1` this
      /// takes `ln_1p(t + sqrt(2t + t * t))` instead, which keeps them.
      fn acosh(self : $t) -> $t {
        if self < $one {
          return $zero / $zero;
        }
        let t = self - $one;
        if t < $one {
          return (t + (2.0 * t + t * t).sqrt()).ln_1p();
        }
        return (self + (t.sqrt() * (self + $one).sqrt())).ln();
      }

      /// The inverse hyperbolic tangent, `ln_1p(2x / (1 - x)) / 2`.
      fn atanh(self : $t) -> $t {
        return 0.5 * ((2.0 * self) / ($one - self)).ln_1p();
      }
    }
  };
}

stamp_float_inverse_hyperbolic!(f64 , 1.0 , 0.0);
stamp_float_inverse_hyperbolic!(f16 , 1.0 , 0.0);
stamp_float_inverse_hyperbolic!(bf16 , 1.0 , 0.0);

impl f32 {
  /// The inverse hyperbolic sine, correctly rounded (LLVM libc's `asinhf`).
  fn asinh(self : f32) -> f32 {
    return libm_asinhf(self);
  }

  /// The inverse hyperbolic cosine, correctly rounded; NaN below one (LLVM libc's `acoshf`).
  fn acosh(self : f32) -> f32 {
    return libm_acoshf(self);
  }

  /// The inverse hyperbolic tangent, correctly rounded; infinite at plus or minus one and NaN
  /// beyond (LLVM libc's `atanhf`).
  fn atanh(self : f32) -> f32 {
    return libm_atanhf(self);
  }

  /// The natural logarithm, correctly rounded (LLVM libc's `logf`).
  fn ln(self : f32) -> f32 {
    return libm_logf(self);
  }

  /// The logarithm to base two, correctly rounded (LLVM libc's `log2f`).
  fn log2(self : f32) -> f32 {
    return libm_log2f(self);
  }

  /// The logarithm to base ten, correctly rounded (LLVM libc's `log10f`).
  fn log10(self : f32) -> f32 {
    return libm_log10f(self);
  }

  /// `ln` of one plus this, correctly rounded (LLVM libc's `log1pf`).
  fn ln_1p(self : f32) -> f32 {
    return libm_log1pf(self);
  }
}

impl f16 {
  /// The natural logarithm, correctly rounded (LLVM libc's `logf16`).
  fn ln(self : f16) -> f16 {
    return libm_logf16(self);
  }

  /// The logarithm to base two, correctly rounded (LLVM libc's `log2f16`).
  fn log2(self : f16) -> f16 {
    return libm_log2f16(self);
  }

  /// The logarithm to base ten, correctly rounded (LLVM libc's `log10f16`).
  fn log10(self : f16) -> f16 {
    return libm_log10f16(self);
  }

  /// `ln` of one plus this, correctly rounded (through LLVM libc's `log1pf`).
  fn ln_1p(self : f16) -> f16 {
    return libm_log1pf16(self);
  }
}

impl bf16 {
  /// The natural logarithm, correctly rounded (LLVM libc's `log_bf16`).
  fn ln(self : bf16) -> bf16 {
    return libm_log_bf16(self);
  }

  /// The logarithm to base two, correctly rounded (through LLVM libc's `log2f`).
  fn log2(self : bf16) -> bf16 {
    return libm_log2_bf16(self);
  }

  /// The logarithm to base ten, correctly rounded (through LLVM libc's `log10f`).
  fn log10(self : bf16) -> bf16 {
    return libm_log10_bf16(self);
  }

  /// `ln` of one plus this, correctly rounded (through LLVM libc's `log1pf`).
  fn ln_1p(self : bf16) -> bf16 {
    return libm_log1p_bf16(self);
  }
}

// The limits of each float width. Written as `arith.constant`, since a Vx literal has no
// exponent and cannot spell an infinity or a NaN. Static, as the constants are: `f64::nan()`.
// The integer widths still ask for theirs through a value, `x.max_value()`.
impl f64 {
  /// The largest finite value.
  fn max_value() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant 1.7976931348623157e+308 : f64
      macro.yield %r : f64
    };
  }

  /// The most negative finite value.
  fn min_value() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant -1.7976931348623157e+308 : f64
      macro.yield %r : f64
    };
  }

  /// The gap between 1.0 and the next larger value.
  fn epsilon() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant 2.220446049250313e-16 : f64
      macro.yield %r : f64
    };
  }

  /// The smallest positive normal value.
  fn min_positive() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant 2.2250738585072014e-308 : f64
      macro.yield %r : f64
    };
  }

  /// Positive infinity.
  fn infinity() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant 0x7FF0000000000000 : f64
      macro.yield %r : f64
    };
  }

  /// Negative infinity.
  fn neg_infinity() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant 0xFFF0000000000000 : f64
      macro.yield %r : f64
    };
  }

  /// A quiet NaN.
  fn nan() -> f64 {
    return mlir!( inputs : (), returns : f64, dialects : ["arith"]) {
      %r = arith.constant 0x7FF8000000000000 : f64
      macro.yield %r : f64
    };
  }
}

impl f32 {
  /// The largest finite value.
  fn max_value() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant 3.40282347e+38 : f32
      macro.yield %r : f32
    };
  }

  /// The most negative finite value.
  fn min_value() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant -3.40282347e+38 : f32
      macro.yield %r : f32
    };
  }

  /// The gap between 1.0 and the next larger value.
  fn epsilon() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant 1.1920929e-07 : f32
      macro.yield %r : f32
    };
  }

  /// The smallest positive normal value.
  fn min_positive() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant 1.17549435e-38 : f32
      macro.yield %r : f32
    };
  }

  /// Positive infinity.
  fn infinity() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant 0x7F800000 : f32
      macro.yield %r : f32
    };
  }

  /// Negative infinity.
  fn neg_infinity() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant 0xFF800000 : f32
      macro.yield %r : f32
    };
  }

  /// A quiet NaN.
  fn nan() -> f32 {
    return mlir!( inputs : (), returns : f32, dialects : ["arith"]) {
      %r = arith.constant 0x7FC00000 : f32
      macro.yield %r : f32
    };
  }
}

