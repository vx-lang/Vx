// The `Iterator` trait on its own, which is what a type needs in order to implement it.
//
// Separate from `core::iter` because an import brings every name the module declares into the
// importer, and so into everything that imports the importer. `std::vec` implements this trait;
// importing all of `core::iter` there put `Range`, `Map` and the free `range`/`map` in front of
// every program that uses a `Vec`, where a type of the same name crashes codegen. Rust keeps
// its trait in `core::iter::traits` for the same reason of layering.
//
// A method whose `loop` only ever leaves by `return` still needs a return after it: the checker
// does not treat such a loop as diverging (E3028). Those are unreachable.
import core::cmp;
import core::iter::adapters;
import core::ops;
import core::option;

trait Iterator {
  /// What `next` hands out.
  type Item;

  /// The next item, or nothing once the sequence is finished.
  ///
  /// The only required method. Every other method of this trait is a default written over it,
  /// so a type becomes iterable by writing this one.
  ///
  /// Calling it again after it has answered nothing is allowed and answers nothing again; an
  /// iterator that would resume is not something this trait promises either way.
  fn next(self : &mut Self) -> Option<Self::Item>;

  /// How many items are left, consuming them all to find out.
  fn count(self : &mut Self) -> i64 {
    let mut n : i64 = 0;
    loop {
      let step = self.next();
      if step.is_none() {
        break;
      }
      n = n + 1i64;
    }
    return n;
  }

  /// The final item, consuming the sequence. Nothing when it is already finished.
  fn last(self : &mut Self) -> Option<Self::Item> {
    let mut seen = self.next();
    loop {
      let step = self.next();
      if step.is_none() {
        break;
      }
      seen = step;
    }
    return seen;
  }

  /// The item `n` places along, counting the next one as zero, discarding those before it.
  ///
  /// Nothing when the sequence finishes first. The items skipped are consumed either way.
  fn nth(self : &mut Self, n : i64) -> Option<Self::Item> {
    let mut left : i64 = n;
    loop {
      let step = self.next();
      if step.is_none() {
        return step;
      }
      if left == 0i64 {
        return step;
      }
      left = left - 1i64;
    }
    return self.next();
  }

  /// Does `f` accept any item? Stops at the first it does, leaving the rest unconsumed.
  fn any(self : &mut Self, f : Closure1<Self::Item, bool>) -> bool {
    loop {
      let step = self.next();
      if step.is_none() {
        return false;
      }
      let p = f.func;
      if p(f.env, step.unwrap()) {
        return true;
      }
    }
    return false;
  }

  /// Does `f` accept every item? Stops at the first it does not.
  ///
  /// True for a sequence that is already finished, which is the usual convention: there is no
  /// item to disagree.
  fn all(self : &mut Self, f : Closure1<Self::Item, bool>) -> bool {
    loop {
      let step = self.next();
      if step.is_none() {
        return true;
      }
      let p = f.func;
      if !p(f.env, step.unwrap()) {
        return false;
      }
    }
    return true;
  }

  /// The first item `f` accepts, or nothing. Stops there, so the rest is unconsumed.
  fn find(self : &mut Self, f : Closure1<Self::Item, bool>) -> Option<Self::Item> {
    loop {
      let step = self.next();
      if step.is_none() {
        return step;
      }
      let kept = step.filter(f);
      if kept.is_some() {
        return kept;
      }
    }
    return self.next();
  }

  /// How far along the first item `f` accepts is, counting the next one as zero.
  fn position(self : &mut Self, f : Closure1<Self::Item, bool>) -> Option<i64> {
    let mut at : i64 = 0;
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<i64>::None();
      }
      let p = f.func;
      if p(f.env, step.unwrap()) {
        return Option<i64>::Some(at);
      }
      at = at + 1i64;
    }
    return Option<i64>::None();
  }

  /// Hand every item to `f`, consuming the sequence.
  ///
  /// `f` answers an `i32` rather than nothing, and this returns the last of them, because no
  /// closure literal can return void yet (Vx#711). Both signatures become Rust's when it can.
  fn for_each(self : &mut Self, f : Closure1<Self::Item, i32>) -> i32 {
    loop {
      let step = self.next();
      if step.is_none() {
        return 0;
      }
      let p = f.func;
      p(f.env, step.unwrap());
    }
    return 0;
  }

  /// `f` over every item, carrying a value from one to the next: `init` goes in with the
  /// first item, and what `f` answers goes in with the next. The last answer is the result,
  /// or `init` for a sequence that is already finished.
  fn fold<B>(self : &mut Self, init : B, f : Closure2<B, Self::Item, B>) -> B {
    let mut acc : B = init;
    loop {
      let step = self.next();
      if step.is_none() {
        return acc;
      }
      let p = f.func;
      acc = p(f.env, acc, step.unwrap());
    }
    return acc;
  }

  /// Every item added up, consuming the sequence. Zero for one that is already finished.
  ///
  /// The item type says how, by implementing `Sum`. Rust also lets the caller choose a result
  /// type other than the item's; here the two are the same.
  fn sum(self : &mut Self) -> Self::Item {
    return Self::Item::sum(self);
  }

  /// Every item multiplied together, consuming the sequence. One for one already finished.
  ///
  /// The item type says how, by implementing `Product`.
  fn product(self : &mut Self) -> Self::Item {
    return Self::Item::product(self);
  }

  /// The greatest item, or nothing for a sequence already finished. Of several equal greatest
  /// items, the last.
  fn max(self : &mut Self) -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut best = first.unwrap();
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(best);
      }
      let v = step.unwrap();
      if !v.cmp(&best).is_lt() {
        best = v;
      }
    }
    return first;
  }

  /// The least item, or nothing for a sequence already finished. Of several equal least items,
  /// the first.
  fn min(self : &mut Self) -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut best = first.unwrap();
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(best);
      }
      let v = step.unwrap();
      if v.cmp(&best).is_lt() {
        best = v;
      }
    }
    return first;
  }

  /// The greatest item as `compare` orders them, `compare(a, b)` saying where `a` sits against
  /// `b`. Of several equal greatest items, the last.
  fn max_by(self : &mut Self, compare : Closure2<&Self::Item, &Self::Item, Ordering>)
  -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut best = first.unwrap();
    let p = compare.func;
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(best);
      }
      let v = step.unwrap();
      if !p(compare.env, &v, &best).is_lt() {
        best = v;
      }
    }
    return first;
  }

  /// The least item as `compare` orders them. Of several equal least items, the first.
  fn min_by(self : &mut Self, compare : Closure2<&Self::Item, &Self::Item, Ordering>)
  -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut best = first.unwrap();
    let p = compare.func;
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(best);
      }
      let v = step.unwrap();
      if p(compare.env, &v, &best).is_lt() {
        best = v;
      }
    }
    return first;
  }

  /// The item whose `key` is greatest. Of several with equal greatest keys, the last.
  fn max_by_key<B>(self : &mut Self, key : Closure1<&Self::Item, B>) -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut best = first.unwrap();
    let p = key.func;
    let mut best_key : B = p(key.env, &best);
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(best);
      }
      let v = step.unwrap();
      let k : B = p(key.env, &v);
      if !k.cmp(&best_key).is_lt() {
        best = v;
        best_key = k;
      }
    }
    return first;
  }

  /// The item whose `key` is least. Of several with equal least keys, the first.
  fn min_by_key<B>(self : &mut Self, key : Closure1<&Self::Item, B>) -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut best = first.unwrap();
    let p = key.func;
    let mut best_key : B = p(key.env, &best);
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(best);
      }
      let v = step.unwrap();
      let k : B = p(key.env, &v);
      if k.cmp(&best_key).is_lt() {
        best = v;
        best_key = k;
      }
    }
    return first;
  }

  /// An iterator over these items with `f` applied to each.
  fn map<U>(self : Self, f : Closure1<Self::Item, U>) -> Map<Self, Closure1<Self::Item, U>> {
    return Map<Self, Closure1<Self::Item, U>> {
      inner : self, f : f
    };
  }

  /// An iterator over the items `keep` accepts.
  fn filter(self : Self, keep : Closure1<&Self::Item, bool>)
  -> Filter<Self, Closure1<&Self::Item, bool>> {
    return Filter<Self, Closure1<&Self::Item, bool>> {
      inner : self, keep : keep
    };
  }

  /// An iterator over at most the first `n` items.
  fn take(self : Self, n : i64) -> Take<Self> {
    return Take<Self> {
      inner : self, left : n
    };
  }

  /// An iterator over the items after the first `n`.
  fn skip(self : Self, n : i64) -> Skip<Self> {
    return Skip<Self> {
      inner : self, drop : n
    };
  }

  /// An iterator over the first item and every `step`th one after it.
  ///
  /// # Panics
  ///
  /// When `step` is not positive: a step of zero would hand out the first item forever.
  fn step_by(self : Self, step : i64) -> StepBy<Self> {
    assert(step > 0i64, "step_by needs a step of at least one");
    return StepBy<Self> {
      inner : self, gap : step - 1i64, first : true
    };
  }

  /// An iterator over these items and then `other`'s, which must be of the same type.
  fn chain<B>(self : Self, other : B) -> Chain<Self, B> {
    return Chain<Self, B> {
      a : self, b : other, a_done : false
    };
  }

  /// An iterator over the leading items `keep` accepts, stopping at the first it refuses.
  fn take_while(self : Self, keep : Closure1<&Self::Item, bool>)
  -> TakeWhile<Self, Closure1<&Self::Item, bool>> {
    return TakeWhile<Self, Closure1<&Self::Item, bool>> {
      inner : self, keep : keep, done : false
    };
  }

  /// An iterator over the items from the first one `skip` refuses onward.
  fn skip_while(self : Self, skip : Closure1<&Self::Item, bool>)
  -> SkipWhile<Self, Closure1<&Self::Item, bool>> {
    return SkipWhile<Self, Closure1<&Self::Item, bool>> {
      inner : self, skip : skip, done : false
    };
  }

  /// An iterator over what `f` answers for each item, ending where `f` first answers nothing.
  fn map_while<U>(self : Self, f : Closure1<Self::Item, Option<U>>)
  -> MapWhile<Self, Closure1<Self::Item, Option<U>>> {
    return MapWhile<Self, Closure1<Self::Item, Option<U>>> {
      inner : self, f : f
    };
  }

  /// An iterator over these items that hands each to `f` on its way past.
  ///
  /// `f` answers an `i32`, which is discarded, because no closure literal can return void yet.
  fn inspect(self : Self, f : Closure1<&Self::Item, i32>)
  -> Inspect<Self, Closure1<&Self::Item, i32>> {
    return Inspect<Self, Closure1<&Self::Item, i32>> {
      inner : self, f : f
    };
  }

  /// An iterator over what `f` answers for each item, with `f` given `initial` to keep and
  /// change from one item to the next. Ends where `f` first answers nothing.
  fn scan<St, B>(self : Self, initial : St, f : Closure2<&mut St, Self::Item, Option<B>>)
  -> Scan<Self, St, Closure2<&mut St, Self::Item, Option<B>>> {
    return Scan<Self, St, Closure2<&mut St, Self::Item, Option<B>>> {
      inner : self, state : initial, f : f
    };
  }

  /// An iterator over these items, repeated forever. Each pass restarts from a clone of this
  /// iterator as it was when `cycle` was called, so the type must implement `Clone`. An
  /// iterator with no items gives one with none.
  fn cycle(self : Self) -> Cycle<Self> {
    return Cycle<Self> {
      orig : self, cur : Option<Self>::None()
    };
  }

  /// An iterator that answers nothing forever once these items have run out.
  fn fuse(self : Self) -> Fuse<Self> {
    return Fuse<Self> {
      inner : self, done : false
    };
  }

  /// An iterator whose next item can be looked at, by `peek`, without taking it.
  fn peekable(self : Self) -> Peekable<Self, Self::Item> {
    return Peekable<Self, Self::Item> {
      inner : self, peeked : Option<Self::Item>::None(), has_peeked : false
    };
  }

  /// An iterator over the items of each iterator `f` answers, in order.
  ///
  /// `f` answers an iterator, where Rust accepts anything that can become one.
  fn flat_map<U>(self : Self, f : Closure1<Self::Item, U>) -> FlatMap<Self, Closure1<Self::Item, U>, U> {
    return FlatMap<Self, Closure1<Self::Item, U>, U> {
      outer : self, f : f, front : Option<U>::None()
    };
  }

  /// An iterator over the items of each of these items, which are iterators themselves.
  fn flatten(self : Self) -> Flatten<Self, Self::Item> {
    return Flatten<Self, Self::Item> {
      outer : self, front : Option<Self::Item>::None()
    };
  }

  /// An iterator over these items from the back, for an iterator that can answer from both ends.
  fn rev(self : Self) -> Rev<Self> {
    return Rev<Self> {
      inner : self
    };
  }

  /// An iterator over pairs of these items and `other`'s, in step, as long as both last.
  fn zip<U>(self : Self, other : U) -> Zip<Self, U> {
    return Zip<Self, U> {
      a : self, b : other
    };
  }

  /// An iterator over these items, each paired with its position, counting from zero.
  ///
  /// The position is an `i64`, where Rust's is a `usize`.
  fn enumerate(self : Self) -> Enumerate<Self> {
    return Enumerate<Self> {
      inner : self, count : 0i64
    };
  }

  /// `fold` with the first item as the starting value, so nothing for a sequence already
  /// finished.
  fn reduce(self : &mut Self, f : Closure2<Self::Item, Self::Item, Self::Item>)
  -> Option<Self::Item> {
    let first = self.next();
    if first.is_none() {
      return first;
    }
    let mut acc = first.unwrap();
    let p = f.func;
    loop {
      let step = self.next();
      if step.is_none() {
        return Option<Self::Item>::Some(acc);
      }
      acc = p(f.env, acc, step.unwrap());
    }
    return first;
  }

  /// Every item, gathered into a new collection of whatever type the result is assigned to:
  /// `let v : Vec<i64> = it.collect();`. That type says how, by implementing `FromIterator`.
  fn collect<B>(self : &mut Self) -> B {
    return B::from_iter(self);
  }

  /// Every item, split in two by `f`: the ones it accepts first, the rest second. Each half
  /// is a collection of whatever type the result is assigned to, which starts from its
  /// `Default` and grows through `Extend`.
  fn partition<B>(self : &mut Self, f : Closure1<&Self::Item, bool>) -> (B, B) {
    let mut yes = B::default();
    let mut no = B::default();
    let p = f.func;
    loop {
      let step = self.next();
      if step.is_none() {
        return (yes, no);
      }
      let v = step.unwrap();
      if p(f.env, &v) {
        yes.extend_one(v);
      } else {
        no.extend_one(v);
      }
    }
    return (yes, no);
  }

  /// An iterator of pairs, split into two collections: the first of each pair in one, the
  /// second in the other.
  fn unzip<FromA, FromB>(self : &mut Self) -> (FromA, FromB) {
    let mut left = FromA::default();
    let mut right = FromB::default();
    loop {
      let step = self.next();
      if step.is_none() {
        return (left, right);
      }
      let pair = step.unwrap();
      left.extend_one(pair.0);
      right.extend_one(pair.1);
    }
    return (left, right);
  }

  // This method and the seven after it name their type parameter `Other`, not `I`: a method
  // parameter that shares a name with one of the receiver's (`Map<I, F>`) takes its type.

  /// These items against `other`'s, in step, by their `Ord`: the first pair that differs
  /// decides. When one sequence runs out first and every pair so far was equal, the shorter
  /// one is Less, as for words in a dictionary.
  fn cmp<Other>(self : &mut Self, other : Other) -> Ordering {
    let mut rest = other;
    loop {
      let x = self.next();
      let y = rest.next();
      if x.is_none() {
        if y.is_none() {
          return Ordering::Equal();
        }
        return Ordering::Less();
      }
      if y.is_none() {
        return Ordering::Greater();
      }
      let a = x.unwrap();
      let b = y.unwrap();
      let order = a.cmp(&b);
      if !order.is_eq() {
        return order;
      }
    }
    return Ordering::Equal();
  }

  /// `cmp` by the items' `PartialOrd`, so nothing as soon as a pair does not compare, which is
  /// what a NaN does.
  fn partial_cmp<Other>(self : &mut Self, other : Other) -> Option<Ordering> {
    let mut rest = other;
    loop {
      let x = self.next();
      let y = rest.next();
      if x.is_none() {
        if y.is_none() {
          return Option<Ordering>::Some(Ordering::Equal());
        }
        return Option<Ordering>::Some(Ordering::Less());
      }
      if y.is_none() {
        return Option<Ordering>::Some(Ordering::Greater());
      }
      let a = x.unwrap();
      let b = y.unwrap();
      let order = a.partial_cmp(&b);
      if order.is_none() {
        return order;
      }
      let decided = order.unwrap();
      if !decided.is_eq() {
        return Option<Ordering>::Some(decided);
      }
    }
    return Option<Ordering>::None();
  }

  /// Are these items equal to `other`'s, one for one and as many of them?
  fn eq<Other>(self : &mut Self, other : Other) -> bool {
    let mut rest = other;
    loop {
      let x = self.next();
      let y = rest.next();
      if x.is_none() {
        return y.is_none();
      }
      if y.is_none() {
        return false;
      }
      let a = x.unwrap();
      let b = y.unwrap();
      if !a.eq(&b) {
        return false;
      }
    }
    return false;
  }

  /// Do these items differ from `other`'s anywhere, or in how many there are?
  fn ne<Other>(self : &mut Self, other : Other) -> bool {
    return !self.eq(other);
  }

  /// Are these items less than `other`'s, in the order `partial_cmp` gives? False when some
  /// pair does not compare.
  fn lt<Other>(self : &mut Self, other : Other) -> bool {
    let order = self.partial_cmp(other);
    if order.is_none() {
      return false;
    }
    return order.unwrap().is_lt();
  }

  /// Less than or equal, by `partial_cmp`. False when some pair does not compare.
  fn le<Other>(self : &mut Self, other : Other) -> bool {
    let order = self.partial_cmp(other);
    if order.is_none() {
      return false;
    }
    return order.unwrap().is_le();
  }

  /// Greater than, by `partial_cmp`. False when some pair does not compare.
  fn gt<Other>(self : &mut Self, other : Other) -> bool {
    let order = self.partial_cmp(other);
    if order.is_none() {
      return false;
    }
    return order.unwrap().is_gt();
  }

  /// Greater than or equal, by `partial_cmp`. False when some pair does not compare.
  fn ge<Other>(self : &mut Self, other : Other) -> bool {
    let order = self.partial_cmp(other);
    if order.is_none() {
      return false;
    }
    return order.unwrap().is_ge();
  }
}

/// An iterator that can also answer from its far end, which is what `rev` needs.
///
/// Rust declares it as a subtrait of `Iterator`; Vx has no subtraits, and `Self::Item` here is
/// the one the type's `Iterator` impl binds.
trait DoubleEndedIterator {
  /// The last item not yet handed out from either end, or nothing once they meet.
  fn next_back(self : &mut Self) -> Option<Self::Item>;

  /// `fold`, from the back.
  fn rfold<B>(self : &mut Self, init : B, f : Closure2<B, Self::Item, B>) -> B {
    let mut acc : B = init;
    loop {
      let step = self.next_back();
      if step.is_none() {
        return acc;
      }
      let p = f.func;
      acc = p(f.env, acc, step.unwrap());
    }
    return acc;
  }

  /// The last item `f` accepts, searching from the back.
  fn rfind(self : &mut Self, f : Closure1<&Self::Item, bool>) -> Option<Self::Item> {
    loop {
      let step = self.next_back();
      if step.is_none() {
        return step;
      }
      let v = step.unwrap();
      let p = f.func;
      if p(f.env, &v) {
        return Option<Self::Item>::Some(v);
      }
    }
    return Option<Self::Item>::None();
  }

  /// The item `n` places from the back, counting the last as zero.
  fn nth_back(self : &mut Self, n : i64) -> Option<Self::Item> {
    let mut left : i64 = n;
    loop {
      let step = self.next_back();
      if step.is_none() {
        return step;
      }
      if left == 0i64 {
        return step;
      }
      left = left - 1i64;
    }
    return Option<Self::Item>::None();
  }
}

/// An iterator that knows how many items it has left, which is what `rev` needs from `take`,
/// `skip` and `step_by`.
///
/// Rust declares it as a subtrait of `Iterator`; Vx has no subtraits.
trait ExactSizeIterator {
  /// How many items are left.
  fn len(self : &Self) -> i64;

  /// Whether no items are left.
  fn is_empty(self : &Self) -> bool {
    return self.len() == 0i64;
  }
}

/// A collection that can be built from an iterator's items, which is what `collect` builds.
trait FromIterator<A> {
  /// A new collection holding every item `iter` has left, in order.
  fn from_iter<I : Iterator>(iter : I) -> Self;
}

/// A collection that grows by an iterator's items, which is what `partition` and `unzip` fill.
trait Extend<A> {
  /// Add every item `iter` has left, in order.
  fn extend<I : Iterator>(self : &mut Self, iter : I) -> i32;

  /// Add one item.
  fn extend_one(self : &mut Self, item : A) -> i32;
}

/// A type whose values can be added up from an iterator's items, which is what `sum` does.
trait Sum<A> {
  /// Every item `iter` has left, added up. Zero when it has none.
  fn sum<I : Iterator>(iter : I) -> Self;
}

/// A type whose values can be multiplied together from an iterator's items, which is what
/// `product` does.
trait Product<A> {
  /// Every item `iter` has left, multiplied together. One when it has none.
  fn product<I : Iterator>(iter : I) -> Self;
}

/// `Sum` and `Product` for one number type, starting from its zero and its one.
macro_rules stamp_accumulate {
  ($t : ident , $zero : expr , $one : expr) => {
    impl Sum<$t> for $t {
      /// Every item added up, from zero.
      fn sum<I : Iterator>(iter : I) -> $t {
        let mut it = iter;
        let mut total : $t = $zero;
        loop {
          let step = it.next();
          if step.is_none() {
            return total;
          }
          total = total + step.unwrap();
        }
        return total;
      }
    }

    impl Product<$t> for $t {
      /// Every item multiplied together, from one.
      fn product<I : Iterator>(iter : I) -> $t {
        let mut it = iter;
        let mut total : $t = $one;
        loop {
          let step = it.next();
          if step.is_none() {
            return total;
          }
          total = total * step.unwrap();
        }
        return total;
      }
    }
  };
}

stamp_accumulate!(i8 , 0 , 1);
stamp_accumulate!(i16 , 0 , 1);
stamp_accumulate!(i32 , 0 , 1);
stamp_accumulate!(i64 , 0 , 1);
stamp_accumulate!(u8 , 0 , 1);
stamp_accumulate!(u16 , 0 , 1);
stamp_accumulate!(u32 , 0 , 1);
stamp_accumulate!(u64 , 0 , 1);
stamp_accumulate!(f32 , 0.0 , 1.0);
stamp_accumulate!(f64 , 0.0 , 1.0);
