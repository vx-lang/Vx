//===----------------------------------------------------------------------===//
// The iterators the adaptor methods of `Iterator` build: `it.map(f)` is a `Map`, and so on.
//
// Each names its inner iterator's item type as `I::Item`. As in Rust, an adaptor that holds a
// closure takes it as a type parameter, because a struct field cannot name `I::Item`; the impl
// states the closure's type, and applies only when that agrees with the inner iterator.
//
// `core::iter::traits` imports this module, since the trait's methods return these types, and
// every program that imports the trait therefore sees these names.
import core::clone;
import core::iter::traits;
import core::ops;
import core::option;

/// An iterator over another one's items with `f` applied to each. Built by `map`.
struct Map<I, F> {
  inner : I,
  f : F,
}

impl<I : Iterator, U> Iterator for Map<I, Closure1<I::Item, U>> {
  type Item = U;

  /// The inner iterator's next item with `f` applied.
  fn next(self : &mut Map<I, Closure1<I::Item, U>>) -> Option<U> {
    let step = self.inner.next();
    if step.is_none() {
      return Option<U>::None();
    }
    let g = self.f;
    let p = g.func;
    return Option<U>::Some(p(g.env, step.unwrap()));
  }
}

impl<I : DoubleEndedIterator, U> DoubleEndedIterator for Map<I, Closure1<I::Item, U>> {
  /// The inner iterator's last item with `f` applied.
  fn next_back(self : &mut Map<I, Closure1<I::Item, U>>) -> Option<U> {
    let step = self.inner.next_back();
    if step.is_none() {
      return Option<U>::None();
    }
    let g = self.f;
    let p = g.func;
    return Option<U>::Some(p(g.env, step.unwrap()));
  }
}

/// An iterator over the items of another that `keep` accepts. Built by `filter`.
impl<I : ExactSizeIterator, U> ExactSizeIterator for Map<I, Closure1<I::Item, U>> {
  /// As many as the inner iterator has.
  fn len(self : &Map<I, Closure1<I::Item, U>>) -> i64 {
    return self.inner.len();
  }
}

struct Filter<I, P> {
  inner : I,
  keep : P,
}

impl<I : Iterator> Iterator for Filter<I, Closure1<&I::Item, bool>> {
  type Item = I::Item;

  /// The inner iterator's next item that `keep` accepts.
  fn next(self : &mut Filter<I, Closure1<&I::Item, bool>>) -> Option<I::Item> {
    loop {
      let step = self.inner.next();
      if step.is_none() {
        return step;
      }
      let v = step.unwrap();
      let g = self.keep;
      let p = g.func;
      if p(g.env, &v) {
        return Option<I::Item>::Some(v);
      }
    }
    return Option<I::Item>::None();
  }
}

impl<I : DoubleEndedIterator> DoubleEndedIterator for Filter<I, Closure1<&I::Item, bool>> {
  /// The inner iterator's last item that `keep` accepts.
  fn next_back(self : &mut Filter<I, Closure1<&I::Item, bool>>) -> Option<I::Item> {
    loop {
      let step = self.inner.next_back();
      if step.is_none() {
        return step;
      }
      let v = step.unwrap();
      let g = self.keep;
      let p = g.func;
      if p(g.env, &v) {
        return Option<I::Item>::Some(v);
      }
    }
    return Option<I::Item>::None();
  }
}

/// An iterator over at most `left` items of another. Built by `take`.
struct Take<I> {
  inner : I,
  left : i64,
}

impl<I : Iterator> Iterator for Take<I> {
  type Item = I::Item;

  /// The inner iterator's next item, until `left` of them have been handed out.
  fn next(self : &mut Take<I>) -> Option<I::Item> {
    if self.left <= 0i64 {
      return Option<I::Item>::None();
    }
    self.left = self.left - 1i64;
    return self.inner.next();
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for Take<I> {
  /// The inner iterator's count, up to `left`.
  fn len(self : &Take<I>) -> i64 {
    let n = self.inner.len();
    if self.left <= 0i64 {
      return 0i64;
    }
    if n < self.left {
      return n;
    }
    return self.left;
  }
}

impl<I : DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Take<I> {
  /// The last of the items `next` would hand out, passing over the inner iterator's items
  /// beyond them.
  fn next_back(self : &mut Take<I>) -> Option<I::Item> {
    if self.left <= 0i64 {
      return Option<I::Item>::None();
    }
    let n = self.inner.len();
    let mut beyond = 0i64;
    if n > self.left {
      beyond = n - self.left;
    }
    self.left = self.left - 1i64;
    return self.inner.nth_back(beyond);
  }
}

/// An iterator over another's items with the first `drop` of them discarded. Built by `skip`.
struct Skip<I> {
  inner : I,
  drop : i64,
}

impl<I : Iterator> Iterator for Skip<I> {
  type Item = I::Item;

  /// The inner iterator's next item, once the skipped ones have been consumed.
  fn next(self : &mut Skip<I>) -> Option<I::Item> {
    loop {
      if self.drop <= 0i64 {
        return self.inner.next();
      }
      let step = self.inner.next();
      if step.is_none() {
        return step;
      }
      self.drop = self.drop - 1i64;
    }
    return Option<I::Item>::None();
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for Skip<I> {
  /// The inner iterator's count less the ones still to be skipped.
  fn len(self : &Skip<I>) -> i64 {
    let n = self.inner.len();
    if n <= self.drop {
      return 0i64;
    }
    return n - self.drop;
  }
}

impl<I : DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {
  /// The inner iterator's last item, while it is not one of the skipped ones.
  fn next_back(self : &mut Skip<I>) -> Option<I::Item> {
    if self.len() <= 0i64 {
      return Option<I::Item>::None();
    }
    return self.inner.next_back();
  }
}

/// An iterator over every `step`th item of another, starting with its first. Built by `step_by`.
struct StepBy<I> {
  inner : I,
  // How many items to pass over between two handed out: the step less one.
  gap : i64,
  first : bool,
}

impl<I : Iterator> Iterator for StepBy<I> {
  type Item = I::Item;

  /// The inner iterator's first item, and after that the one `step` places further on.
  fn next(self : &mut StepBy<I>) -> Option<I::Item> {
    if self.first {
      self.first = false;
      return self.inner.next();
    }
    return self.inner.nth(self.gap);
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for StepBy<I> {
  /// How many of the inner iterator's items land on a step.
  fn len(self : &StepBy<I>) -> i64 {
    let n = self.inner.len();
    if self.first {
      if n == 0i64 {
        return 0i64;
      }
      return 1i64 + (n - 1i64) / (self.gap + 1i64);
    }
    return n / (self.gap + 1i64);
  }
}

impl<I : DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for StepBy<I> {
  /// The last item that lands on a step, passing over the inner iterator's items after it.
  fn next_back(self : &mut StepBy<I>) -> Option<I::Item> {
    let over = self.inner.len() % (self.gap + 1i64);
    let mut beyond = over;
    if self.first {
      beyond = self.gap;
      if over > 0i64 {
        beyond = over - 1i64;
      }
    }
    return self.inner.nth_back(beyond);
  }
}

/// An iterator over the items of one iterator, then those of another. Built by `chain`.
struct Chain<A, B> {
  a : A,
  b : B,
  a_done : bool,
}

impl<A : Iterator, B : Iterator> Iterator for Chain<A, B> {
  type Item = A::Item;

  /// The first iterator's next item, or the second's once the first is finished.
  fn next(self : &mut Chain<A, B>) -> Option<A::Item> {
    if !self.a_done {
      let step = self.a.next();
      if step.is_some() {
        return step;
      }
      self.a_done = true;
    }
    return self.b.next();
  }
}

impl<A : DoubleEndedIterator, B : DoubleEndedIterator> DoubleEndedIterator for Chain<A, B> {
  /// The second iterator's last item, or the first's once the second is finished.
  fn next_back(self : &mut Chain<A, B>) -> Option<A::Item> {
    let step = self.b.next_back();
    if step.is_some() {
      return step;
    }
    return self.a.next_back();
  }
}

/// An iterator over another's items for as long as `keep` accepts them. Built by `take_while`.
struct TakeWhile<I, P> {
  inner : I,
  keep : P,
  done : bool,
}

impl<I : Iterator> Iterator for TakeWhile<I, Closure1<&I::Item, bool>> {
  type Item = I::Item;

  /// The inner iterator's next item, until the first `keep` refuses; nothing from then on.
  fn next(self : &mut TakeWhile<I, Closure1<&I::Item, bool>>) -> Option<I::Item> {
    if self.done {
      return Option<I::Item>::None();
    }
    let step = self.inner.next();
    if step.is_none() {
      return step;
    }
    let v = step.unwrap();
    let g = self.keep;
    let p = g.func;
    if p(g.env, &v) {
      return Option<I::Item>::Some(v);
    }
    self.done = true;
    return Option<I::Item>::None();
  }
}

/// An iterator over another's items from the first one `skip` refuses. Built by `skip_while`.
struct SkipWhile<I, P> {
  inner : I,
  skip : P,
  done : bool,
}

impl<I : Iterator> Iterator for SkipWhile<I, Closure1<&I::Item, bool>> {
  type Item = I::Item;

  /// The inner iterator's next item, once the leading ones `skip` accepts are consumed.
  fn next(self : &mut SkipWhile<I, Closure1<&I::Item, bool>>) -> Option<I::Item> {
    if self.done {
      return self.inner.next();
    }
    loop {
      let step = self.inner.next();
      if step.is_none() {
        return step;
      }
      let v = step.unwrap();
      let g = self.skip;
      let p = g.func;
      if !p(g.env, &v) {
        self.done = true;
        return Option<I::Item>::Some(v);
      }
    }
    return Option<I::Item>::None();
  }
}

/// An iterator over what `f` answers for another's items, until it answers nothing. Built by
/// `map_while`.
struct MapWhile<I, F> {
  inner : I,
  f : F,
}

impl<I : Iterator, U> Iterator for MapWhile<I, Closure1<I::Item, Option<U>>> {
  type Item = U;

  /// `f` of the inner iterator's next item, which is nothing once `f` says so.
  fn next(self : &mut MapWhile<I, Closure1<I::Item, Option<U>>>) -> Option<U> {
    let step = self.inner.next();
    if step.is_none() {
      return Option<U>::None();
    }
    let g = self.f;
    let p = g.func;
    return p(g.env, step.unwrap());
  }
}

/// An iterator that hands each of another's items to `f` on its way past. Built by `inspect`.
struct Inspect<I, F> {
  inner : I,
  f : F,
}

impl<I : Iterator> Iterator for Inspect<I, Closure1<&I::Item, i32>> {
  type Item = I::Item;

  /// The inner iterator's next item, after `f` has seen it.
  fn next(self : &mut Inspect<I, Closure1<&I::Item, i32>>) -> Option<I::Item> {
    let step = self.inner.next();
    if step.is_none() {
      return step;
    }
    let v = step.unwrap();
    let g = self.f;
    let p = g.func;
    p(g.env, &v);
    return Option<I::Item>::Some(v);
  }
}

impl<I : DoubleEndedIterator> DoubleEndedIterator for Inspect<I, Closure1<&I::Item, i32>> {
  /// The inner iterator's last item, after `f` has seen it.
  fn next_back(self : &mut Inspect<I, Closure1<&I::Item, i32>>) -> Option<I::Item> {
    let step = self.inner.next_back();
    if step.is_none() {
      return step;
    }
    let v = step.unwrap();
    let g = self.f;
    let p = g.func;
    p(g.env, &v);
    return Option<I::Item>::Some(v);
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for Inspect<I, Closure1<&I::Item, i32>> {
  /// As many as the inner iterator has.
  fn len(self : &Inspect<I, Closure1<&I::Item, i32>>) -> i64 {
    return self.inner.len();
  }
}

/// An iterator over what `f` answers for another's items while it carries a state between
/// them, ending where `f` first answers nothing. Built by `scan`.
struct Scan<I, St, F> {
  inner : I,
  state : St,
  f : F,
}

impl<I : Iterator, St, B> Iterator for Scan<I, St, Closure2<&mut St, I::Item, Option<B>>> {
  type Item = B;

  /// `f` of the state and the inner iterator's next item.
  fn next(self : &mut Scan<I, St, Closure2<&mut St, I::Item, Option<B>>>) -> Option<B> {
    let step = self.inner.next();
    if step.is_none() {
      return Option<B>::None();
    }
    let g = self.f;
    let p = g.func;
    // Through a local: handing `&mut self.state` straight to `p` leaves the checker reporting
    // `self` as still borrowed in other adaptors' methods.
    let mut state = self.state;
    let out = p(g.env, &mut state, step.unwrap());
    self.state = state;
    return out;
  }
}

/// An iterator that answers nothing forever once another has answered nothing once. Built by
/// `fuse`.
struct Fuse<I> {
  inner : I,
  done : bool,
}

impl<I : Iterator> Iterator for Fuse<I> {
  type Item = I::Item;

  /// The inner iterator's next item, or nothing for good once it has run out.
  fn next(self : &mut Fuse<I>) -> Option<I::Item> {
    if self.done {
      return Option<I::Item>::None();
    }
    let step = self.inner.next();
    if step.is_none() {
      self.done = true;
    }
    return step;
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for Fuse<I> {
  /// As many as the inner iterator has, and none once it has run out.
  fn len(self : &Fuse<I>) -> i64 {
    if self.done {
      return 0i64;
    }
    return self.inner.len();
  }
}

/// An iterator whose next item can be looked at without taking it. Built by `peekable`.
///
/// `T` is always `I::Item`: a struct field cannot name `I::Item`, so the item it holds on to
/// is typed by a parameter of its own, which `peekable` fills in.
struct Peekable<I, T> {
  inner : I,
  peeked : Option<T>,
  has_peeked : bool,
}

impl<I : Iterator> Iterator for Peekable<I, I::Item> {
  type Item = I::Item;

  /// The item `peek` looked at, if it looked, and otherwise the inner iterator's next.
  fn next(self : &mut Peekable<I, I::Item>) -> Option<I::Item> {
    if self.has_peeked {
      self.has_peeked = false;
      return self.peeked;
    }
    return self.inner.next();
  }
}

impl<I : Iterator> Peekable<I, I::Item> {
  /// The item `next` would answer, left where it is.
  ///
  /// Answers a copy where Rust answers a reference into the iterator.
  fn peek(self : &mut Peekable<I, I::Item>) -> Option<I::Item> {
    if !self.has_peeked {
      self.peeked = self.inner.next();
      self.has_peeked = true;
    }
    return self.peeked;
  }

  /// The next item if `accept` takes it, and otherwise nothing, with the item left in place.
  fn next_if(self : &mut Peekable<I, I::Item>, accept : Closure1<&I::Item, bool>)
  -> Option<I::Item> {
    let ahead = self.peek();
    if ahead.is_none() {
      return ahead;
    }
    let v = ahead.unwrap();
    let p = accept.func;
    if p(accept.env, &v) {
      self.has_peeked = false;
      return ahead;
    }
    return Option<I::Item>::None();
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for Peekable<I, I::Item> {
  /// As many as the inner iterator has, and the one `peek` holds.
  fn len(self : &Peekable<I, I::Item>) -> i64 {
    let n = self.inner.len();
    if self.has_peeked && self.peeked.is_some() {
      return n + 1i64;
    }
    return n;
  }
}

/// An iterator over the items of the iterators `f` answers for another's items, one after
/// another. Built by `flat_map`.
///
/// `U` is what `f` answers, held while its items are handed out, and a parameter of its own
/// for the reason `Peekable`'s `T` is.
struct FlatMap<I, F, U> {
  outer : I,
  f : F,
  front : Option<U>,
}

impl<I : Iterator, U : Iterator> Iterator for FlatMap<I, Closure1<I::Item, U>, U> {
  type Item = U::Item;

  /// The current inner iterator's next item, moving to the next one when it runs out.
  fn next(self : &mut FlatMap<I, Closure1<I::Item, U>, U>) -> Option<U::Item> {
    loop {
      if self.front.is_some() {
        let mut cur = self.front.unwrap();
        let step = cur.next();
        self.front = Option<U>::Some(cur);
        if step.is_some() {
          return step;
        }
      }
      let outer = self.outer.next();
      if outer.is_none() {
        return Option<U::Item>::None();
      }
      let g = self.f;
      let p = g.func;
      self.front = Option<U>::Some(p(g.env, outer.unwrap()));
    }
    return Option<U::Item>::None();
  }
}

/// An iterator over the items of each of another's items, which are iterators themselves.
/// Built by `flatten`.
struct Flatten<I, U> {
  outer : I,
  front : Option<U>,
}

impl<I : Iterator, U : Iterator> Iterator for Flatten<I, U> {
  type Item = U::Item;

  /// The current inner iterator's next item, moving to the next one when it runs out.
  fn next(self : &mut Flatten<I, U>) -> Option<U::Item> {
    loop {
      if self.front.is_some() {
        let mut cur = self.front.unwrap();
        let step = cur.next();
        self.front = Option<U>::Some(cur);
        if step.is_some() {
          return step;
        }
      }
      let outer = self.outer.next();
      if outer.is_none() {
        return Option<U::Item>::None();
      }
      self.front = outer;
    }
    return Option<U::Item>::None();
  }
}

/// An iterator over another's items from the back. Built by `rev`.
struct Rev<I> {
  inner : I,
}

impl<I : DoubleEndedIterator> Iterator for Rev<I> {
  type Item = I::Item;

  /// The inner iterator's last item.
  fn next(self : &mut Rev<I>) -> Option<I::Item> {
    return self.inner.next_back();
  }
}

impl<I : DoubleEndedIterator> DoubleEndedIterator for Rev<I> {
  /// The inner iterator's first item.
  fn next_back(self : &mut Rev<I>) -> Option<I::Item> {
    return self.inner.next();
  }
}

impl<I : DoubleEndedIterator + ExactSizeIterator> ExactSizeIterator for Rev<I> {
  /// As many as the inner iterator has.
  fn len(self : &Rev<I>) -> i64 {
    return self.inner.len();
  }
}

/// An iterator over pairs of two others' items, taken in step, ending when either does.
/// Built by `zip`.
struct Zip<A, B> {
  a : A,
  b : B,
}

impl<A : Iterator, B : Iterator> Iterator for Zip<A, B> {
  type Item = (A::Item, B::Item);

  /// The next item of each, paired, or nothing once either has run out.
  fn next(self : &mut Zip<A, B>) -> Option<(A::Item, B::Item)> {
    let x = self.a.next();
    if x.is_none() {
      return Option<(A::Item, B::Item)>::None();
    }
    let y = self.b.next();
    if y.is_none() {
      return Option<(A::Item, B::Item)>::None();
    }
    return Option<(A::Item, B::Item)>::Some((x.unwrap(), y.unwrap()));
  }
}

impl<A : ExactSizeIterator, B : ExactSizeIterator> ExactSizeIterator for Zip<A, B> {
  /// As many as the shorter of the two has.
  fn len(self : &Zip<A, B>) -> i64 {
    let n = self.a.len();
    let m = self.b.len();
    if n < m {
      return n;
    }
    return m;
  }
}

impl<A : DoubleEndedIterator + ExactSizeIterator, B : DoubleEndedIterator + ExactSizeIterator>
DoubleEndedIterator for Zip<A, B> {
  /// The last pair, once the longer iterator's extra items at the back have been dropped.
  fn next_back(self : &mut Zip<A, B>) -> Option<(A::Item, B::Item)> {
    let n = self.a.len();
    let m = self.b.len();
    if n > m {
      self.a.nth_back(n - m - 1i64);
    }
    if m > n {
      self.b.nth_back(m - n - 1i64);
    }
    let x = self.a.next_back();
    if x.is_none() {
      return Option<(A::Item, B::Item)>::None();
    }
    let y = self.b.next_back();
    return Option<(A::Item, B::Item)>::Some((x.unwrap(), y.unwrap()));
  }
}

/// An iterator over another's items, each paired with how far along it is, counting from zero.
/// Built by `enumerate`.
struct Enumerate<I> {
  inner : I,
  count : i64,
}

impl<I : Iterator> Iterator for Enumerate<I> {
  type Item = (i64, I::Item);

  /// The inner iterator's next item with its position.
  fn next(self : &mut Enumerate<I>) -> Option<(i64, I::Item)> {
    let step = self.inner.next();
    if step.is_none() {
      return Option<(i64, I::Item)>::None();
    }
    let at = self.count;
    self.count = self.count + 1i64;
    return Option<(i64, I::Item)>::Some((at, step.unwrap()));
  }
}

impl<I : ExactSizeIterator> ExactSizeIterator for Enumerate<I> {
  /// As many as the inner iterator has.
  fn len(self : &Enumerate<I>) -> i64 {
    return self.inner.len();
  }
}

impl<I : DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Enumerate<I> {
  /// The inner iterator's last item with its position, which is how many come before it.
  fn next_back(self : &mut Enumerate<I>) -> Option<(i64, I::Item)> {
    let step = self.inner.next_back();
    if step.is_none() {
      return Option<(i64, I::Item)>::None();
    }
    let at = self.count + self.inner.len();
    return Option<(i64, I::Item)>::Some((at, step.unwrap()));
  }
}

/// An iterator over another one's items, again and again. Built by `cycle`.
///
/// `orig` is kept untouched. Each pass runs over a clone of it held in `cur`, made when the
/// pass starts. The clone is taken here rather than in `cycle`, because a default method of
/// `Iterator` is checked for every iterator type, and most of them are not `Clone`; this impl
/// is only checked for the types that are actually cycled.
struct Cycle<I> {
  orig : I,
  cur : Option<I>,
}

impl<I : Iterator + Clone> Iterator for Cycle<I> {
  type Item = I::Item;

  /// The next item of the current pass, or the first of a new pass once it has run out.
  /// Nothing, forever, when the original iterator has no items at all.
  fn next(self : &mut Cycle<I>) -> Option<I::Item> {
    if self.cur.is_some() {
      let mut pass = self.cur.unwrap();
      let step = pass.next();
      if step.is_some() {
        self.cur = Option<I>::Some(pass);
        return step;
      }
    }
    let mut fresh = self.orig.clone();
    let first = fresh.next();
    self.cur = Option<I>::Some(fresh);
    return first;
  }
}
