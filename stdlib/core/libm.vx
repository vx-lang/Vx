  let d1 = libm_multiply_add(lo6, libm_f64_from_bits(4507095012802519656u64), libm_f64_from_bits(4543779896819884602u64)); // 0x1.c6b08d7076268p-23, 0x1.ebfbdff82a23ap-15
  let d2 = libm_multiply_add(lo6, libm_f64_from_bits(4428683787439195205u64), libm_f64_from_bits(4468611712252687499u64)); // 0x1.5d870c4d84445p-40, 0x1.3b2ad33f8b48bp-31
  let pp = libm_multiply_add(lo6_sqr, libm_multiply_add(lo6_sqr, d2, d1), d0);
