  } else {
    let x2 = libm_dd_exact_mult(x, x);
    let s = libm_dd_add_any(x2, LibmDoubleDouble {
      hi: -1.0, lo: 0.0
    });
    let w = libm_dd_add_any(LibmDoubleDouble {
      hi: x, lo: 0.0
    }, libm_dd_sqrt(s));
    l = libm_log_dd(w);
  }
  return l.hi + l.lo;
}

/// The inverse hyperbolic tangent of a double; infinite at 1 and NaN past it. Not a port: LLVM
/// libc has no double-precision `atanh`. Below 1/64 in size, its Taylor series up to `x^13` from
/// `libm_odd_series_small`; above, `log((1 + |x|) / (1 - |x|)) / 2` with the ratio and the log as
/// double-doubles. The result is almost always correctly rounded, but that is not proven.
fn libm_atanh(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let x_abs_u = x_u & 9223372036854775807u64; // 0x7fffffffffffffff
  // |x| < 2^-27: atanh(x) = x + x^3/3 rounds to x.
  if x_abs_u < 4485585228861014016u64 { // 0x3e40000000000000
    return x;
  }
  if x_abs_u >= 4607182418800017408u64 { // 0x3ff0000000000000
    if x_abs_u > 9218868437227405312u64 { // 0x7ff0000000000000
      // NaN, made quiet.
      return x + x;
    }
    if x_abs_u == 4607182418800017408u64 { // 0x3ff0000000000000
      return libm_f64_from_bits((x_u & 9223372036854775808u64) | 9218868437227405312u64); // 0x8000000000000000, 0x7ff0000000000000
    }
    return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
  }
  let a = libm_f64_from_bits(x_abs_u);
  let sign : f64 = if (x_u >> 63u64) == 1u64 {
    -1.0
  } else {
    1.0
  };
  if a < 0.015625 {
    // x + x^3/3 + x^5/5 + ... + x^13/13.
    return libm_odd_series_small(x, libm_f64_from_bits(4599676419421066581u64), libm_f64_from_bits(4356482039543059797u64), libm_multiply_add(x * x, libm_multiply_add(x * x, libm_multiply_add(x * x, libm_multiply_add(x * x, libm_f64_from_bits(4590207312512236308u64), libm_f64_from_bits(4591215111030249286u64)), libm_f64_from_bits(4592670820000712476u64)), libm_f64_from_bits(4594314991293244562u64)), 0.2)); // 0x1.5555555555555p-2, 0x1.5555555555555p-56, 0x1.3b13b13b13b14p-4, 0x1.745d1745d1746p-4, 0x1.c71c71c71c71cp-4, 0x1.2492492492492p-3
  }
  let num = libm_dd_two_sum(1.0, a);
  let den = libm_dd_two_sum(1.0, -a);
  let l = libm_log_dd(libm_dd_div(num, den));
  return sign * (0.5 * l.hi + 0.5 * l.lo);
}

/// The inverse hyperbolic functions of a bf16: the double result rounded once, to odd in f32 and
/// then to bf16, which gives the same bf16 as rounding the double directly.
fn libm_asinh_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_f32_round_odd(libm_asinh(libm_f32_from_bf16(x) as f64)));
}

fn libm_acosh_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_f32_round_odd(libm_acosh(libm_f32_from_bf16(x) as f64)));
}

fn libm_atanh_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_f32_round_odd(libm_atanh(libm_f32_from_bf16(x) as f64)));
}

