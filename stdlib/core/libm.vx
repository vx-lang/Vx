// Math functions written in Vx, ported from LLVM libc (llvm-project, libc/src/__support/math/,
// Apache-2.0 WITH LLVM-exception) at commit f475f085bf7b. `core::num`'s float methods call these
// instead of the platform libm (Vx#1038).
//
// Each function follows its C++ source step for step, so that it gives the same bits; the
// file it comes from is named above it. Three things differ:
// - Constants are written as their exact bit patterns, `libm_f64_from_bits(..)`, with LLVM's hex
//   float in a comment: Vx has no hex float literals yet (Vx#783).
// - Tables are `scf.index_switch`es in `mlir!`, which LLVM turns into constant tables: Vx
//   has no constant arrays yet (Vx#780).
// - Only the FMA branch of each `#ifdef LIBC_TARGET_CPU_HAS_FMA_DOUBLE` is kept, because
//   `mul_add` is always fused in Vx. Floating-point exceptions and `errno` are not set, and
//   only round-to-nearest is supported, so LLVM's `round_result_slightly_up/down` cases
//   return their constant directly.
//
// Every function's name starts with `libm_`: Vx has one namespace for all functions and no
// private ones yet, so a program's own `asinhf` must not collide with these.
//
// This module imports nothing, so that `core::num` can import it: the few operations it needs
// on floats are the helpers below, each one MLIR operation.

fn libm_f64_to_bits(x : f64) -> u64 {
  return mlir!( inputs : (%a = x : f64), returns : u64, dialects : ["arith"]) {
    %r = "arith.bitcast"(%a) : (f64) -> i64
    macro.yield %r : i64
  };
}

fn libm_f64_from_bits(v : u64) -> f64 {
  return mlir!( inputs : (%v = v : i64), returns : f64, dialects : ["arith"]) {
    %r = "arith.bitcast"(%v) : (i64) -> f64
    macro.yield %r : f64
  };
}

fn libm_f32_to_bits(x : f32) -> u32 {
  return mlir!( inputs : (%a = x : f32), returns : u32, dialects : ["arith"]) {
    %r = "arith.bitcast"(%a) : (f32) -> i32
    macro.yield %r : i32
  };
}

fn libm_f32_from_bits(v : u32) -> f32 {
  return mlir!( inputs : (%v = v : i32), returns : f32, dialects : ["arith"]) {
    %r = "arith.bitcast"(%v) : (i32) -> f32
    macro.yield %r : f32
  };
}

/// `x * y + z` with one rounding: `fputil::multiply_add` with FMA.
fn libm_multiply_add(x : f64, y : f64, z : f64) -> f64 {
  return mlir!( inputs : (%x = x : f64, %y = y : f64, %z = z : f64), returns : f64, dialects : ["math"]) {
    %r = math.fma %x, %y, %z : f64
    macro.yield %r : f64
  };
}

/// The correctly rounded square root: `fputil::sqrt<double>`.
fn libm_sqrt_f64(x : f64) -> f64 {
  return mlir!( inputs : (%x = x : f64), returns : f64, dialects : ["math"]) {
    %r = math.sqrt %x : f64
    macro.yield %r : f64
  };
}

/// `log(x)` for a positive, normal `x`, accurate enough for the single-precision functions:
/// `log_eval` from `acoshf_utils.h`, accurate version, with its tables `R_LOG` and `LOG_R`
/// from `acosh_float_constants.h`. With `x = 2^e * m`, it is `e * log(2) + log(1 / r) +
/// log(1 + dx)`, where `r` from the table makes `dx = r * m - 1` small enough for a degree-6
/// polynomial (Sollya: `fpminimax(log(1 + x)/x, 6, [|1, D...|], [-2^-7, 2^-6])`).
///
/// One `mlir!` block, so that LLVM can inline nothing away: written as calls to helpers, the
/// two table lookups were not inlined and cost a third of the time. The tables are
/// `scf.index_switch`es, which LLVM turns into loads from constant tables.
fn libm_log_eval(x : f64) -> f64 {
  return mlir!( inputs : (%x = x : f64), returns : f64, dialects : ["arith", "math", "scf"]) {
    %x_u = "arith.bitcast"(%x) : (f64) -> i64
    // index = (x_u >> 46) & 63: the top 6 bits of the mantissa
    %c46 = arith.constant 46 : i64
    %c63 = arith.constant 63 : i64
    %sh = arith.shrui %x_u, %c46 : i64
    %idx64 = arith.andi %sh, %c63 : i64
    %idx = arith.index_cast %idx64 : i64 to index
    // r = R_LOG[index], log_r = LOG_R[index]
    %r, %log_r = scf.index_switch %idx -> f64, f64
    case 0 {
      %ra0 = arith.constant 0x3FF0000000000000 : f64 // 0x1.0p+0
      %lb0 = arith.constant 0x0000000000000000 : f64 // 0x0.0000000000000p+0
      scf.yield %ra0, %lb0 : f64, f64
    }
    case 1 {
      %ra1 = arith.constant 0x3FEF800000000000 : f64 // 0x1.f8p-1
      %lb1 = arith.constant 0x3F90205658935847 : f64 // 0x1.0205658935847p-6
      scf.yield %ra1, %lb1 : f64, f64
    }
    case 2 {
      %ra2 = arith.constant 0x3FEF000000000000 : f64 // 0x1.fp-1
      %lb2 = arith.constant 0x3FA0415D89E74444 : f64 // 0x1.0415d89e74444p-5
      scf.yield %ra2, %lb2 : f64, f64
    }
    case 3 {
      %ra3 = arith.constant 0x3FEE800000000000 : f64 // 0x1.e8p-1
      %lb3 = arith.constant 0x3FA894AA149FB343 : f64 // 0x1.894aa149fb343p-5
      scf.yield %ra3, %lb3 : f64, f64
    }
    case 4 {
      %ra4 = arith.constant 0x3FEE000000000000 : f64 // 0x1.ep-1
      %lb4 = arith.constant 0x3FB08598B59E3A07 : f64 // 0x1.08598b59e3a07p-4
      scf.yield %ra4, %lb4 : f64, f64
    }
    case 5 {
      %ra5 = arith.constant 0x3FED800000000000 : f64 // 0x1.d8p-1
      %lb5 = arith.constant 0x3FB4D3115D207EAC : f64 // 0x1.4d3115d207eacp-4
      scf.yield %ra5, %lb5 : f64, f64
    }
    case 6 {
      %ra6 = arith.constant 0x3FED400000000000 : f64 // 0x1.d4p-1
      %lb6 = arith.constant 0x3FB700D30AEAC0E1 : f64 // 0x1.700d30aeac0e1p-4
      scf.yield %ra6, %lb6 : f64, f64
    }
    case 7 {
      %ra7 = arith.constant 0x3FECC00000000000 : f64 // 0x1.ccp-1
      %lb7 = arith.constant 0x3FBB6AC88DAD5B1C : f64 // 0x1.b6ac88dad5b1cp-4
      scf.yield %ra7, %lb7 : f64, f64
    }
    case 8 {
      %ra8 = arith.constant 0x3FEC400000000000 : f64 // 0x1.c4p-1
      %lb8 = arith.constant 0x3FBFE89139DBD566 : f64 // 0x1.fe89139dbd566p-4
      scf.yield %ra8, %lb8 : f64, f64
    }
    case 9 {
