    has: false, value: 0.0, x: x0, y: y0, e_x: ((((x_u0 >> 52u64) & 2047u64) as i32) - 1023) as f64, x_mant: x_u0 & 4503599627370495u64, is_neg: false, sign_d: 1.0 // 0x000fffffffffffff
  };
