/// `BIG_COEFFS` from `log1p.h`: a polynomial for `log(1 + v)` with 128-bit precision.
const LIBM_LOG1P_BIG_COEFFS : Tensor<u64, [16]> = [
0, 18446744073709551486, 14757395303985898391, 9139919541661348187,
1, 18446744073709551487, 9223372036855068848, 14283318103400833366,
