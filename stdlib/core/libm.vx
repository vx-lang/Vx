/// The accurate pass of `powf`, as a double-double: `powf_double_double` from `powf.h`, the
/// logarithm refined by a second table step and both polynomials in double-double.
fn libm_powf_double_double(idx_x : i64, dx : f64, y6 : f64, lo6_hi : f64, exp2_hi_mid : LibmDoubleDouble) -> LibmDoubleDouble {
  let idx2 = libm_round_even_f64(libm_multiply_add(dx, 16384.0, 64.0)) as i64;
  // Exact.
  let dx2 = libm_multiply_add(1.0 + dx, LIBM_COMMON_R2[idx2], -1.0);
  let dx_dd = LibmDoubleDouble {
    hi: dx2, lo: 0.0
  };
  // log2(1 + dx2) / dx2
  let mut p = LibmDoubleDouble {
    hi: libm_f64_from_bits(13821203156263148710u64), lo: libm_f64_from_bits(4351272168970118743u64)
  }; // -0x1.ec70af1929ca6p-3, 0x1.2d2fbd081e657p-57
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4598869476604809890u64), lo: libm_f64_from_bits(13572541067231605528u64)
  }); // 0x1.2776c516a92a2p-2, -0x1.b5a30b3bdb318p-58
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(13823540977621238523u64), lo: libm_f64_from_bits(4355323562998062053u64)
  }); // -0x1.71547652b82fbp-2, 0x1.137b47e635be5p-56
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4602334714382648317u64), lo: libm_f64_from_bits(4358605153478170727u64)
  }); // 0x1.ec709dc3a03fdp-2, 0x1.ce04b5140d867p-56
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(13828044577248609022u64), lo: libm_f64_from_bits(13575951341293865604u64)
  }); // -0x1.71547652b82fep-1, -0x1.777d101cf0a84p-57
  p = libm_dd_multiply_add(dx_dd, p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4609176140021203710u64), lo: libm_f64_from_bits(4357082904033633760u64)
  }); // 0x1.71547652b82fep0, 0x1.777d0ffda25ep-56
  let log2_x_lo = libm_dd_quick_mult_d(dx2, p);
  let log2_x_mid = LibmDoubleDouble {
    hi: LIBM_POWF_LOG2_R_TD[3 * idx_x + 1], lo: LIBM_POWF_LOG2_R_TD[3 * idx_x]
  };
  let log2_x_m = libm_dd_add(LibmDoubleDouble {
    hi: LIBM_POWF_LOG2_R2_DD[2 * idx2 + 1], lo: LIBM_POWF_LOG2_R2_DD[2 * idx2]
  }, log2_x_mid);
  let log2_x = if libm_larger_exponent(log2_x_m.hi, log2_x_lo.hi) {
    libm_dd_add(log2_x_m, log2_x_lo)
  } else {
    libm_dd_add(log2_x_lo, log2_x_m)
  };
  let lo6_hi_dd = LibmDoubleDouble {
    hi: lo6_hi, lo: 0.0
  };
  let prod = libm_dd_quick_mult_d(y6, log2_x);
  let lo6 = if libm_larger_exponent(prod.hi, lo6_hi) {
    libm_dd_add(prod, lo6_hi_dd)
  } else {
    libm_dd_add(lo6_hi_dd, prod)
  };
  // 2^(lo6 / 64)
  let mut pp = LibmDoubleDouble {
    hi: libm_f64_from_bits(4259088384742899425u64), lo: libm_f64_from_bits(13238410538663896109u64)
  }; // 0x1.b5251ff97bee1p-78, -0x1.8483eabd9642dp-132
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4302674886669337401u64), lo: libm_f64_from_bits(13281320184314770283u64)
  }); // 0x1.62c034beb8339p-68, -0x1.0ba57164eb36bp-122
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4345970066018852569u64), lo: libm_f64_from_bits(13322521076972774527u64)
  }); // 0x1.ffcbfc588ded9p-59, -0x1.31a55719de47fp-113
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4387685337091456952u64), lo: libm_f64_from_bits(13369397596894643686u64)
  }); // 0x1.430912f86bfb8p-49, -0x1.9a447bfddc5e6p-103
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4428683852445804337u64), lo: libm_f64_from_bits(4174420041262859232u64)
  }); // 0x1.5d87fe78a6731p-40, 0x1.e84e916be83ep-97
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4468611704665296503u64), lo: libm_f64_from_bits(4221274946447384910u64)
  }); // 0x1.3b2ab6fba4e77p-31, 0x1.4fb32d240a14ep-86
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4507095012802339008u64), lo: libm_f64_from_bits(13487492629240293007u64)
  }); // 0x1.c6b08d704a0cp-23, -0x1.d33162491268fp-77
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4543779896819893647u64), lo: libm_f64_from_bits(13521464395421040091u64)
  }); // 0x1.ebfbdff82c58fp-15, -0x1.5e43a5429bddbp-69
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: libm_f64_from_bits(4577396936549218799u64), lo: libm_f64_from_bits(4330981379454631972u64)
  }); // 0x1.62e42fefa39efp-7, 0x1.abc9e3b398024p-62
  pp = libm_dd_multiply_add(lo6, pp, LibmDoubleDouble {
    hi: 1.0, lo: 0.0
  });
  let rr = libm_dd_quick_mult(exp2_hi_mid, pp);
  return libm_dd_exact_add(rr.hi, rr.lo);
}

/// `x^y` as a double: `powf` from `powf.h`. `x^y = 2^(y log2 x)`: `log2 x` from the `LOG2_R`
/// tables and a polynomial, `2^(.)` from `EXP2_MID1` and a polynomial, both in double; a result
/// too near a rounding boundary is redone in double-double and moved off a halfway point by
/// `libm_dd_nudge` with `mask`. Special cases: `y` of 0, 1/2, 1, 2, small whole `y` computed
/// exactly, infinities, NaNs, zeros and negative `x`.
///
/// With `narrow` false the result rounds to the correct f32, as `powf` does. With `narrow` true,
/// for f16 and bf16 inputs, every result takes the double-double pass, and `exp2f` and `exp10f`,
/// which would round twice, are not used for `x` of 2 and 10.
fn libm_pow_value(x0 : f32, y0 : f32, mask : u64, narrow : bool) -> f64 {
  let mut x = x0;
  let mut y = y0;
  let mut x_u = libm_f32_to_bits(x);
