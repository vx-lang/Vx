0.33333333285220024, -0.11111107258758213, 0.061727081409273264, -0.04112747277999788, 0.02989734630976427, -0.02153799114741434, 0.01127419346708957,
0.3333333192549229, -0.11111045545593548, 0.06171526900235289, -0.041005246190812326, 0.029175410607531576, -0.019228232217575983, 0.00814588520838889,
0.33333322118400993, -0.11110739114119272, 0.06167512191527053, -0.04072285954651347, 0.028050481630665987, -0.016821481616236658, 0.005985321117601386,
0.3333328439114462, -0.11109844704483143, 0.061586441300283144, -0.04025211864010436, 0.02663941454402286, -0.014556751523170123, 0.004464847292284045,
0.333331824932397, -0.11107902069657861, 0.06143174976802822, -0.03959352639524023, 0.02505825712076138, -0.012527094689041198, 0.0033765491760100663,
0.3333296241102541, -0.11104396217161557, 0.06119865349685749, -0.03876553322357515, 0.02340097720733003, -0.0107548637980802, 0.0025855267287813633,
0.33332554295025096, -0.11098815281870428, 0.06088025654574078, -0.037795508771109425, 0.021736514609599786, -0.009229688988917809, 0.0020024731854467546,
0.33331876130007143, -0.11090693159095093, 0.06047454747254198, -0.036713619891480906, 0.020112095457727387, -0.0079276099775775, 0.0015671722277329377,
0.3333083807403939, -0.11079635564459517, 0.059983386823503855, -0.03554917093135616, 0.018558007380360092, -0.00682056509242118, 0.0012383367214761304,
0.33329346715947966, -0.11065332249560347, 0.05941144576706022, -0.034328675293879195, 0.017092069285967366, -0.005880916261710258, 0.0009872199863386318,
