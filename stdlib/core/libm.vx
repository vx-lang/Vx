/// `BIG_COEFFS` from `log.h`: a degree-4 polynomial for `log(1 + v)` with 128-bit precision.
const LIBM_LOG_BIG_COEFFS : Tensor<u64, [12]> = [
1, 18446744073709551487, 9223372036855211792, 13086432359233706012,
0, 18446744073709551487, 12297829382473034429, 15998412918662745006,
1, 18446744073709551488, 9223372036854775808, 0
];

/// The result of `libm_log_range_reduction`: the sum of the table values it added, and the
/// reduced argument.
struct LibmLogReduced {
  sum : LibmDyadic128,
  v : LibmDyadic128,
}

/// Steps 2 to 4 of the range reduction for the accurate pass of `log`: `log_range_reduction`
/// from `log_range_reduction.h`, on `m_x` with units of 2^-60. It adds `-log(r)` of each step
/// to `sum` from `step_2`, `step_3` and `step_4` and answers what is left.
fn libm_log_range_reduction(m_x : f64, sum0 : LibmDyadic128, step : i32) -> LibmLogReduced {
  let mut sum = sum0;
  // ulp = 2^-60
  let v = (m_x * libm_f64_from_bits(4877398396442247168u64)) as i64; // 0x1.0p60
  let idx2 = (v + 4538783999459328) >> 46; // 0x10'2000'0000'0000
  sum = libm_dyadic_add(sum, libm_log_step(step, 2, idx2));
  // |s| <= 2^-7, ulp = 2^-16
  let s2 = LIBM_COMMON_S2[idx2];
  // |s*v| < 2^-14, ulp = 2^(-60-16) = 2^-76
  let sv2 = s2 * v;
  // |s + v| < 2^-14, ulp = 2^-60
  let spv2 = (s2 << 44) + v;
  // |vv2| < 2^-14, ulp = 2^-76
  let vv2 = (spv2 << 16) + sv2;
  let idx3 = (vv2 + 2900318160026599424) >> 55; // 0x2840'0000'0000'0000
  sum = libm_dyadic_add(sum, libm_log_step(step, 3, idx3));
  // |s| < 2^-13, ulp = 2^-21
  let s3 = LIBM_COMMON_S3[idx3];
  // |s + v| < 2^-21, ulp = 2^-76
  let spv3 = (s3 << 55) + vv2;
  let sv3 = libm_i128_mul_i64(libm_i128_from_i64(vv2), s3);
  let vv3 = libm_i128_add(libm_i128_shl(libm_i128_from_i64(spv3), 21u64), sv3);
  let idx4 = ((libm_i128_bits_from_68(vv3) + 131) >> 1) as i64;
  sum = libm_dyadic_add(sum, libm_log_step(step, 4, idx4));
  // |s| < 2^-21, ulp = 2^-28
  let s4 = LIBM_COMMON_S4[idx4];
  let spv4 = libm_i128_add(libm_i128_shl(libm_i128_from_i64(s4), 69u64), vv3);
  let sv4 = libm_i128_mul_i64(vv3, s4);
  let vv4 = libm_i128_add(libm_i128_shl(spv4, 28u64), sv4);
  let negative = libm_i128_is_negative(vv4);
  let mag = if negative {
    libm_i128_negate(vv4)
  } else {
    vv4
  };
  let reduced = libm_dyadic_normalize(LibmDyadic128 {
    negative: negative, exponent: -125, hi: mag.hi, lo: mag.lo
  });
  return LibmLogReduced {
    sum: sum, v: reduced
  };
}

/// Entry `i` of step `k` (1 to 4) of a logarithm's range reduction table: `log`'s while `table`
/// is 0, `log2`'s while it is 1 and `log10`'s while it is 2.
fn libm_log_step(table : i32, k : i32, i : i64) -> LibmDyadic128 {
  let j = 4 * i;
  if table == 2 {
    if k == 1 {
      return libm_dyadic_from_parts(LIBM_LOG10_STEP_1[j], LIBM_LOG10_STEP_1[j + 1], LIBM_LOG10_STEP_1[j + 2], LIBM_LOG10_STEP_1[j + 3]);
    }
    if k == 2 {
      return libm_dyadic_from_parts(LIBM_LOG10_STEP_2[j], LIBM_LOG10_STEP_2[j + 1], LIBM_LOG10_STEP_2[j + 2], LIBM_LOG10_STEP_2[j + 3]);
    }
    if k == 3 {
      return libm_dyadic_from_parts(LIBM_LOG10_STEP_3[j], LIBM_LOG10_STEP_3[j + 1], LIBM_LOG10_STEP_3[j + 2], LIBM_LOG10_STEP_3[j + 3]);
    }
    return libm_dyadic_from_parts(LIBM_LOG10_STEP_4[j], LIBM_LOG10_STEP_4[j + 1], LIBM_LOG10_STEP_4[j + 2], LIBM_LOG10_STEP_4[j + 3]);
  }
  if table == 1 {
    if k == 1 {
      return libm_dyadic_from_parts(LIBM_LOG2_STEP_1[j], LIBM_LOG2_STEP_1[j + 1], LIBM_LOG2_STEP_1[j + 2], LIBM_LOG2_STEP_1[j + 3]);
    }
    if k == 2 {
      return libm_dyadic_from_parts(LIBM_LOG2_STEP_2[j], LIBM_LOG2_STEP_2[j + 1], LIBM_LOG2_STEP_2[j + 2], LIBM_LOG2_STEP_2[j + 3]);
    }
    if k == 3 {
      return libm_dyadic_from_parts(LIBM_LOG2_STEP_3[j], LIBM_LOG2_STEP_3[j + 1], LIBM_LOG2_STEP_3[j + 2], LIBM_LOG2_STEP_3[j + 3]);
    }
    return libm_dyadic_from_parts(LIBM_LOG2_STEP_4[j], LIBM_LOG2_STEP_4[j + 1], LIBM_LOG2_STEP_4[j + 2], LIBM_LOG2_STEP_4[j + 3]);
  }
  if k == 1 {
    return libm_dyadic_from_parts(LIBM_LOG_STEP_1[j], LIBM_LOG_STEP_1[j + 1], LIBM_LOG_STEP_1[j + 2], LIBM_LOG_STEP_1[j + 3]);
  }
  if k == 2 {
    return libm_dyadic_from_parts(LIBM_LOG_STEP_2[j], LIBM_LOG_STEP_2[j + 1], LIBM_LOG_STEP_2[j + 2], LIBM_LOG_STEP_2[j + 3]);
  }
  if k == 3 {
    return libm_dyadic_from_parts(LIBM_LOG_STEP_3[j], LIBM_LOG_STEP_3[j + 1], LIBM_LOG_STEP_3[j + 2], LIBM_LOG_STEP_3[j + 3]);
  }
  return libm_dyadic_from_parts(LIBM_LOG_STEP_4[j], LIBM_LOG_STEP_4[j + 1], LIBM_LOG_STEP_4[j + 2], LIBM_LOG_STEP_4[j + 3]);
}

/// The accurate pass of `log`: `log_accurate` from `log.h`, in 128-bit dyadic floats. `e_x` and
/// `index` are the fast pass's exponent and table index, `m_x` its reduced argument.
fn libm_log_accurate(e_x : i32, index : i64, m_x : f64) -> f64 {
  // log(2) with 128-bit precision.
  let log_2 = LibmDyadic128 {
    negative: false, exponent: -128, hi: 12786308645202655659u64, lo: 14547668686819489455u64
  }; // 0xb17217f7d1cf79ab, 0xc9e3b39803f2f6af
  let mut sum = libm_dyadic_mul(log_2, libm_dyadic_from_f64(e_x as f64));
  sum = libm_dyadic_add(sum, libm_log_step(0, 1, index));
  let rr = libm_log_range_reduction(m_x, sum, 0);
  sum = libm_dyadic_add(rr.sum, rr.v);
  let c0 = libm_dyadic_from_parts(LIBM_LOG_BIG_COEFFS[0], LIBM_LOG_BIG_COEFFS[1], LIBM_LOG_BIG_COEFFS[2], LIBM_LOG_BIG_COEFFS[3]);
  let c1 = libm_dyadic_from_parts(LIBM_LOG_BIG_COEFFS[4], LIBM_LOG_BIG_COEFFS[5], LIBM_LOG_BIG_COEFFS[6], LIBM_LOG_BIG_COEFFS[7]);
  let c2 = libm_dyadic_from_parts(LIBM_LOG_BIG_COEFFS[8], LIBM_LOG_BIG_COEFFS[9], LIBM_LOG_BIG_COEFFS[10], LIBM_LOG_BIG_COEFFS[11]);
  let mut p = libm_dyadic_mul(rr.v, c0);
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c1));
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c2));
  p = libm_dyadic_mul(rr.v, p);
  return libm_dyadic_to_f64(libm_dyadic_add(sum, p));
}

/// The natural logarithm of a double, correctly rounded: `log` from `log.h`. `x = 2^e * m`, and
/// `log(m) = -log(r) + log(1 + u)` with `r` from `RD` and `u = r * m - 1` exact; `log(1 + u)`
/// is a degree-7 polynomial. When the error bound does not decide the rounding, the accurate
/// pass redoes it in 128-bit dyadic floats.
fn libm_log(x : f64) -> f64 {
  let mut x_u = libm_f64_to_bits(x);
  let mut x_e : i32 = -1023;
  // log(1) = +0
  if x_u == 4607182418800017408u64 { // 0x3ff0000000000000
    return 0.0;
  }
  // Zero, negative, subnormal, infinity or NaN.
  if x_u < 4503599627370496u64 || x_u > 9218868437227405311u64 { // 0x0010000000000000, 0x7fefffffffffffff
    if x == 0.0 {
      return libm_f64_from_bits(18442240474082181120u64); // 0xfff0000000000000
    }
    if (x_u >> 63u64) == 1u64 && x == x {
      return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
    }
    if (x_u & 9218868437227405312u64) == 9218868437227405312u64 { // 0x7ff0000000000000, 0x7ff0000000000000
      return x;
    }
    // Normalize a subnormal.
    x_u = libm_f64_to_bits(x * libm_f64_from_bits(4841369599423283200u64)); // 0x1.0p52
    x_e = x_e - 52;
  }
  let index = ((x_u >> 45u64) & 127u64) as i64;
  let r = LIBM_COMMON_RD[index];
  // Add the unbiased exponent, plus 1 when the 8 leading fraction bits are all 1.
  x_e = x_e + ((x_u + 35184372088832u64) >> 52u64) as i32; // 1 << 45
  let e_x = x_e as f64;
  // hi is exact.
  let hi = libm_multiply_add(e_x, libm_f64_from_bits(4604418534313441280u64), LIBM_COMMON_LOG_R_DD[2 * index + 1]); // 0x1.62e42fefa38p-1
  let lo = libm_multiply_add(e_x, libm_f64_from_bits(4408728642709317424u64), LIBM_COMMON_LOG_R_DD[2 * index]); // 0x1.ef35793c7673p-45
  let m = libm_f64_from_bits((x_u & 4503599627370495u64) | 4607182418800017408u64); // 0x000fffffffffffff, 0x3ff0000000000000
  // Exact.
  let u = libm_multiply_add(r, m, -1.0);
  let r1 = libm_dd_exact_add(hi, u);
  let u_sq = u * u;
  let p0 = libm_multiply_add(u, libm_f64_from_bits(4599676419421063835u64), libm_f64_from_bits(13826050856027422719u64)); // 0x1.5555555554a9bp-2, -0x1.fffffffffffffp-2
  let p1 = libm_multiply_add(u, libm_f64_from_bits(4596373780821541436u64), libm_f64_from_bits(13821547256400659815u64)); // 0x1.99999dcc9823cp-3, -0x1.0000000094567p-2
  let p2 = libm_multiply_add(u, libm_f64_from_bits(4594263169067001047u64), libm_f64_from_bits(13818544836630696826u64)); // 0x1.21a02c4e624d7p-3, -0x1.55550ac2e537ap-3
  let p = libm_multiply_add(u_sq, libm_multiply_add(u_sq, libm_multiply_add(u_sq, p2, p1), p0), lo + r1.lo);
  // The error is at most about C * ulp(u^2) + 2^-85.
  let err = libm_multiply_add(u_sq, libm_f64_from_bits(4382002437431492608u64), libm_f64_from_bits(4224376450473525248u64)); // 0x1.0p-50, 0x1.0p-85
  let left = r1.hi + (p - err);
  let right = r1.hi + (p + err);
  if left == right {
    return left;
  }
  return libm_log_accurate(x_e, index, u);
}

