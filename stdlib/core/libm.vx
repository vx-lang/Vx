  let c1 = libm_multiply_add(dx, libm_f64_from_bits(4596593531131729630u64), libm_f64_from_bits(13821203151611432941u64)); // 0x1.a617677f716dep-3, -0x1.ec709dc4f0fedp-3
  let c2 = libm_multiply_add(dx, libm_f64_from_bits(4594883708376075523u64), libm_f64_from_bits(13819037355850650880u64)); // 0x1.44e6355fc4d03p-3, -0x1.715423d54d5p-3
  let dx4 = dx2 * dx2;
