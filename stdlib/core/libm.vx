  let c1_hi = libm_f64_from_bits(4609176140021203710u64); // 0x1.71547652b82fep0
  let c1_lo = libm_f64_from_bits(4357082904033627428u64); // 0x1.777d0ffda0d24p-56
  let c2_hi = libm_f64_from_bits(13828044577248609022u64); // -0x1.71547652b82fep-1
  let c2_lo = libm_f64_from_bits(13575951341261032740u64); // -0x1.777d0ffda0d24p-57
  let c3_hi = libm_f64_from_bits(4602334714382648290u64); // 0x1.ec709dc3a03e2p-2
  let c3_lo = libm_f64_from_bits(4385226891667514044u64); // 0x1.b749fc15522bcp-50
