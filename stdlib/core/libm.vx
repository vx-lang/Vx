  let p1 = libm_multiply_add(u, libm_f64_from_bits(4596373780821541436u64), libm_f64_from_bits(13821547256400659815u64)); // 0x1.99999dcc9823cp-3, -0x1.0000000094567p-2
  let p2 = libm_multiply_add(u, libm_f64_from_bits(4594263169067001047u64), libm_f64_from_bits(13818544836630696826u64)); // 0x1.21a02c4e624d7p-3, -0x1.55550ac2e537ap-3
  let p = libm_multiply_add(u_sq, libm_multiply_add(u_sq, libm_multiply_add(u_sq, p2, p1), p0), lo);
  let r1 = libm_dd_exact_add(hi, u);
  let r1p = LibmDoubleDouble {
    hi: r1.hi, lo: r1.lo + p
  };
  // log10(e)
  let r2 = libm_dd_quick_mult(r1p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4601495173785380110u64), lo: libm_f64_from_bits(4353102142499388115u64)
  }); // 0x1.bcb7b1526e50ep-2, 0x1.95355baaafad3p-57
  let err = libm_multiply_add(u_sq, libm_f64_from_bits(4377498837804122112u64), libm_f64_from_bits(4224376450473525248u64)); // 0x1.0p-51, 0x1.0p-85
  let left = r2.hi + (r2.lo - err);
  let right = r2.hi + (r2.lo + err);
  if left == right {
    return left;
  }
  return libm_log10_accurate(x_e, index, u);
}

