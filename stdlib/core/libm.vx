0.33321238861369823, -0.11001108417713691, 0.05728120253303031, -0.030541211931495733, 0.013284937772356398, -0.003829471687080277, 0.0005242892455637034,
0.33317044926474165, -0.10972357212874569, 0.0564596833754264, -0.02928888794612186, 0.01221075824789998, -0.0033379141814110316, 0.0004305332726031143,
0.3331198335582261, -0.10939968809503033, 0.05559590322798834, -0.028059931816311626, 0.011226944640882692, -0.002917760004129841, 0.000355748383247888
