/// Entry `i` of `LOG_R1`, `LOG_R2` or `LOG_R3` of `log1p`, for `k` of 1, 2 or 3.
fn libm_log1p_step(k : i32, i : i64) -> LibmDyadic128 {
  let j = 4 * i;
  if k == 1 {
    return libm_dyadic_from_parts(LIBM_LOG1P_LOG_R1[j], LIBM_LOG1P_LOG_R1[j + 1], LIBM_LOG1P_LOG_R1[j + 2], LIBM_LOG1P_LOG_R1[j + 3]);
  }
  if k == 2 {
    return libm_dyadic_from_parts(LIBM_LOG1P_LOG_R2[j], LIBM_LOG1P_LOG_R2[j + 1], LIBM_LOG1P_LOG_R2[j + 2], LIBM_LOG1P_LOG_R2[j + 3]);
  }
  return libm_dyadic_from_parts(LIBM_LOG1P_LOG_R3[j], LIBM_LOG1P_LOG_R3[j + 1], LIBM_LOG1P_LOG_R3[j + 2], LIBM_LOG1P_LOG_R3[j + 3]);
}

/// The accurate pass of `log1p`: `log1p_accurate` from `log1p.h`, in 128-bit dyadic floats.
/// `m_hi + m_lo` is the fast pass's reduced argument.
fn libm_log1p_accurate(e_x : i32, index : i64, m_hi : f64, m_lo : f64) -> f64 {
  // log(2) with 128-bit precision.
  let log_2 = LibmDyadic128 {
    negative: false, exponent: -128, hi: 12786308645202655659u64, lo: 14547668686819489455u64
  }; // 0xb17217f7d1cf79ab, 0xc9e3b39803f2f6af
  let mut sum = libm_dyadic_mul(log_2, libm_dyadic_from_f64(e_x as f64));
  sum = libm_dyadic_add(sum, libm_log1p_step(1, index));
  let mut v = libm_dyadic_add(libm_dyadic_from_f64(m_hi), libm_dyadic_from_f64(m_lo));
  if m_hi > libm_f64_from_bits(4539628424389459968u64) || m_hi < libm_f64_from_bits(13763000461244235776u64) { // 0x1p-15, -0x1p-15
    // 0x1p14 * (m_hi + (91 * 0x1p-14 + 0x1p-15))
    let idx2 = (libm_f64_from_bits(4670232813583204352u64) * (m_hi + libm_f64_from_bits(4573088762245939200u64))) as i64; // 0x1p14, 0x1.6ep-8
    sum = libm_dyadic_add(sum, libm_log1p_step(2, idx2));
    let s2 = libm_dyadic_from_f64(LIBM_LOG1P_S2[idx2]);
    v = libm_dyadic_add(libm_dyadic_add(v, s2), libm_dyadic_mul(v, s2));
  }
  if v.exponent > -150 {
    // 0x1p21 * (v + (69 * 0x1p-21 + 0x1p-22))
    let idx3 = (libm_f64_from_bits(4701758010974797824u64) * (libm_dyadic_to_f64(v) + libm_f64_from_bits(4540015452482437120u64))) as i64; // 0x1p21, 0x1.16p-15
    sum = libm_dyadic_add(sum, libm_log1p_step(3, idx3));
    let s3 = libm_dyadic_from_f64(LIBM_LOG1P_S3[idx3]);
    v = libm_dyadic_add(libm_dyadic_add(v, s3), libm_dyadic_mul(v, s3));
  }
  let c0 = libm_dyadic_from_parts(LIBM_LOG1P_BIG_COEFFS[0], LIBM_LOG1P_BIG_COEFFS[1], LIBM_LOG1P_BIG_COEFFS[2], LIBM_LOG1P_BIG_COEFFS[3]);
  let c1 = libm_dyadic_from_parts(LIBM_LOG1P_BIG_COEFFS[4], LIBM_LOG1P_BIG_COEFFS[5], LIBM_LOG1P_BIG_COEFFS[6], LIBM_LOG1P_BIG_COEFFS[7]);
  let c2 = libm_dyadic_from_parts(LIBM_LOG1P_BIG_COEFFS[8], LIBM_LOG1P_BIG_COEFFS[9], LIBM_LOG1P_BIG_COEFFS[10], LIBM_LOG1P_BIG_COEFFS[11]);
  let c3 = libm_dyadic_from_parts(LIBM_LOG1P_BIG_COEFFS[12], LIBM_LOG1P_BIG_COEFFS[13], LIBM_LOG1P_BIG_COEFFS[14], LIBM_LOG1P_BIG_COEFFS[15]);
  let mut p = libm_dyadic_mul(v, c0);
  p = libm_dyadic_mul(v, libm_dyadic_add(p, c1));
  p = libm_dyadic_mul(v, libm_dyadic_add(p, c2));
  p = libm_dyadic_mul(v, libm_dyadic_add(p, c3));
  p = libm_dyadic_add(v, libm_dyadic_mul(v, p));
  return libm_dyadic_to_f64(libm_dyadic_add(sum, p));
}

/// `log(1 + x)` of a double, correctly rounded and accurate for a small `x`: `log1p` from
/// `log1p.h`. `1 + x` is formed exactly as a double-double, reduced by `R1`, and the result is
/// `e * log(2) - log(r) + log(1 + v)` with a degree-5 polynomial for the last term.
fn libm_log1p(x : f64) -> f64 {
  return libm_log1p_value(x, false);
}

/// `libm_log1p`, which with `always_accurate` takes the accurate pass even when the fast one
/// decides the rounding, so that a test can reach it.
fn libm_log1p_value(x : f64, always_accurate : bool) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let x_exp = (x_u >> 52u64) & 2047u64;
  let mut x_dd = LibmDoubleDouble {
    hi: 0.0, lo: 0.0
  };
  if x_exp >= 1023u64 {
    // |x| >= 1
    if x_u >= 5066549580791808000u64 { // 0x4650000000000000
      // x >= 2^102 or x <= -1
      if x_u > 9218868437227405311u64 { // 0x7fefffffffffffff
        if x_u == 13830554455654793216u64 { // 0xbff0000000000000
          return libm_f64_from_bits(18442240474082181120u64); // 0xfff0000000000000
        }
        if (x_u >> 63u64) == 1u64 && x == x {
          return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
        }
        if x_u == 9218868437227405312u64 { // 0x7ff0000000000000
          return x;
        }
        return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
      }
      x_dd = LibmDoubleDouble {
        hi: x, lo: 0.0
      };
    } else {
      x_dd = libm_dd_exact_add(x, 1.0);
    }
  } else {
    // |x| < 2^-53: log(1 + x) rounds to x.
    if x_exp < 970u64 {
      if x + x == 0.0 {
        return x + x;
      }
      return x;
    }
    x_dd = libm_dd_exact_add(1.0, x);
  }
  let xhi_u = libm_f64_to_bits(x_dd.hi);
  let xhi_frac = xhi_u & 4503599627370495u64; // 0x000fffffffffffff
  let idx = ((xhi_frac + 17592186044416u64) >> 45u64) as i64; // 1 << 44
  let x_e = (((xhi_u >> 52u64) & 2047u64) as i32) - 1023 + ((idx >> 7) as i32);
  let e_x = x_e as f64;
  let hi = libm_multiply_add(e_x, libm_f64_from_bits(4604418534313441280u64), LIBM_LOG1P_LOG_R1_DD[2 * idx + 1]); // 0x1.62e42fefa38p-1
  let lo = libm_multiply_add(e_x, libm_f64_from_bits(4408728642709317424u64), LIBM_LOG1P_LOG_R1_DD[2 * idx]); // 0x1.ef35793c7673p-45
  let err_hi : f64 = if hi == 0.0 {
    0.0
  } else {
    libm_f64_from_bits(4224376450473525248u64) // 0x1.0p-85
  };
  // x_dd scaled to [1, 2): the exponent of hi, taken off lo as well.
  let s_u = ((xhi_u & 9218868437227405312u64) as i64) - 4607182418800017408; // 0x7ff0000000000000, 1023 << 52
  let m_hi = 4607182418800017408u64 | xhi_frac; // 0x3ff0000000000000
  let lo_abs = libm_f64_from_bits(libm_f64_to_bits(x_dd.lo) & 9223372036854775807u64); // 0x7fffffffffffffff
  let m_lo = if lo_abs > x_dd.hi * libm_f64_from_bits(4035225266123964416u64) { // 0x1.0p-127
    ((libm_f64_to_bits(x_dd.lo) as i64) - s_u) as u64
  } else {
    0u64
  };
  let m_dd_hi = libm_f64_from_bits(m_hi);
  let m_dd_lo = libm_f64_from_bits(m_lo);
  let r = LIBM_LOG1P_R1[idx];
  // Exact.
  let v_lo_hi = m_dd_lo * r;
  let v_lo_lo = libm_multiply_add(m_dd_lo, r, -v_lo_hi);
  let v_hi = libm_multiply_add(r, m_dd_hi, -1.0);
  let v_dd0 = libm_dd_exact_add(v_hi, v_lo_hi);
  let v_dd_hi = v_dd0.hi;
  let v_dd_lo = v_dd0.lo + v_lo_lo;
  let r1 = libm_dd_exact_add(hi, v_dd_hi);
  let v_sq = v_dd_hi * v_dd_hi;
  let p0 = libm_multiply_add(v_dd_hi, LIBM_LOG1P_P_COEFFS[1], LIBM_LOG1P_P_COEFFS[0]);
  let p1 = libm_multiply_add(v_dd_hi, LIBM_LOG1P_P_COEFFS[3], LIBM_LOG1P_P_COEFFS[2]);
  let p2 = libm_multiply_add(v_dd_hi, LIBM_LOG1P_P_COEFFS[5], LIBM_LOG1P_P_COEFFS[4]);
  let p = libm_multiply_add(v_sq, libm_multiply_add(v_sq, libm_multiply_add(v_sq, p2, p1), p0), (v_dd_lo + r1.lo) + lo);
  let err = libm_multiply_add(v_sq, libm_f64_from_bits(4386506037058863104u64), err_hi); // 0x1.0p-49
  let left = r1.hi + (p - err);
  let right = r1.hi + (p + err);
  if left == right && !always_accurate {
    return left;
  }
  return libm_log1p_accurate(x_e, idx, v_dd_hi, v_dd_lo);
}

