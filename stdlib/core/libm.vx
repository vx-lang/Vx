  let e0 = libm_multiply_add(lo6.hi, libm_f64_from_bits(4507095012802339008u64), libm_f64_from_bits(4543779896819893647u64)); // 0x1.c6b08d704a0cp-23, 0x1.ebfbdff82c58fp-15
  let e1 = libm_multiply_add(lo6.hi, libm_f64_from_bits(4428683852444758877u64), libm_f64_from_bits(4468611704664936591u64)); // 0x1.5d87fe77a735dp-40, 0x1.3b2ab6fb4d08fp-31
  let e2 = libm_multiply_add(lo6.hi, libm_f64_from_bits(4345971887050920643u64), libm_f64_from_bits(4387685642132324420u64)); // 0x1.ffe67c38112c3p-59, 0x1.430d835610044p-49
  let lo6_4 = lo6_sq * lo6_sq;
