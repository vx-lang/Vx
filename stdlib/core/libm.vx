  let lo6_hi = libm_multiply_add(y6, e_x + LIBM_POWF_LOG2_R_TD[3 * idx_x + 2], -hm);
  let lo6 = libm_multiply_add(y6, libm_multiply_add(dx, p, LIBM_POWF_LOG2_R_TD[3 * idx_x + 1]), lo6_hi);
  let mut hm_i = hm as i64;
