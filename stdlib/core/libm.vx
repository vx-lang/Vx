/// `e^a` as `2^hi * m`, with `m` a double-double between about 0.7 and 1.5, for `|a|` below about
/// 745: the reduction and double-double pass of `libm_exp`, without scaling by `2^hi`, so that a
/// value past the largest double can still be divided.
struct LibmExpParts {
  hi : i32,
  m : LibmDoubleDouble,
}

impl Copy for LibmExpParts {}

fn libm_exp_parts(a : f64) -> LibmExpParts {
  let tmp = libm_multiply_add(a, libm_f64_from_bits(4609176140021203710u64), libm_f64_from_bits(4704009810788745216u64)); // 0x1.71547652b82fep+0, 0x1.800000004p21
  let k = ((libm_f64_to_bits(tmp) >> 19u64) as u32) as i32;
  let kd = k as f64;
  let exp_mid = libm_exp_mid_dd(((k >> 6) & 63) as i64, (k & 63) as i64);
  return LibmExpParts {
    hi: k >> 12, m: libm_exp_dd(a, kd, exp_mid)
