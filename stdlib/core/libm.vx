/// The natural logarithm, correctly rounded: `logf` from `logf.h`. With `x = 2^m * 1.mant` and
/// `f` the top 8 bits of `1.mant`, it is `m * log(2) + log(f) + log(1 + d / f)`, the last a
/// degree-5 polynomial (Sollya: `fpminimax(log(1 + x)/x, 4, [|1, D...|], [-2^-8, 2^-7])`).
fn libm_logf(x : f32) -> f32 {
  let mut x_u = libm_f32_to_bits(x);
  let mut m : i32 = -127;
  // x < 0x1.bacb4ap+25
  if x_u < 1281189285u32 { // 0x4c5d65a5
    // Inputs where the evaluation below would round the wrong way.
    if x_u == 1065307503u32 { // 0x3f7f4d6f
      return libm_f32_from_bits(3140669284u32); // -0x1.659ec8p-9f
    }
    if x_u == 1092063211u32 { // 0x41178feb
      return libm_f32_from_bits(1074783719u32); // 0x1.1fcbcep+1f
    }
    if x_u == 1065353216u32 { // 0x3f800000
      return 0.0;
    }
    // Zero and subnormal inputs.
    if x_u < 8388608u32 { // 0x00800000
      if x == 0.0 {
        return libm_f32_from_bits(4286578688u32); // 0xff800000
      }
      x_u = libm_f32_to_bits(x * libm_f32_from_bits(1258291200u32)); // 0x1.0p23f
      m = m - 23;
    }
  } else {
    if x_u == 1281189285u32 { // 0x4c5d65a5
      return libm_f32_from_bits(1099891531u32); // 0x1.1e0696p+4f
    }
    if x_u == 1708691667u32 { // 0x65d890d3
      return libm_f32_from_bits(1112855033u32); // 0x1.a9a3f2p+5f
    }
    if x_u == 1865525484u32 { // 0x6f31a8ec
      return libm_f32_from_bits(1115970185u32); // 0x1.08b512p+6f
    }
    if x_u == 2048389898u32 { // 0x7a17f30a
      return libm_f32_from_bits(1117948443u32); // 0x1.451436p+6f
    }
    // Negative numbers, infinity and NaN.
    if x_u > 2139095039u32 { // 0x7f7fffff
      if x_u == 2147483648u32 { // 0x80000000
        return libm_f32_from_bits(4286578688u32); // 0xff800000
      }
      let is_nan = (x_u & 2147483647u32) > 2139095040u32; // 0x7fffffff, 0x7f800000
      if (x_u >> 31u32) == 1u32 && !is_nan {
        return libm_f32_from_bits(2143289344u32); // 0x7fc00000
      }
      if libm_f32_is_signaling_nan(x_u) {
        return libm_f32_from_bits(2143289344u32); // 0x7fc00000
      }
      return x;
    }
  }
  let index = ((x_u & 8388607u32) >> 16u32) as i64; // 0x007fffff
  // The exponent, plus one when the 7 leading bits of the mantissa are all ones.
  m = m + ((x_u + 65536u32) >> 23u32) as i32;
  let u = libm_f32_from_bits((x_u & 8388607u32) | 1065353216u32); // 0x007fffff, 0x3f800000
  // Exact.
  let v = libm_multiply_add_f32(u, LIBM_COMMON_R[index], -1.0) as f64;
  let v2 = v * v;
  let p2 = libm_multiply_add(v, libm_f64_from_bits(4596317492040542199u64), libm_f64_from_bits(13821547267371170182u64)); // 0x1.966681bfda7f7p-3, -0x1.000028dedf986p-2
  let p1 = libm_multiply_add(v, libm_f64_from_bits(4599676419844750358u64), libm_f64_from_bits(13826050856027487843u64)); // 0x1.555556e963c16p-2, -0x1.000000000fe63p-1
  let p0 = LIBM_COMMON_LOG_R[index] + v;
  let p = libm_multiply_add(v2, libm_multiply_add(v2, p2, p1), p0);
  return libm_multiply_add(m as f64, libm_f64_from_bits(4604418534313441775u64), p) as f32; // 0x1.62e42fefa39efp-1
}

/// The logarithm to base two, correctly rounded: `log2f` from `log2f.h`, the same reduction as
/// `libm_logf` with a degree-5 polynomial for `log2(1 + x)` (Sollya:
/// `fpminimax(log2(1 + x)/x, 4, [|1, D...|], [-2^-8, 2^-7])`).
fn libm_log2f(x : f32) -> f32 {
  let mut x_u = libm_f32_to_bits(x);
  let mut m : i32 = -127;
  if x_u == 1065353216u32 { // 0x3f800000
    return 0.0;
  }
  // Zero, subnormal, negative, infinity and NaN.
  if x_u < 8388608u32 || x_u > 2139095039u32 { // 0x00800000, 0x7f7fffff
    if x == 0.0 {
      return libm_f32_from_bits(4286578688u32); // 0xff800000
    }
    let is_nan = (x_u & 2147483647u32) > 2139095040u32; // 0x7fffffff, 0x7f800000
    if (x_u >> 31u32) == 1u32 && !is_nan {
      return libm_f32_from_bits(2143289344u32); // 0x7fc00000
    }
    if (x_u & 2139095040u32) == 2139095040u32 { // 0x7f800000, 0x7f800000
      return x;
    }
    x_u = libm_f32_to_bits(x * libm_f32_from_bits(1258291200u32)); // 0x1.0p23f
    m = m - 23;
  }
  m = m + ((x_u >> 23u32) & 255u32) as i32;
  let index = ((x_u & 8388607u32) >> 16u32) as i64; // 0x007fffff
  let u = libm_f32_from_bits((x_u & 8388607u32) | 1065353216u32); // 0x007fffff, 0x3f800000
  // Exact.
  let v = libm_multiply_add_f32(u, LIBM_COMMON_R[index], -1.0) as f64;
  let extra_factor = (m as f64) + LIBM_COMMON_LOG2_R[index];
  let vsq = v * v;
  let c0 = libm_multiply_add(v, libm_f64_from_bits(4609176140021203251u64), extra_factor); // 0x1.71547652b8133p0
  let c1 = libm_multiply_add(v, libm_f64_from_bits(4602334715142501342u64), libm_f64_from_bits(13828044577248714291u64)); // 0x1.ec70a098473dep-2, -0x1.71547652d1e33p-1
  let c2 = libm_multiply_add(v, libm_f64_from_bits(4598827572884280074u64), libm_f64_from_bits(13823540998955725089u64)); // 0x1.2514fd90a130ap-2, -0x1.7154c5ccdf121p-2
  return libm_multiply_add(vsq, libm_multiply_add(vsq, c2, c1), c0) as f32;
}

/// The logarithm to base ten, correctly rounded: `log10f` from `log10f.h`. Powers of ten up
/// to `10^10` are exact.
fn libm_log10f(x : f32) -> f32 {
  let mut x_u = libm_f32_to_bits(x);
  if (x_u & 1023u32) == 0u32 {
    if x_u == 1065353216u32 { // 0x3f800000
      return 0.0;
    }
    if x_u == 1092616192u32 { // 0x41200000
      return 1.0;
    }
    if x_u == 1120403456u32 { // 0x42c80000
      return 2.0;
    }
    if x_u == 1148846080u32 { // 0x447a0000
      return 3.0;
    }
    if x_u == 1176256512u32 { // 0x461c4000
      return 4.0;
    }
    if x_u == 1203982336u32 { // 0x47c35000
      return 5.0;
    }
    if x_u == 1232348160u32 { // 0x49742400
      return 6.0;
    }
  } else {
    if x_u == 1259902592u32 { // 0x4b189680
      return 7.0;
    }
    if x_u == 1287568416u32 { // 0x4cbebc20
      return 8.0;
    }
    if x_u == 1315859240u32 { // 0x4e6e6b28
      return 9.0;
    }
    if x_u == 1343554297u32 { // 0x501502f9
      return 10.0;
    }
    // Inputs where the evaluation below would round the wrong way.
    if x_u == 251588218u32 { // 0x0efeee7a
      return libm_f32_from_bits(3253312803u32); // -0x1.d33a46p+4f
    }
    if x_u == 1063247387u32 { // 0x3f5fde1b
      return libm_f32_from_bits(3178141239u32); // -0x1.dd2c6ep-5f
    }
    if x_u == 1065382104u32 { // 0x3f8070d8
      return libm_f32_from_bits(985903458u32); // 0x1.8762c4p-10f
    }
  }
  let mut m : i32 = -127;
  // Zero, subnormal, negative, infinity and NaN.
  if x_u < 8388608u32 || x_u > 2139095039u32 { // 0x00800000, 0x7f7fffff
    if x == 0.0 {
      return libm_f32_from_bits(4286578688u32); // 0xff800000
    }
    let is_nan = (x_u & 2147483647u32) > 2139095040u32; // 0x7fffffff, 0x7f800000
    if (x_u >> 31u32) == 1u32 && !is_nan {
      return libm_f32_from_bits(2143289344u32); // 0x7fc00000
    }
    if (x_u & 2139095040u32) == 2139095040u32 { // 0x7f800000, 0x7f800000
      return x;
    }
    x_u = libm_f32_to_bits(x * libm_f32_from_bits(1258291200u32)); // 0x1.0p23f
    m = m - 23;
  }
  m = m + (x_u >> 23u32) as i32;
  let index = ((x_u >> 16u32) & 127u32) as i64;
  let u = libm_f32_from_bits((x_u & 8388607u32) | 1065353216u32); // 0x007fffff, 0x3f800000
  // Exact.
  let v = libm_multiply_add_f32(u, LIBM_COMMON_R[index], -1.0) as f64;
  // Sollya: fpminimax(log10(1 + x)/x, 4, [|D...|], [-2^-8, 2^-7])
  let v2 = v * v;
  let p2 = libm_multiply_add(v, libm_f64_from_bits(4590872805527286057u64), libm_f64_from_bits(13815860037079368117u64)); // 0x1.60e7e3e747129p-4, -0x1.bcb8110a181b5p-4
  let p1 = libm_multiply_add(v, libm_f64_from_bits(4594383723326392845u64), libm_f64_from_bits(13820363611012912189u64)); // 0x1.287a77eb4ca0dp-3, -0x1.bcb7b1528d43dp-3
  let p0 = libm_multiply_add(v, libm_f64_from_bits(4601495173785379557u64), LIBM_LOG10F_LOG10_R[index]); // 0x1.bcb7b1526e2e5p-2
  let p = libm_multiply_add(v2, libm_multiply_add(v2, p2, p1), p0);
  return libm_multiply_add(m as f64, libm_f64_from_bits(4599094494223104511u64), p) as f32; // 0x1.34413509f79ffp-2
}

/// `log(1 + x)`, correctly rounded: `log1pf` from `log1pf.h`. For `|x| <= 2^-6` a degree-8
/// polynomial (Sollya: `fpminimax(log(1 + x)/x, 7, [|D...|], [-2^-6; 2^-6])`); otherwise
/// `1 + x` is exact in double precision and `libm_log_eval` takes its logarithm.
fn libm_log1pf(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_a = x_u & 2147483647u32; // 0x7fffffff
  let xd = x as f64;
  if x_a <= 1015021568u32 { // 0x3c800000
    // Inputs where the evaluation below would round the wrong way.
    if x_u == 893386755u32 { // 0x35400003
      return libm_f32_from_bits(893386751u32); // 0x1.7ffffep-21f
    }
    if x_u == 923795483u32 { // 0x3710001b
      return libm_f32_from_bits(923795443u32); // 0x1.1fffe6p-17f
    }
    if x_u == 3040870397u32 { // 0xb53ffffd
      return libm_f32_from_bits(3040870401u32); // -0x1.800002p-21f
    }
    if x_u == 3071279077u32 { // 0xb70fffe5
      return libm_f32_from_bits(3071279117u32); // -0x1.20001ap-17f
    }
    if x_u == 3138308292u32 { // 0xbb0ec8c4
      return libm_f32_from_bits(3138318501u32); // -0x1.1de14ap-9f
    }
    let xsq = xd * xd;
    let c0 = libm_multiply_add(xd, libm_f64_from_bits(4599676419421072045u64), libm_f64_from_bits(13826050856027422720u64)); // 0x1.5555555556aadp-2, -0x1.0000000000000p-1
    let c1 = libm_multiply_add(xd, libm_f64_from_bits(4596373779425792590u64), libm_f64_from_bits(13821547256400058394u64)); // 0x1.999998998124ep-3, -0x1.000000000181ap-2
    let c2 = libm_multiply_add(xd, libm_f64_from_bits(4594316876692998823u64), libm_f64_from_bits(13818544856377469483u64)); // 0x1.24adb8cde4aa7p-3, -0x1.55555452e2a2bp-3
    let x4 = xsq * xsq;
    let d0 = libm_multiply_add(xsq, c1, c0);
    let d1 = libm_multiply_add(xsq, libm_f64_from_bits(13817045433699397487u64), c2); // -0x1.0019db915ef6fp-3
    let d2 = libm_multiply_add(x4, d1, d0);
    return libm_multiply_add(xsq, d2, xd) as f32;
  }
  if x_a >= 1065353216u32 { // 0x3f800000
    // Infinity, NaN, or x <= -1.
    if x_u >= 2139095040u32 { // 0x7f800000
      if x == -1.0 {
        return libm_f32_from_bits(4286578688u32); // 0xff800000
      }
      if libm_f32_is_signaling_nan(x_u) || x < 1.0 {
        return libm_f32_from_bits(2143289344u32); // 0x7fc00000
      }
      return x;
    }
    if x >= libm_f32_from_bits(1427660674u32) { // 0x1.30bf04p+43f
      if x_u == 1427660674u32 { // 0x55185f82
        return libm_f32_from_bits(1106237000u32); // 0x1.dfac9p+4f
      }
      if x_u == 1557569160u32 { // 0x5cd69e88
        return libm_f32_from_bits(1109581987u32); // 0x1.45c146p+5f
      }
      if x_u == 1592301646u32 { // 0x5ee8984e
        return libm_f32_from_bits(1110329889u32); // 0x1.5c9442p+5f
      }
      if x_u == 1708691667u32 { // 0x65d890d3
        return libm_f32_from_bits(1112855033u32); // 0x1.a9a3f2p+5f
      }
      if x_u == 1865525484u32 { // 0x6f31a8ec
        return libm_f32_from_bits(1115970185u32); // 0x1.08b512p+6f
      }
      if x_u == 2048389898u32 { // 0x7a17f30a
        return libm_f32_from_bits(1117948443u32); // 0x1.451436p+6f
      }
    }
  } else {
    if x_u == 1056801197u32 { // 0x3efd81ad
      return libm_f32_from_bits(1053683425u32); // 0x1.9bddc2p-2f
    }
  }
  return libm_log_eval(xd + 1.0) as f32;
}

/// The bits of an f16.
fn libm_f16_to_bits(x : f16) -> u16 {
  return mlir!( inputs : (%a = x : f16), returns : u16, dialects : ["arith"]) {
    %r = arith.bitcast %a : f16 to i16
    macro.yield %r : i16
  };
}

/// The f16 with these bits.
fn libm_f16_from_bits(v : u16) -> f16 {
  return mlir!( inputs : (%v = v : i16), returns : f16, dialects : ["arith"]) {
    %r = arith.bitcast %v : i16 to f16
    macro.yield %r : f16
  };
}

/// What `ln`, `log2` and `log10` of an f16 answer for zero, one, a negative number, infinity
/// and NaN, as bits; `65536`, which no f16 has, for any other input. The shared start of
/// `logf16`, `log2f16` and `log10f16`.
fn libm_f16_log_special(x_u : u16) -> u32 {
  if x_u != 0u16 && x_u != 15360u16 && x_u < 31744u16 {
    return 65536u32;
  }
  // NaN: a signaling one becomes quiet.
  if (x_u & 32767u16) > 31744u16 {
    if (x_u & 512u16) == 0u16 {
      return 32256u32;
    }
    return x_u as u32;
  }
  // Zero: minus infinity.
  if (x_u & 32767u16) == 0u16 {
    return 64512u32;
  }
  // One: zero.
  if x_u == 15360u16 {
    return 0u32;
  }
  // Negative: NaN.
  if x_u > 32768u16 {
    return 32256u32;
  }
  // Infinity.
  return 31744u32;
}

/// `ONE_OVER_F_F` from `expxf16_utils.h`: `1 / f` in single precision, for the 32 values
/// `f = 1 + i / 32` that the top 5 bits of an f16 mantissa pick.
const LIBM_F16_ONE_OVER_F : Tensor<f32, [32]> = [
1.0, 0.969697, 0.9411765, 0.9142857, 0.8888889, 0.8648649, 0.84210527, 0.82051283,
0.8, 0.7804878, 0.7619048, 0.74418604, 0.72727275, 0.7111111, 0.6956522, 0.68085104,
0.6666667, 0.6530612, 0.64, 0.627451, 0.61538464, 0.6037736, 0.5925926, 0.58181816,
0.5714286, 0.5614035, 0.55172414, 0.5423729, 0.53333336, 0.52459013, 0.516129, 0.50793654
];

/// `LOGF_F` from `expxf16_utils.h`: `log(f)` for each `f` of `LIBM_F16_ONE_OVER_F`.
const LIBM_F16_LOG_F : Tensor<f32, [32]> = [
0.0, 0.030771658, 0.06062462, 0.089612156, 0.11778303, 0.14518201, 0.17185026, 0.19782574,
0.22314355, 0.24783616, 0.2719337, 0.29546422, 0.31845373, 0.3409266, 0.3629055, 0.3844117,
0.4054651, 0.4260844, 0.4462871, 0.46608973, 0.48550782, 0.504556, 0.52324814, 0.5415973,
0.5596158, 0.5773154, 0.59470713, 0.61180156, 0.62860864, 0.64513797, 0.6613985, 0.6773988
];

/// `LOG2F_F` from `expxf16_utils.h`: `log2(f)`.
const LIBM_F16_LOG2_F : Tensor<f32, [32]> = [
0.0, 0.04439412, 0.08746284, 0.12928301, 0.169925, 0.20945336, 0.24792752, 0.2854022,
0.32192808, 0.357552, 0.3923174, 0.42626476, 0.45943162, 0.4918531, 0.52356195, 0.55458885,
0.5849625, 0.61470985, 0.64385617, 0.6724253, 0.7004397, 0.7279205, 0.7548875, 0.78135973,
0.8073549, 0.83289003, 0.85798097, 0.88264304, 0.9068906, 0.9307373, 0.95419633, 0.9772799
];

/// `LOG10F_F` from `expxf16_utils.h`: `log10(f)`.
const LIBM_F16_LOG10_F : Tensor<f32, [32]> = [
0.0, 0.013363961, 0.026328938, 0.038918067, 0.051152524, 0.063051745, 0.07463362, 0.08591463,
0.096910015, 0.10763388, 0.11809931, 0.12831847, 0.1383027, 0.14806254, 0.15760785, 0.16694789,
0.17609125, 0.1850461, 0.19382003, 0.2024202, 0.21085337, 0.2191259, 0.22724378, 0.23521271,
0.24303804, 0.25072488, 0.258278, 0.26570204, 0.27300128, 0.28017986, 0.2872417, 0.2941906
];

/// The natural logarithm of an f16, correctly rounded: `logf16` from `logf16.h`. With
/// `x = 2^m * 1.mant` and `f` the top 6 bits of `1.mant`, it is `m * log(2) + log(f) +
/// log(1 + d / f)`, the last a degree-3 polynomial in single precision (Sollya:
/// `fpminimax(log(1 + x)/x, 2, [|SG...|], [-2^-5, 2^-5])`).
fn libm_logf16(x : f16) -> f16 {
  let mut x_u = libm_f16_to_bits(x);
  let special = libm_f16_log_special(x_u);
  if special != 65536u32 {
    return libm_f16_from_bits(special as u16);
  }
  // Inputs where the evaluation below would round the wrong way.
  if x_u == 6453u16 { // 0x1935
    return libm_f16_from_bits(50681u16); // 0xc5f9
  }
  if x_u == 7544u16 { // 0x1d78
    return libm_f16_from_bits(50491u16); // 0xc53b
  }
  if x_u == 15356u16 { // 0x3bfc
    return libm_f16_from_bits(38913u16); // 0x9801
  }
  if x_u == 15358u16 { // 0x3bfe
    return libm_f16_from_bits(37889u16); // 0x9401
  }
  if x_u == 16689u16 { // 0x4131
    return libm_f16_from_bits(15266u16); // 0x3ba2
  }
  let mut m : i32 = -15;
  // Subnormal: scale by 2^10 into the normal range.
  if (x_u & 31744u16) == 0u16 {
    x_u = libm_f16_to_bits(x * libm_f16_from_bits(25600u16));
    m = m - 10;
  }
  let f = ((x_u & 1023u16) >> 5u16) as i64;
  m = m + (x_u >> 10u16) as i32;
  let mant_f = libm_f16_from_bits((x_u & 1023u16) | 15360u16) as f32;
  let v = libm_multiply_add_f32(mant_f, LIBM_F16_ONE_OVER_F[f], -1.0);
  let p = libm_multiply_add_f32(v, libm_multiply_add_f32(v, libm_f32_from_bits(1051377531u32), libm_f32_from_bits(3204451330u32)), 1.0); // 0x1.557ef6p-2f, -0x1.001804p-1f
  let log_1_mant = LIBM_F16_LOG_F[f] + v * p;
  return libm_multiply_add_f32(m as f32, libm_f32_from_bits(1060205080u32), log_1_mant) as f16; // 0x1.62e43p-1f
}

/// The logarithm to base two of an f16, correctly rounded: `log2f16` from `log2f16.h`, the
/// same reduction as `libm_logf16` (Sollya: `fpminimax(log2(1 + x)/x, 2, [|SG...|], [-2^-5, 2^-5])`).
fn libm_log2f16(x : f16) -> f16 {
  let mut x_u = libm_f16_to_bits(x);
  let special = libm_f16_log_special(x_u);
  if special != 65536u32 {
    return libm_f16_from_bits(special as u16);
  }
  // Inputs where the evaluation below would round the wrong way.
  if x_u == 15267u16 { // 0x3ba3
    return libm_f16_from_bits(44106u16); // 0xac4a
  }
  if x_u == 15341u16 { // 0x3bed
    return libm_f16_from_bits(41699u16); // 0xa2e3
  }
  let mut m : i32 = -15;
  // Subnormal: scale by 2^10 into the normal range.
  if (x_u & 31744u16) == 0u16 {
    x_u = libm_f16_to_bits(x * libm_f16_from_bits(25600u16));
    m = m - 10;
  }
  let f = ((x_u & 1023u16) >> 5u16) as i64;
  m = m + (x_u >> 10u16) as i32;
  let mant_f = libm_f16_from_bits((x_u & 1023u16) | 15360u16) as f32;
  let v = libm_multiply_add_f32(mant_f, LIBM_F16_ONE_OVER_F[f], -1.0);
  let p = libm_multiply_add_f32(v, libm_multiply_add_f32(v, libm_f32_from_bits(1056332231u32), libm_f32_from_bits(3208166285u32)), libm_f32_from_bits(1069066811u32)); // 0x1.ecb38ep-2f, -0x1.71771ap-1f, 0x1.715476p+0f
  let log2_1_mant = LIBM_F16_LOG2_F[f] + v * p;
  return ((m as f32) + log2_1_mant) as f16;
}

/// The logarithm to base ten of an f16, correctly rounded: `log10f16` from `log10f16.h`, the
/// same reduction as `libm_logf16`.
fn libm_log10f16(x : f16) -> f16 {
  let mut x_u = libm_f16_to_bits(x);
  let special = libm_f16_log_special(x_u);
  if special != 65536u32 {
    return libm_f16_from_bits(special as u16);
  }
  // Inputs where the evaluation below would round the wrong way, and exact powers of ten.
  if x_u == 13199u16 { // 0x338f
    return libm_f16_from_bits(47363u16); // 0xb903
  }
  if x_u == 13304u16 { // 0x33f8
    return libm_f16_from_bits(47317u16); // 0xb8d5
  }
  if x_u == 15274u16 { // 0x3baa
    return libm_f16_from_bits(42181u16); // 0xa4c5
  }
  if x_u == 15276u16 { // 0x3bac
    return libm_f16_from_bits(42152u16); // 0xa4a8
  }
  if x_u == 15308u16 { // 0x3bcc
    return libm_f16_from_bits(41400u16); // 0xa1b8
  }
  if x_u == 18688u16 { // 0x4900
    return libm_f16_from_bits(15360u16); // 0x3c00
  }
  if x_u == 22080u16 { // 0x5640
    return libm_f16_from_bits(16384u16); // 0x4000
  }
  if x_u == 22497u16 { // 0x57e1
    return libm_f16_from_bits(16435u16); // 0x4033
  }
  if x_u == 25552u16 { // 0x63d0
    return libm_f16_from_bits(16896u16); // 0x4200
  }
  if x_u == 28898u16 { // 0x70e2
    return libm_f16_from_bits(17408u16); // 0x4400
  }
  if x_u == 29085u16 { // 0x719d
    return libm_f16_from_bits(17423u16); // 0x440f
  }
  let mut m : i32 = -15;
  // Subnormal: scale by 2^10 into the normal range.
  if (x_u & 31744u16) == 0u16 {
    x_u = libm_f16_to_bits(x * libm_f16_from_bits(25600u16));
    m = m - 10;
  }
  let f = ((x_u & 1023u16) >> 5u16) as i64;
  m = m + (x_u >> 10u16) as i32;
  let mant_f = libm_f16_from_bits((x_u & 1023u16) | 15360u16) as f32;
  let v = libm_multiply_add_f32(mant_f, LIBM_F16_ONE_OVER_F[f], -1.0);
  let p = libm_multiply_add_f32(v, libm_multiply_add_f32(v, libm_f32_from_bits(1041520220u32), libm_f32_from_bits(3193860276u32)), libm_f32_from_bits(1054759896u32)); // 0x1.28acb8p-3f, -0x1.bce168p-3f, 0x1.bcb7bp-2f
  let log10_1_mant = LIBM_F16_LOG10_F[f] + v * p;
  return libm_multiply_add_f32(m as f32, libm_f32_from_bits(1050288283u32), log10_1_mant) as f16; // 0x1.344136p-2f
}

/// `log(1 + x)` of an f16, correctly rounded. LLVM libc has no `log1pf16`: this is its
/// `log1pf` on the input widened to f32, rounded to f16. Rounding twice lands one step off
/// for two inputs, found by checking all 65,536 inputs against `ln(1 + x)` computed to 60
/// digits; they are listed here.
fn libm_log1pf16(x : f16) -> f16 {
  let x_u = libm_f16_to_bits(x);
  // x = 0x1.80cp-8
  if x_u == 7683u16 {
    return libm_f16_from_bits(7679u16); // 0x1.7fcp-8
  }
  // x = -0x1.7f4p-8
  if x_u == 40445u16 {
    return libm_f16_from_bits(40449u16); // -0x1.804p-8
  }
  return libm_log1pf(x as f32) as f16;
}

/// The bits of a bf16.
fn libm_bf16_to_bits(x : bf16) -> u16 {
  return mlir!( inputs : (%a = x : bf16), returns : u16, dialects : ["arith"]) {
    %r = arith.bitcast %a : bf16 to i16
    macro.yield %r : i16
  };
}

/// The bf16 with these bits.
fn libm_bf16_from_bits(v : u16) -> bf16 {
  return mlir!( inputs : (%v = v : i16), returns : bf16, dialects : ["arith"]) {
    %r = arith.bitcast %v : i16 to bf16
    macro.yield %r : bf16
  };
}

/// A bf16 widened to f32, exactly, by moving its bits. `as f32` is exact too, but LLVM then
/// narrows a comparison such as `(x as f32) == 0.0` back to bf16, and on a CPU with AVX512-BF16
/// it evaluates that through `vcvtneps2bf16`, which reads a subnormal as zero.
fn libm_f32_from_bf16(x : bf16) -> f32 {
  return libm_f32_from_bits((libm_bf16_to_bits(x) as u32) << 16u32);
}

/// An f32 rounded to the nearest bf16, ties to even, as integer operations on its bits. `as bf16`
/// cannot be used: on a CPU with AVX512-BF16, LLVM converts with `vcvtneps2bf16`, which reads a
/// subnormal input as zero and flushes a subnormal result to zero.
fn libm_bf16_from_f32(x : f32) -> bf16 {
  return libm_bf16_from_bits(libm_bf16_bits_from_f32(x));
}

/// The bits of `libm_bf16_from_f32(x)`. A bf16 function makes its result once, at its only
/// return: on a CPU with AVX512-BF16, LLVM joins bf16 values from two branches through
/// `vcvtneps2bf16`, which flushes a subnormal to zero.
fn libm_bf16_bits_from_f32(x : f32) -> u16 {
  let b = libm_f32_to_bits(x);
  // NaN: keep the sign and the top of the payload, and make it quiet.
  if (b & 2147483647u32) > 2139095040u32 {
    return ((b >> 16u32) | 64u32) as u16;
  }
  let round = 32767u32 + ((b >> 16u32) & 1u32);
  return ((b + round) >> 16u32) as u16;
}

