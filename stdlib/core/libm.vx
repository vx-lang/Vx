-0.000000000000000024623815582638635, 0.35877067027057225, 0.000000000000000019612311504845653, 0.3723984466767542,
0.00000000000000002378822732491941, 0.38588266939807375, 0.00000000000000002246598105617042, 0.39922076957525254,
-0.00000000000000001587652227770689, 0.4124104415973873, 0.000000000000000023315530741892885, 0.42544963737004227,
-0.00000000000000002494277030626541, 0.43833655985795783, -0.000000000000000022703795229420475, 0.4510696559885235,
0.000000000000000022698777452961687, 0.4636476090008061, 0.000000000000000014654487332256713, 0.4760693303227612,
-0.000000000000000011373236189329585, 0.48833395105640554, -0.000000000000000047181675085518756, 0.5004408131472942,
-0.000000000000000025462781472855804, 0.5123894603107377, 0.000000000000000005520094119641666, 0.5241796287829132,
-0.0000000000000000040637956834825575, 0.5358112379604637, 0.00000000000000004923709671396255, 0.5472843809874369,
-0.0000000000000000054556305485916264, 0.5585993153435624, 0.000000000000000012255062085054184, 0.5697564534829784,
-0.00000000000000001441464378193067, 0.5807563535676704, 0.00000000000000004920495453686772, 0.5915997103351114,
0.00000000000000002950430737228402, 0.6022873461349642, -0.000000000000000031552061848586226, 0.6128202021652414,
0.00000000000000002672403885140095, 0.6231993299340659, -0.000000000000000027290767436015276, 0.6334258829691446,
0.000000000000000015834785051444286, 0.6435011087932844, 0.000000000000000035800634857340095, 0.6534263411807619,
