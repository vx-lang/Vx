/// `a + b` for double-doubles of either order of size: TwoSum on the high parts.
fn libm_dd_add_any(a : LibmDoubleDouble, b : LibmDoubleDouble) -> LibmDoubleDouble {
  let s = libm_dd_two_sum(a.hi, b.hi);
  return libm_dd_exact_add(s.hi, s.lo + (a.lo + b.lo));
}

/// The square root of a double-double, as a double-double: the double root corrected once.
fn libm_dd_sqrt(a : LibmDoubleDouble) -> LibmDoubleDouble {
  let r = libm_sqrt_f64(a.hi);
