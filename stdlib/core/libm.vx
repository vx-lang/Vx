/// `x^y`, correctly rounded: `powf` from `powf.h`.
fn libm_powf(x : f32, y : f32) -> f32 {
  return libm_pow_value(x, y, 268435455u64, false) as f32;
}

/// `x^y` for f16, correctly rounded: `libm_pow_value` on the inputs widened to f32, always
/// through the double-double pass, rounded once.
fn libm_powf16(x : f16, y : f16) -> f16 {
  // Widening to f32 would quiet a signaling NaN, and pow(1, NaN) is 1 for a quiet one.
  let x_a = libm_f16_to_bits(x) & 32767u16; // 0x7fff
  let y_a = libm_f16_to_bits(y) & 32767u16; // 0x7fff
  if (x_a > 31744u16 && (x_a & 512u16) == 0u16) || (y_a > 31744u16 && (y_a & 512u16) == 0u16) { // 0x7c00, 0x200
    return libm_f16_from_bits(32256u16); // 0x7e00
  }
  return libm_pow_value(x as f32, y as f32, 2199023255551u64, true) as f16;
}

/// `x^y` for bf16, correctly rounded: as for f16, rounded to f32 with round-to-odd and then to
/// bf16.
fn libm_pow_bf16(x : bf16, y : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_f32_round_odd(libm_pow_value(libm_f32_from_bf16(x), libm_f32_from_bf16(y), 17592186044415u64, true)));
}

/// The correctly rounded square root of an f32.
fn libm_sqrt_f32(x : f32) -> f32 {
  return mlir!( inputs : (%x = x : f32), returns : f32, dialects : ["math"]) {
    %r = math.sqrt %x : f32
    macro.yield %r : f32
  };
}

// ---------------------------------------------------------------------------------------------
// Signed 128-bit integers, as two's complement in two 64-bit halves, for the range reduction of
// the double-precision logarithms. Every operation wraps modulo 2^128.

/// `hi * 2^64 + lo` read as a signed 128-bit integer.
struct LibmI128 {
  hi : u64,
  lo : u64,
}

impl Copy for LibmI128 {}

/// `v` widened to 128 bits.
fn libm_i128_from_i64(v : i64) -> LibmI128 {
  let hi = if v < 0 {
    18446744073709551615u64
  } else {
    0u64
  };
  return LibmI128 {
    hi: hi, lo: v as u64
  };
}

/// `a + b`.
fn libm_i128_add(a : LibmI128, b : LibmI128) -> LibmI128 {
  let lo = a.lo + b.lo;
  let carry = if lo < a.lo {
    1u64
  } else {
    0u64
  };
  return LibmI128 {
    hi: a.hi + b.hi + carry, lo: lo
  };
}

/// `a << s`, for `s` below 128.
fn libm_i128_shl(a : LibmI128, s : u64) -> LibmI128 {
  if s == 0u64 {
    return a;
  }
  if s < 64u64 {
    return LibmI128 {
      hi: (a.hi << s) | (a.lo >> (64u64 - s)), lo: a.lo << s
    };
  }
  return LibmI128 {
    hi: a.lo << (s - 64u64), lo: 0u64
  };
}

/// `a * s`, keeping the low 128 bits.
fn libm_i128_mul_i64(a : LibmI128, s : i64) -> LibmI128 {
  let s_lo = s as u64;
  let s_hi = if s < 0 {
    18446744073709551615u64
  } else {
    0u64
  };
  return LibmI128 {
    hi: libm_u64_mul_hi(a.lo, s_lo) + a.lo * s_hi + a.hi * s_lo, lo: a.lo * s_lo
  };
}

/// Whether `a` is negative.
fn libm_i128_is_negative(a : LibmI128) -> bool {
  return (a.hi >> 63u64) == 1u64;
}

/// `-a`.
fn libm_i128_negate(a : LibmI128) -> LibmI128 {
  return libm_i128_add(LibmI128 {
    hi: a.hi ^ 18446744073709551615u64, lo: a.lo ^ 18446744073709551615u64
  }, LibmI128 {
    hi: 0u64, lo: 1u64
  });
}

/// Bits 68 to 99 of `a`, as `(int)(a >> 68)` with an arithmetic shift.
fn libm_i128_bits_from_68(a : LibmI128) -> i32 {
  return ((a.hi >> 4u64) as u32) as i32;
}

/// The dyadic float at `[4 i]` to `[4 i + 3]` of a table written by `DYADIC`: negative, exponent,
/// mantissa high and low.
fn libm_dyadic_from_parts(negative : u64, exponent : u64, hi : u64, lo : u64) -> LibmDyadic128 {
  return LibmDyadic128 {
    negative: negative == 1u64, exponent: (exponent as i64) as i32, hi: hi, lo: lo
  };
}

