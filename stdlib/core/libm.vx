0.00000000000000003061616997868383, 0.7853981633974483
];

/// pi/2 and pi in 128 bits.
fn libm_pi_over_two_f128() -> LibmDyadic128 {
  return LibmDyadic128 {
    negative: false, exponent: -127, hi: 14488038916154245684u64, lo: 14179128828124470481u64 // 0xc90fdaa22168c234, 0xc4c6628b80dc1cd1
  };
}

fn libm_pi_f128() -> LibmDyadic128 {
  return LibmDyadic128 {
    negative: false, exponent: -126, hi: 14488038916154245684u64, lo: 14179128828124470481u64 // 0xc90fdaa22168c234, 0xc4c6628b80dc1cd1
  };
}

/// `asin(x) / x` as a double-double for `u = x^2` (or the reduced argument of the larger
/// range), from row `round(32 u.hi)` of `LIBM_ASIN_COEFFS`: `asin_eval` from `asin_utils.h`.
/// `err` is the error bound so far, which it scales by the size of the reduced argument.
struct LibmAsinEval {
  p : LibmDoubleDouble,
  err : f64,
}

impl Copy for LibmAsinEval {}

fn libm_asin_eval_dd(u : LibmDoubleDouble, err0 : f64) -> LibmAsinEval {
  let k = libm_round_even_f64(u.hi * 32.0);
  let i = (k as i64) * 12;
  // Exact.
  let y_hi = libm_multiply_add(k, -0.03125, u.hi);
  let y = libm_dd_exact_add(y_hi, u.lo);
  let y2 = y.hi * y.hi;
  let err = libm_multiply_add(err0, y2, libm_f64_from_bits(4147815256808226816u64)); // 0x1.0p-102
  let c0 = libm_dd_quick_mult(y, LibmDoubleDouble {
    hi: LIBM_ASIN_COEFFS[i + 2], lo: LIBM_ASIN_COEFFS[i + 3]
  });
  let c1 = libm_multiply_add(y.hi, LIBM_ASIN_COEFFS[i + 5], LIBM_ASIN_COEFFS[i + 4]);
  let c2 = libm_multiply_add(y.hi, LIBM_ASIN_COEFFS[i + 7], LIBM_ASIN_COEFFS[i + 6]);
  let c3 = libm_multiply_add(y.hi, LIBM_ASIN_COEFFS[i + 9], LIBM_ASIN_COEFFS[i + 8]);
  let c4 = libm_multiply_add(y.hi, LIBM_ASIN_COEFFS[i + 11], LIBM_ASIN_COEFFS[i + 10]);
  let y4 = y2 * y2;
  let d0 = libm_multiply_add(y2, c2, c1);
  let d1 = libm_multiply_add(y2, c4, c3);
  let r = libm_dd_exact_add(LIBM_ASIN_COEFFS[i], c0.hi);
  let e1 = libm_multiply_add(y4, d1, d0);
  return LibmAsinEval {
    p: LibmDoubleDouble {
      hi: r.hi, lo: libm_multiply_add(y2, e1, LIBM_ASIN_COEFFS[i + 1] + c0.lo + r.lo)
    }, err: err
  };
}

/// Coefficient `j` of row `idx` of `LIBM_ASIN_COEFFS_F128`.
fn libm_asin_coeff_f128(idx : i64, j : i64) -> LibmDyadic128 {
  let b = 64 * idx + 4 * j;
  return libm_dyadic_from_parts(LIBM_ASIN_COEFFS_F128[b], LIBM_ASIN_COEFFS_F128[b + 1], LIBM_ASIN_COEFFS_F128[b + 2], LIBM_ASIN_COEFFS_F128[b + 3]);
}

/// `asin(x) / x` in 128 bits from row `idx`, at the reduced argument `u`: the 128-bit
/// `asin_eval`, by Horner's rule.
fn libm_asin_eval_f128(u : LibmDyadic128, idx : i64) -> LibmDyadic128 {
  let mut p = libm_asin_coeff_f128(idx, 15);
  let mut j : i64 = 14;
  while j >= 0 {
    p = libm_dyadic_add(libm_asin_coeff_f128(idx, j), libm_dyadic_mul(u, p));
    j = j - 1;
  }
  return p;
}

/// The reduced argument of the 128-bit pass for `|x| < 1/2`: `u = x^2 - idx / 64` with
/// `idx = round(64 x^2)`, from `x^2` as a double-double. Its `idx` comes back in `k`.
struct LibmAsinSmall128 {
  u : LibmDyadic128,
  idx : i64,
}

impl Copy for LibmAsinSmall128 {}

fn libm_asin_small_f128(x_sq : LibmDoubleDouble) -> LibmAsinSmall128 {
  let k = libm_round_even_f64(x_sq.hi * 64.0);
  let u_hi = libm_dyadic_from_f64(libm_multiply_add(k, -0.015625, x_sq.hi));
  return LibmAsinSmall128 {
    u: libm_dyadic_add(u_hi, libm_dyadic_from_f64(x_sq.lo)), idx: k as i64
  };
}

/// For `1/2 <= |x| < 1`, `asin(|x|) = pi/2 - 2 asin(sqrt(u))` with `u = (1 - |x|) / 2`. This
/// holds the pieces both `asin` and `acos` need: `v = sqrt(u)` as `vh / 2 + vl / 2`, and the
/// double-double `2 sqrt(u) * asin(sqrt(u)) / sqrt(u)` with its error bound.
struct LibmAsinLarge {
  u : f64,
  v_hi : f64,
  h : f64,
  vh : f64,
  vl : f64,
  r0 : LibmDoubleDouble,
  err : f64,
}

impl Copy for LibmAsinLarge {}

fn libm_asin_large(x_abs : f64) -> LibmAsinLarge {
  let u = libm_multiply_add(x_abs, -0.5, 0.5);
  let v_hi = libm_sqrt_f64(u);
  let h = libm_multiply_add(v_hi, -v_hi, u);
  let vh = v_hi * 2.0;
  let vl = h / v_hi;
  let e = libm_asin_eval_dd(LibmDoubleDouble {
    hi: u, lo: 0.0
  }, vh * libm_f64_from_bits(4377498837804122112u64)); // 0x1.0p-51
  return LibmAsinLarge {
    u: u, v_hi: v_hi, h: h, vh: vh, vl: vl, r0: libm_dd_quick_mult(LibmDoubleDouble {
      hi: vh, lo: vl
    }, e.p), err: e.err
  };
}

/// `2 sqrt(u) asin(sqrt(u)) / sqrt(u)` in 128 bits, from the pieces of `libm_asin_large`, with
/// the sign of `negative`.
fn libm_asin_large_f128(s : LibmAsinLarge, negative : bool) -> LibmDyadic128 {
  let idx = libm_round_even_f64(s.u * 64.0);
  let vl_lo = libm_multiply_add(-s.v_hi, s.vl, s.h) / s.v_hi;
  let t = s.h * -0.25 / s.u;
  let vll = libm_multiply_add(s.vl, t, vl_lo);
  let mut m_v = libm_dyadic_add(libm_dyadic_from_f64(s.vh), libm_dyadic_add(libm_dyadic_from_f64(s.vl), libm_dyadic_from_f64(vll)));
  m_v.negative = negative;
  let y = libm_dyadic_from_f64(libm_multiply_add(idx, -0.015625, s.u));
  return libm_dyadic_mul(m_v, libm_asin_eval_f128(y, idx as i64));
}

/// What `asin` and `acos` answer for `|x| > 1` and NaN: a quiet NaN, the input itself if it is
/// one.
fn libm_asin_nan(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  if (x_u & 9221120237041090560u64) == 9221120237041090560u64 { // 0x7ff8000000000000, 0x7ff8000000000000
    return x;
  }
  return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
}

/// The arcsine of a double, correctly rounded: `asin` from `asin.h`. For `|x| < 1/2` a
/// polynomial in `x^2`, from one of 9 tables; above that `pi/2 - 2 asin(sqrt((1 - |x|) / 2))`.
/// When the error bound does not decide the rounding, the result is computed again in 128 bits.
fn libm_asin(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let x_exp = ((x_u >> 52u64) & 2047u64) as i32;
  let x_abs = libm_f64_from_bits(x_u & 9223372036854775807u64); // 0x7fffffffffffffff
  if x_exp < 1023 - 1 {
    // |x| < 2^-26: asin(x) rounds like x + x * 2^-54.
    if x_exp < 1023 - 26 {
      return libm_multiply_add(x, libm_f64_from_bits(4363988038922010624u64), x); // 0x1.0p-54
    }
    let x_sq = libm_dd_exact_mult(x, x);
    let e = libm_asin_eval_dd(x_sq, x_abs * libm_f64_from_bits(4377498837804122112u64)); // 0x1.0p-51
    let r0 = libm_dd_exact_mult(x, e.p.hi);
    let r_lo = libm_multiply_add(x, e.p.lo, r0.lo);
    let r_upper = r0.hi + (r_lo + e.err);
    let r_lower = r0.hi + (r_lo - e.err);
    if r_upper == r_lower {
      return r_upper;
    }
    let s = libm_asin_small_f128(x_sq);
    return libm_dyadic_to_f64(libm_dyadic_mul(libm_dyadic_from_f64(x), libm_asin_eval_f128(s.u, s.idx)));
  }
  let x_sign : f64 = if (x_u >> 63u64) == 1u64 {
    -1.0
  } else {
    1.0
  };
  let pi_over_two = LibmDoubleDouble {
    hi: libm_f64_from_bits(4609753056924675352u64), lo: libm_f64_from_bits(4364452196894661639u64) // 0x1.921fb54442d18p0, 0x1.1a62633145c07p-54
  };
  if x_exp >= 1023 {
    if x_abs == 1.0 {
      return libm_multiply_add(x_sign, pi_over_two.hi, x_sign * pi_over_two.lo);
    }
    return libm_asin_nan(x);
  }
  let s = libm_asin_large(x_abs);
  let r = libm_dd_exact_add(pi_over_two.hi, -s.r0.hi);
  let r_lo = pi_over_two.lo - s.r0.lo + r.lo;
  let r_upper = libm_multiply_add(r.hi, x_sign, libm_multiply_add(r_lo, x_sign, s.err));
  let r_lower = libm_multiply_add(r.hi, x_sign, libm_multiply_add(r_lo, x_sign, -s.err));
  if r_upper == r_lower {
    return r_upper;
  }
  let mut r_f128 = libm_dyadic_add(libm_pi_over_two_f128(), libm_asin_large_f128(s, true));
  if (x_u >> 63u64) == 1u64 {
    r_f128.negative = true;
  }
  return libm_dyadic_to_f64(r_f128);
}

/// The arccosine of a double, correctly rounded: `acos` from `acos.h`. `pi/2 - asin(x)` for
/// `|x| < 1/2`; above that `2 asin(sqrt((1 - |x|) / 2))`, from pi for a negative x. When the
/// error bound does not decide the rounding, the result is computed again in 128 bits.
fn libm_acos(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let x_exp = ((x_u >> 52u64) & 2047u64) as i32;
  let x_abs = libm_f64_from_bits(x_u & 9223372036854775807u64); // 0x7fffffffffffffff
  let pi_over_two = LibmDoubleDouble {
    hi: libm_f64_from_bits(4609753056924675352u64), lo: libm_f64_from_bits(4364452196894661639u64) // 0x1.921fb54442d18p0, 0x1.1a62633145c07p-54
  };
  let pi = LibmDoubleDouble {
    hi: libm_f64_from_bits(4614256656552045848u64), lo: libm_f64_from_bits(4368955796522032135u64) // 0x1.921fb54442d18p1, 0x1.1a62633145c07p-53
  };
  if x_exp < 1023 - 1 {
    // |x| < 2^-55: acos(x) rounds like pi/2 just below the double nearest it.
    if x_exp < 1023 - 55 {
      return (x_abs + libm_f64_from_bits(3886606478420738048u64)) + pi_over_two.hi; // 0x1.0p-160
    }
    let x_sq = libm_dd_exact_mult(x, x);
    let e = libm_asin_eval_dd(x_sq, x_abs * libm_f64_from_bits(4377498837804122112u64)); // 0x1.0p-51
    let r0 = libm_dd_exact_mult(x, e.p.hi);
    let r_hi = libm_multiply_add(-x, e.p.hi, pi_over_two.hi);
    let r_lo0 = ((pi_over_two.hi - r_hi) - r0.hi) - r0.lo;
    let r_lo = libm_multiply_add(-x, e.p.lo, r_lo0 + pi_over_two.lo);
    let r_upper = r_hi + (r_lo + e.err);
    let r_lower = r_hi + (r_lo - e.err);
    if r_upper == r_lower {
      return r_upper;
    }
    let s = libm_asin_small_f128(x_sq);
    let mut x_f128 = libm_dyadic_from_f64(x);
    x_f128.negative = !x_f128.negative;
    return libm_dyadic_to_f64(libm_dyadic_add(libm_pi_over_two_f128(), libm_dyadic_mul(x_f128, libm_asin_eval_f128(s.u, s.idx))));
  }
  let negative = (x_u >> 63u64) == 1u64;
  if x_exp >= 1023 {
    if x_abs == 1.0 {
      if x == 1.0 {
        return 0.0;
      }
      return libm_multiply_add(1.0, pi.hi, pi.lo);
    }
    return libm_asin_nan(x);
  }
  let s = libm_asin_large(x_abs);
  let mut r_hi = s.r0.hi;
  let mut r_lo = s.r0.lo;
  if negative {
    let r = libm_dd_exact_add(pi.hi, -s.r0.hi);
    r_hi = r.hi;
    r_lo = (pi.lo - s.r0.lo) + r.lo;
  }
  let r_upper = r_hi + (r_lo + s.err);
  let r_lower = r_hi + (r_lo - s.err);
  if r_upper == r_lower {
    return r_upper;
  }
  let mut r_f128 = libm_asin_large_f128(s, negative);
  if negative {
    r_f128 = libm_dyadic_add(libm_pi_f128(), r_f128);
  }
  return libm_dyadic_to_f64(r_f128);
}

/// `atan(x)` as a double-double for a small double-double `x`: `atan_eval` from
/// `atan_utils.h`, `x - x^3/3 + x^5/5 - x^7/7 + x^9/9` with `x.lo` added to first order.
fn libm_atan_eval_dd(x : LibmDoubleDouble) -> LibmDoubleDouble {
  let x_hi_sq = x.hi * x.hi;
  let c0 = libm_multiply_add(x_hi_sq, libm_f64_from_bits(4596373779694328218u64), libm_f64_from_bits(13823048456275842389u64)); // 0x1.999999999999ap-3, -0x1.5555555555555p-2
  let c1 = libm_multiply_add(x_hi_sq, libm_f64_from_bits(4592670820000712476u64), libm_f64_from_bits(13817687028148020370u64)); // 0x1.c71c71c71c71cp-4, -0x1.2492492492492p-3
  let x_hi_3 = x_hi_sq * x.hi;
  let x_hi_4 = x_hi_sq * x_hi_sq;
  let d0 = libm_multiply_add(x_hi_4, c1, c0);
  let d1 = libm_multiply_add(x_hi_4 - x_hi_sq, x.lo, x.lo);
  return LibmDoubleDouble {
    hi: x.hi, lo: libm_multiply_add(x_hi_3, d0, d1)
  };
}

/// `atan(i / 64)` as a double-double.
fn libm_atan_i(i : i64) -> LibmDoubleDouble {
  return LibmDoubleDouble {
    hi: LIBM_ATAN_I[2 * i + 1], lo: LIBM_ATAN_I[2 * i]
  };
}

/// The arctangent of a double: `atan` from `atan.h`. With `k = round(64 |x|) / 64`,
/// `atan(|x|) = atan(k) + atan((|x| - k) / (1 + |x| k))`; above 1 the same on `1 / |x|`, from
/// pi/2. LLVM libc has no 128-bit pass for this one, so the last bit can be off.
fn libm_atan(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let x_sign : f64 = if (x_u >> 63u64) == 1u64 {
    -1.0
  } else {
    1.0
  };
  let x_abs_u = x_u & 9223372036854775807u64; // 0x7fffffffffffffff
  let x_exp = ((x_abs_u >> 52u64) as i32) - 1023;
  let x_d = libm_f64_from_bits(x_abs_u);
  if x_exp < 0 {
    // |x| < 2^-26: atan(x) rounds like x - x * 2^-54.
    if x_exp < -26 {
      if x == 0.0 {
        return x;
      }
      return libm_multiply_add(libm_f64_from_bits(13587360075776786432u64), x, x); // -0x1.0p-54
    }
    let kr = libm_round_even_f64(64.0 * x_d);
    let idx = kr as i64;
    let k = kr * 0.015625;
    let den_hi = libm_multiply_add(x_d, k, 1.0);
    let prod = libm_dd_exact_mult(x_d, k);
    let den = LibmDoubleDouble {
      hi: den_hi, lo: ((1.0 - den_hi) + prod.hi) + prod.lo
    };
    let x_r = libm_dd_div(LibmDoubleDouble {
      hi: x_d - k, lo: 0.0
    }, den);
    let p = libm_atan_eval_dd(x_r);
    let a = libm_atan_i(idx);
    let c0 = libm_dd_exact_add(a.hi, p.hi);
    let c1 = c0.lo + (a.lo + p.lo);
    return x_sign * (c0.hi + c1);
  }
  if x_exp >= 53 {
    // NaN, quiet; infinity and |x| >= 2^53 give pi/2 with the sign of x.
    if x_abs_u > 9218868437227405312u64 { // 0x7ff0000000000000
      if (x_abs_u & 2251799813685248u64) == 0u64 { // 0x0008000000000000
        return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
      }
      return x;
    }
    return libm_multiply_add(x_sign, libm_f64_from_bits(4609753056924675352u64), x_sign * libm_f64_from_bits(4364452196894661639u64)); // 0x1.921fb54442d18p0, 0x1.1a62633145c07p-54
  }
  let y = 1.0 / x_d;
  let kr = libm_round_even_f64(64.0 * y);
  let idx = kr as i64;
  let k = kr * 0.015625;
  let den = libm_dd_exact_add(x_d, k);
  let num_hi = libm_multiply_add(-x_d, k, 1.0);
  let prod = libm_dd_exact_mult(x_d, k);
  let num = LibmDoubleDouble {
    hi: num_hi, lo: ((1.0 - num_hi) - prod.hi) - prod.lo
  };
  let x_r = libm_dd_div(num, den);
  let p = libm_atan_eval_dd(x_r);
  let a = libm_atan_i(idx);
  let mpi_over_2_hi = libm_f64_from_bits(13833125093779451160u64); // -0x1.921fb54442d18p0
  let mpi_over_2_lo = libm_f64_from_bits(13587824233749437447u64); // -0x1.1a62633145c07p-54
  let c0 = libm_dd_exact_add(mpi_over_2_hi, a.hi);
  let c1 = libm_dd_exact_add(c0.hi, p.hi);
  let c2 = c1.lo + (c0.lo + p.lo) + (a.lo + mpi_over_2_lo);
  return -x_sign * (c1.hi + c2);
}

/// The angle to the point (`x`, `y`): `atan2` from `atan2.h`. The smaller of `|x|` and `|y|` is
/// divided by the larger, reduced as in `libm_atan`, and the quadrant adds 0, pi/2 or pi. Values
/// near the ends of the exponent range are scaled first. LLVM libc has no 128-bit pass for this
/// one, so the last bit can be off.
fn libm_atan2(y : f64, x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let y_u = libm_f64_to_bits(y);
  let x_sign = (x_u >> 63u64) == 1u64;
  let y_sign = (y_u >> 63u64) == 1u64;
  let x_abs = x_u & 9223372036854775807u64; // 0x7fffffffffffffff
  let y_abs = y_u & 9223372036854775807u64; // 0x7fffffffffffffff
  let recip = x_abs < y_abs;
  let mut min_abs = y_abs;
  let mut max_abs = x_abs;
  if recip {
    min_abs = x_abs;
    max_abs = y_abs;
  }
  let mut min_exp = min_abs >> 52u64;
  let mut max_exp = max_abs >> 52u64;
  let mut num = libm_f64_from_bits(min_abs);
  let mut den = libm_f64_from_bits(max_abs);
  let y_neg : f64 = if y_sign {
    -1.0
  } else {
    1.0
  };
  if max_exp > 2047u64 - 128u64 || min_exp < 128u64 {
    if x_abs > 9218868437227405312u64 || y_abs > 9218868437227405312u64 { // 0x7ff0000000000000, 0x7ff0000000000000
      return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
    }
    // 0 for a zero, 2 for an infinity, 1 for anything else.
    let x_except : i32 = if x == 0.0 {
      0
    } else if x_abs == 9218868437227405312u64 { // 0x7ff0000000000000
      2
    } else {
      1
    };
    let y_except : i32 = if y == 0.0 {
      0
    } else if y_abs == 9218868437227405312u64 { // 0x7ff0000000000000
      2
    } else {
      1
    };
    if x_except != 1 || y_except != 1 {
      let r = libm_atan2_except(y_except, x_except, x_sign);
      return libm_multiply_add(y_neg, r.hi, y_neg * r.lo);
    }
    let scale_up = min_exp < 128u64;
    let scale_down = max_exp > 2047u64 - 128u64;
    if scale_up {
      num = num * libm_f64_from_bits(4895412794951729152u64); // 0x1.0p64
      if !scale_down {
        den = den * libm_f64_from_bits(4895412794951729152u64); // 0x1.0p64
      }
    } else if scale_down {
      den = den * libm_f64_from_bits(4318952042648305664u64); // 0x1.0p-64
      num = num * libm_f64_from_bits(4318952042648305664u64); // 0x1.0p-64
    }
    min_abs = libm_f64_to_bits(num);
    max_abs = libm_f64_to_bits(den);
    min_exp = min_abs >> 52u64;
    max_exp = max_abs >> 52u64;
  }
  let final_sign : f64 = if (x_sign != y_sign) != recip {
    -1.0
  } else {
    1.0
  };
  let const_term = libm_atan2_const_adj(x_sign, y_sign, recip);
  let exp_diff = max_exp - min_exp;
  if exp_diff > 54u64 {
    return libm_multiply_add(final_sign, const_term.hi, final_sign * (const_term.lo + num / den));
  }
  let kr = libm_round_even_f64(64.0 * num / den);
  let idx = kr as i64;
  let k = kr * 0.015625;
  let num_k = libm_dd_exact_mult(num, k);
  let den_k = libm_dd_exact_mult(den, k);
  let num_dd = libm_dd_exact_add(num - den_k.hi, -den_k.lo);
  let mut den_dd = libm_dd_exact_add(den, num_k.hi);
  den_dd.lo = den_dd.lo + num_k.lo;
  let q = libm_dd_div(num_dd, den_dd);
  let p = libm_atan_eval_dd(q);
  let r = libm_dd_add(const_term, libm_dd_add(libm_atan_i(idx), p));
  let r_hi = r.hi * final_sign;
  let r_lo = r.lo * final_sign;
  return r_hi + r_lo;
}

/// The constant `atan2` adds for the quadrant, `CONST_ADJ[x_sign][y_sign][recip]`: 0, -0, pi/2,
/// -pi/2 or -pi as double-doubles.
fn libm_atan2_const_adj(x_sign : bool, y_sign : bool, recip : bool) -> LibmDoubleDouble {
  let pi_over_2 = LibmDoubleDouble {
    hi: libm_f64_from_bits(4609753056924675352u64), lo: libm_f64_from_bits(4364452196894661639u64) // 0x1.921fb54442d18p0, 0x1.1a62633145c07p-54
  };
  if recip {
    if x_sign {
      return pi_over_2;
    }
    return LibmDoubleDouble {
      hi: -pi_over_2.hi, lo: -pi_over_2.lo
    };
  }
  if x_sign {
    return LibmDoubleDouble {
      hi: libm_f64_from_bits(13837628693406821656u64), lo: libm_f64_from_bits(13592327833376807943u64) // -0x1.921fb54442d18p1, -0x1.1a62633145c07p-53
    };
  }
  if y_sign {
    return LibmDoubleDouble {
      hi: -0.0, lo: -0.0
    };
  }
  return LibmDoubleDouble {
    hi: 0.0, lo: 0.0
  };
}

/// What `atan2` answers when either input is a zero or an infinity, before the sign of `y`:
/// `EXCEPTS[y_except][x_except][x_sign]`.
fn libm_atan2_except(y_except : i32, x_except : i32, x_sign : bool) -> LibmDoubleDouble {
  let zero = LibmDoubleDouble {
    hi: 0.0, lo: 0.0
  };
  let pi = LibmDoubleDouble {
    hi: libm_f64_from_bits(4614256656552045848u64), lo: libm_f64_from_bits(4368955796522032135u64) // 0x1.921fb54442d18p1, 0x1.1a62633145c07p-53
  };
  let pi_over_2 = LibmDoubleDouble {
    hi: libm_f64_from_bits(4609753056924675352u64), lo: libm_f64_from_bits(4364452196894661639u64) // 0x1.921fb54442d18p0, 0x1.1a62633145c07p-54
  };
  // y zero: 0 for a positive x, pi for a negative one.
  if y_except == 0 || (y_except == 1 && x_except == 2) {
    if x_sign {
      return pi;
    }
    return zero;
  }
  if y_except == 1 || x_except != 2 {
    // x zero and y finite, or y infinite and x finite.
    return pi_over_2;
  }
  // Both infinite.
  if x_sign {
    return LibmDoubleDouble {
      hi: libm_f64_from_bits(4612488097114038738u64), lo: libm_f64_from_bits(4366936075694672394u64) // 0x1.2d97c7f3321d2p+1, 0x1.a79394c9e8a0ap-54
    };
  }
  return LibmDoubleDouble {
    hi: libm_f64_from_bits(4605249457297304856u64), lo: libm_f64_from_bits(4359948597267291143u64) // 0x1.921fb54442d18p-1, 0x1.1a62633145c07p-55
  };
}

/// `sqrt(x^2 + y^2)` for doubles, exactly rounded with integers: the generic `hypot` from
/// `FPUtil/Hypot.h` for `double`, in round-to-nearest. The squares of the two 54-bit mantissas
/// are added as 128-bit integers, and the square root is taken one bit at a time.
fn libm_hypot_exact(x : f64, y : f64) -> f64 {
  let x_abs = libm_f64_to_bits(x) & 9223372036854775807u64; // 0x7fffffffffffffff
  let y_abs = libm_f64_to_bits(y) & 9223372036854775807u64; // 0x7fffffffffffffff
  let mut a_bits = x_abs;
  let mut b_bits = y_abs;
  if x_abs < y_abs {
    a_bits = y_abs;
    b_bits = x_abs;
  }
  if a_bits >= 9218868437227405312u64 { // 0x7ff0000000000000
    return libm_hypot_special(x, y);
  }
  let mut a_exp = a_bits >> 52u64;
  let mut b_exp = b_bits >> 52u64;
  if a_exp - b_exp >= 54u64 || x == 0.0 || y == 0.0 {
    return libm_f64_from_bits(x_abs) + libm_f64_from_bits(y_abs);
  }
  let mut out_exp = a_exp;
  let one = 9007199254740992u64; // 0x0020000000000000
  let mut a_mant = (a_bits & 4503599627370495u64) << 1u64; // 0x000fffffffffffff
  let mut b_mant = (b_bits & 4503599627370495u64) << 1u64; // 0x000fffffffffffff
  let mut leading_one = one;
  let mut y_mant_width : u64 = 53u64;
  if a_exp != 0u64 {
    a_mant = a_mant | one;
  } else {
    // A subnormal a: its leading one is its highest set bit.
    y_mant_width = 0u64;
    if a_mant > 0u64 {
      y_mant_width = 63u64 - libm_u64_leading_zeros(a_mant);
    }
    leading_one = 1u64 << y_mant_width;
    a_exp = 1u64;
  }
  if b_exp != 0u64 {
    b_mant = b_mant | one;
  } else {
    b_exp = 1u64;
  }
  let a_mant_sq = (a_mant as u128) * (a_mant as u128);
  let mut b_mant_sq = (b_mant as u128) * (b_mant as u128);
  let shift_length = 2u64 * (a_exp - b_exp);
  let mut sticky_bits = (b_mant_sq & (((1 as u128) << (shift_length as u128)) - (1 as u128))) != (0 as u128);
  b_mant_sq = b_mant_sq >> (shift_length as u128);
  let mut sum = a_mant_sq + b_mant_sq;
  if sum >= ((1 as u128) << ((2u64 * y_mant_width + 2u64) as u128)) {
    if leading_one == one {
      sticky_bits = sticky_bits || (sum & (3 as u128)) != (0 as u128);
      sum = sum >> (2 as u128);
      out_exp = out_exp + 1u64;
      if out_exp >= 2047u64 {
        return libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
      }
    } else {
      leading_one = leading_one << 1u64;
      y_mant_width = y_mant_width + 1u64;
    }
  }
  let mut y_new = leading_one;
  let mut r = ((sum >> (y_mant_width as u128)) as u64) - leading_one;
  let tail_bits = (sum as u64) & (leading_one - 1u64);
  let mut current_bit = leading_one >> 1u64;
  while current_bit != 0u64 {
    r = (r << 1u64) + (if (tail_bits & current_bit) != 0u64 {
      1u64
    } else {
      0u64
    });
    let tmp = (y_new << 1u64) + current_bit;
    if r >= tmp {
      r = r - tmp;
      y_new = y_new + current_bit;
    }
    current_bit = current_bit >> 1u64;
  }
  let round_bit = (y_new & 1u64) != 0u64;
  let lsb = (y_new & 2u64) != 0u64;
  if y_new >= one {
    y_new = y_new - one;
    if out_exp == 0u64 {
      out_exp = 1u64;
    }
  }
  y_new = y_new >> 1u64;
  if round_bit && (lsb || sticky_bits || r != 0u64) {
    y_new = y_new + 1u64;
  }
  if y_new >= (one >> 1u64) {
    y_new = y_new - (one >> 1u64);
    out_exp = out_exp + 1u64;
    if out_exp >= 2047u64 {
      return libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
    }
  }
  return libm_f64_from_bits(y_new | (out_exp << 52u64));
}

/// `hypot` when an input is an infinity or a NaN: a signaling NaN gives the quiet NaN, then an
/// infinity gives infinity, then the NaN input itself, `x` first.
fn libm_hypot_special(x : f64, y : f64) -> f64 {
  let x_abs = libm_f64_to_bits(x) & 9223372036854775807u64; // 0x7fffffffffffffff
  let y_abs = libm_f64_to_bits(y) & 9223372036854775807u64; // 0x7fffffffffffffff
  let x_snan = x_abs > 9218868437227405312u64 && (x_abs & 2251799813685248u64) == 0u64; // 0x7ff0000000000000, 0x0008000000000000
  let y_snan = y_abs > 9218868437227405312u64 && (y_abs & 2251799813685248u64) == 0u64; // 0x7ff0000000000000, 0x0008000000000000
  if x_snan || y_snan {
    return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
  }
  if x_abs == 9218868437227405312u64 || y_abs == 9218868437227405312u64 { // 0x7ff0000000000000, 0x7ff0000000000000
    return libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
  }
  if x_abs > 9218868437227405312u64 { // 0x7ff0000000000000
    return x;
  }
  return y;
}

/// `hypot` when both inputs are below 2^-1022 in size: `hypot_denorm` from `hypot.h`. Both are
/// scaled up by 2^1022 and the double-double square root is checked with 1.0 added, so it
/// rounds at the place a subnormal result would.
fn libm_hypot_denorm(a0 : f64, b0 : f64) -> f64 {
  let a = a0 * libm_f64_from_bits(9209861237972664320u64); // 0x1.0p1022
  let b = b0 * libm_f64_from_bits(9209861237972664320u64); // 0x1.0p1022
  let a_sq = libm_dd_exact_mult(a, a);
  let b_sq = libm_dd_exact_mult(b, b);
  let mut sum = libm_dd_exact_add(a_sq.hi, b_sq.hi);
  sum.lo = sum.lo + (a_sq.lo + b_sq.lo);
  let r_hi = libm_sqrt_f64(sum.hi);
  let r_inv = 0.5 / r_hi;
  let mut r_h = LibmDoubleDouble {
    hi: r_hi, lo: 0.0
  };
  let mut correction : f64 = 0.0;
  if r_hi < 1.0 {
    r_h = libm_dd_exact_add(1.0, r_hi);
    correction = 1.0;
  }
  let r_sq = libm_dd_exact_mult(r_hi, r_hi);
  let num_lo = (sum.lo - r_sq.lo) - (r_sq.hi - sum.hi);
  let r_lo = libm_multiply_add(num_lo, r_inv, r_h.lo);
  let upper = r_h.hi + (r_lo + libm_f64_from_bits(4147815256808226816u64)); // 0x1.0p-102
  let lower = r_h.hi + (r_lo - libm_f64_from_bits(4147815256808226816u64)); // 0x1.0p-102
  if upper == lower {
    let r = libm_dd_exact_add(r_h.hi, r_lo);
    return (r.hi - correction) * libm_f64_from_bits(4503599627370496u64); // 0x1.0p-1022
  }
  return libm_hypot_exact(a * libm_f64_from_bits(4503599627370496u64), b * libm_f64_from_bits(4503599627370496u64)); // 0x1.0p-1022, 0x1.0p-1022
}

/// `sqrt(x^2 + y^2)` for doubles, correctly rounded: `hypot` from `hypot.h`. The squares are
/// added as double-doubles and the square root is corrected once, after scaling by 2^-600 or
/// 2^600 when the inputs are very large or very small. When the error bound does not decide the
/// rounding, `libm_hypot_exact` does it with integers.
fn libm_hypot(x : f64, y : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  let y_u = libm_f64_to_bits(y);
  // The exponent and the top 20 bits of the mantissa.
  let x_e = (x_u >> 31u64) & 4294967295u64; // 0xffffffff
  let y_e = (y_u >> 31u64) & 4294967295u64; // 0xffffffff
  let mut a = x;
  let mut b = y;
  let mut a_e = x_e;
  let mut b_e = y_e;
  if x_e < y_e {
    a = y;
    b = x;
    a_e = y_e;
    b_e = x_e;
  }
  let x_abs = libm_f64_from_bits(x_u & 9223372036854775807u64); // 0x7fffffffffffffff
  let y_abs = libm_f64_from_bits(y_u & 9223372036854775807u64); // 0x7fffffffffffffff
  let mut scale_back : f64 = 1.0;
  if a_e >= ((500u64 + 1023u64) << 21u64) {
    if a_e >= (9218868437227405312u64 >> 31u64) { // 0x7ff0000000000000
      return libm_hypot_special(x, y);
    }
    if a_e - b_e >= (54u64 << 21u64) {
      return x_abs + y_abs;
    }
    scale_back = libm_f64_from_bits(7309342195222315008u64); // 0x1.0p600
    a = a * libm_f64_from_bits(1905022642377719808u64); // 0x1.0p-600
    b = b * libm_f64_from_bits(1905022642377719808u64); // 0x1.0p-600
    // The squares and their sum, each rounded once, as in LLVM.
    let asq = a * a;
    let bsq = b * b;
    let sumsq = asq + bsq;
    if sumsq >= libm_f64_from_bits(8426234902810198016u64) { // 0x1.0p848
      return sumsq * scale_back;
    }
  } else if b_e <= ((1023u64 - 400u64) << 21u64) {
    if a_e < (1u64 << 21u64) {
      if x == 0.0 || y == 0.0 {
        return x_abs + y_abs;
      }
      return libm_hypot_denorm(a, b);
    }
    scale_back = libm_f64_from_bits(1905022642377719808u64); // 0x1.0p-600
    a = a * libm_f64_from_bits(7309342195222315008u64); // 0x1.0p600
    b = b * libm_f64_from_bits(7309342195222315008u64); // 0x1.0p600
  }
  if a_e - b_e >= (54u64 << 21u64) {
    return x_abs + y_abs;
  }
  let a_sq = libm_dd_exact_mult(a, a);
  let b_sq = libm_dd_exact_mult(b, b);
  let mut sum = libm_dd_exact_add(a_sq.hi, b_sq.hi);
  sum.lo = sum.lo + (a_sq.lo + b_sq.lo);
  let r_hi = libm_sqrt_f64(sum.hi);
  let r_inv = 0.5 / r_hi;
  let r_sq = libm_dd_exact_mult(r_hi, r_hi);
  let num_lo = (sum.lo - r_sq.lo) - (r_sq.hi - sum.hi);
  let r_lo = num_lo * r_inv;
  let upper = r_hi + libm_multiply_add(r_hi, libm_f64_from_bits(4147815256808226816u64), r_lo); // 0x1.0p-102
  let lower = r_hi + libm_multiply_add(r_hi, libm_f64_from_bits(13371187293663002624u64), r_lo); // -0x1.0p-102
  if upper == lower {
    return upper * scale_back;
  }
  return libm_hypot_exact(x, y);
}

/// The polynomial of `exp10` from `exp10.h`, as double-doubles, `lo` at `[2i]` and `hi` at
/// `[2i + 1]`.
const LIBM_EXP10_COEFFS_DD : Tensor<f64, [14]> = [
0.0, 1.0, -0.00000000000000021707562233811494, 2.302585092994046,
-0.00000000000000020935887830547685, 2.650949055239199, 0.0000000000000001669593387016762, 2.034678592293476,
0.0000000000000000666917755934106, 1.171255148912267, 0.000000000000000025419896662003015, 0.5393829295760609,
-0.000000000000000010602582695538038, 0.20699584869686802
];

/// The same polynomial with 128-bit coefficients, written by `DYADIC`.
const LIBM_EXP10_COEFFS_128 : Tensor<u64, [32]> = [
0, 18446744073709551489, 9223372036854775808, 0,
0, 18446744073709551490, 10618799479599967254, 16885919335239060013,
0, 18446744073709551490, 12225344693609907258, 9271113825469160411,
0, 18446744073709551490, 9383298816073343748, 7660514654588540469,
0, 18446744073709551489, 10802921988499579489, 11726309156384554360,
0, 18446744073709551488, 9949858852598690067, 10989868292022164938,
0, 18446744073709551486, 15273597790352925547, 9450447102328397853,
0, 18446744073709551485, 10048216733471695771, 17651451638361236818
];

/// The degree-6 double-double polynomial of `exp10` at `dx`, by Horner's rule: `polyeval`.
fn libm_exp10_poly_dd(dx : LibmDoubleDouble) -> LibmDoubleDouble {
  let mut p = LibmDoubleDouble {
    hi: LIBM_EXP10_COEFFS_DD[13], lo: LIBM_EXP10_COEFFS_DD[12]
  };
  let mut i : i64 = 5;
  while i >= 0 {
    p = libm_dd_multiply_add(dx, p, LibmDoubleDouble {
      hi: LIBM_EXP10_COEFFS_DD[2 * i + 1], lo: LIBM_EXP10_COEFFS_DD[2 * i]
    });
    i = i - 1;
  }
  return p;
}

/// The degree-7 128-bit polynomial of `exp10` at `dx`, by Horner's rule: `polyeval`.
fn libm_exp10_poly_128(dx : LibmDyadic128) -> LibmDyadic128 {
  let mut p = libm_dyadic_from_parts(LIBM_EXP10_COEFFS_128[28], LIBM_EXP10_COEFFS_128[29], LIBM_EXP10_COEFFS_128[30], LIBM_EXP10_COEFFS_128[31]);
  let mut i : i64 = 6;
  while i >= 0 {
    let c = libm_dyadic_from_parts(LIBM_EXP10_COEFFS_128[4 * i], LIBM_EXP10_COEFFS_128[4 * i + 1], LIBM_EXP10_COEFFS_128[4 * i + 2], LIBM_EXP10_COEFFS_128[4 * i + 3]);
    p = libm_dyadic_add(c, libm_dyadic_mul(dx, p));
    i = i - 1;
  }
  return p;
}

/// The 128-bit pass of `exp10`: `exp10_f128` from `exp10.h`.
fn libm_exp10_128(x : f64, kd : f64, idx1 : i64, idx2 : i64) -> f64 {
  let t1 = libm_multiply_add(kd, libm_f64_from_bits(13768423335549468672u64), x); // -0x1.3441350ap-14
  let t2 = kd * libm_f64_from_bits(4377710088417181696u64); // 0x1.0c0219dcp-51
  let t3 = kd * libm_f64_from_bits(4219214883283065762u64); // 0x1.da994fd20dba2p-87
  let dx = libm_dyadic_add(libm_dyadic_from_f64(t1), libm_dyadic_add(libm_dyadic_from_f64(t2), libm_dyadic_from_f64(t3)));
  let p = libm_exp10_poly_128(dx);
  let mut r = libm_dyadic_mul(libm_exp_mid_128(idx1, idx2), p);
  r.exponent = r.exponent + ((kd as i32) >> 12);
  return libm_dyadic_to_f64(r);
}

/// The double-double pass of `exp10`: `exp10_double_double` from `exp10.h`.
fn libm_exp10_dd(x : f64, kd : f64, exp_mid : LibmDoubleDouble) -> LibmDoubleDouble {
  let t1 = libm_multiply_add(kd, libm_f64_from_bits(13768423335549468672u64), x); // -0x1.3441350ap-14
  let t2 = kd * libm_f64_from_bits(4377710088417181696u64); // 0x1.0c0219dcp-51
  let t3 = kd * libm_f64_from_bits(4219214883283065762u64); // 0x1.da994fd20dba2p-87
  let mut dx = libm_dd_exact_add(t1, t2);
  dx.lo = dx.lo + t3;
  return libm_dd_quick_mult(exp_mid, libm_exp10_poly_dd(dx));
}

/// The reduction `exp10` and its subnormal path share: `k = round(x * log2(10) * 2^12)`, and
/// the fast pass's `exp_mid` and `lo`.
struct LibmExp10Reduced {
  kd : f64,
  hi : i32,
  idx1 : i64,
  idx2 : i64,
  exp_mid : LibmDoubleDouble,
  lo : f64,
}

impl Copy for LibmExp10Reduced {}

fn libm_exp10_reduce(x : f64) -> LibmExp10Reduced {
  let tmp = libm_multiply_add(x, libm_f64_from_bits(4614662735865160561u64), libm_f64_from_bits(4704009810788745216u64)); // 0x1.a934f0979a371p+1, 0x1.800000004p21
  let k = ((libm_f64_to_bits(tmp) >> 19u64) as u32) as i32;
  let kd = k as f64;
  let idx1 = ((k >> 6) & 63) as i64;
  let idx2 = (k & 63) as i64;
  let exp_mid = libm_exp_mid_dd(idx1, idx2);
  // dx = x - k * 2^-12 * log10(2).
  let lo_h = libm_multiply_add(kd, libm_f64_from_bits(13768423335549468672u64), x); // -0x1.3441350ap-14
  let dx = libm_multiply_add(kd, libm_f64_from_bits(4377710088417303193u64), lo_h); // 0x1.0c0219dc1da99p-51
  let mid_lo = dx * exp_mid.hi;
  // (10^dx - 1) / dx as a degree-3 polynomial.
  let dx2 = dx * dx;
  let c0 = libm_multiply_add(dx, libm_f64_from_bits(4613151825388694122u64), libm_f64_from_bits(4612367379483415830u64)); // 0x1.53524c73cea6ap+1, 0x1.26bb1bbb55516p+1
  let c1 = libm_multiply_add(dx, libm_f64_from_bits(4607953682391825509u64), libm_f64_from_bits(4611764107503871564u64)); // 0x1.2bd75cc6afc65p+0, 0x1.0470587aa264cp+1
  let p = libm_multiply_add(dx2, c1, c0);
  return LibmExp10Reduced {
    kd: kd, hi: k >> 12, idx1: idx1, idx2: idx2, exp_mid: exp_mid, lo: libm_multiply_add(p, mid_lo, exp_mid.lo)
  };
}

/// `exp10(x)` when the result may be subnormal: `exp10_denorm` from `exp10.h`.
fn libm_exp10_denorm(x : f64) -> f64 {
  let s = libm_exp10_reduce(x);
  let r = libm_exp_ziv_denorm(s.hi, s.exp_mid.hi, s.lo, libm_f64_from_bits(4325707442089361408u64)); // 0x1.8p-63
  if r.ok {
    return r.value;
  }
  let r_dd = libm_exp10_dd(x, s.kd, s.exp_mid);
  let r2 = libm_exp_ziv_denorm(s.hi, r_dd.hi, r_dd.lo, libm_f64_from_bits(4163577855504023552u64)); // 0x1.8p-99
  if r2.ok {
    return r2.value;
  }
  return libm_exp10_128(x, s.kd, s.idx1, s.idx2);
}

/// Ten raised to a double, correctly rounded: `exp10` from `exp10.h`. The same scheme as
/// `libm_exp`, with `log2(10)` in place of `log2(e)`; 10^1 to 10^22, which are exact, and 10^23
/// are answered directly when the fast pass cannot decide them.
fn libm_exp10(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  // x < log10(2^-1075) or x >= log10 of the largest double, or |x| < 2^-56, or infinity or NaN.
  if x_u >= 13867491935800207938u64 || (x_u <= 13581672830762149134u64 && x_u >= 4644130490496809471u64) || x_u < 4362804393534743822u64 { // 0xc0733a7146f72a42, 0xbc7bcb7b1526e50e, 0x40734413509f79ff, 0x3c8bcb7b1526e50e
    let x_abs = x_u & 9223372036854775807u64; // 0x7fffffffffffffff
    if x_abs <= 4362804393534743822u64 { // 0x3c8bcb7b1526e50e
      // 10^x ~ 1 + x * ln(10), which rounds like 1 + x / 2.
      return libm_multiply_add(x, 0.5, 1.0);
    }
    if x_u >= 13867491935800207938u64 { // 0xc0733a7146f72a42
      if x_u > 13867772611911707474u64 { // 0xc07439b746e36b52
        // x < log10(2^-1075), or -inf, or NaN with the sign bit set.
        if x != x {
          return x + libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
        }
        return 0.0;
      }
      return libm_exp10_denorm(x);
    }
    if x != x {
      return x + libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
    }
    return libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
  }
  let s = libm_exp10_reduce(x);
  let err_d = libm_f64_from_bits(4325707442089361408u64); // 0x1.8p-63
  let upper = s.exp_mid.hi + (s.lo + err_d);
  let lower = s.exp_mid.hi + (s.lo - err_d);
  if upper == lower {
    return libm_f64_scale(upper, s.hi);
  }
  // A whole x from 1 to 22: 10^x is a double.
  if (x_u & 9223653511831486463u64) == 0u64 && x >= 1.0 && x <= 22.0 && x == libm_round_even_f64(x) { // 0x8000ffffffffffff
    let mut p : f64 = 10.0;
    let mut n : f64 = 1.0;
    while n < x {
      p = p * 10.0;
      n = n + 1.0;
    }
    return p;
  }
  if x_u == 4627167142146473984u64 { // 0x4037000000000000
    // x = 23: 10^23 is not a double; this is it rounded, as LLVM answers it.
    return libm_f64_from_bits(4950912855330343670u64) + x; // 0x1.52d02c7e14af6p76
  }
  let r_dd = libm_exp10_dd(x, s.kd, s.exp_mid);
  let err_dd = libm_f64_from_bits(4163577855504023552u64); // 0x1.8p-99
  let upper_dd = r_dd.hi + (r_dd.lo + err_dd);
  let lower_dd = r_dd.hi + (r_dd.lo - err_dd);
  if upper_dd == lower_dd {
    return libm_f64_scale(upper_dd, s.hi);
  }
  return libm_exp10_128(x, s.kd, s.idx1, s.idx2);
}

