/// `BIG_COEFFS` from `log2.h`: a degree-4 polynomial for `log2(1 + v)` with 128-bit precision.
const LIBM_LOG2_BIG_COEFFS : Tensor<u64, [16]> = [
1, 18446744073709551487, 13306513097845580259, 4525262841340935116,
0, 18446744073709551487, 17742017463792430025, 17165934893981060017,
