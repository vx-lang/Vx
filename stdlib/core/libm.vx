/// The number of zero bits below the lowest set bit; 64 for zero.
fn libm_u64_trailing_zeros(a : u64) -> u64 {
  if a == 0u64 {
    return 64u64;
  }
  let mut n : u64 = 0u64;
  let mut v = a;
  while (v & 1u64) == 0u64 {
    v = v >> 1u64;
    n = n + 1u64;
  }
  return n;
}

/// A 256-bit unsigned integer as four 64-bit words, `w0` the lowest: LLVM libc's `UInt<256>`.
struct LibmU256 {
  w0 : u64,
  w1 : u64,
  w2 : u64,
  w3 : u64,
}

impl Copy for LibmU256 {}

fn libm_u256(w0 : u64, w1 : u64, w2 : u64, w3 : u64) -> LibmU256 {
  return LibmU256 {
    w0: w0, w1: w1, w2: w2, w3: w3
  };
}

fn libm_u256_zero() -> LibmU256 {
  return libm_u256(0u64, 0u64, 0u64, 0u64);
}

fn libm_u256_is_zero(a : LibmU256) -> bool {
  return (a.w0 | a.w1 | a.w2 | a.w3) == 0u64;
}

/// Word `i` of `a`, 0 for `i` outside 0 to 3.
fn libm_u256_word(a : LibmU256, i : i64) -> u64 {
  if i == 0 {
    return a.w0;
  }
  if i == 1 {
    return a.w1;
  }
  if i == 2 {
    return a.w2;
  }
  if i == 3 {
    return a.w3;
  }
  return 0u64;
}

/// The sum of `a` and `b` and whether it carried out of the top word.
struct LibmU256Carry {
  v : LibmU256,
  carry : bool,
}

impl Copy for LibmU256Carry {}

fn libm_u256_add_carry(a : LibmU256, b : LibmU256) -> LibmU256Carry {
  let s0 = (a.w0 as u128) + (b.w0 as u128);
  let s1 = (a.w1 as u128) + (b.w1 as u128) + (s0 >> 64u128);
  let s2 = (a.w2 as u128) + (b.w2 as u128) + (s1 >> 64u128);
  let s3 = (a.w3 as u128) + (b.w3 as u128) + (s2 >> 64u128);
  return LibmU256Carry {
    v: libm_u256(s0 as u64, s1 as u64, s2 as u64, s3 as u64), carry: (s3 >> 64u128) != (0 as u128)
  };
}

/// `a + b`, wrapping.
fn libm_u256_add(a : LibmU256, b : LibmU256) -> LibmU256 {
  return libm_u256_add_carry(a, b).v;
}

/// `a - b`, wrapping.
fn libm_u256_sub(a : LibmU256, b : LibmU256) -> LibmU256 {
  let two64 : u128 = (1 as u128) << 64u128;
  let d0 = (a.w0 as u128) + two64 - (b.w0 as u128);
  let b0 : u128 = if d0 < two64 {
    1 as u128
  } else {
    0 as u128
  };
  let d1 = (a.w1 as u128) + two64 - (b.w1 as u128) - b0;
  let b1 : u128 = if d1 < two64 {
    1 as u128
  } else {
    0 as u128
  };
  let d2 = (a.w2 as u128) + two64 - (b.w2 as u128) - b1;
  let b2 : u128 = if d2 < two64 {
    1 as u128
  } else {
    0 as u128
  };
  let d3 = (a.w3 as u128) + two64 - (b.w3 as u128) - b2;
  return libm_u256(d0 as u64, d1 as u64, d2 as u64, d3 as u64);
}

/// Whether `a >= b`.
fn libm_u256_ge(a : LibmU256, b : LibmU256) -> bool {
  if a.w3 != b.w3 {
    return a.w3 > b.w3;
  }
  if a.w2 != b.w2 {
    return a.w2 > b.w2;
  }
  if a.w1 != b.w1 {
    return a.w1 > b.w1;
  }
  return a.w0 >= b.w0;
}

/// `a << s`; zero once `s` reaches 256.
fn libm_u256_shl(a : LibmU256, s : u64) -> LibmU256 {
  if s >= 256u64 {
    return libm_u256_zero();
  }
  let words = (s / 64u64) as i64;
  let bits = s % 64u64;
  let mut r = libm_u256_zero();
  let mut i : i64 = 3;
  while i >= 0 {
    let src = i - words;
    let mut w = libm_u256_word(a, src) << bits;
    if bits != 0u64 && src - 1 >= 0 {
      w = w | (libm_u256_word(a, src - 1) >> (64u64 - bits));
    }
    if src < 0 {
      w = 0u64;
    }
    if i == 0 {
      r.w0 = w;
    } else if i == 1 {
      r.w1 = w;
    } else if i == 2 {
      r.w2 = w;
    } else {
      r.w3 = w;
    }
    i = i - 1;
  }
  return r;
}

/// `a >> s`; zero once `s` reaches 256.
fn libm_u256_shr(a : LibmU256, s : u64) -> LibmU256 {
  if s >= 256u64 {
    return libm_u256_zero();
  }
  let words = (s / 64u64) as i64;
  let bits = s % 64u64;
  let mut r = libm_u256_zero();
  let mut i : i64 = 0;
  while i <= 3 {
    let src = i + words;
    let mut w = libm_u256_word(a, src) >> bits;
    if bits != 0u64 && src + 1 <= 3 {
      w = w | (libm_u256_word(a, src + 1) << (64u64 - bits));
    }
    if i == 0 {
      r.w0 = w;
    } else if i == 1 {
      r.w1 = w;
    } else if i == 2 {
      r.w2 = w;
    } else {
      r.w3 = w;
    }
    i = i + 1;
  }
  return r;
}

/// The number of zero bits above the highest set bit; 256 for zero.
fn libm_u256_leading_zeros(a : LibmU256) -> u64 {
  if a.w3 != 0u64 {
    return libm_u64_leading_zeros(a.w3);
  }
  if a.w2 != 0u64 {
    return 64u64 + libm_u64_leading_zeros(a.w2);
  }
  if a.w1 != 0u64 {
    return 128u64 + libm_u64_leading_zeros(a.w1);
  }
  if a.w0 != 0u64 {
    return 192u64 + libm_u64_leading_zeros(a.w0);
  }
  return 256u64;
}

/// Bit `p` of `a`, false for `p` past 255.
fn libm_u256_bit(a : LibmU256, p : u64) -> bool {
  if p >= 256u64 {
    return false;
  }
  return ((libm_u256_word(a, (p / 64u64) as i64) >> (p % 64u64)) & 1u64) != 0u64;
}

/// Whether any of the bits of `a` below bit `p` is set (all of them for `p` past 255).
fn libm_u256_any_below(a : LibmU256, p : u64) -> bool {
  if p >= 256u64 {
    return !libm_u256_is_zero(a);
  }
  return !libm_u256_is_zero(libm_u256_shl(a, 256u64 - p)) && p != 0u64;
}

/// The running two-word sum of `quick_mul_hi`, with the carries out of it counted.
struct LibmMulAcc {
  acc : u128,
  carry : u64,
}

impl Copy for LibmMulAcc {}

/// `acc + a * b`, counting a carry out of the two words: `mul_add_with_carry`.
fn libm_mul_acc_add(m : LibmMulAcc, a : u64, b : u64) -> LibmMulAcc {
  let p = (a as u128) * (b as u128);
  let s = m.acc + p;
  let c : u64 = if s < p {
    1u64
  } else {
    0u64
  };
  return LibmMulAcc {
    acc: s, carry: m.carry + c
  };
}

/// The accumulator moved down a word, with the carries as its new high word:
/// `Accumulator::advance`. Its old low word is the result's next word.
fn libm_mul_acc_advance(m : LibmMulAcc) -> LibmMulAcc {
  return LibmMulAcc {
    acc: (m.acc >> 64u128) | ((m.carry as u128) << 64u128), carry: 0u64
  };
}

/// The high 256 bits of `a * b`, without the products below the top half and the carries out of
/// them: `UInt<256>::quick_mul_hi`, at most 3 below the exact high half.
fn libm_u256_quick_mul_hi(a : LibmU256, b : LibmU256) -> LibmU256 {
  let mut m = LibmMulAcc {
    acc: 0 as u128, carry: 0u64
  };
  m = libm_mul_acc_add(m, a.w0, b.w3);
  m = libm_mul_acc_add(m, a.w1, b.w2);
  m = libm_mul_acc_add(m, a.w2, b.w1);
  m = libm_mul_acc_add(m, a.w3, b.w0);
  m = libm_mul_acc_advance(m);
  m = libm_mul_acc_add(m, a.w1, b.w3);
  m = libm_mul_acc_add(m, a.w2, b.w2);
  m = libm_mul_acc_add(m, a.w3, b.w1);
  let d0 = m.acc as u64;
  m = libm_mul_acc_advance(m);
  m = libm_mul_acc_add(m, a.w2, b.w3);
  m = libm_mul_acc_add(m, a.w3, b.w2);
  let d1 = m.acc as u64;
  m = libm_mul_acc_advance(m);
  m = libm_mul_acc_add(m, a.w3, b.w3);
  return libm_u256(d0, d1, m.acc as u64, (m.acc >> 64u128) as u64);
}

/// The high 128 bits of `a * b`, without the product of the low words: `UInt<128>::quick_mul_hi`.
fn libm_u128_quick_mul_hi(a : u128, b : u128) -> u128 {
  let a0 = a as u64;
  let a1 = (a >> 64u128) as u64;
  let b0 = b as u64;
  let b1 = (b >> 64u128) as u64;
  let mut m = LibmMulAcc {
    acc: 0 as u128, carry: 0u64
  };
  m = libm_mul_acc_add(m, a0, b1);
  m = libm_mul_acc_add(m, a1, b0);
  m = libm_mul_acc_advance(m);
  m = libm_mul_acc_add(m, a1, b1);
  return m.acc;
}

/// Entry `i` of a table of 128-bit fractions, low word first.
fn libm_frac128_at(t : i32, i : i64) -> u128 {
  if t == 0 {
    return ((LIBM_POW_LOG2_POLY_128[2 * i + 1] as u128) << 64u128) | (LIBM_POW_LOG2_POLY_128[2 * i] as u128);
  }
  return ((LIBM_POW_EXP2_POLY_128[2 * i + 1] as u128) << 64u128) | (LIBM_POW_EXP2_POLY_128[2 * i] as u128);
}

/// Entry `i` of a table of 256-bit fractions: 0 `LOG2_POLY_256`, 1 `EXP2_POLY_256`,
/// 2 `EXP2_MID_FRAC256`, 3 `LOG2_RD_FRAC256`.
fn libm_frac256_at(t : i32, i : i64) -> LibmU256 {
  if t == 0 {
    return libm_u256(LIBM_POW_LOG2_POLY_256[4 * i], LIBM_POW_LOG2_POLY_256[4 * i + 1], LIBM_POW_LOG2_POLY_256[4 * i + 2], LIBM_POW_LOG2_POLY_256[4 * i + 3]);
  }
  if t == 1 {
    return libm_u256(LIBM_POW_EXP2_POLY_256[4 * i], LIBM_POW_EXP2_POLY_256[4 * i + 1], LIBM_POW_EXP2_POLY_256[4 * i + 2], LIBM_POW_EXP2_POLY_256[4 * i + 3]);
  }
  if t == 2 {
    return libm_u256(LIBM_POW_EXP2_MID_256[4 * i], LIBM_POW_EXP2_MID_256[4 * i + 1], LIBM_POW_EXP2_MID_256[4 * i + 2], LIBM_POW_EXP2_MID_256[4 * i + 3]);
  }
  return libm_u256(LIBM_POW_LOG2_RD_256[4 * i], LIBM_POW_LOG2_RD_256[4 * i + 1], LIBM_POW_LOG2_RD_256[4 * i + 2], LIBM_POW_LOG2_RD_256[4 * i + 3]);
}

/// The top 128 bits of a 256-bit fraction: `to_frac128`.
fn libm_frac256_to_128(a : LibmU256) -> u128 {
  return ((a.w3 as u128) << 64u128) | (a.w2 as u128);
}

/// A 128-bit fraction as a dyadic float `2^exponent * m`, normalized.
fn libm_dyadic_from_u128(negative : bool, exponent : i32, m : u128) -> LibmDyadic128 {
  return libm_dyadic_normalize(LibmDyadic128 {
    negative: negative, exponent: exponent, hi: (m >> 64u128) as u64, lo: m as u64
  });
}

/// The mantissa of a 128-bit dyadic float as one integer.
fn libm_dyadic_mantissa(d : LibmDyadic128) -> u128 {
  return ((d.hi as u128) << 64u128) | (d.lo as u128);
}

/// `(-1)^negative * 2^exponent * m`, with `m` a 256-bit integer: LLVM libc's
/// `DyadicFloat<256>`, which the last pass of `pow` uses.
struct LibmDyadic256 {
  negative : bool,
  exponent : i32,
  m : LibmU256,
}

impl Copy for LibmDyadic256 {}

/// `d` with its mantissa's top bit moved to bit 255, and the exponent lowered to match.
fn libm_dyadic256_normalize(d : LibmDyadic256) -> LibmDyadic256 {
  if libm_u256_is_zero(d.m) {
    return d;
  }
  let s = libm_u256_leading_zeros(d.m);
  return LibmDyadic256 {
    negative: d.negative, exponent: d.exponent - (s as i32), m: libm_u256_shl(d.m, s)
  };
}

/// `x` exactly, normalized: the `DyadicFloat(double)` constructor.
fn libm_dyadic256_from_f64(x : f64) -> LibmDyadic256 {
  let d = libm_dyadic_from_f64(x);
  if d.hi == 0u64 && d.lo == 0u64 {
    // A zero keeps the exponent the constructor gives it at every width.
    return LibmDyadic256 {
      negative: d.negative, exponent: d.exponent, m: libm_u256_zero()
    };
  }
  return libm_dyadic256_normalize(LibmDyadic256 {
    negative: d.negative, exponent: d.exponent - 128, m: libm_u256(0u64, 0u64, d.lo, d.hi)
  });
}

/// `a + b`: `quick_add`.
fn libm_dyadic256_add(a0 : LibmDyadic256, b0 : LibmDyadic256) -> LibmDyadic256 {
  if libm_u256_is_zero(a0.m) {
    return b0;
  }
  if libm_u256_is_zero(b0.m) {
    return a0;
  }
  let mut a = a0;
  let mut b = b0;
  if a.exponent > b.exponent {
    b = LibmDyadic256 {
      negative: b.negative, exponent: a.exponent, m: libm_u256_shr(b.m, (a.exponent - b.exponent) as u64)
    };
  } else if b.exponent > a.exponent {
    a = LibmDyadic256 {
      negative: a.negative, exponent: b.exponent, m: libm_u256_shr(a.m, (b.exponent - a.exponent) as u64)
    };
  }
  if a.negative == b.negative {
    let s = libm_u256_add_carry(a.m, b.m);
    if s.carry {
      let mut m = libm_u256_shr(s.v, 1u64);
      m.w3 = m.w3 | 9223372036854775808u64; // 0x8000000000000000
      return LibmDyadic256 {
        negative: a.negative, exponent: a.exponent + 1, m: m
      };
    }
    return LibmDyadic256 {
      negative: a.negative, exponent: a.exponent, m: s.v
    };
  }
  if libm_u256_ge(a.m, b.m) {
    return libm_dyadic256_normalize(LibmDyadic256 {
      negative: a.negative, exponent: a.exponent, m: libm_u256_sub(a.m, b.m)
    });
  }
  return libm_dyadic256_normalize(LibmDyadic256 {
    negative: b.negative, exponent: b.exponent, m: libm_u256_sub(b.m, a.m)
  });
}

/// `a * b`: `quick_mul`, the mantissa from `quick_mul_hi`.
fn libm_dyadic256_mul(a : LibmDyadic256, b : LibmDyadic256) -> LibmDyadic256 {
  let negative = a.negative != b.negative;
  let mut exponent = a.exponent + b.exponent + 256;
  if libm_u256_is_zero(a.m) || libm_u256_is_zero(b.m) {
    return LibmDyadic256 {
      negative: negative, exponent: exponent, m: libm_u256_zero()
    };
  }
  let mut m = libm_u256_quick_mul_hi(a.m, b.m);
  if (m.w3 >> 63u64) == 0u64 {
    exponent = exponent - 1;
    m = libm_u256_shl(m, 1u64);
  }
  return LibmDyadic256 {
    negative: negative, exponent: exponent, m: m
  };
}

/// The nearest double to `d`, ties to even: `fast_as<double>` for 256 bits. The top 53 bits make
/// `d_hi`; the round and sticky bits below them are added with one FMA.
fn libm_dyadic256_to_f64(d : LibmDyadic256) -> f64 {
  let sign : u64 = if d.negative {
    9223372036854775808u64 // 0x8000000000000000
  } else {
    0u64
  };
  if libm_u256_is_zero(d.m) {
    return libm_f64_from_bits(sign);
  }
  let mut exp_hi = d.exponent + 255 + 1023;
  if exp_hi > 2046 {
    return 2.0 * libm_f64_from_bits(sign | 9214364837600034816u64); // 0x7fe0000000000000
  }
  let mut denorm = false;
  let mut shift : u64 = 203u64;
  if exp_hi <= 0 {
    denorm = true;
    shift = 203u64 + ((1 - exp_hi) as u64);
    exp_hi = 1023;
  }
  let exp_lo = exp_hi - 54;
  let m_hi = libm_u256_shr(d.m, shift).w0;
  let d_hi = libm_f64_from_bits(sign | ((exp_hi as u64) << 52u64) | (m_hi & 4503599627370495u64)); // 0x000fffffffffffff
  let round_bit = libm_u256_bit(d.m, shift - 1u64);
  let sticky_bit = libm_u256_any_below(d.m, shift - 1u64);
  let round_and_sticky : f64 = (if round_bit {
    2.0
  } else {
    0.0
  }) + (if sticky_bit {
    1.0
  } else {
    0.0
  });
  if exp_lo <= 0 {
    let scale = 1 - exp_lo;
    let up = libm_f64_from_bits(((1023 + scale) as u64) << 52u64);
    let down = libm_f64_from_bits(((1023 - scale) as u64) << 52u64);
    let d_lo = libm_f64_from_bits(sign | (((exp_lo + scale) as u64) << 52u64));
    return libm_multiply_add(d_lo, round_and_sticky, d_hi * up) * down;
  }
  let d_lo = libm_f64_from_bits(sign | ((exp_lo as u64) << 52u64));
  let r = libm_multiply_add(d_lo, round_and_sticky, d_hi);
  if denorm {
    return libm_f64_from_bits(libm_f64_to_bits(r) - ((exp_hi as u64) << 52u64));
  }
  return r;
}

/// Whether `x` is an odd integer: `is_odd_integer` from `pow_utils.h`.
fn libm_pow64_is_odd_integer(x : f64) -> bool {
  let x_u = libm_f64_to_bits(x);
  let x_e = (x_u >> 52u64) & 2047u64;
  let lsb = libm_u64_trailing_zeros(x_u | 9218868437227405312u64); // 0x7ff0000000000000
  return x_e + lsb == 1075u64;
}

/// Whether `x` is an integer: `is_integer` from `pow_utils.h`.
fn libm_pow64_is_integer(x : f64) -> bool {
  if x == 0.0 {
    return true;
  }
  let x_u = libm_f64_to_bits(x);
  let x_e = (x_u >> 52u64) & 2047u64;
  let lsb = libm_u64_trailing_zeros(x_u | 9218868437227405312u64); // 0x7ff0000000000000
  return x_e + lsb >= 1075u64;
}

/// Infinity or zero with the sign `negative`: `set_overflow` and `set_underflow` in
/// round-to-nearest.
fn libm_pow64_overflow(negative : bool) -> f64 {
  if negative {
    return libm_f64_from_bits(18442240474082181120u64); // 0xfff0000000000000
  }
  return libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
}

fn libm_pow64_underflow(negative : bool) -> f64 {
  if negative {
    return -0.0;
  }
  return 0.0;
}

/// `2^hi * (mid + lo)` rounded to a double that may be subnormal and of either sign, when `err`
/// is small enough to decide the rounding: `ziv_test_denorm` from `pow_utils.h`. The value is
/// scaled by 2^(hi + 1022) and 1 (or -1) is added, so it rounds at the place a subnormal would.
fn libm_pow64_ziv_denorm(hi : i32, mid : f64, lo : f64, err0 : f64, negative : bool) -> LibmZivResult {
  let mut err = err0;
  let exp_scale = libm_f64_from_bits(((hi + 2045) as u64) << 52u64);
  let mid_hi = mid * exp_scale;
  let lo_scaled = lo * exp_scale;
  let mut extra_factor : f64 = 0.0;
  // 1022 in the exponent field.
  let mut scale_down = 4602678819172646912u64; // 0x3FE0000000000000
  if negative {
    if (-1.0 - mid_hi) < lo_scaled {
      extra_factor = -1.0;
      scale_down = 4607182418800017408u64; // 0x3FF0000000000000
      err = err + libm_f64_from_bits(4372995238176751616u64); // 0x1.0p-52
    }
  } else {
    if (1.0 - mid_hi) > lo_scaled {
      extra_factor = 1.0;
      scale_down = 4607182418800017408u64; // 0x3FF0000000000000
      err = err + libm_f64_from_bits(4372995238176751616u64); // 0x1.0p-52
    }
  }
  let err_scaled = err * exp_scale;
  let upper = extra_factor + (mid_hi + (lo_scaled + err_scaled));
  let lower = extra_factor + (mid_hi + (lo_scaled - err_scaled));
  return LibmZivResult {
    ok: upper == lower, value: libm_f64_from_bits(libm_f64_to_bits(upper) - scale_down)
  };
}

/// What `pow` answers for the inputs `check_special_inputs` of `pow_utils.h` settles: x or y
/// with mostly zero mantissa bits, such as zeros, ones, powers of two and NaNs. `has` is false
/// when the general path must answer.
struct LibmMaybeF64 {
  has : bool,
  value : f64,
}

impl Copy for LibmMaybeF64 {}

fn libm_some_f64(v : f64) -> LibmMaybeF64 {
  return LibmMaybeF64 {
    has: true, value: v
  };
}

fn libm_none_f64() -> LibmMaybeF64 {
  return LibmMaybeF64 {
    has: false, value: 0.0
  };
}

/// Whether the bits of a double are a signaling NaN.
fn libm_f64_bits_is_snan(a : u64) -> bool {
  let abs = a & 9223372036854775807u64; // 0x7fffffffffffffff
  return abs > 9218868437227405312u64 && (abs & 2251799813685248u64) == 0u64; // 0x7ff0000000000000, 0x0008000000000000
}

fn libm_pow64_special(x : f64, y : f64) -> LibmMaybeF64 {
  let x_u = libm_f64_to_bits(x);
  let y_u = libm_f64_to_bits(y);
  let x_sign = (x_u >> 63u64) == 1u64;
  let y_sign = (y_u >> 63u64) == 1u64;
  let x_a = x_u & 9223372036854775807u64; // 0x7fffffffffffffff
  let y_a = y_u & 9223372036854775807u64; // 0x7fffffffffffffff
  if libm_f64_bits_is_snan(x_u) || libm_f64_bits_is_snan(y_u) {
    return libm_some_f64(libm_f64_from_bits(9221120237041090560u64)); // 0x7ff8000000000000
  }
  if x == 1.0 || y == 0.0 {
    return libm_some_f64(1.0);
  }
  if x == 0.0 {
    if y_a > 9218868437227405312u64 { // 0x7ff0000000000000
      return libm_some_f64(y);
    }
    if y_a == 9218868437227405312u64 { // 0x7ff0000000000000
      if y_sign {
        return libm_some_f64(libm_f64_from_bits(9218868437227405312u64)); // 0x7ff0000000000000
      }
      return libm_some_f64(0.0);
    }
    let out_is_neg = x_sign && libm_pow64_is_odd_integer(y);
    if y_sign {
      return libm_some_f64(libm_pow64_overflow(out_is_neg));
    }
    return libm_some_f64(libm_pow64_underflow(out_is_neg));
  }
  if y == 1.0 {
    return libm_some_f64(x);
  }
  if y == 2.0 {
    return libm_some_f64(x * x);
  }
  if y == 0.5 && !x_sign {
    return libm_some_f64(libm_sqrt_f64(x));
  }
  if x == 2.0 {
    return libm_some_f64(libm_exp2(y));
  }
  if x == 10.0 {
    return libm_some_f64(libm_exp10(y));
  }
  // x a positive normal power of two whose exponent is too.
  let x_biased = (x_u >> 52u64) & 2047u64;
  if !x_sign && x_biased != 0u64 && x_biased != 2047u64 && (x_u & 4503599627370495u64) == 0u64 && y_a > 4318532713074062601u64 && y_a < 4888456257178775634u64 { // 0x000fffffffffffff, 0x3bee829f39aef509, 0x43d74910d52d3052
    let e_x = (x_biased as i32) - 1023;
    let abs_e : i32 = if e_x > 0 {
      e_x
    } else {
      -e_x
    };
    if (abs_e & (abs_e - 1)) == 0 && abs_e != 0 {
      let hi = (e_x as f64) * y;
      if hi >= 1024.0 {
        return libm_some_f64(libm_pow64_overflow(false));
      }
      if hi < -1075.0 {
        return libm_some_f64(libm_pow64_underflow(false));
      }
      if hi >= -1022.0 {
        return libm_some_f64(libm_exp2(hi));
      }
    }
  }
  return libm_none_f64();
}

/// The state `pow` carries out of `check_exceptional_cases` in `pow_utils.h`: the answer when it
/// has one, else `x` and `y` (made positive, or moved in range), `x`'s exponent and mantissa (a
/// subnormal normalized), and the result's sign.
struct LibmPow64State {
  has : bool,
  value : f64,
  x : f64,
  y : f64,
  e_x : f64,
  x_mant : u64,
  is_neg : bool,
  sign_d : f64,
}

impl Copy for LibmPow64State {}

fn libm_pow64_exceptional(s0 : LibmPow64State) -> LibmPow64State {
  let mut s = s0;
  let x_u = libm_f64_to_bits(s.x);
  let y_u = libm_f64_to_bits(s.y);
  let x_sign = (x_u >> 63u64) == 1u64;
  let y_sign = (y_u >> 63u64) == 1u64;
  let x_a = x_u & 9223372036854775807u64; // 0x7fffffffffffffff
  let y_a = y_u & 9223372036854775807u64; // 0x7fffffffffffffff
  if libm_f64_bits_is_snan(x_u) || libm_f64_bits_is_snan(y_u) {
    s.has = true;
    s.value = libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
    return s;
  }
  if y_a > 4888456257178775634u64 { // 0x43d74910d52d3052
    if y_a >= 9218868437227405312u64 { // 0x7ff0000000000000
      s.has = true;
      if (y_u & 4503599627370495u64) != 0u64 { // 0x000fffffffffffff
        s.value = s.y;
      } else if x_a > 9218868437227405312u64 { // 0x7ff0000000000000
        s.value = s.x;
      } else if x_a == 4607182418800017408u64 { // 0x3ff0000000000000
        s.value = 1.0;
      } else if (x_a < 4607182418800017408u64) == y_sign { // 0x3ff0000000000000
        s.value = libm_f64_from_bits(9218868437227405312u64); // 0x7ff0000000000000
      } else {
        s.value = 0.0;
      }
      return s;
    }
    // |y| so large that only its sign matters.
    s.y = if y_sign {
      libm_f64_from_bits(14280914418391842816u64) // -0x1.0p100
    } else {
      libm_f64_from_bits(5057542381537067008u64) // 0x1.0p100
    };
  }
  if x_a == 9218868437227405312u64 { // 0x7ff0000000000000
    let out_is_neg = x_sign && libm_pow64_is_odd_integer(s.y);
    s.has = true;
    if y_sign {
      s.value = libm_pow64_underflow(out_is_neg);
    } else {
      s.value = libm_pow64_overflow(out_is_neg);
    }
    return s;
  }
  if x_a > 9218868437227405312u64 { // 0x7ff0000000000000
    s.has = true;
    s.value = s.x;
    return s;
  }
  if x_a < 4503599627370496u64 { // 0x0010000000000000
    // A subnormal x, normalized.
    let x_norm = libm_f64_to_bits(s.x * libm_f64_from_bits(4895412794951729152u64)); // 0x1.0p64
    s.e_x = ((((x_norm >> 52u64) & 2047u64) as i32) - 1023) as f64 - 64.0;
    s.x_mant = x_norm & 4503599627370495u64; // 0x000fffffffffffff
  }
  if x_sign {
    if libm_pow64_is_integer(s.y) {
      s.x = -s.x;
      if libm_pow64_is_odd_integer(s.y) {
        s.is_neg = true;
        s.sign_d = -1.0;
      }
    } else {
      s.has = true;
      s.value = libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
      return s;
    }
  }
  if y_a <= 4318532713074062601u64 { // 0x3bee829f39aef509
    // x^y rounds to 1.
    s.has = true;
    s.value = 1.0;
    return s;
  }
  return s;
}

/// The exact value of `x^y`, as `m * 2^e`, when it has one with at most 54 bits in `m`:
/// `is_exact_rounding_boundary` from `pow_utils.h`. Such a value can lie exactly halfway between
/// two doubles, which an error bound can never decide.
struct LibmPow64Exact {
  ok : bool,
  m : u64,
  e : i32,
}

impl Copy for LibmPow64Exact {}

fn libm_pow64_exact(x : f64, y : f64) -> LibmPow64Exact {
  let none = LibmPow64Exact {
    ok: false, m: 0u64, e: 0
  };
  let x_u = libm_f64_to_bits(x);
  let mut x_e : i32 = 0;
  let mut x_mant = x_u & 4503599627370495u64; // 0x000fffffffffffff
  if ((x_u >> 52u64) & 2047u64) == 0u64 {
    if x_mant != 0u64 {
      let shift = libm_u64_leading_zeros(x_mant) - 11u64;
      x_mant = (x_mant << shift) & 4503599627370495u64; // 0x000fffffffffffff
      x_e = -1022 - (shift as i32);
    }
  } else {
    x_e = (((x_u >> 52u64) & 2047u64) as i32) - 1023;
  }
  if x_mant == 0u64 {
    let ey = (x_e as f64) * y;
    if libm_pow64_is_integer(ey) {
      return LibmPow64Exact {
        ok: true, m: 1u64, e: ey as i32
      };
    }
    return none;
  }
  if y < 0.0 || y > 35.0 {
    return none;
  }
  let y_u = libm_f64_to_bits(y);
  let y_mant = (y_u & 4503599627370495u64) | 4503599627370496u64; // 0x000fffffffffffff, 0x0010000000000000
  let y_exp = (((y_u >> 52u64) & 2047u64) as i32) - 1023 - 52;
  let tz_y = libm_u64_trailing_zeros(y_mant);
  let n = y_mant >> tz_y;
  let f = y_exp + (tz_y as i32);
  if n > 35u64 || f < -5 {
    return none;
  }
  let full_x_mant = x_mant | 4503599627370496u64; // 0x0010000000000000
  let tz_x = libm_u64_trailing_zeros(full_x_mant);
  let m = full_x_mant >> tz_x;
  let e = x_e - 52 + (tz_x as i32);
  if f < 0 {
    let ey = (e as f64) * y;
    if !libm_pow64_is_integer(ey) {
      return none;
    }
    // m must be a perfect 2^-f-th power.
    let mut cur = m;
    let mut i : i32 = 0;
    while i < -f {
      let s = libm_sqrt_f64(cur as f64) as u64;
      if s * s != cur {
        return none;
      }
      cur = s;
      i = i + 1;
    }
    let mut res : u64 = 1u64;
    let mut j : u64 = 0u64;
    while j < n {
      if res > (1u64 << 54u64) / cur {
        return none;
      }
      res = res * cur;
      j = j + 1u64;
    }
    return LibmPow64Exact {
      ok: true, m: res, e: ey as i32
    };
  }
  let y_int = y as i32;
  let mut res : u64 = 1u64;
  let mut i : i32 = 0;
  while i < y_int {
    if res > (1u64 << 54u64) / m {
      return none;
    }
    res = res * m;
    i = i + 1;
  }
  return LibmPow64Exact {
    ok: true, m: res, e: e * y_int
  };
}

/// The exact value `m * 2^e` with the sign `negative`, rounded to a double.
fn libm_pow64_exact_to_f64(negative : bool, m : u64, e : i32) -> f64 {
  let l = 64u64 - libm_u64_leading_zeros(m);
  let d = libm_dyadic_from_u128(negative, e + (l as i32) - 128, (m as u128) << ((128u64 - l) as u128));
  return libm_dyadic_to_f64(d);
}

/// `log2(x)` in 128 bits from `x = 2^x_e * (1 + dx) / r`, with `-log2(r)` from row `idx_x`:
/// `log2_f128` from `pow_accurate_128.h`. `log2(1 + dx)` is a polynomial in fixed point,
/// evaluated in 64 bits for its top terms and in 128 bits for the rest.
fn libm_pow64_log2_f128(x_e : i32, idx_x : i64, dx : f64) -> LibmDyadic128 {
  let x_e_f128 = libm_dyadic_from_f64(x_e as f64);
  let log2_rd = libm_frac256_to_128(libm_frac256_at(3, idx_x));
  if dx == 0.0 {
    return libm_dyadic_add(x_e_f128, libm_dyadic_from_u128(false, -127, log2_rd));
  }
  let abs_dx : f64 = if dx < 0.0 {
    -dx
  } else {
    dx
  };
  let bits = libm_f64_to_bits(abs_dx);
  let mant = (bits & 4503599627370495u64) | 4503599627370496u64; // 0x000fffffffffffff, 0x0010000000000000
  let shift = 127 + ((((bits >> 52u64) & 2047u64) as i32) - 1023) - 52;
  let y : u128 = if shift >= 0 {
    (mant as u128) << (shift as u128)
  } else {
    0 as u128
  };
  let y64 = (y >> 64u128) as u64;
  let mut p64 = (libm_frac128_at(0, 15) >> 64u128) as u64;
  let mut k : i64 = 14;
  while k >= 8 {
    let c = (libm_frac128_at(0, k) >> 64u128) as u64;
    let t = libm_u64_mul_hi(p64, y64) << 1u64;
    if dx >= 0.0 {
      p64 = c - t;
    } else {
      p64 = c + t;
    }
    k = k - 1;
  }
  let mut p : u128 = (p64 as u128) << 64u128;
  k = 7;
  while k >= 0 {
    let t = libm_u128_quick_mul_hi(p, y) << 1u128;
    if dx >= 0.0 {
      p = libm_frac128_at(0, k) - t;
    } else {
      p = libm_frac128_at(0, k) + t;
    }
    k = k - 1;
  }
  let log2_1p = libm_u128_quick_mul_hi(y, p) << 2u128;
  let log2_m : u128 = if dx >= 0.0 {
    log2_rd + log2_1p
  } else {
    log2_rd - log2_1p
  };
  return libm_dyadic_add(x_e_f128, libm_dyadic_from_u128(false, -127, log2_m));
}

/// `2^z` in 128 bits: `exp2_f128` from `pow_accurate_128.h`. `z = hi + idx/64 + lo`; `2^(idx/64)`
/// comes from a table and `2^lo - 1` from a polynomial in fixed point.
fn libm_pow64_exp2_f128(z : LibmDyadic128) -> LibmDyadic128 {
  let z_d = libm_dyadic_to_f64(z);
  let kd = libm_round_even_f64(z_d * 64.0);
  let k = kd as i32;
  let mut hi = k >> 6;
  let idx = (k & 63) as i64;
  let mut kd_f128 = libm_dyadic_from_f64(kd * 0.015625);
  kd_f128.negative = !kd_f128.negative;
  let lo = libm_dyadic_add(z, kd_f128);
  let m = libm_frac256_to_128(libm_frac256_at(2, idx));
  if lo.hi == 0u64 && lo.lo == 0u64 {
    return libm_dyadic_from_u128(false, hi - 127, m);
  }
  let lo_is_neg = lo.negative;
  let shift = -127 - lo.exponent;
  let u : u128 = if shift < 128 {
    libm_dyadic_mantissa(lo) >> (shift as u128)
  } else {
    0 as u128
  };
  let u64v = (u >> 64u128) as u64;
  let mut p64 = (libm_frac128_at(1, 11) >> 64u128) as u64;
  let mut i : i64 = 10;
  while i >= 7 {
    let c = (libm_frac128_at(1, i) >> 64u128) as u64;
    let t = libm_u64_mul_hi(p64, u64v) << 1u64;
    if lo_is_neg {
      p64 = c - t;
    } else {
      p64 = c + t;
    }
    i = i - 1;
  }
  let mut p : u128 = (p64 as u128) << 64u128;
  i = 6;
  while i >= 0 {
    let t = libm_u128_quick_mul_hi(p, u) << 1u128;
    if lo_is_neg {
      p = libm_frac128_at(1, i) - t;
    } else {
      p = libm_frac128_at(1, i) + t;
    }
    i = i - 1;
  }
  let t = libm_u128_quick_mul_hi(u, p) << 1u128;
  let mt = libm_u128_quick_mul_hi(m, t) << 1u128;
  let mut m_final : u128 = if lo_is_neg {
    m - mt
  } else {
    m + mt
  };
  if (m_final >> 127u128) == (0 as u128) {
    m_final = m_final << 1u128;
    hi = hi - 1;
  }
  return libm_dyadic_from_u128(false, hi - 127, m_final);
}

/// `log2(x)` in 256 bits: `log2_f256` from `pow_accurate_256.h`, the same scheme as
/// `libm_pow64_log2_f128` with three precisions.
fn libm_pow64_log2_f256(x_e : i32, idx_x : i64, dx : f64) -> LibmDyadic256 {
  let x_e_f256 = libm_dyadic256_from_f64(x_e as f64);
  let log2_rd = libm_frac256_at(3, idx_x);
  if dx == 0.0 {
    return libm_dyadic256_add(x_e_f256, libm_dyadic256_normalize(LibmDyadic256 {
      negative: false, exponent: -255, m: log2_rd
    }));
  }
  let abs_dx : f64 = if dx < 0.0 {
    -dx
  } else {
    dx
  };
  let bits = libm_f64_to_bits(abs_dx);
  let mant = (bits & 4503599627370495u64) | 4503599627370496u64; // 0x000fffffffffffff, 0x0010000000000000
  let shift = 255 + ((((bits >> 52u64) & 2047u64) as i32) - 1023) - 52;
  let y : LibmU256 = if shift >= 0 {
    libm_u256_shl(libm_u256(mant, 0u64, 0u64, 0u64), shift as u64)
  } else {
    libm_u256_zero()
  };
  let y64 = y.w3;
  let mut p64 = libm_frac256_at(0, 30).w3;
  let mut k : i64 = 29;
  while k >= 18 {
    let c = libm_frac256_at(0, k).w3;
    let t = libm_u64_mul_hi(p64, y64) << 1u64;
    if dx >= 0.0 {
      p64 = c - t;
    } else {
      p64 = c + t;
    }
    k = k - 1;
  }
  let y128 = libm_frac256_to_128(y);
  let mut p128 : u128 = (p64 as u128) << 64u128;
  k = 17;
  while k >= 8 {
    let c = libm_frac256_to_128(libm_frac256_at(0, k));
    let t = libm_u128_quick_mul_hi(p128, y128) << 1u128;
    if dx >= 0.0 {
      p128 = c - t;
    } else {
      p128 = c + t;
    }
    k = k - 1;
  }
  let mut p = libm_u256(0u64, 0u64, p128 as u64, (p128 >> 64u128) as u64);
  k = 7;
  while k >= 0 {
    let t = libm_u256_shl(libm_u256_quick_mul_hi(p, y), 1u64);
    if dx >= 0.0 {
      p = libm_u256_sub(libm_frac256_at(0, k), t);
    } else {
      p = libm_u256_add(libm_frac256_at(0, k), t);
    }
    k = k - 1;
  }
  let log2_1p = libm_u256_shl(libm_u256_quick_mul_hi(y, p), 2u64);
  let log2_m : LibmU256 = if dx >= 0.0 {
    libm_u256_add(log2_rd, log2_1p)
  } else {
    libm_u256_sub(log2_rd, log2_1p)
  };
  return libm_dyadic256_add(x_e_f256, libm_dyadic256_normalize(LibmDyadic256 {
    negative: false, exponent: -255, m: log2_m
  }));
}

/// `2^z` in 256 bits: `exp2_f256` from `pow_accurate_256.h`.
fn libm_pow64_exp2_f256(z : LibmDyadic256) -> LibmDyadic256 {
  let z_d = libm_dyadic256_to_f64(z);
  let kd = libm_round_even_f64(z_d * 64.0);
  let k = kd as i32;
  let mut hi = k >> 6;
  let idx = (k & 63) as i64;
  let mut kd_f256 = libm_dyadic256_from_f64(kd * 0.015625);
  kd_f256.negative = !kd_f256.negative;
  let lo = libm_dyadic256_add(z, kd_f256);
  let m = libm_frac256_at(2, idx);
  if libm_u256_is_zero(lo.m) {
    return libm_dyadic256_normalize(LibmDyadic256 {
      negative: false, exponent: hi - 255, m: m
    });
  }
  let lo_is_neg = lo.negative;
  let shift = -255 - lo.exponent;
  let u : LibmU256 = if shift < 256 {
    libm_u256_shr(lo.m, shift as u64)
  } else {
    libm_u256_zero()
  };
  let u64v = u.w3;
  let mut p64 = libm_frac256_at(1, 21).w3;
  let mut i : i64 = 20;
  while i >= 12 {
    let c = libm_frac256_at(1, i).w3;
    let t = libm_u64_mul_hi(p64, u64v) << 1u64;
    if lo_is_neg {
      p64 = c - t;
    } else {
      p64 = c + t;
    }
    i = i - 1;
  }
  let u128v = libm_frac256_to_128(u);
  let mut p128 : u128 = (p64 as u128) << 64u128;
  i = 11;
  while i >= 6 {
    let c = libm_frac256_to_128(libm_frac256_at(1, i));
    let t = libm_u128_quick_mul_hi(p128, u128v) << 1u128;
    if lo_is_neg {
      p128 = c - t;
    } else {
      p128 = c + t;
    }
    i = i - 1;
  }
  let mut p = libm_u256(0u64, 0u64, p128 as u64, (p128 >> 64u128) as u64);
  i = 5;
  while i >= 0 {
    let t = libm_u256_shl(libm_u256_quick_mul_hi(p, u), 1u64);
    if lo_is_neg {
      p = libm_u256_sub(libm_frac256_at(1, i), t);
    } else {
      p = libm_u256_add(libm_frac256_at(1, i), t);
    }
    i = i - 1;
  }
  let t = libm_u256_shl(libm_u256_quick_mul_hi(u, p), 1u64);
  let mt = libm_u256_shl(libm_u256_quick_mul_hi(m, t), 1u64);
  let mut m_final : LibmU256 = if lo_is_neg {
    libm_u256_sub(m, mt)
  } else {
    libm_u256_add(m, mt)
  };
  if (m_final.w3 >> 63u64) == 0u64 {
    m_final = libm_u256_shl(m_final, 1u64);
    hi = hi - 1;
  }
  return libm_dyadic256_normalize(LibmDyadic256 {
    negative: false, exponent: hi - 255, m: m_final
  });
}

/// The last pass of `pow`, in 256 bits: `pow_accurate_256` from `pow_accurate_256.h`.
fn libm_pow64_accurate_256(y : f64, is_neg : bool, x_e : i32, idx_x : i64, dx : f64) -> f64 {
  let log2_x = libm_pow64_log2_f256(x_e, idx_x, dx);
  let z = libm_dyadic256_mul(libm_dyadic256_from_f64(y), log2_x);
  if !libm_u256_is_zero(z.m) && z.exponent + 255 <= -55 {
    // |z| < 2^-54: 2^z rounds to 1.
    if is_neg {
      return -1.0;
    }
    return 1.0;
  }
  let mut r = libm_pow64_exp2_f256(z);
  if is_neg {
    r.negative = true;
  }
  if r.exponent + 255 >= 1024 {
    return libm_pow64_overflow(is_neg);
  }
  let res = libm_dyadic256_to_f64(r);
  if (libm_f64_to_bits(res) & 9223372036854775807u64) == 9218868437227405312u64 { // 0x7fffffffffffffff, 0x7ff0000000000000
    return libm_pow64_overflow(is_neg);
  }
  return res;
}

/// The accurate pass of `pow`, in 128 bits: `pow_accurate` from `pow_accurate_128.h`. When the
/// result lands too near a rounding boundary to trust, it checks whether `x^y` is exactly a
/// boundary, and otherwise redoes it in 256 bits.
fn libm_pow64_accurate(x : f64, y : f64, is_neg : bool, x_e : i32, idx_x : i64, dx : f64) -> f64 {
  let log2_x = libm_pow64_log2_f128(x_e, idx_x, dx);
  let z = libm_dyadic_mul(libm_dyadic_from_f64(y), log2_x);
  let z_d = libm_dyadic_to_f64(z);
  if z_d >= 1025.0 {
    return libm_pow64_overflow(is_neg);
  }
  if z_d <= -1076.0 {
    return libm_pow64_underflow(is_neg);
  }
  if (z.hi != 0u64 || z.lo != 0u64) && z.exponent + 127 <= -55 {
    // |z| < 2^-54: 2^z rounds to 1.
    if is_neg {
      return -1.0;
    }
    return 1.0;
  }
  let mut r = libm_pow64_exp2_f128(z);
  if is_neg {
    r.negative = true;
  }
