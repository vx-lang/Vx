/// `(e^a + sign * e^-a) / 2` for `a` from 2^-6 to 711, from the double-double `e^a` of
/// `libm_exp_parts`: `2^(hi - 1) * (m + sign * 2^(-2 hi) / m)`, rounded once. When `2^(-2 hi)` is
/// below 2^-120 the second term cannot change the result and is left out.
fn libm_exp_half_sum(a : f64, sign : f64) -> f64 {
  let e = libm_exp_parts(a);
  let mut t = e.m;
  if e.hi < 60 {
    let inv = libm_dd_div(LibmDoubleDouble {
      hi: 1.0, lo: 0.0
