/// `v * 2^e` for a normal `v`, in two steps so that a result past the largest double overflows to
/// infinity instead of wrapping the exponent field.
fn libm_f64_ldexp(v : f64, e : i32) -> f64 {
  let e1 = e / 2;
  let e2 = e - e1;
  let f1 = libm_f64_from_bits(((1023 + e1) as u64) << 52u64);
  let f2 = libm_f64_from_bits(((1023 + e2) as u64) << 52u64);
  return v * f1 * f2;
