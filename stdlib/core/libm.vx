/// `x + x^3 (c + x^2 rest)` for a small `x`, with `c = c_hi + c_lo` a double-double and `x^3`
/// kept as a double-double, so that only `x^5 rest`, which is far below the last place, is rounded
/// on its own: the series of `sinh` and `tanh` below 1/64.
fn libm_odd_series_small(x : f64, c_hi : f64, c_lo : f64, rest : f64) -> f64 {
  let x2 = libm_dd_exact_mult(x, x);
