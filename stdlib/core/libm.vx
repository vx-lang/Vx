/// `COEFFS` from `cbrtf16.h`: the same in f32, degree 5, 5 coefficients per row at `[5 idx]`.
const LIBM_CBRTF16_COEFFS : Tensor<f32, [80]> = [
0.33333334, -0.111113206, 0.061846707, -0.0435785, 0.045315873,
0.33333322, -0.11110493, 0.061589535, -0.03959222, 0.021201836,
0.33333218, -0.111072555, 0.061208475, -0.037574753, 0.017147368,
0.3333282, -0.110988304, 0.0605381, -0.035190117, 0.013947661,
0.33331847, -0.11083373, 0.059612844, -0.032720592, 0.011467862,
0.33329996, -0.11059744, 0.058479197, -0.03029822, 0.009522762,
0.3332693, -0.11027061, 0.057171088, -0.027967818, 0.007963602,
0.33322397, -0.10985615, 0.055748492, -0.025795322, 0.0067181443,
