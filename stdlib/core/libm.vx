/// The accurate pass of `log2`: `log2_accurate` from `log2.h`, in 128-bit dyadic floats.
fn libm_log2_accurate(e_x : i32, index : i64, m_x : f64) -> f64 {
  let mut sum = libm_dyadic_from_f64(e_x as f64);
  sum = libm_dyadic_add(sum, libm_log_step(1, 1, index));
  let rr = libm_log_range_reduction(m_x, sum, 1);
  let c0 = libm_dyadic_from_parts(LIBM_LOG2_BIG_COEFFS[0], LIBM_LOG2_BIG_COEFFS[1], LIBM_LOG2_BIG_COEFFS[2], LIBM_LOG2_BIG_COEFFS[3]);
  let c1 = libm_dyadic_from_parts(LIBM_LOG2_BIG_COEFFS[4], LIBM_LOG2_BIG_COEFFS[5], LIBM_LOG2_BIG_COEFFS[6], LIBM_LOG2_BIG_COEFFS[7]);
  let c2 = libm_dyadic_from_parts(LIBM_LOG2_BIG_COEFFS[8], LIBM_LOG2_BIG_COEFFS[9], LIBM_LOG2_BIG_COEFFS[10], LIBM_LOG2_BIG_COEFFS[11]);
  let c3 = libm_dyadic_from_parts(LIBM_LOG2_BIG_COEFFS[12], LIBM_LOG2_BIG_COEFFS[13], LIBM_LOG2_BIG_COEFFS[14], LIBM_LOG2_BIG_COEFFS[15]);
  let mut p = libm_dyadic_mul(rr.v, c0);
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c1));
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c2));
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c3));
  return libm_dyadic_to_f64(libm_dyadic_add(rr.sum, p));
}

/// The logarithm to base 2 of a double, correctly rounded: `log2` from `log2.h`. The same
/// reduction as `libm_log`; the natural logarithm of the reduced argument is turned into base 2
/// by a double-double multiply by `log2(e)`.
fn libm_log2(x : f64) -> f64 {
  let mut x_u = libm_f64_to_bits(x);
  let mut x_e : i32 = -1023;
  // log2(1) = +0
  if x_u == 4607182418800017408u64 { // 0x3ff0000000000000
    return 0.0;
  }
  // Zero, negative, subnormal, infinity or NaN.
  if x_u < 4503599627370496u64 || x_u > 9218868437227405311u64 { // 0x0010000000000000, 0x7fefffffffffffff
    if x == 0.0 {
      return libm_f64_from_bits(18442240474082181120u64); // 0xfff0000000000000
    }
    if (x_u >> 63u64) == 1u64 && x == x {
      return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
    }
    if (x_u & 9218868437227405312u64) == 9218868437227405312u64 { // 0x7ff0000000000000, 0x7ff0000000000000
      return x;
    }
    // Normalize a subnormal.
    x_u = libm_f64_to_bits(x * libm_f64_from_bits(4841369599423283200u64)); // 0x1.0p52
    x_e = x_e - 52;
  }
  let index = ((x_u >> 45u64) & 127u64) as i64;
  let r = LIBM_COMMON_RD[index];
  // Add the unbiased exponent, plus 1 when the 8 leading fraction bits are all 1.
  x_e = x_e + ((x_u + 35184372088832u64) >> 52u64) as i32; // 1 << 45
  let e_x = x_e as f64;
  let m = libm_f64_from_bits((x_u & 4503599627370495u64) | 4607182418800017408u64); // 0x000fffffffffffff, 0x3ff0000000000000
  // Exact.
  let u = libm_multiply_add(r, m, -1.0);
  let r1 = libm_dd_exact_add(LIBM_LOG2_LOG_R1[2 * index + 1], u);
  let u_sq = u * u;
  let p0 = libm_multiply_add(u, libm_f64_from_bits(4599676419421063835u64), libm_f64_from_bits(13826050856027422719u64)); // 0x1.5555555554a9bp-2, -0x1.fffffffffffffp-2
  let p1 = libm_multiply_add(u, libm_f64_from_bits(4596373780821541436u64), libm_f64_from_bits(13821547256400659815u64)); // 0x1.99999dcc9823cp-3, -0x1.0000000094567p-2
  let p2 = libm_multiply_add(u, libm_f64_from_bits(4594263169067001047u64), libm_f64_from_bits(13818544836630696826u64)); // 0x1.21a02c4e624d7p-3, -0x1.55550ac2e537ap-3
  let p = libm_multiply_add(u_sq, libm_multiply_add(u_sq, libm_multiply_add(u_sq, p2, p1), p0), LIBM_LOG2_LOG_R1[2 * index]);
  let r1p = LibmDoubleDouble {
    hi: r1.hi, lo: r1.lo + p
  };
  // log2(e)
  let r2 = libm_dd_quick_mult(r1p, LibmDoubleDouble {
    hi: libm_f64_from_bits(4609176140021203710u64), lo: libm_f64_from_bits(4357082904033627428u64)
  }); // 0x1.71547652b82fep0, 0x1.777d0ffda0d24p-56
  let r3 = libm_dd_exact_add(e_x, r2.hi);
  let r3_lo = r3.lo + r2.lo;
  let err = u_sq * libm_f64_from_bits(4386506037058863104u64); // 0x1.0p-49
  let left = r3.hi + (r3_lo - err);
  let right = r3.hi + (r3_lo + err);
  if left == right {
    return left;
  }
  return libm_log2_accurate(x_e, index, u);
}

