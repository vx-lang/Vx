0.0, 0.5, 0.00000000000000000925185853854297, 0.16666666666666666,
0.0000000000000000023129646346357427, 0.041666666666666664, 0.00000000000000000011564823173178714, 0.008333333333333333,
-0.00000000000000000005300543954373577, 0.001388888888888889
];

