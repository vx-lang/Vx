  let y = s.y;
  let e_x = s.e_x;
  let x_mant = s.x_mant;
  let is_neg = s.is_neg;
  let sign_d = s.sign_d;
  let idx_x = (x_mant >> 45u64) as i64;
  let m_x = libm_f64_from_bits(x_mant | 4607182418800017408u64); // 0x3ff0000000000000
  // Exact.
  let dx = libm_multiply_add(LIBM_COMMON_RD[idx_x], m_x, -1.0);
