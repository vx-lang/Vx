  let log2_x_hi = libm_dd_exact_add(e_x + LIBM_POW_LOG2_R_DD[2 * idx_x + 1], log2_1p.hi);
  let log2_x_lo = log2_1p.lo + LIBM_POW_LOG2_R_DD[2 * idx_x];
  let mut log2_x = libm_dd_exact_add(log2_x_hi.hi, log2_x_lo);
