    return libm_odd_series_small(x, libm_f64_from_bits(13823048456275842389u64), libm_f64_from_bits(13579854076397835605u64), libm_multiply_add(x * x, libm_multiply_add(x * x, libm_multiply_add(x * x, libm_multiply_add(x * x, libm_f64_from_bits(4570429305847643616u64), libm_f64_from_bits(13799634966057239101u64)), libm_f64_from_bits(4581960672315445498u64)), libm_f64_from_bits(13811310502961330716u64)), libm_f64_from_bits(4593971859893063953u64))); // -0x1.5555555555555p-2, -0x1.5555555555555p-56, 0x1.d6d3d0e157de0p-9, -0x1.226e355e6c23dp-7, 0x1.664f4882c10fap-6, -0x1.ba1ba1ba1ba1cp-5, 0x1.1111111111111p-3
