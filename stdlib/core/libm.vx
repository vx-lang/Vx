/// `a + b` as a double-double, exactly, in either order of size (TwoSum): `exact_add<false>`.
fn libm_dd_two_sum(a : f64, b : f64) -> LibmDoubleDouble {
  let hi = a + b;
  let t1 = hi - a;
  let t2 = hi - t1;
  let t3 = b - t1;
  let t4 = a - t2;
  return LibmDoubleDouble {
    hi: hi, lo: t3 + t4
  };
}

/// `a * b` as a double-double, exactly: `exact_mult` with FMA.
fn libm_dd_exact_mult(a : f64, b : f64) -> LibmDoubleDouble {
  let hi = a * b;
  return LibmDoubleDouble {
    hi: hi, lo: libm_multiply_add(a, b, -hi)
  };
}

/// `a / b` as a double-double: `div` from `double_double.h`, one correction step on `a.hi / b.hi`.
fn libm_dd_div(a : LibmDoubleDouble, b : LibmDoubleDouble) -> LibmDoubleDouble {
  let q = 1.0 / b.hi;
  let hi = a.hi * q;
  let e_hi = libm_multiply_add(b.hi, -hi, a.hi);
  let e_lo = libm_multiply_add(b.lo, -hi, a.lo);
  return LibmDoubleDouble {
    hi: hi, lo: q * (e_hi + e_lo)
  };
}

/// The result of reducing `x` by multiples of pi/128: `x = k pi / 128 + u`, with `|u|` at most
/// about pi/256. For a large `x`, the pieces the 128-bit pass needs to redo the reduction.
struct LibmTrig64Reduced {
  k : i64,
  u : LibmDoubleDouble,
  idx : i64,
  x_reduced : f64,
  y_hi : f64,
  y_lo : f64,
  y_mid : LibmDoubleDouble,
}

impl Copy for LibmTrig64Reduced {}

/// Reduction for `|x| < 2^16`: `range_reduction_small` from `range_reduction_double_common.h`.
/// `k = round(x * 128/pi)` and `u = x - k pi/128`, with pi/128 in three parts whose first two
/// products with `k` are exact.
fn libm_trig64_reduce_small(x : f64) -> LibmTrig64Reduced {
  let kd = libm_round_even_f64(x * libm_f64_from_bits(4630930978448722051u64)); // 0x1.45f306dc9c883p5
  // Exact.
  let y_hi = libm_multiply_add(kd, libm_f64_from_bits(13806103496014954496u64), x); // -0x1.921fb544p-6
  let u_hi = libm_multiply_add(kd, libm_f64_from_bits(13650608799707299840u64), y_hi); // -0x1.0b4611a6p-40
  // Exact.
  let u0 = y_hi - u_hi;
  // Exact.
  let u1 = libm_multiply_add(kd, libm_f64_from_bits(13650608799707299840u64), u0); // -0x1.0b4611a6p-40
  let u_lo = libm_multiply_add(kd, libm_f64_from_bits(13493656989800296563u64), u1); // -0x1.3198a2e037073p-75
  return LibmTrig64Reduced {
    k: kd as i64, u: LibmDoubleDouble {
      hi: u_hi, lo: u_lo
    }, idx: 0, x_reduced: 0.0, y_hi: 0.0, y_lo: 0.0, y_mid: LibmDoubleDouble {
      hi: 0.0, lo: 0.0
    }
  };
}

/// `x` itself as `u`, with `k = 0`, for an `x` too small to need reducing.
fn libm_trig64_reduce_none(x : f64) -> LibmTrig64Reduced {
  return LibmTrig64Reduced {
    k: 0, u: LibmDoubleDouble {
      hi: x, lo: 0.0
    }, idx: 0, x_reduced: 0.0, y_hi: 0.0, y_lo: 0.0, y_mid: LibmDoubleDouble {
      hi: 0.0, lo: 0.0
    }
  };
}

/// Reduction for `|x| >= 2^16`: `LargeRangeReduction::fast` from `range_reduction_double_fma.h`.
/// `x` is split as `2^(16 (idx - 3)) * x_reduced`, and `x_reduced` is multiplied by the row of
/// 128/pi that starts where the integer part of the product stops mattering. The fractional
/// part, times pi/128, is `u`.
fn libm_trig64_reduce_large(x : f64) -> LibmTrig64Reduced {
  let x_u = libm_f64_to_bits(x);
  let x_e_m62 = (((x_u >> 52u64) & 2047u64) as i32) - (1023 + 62);
  let idx = ((x_e_m62 >> 4) + 3) as i64;
  let x_reduced = libm_f64_from_bits((x_u & 9227875636482146303u64) | ((((x_e_m62 & 15) + 1023 + 62) as u64) << 52u64)); // 0x800fffffffffffff
  let ph = libm_dd_exact_mult(x_reduced, LIBM_TRIG64_128_OVER_PI[4 * idx]);
  let pm = libm_dd_exact_mult(x_reduced, LIBM_TRIG64_128_OVER_PI[4 * idx + 1]);
  let pl = libm_dd_exact_mult(x_reduced, LIBM_TRIG64_128_OVER_PI[4 * idx + 2]);
  let kd = libm_round_even_f64(ph.lo + pm.hi);
  // Exact.
  let y_hi = (ph.lo - kd) + pm.hi;
  let y_mid = libm_dd_exact_add(pm.lo, pl.hi);
  let y_lo = pl.lo;
  let y_l = libm_multiply_add(x_reduced, LIBM_TRIG64_128_OVER_PI[4 * idx + 3], y_lo);
  let mut y = libm_dd_exact_add(y_hi, y_mid.hi);
  y.lo = y.lo + (y_mid.lo + y_l);
  let pi_over_128 = LibmDoubleDouble {
    hi: libm_f64_from_bits(4582731459160452376u64), lo: libm_f64_from_bits(4337430599130438663u64) // 0x1.921fb54442d18p-6, 0x1.1a62633145c07p-60
  };
  return LibmTrig64Reduced {
    k: kd as i64, u: libm_dd_quick_mult(y, pi_over_128), idx: idx, x_reduced: x_reduced, y_hi: y_hi, y_lo: y_lo, y_mid: y_mid
  };
}

/// pi/128 in 128 bits.
fn libm_trig64_pi_over_128_f128() -> LibmDyadic128 {
  return LibmDyadic128 {
    negative: false, exponent: -133, hi: 14488038916154245684u64, lo: 14179128828124470481u64 // 0xc90fdaa22168c234, 0xc4c6628b80dc1cd1
  };
}

/// `u` in 128 bits for the accurate pass: `range_reduction_small_f128` for `|x| < 2^16`, else
/// `LargeRangeReduction::accurate` from the pieces `libm_trig64_reduce_large` kept.
fn libm_trig64_reduce_f128(x : f64, r : LibmTrig64Reduced) -> LibmDyadic128 {
  let x_e = ((libm_f64_to_bits(x) >> 52u64) & 2047u64) as i32;
  if x_e < 1023 + 16 {
    let kd = libm_round_even_f64(x * libm_f64_from_bits(4630930978448722051u64)); // 0x1.45f306dc9c883p5
    let x_f128 = libm_dyadic_from_f64(x);
    let p_hi = libm_dyadic_mul(x_f128, libm_dyadic_from_f64(LIBM_TRIG64_128_OVER_PI[12]));
    let p_mid = libm_dyadic_mul(x_f128, libm_dyadic_from_f64(LIBM_TRIG64_128_OVER_PI[13]));
    let p_lo = libm_dyadic_mul(x_f128, libm_dyadic_from_f64(LIBM_TRIG64_128_OVER_PI[14]));
    let s_hi = libm_dyadic_add(p_hi, libm_dyadic_from_f64(-kd));
    let s_lo = libm_dyadic_add(p_mid, p_lo);
    return libm_dyadic_mul(libm_dyadic_add(s_hi, s_lo), libm_trig64_pi_over_128_f128());
  }
  let y_lo_0 = libm_dyadic_from_f64(r.x_reduced * LIBM_TRIG64_128_OVER_PI[4 * r.idx + 3]);
  let y_lo_1 = libm_dyadic_add(libm_dyadic_from_f64(r.y_lo), y_lo_0);
  let y_mid = libm_dyadic_add(libm_dyadic_from_f64(r.y_mid.lo), y_lo_1);
  let y_hi = libm_dyadic_add(libm_dyadic_from_f64(r.y_hi), libm_dyadic_from_f64(r.y_mid.hi));
  return libm_dyadic_mul(libm_dyadic_add(y_hi, y_mid), libm_trig64_pi_over_128_f128());
}

/// `sin(k pi / 128)` as a double-double, for any integer `k`.
fn libm_trig64_sin_k(k : i64) -> LibmDoubleDouble {
  let i = k & 255;
  return LibmDoubleDouble {
    hi: LIBM_TRIG64_SIN_K_PI_OVER_128[2 * i + 1], lo: LIBM_TRIG64_SIN_K_PI_OVER_128[2 * i]
  };
}

/// `sin(k pi / 128)` in 128 bits, for any integer `k`, from the table of the first quarter turn.
fn libm_trig64_sin_k_f128(k : i64) -> LibmDyadic128 {
  let mut i = k & 63;
  if (k & 64) != 0 {
    i = 64 - (k & 63);
  }
  let mut r = libm_dyadic_from_parts(LIBM_TRIG64_SIN_K_PI_OVER_128_F128[4 * i], LIBM_TRIG64_SIN_K_PI_OVER_128_F128[4 * i + 1], LIBM_TRIG64_SIN_K_PI_OVER_128_F128[4 * i + 2], LIBM_TRIG64_SIN_K_PI_OVER_128_F128[4 * i + 3]);
  if (k & 128) != 0 {
    r.negative = true;
  }
  return r;
}

/// The 128-bit polynomial `which` (0 `sin(u) / u`, 1 `cos(u)`, 2 `tan(u) / u`) at `u_sq = u^2`,
/// by Horner's rule: `polyeval`.
fn libm_trig64_poly_f128(which : i32, u_sq : LibmDyadic128) -> LibmDyadic128 {
  let mut n : i64 = 7;
  if which == 2 {
    n = 9;
  }
  let mut p = libm_trig64_coeff_f128(which, n - 1);
  let mut i = n - 2;
  while i >= 0 {
    p = libm_dyadic_add(libm_trig64_coeff_f128(which, i), libm_dyadic_mul(u_sq, p));
    i = i - 1;
  }
  return p;
}

/// Coefficient `i` of the 128-bit polynomial `which` of `libm_trig64_poly_f128`.
fn libm_trig64_coeff_f128(which : i32, i : i64) -> LibmDyadic128 {
  if which == 0 {
    return libm_dyadic_from_parts(LIBM_TRIG64_SIN_COEFFS[4 * i], LIBM_TRIG64_SIN_COEFFS[4 * i + 1], LIBM_TRIG64_SIN_COEFFS[4 * i + 2], LIBM_TRIG64_SIN_COEFFS[4 * i + 3]);
  }
  if which == 1 {
    return libm_dyadic_from_parts(LIBM_TRIG64_COS_COEFFS[4 * i], LIBM_TRIG64_COS_COEFFS[4 * i + 1], LIBM_TRIG64_COS_COEFFS[4 * i + 2], LIBM_TRIG64_COS_COEFFS[4 * i + 3]);
  }
  return libm_dyadic_from_parts(LIBM_TRIG64_TAN_COEFFS[4 * i], LIBM_TRIG64_TAN_COEFFS[4 * i + 1], LIBM_TRIG64_TAN_COEFFS[4 * i + 2], LIBM_TRIG64_TAN_COEFFS[4 * i + 3]);
}

/// `sin(u)` and `cos(u)` as double-doubles, and the bound on their error: `sincos_eval` from
/// `sincos_eval.h`, Taylor polynomials in `u.hi` with `u.lo` added to first order.
struct LibmSinCos {
  sin_u : LibmDoubleDouble,
  cos_u : LibmDoubleDouble,
  err : f64,
}

impl Copy for LibmSinCos {}

fn libm_trig64_sincos_eval(u : LibmDoubleDouble) -> LibmSinCos {
  let u_hi_sq = u.hi * u.hi;
  let p1 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(13774824197408792602u64), libm_f64_from_bits(4575957461383581969u64)); // -0x1.a01a01a01a01ap-13, 0x1.1111111111111p-7
  let q1 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(4586165620538955093u64), -0.5); // 0x1.5555555555555p-5
  let u_hi_3 = u_hi_sq * u.hi;
  let p2 = libm_multiply_add(u_hi_sq, p1, libm_f64_from_bits(13818544856648471893u64)); // -0x1.5555555555555p-3
  let q2 = libm_multiply_add(u_hi_sq, q1, 1.0);
  let sin_lo = libm_multiply_add(u_hi_3, p2, u.lo * q2);
  let u_hi_neg_half = -0.5 * u.hi;
  // v = 1 - u.hi^2 / 2 as a double-double.
  let v_hi = libm_multiply_add(u.hi, u_hi_neg_half, 1.0);
  // Exact.
  let v_lo0 = 1.0 - v_hi;
  let v_lo = libm_multiply_add(u.hi, u_hi_neg_half, v_lo0);
  let r1 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(4537941361671905306u64), libm_f64_from_bits(13787419979223755799u64)); // 0x1.a01a01a01a01ap-16, -0x1.6c16c16c16c17p-10
  let s1 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(4595172819793696085u64), -1.0); // 0x1.5555555555555p-3
  let u_hi_4 = u_hi_sq * u_hi_sq;
  let u_hi_u_lo = u.hi * u.lo;
  let r2 = libm_multiply_add(u_hi_sq, r1, libm_f64_from_bits(4586165620538955093u64)); // 0x1.5555555555555p-5
  let s2 = libm_multiply_add(u_hi_u_lo, s1, v_lo);
  let cos_lo = libm_multiply_add(u_hi_4, r2, s2);
  let abs_u_hi_3 = libm_f64_from_bits(libm_f64_to_bits(u_hi_3) & 9223372036854775807u64); // 0x7fffffffffffffff
  return LibmSinCos {
    sin_u: libm_dd_exact_add(u.hi, sin_lo), cos_u: libm_dd_exact_add(v_hi, cos_lo), err: libm_multiply_add(abs_u_hi_3, libm_f64_from_bits(4377498837804122112u64), libm_f64_from_bits(4134304457926115328u64)) // 0x1.0p-51, 0x1.0p-105
  };
}

/// What `sin`, `cos` and `tan` answer for infinities and NaNs: a NaN, quiet.
fn libm_trig64_nan(x : f64) -> f64 {
  let x_u = libm_f64_to_bits(x);
  // A signaling NaN gives the default quiet NaN.
  if (x_u & 9221120237041090560u64) == 9218868437227405312u64 && (x_u & 4503599627370495u64) != 0u64 { // 0x7ff8000000000000, 0x7ff0000000000000, 0x000fffffffffffff
    return libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
  }
  return x + libm_f64_from_bits(9221120237041090560u64); // 0x7ff8000000000000
}

/// The 128-bit pass of `sin`: `sin_accurate` from `sin.h`. `sin(k pi/128 + u) = sin(k pi/128)
/// cos(u) + cos(k pi/128) sin(u)`.
fn libm_sin_accurate(x : f64, r : LibmTrig64Reduced) -> f64 {
  let u = libm_trig64_reduce_f128(x, r);
  let u_sq = libm_dyadic_mul(u, u);
  let sin_u = libm_dyadic_mul(u, libm_trig64_poly_f128(0, u_sq));
  let cos_u = libm_trig64_poly_f128(1, u_sq);
  let s = libm_dyadic_add(libm_dyadic_mul(libm_trig64_sin_k_f128(r.k), cos_u), libm_dyadic_mul(libm_trig64_sin_k_f128(r.k + 64), sin_u));
  return libm_dyadic_to_f64(s);
}

/// The sine of a double, correctly rounded: `sin` from `sin.h`. `x = k pi/128 + u`; the sine and
/// cosine of `k pi/128` come from a table and those of `u` from short polynomials. When the
/// error bound does not decide the rounding, the result is computed again in 128 bits.
fn libm_sin(x : f64) -> f64 {
  let x_e = ((libm_f64_to_bits(x) >> 52u64) & 2047u64) as i32;
  let mut r = libm_trig64_reduce_small(0.0);
  if x_e < 1023 + 16 {
    if x_e < 1023 - 4 {
      // |x| < 2^-26: sin(x) rounds like x - x * 2^-54.
      if x_e < 1023 - 26 {
        if x == 0.0 {
          return x + x;
        }
        return libm_multiply_add(x, libm_f64_from_bits(13587360075776786432u64), x); // -0x1.0p-54
      }
      // |x| < 2^-4: a degree-9 polynomial.
      let x_sq = x * x;
      let c0 = libm_multiply_add(x_sq, libm_f64_from_bits(4575957461383574673u64), libm_f64_from_bits(13818544856648471893u64)); // 0x1.111111110f491p-7, -0x1.5555555555555p-3
      let c1 = libm_multiply_add(x_sq, libm_f64_from_bits(4523615292252691375u64), libm_f64_from_bits(13774824197208846142u64)); // 0x1.71c24233f1bafp-19, -0x1.a01a00e16af3ep-13
      let x4 = x_sq * x_sq;
      let x3 = x * x_sq;
      let r_lo = libm_multiply_add(x4, c1, c0) * x3;
      let err = libm_multiply_add(x_sq, libm_f64_from_bits(4372995238176751616u64), libm_f64_from_bits(4300937644138823680u64)); // 0x1.0p-52, 0x1.0p-68
      let r_upper = x + libm_multiply_add(x, err, r_lo);
      let r_lower = x + libm_multiply_add(-x, err, r_lo);
      if r_upper == r_lower {
        return r_upper;
      }
      return libm_sin_accurate(x, libm_trig64_reduce_small(x));
    }
    r = libm_trig64_reduce_small(x);
  } else {
    if x_e > 2046 {
      return libm_trig64_nan(x);
    }
    r = libm_trig64_reduce_large(x);
  }
  let sc = libm_trig64_sincos_eval(r.u);
  let sin_k = libm_trig64_sin_k(r.k);
  let cos_k = libm_trig64_sin_k(r.k + 64);
  let sin_k_cos_y = libm_dd_quick_mult(sc.cos_u, sin_k);
  let cos_k_sin_y = libm_dd_quick_mult(sc.sin_u, cos_k);
  let mut rr = libm_dd_exact_add(sin_k_cos_y.hi, cos_k_sin_y.hi);
  rr.lo = rr.lo + (sin_k_cos_y.lo + cos_k_sin_y.lo);
  let r_upper = rr.hi + (rr.lo + sc.err);
  let r_lower = rr.hi + (rr.lo - sc.err);
  if r_upper == r_lower {
    return r_upper;
  }
  return libm_sin_accurate(x, r);
}

/// The 128-bit pass of `cos`: `cos_accurate` from `cos.h`. `cos(k pi/128 + u) = cos(k pi/128)
/// cos(u) - sin(k pi/128) sin(u)`.
fn libm_cos_accurate(x : f64, r : LibmTrig64Reduced) -> f64 {
  let u = libm_trig64_reduce_f128(x, r);
  let u_sq = libm_dyadic_mul(u, u);
  let sin_u = libm_dyadic_mul(u, libm_trig64_poly_f128(0, u_sq));
  let cos_u = libm_trig64_poly_f128(1, u_sq);
  let c = libm_dyadic_add(libm_dyadic_mul(libm_trig64_sin_k_f128(r.k + 64), cos_u), libm_dyadic_mul(libm_trig64_sin_k_f128(r.k + 128), sin_u));
  return libm_dyadic_to_f64(c);
}

/// The cosine of a double, correctly rounded: `cos` from `cos.h`, the same scheme as `libm_sin`.
fn libm_cos(x : f64) -> f64 {
  let x_e = ((libm_f64_to_bits(x) >> 52u64) & 2047u64) as i32;
  let mut r = libm_trig64_reduce_small(0.0);
  if x_e < 1023 + 16 {
    if x_e < 1023 - 4 {
      // |x| < 2^-27: cos(x) rounds to 1.
      if x_e < 1023 - 27 {
        return 1.0;
      }
      // |x| < 2^-4: a degree-8 polynomial.
      let x_sq = x * x;
      let c0 = libm_multiply_add(x_sq, libm_f64_from_bits(4586165620538954338u64), -0.5); // 0x1.5555555555262p-5
      let c1 = libm_multiply_add(x_sq, libm_f64_from_bits(4537940673359844762u64), libm_f64_from_bits(13787419979194875889u64)); // 0x1.a00ffd769159ap-16, -0x1.6c16c1508bff1p-10
      let x4 = x_sq * x_sq;
      let r_lo = libm_multiply_add(x4, c1, c0) * x_sq;
      let err = libm_multiply_add(x_sq, libm_f64_from_bits(4377498837804122112u64), libm_f64_from_bits(4296434044511453184u64)); // 0x1.0p-51, 0x1.0p-69
      let r_upper = 1.0 + (r_lo + err);
      let r_lower = 1.0 + (r_lo - err);
      if r_upper == r_lower {
        return r_upper;
      }
      return libm_cos_accurate(x, libm_trig64_reduce_small(x));
    }
    r = libm_trig64_reduce_small(x);
  } else {
    if x_e > 2046 {
      return libm_trig64_nan(x);
    }
    r = libm_trig64_reduce_large(x);
  }
  let sc = libm_trig64_sincos_eval(r.u);
  let msin_k = libm_trig64_sin_k(r.k + 128);
  let cos_k = libm_trig64_sin_k(r.k + 64);
  let cos_k_cos_y = libm_dd_quick_mult(sc.cos_u, cos_k);
  let msin_k_sin_y = libm_dd_quick_mult(sc.sin_u, msin_k);
  let mut rr = libm_dd_exact_add(cos_k_cos_y.hi, msin_k_sin_y.hi);
  rr.lo = rr.lo + (msin_k_sin_y.lo + cos_k_cos_y.lo);
  let r_upper = rr.hi + (rr.lo + sc.err);
  let r_lower = rr.hi + (rr.lo - sc.err);
  if r_upper == r_lower {
    return r_upper;
  }
  return libm_cos_accurate(x, r);
}

/// `a / b` in 128 bits, from the first guess `q` of `1 / b`: two Newton-Raphson steps,
/// `newton_raphson_div` from `tan.h`.
fn libm_dyadic_div_newton(a : LibmDyadic128, b0 : LibmDyadic128, q : f64) -> LibmDyadic128 {
  let q0 = libm_dyadic_from_f64(q);
  let two = libm_dyadic_from_f64(2.0);
  let mut b = b0;
  b.negative = !b.negative;
  let q1 = libm_dyadic_mul(q0, libm_dyadic_add(two, libm_dyadic_mul(b, q0)));
  let q2 = libm_dyadic_mul(q1, libm_dyadic_add(two, libm_dyadic_mul(b, q1)));
  return libm_dyadic_mul(a, q2);
}

/// The tangent of a double, correctly rounded: `tan` from `tan.h`. `x = k pi/128 + u`, and
/// `tan(x) = (sin(k pi/128) + cos(k pi/128) tan(u)) / (cos(k pi/128) - sin(k pi/128) tan(u))`,
/// with `tan(u)` a short polynomial and the division done in double-doubles. When the error
/// bound does not decide the rounding, the result is computed again in 128 bits.
fn libm_tan(x : f64) -> f64 {
  let x_e = ((libm_f64_to_bits(x) >> 52u64) & 2047u64) as i32;
  let mut r = libm_trig64_reduce_small(0.0);
  if x_e < 1023 + 16 {
    if x_e < 1023 - 7 {
      // |x| < 2^-27: tan(x) rounds like x + x * 2^-54.
      if x_e < 1023 - 27 {
        if x == 0.0 {
          return x + x;
        }
        return libm_multiply_add(x, libm_f64_from_bits(4363988038922010624u64), x); // 0x1.0p-54
      }
      // |x| < 2^-7: no reduction.
      r = libm_trig64_reduce_none(x);
    } else {
      r = libm_trig64_reduce_small(x);
    }
  } else {
    if x_e > 2046 {
      return libm_trig64_nan(x);
    }
    r = libm_trig64_reduce_large(x);
  }
  // tan(u) as a double-double, and its error bound.
  let u = r.u;
  let u_hi_sq = u.hi * u.hi;
  let p1 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(4581960672315445498u64), libm_f64_from_bits(4587938466106554908u64)); // 0x1.664f4882c10fap-6, 0x1.ba1ba1ba1ba1cp-5
  let p2 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(4593971859893063953u64), libm_f64_from_bits(4599676419421066581u64)); // 0x1.1111111111111p-3, 0x1.5555555555555p-2
  let q1 = libm_multiply_add(u_hi_sq, libm_f64_from_bits(4604180019048437077u64), 1.0); // 0x1.5555555555555p-1
  let u_hi_3 = u_hi_sq * u.hi;
  let u_hi_4 = u_hi_sq * u_hi_sq;
  let p3 = libm_multiply_add(u_hi_4, p1, p2);
  let q2 = libm_multiply_add(u_hi_sq, q1, 1.0);
  let tan_lo = libm_multiply_add(u_hi_3, p3, u.lo * q2);
  let tan_y = libm_dd_exact_add(u.hi, tan_lo);
  let abs_u_hi_3 = libm_f64_from_bits(libm_f64_to_bits(u_hi_3) & 9223372036854775807u64); // 0x7fffffffffffffff
  let err = libm_multiply_add(abs_u_hi_3, libm_f64_from_bits(4377498837804122112u64), libm_f64_from_bits(4147815256808226816u64)); // 0x1.0p-51, 0x1.0p-102
  let msin_k = libm_trig64_sin_k(r.k + 128);
  let cos_k = libm_trig64_sin_k(r.k + 64);
  let cos_k_tan_y = libm_dd_quick_mult(tan_y, cos_k);
  let msin_k_tan_y = libm_dd_quick_mult(tan_y, msin_k);
  let mut num_dd = libm_dd_two_sum(cos_k_tan_y.hi, -msin_k.hi);
  let mut den_dd = libm_dd_two_sum(msin_k_tan_y.hi, cos_k.hi);
  num_dd.lo = num_dd.lo + (cos_k_tan_y.lo - msin_k.lo);
  den_dd.lo = den_dd.lo + (msin_k_tan_y.lo + cos_k.lo);
  let tan_x = libm_dd_div(num_dd, den_dd);
  // A power of two near 1 / |den_dd.hi|, which scales the error bound by the division.
  let den_inv = libm_f64_from_bits(9223372036854775808u64 - (libm_f64_to_bits(den_dd.hi) & 9218868437227405312u64)); // 0x8000000000000000, 0x7ff0000000000000
  let abs_tan_hi = libm_f64_from_bits(libm_f64_to_bits(tan_x.hi) & 9223372036854775807u64); // 0x7fffffffffffffff
  let tan_err = err * libm_multiply_add(den_inv, abs_tan_hi, 1.0);
  let tan_upper = tan_x.hi + (tan_x.lo + tan_err);
  let tan_lower = tan_x.hi + (tan_x.lo - tan_err);
  if tan_upper == tan_lower {
    return tan_upper;
  }
  // The 128-bit pass.
  let u_f128 = libm_trig64_reduce_f128(x, r);
  let tan_u = libm_dyadic_mul(u_f128, libm_trig64_poly_f128(2, libm_dyadic_mul(u_f128, u_f128)));
  let num_f128 = libm_dyadic_add(libm_trig64_sin_k_f128(r.k), libm_dyadic_mul(libm_trig64_sin_k_f128(r.k + 64), tan_u));
  let den_f128 = libm_dyadic_add(libm_trig64_sin_k_f128(r.k + 64), libm_dyadic_mul(libm_trig64_sin_k_f128(r.k + 128), tan_u));
  return libm_dyadic_to_f64(libm_dyadic_div_newton(num_f128, den_f128, 1.0 / den_dd.hi));
}

