2.117000016612675, 2.13360385352902, 2.1503379159523, 2.1672032252538247,
2.184200810815618, 2.2013317100932475, 2.218596968679145, 2.2359976403664263,
2.2535347872132085, 2.2712094796074336, 2.289022796332201, 2.3069758246316097,
2.325069660277121, 2.3433054076344373, 2.3616841797309096, 2.3802070983234693,
2.398875293967098, 2.417689906083828, 2.4366520830322917, 2.455762982177808,
2.475023769963025, 2.4944356219791146, 2.5139997230375233, 2.53371726724229,
2.553589458062927, 2.5736175084078754, 2.593802640698535, 2.6141460869438746,
2.6346490888156313, 2.655312897724092, 2.676138774894477, 2.6971279914439186
];

/// `EXP_2_MID` from `exp10f_utils.h`: the bits of `2^(i / 32)` for `i` from 0 to 31.
const LIBM_EXP_2_MID : Tensor<i64, [32]> = [
4607182418800017408, 4607281034790536564, 4607381810190059791, 4607484792283487057,
4607590029391122811, 4607697570891348394, 4607807467243790904, 4607919770012999393,
4608034531892639509, 4608151806730217931, 4608271649552348194, 4608394116590569773,
4608519265307732519, 4608647154424958850, 4608777843949196329, 4608911395201373573,
4609047870845172685, 4609187334916431732, 4609329852853191047, 4609475491526397459,
4609624319271280859, 4609776405919417829, 4609931822831497360, 4610090642930804061,
4610252940737434541, 4610418792403263047, 4610588275747672732, 4610761470294069353,
4610938457307194503, 4611119319831255903, 4611304142728892634, 4611493012720993600
];

/// `exp(x)`, correctly rounded: `expf` from `expf_double_eval.h`. With `x = hi + mid + lo`,
/// `hi` an integer and `mid` a multiple of 1/128, it is `exp(hi) * exp(mid) * exp(lo)`: two
/// tables and a degree-4 polynomial (Sollya: `fpminimax(expm1(x)/x, 3, [|D...|], [-2^-8, 2^-8])`).
fn libm_expf(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  // An input where the evaluation below would round the wrong way.
  if x_u == 3258367372u32 { // 0xc236bd8c
    return libm_f32_from_bits(512247084u32) - x * libm_f32_from_bits(268435456u32); // 0x1.108a58p-66f, 0x1.0p-95f
  }
  // |x| >= 89, |x| <= 2^-25, or NaN.
  if x_abs >= 1118961664u32 || x_abs <= 847249408u32 { // 0x42b20000, 0x32800000
    // |x| < 2^-25
    if ((x_u >> 23u32) & 255u32) <= 101u32 {
      return 1.0 + x;
    }
    // x < log(2^-150), or NaN.
    if x_u >= 3268407733u32 { // 0xc2cff1b5
      if x_abs == 2139095040u32 { // 0x7f800000
        return 0.0;
      }
      if x_abs > 2139095040u32 { // 0x7f800000
        return x;
      }
      return 0.0;
    }
    // x >= 89 or NaN: infinity, or the NaN.
    if (x_u >> 31u32) == 0u32 && x_u >= 1118961664u32 { // 0x42b20000
      return x + libm_f32_from_bits(2139095040u32); // 0x7f800000
    }
  }
  let kf = libm_round_even_f32(x * 128.0);
  // lo = x - (hi + mid), exactly.
  let xd = libm_multiply_add_f32(kf, -0.0078125, x) as f64;
  let x_hi = (kf as i32) + 13312;
  let exp_hi = LIBM_EXP_M1[(x_hi >> 7) as i64];
  let exp_mid = LIBM_EXP_M2[(x_hi & 127) as i64];
  let exp_lo = libm_multiply_add(xd, libm_multiply_add(xd, libm_multiply_add(xd, libm_multiply_add(xd, libm_f64_from_bits(4586165620539585091u64), libm_f64_from_bits(4595172824375158247u64)), libm_f64_from_bits(4602678819172648732u64)), libm_f64_from_bits(4607182418800015223u64)), 1.0); // 0x1.55555555ef243p-5, 0x1.555566668e5e7p-3, 0x1.000000000071cp-1, 0x1.ffffffffff777p-1
  return (exp_hi * exp_mid * exp_lo) as f32;
}

/// `2^x`, correctly rounded: `exp2f` from `exp2f_double_eval.h`. Near zero a degree-6
/// polynomial; otherwise `2^x = 2^hi * 2^mid * 2^lo` with `mid` a multiple of 1/32, `2^hi`
/// added straight into the exponent of `2^mid` from a table, and `2^lo` a degree-5 polynomial.
fn libm_exp2f(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  // |x| >= 128, NaN, or |x| <= 2^-5.
  if x_abs >= 1124073472u32 || x_abs <= 1023410176u32 { // 0x43000000, 0x3d000000
    if x_abs <= 1023410176u32 { // 0x3d000000
      // |x| < 2^-25
      if x_abs <= 847249408u32 { // 0x32800000
        return 1.0 + x;
      }
      // Inputs where the evaluation below would round the wrong way.
      if x_u == 994221367u32 { // 0x3b429d37
        return libm_f32_from_bits(1065370501u32); // 0x1.00870ap+0f
      }
      if x_u == 3170085175u32 { // 0xbcf3a937
        return libm_f32_from_bits(1065010865u32); // 0x1.f58d62p-1f
      }
      // Sollya: fpminimax((2^x - 1)/x, 5, [|D...|], [-2^-5, 2^-5])
      let xd = x as f64;
      let xsq = xd * xd;
      let c0 = libm_multiply_add(xd, libm_f64_from_bits(4597823092348339579u64), libm_f64_from_bits(4604418534313441779u64)); // 0x1.ebfbdff82c57bp-3, 0x1.62e42fefa39f3p-1
      let c1 = libm_multiply_add(xd, libm_f64_from_bits(4576698095723163485u64), libm_f64_from_bits(4588159806093842346u64)); // 0x1.3b2ab6fc92f5dp-7, 0x1.c6b08d6f2d7aap-5
      let c2 = libm_multiply_add(xd, libm_f64_from_bits(4549814922445220593u64), libm_f64_from_bits(4563791943949250853u64)); // 0x1.43090e61e6af1p-13, 0x1.5d897cfe27125p-10
      let p = libm_multiply_add(xsq, libm_multiply_add(xsq, c2, c1), c0);
      return libm_multiply_add(p, xd, 1.0) as f32;
    }
    // x >= 128: infinity, or the NaN.
    if (x_u >> 31u32) == 0u32 {
      return x + libm_f32_from_bits(2139095040u32); // 0x7f800000
    }
    // x <= -150
    if x_u >= 3272998912u32 { // 0xc3160000
      if x_abs == 2139095040u32 { // 0x7f800000
        return 0.0;
      }
      if x_abs > 2139095040u32 { // 0x7f800000
        return x;
      }
      return 0.0;
    }
  }
  let kf = libm_round_even_f32(x * 32.0);
  let k = kf as i32;
  // lo = x - (hi + mid), exactly.
  let dx = libm_multiply_add_f32(-0.03125, kf, x) as f64;
  // 2^hi * 2^mid, by adding hi to the exponent of 2^mid.
  let exp_hi = ((k >> 5) as i64) << 52;
  let mh = libm_f64_from_bits((LIBM_EXP_2_MID[(k & 31) as i64] + exp_hi) as u64);
  // Sollya: fpminimax((2^x - 1)/x, 5, [|D...|], [-1/32, 1/32])
  let dx_sq = dx * dx;
  let c1 = libm_multiply_add(dx, libm_f64_from_bits(4604418534313441775u64), 1.0); // 0x1.62e42fefa39efp-1
  let c2 = libm_multiply_add(dx, libm_f64_from_bits(4588159806095103637u64), libm_f64_from_bits(4597823092348236228u64)); // 0x1.c6b08d7061695p-5, 0x1.ebfbdff8131c4p-3
  let c3 = libm_multiply_add(dx, libm_f64_from_bits(4563791844111648041u64), libm_f64_from_bits(4576698122820340522u64)); // 0x1.5d88091198529p-10, 0x1.3b2b1bee74b2ap-7
  let p = libm_multiply_add(dx_sq, c3, c2);
  return libm_multiply_add(p, dx_sq * mh, c1 * mh) as f32;
}

/// `exp(x) - 1`, correctly rounded: `expm1f` from `expm1f.h`. Near zero a polynomial; otherwise
/// `expf`'s reduction with the final step `exp(hi + mid) * exp(lo) - 1` as one FMA.
fn libm_expm1f(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  // An input where the evaluation below would round the wrong way.
  if x_u == 1043709637u32 { // 0x3e35bec5
    return libm_f32_from_bits(1044832050u32); // 0x1.8dbe64p-3f
  }
  // |x| >= 0x1.1542p+4
  if x_abs >= 1099604259u32 { // 0x418aa123
    if (x_u >> 31u32) == 1u32 {
      // NaN stays NaN; any other x this negative gives -1.
      if x_abs > 2139095040u32 { // 0x7f800000
        return x;
      }
      return -1.0;
    }
    // x >= 89: infinity, or the NaN.
    if x_u >= 1118961664u32 { // 0x42b20000
      return x + libm_f32_from_bits(2139095040u32); // 0x7f800000
    }
  }
  // |x| < 2^-4
  if x_abs < 1031798784u32 { // 0x3d800000
    // |x| < 2^-25
    if x_abs < 855638016u32 { // 0x33000000
      if x_u == 2147483648u32 { // 0x80000000
        return x;
      }
      return libm_multiply_add_f32(x, x, x);
    }
    let xd = x as f64;
    let xsq = xd * xd;
    let c0 = libm_multiply_add(xd, libm_f64_from_bits(4595172819793696733u64), 0.5); // 0x1.55555555557ddp-3
    let c1 = libm_multiply_add(xd, libm_f64_from_bits(4575957461362366647u64), libm_f64_from_bits(4586165620538954490u64)); // 0x1.111110fcd58b7p-7, 0x1.55555555552fap-5
    let c2 = libm_multiply_add(xd, libm_f64_from_bits(4551452855633997154u64), libm_f64_from_bits(4564047942374614539u64)); // 0x1.a0241f0006d62p-13, 0x1.6c16c1717660bp-10
    let r = libm_multiply_add(xsq, libm_multiply_add(xsq, libm_multiply_add(xsq, libm_f64_from_bits(4537941653173026912u64), c2), c1), c0); // 0x1.a01e3f8d3c06p-16
    return libm_multiply_add(r, xsq, xd) as f32;
  }
  let kf = libm_round_even_f32(x * 128.0);
  let x_hi = (kf as i32) + 13312;
  // lo = x - (hi + mid), exactly.
  let xd = libm_multiply_add_f32(kf, -0.0078125, x) as f64;
  let exp_hi_mid = LIBM_EXP_M1[(x_hi >> 7) as i64] * LIBM_EXP_M2[(x_hi & 127) as i64];
  let exp_lo = libm_multiply_add(xd, libm_multiply_add(xd, libm_multiply_add(xd, libm_multiply_add(xd, libm_f64_from_bits(4586165620539585091u64), libm_f64_from_bits(4595172824375158247u64)), libm_f64_from_bits(4602678819172648732u64)), libm_f64_from_bits(4607182418800015223u64)), 1.0); // 0x1.55555555ef243p-5, 0x1.555566668e5e7p-3, 0x1.000000000071cp-1, 0x1.ffffffffff777p-1
  return libm_multiply_add(exp_hi_mid, exp_lo, -1.0) as f32;
}

// f16 and bf16 versions of the f32 functions above: the f32 result, correctly rounded, rounded
// once more to the narrower format. That second rounding is wrong only when the f32 result sits
// exactly on a halfway point of the narrow format; checking every one of the 65,536 inputs
// against the function computed to 120 digits finds those inputs, and each function lists them.

fn libm_expf16(x : f16) -> f16 {
  // x = 0x1.de4p-8
  if libm_f16_to_bits(x) == 8057u16 {
    return libm_f16_from_bits(15367u16); // 0x1.01cp+0
  }
  // x = 0x1.73cp-6
  if libm_f16_to_bits(x) == 9679u16 {
    return libm_f16_from_bits(15383u16); // 0x1.05cp+0
  }
  return libm_expf(x as f32) as f16;
}

fn libm_exp2f16(x : f16) -> f16 {
  // x = 0x1.714p-11
  if libm_f16_to_bits(x) == 4549u16 {
    return libm_f16_from_bits(15361u16); // 0x1.004p+0
  }
  return libm_exp2f(x as f32) as f16;
}

fn libm_expm1f16(x : f16) -> f16 {
  // x = 0x1.6ap-11
  if libm_f16_to_bits(x) == 4520u16 {
    return libm_f16_from_bits(4521u16); // 0x1.6a4p-11
  }
  return libm_expm1f(x as f32) as f16;
}

fn libm_exp_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_expf(libm_f32_from_bf16(x)));
}

fn libm_exp2_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_exp2f(libm_f32_from_bf16(x)));
}

fn libm_expm1_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_expm1f(libm_f32_from_bf16(x)));
}

/// `sinh(x)` (`is_sinh`) or `cosh(x)` of an f32, before rounding: `exp_pm_eval` from
/// `sinhfcoshf_utils.h`. With `x = (hi + mid) * log(2) + lo`, `mid` a multiple of 1/32, `e^x`
/// and `e^-x` share one reduction: `2^(hi + mid)` and `2^-(hi + mid)` from `EXP_2_MID`, and the
/// even and odd halves of a degree-5 polynomial for `e^lo` and `e^-lo`.
fn libm_exp_pm_eval(x : f32, is_sinh : bool) -> f64 {
  let xd = x as f64;
  // k = round(x * log2(e) * 2^5)
  let kd = libm_round_even_f64(libm_f64_from_bits(4631694138158056190u64) * xd); // 0x1.71547652b82fep+5
  let k_p = kd as i32;
  let k_m = -k_p;
  let exp_hi_p = ((k_p >> 5) as i64) << 52;
  let exp_hi_m = ((k_m >> 5) as i64) << 52;
  let mh_p = libm_f64_from_bits((LIBM_EXP_2_MID[(k_p & 31) as i64] + exp_hi_p) as u64);
  let mh_m = libm_f64_from_bits((LIBM_EXP_2_MID[(k_m & 31) as i64] + exp_hi_m) as u64);
  let mh_sum = mh_p + mh_m;
  let mh_diff = mh_p - mh_m;
  // lo = x - (hi + mid) * log(2), with log(2) / 32 in two parts.
  let dx = libm_multiply_add(kd, libm_f64_from_bits(13631542416105159482u64), libm_multiply_add(kd, libm_f64_from_bits(13805272573031350272u64), xd)); // -0x1.cf79abc9e3b3ap-45, -0x1.62e42fefa0000p-6
  let dx2 = dx * dx;
  let p_even = libm_multiply_add(dx2, libm_multiply_add(dx2, libm_f64_from_bits(4581662050259519668u64), libm_f64_from_bits(4598175219545168840u64)), 0.5); // 0x1.5555c2a9b48b4p-6, 0x1.ffffffffe5bc8p-3
  let p_odd = libm_multiply_add(dx2, libm_multiply_add(dx2, libm_f64_from_bits(4571453868464098267u64), libm_f64_from_bits(4590669220166356327u64)), 0.5); // 0x1.11112a0e34bdbp-8, 0x1.555555555cd67p-4
  if is_sinh {
    return libm_multiply_add(dx * mh_sum, p_odd, p_even * mh_diff);
  }
  return libm_multiply_add(dx * mh_diff, p_odd, p_even * mh_sum);
}

/// `x` rounded to the nearest integer, ties to even, in double precision.
fn libm_round_even_f64(x : f64) -> f64 {
  return mlir!( inputs : (%x = x : f64), returns : f64, dialects : ["math"]) {
    %r = math.roundeven %x : f64
    macro.yield %r : f64
  };
}

/// The hyperbolic sine, correctly rounded: `sinhf` from `sinhf.h`. Near zero a polynomial;
/// otherwise `libm_exp_pm_eval`.
fn libm_sinhf(x : f32) -> f32 {
  let x_abs = libm_f32_to_bits(x) & 2147483647u32; // 0x7fffffff
  // |x| >= 90, NaN, or |x| <= 0.078125
  if x_abs >= 1119092736u32 || x_abs <= 1033895936u32 { // 0x42b40000, 0x3da00000
    if x_abs <= 1033895936u32 { // 0x3da00000
      // An input where the polynomial below would round the wrong way.
      if x_abs == 974292479u32 { // 0x3a1285ff
        return x;
      }
      let xdbl = x as f64;
      // |x| <= 2^-26
      if x_abs <= 847249408u32 { // 0x32800000
        if x_abs == 0u32 {
          return x;
        }
        return libm_multiply_add(0.25 * xdbl * xdbl, xdbl, xdbl) as f32;
      }
      let x2 = xdbl * xdbl;
      let pe = libm_multiply_add(x2, libm_multiply_add(x2, libm_multiply_add(x2, libm_f64_from_bits(4551453352550203708u64), libm_f64_from_bits(4575957461317689119u64)), libm_f64_from_bits(4595172819793700227u64)), 0.0); // 0x1.a02b5a284013cp-13, 0x1.111110d239f1fp-7, 0x1.5555555556583p-3
      return libm_multiply_add(xdbl, pe, xdbl) as f32;
    }
    // NaN: quiet.
    if x_abs > 2139095040u32 { // 0x7f800000
      return x + 1.0;
    }
    // Infinity, or overflow to it.
    if x_abs == 2139095040u32 { // 0x7f800000
      return x;
    }
    return x + libm_f32_from_bits((libm_f32_to_bits(x) & 2147483648u32) | 2139095040u32); // 0x80000000, 0x7f800000
  }
  return libm_exp_pm_eval(x, true) as f32;
}

/// The hyperbolic cosine, correctly rounded: `coshf` from `coshf.h`.
fn libm_coshf(x0 : f32) -> f32 {
  let x_u = libm_f32_to_bits(x0) & 2147483647u32; // 0x7fffffff
  let x = libm_f32_from_bits(x_u);
  // |x| >= 90, NaN, or |x| <= 2^-26
  if x_u >= 1119092736u32 || x_u <= 847249408u32 { // 0x42b40000, 0x32800000
    if x_u <= 847249408u32 { // 0x32800000
      return 1.0 + x;
    }
    return x + libm_f32_from_bits(2139095040u32); // 0x7f800000
  }
  return libm_exp_pm_eval(x, false) as f32;
}

/// The hyperbolic tangent, correctly rounded: `tanhf` from `tanhf.h`. Near zero a Taylor
/// polynomial; otherwise `(e^2x - 1) / (e^2x + 1)` written as `(r - mh) / (r + mh)` with
/// `mh = 2^-(hi + mid)` and `r` a polynomial for `e^2lo`.
fn libm_tanhf(x : f32) -> f32 {
  let x_abs = libm_f32_to_bits(x) & 2147483647u32; // 0x7fffffff
  // |x| >= 15, NaN, or |x| <= 0.078125
  if x_abs >= 1097859072u32 || x_abs <= 1033895936u32 { // 0x41700000, 0x3da00000
    if x_abs <= 1033895936u32 { // 0x3da00000
      let xdbl = x as f64;
      // |x| <= 2^-26
      if x_abs <= 847249408u32 { // 0x32800000
        if x_abs == 0u32 {
          return x;
        }
        return libm_multiply_add(-(libm_f64_from_bits(4599676419421066581u64) * xdbl * xdbl), xdbl, xdbl) as f32; // 0x1.5555555555555p-2
      }
      let x2 = xdbl * xdbl;
      let x4 = x2 * x2;
      let c0 = x2 * libm_f64_from_bits(13823048456275842389u64); // -0x1.5555555555555p-2
      let c1 = libm_multiply_add(x2, libm_f64_from_bits(13811310502961330716u64), libm_f64_from_bits(4593971859893063953u64)); // -0x1.ba1ba1ba1ba1cp-5, 0x1.1111111111111p-3
      let c2 = libm_multiply_add(x2, libm_f64_from_bits(13799634966057239101u64), libm_f64_from_bits(4581960672315445498u64)); // -0x1.226e355e6c23dp-7, 0x1.664f4882c10fap-6
      let pe = libm_multiply_add(x4, libm_multiply_add(x4, c2, c1), c0);
      return libm_multiply_add(xdbl, pe, xdbl) as f32;
    }
    // NaN: quiet.
    if x_abs > 2139095040u32 { // 0x7f800000
      return x + 1.0;
    }
    if (libm_f32_to_bits(x) >> 31u32) == 1u32 {
      return -1.0;
    }
    return 1.0;
  }
  let xd = x as f64;
  let k = libm_round_even_f64(xd * libm_f64_from_bits(4636197737785426686u64)); // 0x1.71547652b82fep+6
  let mk = -(k as i32);
  let exp_mhi = ((mk >> 5) as i64) << 52;
  let mh = libm_f64_from_bits((LIBM_EXP_2_MID[(mk & 31) as i64] + exp_mhi) as u64);
  let dx = libm_multiply_add(k, libm_f64_from_bits(13627038816477788986u64), libm_multiply_add(k, libm_f64_from_bits(13800768973403979776u64), xd)); // -0x1.cf79abc9e3b3ap-46, -0x1.62e42fefa0000p-7
  let dx2 = dx * dx;
  let c0 = libm_multiply_add(dx, 2.0, 1.0);
  let c1 = libm_multiply_add(dx, libm_f64_from_bits(4608683618675838311u64), libm_f64_from_bits(4611686018427280328u64)); // 0x1.555555555cd67p0, 0x1.ffffffffe5bc8p0
  let c2 = libm_multiply_add(dx, libm_f64_from_bits(4598475466228321243u64), libm_f64_from_bits(4604180048396372148u64)); // 0x1.11112a0e34bdbp-2, 0x1.5555c2a9b48b4p-1
  let r = libm_multiply_add(dx2, libm_multiply_add(dx2, c2, c1), c0);
  return ((r - mh) / (r + mh)) as f32;
}

fn libm_sinhf16(x : f16) -> f16 {
  // x = 0x1.3c8p+1
  if libm_f16_to_bits(x) == 16626u16 {
    return libm_f16_from_bits(17891u16); // 0x1.78cp+2
  }
  // x = -0x1.3c8p+1
  if libm_f16_to_bits(x) == 49394u16 {
    return libm_f16_from_bits(50659u16); // -0x1.78cp+2
  }
  return libm_sinhf(x as f32) as f16;
}

fn libm_coshf16(x : f16) -> f16 {
  // x = 0x1.0p-5
  if libm_f16_to_bits(x) == 10240u16 {
    return libm_f16_from_bits(15361u16); // 0x1.004p+0
  }
  // x = -0x1.0p-5
  if libm_f16_to_bits(x) == 43008u16 {
    return libm_f16_from_bits(15361u16); // 0x1.004p+0
  }
  return libm_coshf(x as f32) as f16;
}

fn libm_tanhf16(x : f16) -> f16 {
  return libm_tanhf(x as f32) as f16;
}

fn libm_sinh_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_sinhf(libm_f32_from_bf16(x)));
}

fn libm_cosh_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_coshf(libm_f32_from_bf16(x)));
}

fn libm_tanh_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_tanhf(libm_f32_from_bf16(x)));
}

