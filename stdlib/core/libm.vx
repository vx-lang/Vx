/// The accurate pass of `log10`: `log10_accurate` from `log10.h`, in 128-bit dyadic floats.
fn libm_log10_accurate(e_x : i32, index : i64, m_x : f64) -> f64 {
  // log10(2) with 128-bit precision.
  let log10_2 = LibmDyadic128 {
    negative: false, exponent: -129, hi: 11106046577046714264u64, lo: 10342896614695014776u64
  }; // 0x9a209a84fbcff798, 0x8f8959ac0b7c9178
  let mut sum = libm_dyadic_mul(log10_2, libm_dyadic_from_f64(e_x as f64));
  sum = libm_dyadic_add(sum, libm_log_step(2, 1, index));
  let rr = libm_log_range_reduction(m_x, sum, 2);
  let c0 = libm_dyadic_from_parts(LIBM_LOG10_BIG_COEFFS[0], LIBM_LOG10_BIG_COEFFS[1], LIBM_LOG10_BIG_COEFFS[2], LIBM_LOG10_BIG_COEFFS[3]);
  let c1 = libm_dyadic_from_parts(LIBM_LOG10_BIG_COEFFS[4], LIBM_LOG10_BIG_COEFFS[5], LIBM_LOG10_BIG_COEFFS[6], LIBM_LOG10_BIG_COEFFS[7]);
  let c2 = libm_dyadic_from_parts(LIBM_LOG10_BIG_COEFFS[8], LIBM_LOG10_BIG_COEFFS[9], LIBM_LOG10_BIG_COEFFS[10], LIBM_LOG10_BIG_COEFFS[11]);
  let c3 = libm_dyadic_from_parts(LIBM_LOG10_BIG_COEFFS[12], LIBM_LOG10_BIG_COEFFS[13], LIBM_LOG10_BIG_COEFFS[14], LIBM_LOG10_BIG_COEFFS[15]);
  let mut p = libm_dyadic_mul(rr.v, c0);
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c1));
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c2));
  p = libm_dyadic_mul(rr.v, libm_dyadic_add(p, c3));
  return libm_dyadic_to_f64(libm_dyadic_add(rr.sum, p));
}

/// The logarithm to base 10 of a double, correctly rounded: `log10` from `log10.h`. The same
/// reduction as `libm_log`, turned into base 10 by a double-double multiply by `log10(e)`.
/// LLVM libc also answers 10^1 to 10^22 from a table when the error bound does not decide the
/// rounding; with FMA the bound decides all 22, so the table is left out.
fn libm_log10(x : f64) -> f64 {
