/// `atan(i/16 + x) - atan(i/16)` divided by `x`: `atan_eval` from `atan_utils.h`.
fn libm_atan_eval(x : f64, i : i64) -> f64 {
  let row = 9 * i;
  let x2 = x * x;
  let c0 = libm_multiply_add(x, LIBM_ATAN_COEFFS[row + 2], LIBM_ATAN_COEFFS[row + 1]);
  let c1 = libm_multiply_add(x, LIBM_ATAN_COEFFS[row + 4], LIBM_ATAN_COEFFS[row + 3]);
  let c2 = libm_multiply_add(x, LIBM_ATAN_COEFFS[row + 6], LIBM_ATAN_COEFFS[row + 5]);
  let c3 = libm_multiply_add(x, LIBM_ATAN_COEFFS[row + 8], LIBM_ATAN_COEFFS[row + 7]);
  let x4 = x2 * x2;
  let d1 = libm_multiply_add(x2, c1, c0);
  let d2 = libm_multiply_add(x2, c3, c2);
  return libm_multiply_add(x4, d2, d1);
}

/// The arctangent, correctly rounded: `atanf` from `atanf.h`. Near zero and beyond 16 a
/// Taylor polynomial (of `-1/x` beyond 16); between, `atan(k/16) + atan_eval` with
/// `k = round(16 |x|)`, or of `1/|x|` above 1.
fn libm_atanf(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  let neg = (x_u >> 31u32) == 1u32;
  let signed_pi_over_2 : f64 = if neg {
    libm_f64_from_bits(13833125093779451160u64)
  } else {
    libm_f64_from_bits(4609753056924675352u64)
  }; // -0x1.921fb54442d18p0, 0x1.921fb54442d18p0
  // |x| <= 1/16 or |x| >= 16.
  if x_abs <= 1031798784u32 || x_abs >= 1098907648u32 { // 0x3d800000, 0x41800000
    let mut x_d = x as f64;
    let mut const_term : f64 = 0.0;
    if x_abs >= 1098907648u32 { // 0x41800000
      if x_abs == 2139095040u32 { // 0x7f800000
        return signed_pi_over_2 as f32;
      }
      if x_abs > 2139095040u32 { // 0x7f800000
        return x;
      }
      x_d = -1.0 / x_d;
      const_term = signed_pi_over_2;
    }
    if x_abs == 0u32 {
      return x;
    }
    // |x| < 2^-12
    if x_abs < 964689920u32 { // 0x39800000
      return libm_multiply_add_f32(x, libm_f32_from_bits(3003121664u32), x); // -0x1.0p-25f
    }
    let x2 = x_d * x_d;
    let x4 = x2 * x2;
    let c0 = libm_multiply_add(x2, libm_f64_from_bits(13823048456275842389u64), 1.0); // -0x1.5555555555555p-2
    let c1 = libm_multiply_add(x2, libm_f64_from_bits(13817687028148020370u64), libm_f64_from_bits(4596373779694328218u64)); // -0x1.2492492492492p-3, 0x1.999999999999ap-3
    let c2 = libm_multiply_add(x2, libm_f64_from_bits(13814587147885025094u64), libm_f64_from_bits(4592670820000712476u64)); // -0x1.745d1745d1746p-4, 0x1.c71c71c71c71cp-4
    let p = libm_multiply_add(x4, libm_multiply_add(x4, c2, c1), c0);
    return libm_multiply_add(x_d, p, const_term) as f32;
  }
  let mut x_d : f64 = 0.0;
  let mut const_term : f64 = 0.0;
  let mut final_sign : f64 = 0.0;
  let mut idx : i64 = 0;
  if x_abs > 1065353216u32 { // 0x3f800000
    x_d = 1.0 / (libm_f32_from_bits(x_abs) as f64);
    let k_d = libm_round_even_f64(x_d * 16.0);
    x_d = libm_multiply_add(k_d, -0.0625, x_d);
    idx = k_d as i64;
    final_sign = if neg {
      1.0
    } else {
      -1.0
    };
    const_term = libm_multiply_add(final_sign, LIBM_ATAN_COEFFS[9 * idx], signed_pi_over_2);
  } else {
    // An input where the evaluation below would round the wrong way.
    if x_abs == 1032678179u32 { // 0x3d8d6b23
      if neg {
        return libm_f32_from_bits(3180147139u32); // -0x1.1a6386p-4f
      }
      return libm_f32_from_bits(1032663491u32); // 0x1.1a6386p-4f
    }
    let x_f = libm_f32_from_bits(x_abs);
    let k_f = libm_round_even_f32(x_f * 16.0);
    x_d = libm_multiply_add_f32(k_f, -0.0625, x_f) as f64;
    idx = k_f as i64;
    final_sign = if neg {
      -1.0
    } else {
      1.0
    };
    const_term = final_sign * LIBM_ATAN_COEFFS[9 * idx];
  }
  let p = libm_atan_eval(x_d, idx);
  return libm_multiply_add(final_sign * x_d, p, const_term) as f32;
}

/// A double-double: `hi + lo`, with `|lo|` at most half a unit in the last place of `hi`.
/// LLVM libc's `DoubleDouble`, from `FPUtil/double_double.h`.
struct LibmDoubleDouble {
  hi : f64,
  lo : f64,
}

impl Copy for LibmDoubleDouble {}

/// `a + b` as a double-double, exactly, for `|a| >= |b|` (Fast2Sum): `exact_add`.
fn libm_dd_exact_add(a : f64, b : f64) -> LibmDoubleDouble {
  let hi = a + b;
  let t = hi - a;
  return LibmDoubleDouble {
    hi: hi, lo: b - t
  };
}

/// `a + b`: `add`.
fn libm_dd_add(a : LibmDoubleDouble, b : LibmDoubleDouble) -> LibmDoubleDouble {
  let r = libm_dd_exact_add(a.hi, b.hi);
  let lo = a.lo + b.lo;
  return libm_dd_exact_add(r.hi, r.lo + lo);
}

/// `a * b`, dropping the product of the low parts: `quick_mult`.
fn libm_dd_quick_mult(a : LibmDoubleDouble, b : LibmDoubleDouble) -> LibmDoubleDouble {
  let hi = a.hi * b.hi;
  let lo = libm_multiply_add(a.hi, b.hi, -hi);
  let t1 = libm_multiply_add(a.hi, b.lo, lo);
  let t2 = libm_multiply_add(a.lo, b.hi, t1);
  return LibmDoubleDouble {
    hi: hi, lo: t2
  };
}

/// `a * b + c`: the double-double `multiply_add`.
fn libm_dd_multiply_add(a : LibmDoubleDouble, b : LibmDoubleDouble, c : LibmDoubleDouble) -> LibmDoubleDouble {
  return libm_dd_add(c, libm_dd_quick_mult(a, b));
}

/// `ATAN_I` from `atan2f.h`: `atan(i/16)` as double-doubles, `lo` at `[2i]` and `hi` at
/// `[2i + 1]`.
const LIBM_ATAN2F_ATAN_I : Tensor<f64, [34]> = [
0.0, 0.0, -0.0000000000000000015490756308295046, 0.06241880999595735,
-0.0000000000000000031253241424539383, 0.12435499454676144, 0.000000000000000004180692268843079, 0.18534794999569476,
0.000000000000000010698755618734451, 0.24497866312686414, -0.000000000000000011010827903001369, 0.3028848683749714,
-0.000000000000000024623815582638635, 0.35877067027057225, -0.00000000000000001587652227770689, 0.4124104415973873,
0.000000000000000022698777452961687, 0.4636476090008061, -0.000000000000000025462781472855804, 0.5123894603107377,
-0.0000000000000000054556305485916264, 0.5585993153435624, 0.00000000000000002950430737228402, 0.6022873461349642,
0.000000000000000015834785051444286, 0.6435011087932844, 0.000000000000000006943223671560008, 0.6823165548747481,
-0.000000000000000021478388444456983, 0.7188299996216245, -0.000000000000000024256934659182068, 0.7531512809621944,
0.00000000000000003061616997868383, 0.7853981633974483
];

/// `COEFFS` from `atan2f.h`: the Taylor coefficients of atan, `(-1)^i / (2i + 1)`, as
/// double-doubles, `lo` at `[2i]` and `hi` at `[2i + 1]`.
const LIBM_ATAN2F_COEFFS : Tensor<f64, [18]> = [
0.0, 1.0, -0.00000000000000001850371707708594, -0.3333333333333333,
-0.000000000000000011102230246251566, 0.2, -0.00000000000000000793016446160826, -0.14285714285714285,
0.0000000000000000061679056923619804, 0.1111111111111111, 0.000000000000000002523234146875356, -0.09090909090909091,
-0.000000000000000004270088556250602, 0.07692307692307693, -0.0000000000000000009251858538542971, -0.06666666666666667,
0.0000000000000000008163404592832033, 0.058823529411764705
];

/// `rr.hi`, moved one unit toward `rr.lo` when its bits below the target precision (`mask`)
/// are all zero, so that rounding it to the target sees which side of a boundary the exact
/// value is on. From the end of `atan2f_double_double`.
fn libm_dd_nudge(rr : LibmDoubleDouble, mask : u64) -> f64 {
  let mut rr_bits = libm_f64_to_bits(rr.hi);
  if (rr_bits & mask) == 0u64 && rr.lo != 0.0 {
    let hi_neg = (rr_bits >> 63u64) == 1u64;
    let lo_neg = (libm_f64_to_bits(rr.lo) >> 63u64) == 1u64;
    if hi_neg == lo_neg {
      rr_bits = rr_bits + 1u64;
    } else if (rr_bits & 4503599627370495u64) > 0u64 {
      rr_bits = rr_bits - 1u64;
    }
  }
  return libm_f64_from_bits(rr_bits);
}

/// The accurate pass of `atan2f`, for a result too near a rounding boundary to trust the
/// fast one: `atan2f_double_double` from `atan2f.h`, the same reduction in double-double.
/// It answers the double-double; `libm_dd_nudge` turns that into a double that rounds right.
fn libm_atan2_double_double(num_d : f64, den_d : f64, q_d : f64, idx : i64, k_d : f64, final_sign : f64, const_hi : f64, const_lo : f64) -> LibmDoubleDouble {
  let mut num_r = num_d;
  let mut den_r = den_d;
  let mut q_hi = q_d;
  if idx != 0 {
    let k = k_d * 0.0625;
    // Exact.
    num_r = libm_multiply_add(k, -den_d, num_d);
    den_r = libm_multiply_add(k, num_d, den_d);
    q_hi = num_r / den_r;
  }
  let q = LibmDoubleDouble {
    hi: q_hi, lo: libm_multiply_add(q_hi, -den_r, num_r) / den_r
  };
  let q2 = libm_dd_quick_mult(q, q);
  let mut p = LibmDoubleDouble {
    hi: LIBM_ATAN2F_COEFFS[17], lo: LIBM_ATAN2F_COEFFS[16]
  };
  let mut j : i64 = 7;
  while j >= 0 {
    p = libm_dd_multiply_add(q2, p, LibmDoubleDouble {
      hi: LIBM_ATAN2F_COEFFS[2 * j + 1], lo: LIBM_ATAN2F_COEFFS[2 * j]
    });
    j = j - 1;
  }
  let atan_i = LibmDoubleDouble {
    hi: LIBM_ATAN2F_ATAN_I[2 * idx + 1], lo: LIBM_ATAN2F_ATAN_I[2 * idx]
  };
  let r_dd = libm_dd_add(LibmDoubleDouble {
    hi: const_hi, lo: const_lo
  }, libm_dd_multiply_add(q, p, atan_i));
  return libm_dd_exact_add(r_dd.hi * final_sign, r_dd.lo * final_sign);
}

/// `atan2(y, x)`, the angle of the point `(x, y)`, correctly rounded: `atan2f` from
/// `atan2f.h`. With `q = min(|x|, |y|) / max(|x|, |y|)` it is `atan(q)` from `atan_eval`,
/// adjusted for the quadrant; a result too near a rounding boundary is redone in
/// double-double.
fn libm_atan2f(y : f32, x : f32) -> f32 {
  return libm_atan2_value(y, x, 268435455u64, false) as f32;
}

/// `atan2(y, x)` as a double that rounds correctly to a format whose bits below its precision
/// are `mask` in a double: the body of `atan2f`. `always_accurate` skips the fast path, for a
/// format that the fast path's check does not cover.
fn libm_atan2_value(y : f32, x : f32, mask : u64, always_accurate : bool) -> f64 {
  let x_u = libm_f32_to_bits(x);
  let y_u = libm_f32_to_bits(y);
  let x_sign = (x_u >> 31u32) == 1u32;
  let y_sign = (y_u >> 31u32) == 1u32;
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  let y_abs = y_u & 2147483647u32; // 0x7fffffff
  let max_abs = if x_abs > y_abs {
    x_abs
  } else {
    y_abs
  };
  let min_abs = if x_abs <= y_abs {
    x_abs
  } else {
    y_abs
  };
  let num_d = libm_f32_from_bits(min_abs) as f64;
  let den_d = libm_f32_from_bits(max_abs) as f64;
  let y_neg : f64 = if y_sign {
    -1.0
  } else {
    1.0
  };
  // An infinity, a NaN, or a zero.
  if max_abs >= 2139095040u32 || num_d == 0.0 { // 0x7f800000
    if x_abs > 2139095040u32 || y_abs > 2139095040u32 { // 0x7f800000, 0x7f800000
      return libm_f32_from_bits(2143289344u32) as f64; // 0x7fc00000
    }
    let pi : f64 = libm_f64_from_bits(4614256656552045848u64); // 0x1.921fb54442d18p1
    let pi_2 : f64 = libm_f64_from_bits(4609753056924675352u64); // 0x1.921fb54442d18p0
    // y zero: 0 or pi; y finite: pi/2, or 0 or pi for an infinite x; y infinite: pi/2, or
    // pi/4 or 3pi/4 for an infinite x.
    let mut r : f64 = 0.0;
    if y_abs == 0u32 {
      r = if x_sign {
        pi
      } else {
        0.0
      };
    } else if y_abs < 2139095040u32 { // 0x7f800000
      if x_abs == 0u32 {
        r = pi_2;
      } else if x_abs == 2139095040u32 { // 0x7f800000
        r = if x_sign {
          pi
        } else {
          0.0
        };
      }
    } else {
      if x_abs < 2139095040u32 { // 0x7f800000
        r = pi_2;
      } else {
        r = if x_sign {
          libm_f64_from_bits(4612488097114038738u64)
        } else {
          libm_f64_from_bits(4605249457297304856u64)
        }; // 0x1.2d97c7f3321d2p+1, 0x1.921fb54442d18p-1
      }
    }
    return y_neg * r;
  }
  let recip = x_abs < y_abs;
  let final_sign : f64 = if (x_sign != y_sign) != recip {
    -1.0
  } else {
    1.0
  };
  // CONST_ADJ[x_sign][y_sign][recip]
  let mut const_hi : f64 = 0.0;
  let mut const_lo : f64 = 0.0;
  if recip {
    if x_sign {
      const_hi = libm_f64_from_bits(4609753056924675352u64); // 0x1.921fb54442d18p0
      const_lo = libm_f64_from_bits(4364452196894661639u64); // 0x1.1a62633145c07p-54
    } else {
      const_hi = libm_f64_from_bits(13833125093779451160u64); // -0x1.921fb54442d18p0
      const_lo = libm_f64_from_bits(13587824233749437447u64); // -0x1.1a62633145c07p-54
    }
  } else if x_sign {
    const_hi = libm_f64_from_bits(13837628693406821656u64); // -0x1.921fb54442d18p1
    const_lo = libm_f64_from_bits(13592327833376807943u64); // -0x1.1a62633145c07p-53
  } else if y_sign {
    const_hi = -0.0;
    const_lo = -0.0;
  }
  let q0 = num_d / den_d;
  let k_d = libm_round_even_f64(q0 * 16.0);
  let idx = k_d as i64;
  let q_d = libm_multiply_add(k_d, -0.0625, q0);
  let p = libm_atan_eval(q_d, idx);
  let r = final_sign * libm_multiply_add(q_d, p, const_hi + LIBM_ATAN_COEFFS[9 * idx]);
  // The bits below single precision: far enough from a rounding boundary, r is right.
  let r_bits = libm_f64_to_bits(r) & 268435455u64;
  if !always_accurate && r_bits > 4u64 && r_bits < 268435451u64 {
    return r;
  }
  return libm_dd_nudge(libm_atan2_double_double(num_d, den_d, q_d, idx, k_d, final_sign, const_hi, const_lo), mask);
}

fn libm_asinf16(x : f16) -> f16 {
  return libm_asinf(x as f32) as f16;
}

fn libm_acosf16(x : f16) -> f16 {
  // x = -0x1.2cp-18
  if libm_f16_to_bits(x) == 32843u16 {
    return libm_f16_from_bits(15945u16); // 0x1.924p+0
  }
  // x = -0x1.2bcp-4
  if libm_f16_to_bits(x) == 44207u16 {
    return libm_f16_from_bits(16019u16); // 0x1.a4cp+0
  }
  // x = -0x1.1dp-1
  if libm_f16_to_bits(x) == 47220u16 {
    return libm_f16_from_bits(16467u16); // 0x1.14cp+1
  }
  return libm_acosf(x as f32) as f16;
}

fn libm_atanf16(x : f16) -> f16 {
  // x = 0x1.d14p-6
  if libm_f16_to_bits(x) == 10053u16 {
    return libm_f16_from_bits(10053u16); // 0x1.d14p-6
  }
  // x = 0x1.ad4p-3
  if libm_f16_to_bits(x) == 12981u16 {
    return libm_f16_from_bits(12957u16); // 0x1.a74p-3
  }
  // x = 0x1.9b8p+2
  if libm_f16_to_bits(x) == 18030u16 {
    return libm_f16_from_bits(15787u16); // 0x1.6acp+0
  }
  // x = -0x1.d14p-6
  if libm_f16_to_bits(x) == 42821u16 {
    return libm_f16_from_bits(42821u16); // -0x1.d14p-6
  }
  // x = -0x1.ad4p-3
  if libm_f16_to_bits(x) == 45749u16 {
    return libm_f16_from_bits(45725u16); // -0x1.a74p-3
  }
  // x = -0x1.9b8p+2
  if libm_f16_to_bits(x) == 50798u16 {
    return libm_f16_from_bits(48555u16); // -0x1.6acp+0
  }
  return libm_atanf(x as f32) as f16;
}

fn libm_asin_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_asinf(libm_f32_from_bf16(x)));
}

fn libm_acos_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_acosf(libm_f32_from_bf16(x)));
}

fn libm_atan_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_atanf(libm_f32_from_bf16(x)));
}

/// `d` rounded to an f32 with round-to-odd: truncated toward zero, with the last bit set when
/// anything was dropped. Rounding that again to a format at least two bits narrower is the
/// same as rounding `d` once.
fn libm_f32_round_odd(d : f64) -> f32 {
  let f = d as f32;
  if (f as f64) == d || f != f {
    return f;
  }
  let mut b = libm_f32_to_bits(f);
  // Rounded away from zero (to infinity, when d is beyond the f32 range): step back toward it.
  if (d > 0.0) == ((f as f64) > d) {
    b = b - 1u32;
  }
  return libm_f32_from_bits(b | 1u32);
}

/// `atan2(y, x)` for f16, correctly rounded: the double-double accurate pass of `atan2f` on the
/// inputs widened to f32, rounded once to f16.
fn libm_atan2f16(y : f16, x : f16) -> f16 {
  return libm_atan2_value(y as f32, x as f32, 2199023255551u64, true) as f16;
}

/// `atan2(y, x)` for bf16, correctly rounded: the double-double accurate pass of `atan2f` on
/// the inputs widened to f32, rounded to f32 with round-to-odd and then to bf16.
fn libm_atan2_bf16(y : bf16, x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_f32_round_odd(libm_atan2_value(libm_f32_from_bf16(y), libm_f32_from_bf16(x), 17592186044415u64, true)));
}

/// `sqrt(x^2 + y^2)` without overflow or underflow in between, correctly rounded: `hypotf`
/// from `hypotf.h`. The sum of squares is computed in double and its square root rounded to
/// f32; when that double sits near a halfway point of f32, the error of the sum decides which
/// way it goes.
fn libm_hypotf(x : f32, y : f32) -> f32 {
  let x_a = libm_f32_to_bits(x) & 2147483647u32; // 0x7fffffff
  let y_a = libm_f32_to_bits(y) & 2147483647u32; // 0x7fffffff
  // Infinity or NaN.
  if x_a >= 2139095040u32 || y_a >= 2139095040u32 { // 0x7f800000, 0x7f800000
    if libm_f32_is_signaling_nan(x_a) || libm_f32_is_signaling_nan(y_a) {
      return libm_f32_from_bits(2143289344u32); // 0x7fc00000
    }
    if x_a == 2139095040u32 || y_a == 2139095040u32 { // 0x7f800000, 0x7f800000
      return libm_f32_from_bits(2139095040u32); // 0x7f800000
    }
    return x + y;
  }
  let xd = x as f64;
  let yd = y as f64;
  let x_sq = xd * xd;
  let sum_sq = libm_multiply_add(yd, yd, x_sq);
  let r = libm_sqrt_f64(sum_sq);
  let r_f = r as f32;
  let mut r_u = libm_f64_to_bits(r);
  let r_u32 = r_u & 4294967295u64;
  // Near a halfway point of f32.
  if ((r_u32 + 1u64) & 268435454u64) == 0u64 {
    let r_d = r_f as f64;
    let y_sq = yd * yd;
    let a = if y_a < x_a {
      x_sq
    } else {
      y_sq
    };
    let b = if y_a < x_a {
      y_sq
    } else {
      x_sq
    };
    let e = b - libm_multiply_add(r_d, r_d, -a);
    if e == 0.0 {
      return r_f;
    }
    let sum_sq_lo = b - (sum_sq - a);
    let err = sum_sq_lo - libm_multiply_add(r, r, -sum_sq);
    if err > 0.0 {
      r_u = r_u | 1u64;
    } else if err < 0.0 && (r_u32 & 268435455u64) == 0u64 {
      r_u = r_u - 1u64;
    }
    return libm_f64_from_bits(r_u) as f32;
  }
  return r_f;
}

/// The result of `hypot` on infinities and NaNs, as the bits of a 16-bit float whose exponent
/// mask is `exp_mask` and quiet bit `quiet`, or 65536 (no 16-bit value) when neither input is
/// one: a signaling NaN in either gives the quiet NaN, then an infinity in either gives
/// infinity, then the NaN input itself. The order of `hypotf16` and `hypotbf16`. They differ in
/// which NaN they answer: `hypotf16` the larger in size, without its sign, and `hypotbf16`
/// (`keep_sign`) `x` if it is a NaN, else `y`, with its sign.
fn libm_hypot16_special(x_bits : u16, y_bits : u16, exp_mask : u16, quiet : u16, keep_sign : bool) -> u32 {
  let x_a = x_bits & 32767u16;
  let y_a = y_bits & 32767u16;
  if x_a < exp_mask && y_a < exp_mask {
    return 65536u32;
  }
  let x_snan = x_a > exp_mask && (x_a & quiet) == 0u16;
  let y_snan = y_a > exp_mask && (y_a & quiet) == 0u16;
  if x_snan || y_snan {
    return (exp_mask | quiet) as u32;
  }
  if x_a == exp_mask || y_a == exp_mask {
    return exp_mask as u32;
  }
  if keep_sign {
    if x_a > exp_mask {
      return x_bits as u32;
    }
    return y_bits as u32;
  }
  if x_a >= y_a {
    return x_a as u32;
  }
  return y_a as u32;
}

/// `sqrt(x^2 + y^2)` for f16: the square root of the sum in double, rounded once to f16.
fn libm_hypotf16(x : f16, y : f16) -> f16 {
  let special = libm_hypot16_special(libm_f16_to_bits(x), libm_f16_to_bits(y), 31744u16, 512u16, false);
  if special != 65536u32 {
    return libm_f16_from_bits(special as u16);
  }
  let xd = x as f64;
  let yd = y as f64;
  return libm_sqrt_f64(libm_multiply_add(yd, yd, xd * xd)) as f16;
}

/// The bits of `hypot` of two bf16s, given by their bits: the square root of the sum in
/// double, rounded to f32 with round-to-odd and then to bf16. In bits so that the bf16 result
/// is made once, at the end (see `libm_bf16_bits_from_f32`).
fn libm_hypot_bf16_bits(x_bits : u16, y_bits : u16) -> u16 {
  let special = libm_hypot16_special(x_bits, y_bits, 32640u16, 64u16, true);
  if special != 65536u32 {
    return special as u16;
  }
  let xd = libm_f32_from_bits((x_bits as u32) << 16u32) as f64;
  let yd = libm_f32_from_bits((y_bits as u32) << 16u32) as f64;
  let r = libm_f32_round_odd(libm_sqrt_f64(libm_multiply_add(yd, yd, xd * xd)));
  // f32 to bf16, ties to even.
  let b = libm_f32_to_bits(r);
  return ((b + 32767u32 + ((b >> 16u32) & 1u32)) >> 16u32) as u16;
}

/// `sqrt(x^2 + y^2)` for bf16, correctly rounded.
fn libm_hypot_bf16(x : bf16, y : bf16) -> bf16 {
  return libm_bf16_from_bits(libm_hypot_bf16_bits(libm_bf16_to_bits(x), libm_bf16_to_bits(y)));
}

/// `10^x`, correctly rounded: `exp10f` from `exp10f_double_eval.h`, with `x = (hi + mid) *
/// log10(2) + lo` and `10^lo` a degree-5 polynomial. Powers of ten up to 10^10 are exact.
fn libm_exp10f(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32; // 0x7fffffff
  // |x| >= 0x1.344136p+5
  if x_abs >= 1109008539u32 { // 0x421a209b
    // x < -0x1.693e6ap+5, or NaN.
    if x_u > 3258228277u32 { // 0xc2349e35
      if x_u == 4286578688u32 { // 0xff800000
        return 0.0;
      }
      if x_abs > 2139095040u32 { // 0x7f800000
        return x;
      }
      return 0.0;
    }
    // Overflow to infinity, or the NaN.
    if (x_u >> 31u32) == 0u32 {
      return x + libm_f32_from_bits(2139095040u32); // 0x7f800000
    }
  }
  // |x| <= 0x1.344136p-8
  if x_abs <= 999956635u32 { // 0x3b9a209b
    // An input where the evaluation below would round the wrong way.
    if x_u == 2992528345u32 { // 0xb25e5bd9
      return libm_f32_from_bits(1065353215u32); // 0x1.fffffep-1f
    }
    // |x| <= 2^-26
    if x_abs <= 847249408u32 { // 0x32800000
      return libm_multiply_add_f32(x, libm_f32_from_bits(1075010958u32), 1.0); // 0x1.26bb1cp+1f
    }
    let dx = x as f64;
    let dx2 = dx * dx;
    let c0 = libm_multiply_add(dx, libm_f64_from_bits(4612367379483415829u64), 1.0); // 0x1.26bb1bbb55515p1
    let c1 = libm_multiply_add(dx, libm_f64_from_bits(4611764107675169097u64), libm_f64_from_bits(4613151825388622826u64)); // 0x1.0470591dff149p1, 0x1.53524c73bd3eap1
    let c2 = libm_multiply_add(dx, libm_f64_from_bits(4603033542478892867u64), libm_f64_from_bits(4607953709205273677u64)); // 0x1.1429e74a98f43p-1, 0x1.2bd7c0a9fbc4dp0
    return libm_multiply_add(dx2, libm_multiply_add(dx2, c2, c1), c0) as f32;
  }
  // Exact powers of ten.
  if (x_u & 2148532223u32) == 0u32 { // 0x800fffff
    if x_u == 1065353216u32 { // 0x3f800000
      return 10.0;
    }
    if x_u == 1073741824u32 { // 0x40000000
      return 100.0;
    }
    if x_u == 1077936128u32 { // 0x40400000
      return 1000.0;
    }
    if x_u == 1082130432u32 { // 0x40800000
      return 10000.0;
    }
    if x_u == 1084227584u32 { // 0x40a00000
      return 100000.0;
    }
    if x_u == 1086324736u32 { // 0x40c00000
      return 1000000.0;
    }
    if x_u == 1088421888u32 { // 0x40e00000
      return 10000000.0;
    }
    if x_u == 1090519040u32 { // 0x41000000
      return 100000000.0;
    }
    if x_u == 1091567616u32 { // 0x41100000
      return 1000000000.0;
    }
    if x_u == 1092616192u32 { // 0x41200000
      return 10000000000.0;
    }
  }
  let xd = x as f64;
  let kd = libm_round_even_f64(libm_f64_from_bits(4637180734002013041u64) * xd); // 0x1.a934f0979a371p+6
  let k = kd as i32;
  let mh = libm_f64_from_bits((LIBM_EXP_2_MID[(k & 31) as i64] + (((k >> 5) as i64) << 52)) as u64);
  let lo = libm_multiply_add(kd, libm_f64_from_bits(4388762457053287210u64), libm_multiply_add(kd, libm_f64_from_bits(13799948532941029376u64), xd)); // 0x1.80433b83b532ap-49, -0x1.34413509f8p-7
  let lo2 = lo * lo;
  let c0 = libm_multiply_add(lo, libm_f64_from_bits(4612367379483415829u64), 1.0); // 0x1.26bb1bbb55515p1
  let c1 = libm_multiply_add(lo, libm_f64_from_bits(4611764107675169097u64), libm_f64_from_bits(4613151825388622826u64)); // 0x1.0470591dff149p1, 0x1.53524c73bd3eap1
  let c2 = libm_multiply_add(lo, libm_f64_from_bits(4603033542478892867u64), libm_f64_from_bits(4607953709205273677u64)); // 0x1.1429e74a98f43p-1, 0x1.2bd7c0a9fbc4dp0
  let p = libm_multiply_add(lo2, c2, c1);
  return libm_multiply_add(p, lo2 * mh, c0 * mh) as f32;
}

/// The number of zero bits below the lowest set bit; 32 for zero.
fn libm_u32_trailing_zeros(a : u32) -> u32 {
  return mlir!( inputs : (%a = a : i32), returns : u32, dialects : ["math"]) {
    %r = math.cttz %a : i32
    macro.yield %r : i32
  };
}

/// The number of zero bits above the highest set bit; 32 for zero.
fn libm_u32_leading_zeros(a : u32) -> u32 {
  return mlir!( inputs : (%a = a : i32), returns : u32, dialects : ["math"]) {
    %r = math.ctlz %a : i32
    macro.yield %r : i32
  };
}

/// Whether the f32 with bits `x_u` is a whole number (or infinite): `is_integer` from `powf.h`.
fn libm_f32_bits_is_integer(x_u : u32) -> bool {
  let x_e = ((x_u & 2139095040u32) >> 23u32) as i32; // 0x7f800000
  let lsb = libm_u32_trailing_zeros(x_u | 2139095040u32) as i32; // 0x7f800000
  return x_e + lsb >= 150;
}

/// Whether the f32 with bits `x_u` is an odd whole number: `is_odd_integer` from `powf.h`.
fn libm_f32_bits_is_odd_integer(x_u : u32) -> bool {
  let x_e = ((x_u & 2139095040u32) >> 23u32) as i32; // 0x7f800000
  let lsb = libm_u32_trailing_zeros(x_u | 2139095040u32) as i32; // 0x7f800000
  return x_e + lsb == 150;
}

/// `x * b` as a double-double, for a double `x`: `quick_mult(double, DoubleDouble)`.
fn libm_dd_quick_mult_d(x : f64, b : LibmDoubleDouble) -> LibmDoubleDouble {
  let hi = x * b.hi;
  let lo = libm_multiply_add(x, b.hi, -hi);
  return LibmDoubleDouble {
    hi: hi, lo: libm_multiply_add(x, b.lo, lo)
  };
}

/// Whether the exponent of `a` is at least that of `b`: `larger_exponent` from `powf.h`.
fn libm_larger_exponent(a : f64, b : f64) -> bool {
  return ((libm_f64_to_bits(a) >> 52u64) & 2047u64) >= ((libm_f64_to_bits(b) >> 52u64) & 2047u64);
}

/// `LOG2_R_TD` from `powf.h`: `-log2(r)` as triple-doubles, `lo`, `mid` and `hi` at `[3i]`,
/// `[3i + 1]` and `[3i + 2]`, the high part short enough that `y * (e_x + hi)` is exact.
const LIBM_POWF_LOG2_R_TD : Tensor<f64, [384]> = [
