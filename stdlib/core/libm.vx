/// `erf(x)` in double for a finite `|x|` below 4: the polynomial of `erff.h` for the slice `|x|`
/// is in.
fn libm_erf_eval(x : f32) -> f64 {
  let x_abs = libm_f32_to_bits(x) & 2147483647u32;
  let xd = x as f64;
  let xsq = xd * xd;
  // 8 |x|, by adding 3 to the exponent.
  let idx = (libm_f32_from_bits(x_abs + 25165824u32) as i32) as i64;
  let k = 8 * idx;
  let x4 = xsq * xsq;
  let c0 = libm_multiply_add(xsq, LIBM_ERFF_COEFFS[k + 1], LIBM_ERFF_COEFFS[k]);
  let c1 = libm_multiply_add(xsq, LIBM_ERFF_COEFFS[k + 3], LIBM_ERFF_COEFFS[k + 2]);
  let c2 = libm_multiply_add(xsq, LIBM_ERFF_COEFFS[k + 5], LIBM_ERFF_COEFFS[k + 4]);
  let c3 = libm_multiply_add(xsq, LIBM_ERFF_COEFFS[k + 7], LIBM_ERFF_COEFFS[k + 6]);
  let x8 = x4 * x4;
  let p0 = libm_multiply_add(x4, c1, c0);
  let p1 = libm_multiply_add(x4, c3, c2);
  return xd * libm_multiply_add(x8, p1, p0);
}

/// The error function of an f32, correctly rounded: `erff` from `erff.h`. From 4 up in size it
/// rounds to 1; below, a polynomial for one of 32 slices, in double, with two inputs whose double
/// result would round the wrong way answered from a list.
fn libm_erff(x : f32) -> f32 {
  let x_u = libm_f32_to_bits(x);
  let x_abs = x_u & 2147483647u32;
  let negative = (x_u >> 31u32) == 1u32;
  if x_abs >= 1082130432u32 { // 0x40800000
    if x_abs >= 2139095040u32 { // 0x7f800000
      if x_abs > 2139095040u32 {
        if (x_abs & 4194304u32) == 0u32 {
          return libm_f32_from_bits(2143289344u32);
        }
        return x;
      }
      if negative {
        return -1.0;
      }
      return 1.0;
    }
    // erf(x) is within 2^-25 of +-1.
    if negative {
      return -1.0 + libm_f32_from_bits(855638016u32); // 0x1.0p-25f
    }
    return 1.0 - libm_f32_from_bits(855638016u32); // 0x1.0p-25f
  }
  // The two exceptions (and zero) all have the bits of 0x809a6184 clear.
  if (x_abs & 2157600132u32) == 0u32 {
    if x_abs == 1063621161u32 { // 0x3f659229
      if negative {
        return libm_f32_from_bits(3209402196u32); // -0x1.972ea8p-1f
      }
      return libm_f32_from_bits(1061918548u32); // 0x1.972ea8p-1f
    }
    if x_abs == 1074011754u32 { // 0x40041e6a
      if negative {
        return libm_f32_from_bits(3212778033u32); // -0x1.fe3462p-1f
      }
      return libm_f32_from_bits(1065294385u32); // 0x1.fe3462p-1f
    }
    if x_abs == 0u32 {
      return x;
    }
  }
  return libm_erf_eval(x) as f32;
}

/// The error function of an f16, correctly rounded: `erff16` from `erff16.h`, the polynomial of
/// `erff` in f32. From 3 up in size it rounds to +-1.
fn libm_erff16(x : f16) -> f16 {
  let x_u = libm_f16_to_bits(x);
  let x_abs = x_u & 32767u16;
  let negative = (x_u >> 15u16) == 1u16;
  let xf = x as f32;
  // Inputs whose f32 result rounds the wrong way, odd in x.
  let mut ex : u16 = 0u16;
  if x_abs == 5650u16 { // 0x1612
    ex = 5849u16; // 0x16d9
  } else if x_abs == 5724u16 { // 0x165c
    ex = 5933u16; // 0x172d
  } else if x_abs == 5872u16 { // 0x16f0
    ex = 6100u16; // 0x17d4
  } else if x_abs == 15346u16 { // 0x3bf2
    ex = 15032u16; // 0x3ab8
  }
  if ex != 0u16 {
    if negative {
      return libm_f16_from_bits(ex | 32768u16);
    }
    return libm_f16_from_bits(ex);
  }
  if x_abs >= 16896u16 { // 0x4200
    if x_abs >= 31744u16 { // 0x7c00
      if x_abs > 31744u16 {
        if (x_abs & 512u16) == 0u16 {
          return libm_f16_from_bits(32256u16);
        }
        return x;
      }
      if negative {
        return libm_f16_from_bits(48128u16);
      }
      return libm_f16_from_bits(15360u16);
    }
    if negative {
      return (-1.0 - xf * libm_f32_from_bits(830472192u32)) as f16; // 0x1.0p-28f
    }
    return (1.0 - xf * libm_f32_from_bits(830472192u32)) as f16; // 0x1.0p-28f
  }
  let idx = ((libm_f16_from_bits(x_abs) * libm_f16_from_bits(18432u16)) as i32) as i64;
  let k = 8 * idx;
  let xsq = xf * xf;
  let x4 = xsq * xsq;
  let c0 = libm_multiply_add_f32(xsq, LIBM_ERFF16_COEFFS[k + 1], LIBM_ERFF16_COEFFS[k]);
  let c1 = libm_multiply_add_f32(xsq, LIBM_ERFF16_COEFFS[k + 3], LIBM_ERFF16_COEFFS[k + 2]);
  let c2 = libm_multiply_add_f32(xsq, LIBM_ERFF16_COEFFS[k + 5], LIBM_ERFF16_COEFFS[k + 4]);
  let c3 = libm_multiply_add_f32(xsq, LIBM_ERFF16_COEFFS[k + 7], LIBM_ERFF16_COEFFS[k + 6]);
  let x8 = x4 * x4;
  let p0 = libm_multiply_add_f32(x4, c1, c0);
  let p1 = libm_multiply_add_f32(x4, c3, c2);
  let result = xf * libm_multiply_add_f32(x8, p1, p0);
  if result > 1.0 {
    return (1.0 - xf * libm_f32_from_bits(830472192u32)) as f16; // 0x1.0p-28f
  }
  if result < -1.0 {
    return (-1.0 - xf * libm_f32_from_bits(830472192u32)) as f16; // 0x1.0p-28f
  }
  return result as f16;
}

/// The error function of a bf16: the double result of `erff`'s polynomial rounded once to bf16.
/// LLVM libc has no bf16 `erf`.
fn libm_erf_bf16(x : bf16) -> bf16 {
  let xf = libm_f32_from_bf16(x);
  let x_abs = libm_f32_to_bits(xf) & 2147483647u32;
  if x_abs >= 1082130432u32 || x_abs == 0u32 {
    // Zero, NaN, infinity and |x| from 4 up: erff's answer rounds to bf16 the same.
    return libm_bf16_from_f32(libm_erff(xf));
  }
  return libm_bf16_from_f32(libm_f32_round_odd(libm_erf_eval(xf)));
}

/// What `rsqrt` answers for zero, a negative number, infinity and NaN, as the bits of a float with
/// exponent mask `inf` and quiet bit `quiet`, or no answer (`ok` false) for a positive finite x.
fn libm_rsqrt_special(x_u : u64, sign_bit : u64, inf : u64, quiet : u64) -> LibmZivResult {
  let x_abs = x_u & (sign_bit - 1u64);
  if x_u != 0u64 && x_u < inf {
    return LibmZivResult {
      ok: false, value: 0.0
    };
  }
  let mut bits : u64 = 0u64;
  if x_abs > inf {
    // NaN; a signaling one becomes the quiet NaN.
    bits = x_u;
    if (x_abs & quiet) == 0u64 {
      bits = inf | quiet;
    }
  } else if x_abs == 0u64 {
    // 1 / sqrt(+-0) = +-infinity.
    bits = (x_u & sign_bit) | inf;
  } else if x_u > (sign_bit - 1u64) {
    // A negative number, or minus infinity.
    bits = inf | quiet;
  }
  // +infinity gives +0.
  return LibmZivResult {
    ok: true, value: libm_f64_from_bits(bits)
  };
}

/// `1 / sqrt(x)` for an f32: `rsqrtf` from `rsqrtf.h`, the double result rounded to f32.
fn libm_rsqrtf(x : f32) -> f32 {
  let s = libm_rsqrt_special(libm_f32_to_bits(x) as u64, 2147483648u64, 2139095040u64, 4194304u64);
  if s.ok {
    return libm_f32_from_bits(libm_f64_to_bits(s.value) as u32);
  }
  return (1.0 / libm_sqrt_f64(x as f64)) as f32;
}

/// `1 / sqrt(x)` for an f16, correctly rounded: `rsqrtf16` from `rsqrtf16.h`, in f32, with two
/// mantissas whose f32 result would round the wrong way nudged first.
fn libm_rsqrtf16(x : f16) -> f16 {
  let x_u = libm_f16_to_bits(x);
  let s = libm_rsqrt_special(x_u as u64, 32768u64, 31744u64, 512u64);
  if s.ok {
    return libm_f16_from_bits(libm_f64_to_bits(s.value) as u16);
  }
  let mut result = 1.0 / libm_sqrt_f32(x as f32);
  let half_mantissa = x_u & 1023u16;
  if half_mantissa == 287u16 { // 0x011f
    result = libm_multiply_add_f32(result, libm_f32_from_bits(889192448u32), result); // 0x1.0p-21f
  } else if half_mantissa == 787u16 { // 0x0313
    result = libm_multiply_add_f32(result, libm_f32_from_bits(3036676096u32), result); // -0x1.0p-21f
  }
  return result as f16;
}

/// `1 / sqrt(x)` for a double, correctly rounded. Not a port: LLVM libc has no double-precision
/// `rsqrt`. The square root as a double-double, then one double-double division, rounded once;
/// `1 / sqrt(x)` is never exactly halfway between two doubles unless it is a double, so that
/// rounding is right.
fn libm_rsqrt(x : f64) -> f64 {
  let s = libm_rsqrt_special(libm_f64_to_bits(x), 9223372036854775808u64, 9218868437227405312u64, 2251799813685248u64); // 0x8000000000000000, 0x7ff0000000000000, 0x0008000000000000
  if s.ok {
    return s.value;
  }
  // Below 2^-900 the square of the root, which corrects it, would lose bits to underflow: scale
  // x up by 2^200 and the result by 2^100.
  let mut a = x;
  let mut scale : f64 = 1.0;
  if x < libm_f64_from_bits(553942754166571008u64) {
    a = x * libm_f64_from_bits(5507902344274116608u64);
    scale = libm_f64_from_bits(5057542381537067008u64);
  }
  let r = libm_dd_div(LibmDoubleDouble {
    hi: 1.0, lo: 0.0
  }, libm_dd_sqrt(LibmDoubleDouble {
    hi: a, lo: 0.0
  }));
  return (r.hi + r.lo) * scale;
}

/// `1 / sqrt(x)` for a bf16: the double result rounded once to bf16. LLVM libc has no bf16
/// `rsqrt`.
fn libm_rsqrt_bf16(x : bf16) -> bf16 {
  return libm_bf16_from_f32(libm_f32_round_odd(libm_rsqrt(libm_f32_from_bf16(x) as f64)));
}
