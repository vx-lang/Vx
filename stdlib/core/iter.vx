//===----------------------------------------------------------------------===//
// The iterator library: `Range`, the adaptors, and the functions that build them. The
// `Iterator` trait itself is in `core::iter::traits`, which this imports, so importing
// `core::iter` brings the trait as well.
//
// `Item` is an associated type: each impl binds it with `type Item = ..;` and the trait's
// signatures say `Self::Item`. The adaptors still carry their inner iterator's item type as
// a parameter of their own, `T`, because naming it as `I::Item` does not resolve yet (Vx#727);
// that is also why `take` and `skip` are called with the item type spelled out.
//
// A `for` loop consumes the iterator it drives, so an adaptor takes its inner iterator by
// value and the chain is built before the loop.
//
// One adaptor deep only: a second one makes the inner type a nested generic, and a type
// argument list is split on commas without counting brackets (Vx#647).
//
// The bound on an adaptor's `I` is not checked today (Vx#645): it is written for the
// reader, and a type without `next` fails inside the adaptor instead of at the use.
import core::iter::traits;
import core::ops;
import core::option;

/// The numbers from `at` up to but not including `end`.
/// A half-open span of `i64`, from `at` up to but not including `end`.
struct Range {
  at : i64,
  end : i64,
}

impl Iterator for Range {
  type Item = i64;

  /// The next value in the span, or nothing once `end` is reached.
  fn next(self : &mut Range) -> Option<i64> {
    if self.at >= self.end {
      return Option<i64>::None();
    }
    let v : i64 = self.at;
    self.at = self.at + 1i64;
    return Option<i64>::Some(v);
  }
}

/// `f` over every item.
/// An iterator over another one's items with `f` applied to each. Built by `map`.
struct Map<I, T, U> {
  inner : I,
  f : Closure1<T, U>,
}

impl<I : Iterator, T, U> Iterator for Map<I, T, U> {
  type Item = U;

  /// The inner iterator's next item with `f` applied.
  fn next(self : &mut Map<I, T, U>) -> Option<U> {
    let step = self.inner.next();
    if step.is_none() {
      return Option<U>::None();
    }
    let g = self.f;
    let p = g.func;
    return Option<U>::Some(p(g.env, step.unwrap()));
  }
}

/// Only the items `keep` accepts.
/// An iterator over the items of another that `keep` accepts. Built by `filter`.
struct Filter<I, T> {
  inner : I,
  keep : Closure1<T, bool>,
}

impl<I : Iterator, T> Iterator for Filter<I, T> {
  type Item = T;

  /// The inner iterator's next item that `keep` accepts.
  fn next(self : &mut Filter<I, T>) -> Option<T> {
    loop {
      let step = self.inner.next();
      if step.is_none() {
        return Option<T>::None();
      }
      let v = step.unwrap();
      let g = self.keep;
      let p = g.func;
      if p(g.env, v) {
        return Option<T>::Some(v);
      }
    }
    return Option<T>::None();
  }
}

/// The first `left` items, then nothing.
///
/// `T` is carried by the struct although `Take` never stores one: until `I::Item` resolves
/// it is the only place the impl can read the element type from.
/// An iterator over at most `left` items of another. Built by `take`.
struct Take<I, T> {
  inner : I,
  left : i64,
}

impl<I : Iterator, T> Iterator for Take<I, T> {
  type Item = T;

  /// The inner iterator's next item, until `left` of them have been handed out.
  fn next(self : &mut Take<I, T>) -> Option<T> {
    if self.left <= 0i64 {
      return Option<T>::None();
    }
    self.left = self.left - 1i64;
    return self.inner.next();
  }
}

/// Everything after the first `drop` items.
/// An iterator over another's items with the first `drop` of them discarded. Built by `skip`.
struct Skip<I, T> {
  inner : I,
  drop : i64,
}

impl<I : Iterator, T> Iterator for Skip<I, T> {
  type Item = T;

  /// The inner iterator's next item, once the skipped ones have been consumed.
  fn next(self : &mut Skip<I, T>) -> Option<T> {
    loop {
      if self.drop <= 0i64 {
        return self.inner.next();
      }
      let step = self.inner.next();
      if step.is_none() {
        return step;
      }
      self.drop = self.drop - 1i64;
    }
    return Option<T>::None();
  }
}

/// The adaptors are built through these rather than by writing the struct literal: a
/// closure literal is coerced to `Closure1<A, B>` in an argument but not in a field
/// initializer (Vx#648).
fn map<I, T, U>(inner : I, f : Closure1<T, U>) -> Map<I, T, U> {
  return Map<I, T, U> {
    inner : inner, f : f
  };
}

/// An iterator over the items of `inner` that `keep` accepts.
fn filter<I, T>(inner : I, keep : Closure1<T, bool>) -> Filter<I, T> {
  return Filter<I, T> {
    inner : inner, keep : keep
  };
}

/// An iterator over at most `left` items of `inner`.
fn take<I, T>(inner : I, left : i64) -> Take<I, T> {
  return Take<I, T> {
    inner : inner, left : left
  };
}

/// An iterator over `inner` with its first `drop` items discarded.
fn skip<I, T>(inner : I, drop : i64) -> Skip<I, T> {
  return Skip<I, T> {
    inner : inner, drop : drop
  };
}

/// The numbers `at .. end`.
fn range(at : i64, end : i64) -> Range {
  return Range {
    at : at, end : end
  };
}
