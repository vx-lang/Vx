//===----------------------------------------------------------------------===//
// The iterator library: `Range` and `range`. The `Iterator` trait is in `core::iter::traits`
// and the adaptors its methods build are in `core::iter::adapters`; importing `core::iter`
// brings both.
//
// A `for` loop consumes the iterator it drives, so an adaptor takes its inner iterator by
// value and the chain is built before the loop.
import core::iter::traits;
import core::ops;
import core::option;

/// The numbers from `at` up to but not including `end`.
/// A half-open span of `i64`, from `at` up to but not including `end`.
struct Range {
  at : i64,
  end : i64,
}

impl Iterator for Range {
  type Item = i64;

  /// The next value in the span, or nothing once `end` is reached.
  fn next(self : &mut Range) -> Option<i64> {
    if self.at >= self.end {
      return Option<i64>::None();
    }
    let v : i64 = self.at;
    self.at = self.at + 1i64;
    return Option<i64>::Some(v);
  }
}

/// The numbers `at .. end`.
fn range(at : i64, end : i64) -> Range {
  return Range {
    at : at, end : end
  };
}
