// `f32` and `f64` have the same functions except `compare_and_swap`. `fetch_max` and `fetch_min`
// follow `f32::max`: a NaN loses to a number.
stamp_element_atomics!(f32 , f32 , 4 , core_atomic_len_f32 , atomic_load_f32 , atomic_store_f32);
stamp_element_rmw!(atomic_swap_f32 , f32 , f32 , core_atomic_len_f32 , xchg);
