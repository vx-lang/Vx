// Atomic integers and booleans: each read, write or read-modify-write is one indivisible
// memory operation, with the memory ordering the caller asks for.
//
// Every operation is one `llvm.atomicrmw`, `llvm.cmpxchg`, `llvm.fence` or atomic
// `llvm.load`/`llvm.store` written in an `mlir!` block, so the module needs no libc.
// An `mlir!` block names its ordering in the text, so each method matches on the ordering
// and has one block per case. A constant ordering lets the optimizer drop the other cases.
//
// Differences from Rust's `core::sync::atomic`:
//
// - The ordering enum is `AtomicOrdering`, since `core::cmp` already has an `Ordering` and
//   two imported names cannot be the same.
// - Each atomic holds its value in a `SharedCell` (Rust's `UnsafeCell`), so every method that
//   reads or writes takes `self : &Self`, as in Rust.
// - A tensor element is a plain number, not an atomic type. The functions at the end of this file,
//   such as `atomic_fetch_add_u32(&t, i, v, order)`, change one element atomically.
// - `compare_exchange` can use stronger orderings than asked for: `Release` on success with
//   `Acquire` on failure runs as `AcqRel` and `Acquire`. A stronger ordering is always
//   correct. `compare_exchange_weak` is `compare_exchange`, which never fails spuriously.
// - A program that calls `fetch_update` is compiled by the legacy code generator: the flat
//   one cannot yet call a closure that answers an `Option`.
// - An ordering Rust panics on (`Release` for a load, `Acquire` for a store, `Release` or
//   `AcqRel` as a failure ordering, `Relaxed` for a fence) fails an `assert` here.
// - Vx has no threads yet, so nothing here has been run by more than one thread.
//
// Not here: `AtomicPtr<T>` (not written yet),
// `AtomicIsize` (Vx has no `isize`), `AtomicI128`/`AtomicU128` (unstable in Rust),
// `as_ptr` and `get_mut` on `AtomicBool` (it is held as a byte), `from_ptr` and the
// `from_mut`/`get_mut_slice` family (want turning a pointer into a reference, and slices),
// and `Debug` (no `core::fmt`).
import core::cell;
import core::marker;
import core::option;
import core::result;
import core::default;
import core::convert;

/// How an atomic operation is ordered with the memory operations around it.
enum AtomicOrdering {
  // Only the operation itself is atomic, with one exception: a relaxed read is not moved after a
  // write that comes later in its thread, so no value comes out of thin air. The compiler makes
  // each relaxed read an acquire read for this. `-fweak-relaxed-atomics` drops the exception.
  Relaxed,
  // Writes before this store are visible to a thread whose `Acquire` load reads it.
  Release,
  // Reads after this load see the writes made before the `Release` store it read.
  Acquire,
  // `Acquire` for the read and `Release` for the write of a read-modify-write.
  AcqRel,
  // `AcqRel`, and every `SeqCst` operation is seen in one order by all threads.
  SeqCst,
}

impl Copy for AtomicOrdering {}

/// Whether a load may use `o`. Rust panics on `Release` and `AcqRel`. It runs where its caller
/// runs, so device code can call it.
fn core_atomic_load_order_ok<D : Topology>(o : AtomicOrdering) on Topology::D -> bool {
  match o {
    AtomicOrdering::Release => {
      return false;
    }
    AtomicOrdering::AcqRel => {
      return false;
    }
    _ => {
      return true;
    }
  }
}

/// Whether a store may use `o`. Rust panics on `Acquire` and `AcqRel`. It runs where its caller
/// runs.
fn core_atomic_store_order_ok<D : Topology>(o : AtomicOrdering) on Topology::D -> bool {
  match o {
    AtomicOrdering::Acquire => {
      return false;
    }
    AtomicOrdering::AcqRel => {
      return false;
    }
    _ => {
      return true;
    }
  }
}

/// Whether a fence may use `o`. Rust panics on `Relaxed`. It runs where its caller runs.
fn core_atomic_fence_order_ok<D : Topology>(o : AtomicOrdering) on Topology::D -> bool
ensures writes_only()
{
  match o {
    AtomicOrdering::Relaxed => {
      return false;
    }
    _ => {
      return true;
    }
  }
}

/// `o`, made strong enough to include `Acquire`.
fn core_atomic_with_acquire(o : AtomicOrdering) -> AtomicOrdering {
  match o {
    AtomicOrdering::Relaxed => {
      return AtomicOrdering::Acquire;
    }
    AtomicOrdering::Release => {
      return AtomicOrdering::AcqRel;
    }
    _ => {
      return o;
    }
  }
}

/// The one ordering `compare_exchange` uses: `success` made strong enough to also cover
/// `failure`. A `failure` of `Release` or `AcqRel` fails the assert, as Rust panics.
fn core_atomic_cas_order(success : AtomicOrdering, failure : AtomicOrdering) -> AtomicOrdering {
  assert(core_atomic_load_order_ok(failure), "compare_exchange: the failure ordering cannot be Release or AcqRel");
  match failure {
    AtomicOrdering::SeqCst => {
      return AtomicOrdering::SeqCst;
    }
    AtomicOrdering::Acquire => {
      return core_atomic_with_acquire(success);
    }
    _ => {
      return success;
    }
  }
}

/// Stamps one read-modify-write method: `$method` is the Rust name, `$op` the
/// `llvm.atomicrmw` operation. It answers the value from before the change.
macro_rules stamp_atomic_rmw {
  ($name : ident , $t : ident , $mlir : ident , $method : ident , $op : ident) => {
    impl $name {
      fn $method(self : &$name, val : $t, order : AtomicOrdering) -> $t {
        match order {
          AtomicOrdering::Relaxed => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), returns : $t, dialects : ["llvm"]) {
              %r = llvm.atomicrmw $op %p, %x monotonic : !llvm.ptr, $mlir
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::Release => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), returns : $t, dialects : ["llvm"]) {
              %r = llvm.atomicrmw $op %p, %x release : !llvm.ptr, $mlir
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::Acquire => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), returns : $t, dialects : ["llvm"]) {
              %r = llvm.atomicrmw $op %p, %x acquire : !llvm.ptr, $mlir
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::AcqRel => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), returns : $t, dialects : ["llvm"]) {
              %r = llvm.atomicrmw $op %p, %x acq_rel : !llvm.ptr, $mlir
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::SeqCst => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), returns : $t, dialects : ["llvm"]) {
              %r = llvm.atomicrmw $op %p, %x seq_cst : !llvm.ptr, $mlir
              macro.yield %r : $mlir
            };
          }
        }
      }
    }
  };
}

/// Stamps one atomic integer type `$name` holding a `$t`. `$mlir` is the MLIR type of `$t`
/// (a Vx `u32` is an MLIR `i32`), and `$align` its size in bytes.
macro_rules stamp_atomic_int {
  ($name : ident , $t : ident , $mlir : ident , $align : expr) => {
    /// A `$t` that can be read and changed atomically.
    struct $name {
      v : SharedCell<$t>,
    }

    // Each access to the value is atomic, so two tasks may share one through `&`.
    unsafe impl Sync for $name {}

    impl $name {
      /// A new atomic holding `v`.
      fn new(v : $t) -> $name {
        return $name {
          v : SharedCell<$t>::new(v)
        };
      }

      /// The value, which is no longer atomic.
      fn into_inner(self : $name) -> $t {
        return self.v.into_inner();
      }

      /// The value, through a `&mut`, which rules out any other access at the same time.
      fn get_mut(self : &mut $name) -> &mut $t {
        return self.v.get_mut();
      }

      /// A pointer to the value.
      fn as_ptr(self : &$name) -> *mut $t {
        return self.v.get();
      }

      /// Reads the value. `order` cannot be `Release` or `AcqRel`.
      fn load(self : &$name, order : AtomicOrdering) -> $t {
        assert(core_atomic_load_order_ok(order), "load: the ordering cannot be Release or AcqRel");
        match order {
          AtomicOrdering::Relaxed => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr), returns : $t, dialects : ["llvm"]) {
              %r = llvm.load %p atomic monotonic {
                alignment = $align : i64
              } : !llvm.ptr -> $mlir
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::Acquire => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr), returns : $t, dialects : ["llvm"]) {
              %r = llvm.load %p atomic acquire {
                alignment = $align : i64
              } : !llvm.ptr -> $mlir
              macro.yield %r : $mlir
            };
          }
          _ => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr), returns : $t, dialects : ["llvm"]) {
              %r = llvm.load %p atomic seq_cst {
                alignment = $align : i64
              } : !llvm.ptr -> $mlir
              macro.yield %r : $mlir
            };
          }
        }
      }

      /// Writes `val`. `order` cannot be `Acquire` or `AcqRel`.
      fn store(self : &$name, val : $t, order : AtomicOrdering) -> void {
        assert(core_atomic_store_order_ok(order), "store: the ordering cannot be Acquire or AcqRel");
        match order {
          AtomicOrdering::Relaxed => {
            mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), dialects : ["llvm"]) {
              llvm.store %x, %p atomic monotonic {
                alignment = $align : i64
              } : $mlir, !llvm.ptr
              macro.yield
            };
          }
          AtomicOrdering::Release => {
            mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), dialects : ["llvm"]) {
              llvm.store %x, %p atomic release {
                alignment = $align : i64
              } : $mlir, !llvm.ptr
              macro.yield
            };
          }
          _ => {
            mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %x = val : $mlir), dialects : ["llvm"]) {
              llvm.store %x, %p atomic seq_cst {
                alignment = $align : i64
              } : $mlir, !llvm.ptr
              macro.yield
            };
          }
        }
        // A `match` ending a function counts as its result; this keeps it a statement.
        return;
      }

      /// Stores `new` if the value is `current`. Answers `Ok` with the old value when it
      /// stored, `Err` with the value it found when it did not.
      fn compare_exchange(self : &$name, current : $t, new : $t, success : AtomicOrdering, failure : AtomicOrdering) -> Result<$t, $t> {
        let old = self.core_atomic_cmpxchg(current, new, core_atomic_cas_order(success, failure));
        if old == current {
          return Result<$t, $t>::Ok(old);
        }
        return Result<$t, $t>::Err(old);
      }

      /// `compare_exchange`. Rust allows this one to fail even when the value matches; this
      /// one never does.
      fn compare_exchange_weak(self : &$name, current : $t, new : $t, success : AtomicOrdering, failure : AtomicOrdering) -> Result<$t, $t> {
        return self.compare_exchange(current, new, success, failure);
      }

      /// Replaces the value with `f(value)` until no other write gets in between, and answers
      /// `Ok` with the old value. If `f` answers `None`, stops and answers `Err` with the value.
      fn fetch_update(self : &$name, set_order : AtomicOrdering, fetch_order : AtomicOrdering, f : Closure1<$t, Option<$t>>) -> Result<$t, $t> {
        let call = f.func;
        let mut prev = self.load(fetch_order);
        loop {
          match call(f.env, prev) {
            Option<$t>::Some(next) => {
              match self.compare_exchange_weak(prev, next, set_order, fetch_order) {
                Result<$t, $t>::Ok(old) => {
                  return Result<$t, $t>::Ok(old);
                }
                Result<$t, $t>::Err(seen) => {
                  prev = seen;
                }
              }
            }
            Option<$t>::None => {
              return Result<$t, $t>::Err(prev);
            }
          }
        }
        // The loop only ends by returning; the checker does not know that.
        return Result<$t, $t>::Err(prev);
      }

      /// One `llvm.cmpxchg` at `order`, answering the value it found. The failure ordering
      /// is the strongest one `order` allows.
      fn core_atomic_cmpxchg(self : &$name, current : $t, new : $t, order : AtomicOrdering) -> $t {
        match order {
          AtomicOrdering::Relaxed => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["llvm"]) {
              %s = llvm.cmpxchg %p, %c, %n monotonic monotonic : !llvm.ptr, $mlir
              %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::Release => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["llvm"]) {
              %s = llvm.cmpxchg %p, %c, %n release monotonic : !llvm.ptr, $mlir
              %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::Acquire => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["llvm"]) {
              %s = llvm.cmpxchg %p, %c, %n acquire acquire : !llvm.ptr, $mlir
              %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::AcqRel => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["llvm"]) {
              %s = llvm.cmpxchg %p, %c, %n acq_rel acquire : !llvm.ptr, $mlir
              %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
              macro.yield %r : $mlir
            };
          }
          AtomicOrdering::SeqCst => {
            return mlir!( inputs : (%p = self.v.get() : !llvm.ptr, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["llvm"]) {
              %s = llvm.cmpxchg %p, %c, %n seq_cst seq_cst : !llvm.ptr, $mlir
              %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
              macro.yield %r : $mlir
            };
          }
        }
      }
    }

    impl Default for $name {
      /// An atomic holding zero.
      fn default() -> $name {
        return $name {
          v : SharedCell<$t>::new(0)
        };
      }
    }

    impl From<$t> for $name {
      /// `new`.
      fn from(value : $t) -> $name {
        return $name {
          v : SharedCell<$t>::new(value)
        };
      }
    }
  };
}

/// Stamps the methods every atomic integer has, signed or not.
macro_rules stamp_atomic_int_rmw {
  ($name : ident , $t : ident , $mlir : ident) => {
    stamp_atomic_rmw!($name , $t , $mlir , swap , xchg);
    stamp_atomic_rmw!($name , $t , $mlir , fetch_add , add);
    stamp_atomic_rmw!($name , $t , $mlir , fetch_sub , sub);
    stamp_atomic_rmw!($name , $t , $mlir , fetch_and , _and);
    stamp_atomic_rmw!($name , $t , $mlir , fetch_nand , nand);
    stamp_atomic_rmw!($name , $t , $mlir , fetch_or , _or);
    stamp_atomic_rmw!($name , $t , $mlir , fetch_xor , _xor);
  };
}

stamp_atomic_int!(AtomicI8 , i8 , i8 , 1);
stamp_atomic_int!(AtomicI16 , i16 , i16 , 2);
stamp_atomic_int!(AtomicI32 , i32 , i32 , 4);
stamp_atomic_int!(AtomicI64 , i64 , i64 , 8);
stamp_atomic_int!(AtomicU8 , u8 , i8 , 1);
stamp_atomic_int!(AtomicU16 , u16 , i16 , 2);
stamp_atomic_int!(AtomicU32 , u32 , i32 , 4);
stamp_atomic_int!(AtomicU64 , u64 , i64 , 8);
stamp_atomic_int!(AtomicUsize , usize , i64 , 8);

stamp_atomic_int_rmw!(AtomicI8 , i8 , i8);
stamp_atomic_int_rmw!(AtomicI16 , i16 , i16);
stamp_atomic_int_rmw!(AtomicI32 , i32 , i32);
stamp_atomic_int_rmw!(AtomicI64 , i64 , i64);
stamp_atomic_int_rmw!(AtomicU8 , u8 , i8);
stamp_atomic_int_rmw!(AtomicU16 , u16 , i16);
stamp_atomic_int_rmw!(AtomicU32 , u32 , i32);
stamp_atomic_int_rmw!(AtomicU64 , u64 , i64);
stamp_atomic_int_rmw!(AtomicUsize , usize , i64);

// `fetch_max` and `fetch_min` compare with the sign on the signed widths and without it on
// the unsigned ones.
stamp_atomic_rmw!(AtomicI8 , i8 , i8 , fetch_max , max);
stamp_atomic_rmw!(AtomicI8 , i8 , i8 , fetch_min , min);
stamp_atomic_rmw!(AtomicI16 , i16 , i16 , fetch_max , max);
stamp_atomic_rmw!(AtomicI16 , i16 , i16 , fetch_min , min);
stamp_atomic_rmw!(AtomicI32 , i32 , i32 , fetch_max , max);
stamp_atomic_rmw!(AtomicI32 , i32 , i32 , fetch_min , min);
stamp_atomic_rmw!(AtomicI64 , i64 , i64 , fetch_max , max);
stamp_atomic_rmw!(AtomicI64 , i64 , i64 , fetch_min , min);
stamp_atomic_rmw!(AtomicU8 , u8 , i8 , fetch_max , umax);
stamp_atomic_rmw!(AtomicU8 , u8 , i8 , fetch_min , umin);
stamp_atomic_rmw!(AtomicU16 , u16 , i16 , fetch_max , umax);
stamp_atomic_rmw!(AtomicU16 , u16 , i16 , fetch_min , umin);
stamp_atomic_rmw!(AtomicU32 , u32 , i32 , fetch_max , umax);
stamp_atomic_rmw!(AtomicU32 , u32 , i32 , fetch_min , umin);
stamp_atomic_rmw!(AtomicU64 , u64 , i64 , fetch_max , umax);
stamp_atomic_rmw!(AtomicU64 , u64 , i64 , fetch_min , umin);
stamp_atomic_rmw!(AtomicUsize , usize , i64 , fetch_max , umax);
stamp_atomic_rmw!(AtomicUsize , usize , i64 , fetch_min , umin);

/// A `bool` that can be read and changed atomically. It is held as an `AtomicU8` that is
/// always 0 or 1, since LLVM has no atomic operation on a single bit.
struct AtomicBool {
  v : AtomicU8,
}

/// 1 for `true`, 0 for `false`.
fn core_atomic_bool_byte(b : bool) -> u8 {
  if b {
    return 1;
  }
  return 0;
}

impl AtomicBool {
  /// A new atomic holding `v`.
  fn new(v : bool) -> AtomicBool {
    return AtomicBool {
      v : AtomicU8::new(core_atomic_bool_byte(v))
    };
  }

  /// The value, which is no longer atomic.
  fn into_inner(self : AtomicBool) -> bool {
    return self.v.into_inner() != 0;
  }

  /// Reads the value. `order` cannot be `Release` or `AcqRel`.
  fn load(self : &AtomicBool, order : AtomicOrdering) -> bool {
    return self.v.load(order) != 0;
  }

  /// Writes `val`. `order` cannot be `Acquire` or `AcqRel`.
  fn store(self : &AtomicBool, val : bool, order : AtomicOrdering) -> void {
    self.v.store(core_atomic_bool_byte(val), order);
  }

  /// Writes `val` and answers the old value.
  fn swap(self : &AtomicBool, val : bool, order : AtomicOrdering) -> bool {
    return self.v.swap(core_atomic_bool_byte(val), order) != 0;
  }

  /// Stores `new` if the value is `current`. Answers `Ok` with the old value when it
  /// stored, `Err` with the value it found when it did not.
  fn compare_exchange(self : &AtomicBool, current : bool, new : bool, success : AtomicOrdering, failure : AtomicOrdering) -> Result<bool, bool> {
    let old = self.v.core_atomic_cmpxchg(core_atomic_bool_byte(current), core_atomic_bool_byte(new), core_atomic_cas_order(success, failure)) != 0;
    if old == current {
      return Result<bool, bool>::Ok(old);
    }
    return Result<bool, bool>::Err(old);
  }

  /// `compare_exchange`, which never fails spuriously.
  fn compare_exchange_weak(self : &AtomicBool, current : bool, new : bool, success : AtomicOrdering, failure : AtomicOrdering) -> Result<bool, bool> {
    return self.compare_exchange(current, new, success, failure);
  }

  /// Logical and with `val`; answers the old value.
  fn fetch_and(self : &AtomicBool, val : bool, order : AtomicOrdering) -> bool {
    return self.v.fetch_and(core_atomic_bool_byte(val), order) != 0;
  }

  /// Logical or with `val`; answers the old value.
  fn fetch_or(self : &AtomicBool, val : bool, order : AtomicOrdering) -> bool {
    return self.v.fetch_or(core_atomic_bool_byte(val), order) != 0;
  }

  /// Logical exclusive or with `val`; answers the old value.
  fn fetch_xor(self : &AtomicBool, val : bool, order : AtomicOrdering) -> bool {
    return self.v.fetch_xor(core_atomic_bool_byte(val), order) != 0;
  }

  /// Sets the value to `!(old && val)`; answers the old value. A byte `nand` would leave 254,
  /// so this is an exclusive or with `true` when `val` is true, and a store of `true` when not.
  fn fetch_nand(self : &AtomicBool, val : bool, order : AtomicOrdering) -> bool {
    if val {
      return self.v.fetch_xor(1, order) != 0;
    }
    return self.v.swap(1, order) != 0;
  }

  /// Flips the value; answers the old one.
  fn fetch_not(self : &AtomicBool, order : AtomicOrdering) -> bool {
    return self.v.fetch_xor(1, order) != 0;
  }
}

impl Default for AtomicBool {
  /// An atomic holding `false`.
  fn default() -> AtomicBool {
    return AtomicBool::new(false);
  }
}

impl From<bool> for AtomicBool {
  /// `new`.
  fn from(value : bool) -> AtomicBool {
    return AtomicBool::new(value);
  }
}

/// Orders the memory operations before it with those after it, for every thread.
/// `order` cannot be `Relaxed`.
fn fence(order : AtomicOrdering) -> void {
  assert(core_atomic_fence_order_ok(order), "fence: the ordering cannot be Relaxed");
  match order {
    AtomicOrdering::Release => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence release
        macro.yield
      };
    }
    AtomicOrdering::Acquire => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence acquire
        macro.yield
      };
    }
    AtomicOrdering::AcqRel => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence acq_rel
        macro.yield
      };
    }
    AtomicOrdering::SeqCst => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence seq_cst
        macro.yield
      };
    }
    AtomicOrdering::Relaxed => {}
  }
  return;
}

/// Which threads a `scoped_fence` orders memory for. A smaller scope is a cheaper fence.
enum FenceScope {
  // The passes of one block of an `across` loop.
  Block,
  // Every thread on the device, which is what a kernel usually needs.
  Device,
  // Every thread in the system, the host too. This is what `fence` does.
  System,
}

impl Copy for FenceScope {}

/// `fence`, for the threads of `scope` only. It runs where its caller runs, and it writes no
/// memory, so the passes of an `across` loop may call it. `order` cannot be `Relaxed`. On a CPU,
/// LLVM gives every scope the fence for the whole system, which is stronger.
fn scoped_fence<D : Topology>(order : AtomicOrdering, scope : FenceScope) on Topology::D -> void
ensures writes_only()
{
  assert(core_atomic_fence_order_ok(order), "scoped_fence: the ordering cannot be Relaxed");
  match scope {
    FenceScope::Block => {
      match order {
        AtomicOrdering::Release => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("block") release
            macro.yield
          };
        }
        AtomicOrdering::Acquire => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("block") acquire
            macro.yield
          };
        }
        AtomicOrdering::AcqRel => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("block") acq_rel
            macro.yield
          };
        }
        AtomicOrdering::SeqCst => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("block") seq_cst
            macro.yield
          };
        }
        AtomicOrdering::Relaxed => {}
      }
    }
    FenceScope::Device => {
      match order {
        AtomicOrdering::Release => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("device") release
            macro.yield
          };
        }
        AtomicOrdering::Acquire => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("device") acquire
            macro.yield
          };
        }
        AtomicOrdering::AcqRel => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("device") acq_rel
            macro.yield
          };
        }
        AtomicOrdering::SeqCst => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence syncscope("device") seq_cst
            macro.yield
          };
        }
        AtomicOrdering::Relaxed => {}
      }
    }
    FenceScope::System => {
      match order {
        AtomicOrdering::Release => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence release
            macro.yield
          };
        }
        AtomicOrdering::Acquire => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence acquire
            macro.yield
          };
        }
        AtomicOrdering::AcqRel => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence acq_rel
            macro.yield
          };
        }
        AtomicOrdering::SeqCst => {
          mlir!( inputs : (), dialects : ["llvm"], ensures : [writes_only()]) {
            llvm.fence seq_cst
            macro.yield
          };
        }
        AtomicOrdering::Relaxed => {}
      }
    }
  }
  return;
}

/// `fence`, for the current thread only: it stops the compiler from moving memory operations
/// across it and emits no instruction. `order` cannot be `Relaxed`.
fn compiler_fence(order : AtomicOrdering) -> void {
  assert(core_atomic_fence_order_ok(order), "compiler_fence: the ordering cannot be Relaxed");
  match order {
    AtomicOrdering::Release => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence syncscope("singlethread") release
        macro.yield
      };
    }
    AtomicOrdering::Acquire => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence syncscope("singlethread") acquire
        macro.yield
      };
    }
    AtomicOrdering::AcqRel => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence syncscope("singlethread") acq_rel
        macro.yield
      };
    }
    AtomicOrdering::SeqCst => {
      mlir!( inputs : (), dialects : ["llvm"]) {
        llvm.fence syncscope("singlethread") seq_cst
        macro.yield
      };
    }
    AtomicOrdering::Relaxed => {}
  }
  return;
}

// Atomic operations on one element of a tensor, for GPU kernels and for host code. A tensor element
// is a plain number, so these are functions that take the tensor and an index. `ensures atomic(t)`
// says that each one changes `t` only with an atomic operation, so the race proof of an `across`
// loop accepts many passes that call them on one tensor, and refuses a plain access to it there.
// `<M : Memory>` takes a tensor in any memory, and `on Topology::D` runs where the caller runs.
//
// Each one answers the value from before the change. An index outside the tensor fails an
// `assert`. Each function is stamped for `i32`, `u32`, `i64`, `u64`, `f32` and `f64`, and the name
// ends with the type: `atomic_fetch_add_u32`.

/// Stamps the length, load and store for tensors of `$t`. `$mlir` is the MLIR type of `$t`, and
/// `$align` its size in bytes.
macro_rules stamp_element_atomics {
  ($t : ident , $mlir : ident , $align : expr , $len : ident , $load : ident , $store : ident) => {
    /// The number of elements of `t`. It reads no element.
    fn $len<M : Memory, D : Topology>(t : &Tensor<$t, [?], Memory::M>) on Topology::D -> i32
    ensures atomic(t)
    {
      return mlir!( inputs : (%t = t : memref<?x$mlir>), returns : i32, dialects : ["memref", "arith"], ensures : [atomic(t)]) {
        %c0 = arith.constant 0 : index
        %d = memref.dim %t, %c0 : memref<?x$mlir>
        %n = arith.index_cast %d : index to i32
        macro.yield %n : i32
      };
    }

    /// Reads `t[i]`. `order` cannot be `Release` or `AcqRel`.
    fn $load<M : Memory, D : Topology>(t : &Tensor<$t, [?], Memory::M>, i : i32, order : AtomicOrdering) on Topology::D -> $t
    ensures atomic(t)
    {
      assert(i >= 0 && i < $len(t), "atomic load: the index is outside the tensor");
      assert(core_atomic_load_order_ok(order), "atomic load: the ordering cannot be Release or AcqRel");
      match order {
        AtomicOrdering::Relaxed => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.load %p atomic monotonic {
              alignment = $align : i64
            } : !llvm.ptr -> $mlir
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::Acquire => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.load %p atomic acquire {
              alignment = $align : i64
            } : !llvm.ptr -> $mlir
            macro.yield %r : $mlir
          };
        }
        _ => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.load %p atomic seq_cst {
              alignment = $align : i64
            } : !llvm.ptr -> $mlir
            macro.yield %r : $mlir
          };
        }
      }
    }

    /// Writes `val` to `t[i]`. `order` cannot be `Acquire` or `AcqRel`.
    fn $store<M : Memory, D : Topology>(t : &Tensor<$t, [?], Memory::M>, i : i32, val : $t, order : AtomicOrdering) on Topology::D -> void
    ensures atomic(t)
    {
      assert(i >= 0 && i < $len(t), "atomic store: the index is outside the tensor");
      assert(core_atomic_store_order_ok(order), "atomic store: the ordering cannot be Acquire or AcqRel");
      match order {
        AtomicOrdering::Relaxed => {
          mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            llvm.store %x, %p atomic monotonic {
              alignment = $align : i64
            } : $mlir, !llvm.ptr
            macro.yield
          };
        }
        AtomicOrdering::Release => {
          mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            llvm.store %x, %p atomic release {
              alignment = $align : i64
            } : $mlir, !llvm.ptr
            macro.yield
          };
        }
        _ => {
          mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            llvm.store %x, %p atomic seq_cst {
              alignment = $align : i64
            } : $mlir, !llvm.ptr
            macro.yield
          };
        }
      }
      // A `match` ending a function counts as its result. This keeps it a statement.
      return;
    }
  };
}

/// Stamps the compare-and-swap for tensors of `$t`. LLVM has one only for integers.
macro_rules stamp_element_cas {
  ($t : ident , $mlir : ident , $len : ident , $cas : ident) => {
    /// Writes `new` to `t[i]` if it holds `current`, and answers the value it found. So it wrote
    /// when the answer is `current`. The failure ordering is the strongest one `order` allows.
    fn $cas<M : Memory, D : Topology>(t : &Tensor<$t, [?], Memory::M>, i : i32, current : $t, new : $t, order : AtomicOrdering) on Topology::D -> $t
    ensures atomic(t)
    {
      assert(i >= 0 && i < $len(t), "atomic compare_and_swap: the index is outside the tensor");
      match order {
        AtomicOrdering::Relaxed => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %s = llvm.cmpxchg %p, %c, %n monotonic monotonic : !llvm.ptr, $mlir
            %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::Release => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %s = llvm.cmpxchg %p, %c, %n release monotonic : !llvm.ptr, $mlir
            %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::Acquire => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %s = llvm.cmpxchg %p, %c, %n acquire acquire : !llvm.ptr, $mlir
            %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::AcqRel => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %s = llvm.cmpxchg %p, %c, %n acq_rel acquire : !llvm.ptr, $mlir
            %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::SeqCst => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %c = current : $mlir, %n = new : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %s = llvm.cmpxchg %p, %c, %n seq_cst seq_cst : !llvm.ptr, $mlir
            %r = llvm.extractvalue %s[0] : !llvm.struct<($mlir, i1)>
            macro.yield %r : $mlir
          };
        }
      }
    }
  };
}

/// Stamps one read-modify-write function `$name` on tensors of `$t`. `$op` is the
/// `llvm.atomicrmw` operation and `$len` the length function of `$t`.
macro_rules stamp_element_rmw {
  ($name : ident , $t : ident , $mlir : ident , $len : ident , $op : ident) => {
    fn $name<M : Memory, D : Topology>(t : &Tensor<$t, [?], Memory::M>, i : i32, val : $t, order : AtomicOrdering) on Topology::D -> $t
    ensures atomic(t)
    {
      assert(i >= 0 && i < $len(t), "atomic read-modify-write: the index is outside the tensor");
      match order {
        AtomicOrdering::Relaxed => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.atomicrmw $op %p, %x monotonic : !llvm.ptr, $mlir
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::Release => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.atomicrmw $op %p, %x release : !llvm.ptr, $mlir
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::Acquire => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.atomicrmw $op %p, %x acquire : !llvm.ptr, $mlir
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::AcqRel => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.atomicrmw $op %p, %x acq_rel : !llvm.ptr, $mlir
            macro.yield %r : $mlir
          };
        }
        AtomicOrdering::SeqCst => {
          return mlir!( inputs : (%t = t : memref<?x$mlir>, %i = i : i32, %x = val : $mlir), returns : $t, dialects : ["memref", "arith", "llvm"], ensures : [atomic(t)]) {
            %a = memref.extract_aligned_pointer_as_index %t : memref<?x$mlir> -> index
            %b, %off, %sz, %st = memref.extract_strided_metadata %t : memref<?x$mlir> -> memref<$mlir>, index, index, index
            %ai = arith.index_cast %a : index to i64
            %base = llvm.inttoptr %ai : i64 to !llvm.ptr
            %oi = arith.index_cast %off : index to i64
            %i64 = arith.extsi %i : i32 to i64
            %k = arith.addi %oi, %i64 : i64
            %p = llvm.getelementptr %base[%k] : (!llvm.ptr, i64) -> !llvm.ptr, $mlir
            %r = llvm.atomicrmw $op %p, %x seq_cst : !llvm.ptr, $mlir
            macro.yield %r : $mlir
          };
        }
      }
    }
  };
}

stamp_element_atomics!(i32 , i32 , 4 , core_atomic_len_i32 , atomic_load_i32 , atomic_store_i32);
stamp_element_cas!(i32 , i32 , core_atomic_len_i32 , atomic_compare_and_swap_i32);
stamp_element_rmw!(atomic_swap_i32 , i32 , i32 , core_atomic_len_i32 , xchg);
stamp_element_rmw!(atomic_fetch_add_i32 , i32 , i32 , core_atomic_len_i32 , add);
stamp_element_rmw!(atomic_fetch_sub_i32 , i32 , i32 , core_atomic_len_i32 , sub);
stamp_element_rmw!(atomic_fetch_max_i32 , i32 , i32 , core_atomic_len_i32 , max);
stamp_element_rmw!(atomic_fetch_min_i32 , i32 , i32 , core_atomic_len_i32 , min);

