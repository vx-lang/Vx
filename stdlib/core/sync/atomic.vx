stamp_element_rmw!(atomic_fetch_min_f64 , f64 , f64 , core_atomic_len_f64 , fmin);

// Adds 1, or writes 0 when the old value is `val` or more, so the element counts from 0 to `val`
// and starts again. NVPTX has one instruction for it, `atom.inc`, which the GPU does not merge
// across the lanes of a subgroup as it does an add.
stamp_element_rmw!(atomic_fetch_inc_wrap_u32 , u32 , i32 , core_atomic_len_u32 , uinc_wrap);
