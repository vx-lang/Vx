// Hints to the optimizer.
//
// Not here yet: `black_box` needs an opaque operation over any type, which `mlir!` cannot
// name for a type parameter; `spin_loop` is `pause` on x86 and `yield` on ARM, and `core`
// has no way yet to pick an instruction by target; `unreachable_unchecked` is not written yet.

/// Tells the optimizer that `cond` is true, so it may drop checks that follow from it.
/// Nothing checks it: if `cond` is false, the program's behaviour is undefined.
pub unsafe fn assert_unchecked(cond : bool) -> void {
  let _kept : bool = mlir!( inputs : (%c = cond : i1), returns : bool, dialects : ["llvm"]) {
    llvm.intr.assume %c : i1
    macro.yield %c : i1
  };
}

/// Returns `value` unchanged, marking a value that should not be ignored.
pub fn must_use<T>(value : T) -> T {
  return value;
}

/// Asks the processor to bring the cache line at `p` into the cache closest to it (locality 3),
/// because the program will read it soon. It is only a hint: it does not load a value from `*p`,
/// and it does not change what the program computes. A prefetch never faults, even when `p` is
/// null or is not a valid address, so the function is safe.
pub fn prefetch_read<T, M : Memory>(p : *const T in Memory::M) -> void {
  let _p : *const T in Memory::M = unsafe { mlir!( inputs : (%p = p : !llvm.ptr), returns : *const T in Memory::M, dialects : ["llvm"]) {
      "llvm.intr.prefetch"(%p) < {
        rw = 0 : i32, hint = 3 : i32, cache = 1 : i32
      }> : (!llvm.ptr) -> ()
      macro.yield %p : !llvm.ptr
    } };
}

/// `prefetch_read` for a line that the program will write soon. When the target CPU has a write
/// prefetch (`prefetchw` on x86), it fetches the line ready for a write. It is also safe: a
/// prefetch never faults.
pub fn prefetch_write<T, M : Memory>(p : *mut T in Memory::M) -> void {
  let _p : *mut T in Memory::M = unsafe { mlir!( inputs : (%p = p : !llvm.ptr), returns : *mut T in Memory::M, dialects : ["llvm"]) {
      "llvm.intr.prefetch"(%p) < {
        rw = 1 : i32, hint = 3 : i32, cache = 1 : i32
      }> : (!llvm.ptr) -> ()
      macro.yield %p : !llvm.ptr
    } };
}

/// `true_val` if `condition` holds, otherwise `false_val`. Both are already computed, so
/// the answer can be a select rather than a branch the processor must predict.
pub fn select_unpredictable<T>(condition : bool, true_val : T, false_val : T) -> T {
  if condition {
    return true_val;
  }
  return false_val;
}
