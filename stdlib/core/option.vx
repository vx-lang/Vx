// `Option<T>`, for a value that may be absent.
//
// Moved here from `std::option`, unchanged apart from the extra methods below and the
// removal of an `import std::alloc` that nothing in the file used. It belongs in `core`
// because it needs no allocator and no operating system: it is one enum and a handful of
// matches, and the rest of `core` is written against it -- `Iterator::next` returns one,
// and so will every `checked_` method in `core::num`.
//
// Every method here answers with a `T` or a `bool`, and that is the whole of what can be
// written today rather than a choice. A method on `Option<T>` that *returns* an
// `Option<T>` does not lower: the monomorphizer leaves the return type as the parameter
// and codegen stops with "generic type reached codegen". That is true even of one that
// builds nothing and simply hands back whichever argument it was given, so it is not
// about constructing a value.
//
// So `or`, `and`, `xor`, `filter`, `take` and `replace` are all out, alongside `map`,
// `and_then` and `ok_or`, which additionally want a type parameter of their own. Roughly
// half of Rust's `Option` surface waits on that one compiler gap.

enum Option<T> {
  Some(T),
  None,
}

impl<T> Option<T> {
  /// Is there a value?
  fn is_some(self : &Option<T>) -> Bool {
    let mut ret = false;
    match *self {
      Option<T>::Some(v) => {
        ret = true;
      }
      Option<T>::None() => {
        ret = false;
      }
    }
    return ret;
  }

  /// Is there no value?
  fn is_none(self : &Option<T>) -> Bool {
    let mut ret = true;
    match *self {
      Option<T>::Some(v) => {
        ret = false;
      }
      Option<T>::None() => {
        ret = true;
      }
    }
    return ret;
  }

  /// The value, or a stop. Reach for `unwrap_or` where there is a sensible answer for
  /// the absent case; this one ends the program.
  fn unwrap(self : Option<T>) -> T {
    match self {
      Option<T>::Some(v) => {
        return v;
      }
      Option<T>::None() => {
        let is_some = self.is_some();
        assert(is_some, "unwrap called on None");
      }
    }
  }

  /// The value, or the given one. `default` is evaluated by the caller either way, so
  /// keep it cheap; Rust's `unwrap_or_else` is the form that does not, and it takes a
  /// closure whose type parameter this cannot yet spell.
  fn unwrap_or(self : Option<T>, default : T) -> T {
    match self {
      Option<T>::Some(v) => {
        return v;
      }
      Option<T>::None() => {
        return default;
      }
    }
  }

}
