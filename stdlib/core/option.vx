// `Option<T>`, for a value that may be absent.
//
// Moved here from `std::option`, unchanged apart from the extra methods below and the
// removal of an `import std::alloc` that nothing in the file used. It belongs in `core`
// because it needs no allocator and no operating system: it is one enum and a handful of
// matches, and the rest of `core` is written against it -- `Iterator::next` returns one,
// and so will every `checked_` method in `core::num`.
//
// `ok_or`, `ok_or_else` and `transpose` are here in spirit but live in `core::result`,
// because that module already imports this one and importing it back would be a cycle.
//
// Still missing, each waiting on something outside this file:
//
//   `expect`               `assert` wants a string literal, so a message parameter cannot
//                          be handed to it (Vx#526).
//   `unwrap_or_default`    `T::default()` on a bounded type parameter is not resolved.
//   `inspect`              no closure literal can return void (Vx#711).
//   `flatten`              wants `Option<Option<T>>` to lower.
//   `as_ref`, `as_mut`,    each answers with a reference into the option, and `iter` needs
//   `iter`, `insert`,      `core::iter` besides.
//   `get_or_insert`
//
// A closure is called by hand -- `let p = f.func; p(f.env, v)` -- since there is no call
// syntax for one yet.

import core::marker;
import core::ops;

enum Option<T> {
  Some(T),
  None,
}

/// An option copies when what it may hold copies, which is Rust's rule. It buys nothing
/// yet: a generic enum is not treated as linear, so an `Option` survives a move whether or
/// not this is written (Vx#715). It is here to be right when that is fixed.
impl<T : Copy> Copy for Option<T> {}

impl<T> Option<T> {
  /// Is there a value?
  fn is_some(self : &Option<T>) -> Bool {
    let mut ret = false;
    match *self {
      Option<T>::Some(v) => {
        ret = true;
      }
      Option<T>::None() => {
        ret = false;
      }
    }
    return ret;
  }

  /// Is there no value?
  fn is_none(self : &Option<T>) -> Bool {
    let mut ret = true;
    match *self {
      Option<T>::Some(v) => {
        ret = false;
      }
      Option<T>::None() => {
        ret = true;
      }
    }
    return ret;
  }

  /// The value, or a stop. Reach for `unwrap_or` where there is a sensible answer for
  /// the absent case; this one ends the program.
  fn unwrap(self : Option<T>) -> T {
    match self {
      Option<T>::Some(v) => {
        return v;
      }
      Option<T>::None() => {
        let is_some = self.is_some();
        assert(is_some, "unwrap called on None");
      }
    }
  }

  /// The value, or the given one. `default` is evaluated by the caller either way, so
  /// keep it cheap; Rust's `unwrap_or_else` is the form that does not, and it takes a
  /// closure whose type parameter this cannot yet spell.
  fn unwrap_or(self : Option<T>, default : T) -> T {
    match self {
      Option<T>::Some(v) => {
        return v;
      }
      Option<T>::None() => {
        return default;
      }
    }
  }

  /// This one if it holds a value, otherwise the other. Both sides are the same type,
  /// which is why this fits while `and_then` does not.
  fn or(self : Option<T>, other : Option<T>) -> Option<T> {
    match self {
      Option<T>::Some(v) => {
        return Option<T>::Some(v);
      }
      Option<T>::None() => {
        return other;
      }
    }
  }

  /// The other one if this holds a value, otherwise nothing.
  fn and(self : Option<T>, other : Option<T>) -> Option<T> {
    match self {
      Option<T>::Some(v) => {
        return other;
      }
      Option<T>::None() => {
        return Option<T>::None();
      }
    }
  }

  /// Whichever one holds a value, and nothing when both do or neither does.
  fn xor(self : Option<T>, other : Option<T>) -> Option<T> {
    let left = self.is_some();
    let right = other.is_some();
    if left && right {
      return Option<T>::None();
    }
    if left {
      return self;
    }
    if right {
      return other;
    }
    return Option<T>::None();
  }

  /// The value with `f` applied, if there is one.
  fn map<U>(self : Option<T>, f : Closure1<T, U>) -> Option<U> {
    match self {
      Option<T>::Some(v) => {
        let p = f.func;
        return Option<U>::Some(p(f.env, v));
      }
      Option<T>::None() => {
        return Option<U>::None();
      }
    }
  }

  /// `map` for an `f` that answers with an `Option` of its own, without the nesting.
  fn and_then<U>(self : Option<T>, f : Closure1<T, Option<U>>) -> Option<U> {
    match self {
      Option<T>::Some(v) => {
        let p = f.func;
        return p(f.env, v);
      }
      Option<T>::None() => {
        return Option<U>::None();
      }
    }
  }

  /// Both values as a pair when both are there, otherwise nothing.
  fn zip<U>(self : Option<T>, other : Option<U>) -> Option<(T, U)> {
    if self.is_some() && other.is_some() {
      return Option<(T, U)>::Some((self.unwrap(), other.unwrap()));
    }
    return Option<(T, U)>::None();
  }

  /// The value if it is there and `p` accepts it, otherwise nothing.
  fn filter(self : Option<T>, p : Closure1<T, bool>) -> Option<T> {
    match self {
      Option<T>::Some(v) => {
        let f = p.func;
        if f(p.env, v) {
          return Option<T>::Some(v);
        }
        return Option<T>::None();
      }
      Option<T>::None() => {
        return Option<T>::None();
      }
    }
  }

  /// `f` applied to the value, or the given answer when there is none. Both are the same
  /// type, which is what separates this from `map`.
  fn map_or<U>(self : Option<T>, default : U, f : Closure1<T, U>) -> U {
    match self {
      Option<T>::Some(v) => {
        let p = f.func;
        return p(f.env, v);
      }
      Option<T>::None() => {
        return default;
      }
    }
  }

  /// The value, or the answer `f` gives. Unlike `unwrap_or`, nothing is computed when
  /// there is a value.
  fn unwrap_or_else(self : Option<T>, f : Closure0<T>) -> T {
    match self {
      Option<T>::Some(v) => {
        return v;
      }
      Option<T>::None() => {
        let p = f.func;
        return p(f.env);
      }
    }
  }

  /// Is there a value, and does `p` accept it?
  fn is_some_and(self : Option<T>, p : Closure1<T, bool>) -> bool {
    match self {
      Option<T>::Some(v) => {
        let f = p.func;
        return f(p.env, v);
      }
      Option<T>::None() => {
        return false;
      }
    }
  }

  /// Is there no value, or does `p` accept the one there is? The mirror of `is_some_and`.
  fn is_none_or(self : Option<T>, p : Closure1<T, bool>) -> bool {
    match self {
      Option<T>::Some(v) => {
        let f = p.func;
        return f(p.env, v);
      }
      Option<T>::None() => {
        return true;
      }
    }
  }

  /// This one if it holds a value, otherwise what `f` gives. `or` is the form that
  /// evaluates the other side either way.
  fn or_else(self : Option<T>, f : Closure0<Option<T>>) -> Option<T> {
    match self {
      Option<T>::Some(v) => {
        return Option<T>::Some(v);
      }
      Option<T>::None() => {
        let p = f.func;
        return p(f.env);
      }
    }
  }

  /// `f` applied to the value, or what `d` gives when there is none. `map_or` is the form
  /// that takes the fallback as a value.
  fn map_or_else<U>(self : Option<T>, d : Closure0<U>, f : Closure1<T, U>) -> U {
    match self {
      Option<T>::Some(v) => {
        let p = f.func;
        return p(f.env, v);
      }
      Option<T>::None() => {
        let q = d.func;
        return q(d.env);
      }
    }
  }

  /// The value, leaving nothing behind.
  fn take(self : &mut Option<T>) -> Option<T> {
    let old = *self;
    *self = Option<T>::None();
    return old;
  }

  /// The value, leaving `v` behind.
  fn replace(self : &mut Option<T>, v : T) -> Option<T> {
    let old = *self;
    *self = Option<T>::Some(v);
    return old;
  }
}
