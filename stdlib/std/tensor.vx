// This module provides standard library methods for the built-in Tensor type.
// Tensors are natively backed by MLIR memref operations in the compiler backend.

impl<T> Tensor<T> {
  // Fills the tensor with the given value.
  fn fill(self: Tensor<T>, value: T) -> Tensor<T> {
    mlir!(
    inputs: (%val = value: f32, %tensor = self: memref<?x?xf32>),
    clobbers: [],
    returns: Tensor<T>,
    dialects: ["linalg"]
    ) {
      linalg.fill ins(%val: f32) outs(%tensor: memref<?x?xf32>)
      return %tensor : memref<?x?xf32>
    }
  }
}
