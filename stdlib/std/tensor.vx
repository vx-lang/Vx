import core::num;

/// A floating-point element type, the only kind these tensor methods are written for.
trait Float {}

impl Float for f16 {}
impl Float for bf16 {}
impl Float for f32 {}
impl Float for f64 {}

/// Stamps the element-wise operations over a 1-D tensor of one float width. Each changes
/// the tensor in place, so a chain of them allocates nothing. They are plain loops: with no
/// order to relax, the compiler turns them into vector code as they are. The `_assign` ones
/// stand in for `+=` and its kin, which Vx cannot overload yet.
macro_rules stamp_tensor_elementwise {
  ($t : ident) => {
    impl Tensor<$t, [?]> {
      /// Adds `other` to this tensor, element by element. Refused for different lengths.
      fn add_assign(self : &mut Tensor<$t, [?]>, other : &Tensor<$t, [?]>) -> void {
        assert(self.len() == other.len(), "add_assign needs two tensors of the same length");
        for i in 0..self.len() {
          self[i] = self[i] + other[i];
        }
      }

      /// Subtracts `other` from this tensor, element by element.
      fn sub_assign(self : &mut Tensor<$t, [?]>, other : &Tensor<$t, [?]>) -> void {
        assert(self.len() == other.len(), "sub_assign needs two tensors of the same length");
        for i in 0..self.len() {
          self[i] = self[i] - other[i];
        }
      }

      /// Multiplies this tensor by `other`, element by element.
      fn mul_assign(self : &mut Tensor<$t, [?]>, other : &Tensor<$t, [?]>) -> void {
        assert(self.len() == other.len(), "mul_assign needs two tensors of the same length");
        for i in 0..self.len() {
          self[i] = self[i] * other[i];
        }
      }

      /// Divides this tensor by `other`, element by element.
      fn div_assign(self : &mut Tensor<$t, [?]>, other : &Tensor<$t, [?]>) -> void {
        assert(self.len() == other.len(), "div_assign needs two tensors of the same length");
        for i in 0..self.len() {
          self[i] = self[i] / other[i];
        }
      }

      /// Adds `a` to every element.
      fn add_scalar(self : &mut Tensor<$t, [?]>, a : $t) -> void {
        for i in 0..self.len() {
          self[i] = self[i] + a;
        }
      }

      /// Multiplies every element by `a`.
      fn scale(self : &mut Tensor<$t, [?]>, a : $t) -> void {
        for i in 0..self.len() {
          self[i] = self[i] * a;
        }
      }

      /// Adds `a` times `x` to this tensor: BLAS's `axpy`. Refused for different lengths.
      fn scaled_add(self : &mut Tensor<$t, [?]>, a : $t, x : &Tensor<$t, [?]>) -> void {
        assert(self.len() == x.len(), "scaled_add needs two tensors of the same length");
        for i in 0..self.len() {
          self[i] = self[i] + a * x[i];
        }
      }

      /// Replaces every element by `f` of it. A call per element, so the named operations
      /// below are faster where one fits.
      fn map_inplace(self : &mut Tensor<$t, [?]>, f : Closure1<$t, $t>) -> void {
        let p = f.func;
        for i in 0..self.len() {
          self[i] = p(f.env, self[i]);
        }
      }

      /// Replaces every element by its absolute value.
      fn abs_inplace(self : &mut Tensor<$t, [?]>) -> void {
        for i in 0..self.len() {
          self[i] = self[i].abs();
        }
      }

      /// Replaces every element by its square root.
      fn sqrt_inplace(self : &mut Tensor<$t, [?]>) -> void {
        for i in 0..self.len() {
          self[i] = self[i].sqrt();
        }
      }

      /// Holds every element between `lo` and `hi`, as `clamp` on a number does.
      fn clamp_inplace(self : &mut Tensor<$t, [?]>, lo : $t, hi : $t) -> void {
        for i in 0..self.len() {
          self[i] = self[i].clamp(lo, hi);
        }
      }
    }
  };
}

stamp_tensor_elementwise!(f32);
stamp_tensor_elementwise!(f64);
stamp_tensor_elementwise!(f16);
stamp_tensor_elementwise!(bf16);

impl<T : Float> Tensor<T, [?, ?]> {
  /// A 1-by-`d1` tensor holding a copy of `d1` elements read from `ptr`.
  ///
  /// The elements are copied, so the tensor does not alias the buffer and outlives it. `ptr`
  /// must address `d1` elements; nothing here checks.
  fn from_ptr_1d(ptr: *mut T, d1: i32) -> Tensor<T, [?, ?]> {
    let mut t = Tensor<T>([ 1, d1 ]);
    for i in 0..d1 {
      unsafe { t[0][i] = ptr[i]; }
    }
    return t;
  }

  /// A `d1`-by-`d2` tensor holding a copy of `d1 * d2` elements read from `ptr` in row-major
  /// order. Copied, as `from_ptr_1d` is.
  fn from_ptr_2d(ptr: *mut T, d1: i32, d2: i32) -> Tensor<T, [?, ?]> {
    let mut t = Tensor<T>([ d1, d2 ]);
    for i in 0..d1 {
      for j in 0..d2 {
        unsafe { t[i][j] = ptr[i * d2 + j]; }
      }
    }
    return t;
  }

  /// A `d1`-by-`d2` tensor read from one row of this one, taken row-major from its start.
  ///
  /// **A copy, not a view.** Every `slice_` method here allocates and copies, so writing to
  /// the result does not touch the original and the cost is the elements moved, not constant.
  fn slice_2d(self: &Tensor<T, [?, ?]>, row: i32, d1: i32, d2: i32) -> Tensor<T, [?, ?]> {
    let mut t = Tensor<T>([ d1, d2 ]);
    for i in 0..d1 {
      for j in 0..d2 {
        unsafe { t[i][j] = self[row][i * d2 + j]; }
      }
    }
    return t;
  }

  /// A `d1`-by-`d2` tensor read from row 0 beginning at `start`, reshaped row-major. A copy.
  fn slice_2d_from_1d(self: &Tensor<T, [?, ?]>, start: i32, d1: i32, d2: i32) -> Tensor<T, [?, ?]> {
    let mut t = Tensor<T>([ d1, d2 ]);
    for i in 0..d1 {
      for j in 0..d2 {
        t[i][j] = self[0][start + i * d2 + j];
      }
    }
    return t;
  }

  /// A 1-by-`d1` tensor read from row 0 beginning at `start`. A copy.
  fn slice_1d(self: &Tensor<T, [?, ?]>, start: i32, d1: i32) -> Tensor<T, [?, ?]> {
    let mut t = Tensor<T>([ 1, d1 ]);
    for i in 0..d1 {
      t[0][i] = self[0][start + i];
    }
    return t;
  }

  // Fills the tensor with a constant value using Linalg
  /// Set every element to `val`.
  ///
  /// Lowered through `linalg`, with a separate path chosen at compile time for AVX-512.
  fn fill(self : &mut Tensor<T, [?, ?]>, val : T) -> void {
    mlir!(
    inputs: (%arg_t = self: memref<?x?xf32>, %arg_v = val: f32),
    clobbers: [self],
    dialects: ["linalg"]
    ) {
      linalg.fill ins(%arg_v : f32) outs(%arg_t : memref<?x?xf32>)
      macro.yield
    };
  }

  /// Overwrite this tensor's elements with `src`'s.
  ///
  /// Both must have the same shape; nothing here checks, and a mismatch reads or writes past
  /// an end.
  fn copy(self : &mut Tensor<T, [?, ?]>, src : &Tensor<T, [?, ?]>) -> void {
    if comptime
    Topology::Current == Topology::CPU_AVX512 {
      mlir!(
      inputs: (%dst = self: memref<?x?xf32>, %src = src: memref<?x?xf32>),
      clobbers: [self],
      dialects: ["linalg"]
      ) {
        linalg.copy ins(%src : memref<?x?xf32>) outs(%dst : memref<?x?xf32>)
        macro.yield
      };
    } else if comptime
    Topology::Current == Topology::ANE {
      mlir!(
      inputs: (%dst = self: memref<?x?xf32>, %src = src: memref<?x?xf32>),
      clobbers: [self],
      dialects: ["linalg"]
      ) {
        linalg.copy ins(%src : memref<?x?xf32>) outs(%dst : memref<?x?xf32>)
        macro.yield
      };
    } else {
      mlir!(
      inputs: (%dst = self: memref<?x?xf32>, %src = src: memref<?x?xf32>),
      clobbers: [self],
      dialects: ["linalg"]
      ) {
        linalg.copy ins(%src : memref<?x?xf32>) outs(%dst : memref<?x?xf32>)
        macro.yield
      };
    };
  }

  /// Set every element to `val`, as `fill` does. The two differ in the `linalg` form they
  /// emit, not in what they mean.
  fn assign(self : &mut Tensor<T, [?, ?]>, val : T) -> void {
    if comptime
    Topology::Current == Topology::CPU_AVX512 {
      mlir!(
      inputs: (%arg_t = self: memref<?x?xf32>, %arg_v = val: f32),
      clobbers: [self],
      dialects: ["linalg"]
      ) {
        linalg.fill ins(%arg_v : f32) outs(%arg_t : memref<?x?xf32>)
        macro.yield
      };
    } else if comptime
    Topology::Current == Topology::ANE {
      mlir!(
      inputs: (%arg_t = self: memref<?x?xf32>, %arg_v = val: f32),
      clobbers: [self],
      dialects: ["linalg"]
      ) {
        linalg.fill ins(%arg_v : f32) outs(%arg_t : memref<?x?xf32>)
        macro.yield
      };
    } else {
      mlir!(
      inputs: (%arg_t = self: memref<?x?xf32>, %arg_v = val: f32),
      clobbers: [self],
      dialects: ["linalg"]
      ) {
        linalg.fill ins(%arg_v : f32) outs(%arg_t : memref<?x?xf32>)
        macro.yield
      };
    };
  }

  /// Are the two tensors equal element by element?
  ///
  /// Exact equality, reduced over every element, so two tensors a rounding step apart answer
  /// false. A NaN anywhere makes the answer false, including against itself.
  fn compare(self : &Tensor<T, [?, ?]>, other : &Tensor<T, [?, ?]>) -> bool {
    if comptime
    Topology::Current == Topology::CPU_AVX512 {
      mlir!(
      inputs: (%lhs = self: memref<?x?xf32>, %rhs = other: memref<?x?xf32>),
      clobbers: [],
      returns: bool,
      dialects: ["linalg", "arith", "memref", "func"]
      ) {
        %true = arith.constant 1 : i1
        %res = memref.alloca() : memref<i1>
        memref.store %true, %res[] : memref<i1>
        linalg.generic {
          indexing_maps = [
          affine_map<(d0, d1) -> (d0, d1)>,
          affine_map<(d0, d1) -> (d0, d1)>,
          affine_map<(d0, d1) -> ()>
          ],
          iterator_types = ["reduction", "reduction"]
        } ins(%lhs, %rhs : memref<?x?xf32>, memref<?x?xf32>) outs(%res : memref<i1>) {
          ^bb0(%a: f32, %b: f32, %out: i1):
          %cmp = arith.cmpf oeq, %a, %b : f32
          %and = arith.andi %out, %cmp : i1
          linalg.yield %and : i1
        }
        %val = memref.load %res[] : memref<i1>
        func.return %val : i1
      }
    } else if comptime
    Topology::Current == Topology::ANE {
      mlir!(
      inputs: (%lhs = self: memref<?x?xf32>, %rhs = other: memref<?x?xf32>),
      clobbers: [],
      returns: bool,
      dialects: ["linalg", "arith", "memref", "func"]
      ) {
        %true = arith.constant 1 : i1
        %res = memref.alloca() : memref<i1>
        memref.store %true, %res[] : memref<i1>
        linalg.generic {
          indexing_maps = [
          affine_map<(d0, d1) -> (d0, d1)>,
          affine_map<(d0, d1) -> (d0, d1)>,
          affine_map<(d0, d1) -> ()>
          ],
          iterator_types = ["reduction", "reduction"]
        } ins(%lhs, %rhs : memref<?x?xf32>, memref<?x?xf32>) outs(%res : memref<i1>) {
          ^bb0(%a: f32, %b: f32, %out: i1):
          %cmp = arith.cmpf oeq, %a, %b : f32
          %and = arith.andi %out, %cmp : i1
          linalg.yield %and : i1
        }
        %val = memref.load %res[] : memref<i1>
        func.return %val : i1
      }
    } else {
      mlir!(
      inputs: (%lhs = self: memref<?x?xf32>, %rhs = other: memref<?x?xf32>),
      clobbers: [],
      returns: bool,
      dialects: ["linalg", "arith", "memref", "func"]
      ) {
        %true = arith.constant 1 : i1
        %res = memref.alloca() : memref<i1>
        memref.store %true, %res[] : memref<i1>
        linalg.generic {
          indexing_maps = [
          affine_map<(d0, d1) -> (d0, d1)>,
          affine_map<(d0, d1) -> (d0, d1)>,
          affine_map<(d0, d1) -> ()>
          ],
          iterator_types = ["reduction", "reduction"]
        } ins(%lhs, %rhs : memref<?x?xf32>, memref<?x?xf32>) outs(%res : memref<i1>) {
          ^bb0(%a: f32, %b: f32, %out: i1):
          %cmp = arith.cmpf oeq, %a, %b : f32
          %and = arith.andi %out, %cmp : i1
          linalg.yield %and : i1
        }
        %val = memref.load %res[] : memref<i1>
        func.return %val : i1
      }
    }
  }
}

impl<T : Float, const N : i32, const M : i32> Tensor<T, [N, M]> {
  // Fills the statically shaped tensor with a constant value using Linalg
  /// Set every element of a statically shaped tensor to `val`.
  ///
  /// The shape is known at compile time here, so the emitted loop has constant bounds.
  fn fill_static(self : &mut Tensor<T, [ N, M ]>, val : T) -> void {
    if comptime
    Topology::Current == Topology::CPU_AVX512 {
      // Demonstrate optimized code path for AVX512 (fallback to standard
      // Linalg for demonstration)
      mlir!(inputs : (% arg_t = self : memref<N x M x f32>,
      % arg_v = val : f32),
      clobbers : [self], dialects : ["linalg"]) {
        linalg
        .fill ins(% arg_v : f32) outs(% arg_t : memref<N x M x f32>)
        macro.yield};
    } else {
      mlir!(
      inputs : (% arg_t = self : memref<N x M x f32>, % arg_v = val : f32),
      clobbers : [self], dialects : ["linalg"]) {
        linalg
        .fill ins(% arg_v : f32) outs(% arg_t : memref<N x M x f32>)
        macro.yield};
    }
  }
}

/// Stamps the sums over a 1-D tensor of one float width: `sum`, `dot`, `mean` and `norm`.
///
/// The order the elements are combined in is left unspecified, which is what lets each one
/// be a vector loop: four accumulators of `$lanes` elements, combined at the end, then a
/// plain loop over the elements left over, so any length works. The result can differ in
/// the last bits from adding the elements one by one, and is usually closer to the exact
/// answer, since no running total grows much larger than what is added to it.
macro_rules stamp_tensor_sums {
  ($t : ident , $lanes : expr) => {
    impl Tensor<$t, [?]> {
      /// The sum of the elements. 0 for an empty tensor.
      fn sum(self : &Tensor<$t, [?]>) -> $t {
        return mlir!( inputs : (%a = self : memref<?x$t>), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x $t>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %s0 = arith.addf %v0, %x0 : vector<$lanes x $t>
            %s1 = arith.addf %v1, %x1 : vector<$lanes x $t>
            %s2 = arith.addf %v2, %x2 : vector<$lanes x $t>
            %s3 = arith.addf %v3, %x3 : vector<$lanes x $t>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x $t>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x $t>
          %p = arith.addf %p0, %p1 : vector<$lanes x $t>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
            %x = memref.load %a[%i] : memref<?x$t>
            %y = arith.addf %acc, %x : $t
            scf.yield %y : $t
          }
          macro.yield %t : $t
        };
      }

      /// The sum of the products of matching elements. Refused for tensors of different
      /// lengths.
      fn dot(self : &Tensor<$t, [?]>, other : &Tensor<$t, [?]>) -> $t {
        assert(self.len() == other.len(), "dot needs two tensors of the same length");
        return mlir!( inputs : (%a = self : memref<?x$t>, %b = other : memref<?x$t>), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x $t>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %y0 = vector.load %b[%i0] : memref<?x$t>, vector<$lanes x $t>
            %y1 = vector.load %b[%i1] : memref<?x$t>, vector<$lanes x $t>
            %y2 = vector.load %b[%i2] : memref<?x$t>, vector<$lanes x $t>
            %y3 = vector.load %b[%i3] : memref<?x$t>, vector<$lanes x $t>
            %s0 = vector.fma %x0, %y0, %v0 : vector<$lanes x $t>
            %s1 = vector.fma %x1, %y1, %v1 : vector<$lanes x $t>
            %s2 = vector.fma %x2, %y2, %v2 : vector<$lanes x $t>
            %s3 = vector.fma %x3, %y3, %v3 : vector<$lanes x $t>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x $t>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x $t>
          %p = arith.addf %p0, %p1 : vector<$lanes x $t>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
            %x = memref.load %a[%i] : memref<?x$t>
            %y = memref.load %b[%i] : memref<?x$t>
            %m = math.fma %x, %y, %acc : $t
            scf.yield %m : $t
          }
          macro.yield %t : $t
        };
      }

      /// The average of the elements. NaN for an empty tensor. The loop of `sum`, written out
      /// rather than calling `self.sum()`, which the legacy code generator cannot compile.
      fn mean(self : &Tensor<$t, [?]>) -> $t {
        let total : $t = mlir!( inputs : (%a = self : memref<?x$t>), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x $t>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %s0 = arith.addf %v0, %x0 : vector<$lanes x $t>
            %s1 = arith.addf %v1, %x1 : vector<$lanes x $t>
            %s2 = arith.addf %v2, %x2 : vector<$lanes x $t>
            %s3 = arith.addf %v3, %x3 : vector<$lanes x $t>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x $t>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x $t>
          %p = arith.addf %p0, %p1 : vector<$lanes x $t>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
            %x = memref.load %a[%i] : memref<?x$t>
            %y = arith.addf %acc, %x : $t
            scf.yield %y : $t
          }
          macro.yield %t : $t
        };
        return total / (self.len() as $t);
      }

      /// The Euclidean length: the square root of the sum of the squares. The loop of `dot`
      /// with the tensor on both sides, written out rather than calling `self.dot(self)`,
      /// which the legacy code generator cannot compile.
      fn norm(self : &Tensor<$t, [?]>) -> $t {
        let squares : $t = mlir!( inputs : (%a = self : memref<?x$t>), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x $t>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %y0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %y1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %y2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %y3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %s0 = vector.fma %x0, %y0, %v0 : vector<$lanes x $t>
            %s1 = vector.fma %x1, %y1, %v1 : vector<$lanes x $t>
            %s2 = vector.fma %x2, %y2, %v2 : vector<$lanes x $t>
            %s3 = vector.fma %x3, %y3, %v3 : vector<$lanes x $t>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x $t>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x $t>
          %p = arith.addf %p0, %p1 : vector<$lanes x $t>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
            %x = memref.load %a[%i] : memref<?x$t>
            %y = memref.load %a[%i] : memref<?x$t>
            %m = math.fma %x, %y, %acc : $t
            scf.yield %m : $t
          }
          macro.yield %t : $t
        };
        return squares.sqrt();
      }
    }
  };
}

/// Stamps `sum`, `dot`, `mean` and `norm` for a half-width float, `f16` or `bf16`. Each loads
/// `$t` and adds up in `f32`, which it returns: a long sum of `f16` values would lose most of
/// its digits in `f16`, and `f16` cannot hold a total above 65504. The loops are the ones of
/// `stamp_tensor_sums`, with each load widened.
macro_rules stamp_half_tensor_sums {
  ($t : ident , $lanes : expr) => {
    impl Tensor<$t, [?]> {
      /// The sum of the elements. 0 for an empty tensor.
      fn sum(self : &Tensor<$t, [?]>) -> f32 {
        return mlir!( inputs : (%a = self : memref<?x$t>), returns : f32, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x f32>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0h = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x0 = arith.extf %x0h : vector<$lanes x $t> to vector<$lanes x f32>
            %x1h = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x1 = arith.extf %x1h : vector<$lanes x $t> to vector<$lanes x f32>
            %x2h = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x2 = arith.extf %x2h : vector<$lanes x $t> to vector<$lanes x f32>
            %x3h = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %x3 = arith.extf %x3h : vector<$lanes x $t> to vector<$lanes x f32>
            %s0 = arith.addf %v0, %x0 : vector<$lanes x f32>
            %s1 = arith.addf %v1, %x1 : vector<$lanes x f32>
            %s2 = arith.addf %v2, %x2 : vector<$lanes x f32>
            %s3 = arith.addf %v3, %x3 : vector<$lanes x f32>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x f32>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x f32>
          %p = arith.addf %p0, %p1 : vector<$lanes x f32>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x f32> into f32
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> (f32) {
            %xh = memref.load %a[%i] : memref<?x$t>
            %x = "arith.extf"(%xh) : ($t) -> f32
            %y = arith.addf %acc, %x : f32
            scf.yield %y : f32
          }
          macro.yield %t : f32
        };
      }

      /// The sum of the products of matching elements. Refused for tensors of different
      /// lengths.
      fn dot(self : &Tensor<$t, [?]>, other : &Tensor<$t, [?]>) -> f32 {
        assert(self.len() == other.len(), "dot needs two tensors of the same length");
        return mlir!( inputs : (%a = self : memref<?x$t>, %b = other : memref<?x$t>), returns : f32, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x f32>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0h = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x0 = arith.extf %x0h : vector<$lanes x $t> to vector<$lanes x f32>
            %x1h = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x1 = arith.extf %x1h : vector<$lanes x $t> to vector<$lanes x f32>
            %x2h = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x2 = arith.extf %x2h : vector<$lanes x $t> to vector<$lanes x f32>
            %x3h = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %x3 = arith.extf %x3h : vector<$lanes x $t> to vector<$lanes x f32>
            %y0h = vector.load %b[%i0] : memref<?x$t>, vector<$lanes x $t>
            %y0 = arith.extf %y0h : vector<$lanes x $t> to vector<$lanes x f32>
            %y1h = vector.load %b[%i1] : memref<?x$t>, vector<$lanes x $t>
            %y1 = arith.extf %y1h : vector<$lanes x $t> to vector<$lanes x f32>
            %y2h = vector.load %b[%i2] : memref<?x$t>, vector<$lanes x $t>
            %y2 = arith.extf %y2h : vector<$lanes x $t> to vector<$lanes x f32>
            %y3h = vector.load %b[%i3] : memref<?x$t>, vector<$lanes x $t>
            %y3 = arith.extf %y3h : vector<$lanes x $t> to vector<$lanes x f32>
            %s0 = vector.fma %x0, %y0, %v0 : vector<$lanes x f32>
            %s1 = vector.fma %x1, %y1, %v1 : vector<$lanes x f32>
            %s2 = vector.fma %x2, %y2, %v2 : vector<$lanes x f32>
            %s3 = vector.fma %x3, %y3, %v3 : vector<$lanes x f32>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x f32>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x f32>
          %p = arith.addf %p0, %p1 : vector<$lanes x f32>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x f32> into f32
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> (f32) {
            %xh = memref.load %a[%i] : memref<?x$t>
            %x = "arith.extf"(%xh) : ($t) -> f32
            %yh = memref.load %b[%i] : memref<?x$t>
            %y = "arith.extf"(%yh) : ($t) -> f32
            %m = math.fma %x, %y, %acc : f32
            scf.yield %m : f32
          }
          macro.yield %t : f32
        };
      }

      /// The average of the elements. NaN for an empty tensor. The loop of `sum`, written out
      /// rather than calling `self.sum()`, which the legacy code generator cannot compile.
      fn mean(self : &Tensor<$t, [?]>) -> f32 {
        let total : f32 = mlir!( inputs : (%a = self : memref<?x$t>), returns : f32, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x f32>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0h = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x0 = arith.extf %x0h : vector<$lanes x $t> to vector<$lanes x f32>
            %x1h = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x1 = arith.extf %x1h : vector<$lanes x $t> to vector<$lanes x f32>
            %x2h = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x2 = arith.extf %x2h : vector<$lanes x $t> to vector<$lanes x f32>
            %x3h = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %x3 = arith.extf %x3h : vector<$lanes x $t> to vector<$lanes x f32>
            %s0 = arith.addf %v0, %x0 : vector<$lanes x f32>
            %s1 = arith.addf %v1, %x1 : vector<$lanes x f32>
            %s2 = arith.addf %v2, %x2 : vector<$lanes x f32>
            %s3 = arith.addf %v3, %x3 : vector<$lanes x f32>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x f32>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x f32>
          %p = arith.addf %p0, %p1 : vector<$lanes x f32>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x f32> into f32
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> (f32) {
            %xh = memref.load %a[%i] : memref<?x$t>
            %x = "arith.extf"(%xh) : ($t) -> f32
            %y = arith.addf %acc, %x : f32
            scf.yield %y : f32
          }
          macro.yield %t : f32
        };
        return total / (self.len() as f32);
      }

      /// The Euclidean length: the square root of the sum of the squares. The loop of `dot`
      /// with the tensor on both sides, written out rather than calling `self.dot(self)`,
      /// which the legacy code generator cannot compile.
      fn norm(self : &Tensor<$t, [?]>) -> f32 {
        let squares : f32 = mlir!( inputs : (%a = self : memref<?x$t>), returns : f32, dialects : ["arith", "math", "memref", "scf", "vector"]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c3 = arith.constant 3 : index
          %c4 = arith.constant 4 : index
          %lanes = arith.constant $lanes : index
          %l2 = arith.muli %lanes, %c2 : index
          %l3 = arith.muli %lanes, %c3 : index
          %step = arith.muli %lanes, %c4 : index
          %n = memref.dim %a, %c0 : memref<?x$t>
          %rem = arith.remui %n, %step : index
          %body = arith.subi %n, %rem : index
          %z = arith.constant dense<0.0> : vector<$lanes x f32>
          %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>) {
            %i1 = arith.addi %i0, %lanes : index
            %i2 = arith.addi %i0, %l2 : index
            %i3 = arith.addi %i0, %l3 : index
            %x0h = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %x0 = arith.extf %x0h : vector<$lanes x $t> to vector<$lanes x f32>
            %x1h = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %x1 = arith.extf %x1h : vector<$lanes x $t> to vector<$lanes x f32>
            %x2h = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %x2 = arith.extf %x2h : vector<$lanes x $t> to vector<$lanes x f32>
            %x3h = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %x3 = arith.extf %x3h : vector<$lanes x $t> to vector<$lanes x f32>
            %y0h = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
            %y0 = arith.extf %y0h : vector<$lanes x $t> to vector<$lanes x f32>
            %y1h = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
            %y1 = arith.extf %y1h : vector<$lanes x $t> to vector<$lanes x f32>
            %y2h = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
            %y2 = arith.extf %y2h : vector<$lanes x $t> to vector<$lanes x f32>
            %y3h = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
            %y3 = arith.extf %y3h : vector<$lanes x $t> to vector<$lanes x f32>
            %s0 = vector.fma %x0, %y0, %v0 : vector<$lanes x f32>
            %s1 = vector.fma %x1, %y1, %v1 : vector<$lanes x f32>
            %s2 = vector.fma %x2, %y2, %v2 : vector<$lanes x f32>
            %s3 = vector.fma %x3, %y3, %v3 : vector<$lanes x f32>
            scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>, vector<$lanes x f32>
          }
          %p0 = arith.addf %r#0, %r#1 : vector<$lanes x f32>
          %p1 = arith.addf %r#2, %r#3 : vector<$lanes x f32>
          %p = arith.addf %p0, %p1 : vector<$lanes x f32>
          %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x f32> into f32
          %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> (f32) {
            %xh = memref.load %a[%i] : memref<?x$t>
            %x = "arith.extf"(%xh) : ($t) -> f32
            %yh = memref.load %a[%i] : memref<?x$t>
            %y = "arith.extf"(%yh) : ($t) -> f32
            %m = math.fma %x, %y, %acc : f32
            scf.yield %m : f32
          }
          macro.yield %t : f32
        };
        return squares.sqrt();
      }
    }
  };
}

stamp_tensor_sums!(f32 , 16);
stamp_tensor_sums!(f64 , 8);
stamp_half_tensor_sums!(f16 , 16);
stamp_half_tensor_sums!(bf16 , 16);

/// The largest element of a 1-D tensor `$a` of `$t`, ignoring NaN, starting from `$start`
/// (the bits of negative infinity): four `$lanes`-wide running maxima, then the leftover
/// elements one at a time.
macro_rules tensor_max_loop {
  ($a : expr , $t : ident , $lanes : expr , $start : expr) => {
    mlir!( inputs : (%a = $a : memref<?x$t>), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c3 = arith.constant 3 : index
      %c4 = arith.constant 4 : index
      %lanes = arith.constant $lanes : index
      %l2 = arith.muli %lanes, %c2 : index
      %l3 = arith.muli %lanes, %c3 : index
      %step = arith.muli %lanes, %c4 : index
      %n = memref.dim %a, %c0 : memref<?x$t>
      %rem = arith.remui %n, %step : index
      %body = arith.subi %n, %rem : index
      %z = arith.constant dense<$start> : vector<$lanes x $t>
      %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
        %i1 = arith.addi %i0, %lanes : index
        %i2 = arith.addi %i0, %l2 : index
        %i3 = arith.addi %i0, %l3 : index
        %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
        %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
        %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
        %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
        %s0 = arith.maxnumf %v0, %x0 : vector<$lanes x $t>
        %s1 = arith.maxnumf %v1, %x1 : vector<$lanes x $t>
        %s2 = arith.maxnumf %v2, %x2 : vector<$lanes x $t>
        %s3 = arith.maxnumf %v3, %x3 : vector<$lanes x $t>
        scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
      }
      %p0 = arith.maxnumf %r#0, %r#1 : vector<$lanes x $t>
      %p1 = arith.maxnumf %r#2, %r#3 : vector<$lanes x $t>
      %p = arith.maxnumf %p0, %p1 : vector<$lanes x $t>
      %head = vector.reduction <maxnumf>, %p : vector<$lanes x $t> into $t
      %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
        %x = memref.load %a[%i] : memref<?x$t>
        %y = arith.maxnumf %acc, %x : $t
        scf.yield %y : $t
      }
      macro.yield %t : $t
    }
  };
}

/// The smallest element of a 1-D tensor `$a` of `$t`, ignoring NaN, starting from `$start`
/// (the bits of positive infinity), with the loop shape of `tensor_max_loop`.
macro_rules tensor_min_loop {
  ($a : expr , $t : ident , $lanes : expr , $start : expr) => {
    mlir!( inputs : (%a = $a : memref<?x$t>), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c3 = arith.constant 3 : index
      %c4 = arith.constant 4 : index
      %lanes = arith.constant $lanes : index
      %l2 = arith.muli %lanes, %c2 : index
      %l3 = arith.muli %lanes, %c3 : index
      %step = arith.muli %lanes, %c4 : index
      %n = memref.dim %a, %c0 : memref<?x$t>
      %rem = arith.remui %n, %step : index
      %body = arith.subi %n, %rem : index
      %z = arith.constant dense<$start> : vector<$lanes x $t>
      %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
        %i1 = arith.addi %i0, %lanes : index
        %i2 = arith.addi %i0, %l2 : index
        %i3 = arith.addi %i0, %l3 : index
        %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
        %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
        %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
        %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
        %s0 = arith.minnumf %v0, %x0 : vector<$lanes x $t>
        %s1 = arith.minnumf %v1, %x1 : vector<$lanes x $t>
        %s2 = arith.minnumf %v2, %x2 : vector<$lanes x $t>
        %s3 = arith.minnumf %v3, %x3 : vector<$lanes x $t>
        scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
      }
      %p0 = arith.minnumf %r#0, %r#1 : vector<$lanes x $t>
      %p1 = arith.minnumf %r#2, %r#3 : vector<$lanes x $t>
      %p = arith.minnumf %p0, %p1 : vector<$lanes x $t>
      %head = vector.reduction <minnumf>, %p : vector<$lanes x $t> into $t
      %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
        %x = memref.load %a[%i] : memref<?x$t>
        %y = arith.minnumf %acc, %x : $t
        scf.yield %y : $t
      }
      macro.yield %t : $t
    }
  };
}

/// Stamps `max`, `min`, `argmax` and `argmin` over a 1-D tensor of one float width, as vector
/// loops like the sums'. `$neg_inf` and `$pos_inf` are the bits of the two infinities, their starting points.
macro_rules stamp_tensor_extrema {
  ($t : ident , $lanes : expr , $neg_inf : expr , $pos_inf : expr) => {
    impl Tensor<$t, [?]> {
      /// The largest element. A NaN is ignored, as `max` on a number does; negative
      /// infinity for an empty tensor.
      fn max(self : &Tensor<$t, [?]>) -> $t {
        return tensor_max_loop!(self, $t, $lanes, $neg_inf);
      }

      /// The smallest element. A NaN is ignored; positive infinity for an empty tensor.
      fn min(self : &Tensor<$t, [?]>) -> $t {
        return tensor_min_loop!(self, $t, $lanes, $pos_inf);
      }

      /// The index of the largest element, the first one if several are equal. A NaN is
      /// ignored, as `max` does; `None` for an empty tensor or one holding only NaN. Two
      /// passes: the vector loop of `max`, then a search for the first element equal to it.
      fn argmax(self : &Tensor<$t, [?]>) -> Option<i32> {
        let largest : $t = tensor_max_loop!(self, $t, $lanes, $neg_inf);
        for i in 0..self.len() {
          if self[i] == largest {
            return Option<i32>::Some(i);
          }
        }
        return Option<i32>::None;
      }

      /// The index of the smallest element, the first one if several are equal. A NaN is
      /// ignored; `None` for an empty tensor or one holding only NaN.
      fn argmin(self : &Tensor<$t, [?]>) -> Option<i32> {
        let smallest : $t = tensor_min_loop!(self, $t, $lanes, $pos_inf);
        for i in 0..self.len() {
          if self[i] == smallest {
            return Option<i32>::Some(i);
          }
        }
        return Option<i32>::None;
      }
    }
  };
}

stamp_tensor_extrema!(f32 , 16 , 0xFF800000 , 0x7F800000);
stamp_tensor_extrema!(f64 , 8 , 0xFFF0000000000000 , 0x7FF0000000000000);
stamp_tensor_extrema!(f16 , 16 , 0xFC00 , 0x7C00);
stamp_tensor_extrema!(bf16 , 16 , 0xFF80 , 0x7F80);

/// Stamps `softmax_inplace` over a 1-D tensor of `$t`, computing in `$acc`: `f64` for `f64`,
/// `f32` for `f16` and `bf16`, as their sums do. A plain loop; the `f32` one, below, is vector
/// code.
macro_rules stamp_tensor_statistics {
  ($t : ident , $acc : ident) => {
    impl Tensor<$t, [?]> {
      /// Replaces each element `x` with `exp(x) / (sum of exp over all elements)`, so the
      /// elements are positive and add up to 1. The largest element is subtracted before
      /// `exp`, which gives the same answer without overflowing.
      fn softmax_inplace(self : &mut Tensor<$t, [?]>) -> i32 {
        let n = self.len();
        let mut largest : $acc = 0.0;
        for i in 0..n {
          let x = self[i] as $acc;
          if i == 0 || x > largest {
            largest = x;
          }
        }
        let mut total : $acc = 0.0;
        for i in 0..n {
          let e = ((self[i] as $acc) - largest).exp();
          self[i] = e as $t;
          total = total + e;
        }
        for i in 0..n {
          self[i] = ((self[i] as $acc) / total) as $t;
        }
        return 0;
      }
    }
  };
}

stamp_tensor_statistics!(f64 , f64);
stamp_tensor_statistics!(f16 , f32);
stamp_tensor_statistics!(bf16 , f32);

/// The sum of a 1-D tensor `$a` of `$t`, as the vector loop of `sum`: four `$lanes`-wide
/// partial sums, then the elements left over one at a time.
macro_rules tensor_sum_loop {
  ($a : expr , $t : ident , $lanes : expr) => {
    mlir!( inputs : (%a = $a : memref<?x$t>), returns : $t, dialects : ["arith", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c3 = arith.constant 3 : index
      %c4 = arith.constant 4 : index
      %lanes = arith.constant $lanes : index
      %l2 = arith.muli %lanes, %c2 : index
      %l3 = arith.muli %lanes, %c3 : index
      %step = arith.muli %lanes, %c4 : index
      %n = memref.dim %a, %c0 : memref<?x$t>
      %rem = arith.remui %n, %step : index
      %body = arith.subi %n, %rem : index
      %z = arith.constant dense<0.0> : vector<$lanes x $t>
      %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
        %i1 = arith.addi %i0, %lanes : index
        %i2 = arith.addi %i0, %l2 : index
        %i3 = arith.addi %i0, %l3 : index
        %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
        %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
        %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
        %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
        %s0 = arith.addf %v0, %x0 : vector<$lanes x $t>
        %s1 = arith.addf %v1, %x1 : vector<$lanes x $t>
        %s2 = arith.addf %v2, %x2 : vector<$lanes x $t>
        %s3 = arith.addf %v3, %x3 : vector<$lanes x $t>
        scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
      }
      %p0 = arith.addf %r#0, %r#1 : vector<$lanes x $t>
      %p1 = arith.addf %r#2, %r#3 : vector<$lanes x $t>
      %p = arith.addf %p0, %p1 : vector<$lanes x $t>
      %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
      %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
        %x = memref.load %a[%i] : memref<?x$t>
        %y = arith.addf %acc, %x : $t
        scf.yield %y : $t
      }
      macro.yield %t : $t
    }
  };
}

/// The sum of the squared distances of a 1-D tensor `$a` of `$t` from `$mean`, with the same
/// loop shape as `tensor_sum_loop`.
macro_rules tensor_squared_distance_loop {
  ($a : expr , $mean : expr , $t : ident , $lanes : expr) => {
    mlir!( inputs : (%a = $a : memref<?x$t>, %m = $mean : $t), returns : $t, dialects : ["arith", "math", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c3 = arith.constant 3 : index
      %c4 = arith.constant 4 : index
      %lanes = arith.constant $lanes : index
      %l2 = arith.muli %lanes, %c2 : index
      %l3 = arith.muli %lanes, %c3 : index
      %step = arith.muli %lanes, %c4 : index
      %n = memref.dim %a, %c0 : memref<?x$t>
      %rem = arith.remui %n, %step : index
      %body = arith.subi %n, %rem : index
      %z = arith.constant dense<0.0> : vector<$lanes x $t>
      %mv = "vector.broadcast"(%m) : ($t) -> vector<$lanes x $t>
      %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
        %i1 = arith.addi %i0, %lanes : index
        %i2 = arith.addi %i0, %l2 : index
        %i3 = arith.addi %i0, %l3 : index
        %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
        %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
        %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
        %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
        %d0 = arith.subf %x0, %mv : vector<$lanes x $t>
        %d1 = arith.subf %x1, %mv : vector<$lanes x $t>
        %d2 = arith.subf %x2, %mv : vector<$lanes x $t>
        %d3 = arith.subf %x3, %mv : vector<$lanes x $t>
        %s0 = vector.fma %d0, %d0, %v0 : vector<$lanes x $t>
        %s1 = vector.fma %d1, %d1, %v1 : vector<$lanes x $t>
        %s2 = vector.fma %d2, %d2, %v2 : vector<$lanes x $t>
        %s3 = vector.fma %d3, %d3, %v3 : vector<$lanes x $t>
        scf.yield %s0, %s1, %s2, %s3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
      }
      %p0 = arith.addf %r#0, %r#1 : vector<$lanes x $t>
      %p1 = arith.addf %r#2, %r#3 : vector<$lanes x $t>
      %p = arith.addf %p0, %p1 : vector<$lanes x $t>
      %head = vector.reduction <add>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
      %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
        %x = memref.load %a[%i] : memref<?x$t>
        %d = arith.subf %x, %m : $t
        %y = math.fma %d, %d, %acc : $t
        scf.yield %y : $t
      }
      macro.yield %t : $t
    }
  };
}

/// Stamps `variance` and `std_dev` over a 1-D tensor of `f32` or `f64` as vector loops.
macro_rules stamp_tensor_spread {
  ($t : ident , $lanes : expr) => {
    impl Tensor<$t, [?]> {
      /// The average squared distance from the mean, dividing by the number of elements `n`
      /// (numpy's `var`; divide by `n - 1` for the sample variance). It finds the mean first,
      /// which is more accurate than the one-pass formula. NaN for an empty tensor.
      fn variance(self : &Tensor<$t, [?]>) -> $t {
        let total : $t = tensor_sum_loop!(self, $t, $lanes);
        let mean = total / (self.len() as $t);
        let squares : $t = tensor_squared_distance_loop!(self, mean, $t, $lanes);
        return squares / (self.len() as $t);
      }

      /// The standard deviation: the square root of `variance`.
      fn std_dev(self : &Tensor<$t, [?]>) -> $t {
        let total : $t = tensor_sum_loop!(self, $t, $lanes);
        let mean = total / (self.len() as $t);
        let squares : $t = tensor_squared_distance_loop!(self, mean, $t, $lanes);
        return (squares / (self.len() as $t)).sqrt();
      }
    }
  };
}

/// Stamps `variance` and `std_dev` over a 1-D tensor of `f16` or `bf16`, adding up in `f32` as
/// their sums do. Plain loops.
macro_rules stamp_half_tensor_spread {
  ($t : ident) => {
    impl Tensor<$t, [?]> {
      /// As `variance` on `f32`, computed in `f32`.
      fn variance(self : &Tensor<$t, [?]>) -> f32 {
        let n = self.len();
        let mut total : f32 = 0.0;
        for i in 0..n {
          total = total + (self[i] as f32);
        }
        let mean = total / (n as f32);
        let mut squares : f32 = 0.0;
        for i in 0..n {
          let distance = (self[i] as f32) - mean;
          squares = squares + distance * distance;
        }
        return squares / (n as f32);
      }

      /// As `std_dev` on `f32`, computed in `f32`.
      fn std_dev(self : &Tensor<$t, [?]>) -> f32 {
        let n = self.len();
        let mut total : f32 = 0.0;
        for i in 0..n {
          total = total + (self[i] as f32);
        }
        let mean = total / (n as f32);
        let mut squares : f32 = 0.0;
        for i in 0..n {
          let distance = (self[i] as f32) - mean;
          squares = squares + distance * distance;
        }
        return (squares / (n as f32)).sqrt();
      }

    }
  };
}

/// Replaces every element `x` of a 1-D `f32` tensor `$a` with `exp(x - $m)`, and answers their
/// sum. For `softmax_inplace` only, where `x - $m` is at most 0. `exp` is computed 16 lanes at a
/// time as Cephes does: `x` is split into `k ln 2 + r`, `exp(r)` is a degree-6 polynomial, and
/// `2^k` is built from its bits. Within 1 ulp of libm's `expf` over [-88, 0]; results below
/// about 1e-38 may come out as 0. The clamp turns a NaN into a number, so converting it to an
/// integer is defined, and the NaN is put back at the end. The leftover elements use `math.exp`.
macro_rules tensor_exp_shifted_loop {
  ($a : expr , $m : expr) => {
    mlir!( inputs : (%a = $a : memref<?xf32>, %m = $m : f32), returns : f32, dialects : ["arith", "math", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c16 = arith.constant 16 : index
      %n = memref.dim %a, %c0 : memref<?xf32>
      %rem = arith.remui %n, %c16 : index
      %body = arith.subi %n, %rem : index
      %mv = "vector.broadcast"(%m) : (f32) -> vector<16xf32>
      %hi = arith.constant dense<88.3762626647949> : vector<16xf32>
      %lo = arith.constant dense<-88.3762626647949> : vector<16xf32>
      %log2e = arith.constant dense<1.44269504088896341> : vector<16xf32>
      %half = arith.constant dense<0.5> : vector<16xf32>
      %neg_ln2_hi = arith.constant dense<-0.693359375> : vector<16xf32>
      %neg_ln2_lo = arith.constant dense<2.12194440e-4> : vector<16xf32>
      %p0 = arith.constant dense<1.9875691500e-4> : vector<16xf32>
      %p1 = arith.constant dense<1.3981999507e-3> : vector<16xf32>
      %p2 = arith.constant dense<8.3334519073e-3> : vector<16xf32>
      %p3 = arith.constant dense<4.1665795894e-2> : vector<16xf32>
      %p4 = arith.constant dense<1.6666665459e-1> : vector<16xf32>
      %p5 = arith.constant dense<5.0000001201e-1> : vector<16xf32>
      %one = arith.constant dense<1.0> : vector<16xf32>
      %bias = arith.constant dense<127> : vector<16xi32>
      %c23 = arith.constant dense<23> : vector<16xi32>
      %z = arith.constant dense<0.0> : vector<16xf32>
      %sums = scf.for %i = %c0 to %body step %c16 iter_args(%acc = %z) -> (vector<16xf32>) {
        %v = vector.load %a[%i] : memref<?xf32>, vector<16xf32>
        %x = arith.subf %v, %mv : vector<16xf32>
        %x1 = arith.minnumf %x, %hi : vector<16xf32>
        %xc = arith.maxnumf %x1, %lo : vector<16xf32>
        %t = vector.fma %xc, %log2e, %half : vector<16xf32>
        %fx = math.floor %t : vector<16xf32>
        %ra = vector.fma %fx, %neg_ln2_hi, %xc : vector<16xf32>
        %r = vector.fma %fx, %neg_ln2_lo, %ra : vector<16xf32>
        %rr = arith.mulf %r, %r : vector<16xf32>
        %y0 = vector.fma %p0, %r, %p1 : vector<16xf32>
        %y1 = vector.fma %y0, %r, %p2 : vector<16xf32>
        %y2 = vector.fma %y1, %r, %p3 : vector<16xf32>
        %y3 = vector.fma %y2, %r, %p4 : vector<16xf32>
        %y4 = vector.fma %y3, %r, %p5 : vector<16xf32>
        %y5 = vector.fma %y4, %rr, %r : vector<16xf32>
        %y = arith.addf %y5, %one : vector<16xf32>
        %k = "arith.fptosi"(%fx) : (vector<16xf32>) -> vector<16xi32>
        %kb = arith.addi %k, %bias : vector<16xi32>
        %bits = arith.shli %kb, %c23 : vector<16xi32>
        %pow = "arith.bitcast"(%bits) : (vector<16xi32>) -> vector<16xf32>
        %ex = arith.mulf %y, %pow : vector<16xf32>
        %nan = arith.cmpf uno, %x, %x : vector<16xf32>
        %e = arith.select %nan, %x, %ex : vector<16xi1>, vector<16xf32>
        vector.store %e, %a[%i] : memref<?xf32>, vector<16xf32>
        %s = arith.addf %acc, %e : vector<16xf32>
        scf.yield %s : vector<16xf32>
      }
      %head = vector.reduction <add>, %sums fastmath<reassoc> : vector<16xf32> into f32
      %total = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> (f32) {
        %v = memref.load %a[%i] : memref<?xf32>
        %x = arith.subf %v, %m : f32
        %e = math.exp %x : f32
        memref.store %e, %a[%i] : memref<?xf32>
        %s = arith.addf %acc, %e : f32
        scf.yield %s : f32
      }
      macro.yield %total : f32
    }
  };
}

impl Tensor<f32, [?]> {
  /// Replaces each element `x` with `exp(x) / (sum of exp over all elements)`, so the elements
  /// are positive and add up to 1. The largest element is subtracted before `exp`, which gives
  /// the same answer without overflowing. Vector loops, with the `exp` of
  /// `tensor_exp_shifted_loop`: within 1 ulp of `f32::exp`.
  fn softmax_inplace(self : &mut Tensor<f32, [?]>) -> i32 {
    let largest : f32 = tensor_max_loop!(self, f32, 16, 0xFF800000);
    let total : f32 = tensor_exp_shifted_loop!(self, largest);
    for i in 0..self.len() {
      self[i] = self[i] / total;
    }
    return 0;
  }
}

stamp_tensor_spread!(f32 , 16);
stamp_tensor_spread!(f64 , 8);
stamp_half_tensor_spread!(f16);
stamp_half_tensor_spread!(bf16);

/// Stamps the element-wise operations over a 2-D tensor of `$t`. Plain loops, which the
/// compiler turns into vector code.
macro_rules stamp_tensor_rank2 {
  ($t : ident) => {
    impl Tensor<$t, [?, ?]> {
      /// Adds `other` to this tensor, element by element. Refused for different shapes.
      fn add_assign(self : &mut Tensor<$t, [?, ?]>, other : &Tensor<$t, [?, ?]>) -> void {
        assert(self.extent(0) == other.extent(0) && self.extent(1) == other.extent(1), "add_assign needs two tensors of the same shape");
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j] + other[i][j];
          }
        }
      }

      /// Subtracts `other` from this tensor, element by element.
      fn sub_assign(self : &mut Tensor<$t, [?, ?]>, other : &Tensor<$t, [?, ?]>) -> void {
        assert(self.extent(0) == other.extent(0) && self.extent(1) == other.extent(1), "sub_assign needs two tensors of the same shape");
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j] - other[i][j];
          }
        }
      }

      /// Multiplies this tensor by `other`, element by element (not a matrix product).
      fn mul_assign(self : &mut Tensor<$t, [?, ?]>, other : &Tensor<$t, [?, ?]>) -> void {
        assert(self.extent(0) == other.extent(0) && self.extent(1) == other.extent(1), "mul_assign needs two tensors of the same shape");
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j] * other[i][j];
          }
        }
      }

      /// Divides this tensor by `other`, element by element.
      fn div_assign(self : &mut Tensor<$t, [?, ?]>, other : &Tensor<$t, [?, ?]>) -> void {
        assert(self.extent(0) == other.extent(0) && self.extent(1) == other.extent(1), "div_assign needs two tensors of the same shape");
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j] / other[i][j];
          }
        }
      }

      /// Adds `a` to every element.
      fn add_scalar(self : &mut Tensor<$t, [?, ?]>, a : $t) -> void {
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j] + a;
          }
        }
      }

      /// Multiplies every element by `a`.
      fn scale(self : &mut Tensor<$t, [?, ?]>, a : $t) -> void {
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j] * a;
          }
        }
      }

      /// Replaces every element by its absolute value.
      fn abs_inplace(self : &mut Tensor<$t, [?, ?]>) -> void {
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j].abs();
          }
        }
      }

      /// Replaces every element by its square root.
      fn sqrt_inplace(self : &mut Tensor<$t, [?, ?]>) -> void {
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j].sqrt();
          }
        }
      }

      /// Holds every element between `lo` and `hi`, as `clamp` on a number does.
      fn clamp_inplace(self : &mut Tensor<$t, [?, ?]>, lo : $t, hi : $t) -> void {
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            self[i][j] = self[i][j].clamp(lo, hi);
          }
        }
      }
    }
  };
}

stamp_tensor_rank2!(f32);
stamp_tensor_rank2!(f64);
stamp_tensor_rank2!(f16);
stamp_tensor_rank2!(bf16);

/// One reduction over every element of a 2-D tensor `$a` of `$t`: `$op` is the `arith` operation
/// (`addf`, `maxnumf`, `minnumf`), `$red` the matching `vector.reduction` kind and `$start` its
/// starting value. The loop of `sum` over the elements in memory order, four `$lanes`-wide
/// running results at a time. A `memref<?x?xT>` is stored row after row from offset 0, so it is
/// viewed as one row of `rows * cols` elements.
macro_rules tensor_reduce_2d {
  ($a : expr , $t : ident , $lanes : expr , $start : expr , $op : ident , $red : ident) => {
    mlir!( inputs : (%m = $a : memref<?x?x$t>), returns : $t, dialects : ["arith", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c3 = arith.constant 3 : index
      %c4 = arith.constant 4 : index
      %lanes = arith.constant $lanes : index
      %l2 = arith.muli %lanes, %c2 : index
      %l3 = arith.muli %lanes, %c3 : index
      %step = arith.muli %lanes, %c4 : index
      %rows = memref.dim %m, %c0 : memref<?x?x$t>
      %cols = memref.dim %m, %c1 : memref<?x?x$t>
      %z = arith.constant dense<$start> : vector<$lanes x $t>
      %s0 = arith.constant $start : $t
      %n = arith.muli %rows, %cols : index
      %a = memref.reinterpret_cast %m to offset: [0], sizes: [%n], strides: [1] : memref<?x?x$t> to memref<?x$t>
      %rem = arith.remui %n, %step : index
      %body = arith.subi %n, %rem : index
      %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
        %i1 = arith.addi %i0, %lanes : index
        %i2 = arith.addi %i0, %l2 : index
        %i3 = arith.addi %i0, %l3 : index
        %x0 = vector.load %a[%i0] : memref<?x$t>, vector<$lanes x $t>
        %x1 = vector.load %a[%i1] : memref<?x$t>, vector<$lanes x $t>
        %x2 = vector.load %a[%i2] : memref<?x$t>, vector<$lanes x $t>
        %x3 = vector.load %a[%i3] : memref<?x$t>, vector<$lanes x $t>
        %y0 = arith.$op %v0, %x0 : vector<$lanes x $t>
        %y1 = arith.$op %v1, %x1 : vector<$lanes x $t>
        %y2 = arith.$op %v2, %x2 : vector<$lanes x $t>
        %y3 = arith.$op %v3, %x3 : vector<$lanes x $t>
        scf.yield %y0, %y1, %y2, %y3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
      }
      %p0 = arith.$op %r#0, %r#1 : vector<$lanes x $t>
      %p1 = arith.$op %r#2, %r#3 : vector<$lanes x $t>
      %p = arith.$op %p0, %p1 : vector<$lanes x $t>
      %head = vector.reduction <$red>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
      %t = scf.for %i = %body to %n step %c1 iter_args(%acc = %head) -> ($t) {
        %x = memref.load %a[%i] : memref<?x$t>
        %y = arith.$op %acc, %x : $t
        scf.yield %y : $t
      }
      macro.yield %t : $t
    }
  };
}

/// The reduction of `tensor_reduce_2d` along each row of a 2-D tensor `$a` of `$t`, written to
/// the 1-D tensor `$out`, which has one element per row.
macro_rules tensor_reduce_rows_2d {
  ($a : expr , $out : expr , $t : ident , $lanes : expr , $start : expr , $op : ident , $red : ident) => {
    mlir!( inputs : (%m = $a : memref<?x?x$t>, %o = $out : memref<?x$t>), returns : i32, dialects : ["arith", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %c3 = arith.constant 3 : index
      %c4 = arith.constant 4 : index
      %lanes = arith.constant $lanes : index
      %l2 = arith.muli %lanes, %c2 : index
      %l3 = arith.muli %lanes, %c3 : index
      %step = arith.muli %lanes, %c4 : index
      %rows = memref.dim %m, %c0 : memref<?x?x$t>
      %cols = memref.dim %m, %c1 : memref<?x?x$t>
      %z = arith.constant dense<$start> : vector<$lanes x $t>
      %s0 = arith.constant $start : $t
      %rem = arith.remui %cols, %step : index
      %body = arith.subi %cols, %rem : index
      scf.for %row = %c0 to %rows step %c1 {
        %r:4 = scf.for %i0 = %c0 to %body step %step iter_args(%v0 = %z, %v1 = %z, %v2 = %z, %v3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
          %i1 = arith.addi %i0, %lanes : index
          %i2 = arith.addi %i0, %l2 : index
          %i3 = arith.addi %i0, %l3 : index
          %x0 = vector.load %m[%row, %i0] : memref<?x?x$t>, vector<$lanes x $t>
          %x1 = vector.load %m[%row, %i1] : memref<?x?x$t>, vector<$lanes x $t>
          %x2 = vector.load %m[%row, %i2] : memref<?x?x$t>, vector<$lanes x $t>
          %x3 = vector.load %m[%row, %i3] : memref<?x?x$t>, vector<$lanes x $t>
          %y0 = arith.$op %v0, %x0 : vector<$lanes x $t>
          %y1 = arith.$op %v1, %x1 : vector<$lanes x $t>
          %y2 = arith.$op %v2, %x2 : vector<$lanes x $t>
          %y3 = arith.$op %v3, %x3 : vector<$lanes x $t>
          scf.yield %y0, %y1, %y2, %y3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
        }
        %p0 = arith.$op %r#0, %r#1 : vector<$lanes x $t>
        %p1 = arith.$op %r#2, %r#3 : vector<$lanes x $t>
        %p = arith.$op %p0, %p1 : vector<$lanes x $t>
        %head = vector.reduction <$red>, %p fastmath<reassoc> : vector<$lanes x $t> into $t
        %t = scf.for %i = %body to %cols step %c1 iter_args(%acc = %head) -> ($t) {
          %x = memref.load %m[%row, %i] : memref<?x?x$t>
          %y = arith.$op %acc, %x : $t
          scf.yield %y : $t
        }
        memref.store %t, %o[%row] : memref<?x$t>
      }
      %zero = arith.constant 0 : i32
      macro.yield %zero : i32
    }
  };
}

/// Stamps the reductions over a 2-D tensor of `f32` or `f64` as vector loops. A reduction over
/// the whole tensor answers one number. One along an axis answers a 1-D tensor, as numpy's
/// `axis=` does: axis 0 reduces each column (one answer per column), axis 1 each row. Axis 1
/// runs the vector loop along each row; axis 0 adds each row into the answers, element by
/// element, which the compiler turns into vector code.
macro_rules stamp_tensor_rank2_reductions {
  ($t : ident , $lanes : expr , $neg_inf : expr , $pos_inf : expr) => {
    impl Tensor<$t, [?, ?]> {
      /// The sum of every element. 0 for an empty tensor.
      fn sum(self : &Tensor<$t, [?, ?]>) -> $t {
        return tensor_reduce_2d!(self, $t, $lanes, 0.0, addf, add);
      }

      /// The average of every element. NaN for an empty tensor.
      fn mean(self : &Tensor<$t, [?, ?]>) -> $t {
        let total : $t = tensor_reduce_2d!(self, $t, $lanes, 0.0, addf, add);
        return total / ((self.extent(0) * self.extent(1)) as $t);
      }

      /// The largest element. A NaN is ignored; negative infinity for an empty tensor.
      fn max(self : &Tensor<$t, [?, ?]>) -> $t {
        return tensor_reduce_2d!(self, $t, $lanes, $neg_inf, maxnumf, maxnumf);
      }

      /// The smallest element. A NaN is ignored; positive infinity for an empty tensor.
      fn min(self : &Tensor<$t, [?, ?]>) -> $t {
        return tensor_reduce_2d!(self, $t, $lanes, $pos_inf, minnumf, minnumf);
      }

      /// The sum along `axis`: of each column for axis 0, of each row for axis 1.
      fn sum_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<$t, [?]> {
        assert(axis == 0 || axis == 1, "sum_axis takes axis 0 or 1");
        let mut out = Tensor<$t>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        if axis == 1 {
          let _done : i32 = tensor_reduce_rows_2d!(self, &mut out, $t, $lanes, 0.0, addf, add);
        } else {
          for j in 0..out.len() {
            out[j] = 0.0;
          }
          for i in 0..self.extent(0) {
            for j in 0..out.len() {
              out[j] = out[j] + self[i][j];
            }
          }
        }
        return out;
      }

      /// The average along `axis`: of each column for axis 0, of each row for axis 1.
      fn mean_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<$t, [?]> {
        assert(axis == 0 || axis == 1, "mean_axis takes axis 0 or 1");
        let mut out = Tensor<$t>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        if axis == 1 {
          let _done : i32 = tensor_reduce_rows_2d!(self, &mut out, $t, $lanes, 0.0, addf, add);
        } else {
          for j in 0..out.len() {
            out[j] = 0.0;
          }
          for i in 0..self.extent(0) {
            for j in 0..out.len() {
              out[j] = out[j] + self[i][j];
            }
          }
        }
        let count = if axis == 0 {
          self.extent(0)
        } else {
          self.extent(1)
        };
        for k in 0..out.len() {
          out[k] = out[k] / (count as $t);
        }
        return out;
      }

      /// The largest element along `axis`: of each column for axis 0, of each row for axis 1.
      /// A NaN is ignored.
      fn max_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<$t, [?]> {
        assert(axis == 0 || axis == 1, "max_axis takes axis 0 or 1");
        let mut out = Tensor<$t>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        if axis == 1 {
          let _done : i32 = tensor_reduce_rows_2d!(self, &mut out, $t, $lanes, $neg_inf, maxnumf, maxnumf);
        } else {
          for j in 0..out.len() {
            out[j] = $t::neg_infinity();
          }
          for i in 0..self.extent(0) {
            for j in 0..out.len() {
              out[j] = out[j].max(self[i][j]);
            }
          }
        }
        return out;
      }

      /// The smallest element along `axis`: of each column for axis 0, of each row for axis 1.
      /// A NaN is ignored.
      fn min_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<$t, [?]> {
        assert(axis == 0 || axis == 1, "min_axis takes axis 0 or 1");
        let mut out = Tensor<$t>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        if axis == 1 {
          let _done : i32 = tensor_reduce_rows_2d!(self, &mut out, $t, $lanes, $pos_inf, minnumf, minnumf);
        } else {
          for j in 0..out.len() {
            out[j] = $t::infinity();
          }
          for i in 0..self.extent(0) {
            for j in 0..out.len() {
              out[j] = out[j].min(self[i][j]);
            }
          }
        }
        return out;
      }
    }
  };
}

/// Stamps the reductions over a 2-D tensor of `f16` or `bf16`, adding up in `f32` as their 1-D
/// sums do. The meaning of each is that of `stamp_tensor_rank2_reductions`. Plain loops.
macro_rules stamp_half_tensor_rank2_reductions {
  ($t : ident) => {
    impl Tensor<$t, [?, ?]> {
      /// The sum of every element. 0 for an empty tensor.
      fn sum(self : &Tensor<$t, [?, ?]>) -> f32 {
        let mut total : f32 = 0.0;
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            total = total + (self[i][j] as f32);
          }
        }
        return total;
      }

      /// The average of every element. NaN for an empty tensor.
      fn mean(self : &Tensor<$t, [?, ?]>) -> f32 {
        let mut total : f32 = 0.0;
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            total = total + (self[i][j] as f32);
          }
        }
        return total / ((self.extent(0) * self.extent(1)) as f32);
      }

      /// The largest element. A NaN is ignored; negative infinity for an empty tensor.
      fn max(self : &Tensor<$t, [?, ?]>) -> $t {
        let mut best = $t::neg_infinity();
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            best = best.max(self[i][j]);
          }
        }
        return best;
      }

      /// The smallest element. A NaN is ignored; positive infinity for an empty tensor.
      fn min(self : &Tensor<$t, [?, ?]>) -> $t {
        let mut best = $t::infinity();
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            best = best.min(self[i][j]);
          }
        }
        return best;
      }

      /// The sum along `axis`: of each column for axis 0, of each row for axis 1.
      fn sum_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<f32, [?]> {
        assert(axis == 0 || axis == 1, "sum_axis takes axis 0 or 1");
        let mut out = Tensor<f32>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        for k in 0..out.len() {
          out[k] = 0.0;
        }
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            let k = if axis == 0 {
              j
            } else {
              i
            };
            out[k] = out[k] + (self[i][j] as f32);
          }
        }
        return out;
      }

      /// The average along `axis`: of each column for axis 0, of each row for axis 1.
      fn mean_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<f32, [?]> {
        assert(axis == 0 || axis == 1, "mean_axis takes axis 0 or 1");
        let mut out = Tensor<f32>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        for k in 0..out.len() {
          out[k] = 0.0;
        }
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            let k = if axis == 0 {
              j
            } else {
              i
            };
            out[k] = out[k] + (self[i][j] as f32);
          }
        }
        let count = if axis == 0 {
          self.extent(0)
        } else {
          self.extent(1)
        };
        for k in 0..out.len() {
          out[k] = out[k] / (count as f32);
        }
        return out;
      }

      /// The largest element along `axis`: of each column for axis 0, of each row for axis 1.
      /// A NaN is ignored.
      fn max_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<$t, [?]> {
        assert(axis == 0 || axis == 1, "max_axis takes axis 0 or 1");
        let mut out = Tensor<$t>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        for k in 0..out.len() {
          out[k] = $t::neg_infinity();
        }
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            let k = if axis == 0 {
              j
            } else {
              i
            };
            out[k] = out[k].max(self[i][j]);
          }
        }
        return out;
      }

      /// The smallest element along `axis`: of each column for axis 0, of each row for axis 1.
      /// A NaN is ignored.
      fn min_axis(self : &Tensor<$t, [?, ?]>, axis : i32) -> Tensor<$t, [?]> {
        assert(axis == 0 || axis == 1, "min_axis takes axis 0 or 1");
        let mut out = Tensor<$t>([ if axis == 0 {
          self.extent(1)
        } else {
          self.extent(0)
        } ]);
        for k in 0..out.len() {
          out[k] = $t::infinity();
        }
        for i in 0..self.extent(0) {
          for j in 0..self.extent(1) {
            let k = if axis == 0 {
              j
            } else {
              i
            };
            out[k] = out[k].min(self[i][j]);
          }
        }
        return out;
      }

    }
  };
}

stamp_tensor_rank2_reductions!(f32 , 16 , 0xFF800000 , 0x7F800000);
stamp_tensor_rank2_reductions!(f64 , 8 , 0xFFF0000000000000 , 0x7FF0000000000000);
stamp_half_tensor_rank2_reductions!(f16);
stamp_half_tensor_rank2_reductions!(bf16);

/// `$c = $a @ $b` for 2-D tensors of `$t`, `$c` already shaped `[rows of $a, columns of $b]`.
/// A 4-row by `4 * $lanes`-column block of `$c` at a time, kept in 16 vector registers while `k`
/// runs over the shared dimension, each step a fused multiply-add of one element of `$a`, made
/// into a vector, with one vector of `$b`. Each column block of `$b` is first copied into a
/// buffer, so the block's rows lie next to each other in memory instead of a whole row of `$b`
/// apart; the last column block is padded with zeros, and only the columns of `$c` that exist
/// are written. The last row block reads the last row again for the rows past the end, and does
/// not write them. Each element adds its products in order of `k`, each one fused into the
/// running sum with a single rounding.
macro_rules tensor_matmul_kernel {
  ($c : expr , $a : expr , $b : expr , $t : ident , $lanes : expr) => {
    mlir!( inputs : (%c = $c : memref<?x?x$t>, %a = $a : memref<?x?x$t>, %b = $b : memref<?x?x$t>), returns : i32, dialects : ["arith", "memref", "scf", "vector"]) {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %lanes = arith.constant $lanes : index
      %c4 = arith.constant 4 : index
      %cnv = arith.constant 4 : index
      %nr = arith.muli %lanes, %cnv : index
      %m = memref.dim %a, %c0 : memref<?x?x$t>
      %kk = memref.dim %a, %c1 : memref<?x?x$t>
      %n = memref.dim %b, %c1 : memref<?x?x$t>
      %last_row = arith.subi %m, %c1 : index
      %z = arith.constant dense<0.0> : vector<$lanes x $t>
      %pb = memref.alloc(%kk, %nr) : memref<?x?x$t>
      %cv0 = arith.constant 0 : index
      %po0 = arith.muli %lanes, %cv0 : index
      %cv1 = arith.constant 1 : index
      %po1 = arith.muli %lanes, %cv1 : index
      %cv2 = arith.constant 2 : index
      %po2 = arith.muli %lanes, %cv2 : index
      %cv3 = arith.constant 3 : index
      %po3 = arith.muli %lanes, %cv3 : index
      scf.for %jb = %c0 to %n step %nr {
        %left = arith.subi %n, %jb : index
        %w0 = arith.subi %left, %po0 : index
        %mask0 = vector.create_mask %w0 : vector<$lanes x i1>
        %j0 = arith.addi %jb, %po0 : index
        %w1 = arith.subi %left, %po1 : index
        %mask1 = vector.create_mask %w1 : vector<$lanes x i1>
        %j1 = arith.addi %jb, %po1 : index
        %w2 = arith.subi %left, %po2 : index
        %mask2 = vector.create_mask %w2 : vector<$lanes x i1>
        %j2 = arith.addi %jb, %po2 : index
        %w3 = arith.subi %left, %po3 : index
        %mask3 = vector.create_mask %w3 : vector<$lanes x i1>
        %j3 = arith.addi %jb, %po3 : index
        scf.for %k = %c0 to %kk step %c1 {
          %p0 = vector.maskedload %b[%k, %j0], %mask0, %z : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t> into vector<$lanes x $t>
          vector.store %p0, %pb[%k, %po0] : memref<?x?x$t>, vector<$lanes x $t>
          %p1 = vector.maskedload %b[%k, %j1], %mask1, %z : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t> into vector<$lanes x $t>
          vector.store %p1, %pb[%k, %po1] : memref<?x?x$t>, vector<$lanes x $t>
          %p2 = vector.maskedload %b[%k, %j2], %mask2, %z : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t> into vector<$lanes x $t>
          vector.store %p2, %pb[%k, %po2] : memref<?x?x$t>, vector<$lanes x $t>
          %p3 = vector.maskedload %b[%k, %j3], %mask3, %z : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t> into vector<$lanes x $t>
          vector.store %p3, %pb[%k, %po3] : memref<?x?x$t>, vector<$lanes x $t>
        }
        scf.for %i0 = %c0 to %m step %c4 {
          %i0c = arith.minui %i0, %last_row : index
          %ro1 = arith.constant 1 : index
          %iu1 = arith.addi %i0, %ro1 : index
          %i1c = arith.minui %iu1, %last_row : index
          %ro2 = arith.constant 2 : index
          %iu2 = arith.addi %i0, %ro2 : index
          %i2c = arith.minui %iu2, %last_row : index
          %ro3 = arith.constant 3 : index
          %iu3 = arith.addi %i0, %ro3 : index
          %i3c = arith.minui %iu3, %last_row : index
          %acc:16 = scf.for %k = %c0 to %kk step %c1 iter_args(%s0_0 = %z, %s0_1 = %z, %s0_2 = %z, %s0_3 = %z, %s1_0 = %z, %s1_1 = %z, %s1_2 = %z, %s1_3 = %z, %s2_0 = %z, %s2_1 = %z, %s2_2 = %z, %s2_3 = %z, %s3_0 = %z, %s3_1 = %z, %s3_2 = %z, %s3_3 = %z) -> (vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>) {
            %b0 = vector.load %pb[%k, %po0] : memref<?x?x$t>, vector<$lanes x $t>
            %b1 = vector.load %pb[%k, %po1] : memref<?x?x$t>, vector<$lanes x $t>
            %b2 = vector.load %pb[%k, %po2] : memref<?x?x$t>, vector<$lanes x $t>
            %b3 = vector.load %pb[%k, %po3] : memref<?x?x$t>, vector<$lanes x $t>
            %x0 = memref.load %a[%i0c, %k] : memref<?x?x$t>
            %a0 = "vector.broadcast"(%x0) : ($t) -> vector<$lanes x $t>
            %t0_0 = vector.fma %a0, %b0, %s0_0 : vector<$lanes x $t>
            %t0_1 = vector.fma %a0, %b1, %s0_1 : vector<$lanes x $t>
            %t0_2 = vector.fma %a0, %b2, %s0_2 : vector<$lanes x $t>
            %t0_3 = vector.fma %a0, %b3, %s0_3 : vector<$lanes x $t>
            %x1 = memref.load %a[%i1c, %k] : memref<?x?x$t>
            %a1 = "vector.broadcast"(%x1) : ($t) -> vector<$lanes x $t>
            %t1_0 = vector.fma %a1, %b0, %s1_0 : vector<$lanes x $t>
            %t1_1 = vector.fma %a1, %b1, %s1_1 : vector<$lanes x $t>
            %t1_2 = vector.fma %a1, %b2, %s1_2 : vector<$lanes x $t>
            %t1_3 = vector.fma %a1, %b3, %s1_3 : vector<$lanes x $t>
            %x2 = memref.load %a[%i2c, %k] : memref<?x?x$t>
            %a2 = "vector.broadcast"(%x2) : ($t) -> vector<$lanes x $t>
            %t2_0 = vector.fma %a2, %b0, %s2_0 : vector<$lanes x $t>
            %t2_1 = vector.fma %a2, %b1, %s2_1 : vector<$lanes x $t>
            %t2_2 = vector.fma %a2, %b2, %s2_2 : vector<$lanes x $t>
            %t2_3 = vector.fma %a2, %b3, %s2_3 : vector<$lanes x $t>
            %x3 = memref.load %a[%i3c, %k] : memref<?x?x$t>
            %a3 = "vector.broadcast"(%x3) : ($t) -> vector<$lanes x $t>
            %t3_0 = vector.fma %a3, %b0, %s3_0 : vector<$lanes x $t>
            %t3_1 = vector.fma %a3, %b1, %s3_1 : vector<$lanes x $t>
            %t3_2 = vector.fma %a3, %b2, %s3_2 : vector<$lanes x $t>
            %t3_3 = vector.fma %a3, %b3, %s3_3 : vector<$lanes x $t>
            scf.yield %t0_0, %t0_1, %t0_2, %t0_3, %t1_0, %t1_1, %t1_2, %t1_3, %t2_0, %t2_1, %t2_2, %t2_3, %t3_0, %t3_1, %t3_2, %t3_3 : vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>, vector<$lanes x $t>
          }
          %in0 = arith.cmpi ult, %i0, %m : index
          scf.if %in0 {
            vector.maskedstore %c[%i0, %j0], %mask0, %acc#0 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%i0, %j1], %mask1, %acc#1 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%i0, %j2], %mask2, %acc#2 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%i0, %j3], %mask3, %acc#3 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
          }
          %in1 = arith.cmpi ult, %iu1, %m : index
          scf.if %in1 {
            vector.maskedstore %c[%iu1, %j0], %mask0, %acc#4 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu1, %j1], %mask1, %acc#5 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu1, %j2], %mask2, %acc#6 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu1, %j3], %mask3, %acc#7 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
          }
          %in2 = arith.cmpi ult, %iu2, %m : index
          scf.if %in2 {
            vector.maskedstore %c[%iu2, %j0], %mask0, %acc#8 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu2, %j1], %mask1, %acc#9 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu2, %j2], %mask2, %acc#10 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu2, %j3], %mask3, %acc#11 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
          }
          %in3 = arith.cmpi ult, %iu3, %m : index
          scf.if %in3 {
            vector.maskedstore %c[%iu3, %j0], %mask0, %acc#12 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu3, %j1], %mask1, %acc#13 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu3, %j2], %mask2, %acc#14 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
            vector.maskedstore %c[%iu3, %j3], %mask3, %acc#15 : memref<?x?x$t>, vector<$lanes x i1>, vector<$lanes x $t>
          }
        }
      }
      memref.dealloc %pb : memref<?x?x$t>
      %zero = arith.constant 0 : i32
      macro.yield %zero : i32
    }
  };
}

/// Stamps `matmul` over 2-D tensors of `f32` or `f64`.
macro_rules stamp_tensor_matmul {
  ($t : ident , $lanes : expr) => {
    impl Tensor<$t, [?, ?]> {
      /// The matrix product: a new tensor with as many rows as this one and as many columns as
      /// `other`, element `[i][j]` the sum over `k` of `self[i][k] * other[k][j]`. Refused when
      /// this tensor's column count differs from `other`'s row count.
      fn matmul(self : &Tensor<$t, [?, ?]>, other : &Tensor<$t, [?, ?]>) -> Tensor<$t, [?, ?]> {
        assert(self.extent(1) == other.extent(0), "matmul needs as many columns on the left as rows on the right");
        let mut out = Tensor<$t>([ self.extent(0), other.extent(1) ]);
        let _done : i32 = tensor_matmul_kernel!(&mut out, self, other, $t, $lanes);
        return out;
      }
    }
  };
}

stamp_tensor_matmul!(f32 , 16);
stamp_tensor_matmul!(f64 , 8);
