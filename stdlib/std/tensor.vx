// This module provides standard library methods for the built-in Tensor type.
// Tensors are natively backed by MLIR memref operations in the compiler backend.

impl<T: Float, const N: i32> Tensor<T> {
    // Fills the tensor with a constant value using Linalg
    fn fill(self: &mut Tensor<T>, val: T) -> void {
        mlir!(
            inputs: (%arg_t = self: memref<?x?xf32>, %arg_v = val: f32),
            clobbers: [%arg_t],
            dialects: ["linalg"]
        ) {
        ^bb0(%arg_t: memref<?x?xf32>, %arg_v: f32):
            linalg.fill ins(%arg_v : f32) outs(%arg_t : memref<?x?xf32>)
            macro.yield
        };
    }
}