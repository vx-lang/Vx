//===----------------------------------------------------------------------===//
// TCP and UDP sockets. Each call that can fail gives a `Result` with a `NetError`.
//
// The safe methods take a `String` address and a `Vec<u8>` buffer. The length of the vector is the
// size of the buffer, and a call always uses the whole vector, because Vx has no slices yet. The
// `unsafe` methods that end in `_raw` or `_c_str` take raw pointers. `TcpBufReader` reads lines,
// and `TcpBufWriter` collects small writes into one.
//
// `TcpStream`, `TcpListener`, `UdpSocket` and `TcpBufReader` are sources of `select`: each is
// ready when a read, an `accept` or a `recv` does not wait.
//
// A connection and a bound socket need the right to use the network, a `Network`. A program
// gets it in its `Root`, as `root.network` (`std::root`), and passes `&root.network` on.
//
// The Rust core gives a status for each call: 0 when it worked, a number below 0 for each error
// that `NetError` names, and else the error number of the system. A call that worked writes its
// value through its last pointer.
//===----------------------------------------------------------------------===//
import core::ops;
import core::ptr;
import core::result;
import std::string;
import std::sync::select;
import std::vec;

extern {
  /// The Rust core behind `TcpStream::connect_c_str`.
  pub fn vx_tcp_stream_connect(c_addr : *const i8, out : *mut *mut i8) -> i32;
  /// The Rust core behind `TcpStream::read_raw`.
  pub fn vx_tcp_stream_read(ptr : *mut i8, buffer : *mut u8, len : u64, out : *mut u64) -> i32;
  /// The Rust core behind `TcpStream::write_raw`.
  pub fn vx_tcp_stream_write(ptr : *mut i8, buffer : *const u8, len : u64, out : *mut u64) -> i32;
  /// The Rust core behind dropping a `TcpStream`.
  pub fn vx_tcp_stream_drop(ptr : *mut i8) -> i32;

  /// The Rust core behind `UdpSocket::bind_c_str`.
  pub fn vx_udp_socket_bind(c_addr : *const i8, out : *mut *mut i8) -> i32;
  /// The Rust core behind `UdpSocket::recv_raw`.
  pub fn vx_udp_socket_recv(ptr : *mut i8, buffer : *mut u8, len : u64, out : *mut u64) -> i32;
  /// The Rust core behind `UdpSocket::send_to_raw`.
  pub fn vx_udp_socket_send_to(ptr : *mut i8, buffer : *const u8, len : u64,
  c_addr : *const i8, out : *mut u64) -> i32;
  /// The Rust core behind dropping a `UdpSocket`.
  pub fn vx_udp_socket_drop(ptr : *mut i8) -> i32;

  /// The Rust core behind `TcpListener::bind_c_str`.
  pub fn vx_tcp_listener_bind(c_addr : *const i8, out : *mut *mut i8) -> i32;
  /// The Rust core behind `TcpListener::accept`. Waits until a connection arrives.
  pub fn vx_tcp_listener_accept(ptr : *mut i8, out : *mut *mut i8) -> i32;
  /// The Rust core behind dropping a `TcpListener`.
  pub fn vx_tcp_listener_drop(ptr : *mut i8) -> i32;

  /// The file descriptor of each kind of socket, for a `select`.
  pub fn vx_tcp_stream_fd(ptr : *mut i8) -> i32;
  pub fn vx_tcp_listener_fd(ptr : *mut i8) -> i32;
  pub fn vx_udp_socket_fd(ptr : *mut i8) -> i32;
  /// 1 when a read of `fd` does not wait, else 0.
  pub fn vx_fd_can_read(fd : i32) -> i32;
}

/// The right to open network connections and to bind network addresses. Only this file can
/// make a `Network`, and a program gets one in its `Root` (`std::root`). A function that gets a
/// `&Network` uses it during the call and cannot keep it.
struct Network {
  invariant true,
}

/// The network right of the program, for `std::root`. Unsafe because a second `Network` gives
/// the right to code that did not get it.
pub unsafe fn network_of_the_program() -> Network {
  return Network {};
}

/// Why a network call did not work.
enum NetError {
  // The `tasks` block of this task was cancelled while the call waited.
  Cancelled,
  // The address is not `host:port`, holds a NUL byte, or names a host that has no address.
  BadAddress,
  // Nothing listens at the address.
  Refused,
  // The peer reset the connection, or closed it while a write waited.
  Reset,
  // The peer closed the connection before all the bytes that `read_exact` wants arrived.
  Closed,
  // Another socket uses the address already.
  InUse,
  // Another failure, with the error number of the system, or 0 when it gave none.
  Os(i32),
}

impl Copy for NetError {}

/// The `NetError` of a status that is not 0.
pub fn net_error(status : i32) -> NetError {
  if status == -1 {
    return NetError::Cancelled;
  }
  if status == -2 {
    return NetError::BadAddress;
  }
  if status == -3 {
    return NetError::Refused;
  }
  if status == -4 {
    return NetError::Reset;
  }
  if status == -5 {
    return NetError::InUse;
  }
  if status < 0 {
    return NetError::Os(0);
  }
  return NetError::Os(status);
}

/// A count of bytes, or the error of the call that gave its status.
pub fn count_or_error(status : i32, count : u64) -> Result<u64, NetError> {
  if status == 0 {
    return Result<u64, NetError>::Ok(count);
  }
  return Result<u64, NetError>::Err(net_error(status));
}

/// A NUL-terminated copy of an address, for the Rust core. A drop releases it.
struct CAddress {
  ptr : *const i8,

  invariant true,
}

impl CAddress {
  /// A copy of `addr`, or `BadAddress` when `addr` holds a NUL byte, because a C string ends at
  /// its first NUL.
  pub fn of(addr : &String) -> Result<CAddress, NetError> {
    let ptr = unsafe { vx_string_try_as_c_str(addr.ptr) };
    if is_null(ptr) {
      return Result<CAddress, NetError>::Err(NetError::BadAddress);
    }
    return Result<CAddress, NetError>::Ok(CAddress {
      ptr : ptr
    });
  }
}

impl Drop for CAddress {
  /// Release the copy.
  fn drop(self : &mut CAddress) -> void {
    let _freed = unsafe { vx_string_free_c_str(self.ptr) };
  }
}

/// A connected TCP socket, held by the Rust core behind an opaque pointer.
///
/// Closed when it is dropped.
struct TcpStream {
  ptr : *mut i8,

  invariant true,
}

// The handle may move to another task. It is not `Sync`, because each method takes
// `*mut TcpStream`, so a shared `&TcpStream` has no use yet.
unsafe impl Send for TcpStream {}

impl TcpStream {
  /// Connect to `addr`, written as `host:port`. A task of the shared runtime parks while it
  /// waits.
  ///
  /// Unsafe because nothing checks that `addr` points at a NUL-terminated string.
  pub unsafe fn connect_c_str(addr : *const i8) -> Result<TcpStream, NetError> {
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let status = unsafe {
      vx_tcp_stream_connect(addr, (&mut ptr) as *mut *mut i8)
    };
    if status != 0 {
      return Result<TcpStream, NetError>::Err(net_error(status));
    }
    return Result<TcpStream, NetError>::Ok(TcpStream {
      ptr : ptr
    });
  }

  /// Read up to `len` bytes into `buffer` and give how many arrived. 0 means that the peer
  /// closed the connection. A short read is normal: TCP is a stream, and a message can arrive
  /// in pieces, so a caller that wants a whole one loops.
  ///
  /// Unsafe because `buffer` must have room for `len` bytes.
  pub unsafe fn read_raw(self : *mut TcpStream, buffer : *mut u8, len : u64)
  -> Result<u64, NetError> {
    let mut count : u64 = 0;
    let status = unsafe {
      vx_tcp_stream_read(self.ptr, buffer, len, (&mut count) as *mut u64)
    };
    return count_or_error(status, count);
  }

  /// Write up to `len` bytes from `buffer` and give how many were taken. A short write is
  /// normal, and the rest is not tried again here.
  pub unsafe fn write_raw(self : *mut TcpStream, buffer : *const u8, len : u64)
  -> Result<u64, NetError> {
    let mut count : u64 = 0;
    let status = unsafe {
      vx_tcp_stream_write(self.ptr, buffer, len, (&mut count) as *mut u64)
    };
    return count_or_error(status, count);
  }

  /// Fill all `len` bytes of `buffer`, in as many reads as it takes, and give `len`. When the
  /// peer closes the connection first, it gives `Closed`.
  ///
  /// Unsafe because `buffer` must have room for `len` bytes.
  pub unsafe fn read_exact_raw(self : *mut TcpStream, buffer : *mut u8, len : u64)
  -> Result<u64, NetError> {
    let mut done : u64 = 0;
    while done < len {
      let part = unsafe {
        self.read_raw(add_mut(buffer, done as usize), len - done)
      };
      let n = part?;
      if n == 0 {
        return Result<u64, NetError>::Err(NetError::Closed);
      }
      done = done + n;
    }
    return Result<u64, NetError>::Ok(done);
  }

  /// Write all `len` bytes from `buffer`, in as many writes as it takes, and give `len`. A write
  /// that takes 0 bytes gives `Reset`, because TCP does that only when the connection is gone.
  ///
  /// Unsafe because `buffer` must have `len` bytes to read.
  pub unsafe fn write_all_raw(self : *mut TcpStream, buffer : *const u8, len : u64)
  -> Result<u64, NetError> {
    let mut done : u64 = 0;
    while done < len {
      let part = unsafe {
        self.write_raw(add(buffer, done as usize), len - done)
      };
      let n = part?;
      if n == 0 {
        return Result<u64, NetError>::Err(NetError::Reset);
      }
      done = done + n;
    }
    return Result<u64, NetError>::Ok(done);
  }

  /// Connect to `addr`, written as `host:port`. The caller needs the network right, a
  /// `&Network`. A task of the shared runtime parks while it waits.
  pub fn connect(_network : &Network, addr : &String) -> Result<TcpStream, NetError> {
    let c_addr = CAddress::of(addr)?;
    return unsafe { TcpStream::connect_c_str(c_addr.ptr) };
  }

  /// Read up to `buffer.len()` bytes into `buffer` and give how many arrived. 0 means that the
  /// peer closed the connection. A short read is normal, as for `read_raw`.
  pub fn read(self : &mut TcpStream, buffer : &mut Vec<u8>) -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    return unsafe { self.read_raw(buffer.as_mut_ptr(), len) };
  }

  /// Write up to `buffer.len()` bytes and give how many were taken. A short write is normal.
  /// `write_all` writes them all.
  pub fn write(self : &mut TcpStream, buffer : &Vec<u8>) -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    return unsafe { self.write_raw(buffer.as_mut_ptr() as *const u8, len) };
  }

  /// Fill all of `buffer`, in as many reads as it takes, and give its length. When the peer
  /// closes the connection first, it gives `Closed`.
  pub fn read_exact(self : &mut TcpStream, buffer : &mut Vec<u8>) -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    return unsafe { self.read_exact_raw(buffer.as_mut_ptr(), len) };
  }

  /// Write all of `buffer`, in as many writes as it takes, and give its length.
  pub fn write_all(self : &mut TcpStream, buffer : &Vec<u8>) -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    return unsafe {
      self.write_all_raw(buffer.as_mut_ptr() as *const u8, len)
    };
  }
}

impl WaitSource for TcpStream {
  /// Ready when `read` does not wait: bytes arrived, or the peer closed the connection.
  fn is_ready(self : &TcpStream) -> bool {
    return unsafe { vx_fd_can_read(vx_tcp_stream_fd(self.ptr)) } != 0;
  }

  fn watch(self : &TcpStream, w : &Waiter) -> void {
    w.watch_fd(unsafe { vx_tcp_stream_fd(self.ptr) });
  }

  fn unwatch(self : &TcpStream, w : &Waiter) -> void {
    w.unwatch_fd(unsafe { vx_tcp_stream_fd(self.ptr) });
  }
}

impl Drop for TcpStream {
  /// Close the connection and release it.
  fn drop(self : &mut TcpStream) -> void {
    let _dropped = unsafe { vx_tcp_stream_drop(self.ptr) };
  }
}

/// A bound UDP socket, held by the Rust core behind an opaque pointer.
struct UdpSocket {
  ptr : *mut i8,

  invariant true,
}

// The handle may move to another task. It is not `Sync`, because each method takes
// `*mut UdpSocket`, so a shared `&UdpSocket` has no use yet.
unsafe impl Send for UdpSocket {}

impl UdpSocket {
  /// Bind to `addr`, written as `host:port`.
  ///
  /// Unsafe because nothing checks that `addr` points at a NUL-terminated string.
  pub unsafe fn bind_c_str(addr : *const i8) -> Result<UdpSocket, NetError> {
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let status = unsafe {
      vx_udp_socket_bind(addr, (&mut ptr) as *mut *mut i8)
    };
    if status != 0 {
      return Result<UdpSocket, NetError>::Err(net_error(status));
    }
    return Result<UdpSocket, NetError>::Ok(UdpSocket {
      ptr : ptr
    });
  }

  /// Receive one datagram into `buffer` and give its length. A datagram longer than `len` is
  /// cut, and the rest is lost: UDP works that way. The address of the sender is not given.
  ///
  /// Unsafe because `buffer` must have room for `len` bytes.
  pub unsafe fn recv_raw(self : *mut UdpSocket, buffer : *mut u8, len : u64)
  -> Result<u64, NetError> {
    let mut count : u64 = 0;
    let status = unsafe {
      vx_udp_socket_recv(self.ptr, buffer, len, (&mut count) as *mut u64)
    };
    return count_or_error(status, count);
  }

  /// Send one datagram of `len` bytes to `addr`, and give how many were sent. Nothing makes
  /// sure that it arrives, or arrives once, or arrives in order.
  pub unsafe fn send_to_raw(self : *mut UdpSocket, buffer : *const u8, len : u64,
  addr : *const i8)
  -> Result<u64, NetError> {
    let mut count : u64 = 0;
    let status = unsafe {
      vx_udp_socket_send_to(self.ptr, buffer, len, addr, (&mut count) as *mut u64)
    };
    return count_or_error(status, count);
  }

  /// Bind to `addr`, written as `host:port`. The caller needs the network right, a `&Network`.
  pub fn bind(_network : &Network, addr : &String) -> Result<UdpSocket, NetError> {
    let c_addr = CAddress::of(addr)?;
    return unsafe { UdpSocket::bind_c_str(c_addr.ptr) };
  }

  /// Receive one datagram into `buffer` and give its length. A datagram longer than
  /// `buffer.len()` is cut, as for `recv_raw`. A task of the shared runtime parks while it waits.
  pub fn recv(self : &mut UdpSocket, buffer : &mut Vec<u8>) -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    return unsafe { self.recv_raw(buffer.as_mut_ptr(), len) };
  }

  /// Send all of `buffer` as one datagram to `addr`, and give how many bytes were sent.
  pub fn send_to(self : &mut UdpSocket, buffer : &Vec<u8>, addr : &String)
  -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    let c_addr = CAddress::of(addr)?;
    return unsafe {
      self.send_to_raw(buffer.as_mut_ptr() as *const u8, len, c_addr.ptr)
    };
  }
}

impl WaitSource for UdpSocket {
  /// Ready when `recv` does not wait.
  fn is_ready(self : &UdpSocket) -> bool {
    return unsafe { vx_fd_can_read(vx_udp_socket_fd(self.ptr)) } != 0;
  }

  fn watch(self : &UdpSocket, w : &Waiter) -> void {
    w.watch_fd(unsafe { vx_udp_socket_fd(self.ptr) });
  }

  fn unwatch(self : &UdpSocket, w : &Waiter) -> void {
    w.unwatch_fd(unsafe { vx_udp_socket_fd(self.ptr) });
  }
}

impl Drop for UdpSocket {
  /// Close the socket and release it.
  fn drop(self : &mut UdpSocket) -> void {
    let _dropped = unsafe { vx_udp_socket_drop(self.ptr) };
  }
}

/// A listening TCP socket, held by the Rust core behind an opaque pointer.
struct TcpListener {
  ptr : *mut i8,

  invariant true,
}

// The handle may move to another task. It is not `Sync`, because each method takes
// `*mut TcpListener`, so a shared `&TcpListener` has no use yet.
unsafe impl Send for TcpListener {}

impl TcpListener {
  /// Listen on `addr`, written as `host:port`.
  ///
  /// Unsafe because nothing checks that `addr` points at a NUL-terminated string.
  pub unsafe fn bind_c_str(addr : *const i8) -> Result<TcpListener, NetError> {
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let status = unsafe {
      vx_tcp_listener_bind(addr, (&mut ptr) as *mut *mut i8)
    };
    if status != 0 {
      return Result<TcpListener, NetError>::Err(net_error(status));
    }
    return Result<TcpListener, NetError>::Ok(TcpListener {
      ptr : ptr
    });
  }

  /// Listen on `addr`, written as `host:port`. The caller needs the network right, a
  /// `&Network`. Each connection that `accept` gives needs no other right.
  pub fn bind(_network : &Network, addr : &String) -> Result<TcpListener, NetError> {
    let c_addr = CAddress::of(addr)?;
    return unsafe { TcpListener::bind_c_str(c_addr.ptr) };
  }

  /// Wait for a connection and give it. A task of the shared runtime parks while it waits, so
  /// its OS thread can run other tasks.
  pub fn accept(self : &mut TcpListener) -> Result<TcpStream, NetError> {
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let status = unsafe {
      vx_tcp_listener_accept(self.ptr, (&mut ptr) as *mut *mut i8)
    };
    if status != 0 {
      return Result<TcpStream, NetError>::Err(net_error(status));
    }
    return Result<TcpStream, NetError>::Ok(TcpStream {
      ptr : ptr
    });
  }
}

impl WaitSource for TcpListener {
  /// Ready when `accept` does not wait, because a connection arrived.
  fn is_ready(self : &TcpListener) -> bool {
    return unsafe { vx_fd_can_read(vx_tcp_listener_fd(self.ptr)) } != 0;
  }

  fn watch(self : &TcpListener, w : &Waiter) -> void {
    w.watch_fd(unsafe { vx_tcp_listener_fd(self.ptr) });
  }

  fn unwatch(self : &TcpListener, w : &Waiter) -> void {
    w.unwatch_fd(unsafe { vx_tcp_listener_fd(self.ptr) });
  }
}

impl Drop for TcpListener {
  /// Stop listening and release the socket.
  fn drop(self : &mut TcpListener) -> void {
    let _dropped = unsafe { vx_tcp_listener_drop(self.ptr) };
  }
}

/// The size of the buffer of a `TcpBufReader` or a `TcpBufWriter`, in bytes.
const NET_BUFFER_SIZE : i32 = 4096;

/// A `TcpStream` with a buffer for reads, so that `read_line` reads many bytes per call of the
/// system, not one.
struct TcpBufReader {
  stream : TcpStream,
  buffer : Vec<u8>,
  // The next byte of `buffer` to give.
  start : i32,
  // The end of the bytes in `buffer` that are not given yet.
  end : i32,
}

impl TcpBufReader {
  /// A reader of `stream`.
  pub fn new(stream : TcpStream) -> TcpBufReader {
    return TcpBufReader {
      stream : stream, buffer : unsafe { Vec<u8>::zeroed(NET_BUFFER_SIZE) }, start : 0, end : 0
    };
  }

  /// The stream, for example to write a reply. Read through the reader, not through the stream,
  /// because the reader can hold the next bytes in its buffer.
  pub fn get_mut(self : &mut TcpBufReader) -> &mut TcpStream {
    return &mut self.stream;
  }

  /// Copy up to `len` bytes that the reader holds to `to`, and give how many it copied.
  ///
  /// Unsafe because `to` must have room for `len` bytes.
  pub unsafe fn take_buffered_raw(self : &mut TcpBufReader, to : *mut u8, len : u64) -> u64 {
    let mut n = (self.end - self.start) as u64;
    if n > len {
      n = len;
    }
    let from = add(self.buffer.as_mut_ptr() as *const u8, self.start as usize);
    unsafe { copy_nonoverlapping(from, to, n as usize); }
    self.start = self.start + (n as i32);
    return n;
  }

  /// Read up to `buffer.len()` bytes into `buffer` and give how many came. The bytes that the
  /// reader holds come first. 0 means that the peer closed the connection.
  pub fn read(self : &mut TcpBufReader, buffer : &mut Vec<u8>) -> Result<u64, NetError> {
    if self.start == self.end {
      return self.stream.read(buffer);
    }
    let len = buffer.len() as u64;
    return Result<u64, NetError>::Ok(unsafe {
      self.take_buffered_raw(buffer.as_mut_ptr(), len)
    });
  }

  /// Fill all of `buffer` and give its length. The bytes that the reader holds come first, and
  /// then reads of the stream. When the peer closes the connection first, it gives `Closed`.
  pub fn read_exact(self : &mut TcpBufReader, buffer : &mut Vec<u8>) -> Result<u64, NetError> {
    let len = buffer.len() as u64;
    let data = buffer.as_mut_ptr();
    let done = unsafe { self.take_buffered_raw(data, len) };
    let rest = unsafe {
      self.stream.read_exact_raw(add_mut(data, done as usize), len - done)
    };
    let _n = rest?;
    return Result<u64, NetError>::Ok(len);
  }

  /// Add the bytes of the next line, with its `\n`, to the end of `line`, and give how many it
  /// added. The last line can have no `\n`. 0 means that the peer closed the connection.
  ///
  /// A line has no length limit. A peer that never sends `\n` makes `line` grow until the memory
  /// runs out.
  pub fn read_line(self : &mut TcpBufReader, line : &mut Vec<u8>) -> Result<u64, NetError> {
    let mut count : u64 = 0;
    let mut found = false;
    while !found {
      if self.start == self.end {
        let n = self.stream.read(&mut self.buffer)?;
        if n == 0 {
          return Result<u64, NetError>::Ok(count);
        }
        self.start = 0;
        self.end = n as i32;
      }
      let data = self.buffer.as_mut_ptr() as *const u8;
      let mut stop = self.start;
      while stop < self.end && !found {
        found = unsafe { data[stop] } == 10u8;
        stop = stop + 1;
      }
      unsafe {
        line.extend_from_raw(add(data, self.start as usize), stop - self.start);
      }
      count = count + ((stop - self.start) as u64);
      self.start = stop;
    }
    return Result<u64, NetError>::Ok(count);
  }
}

impl WaitSource for TcpBufReader {
  /// Ready when the buffer holds bytes, or a read of the stream does not wait.
  fn is_ready(self : &TcpBufReader) -> bool {
    return self.start < self.end || self.stream.is_ready();
  }

  fn watch(self : &TcpBufReader, w : &Waiter) -> void {
    self.stream.watch(w);
  }

  fn unwatch(self : &TcpBufReader, w : &Waiter) -> void {
    self.stream.unwatch(w);
  }
}

/// A `TcpStream` with a buffer for writes. Small writes go into the buffer, and `flush` sends them
/// in one write. A drop flushes too, but it cannot report an error, so call `flush` first.
struct TcpBufWriter {
  stream : TcpStream,
  buffer : Vec<u8>,
  // The number of bytes in `buffer` that are not sent yet.
  used : i32,
}

impl TcpBufWriter {
  /// A writer to `stream`.
  pub fn new(stream : TcpStream) -> TcpBufWriter {
    return TcpBufWriter {
      stream : stream, buffer : unsafe { Vec<u8>::zeroed(NET_BUFFER_SIZE) }, used : 0
    };
  }

  /// The stream, for example to read a reply. Call `flush` first, so that the peer gets all bytes.
  pub fn get_mut(self : &mut TcpBufWriter) -> &mut TcpStream {
    return &mut self.stream;
  }

  /// Add all of `bytes` to the buffer, and give their count. When they do not fit, it flushes the
  /// buffer first. When they are more than the buffer holds, it writes them at once.
  pub fn write(self : &mut TcpBufWriter, bytes : &Vec<u8>) -> Result<u64, NetError> {
    let n = bytes.len();
    if self.used + n > self.buffer.len() {
      let _sent = self.flush()?;
    }
    if n > self.buffer.len() {
      return self.stream.write_all(bytes);
    }
    let to = add_mut(self.buffer.as_mut_ptr(), self.used as usize);
    unsafe {
      copy_nonoverlapping(bytes.as_mut_ptr() as *const u8, to, n as usize);
    }
    self.used = self.used + n;
    return Result<u64, NetError>::Ok(n as u64);
  }

  /// Send all bytes in the buffer, and give their count. The buffer is empty afterwards, also when
  /// a write fails. Then the program cannot know how many of the bytes the peer got.
  pub fn flush(self : &mut TcpBufWriter) -> Result<u64, NetError> {
    let len = self.used as u64;
    self.used = 0;
    return unsafe {
      self.stream.write_all_raw(self.buffer.as_mut_ptr() as *const u8, len)
    };
  }
}

impl Drop for TcpBufWriter {
  /// Send the bytes in the buffer. An error is lost, because a drop gives no value. In a
  /// cancelled `tasks` block the send gives `Cancelled`, so the bytes are lost.
  fn drop(self : &mut TcpBufWriter) -> void {
    let _sent = self.flush();
  }
}
