extern {
  fn vx_tcp_stream_connect(c_addr : *const i8) -> *mut i8;
  fn vx_tcp_stream_read(ptr : *mut i8, buffer : *mut u8, len : i64) -> i64;
  fn vx_tcp_stream_write(ptr : *mut i8, buffer : *const u8, len : i64) -> i64;
  fn vx_tcp_stream_drop(ptr : *mut i8) -> i32;

  fn vx_udp_socket_bind(c_addr : *const i8) -> *mut i8;
  fn vx_udp_socket_recv(ptr : *mut i8, buffer : *mut u8, len : i64) -> i64;
  fn vx_udp_socket_send_to(ptr : *mut i8, buffer : *const u8, len : i64,
  c_addr : *const i8) -> i64;
  fn vx_udp_socket_drop(ptr : *mut i8) -> i32;

  fn vx_tcp_listener_bind(c_addr : *const i8) -> *mut i8;
  fn vx_tcp_listener_accept(ptr : *mut i8) -> *mut i8;
  fn vx_tcp_listener_drop(ptr : *mut i8) -> i32;
}

struct TcpStream {
  ptr : *mut i8,
}

impl TcpStream {
  unsafe fn connect(addr : *const i8) -> TcpStream {
    let ptr = unsafe { vx_tcp_stream_connect(addr) };
    TcpStream {
      ptr:
      ptr
    }
  }

  unsafe fn read(self : *mut TcpStream, buffer : *mut u8, len : i64)
  -> i64 {
    unsafe { vx_tcp_stream_read(self.ptr, buffer, len) }
  }

  unsafe fn write(self : *mut TcpStream, buffer : *const u8, len : i64)
  ->i64 {
    unsafe { vx_tcp_stream_write(self.ptr, buffer, len) }
  }
}

unsafe fn tcp_stream_drop(stream : *mut TcpStream) -> void {
  let _dropped = unsafe { vx_tcp_stream_drop(stream.ptr) };
}

struct UdpSocket {
  ptr : *mut i8,
}

impl UdpSocket {
  unsafe fn bind(addr : *const i8) -> UdpSocket {
    let ptr = unsafe { vx_udp_socket_bind(addr) };
    UdpSocket {
      ptr:
      ptr
    }
  }

  unsafe fn recv(self : *mut UdpSocket, buffer : *mut u8, len : i64)
  -> i64 {
    unsafe { vx_udp_socket_recv(self.ptr, buffer, len) }
  }

  unsafe fn send_to(self : *mut UdpSocket, buffer : *const u8, len : i64,
  addr : *const i8)
  ->i64 {
    unsafe { vx_udp_socket_send_to(self.ptr, buffer, len, addr) }
  }
}

unsafe fn udp_socket_drop(socket : *mut UdpSocket) -> void {
  let _dropped = unsafe { vx_udp_socket_drop(socket.ptr) };
}

struct TcpListener {
  ptr : *mut i8,
}

impl TcpListener {
  unsafe fn bind(addr : *const i8) -> TcpListener {
    let ptr = unsafe { vx_tcp_listener_bind(addr) };
    TcpListener {
      ptr:
      ptr
    }
  }

  fn accept(self : *mut TcpListener) -> TcpStream {
    let stream_ptr = unsafe { vx_tcp_listener_accept(self.ptr) };
    TcpStream {
      ptr:
      stream_ptr
    }
  }
}

unsafe fn tcp_listener_drop(listener : *mut TcpListener) -> void {
  let _dropped = unsafe { vx_tcp_listener_drop(listener.ptr) };
}
