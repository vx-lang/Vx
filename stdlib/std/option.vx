extern "C" {
  fn malloc(size: i32) -> *mut i8;
}

enum Option<T> {
  Some(T),
  None,
}

impl<T> Option<T> {
  fn is_some(self: &Option<T>) -> Bool {
    match *self {
      Option<T>::Some(v) => { return true; }
      Option<T>::None() => { return false; }
    }
    return false;
  }

  fn unwrap(self: Option<T>) -> T {
    match self {
      Option<T>::Some(v) => { return v; }
      Option<T>::None() => {
        let ptr: *mut T = unsafe { malloc(0) };
        return unsafe { *ptr };
      }
    }
    let ptr: *mut T = unsafe { malloc(0) };
    return unsafe { *ptr };
  }
}
