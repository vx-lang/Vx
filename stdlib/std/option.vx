import std::alloc;

enum Option<T> {
  Some(T),
  None,
}

impl<T>
Option<T> {
  fn is_some(self : &Option<T>) -> Bool {
    let mut ret = false;
    match *self {
      Option<T>::Some(v) => { ret = true; }
      Option<T>::None() => { ret = false; }
    }
    return ret;
  }

  fn is_none(self : &Option<T>) -> Bool {
    let mut ret = true;
    match *self {
      Option<T>::Some(v) => { ret = false; }
      Option<T>::None() => { ret = true; }
    }
    return ret;
  }

  fn unwrap(self : Option<T>) -> T {
    match self {
      Option<T>::Some(v) => { return v; }
      Option<T>::None() => {
        assert(false, "unwrap called on None");
      }
    }
  }
}
