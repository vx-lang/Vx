//===----------------------------------------------------------------------===//
// The environment variables of a program. The program that starts a process chooses them, and
// they often hold secrets, such as the token of a service. So reading them is a right: a function
// reads a variable only when it gets a `&Environment`.
//===----------------------------------------------------------------------===//

import core::result;
import std::string;

extern {
  /// The Rust core behind `Environment::var`: 0 and the value in `*value`, 1 when the
  /// environment has no such variable, 2 when the value is not UTF-8.
  fn vx_env_try_var(name : *mut i8, value : *mut *mut i8) -> i32;
}

/// The right to read the environment variables of the program. Only this file can make an
/// `Environment`, and a program gets one in its `Root` (`std::root`). A function that gets a
/// `&Environment` uses it during the call and cannot keep it.
struct Environment {
  invariant true,
}

/// The environment right of the program, for `std::root`. Only `std` can call it, because a
/// second `Environment` gives the right to code that did not get it.
pkg unsafe fn environment_of_the_program() -> Environment {
  return Environment {};
}

/// Why `Environment::var` gave no value.
enum EnvError {
  // The environment has no variable with the name. A name that is empty or holds `=` or a NUL
  // byte names no variable.
  NotPresent,
  // The value is not UTF-8 text, so a `String` cannot hold it.
  NotUnicode,
}

impl Environment {
  /// The value of the environment variable `name`.
  pub fn var(self : &Environment, name : &String) -> Result<String, EnvError> {
    let mut value : *mut i8 = unsafe { 0 as *mut i8 };
    let code = unsafe {
      vx_env_try_var(name.ptr, (&mut value) as *mut *mut i8)
    };
    if code == 1 {
      return Result<String, EnvError>::Err(EnvError::NotPresent);
    }
    if code == 2 {
      return Result<String, EnvError>::Err(EnvError::NotUnicode);
    }
    return Result<String, EnvError>::Ok(unsafe { String::from_raw(value) });
  }
}
