//===----------------------------------------------------------------------===//
// The capabilities of a program: the rights to use the operating system. A program gets them as
// the parameter of `main`, `fn main(root : Root) -> i32`, and passes each one on to the code that
// needs it. `root.args` holds the words of the command line. A library gets only the capabilities that its caller passes. So a library that gets
// no `&Files` cannot open a file, and a library that gets no `&Network` cannot open a connection.
// `docs/discussions/capability_types.md` explains the design.
//===----------------------------------------------------------------------===//

import std::fs;
import std::net;
import std::string;
import std::vec;

/// The capabilities of a program. Only this file can make a `Root`, and the compiler makes one
/// for a `main` that takes it.
struct Root {
  // The right to open network connections and to bind network addresses.
  network : Network,
  // The right to open files.
  files : Files,
  // The words of the command line: the path of the program, then each argument.
  args : Vec<String>,

  invariant true,
}

/// The `Root` of the program, with the `argc` words of `argv` that C gives `main`. The compiler
/// calls it once, for a `main` that takes a `Root`. Unsafe because a second `Root` gives the
/// rights to code that did not get them, and because `argv` must hold `argc` C strings.
pub unsafe fn root_of_the_program(argc : i32, argv : *mut *mut i8) -> Root {
  let mut args : Vec<String> = Vec::new();
  let mut i = 0;
  while i < argc {
    let word : *const i8 = unsafe { argv[i] };
    args.push(unsafe { String::from_c_str(word) });
    i = i + 1;
  }
  return Root {
    network : unsafe { network_of_the_program() },
    files : unsafe { files_of_the_program() },
    args : args
  };
}
