import core::mem;
import core::ops;
import std::alloc;

/// A single-owner heap allocation, which is what makes a recursive type possible.
///
/// Dropping it drops the value, then frees the allocation.
struct Box<T> {
  ptr : *mut T,
}

impl<T>
Box<T> {
  /// Move a value to the heap.
  ///
  /// The allocation is not checked: `malloc` answering null gives a `Box` that writes through
  /// a null pointer, and Vx cannot test one (Vx#714).
  fn new (val : T)->Box<T> {
    let size_bytes : i64 = sizeof<T>();
    let p : *mut T = unsafe { malloc(size_bytes) };
    unsafe { *p = val; }
    return Box<T> {
      ptr : p
    };
  }
}

impl<T> Drop for Box<T> {
  fn drop(self : &mut Box<T>) -> void {
    let value : T = unsafe { *self.ptr };
    drop(value);
    unsafe { let ptr_i8 : *mut i8 = self.ptr; free(ptr_i8); }
  }
}
