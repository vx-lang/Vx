import core::mem;
import core::ops;
import core::ptr;
import std::alloc;

/// A single-owner heap allocation, which is what makes a recursive type possible.
///
/// Dropping it drops the value, then frees the allocation.
struct Box<T> {
  ptr : *mut T,

  invariant true,
}

// A `Box<T>` owns its `T`s, so it crosses tasks as a `T` does.
unsafe impl<T : Send> Send for Box<T> {}
unsafe impl<T : Sync> Sync for Box<T> {}

impl<T>
Box<T> {
  /// Move a value to the heap. Stops the program when there is no memory.
  pub fn new (val : T)->Box<T> {
    let p : *mut T = alloc(sizeof<T>(), 16);
    if is_null_mut(p) {
      panic("Box: out of memory");
    }
    unsafe { *p = val; }
    return Box<T> {
      ptr : p
    };
  }

  /// A reference to the value. It keeps the box borrowed while it is in use.
  pub fn get(self : &Box<T>) -> &T {
    return unsafe { &*self.ptr };
  }

  /// A mutable reference to the value. It keeps the box borrowed while it is in use.
  pub fn get_mut(self : &mut Box<T>) -> &mut T {
    return unsafe { &mut *self.ptr };
  }

  /// The value, moved out of the box. The allocation is freed, and the value is not dropped.
  pub fn into_inner(self : Box<T>) -> T {
    let value : T = unsafe { read(self.ptr as *const T) };
    let ptr_i8 : *mut i8 = self.ptr;
    unsafe { dealloc(ptr_i8, 16) };
    forget(self);
    return value;
  }
}

impl<T> Drop for Box<T> {
  fn drop(self : &mut Box<T>) -> void {
    let value : T = unsafe { read(self.ptr as *const T) };
    drop(value);
    let ptr_i8 : *mut i8 = self.ptr;
    unsafe { dealloc(ptr_i8, 16) };
  }
}
