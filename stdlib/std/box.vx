import core::mem;
import core::ops;
import core::ptr;
import std::alloc;

/// A single-owner heap allocation, which is what makes a recursive type possible.
///
/// Dropping it drops the value, then frees the allocation.
struct Box<T> {
  ptr : *mut T,
}

// A `Box<T>` owns its `T`s, so it crosses tasks as a `T` does.
unsafe impl<T : Send> Send for Box<T> {}
unsafe impl<T : Sync> Sync for Box<T> {}

impl<T>
Box<T> {
  /// Move a value to the heap. Stops the program when there is no memory.
  fn new (val : T)->Box<T> {
    let p : *mut T = alloc(sizeof<T>(), 16);
    if is_null_mut(p) {
      panic("Box: out of memory");
    }
    unsafe { *p = val; }
    return Box<T> {
      ptr : p
    };
  }
}

impl<T> Drop for Box<T> {
  fn drop(self : &mut Box<T>) -> void {
    let value : T = unsafe { *self.ptr };
    drop(value);
    let ptr_i8 : *mut i8 = self.ptr;
    dealloc(ptr_i8, 16);
  }
}
