// The `extern` block here maps directly to the C-ABI FFI functions
// exposed by `libvx_std_core.dylib` (via `rt.rs` and `math.rs`).
// This allows Vx to hook into native mathematical operations at the LLVM level.
extern {
  fn vx_math_sin_f32(x: f32) -> f32;
  fn vx_math_cos_f32(x: f32) -> f32;
  fn vx_math_tan_f32(x: f32) -> f32;
  fn vx_math_asin_f32(x: f32) -> f32;
  fn vx_math_acos_f32(x: f32) -> f32;
  fn vx_math_atan_f32(x: f32) -> f32;
  fn vx_math_abs_f32(x: f32) -> f32;
  fn vx_math_sqrt_f32(x: f32) -> f32;
  fn vx_math_exp_f32(x: f32) -> f32;
  fn vx_math_log_f32(x: f32) -> f32;
  fn vx_math_log2_f32(x: f32) -> f32;
  fn vx_math_log10_f32(x: f32) -> f32;

  fn vx_math_sin_f64(x: f64) -> f64;
  fn vx_math_cos_f64(x: f64) -> f64;
  fn vx_math_tan_f64(x: f64) -> f64;
  fn vx_math_abs_f64(x: f64) -> f64;
  fn vx_math_sqrt_f64(x: f64) -> f64;
  fn vx_math_exp_f64(x: f64) -> f64;
  fn vx_math_log_f64(x: f64) -> f64;
  fn vx_math_asin_f64(x: f64) -> f64;
  fn vx_math_acos_f64(x: f64) -> f64;
  fn vx_math_atan_f64(x: f64) -> f64;
  fn vx_math_log2_f64(x: f64) -> f64;
  fn vx_math_log10_f64(x: f64) -> f64;
}

trait Math {
  fn sin(self) -> Self;
  fn cos(self) -> Self;
  fn tan(self) -> Self;
  fn abs(self) -> Self;
  fn sqrt(self) -> Self;
  fn exp(self) -> Self;
  fn ln(self) -> Self;
  fn asin(self) -> Self;
  fn acos(self) -> Self;
  fn atan(self) -> Self;
  fn log2(self) -> Self;
  fn log10(self) -> Self;
}

impl Math for f32 {
  fn sin(self) -> f32 { vx_math_sin_f32(self) }
  fn cos(self) -> f32 { vx_math_cos_f32(self) }
  fn tan(self) -> f32 { vx_math_tan_f32(self) }
  fn abs(self) -> f32 { vx_math_abs_f32(self) }
  fn sqrt(self) -> f32 { vx_math_sqrt_f32(self) }
  fn exp(self) -> f32 { vx_math_exp_f32(self) }
  fn ln(self) -> f32 { vx_math_log_f32(self) }
  fn asin(self) -> f32 { vx_math_asin_f32(self) }
  fn acos(self) -> f32 { vx_math_acos_f32(self) }
  fn atan(self) -> f32 { vx_math_atan_f32(self) }
  fn log2(self) -> f32 { vx_math_log2_f32(self) }
  fn log10(self) -> f32 { vx_math_log10_f32(self) }
}

impl Math for f64 {
  fn sin(self) -> f64 { vx_math_sin_f64(self) }
  fn cos(self) -> f64 { vx_math_cos_f64(self) }
  fn tan(self) -> f64 { vx_math_tan_f64(self) }
  fn abs(self) -> f64 { vx_math_abs_f64(self) }
  fn sqrt(self) -> f64 { vx_math_sqrt_f64(self) }
  fn exp(self) -> f64 { vx_math_exp_f64(self) }
  fn ln(self) -> f64 { vx_math_log_f64(self) }
  fn asin(self) -> f64 { vx_math_asin_f64(self) }
  fn acos(self) -> f64 { vx_math_acos_f64(self) }
  fn atan(self) -> f64 { vx_math_atan_f64(self) }
  fn log2(self) -> f64 { vx_math_log2_f64(self) }
  fn log10(self) -> f64 { vx_math_log10_f64(self) }
}
