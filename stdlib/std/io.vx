import core::ops;
import core::option;
import core::result;

extern {
  /// Classify a native code for this host using the file bridge category table.
  fn vx_io_error_kind(code : i32) -> i32;
}

/// A file position. Start offsets are unsigned; relative offsets are signed.
enum SeekFrom {
  Start(u64), Current(i64), End(i64),
}
impl Copy for SeekFrom {}

/// An object with a fallible byte position. Seeking alone does not access a caller's memory.
trait Seek {
  /// Change the byte position and return the new absolute position.
  fn seek_to(self : &mut Self, from : SeekFrom) -> Result<u64, Error>;
  /// Return the current byte position without changing it.
  fn stream_position(self : &mut Self) -> Result<u64, Error> {
    return self.seek_to(SeekFrom::Current(0));
  }

}


/// A portable reason for an I/O failure.
enum ErrorKind {
  NotFound, PermissionDenied, AlreadyExists, InvalidInput, Interrupted,
  WouldBlock, UnexpectedEof, WriteZero, OutOfMemory, LimitExceeded, Unsupported, Other,
}
impl Copy for ErrorKind {}

/// The operation that failed.
enum Operation {
  Open, Read, Write, Seek, Sync, Close, Unspecified,
}
impl Copy for Operation {}

/// An I/O failure with an optional native code. Inspection does not allocate.
struct Error {
  category : ErrorKind,
  action : Operation,
  native : Option<i32>,
}
impl Copy for Error {}

impl Error {
  /// Create a portable error without a native code or operation context.
  fn from_kind(kind : ErrorKind) -> Error {
    return Error {
      category : kind, action : Operation::Unspecified(), native : Option<i32>::None()
    };
  }

  /// Classify a native OS code for this host, preserving the exact code.
  fn from_raw_os_error(code : i32) -> Error {
    let status = unsafe { vx_io_error_kind(code) };
    return io_error_from_bridge(status, Operation::Unspecified(), code, true);
  }

  /// Attach operation context without changing the category or native code.
  fn with_operation(self : Error, operation : Operation) -> Error {
    let mut error = self;
    error.action = operation;
    return error;
  }

  /// The portable category of this failure.
  fn kind(self : &Error) -> ErrorKind {
    return self.category;
  }

  /// The operation that failed.
  fn operation(self : &Error) -> Operation {
    return self.action;
  }

  /// The native code, when the backend supplied one.
  fn raw_os_error(self : &Error) -> Option<i32> {
    return self.native;
  }

  /// A static category description. The caller must not free this pointer.
  fn message_c_str(self : &Error) -> *const i8 {
    match self.category {
      ErrorKind::NotFound() => {
        return "not found";
      }
      ErrorKind::PermissionDenied() => {
        return "permission denied";
      }
      ErrorKind::AlreadyExists() => {
        return "already exists";
      }
      ErrorKind::InvalidInput() => {
        return "invalid input";
      }
      ErrorKind::Interrupted() => {
        return "interrupted";
      }
      ErrorKind::WouldBlock() => {
        return "would block";
      }
      ErrorKind::UnexpectedEof() => {
        return "unexpected end of file";
      }
      ErrorKind::WriteZero() => {
        return "write made no progress";
      }
      ErrorKind::OutOfMemory() => {
        return "out of memory";
      }
      ErrorKind::LimitExceeded() => {
        return "limit exceeded";
      }
      ErrorKind::Unsupported() => {
        return "unsupported operation";
      }
      ErrorKind::Other() => {
        return "I/O error";
      }
    }
  }
}

/// Decode the private file bridge status. Unknown statuses violate the bridge contract.
fn io_error_from_bridge(status : i32, operation : Operation, code : i32, has_code : bool) -> Error {
  assert(status >= -1 && status <= 12 && status != 0, "invalid file error status");
  let mut kind = ErrorKind::Other();
  match status {
    -1 => {
      kind = ErrorKind::InvalidInput();
    }
    1 => {
      kind = ErrorKind::NotFound();
    }
    2 => {
      kind = ErrorKind::PermissionDenied();
    }
    3 => {
      kind = ErrorKind::AlreadyExists();
    }
    4 => {
      kind = ErrorKind::InvalidInput();
    }
    5 => {
      kind = ErrorKind::Interrupted();
    }
    6 => {
      kind = ErrorKind::WouldBlock();
    }
    7 => {
      kind = ErrorKind::UnexpectedEof();
    }
    8 => {
      kind = ErrorKind::WriteZero();
    }
    9 => {
      kind = ErrorKind::OutOfMemory();
    }
    10 => {
      kind = ErrorKind::LimitExceeded();
    }
    11 => {
      kind = ErrorKind::Unsupported();
    }
    _ => {}
  }
  if status != -1 && has_code {
    return Error {
      category : kind, action : operation, native : Option<i32>::Some(code)
    };
  }
  return Error::from_kind(kind).with_operation(operation);
}

extern {
  /// The Rust core behind `stdout_write`.
  fn vx_stdout_write(buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `stderr_write`.
  fn vx_stderr_write(buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `stdin_read`.
  fn vx_stdin_read(buffer : *mut u8, len : u64) -> u64;
}

/// Write `len` bytes to standard output and answer how many were taken.
///
/// A short write is possible and is not retried here. Unsafe because `buffer` must have `len`
/// bytes to read.
unsafe fn stdout_write(buffer : *const u8, len : u64)
-> u64 {
  unsafe { vx_stdout_write(buffer, len) }
}

/// Write `len` bytes to standard error, with the same caveats as `stdout_write`.
unsafe fn stderr_write(buffer : *const u8, len : u64)
->u64 {
  unsafe { vx_stderr_write(buffer, len) }
}

/// Read up to `len` bytes from standard input and answer how many arrived.
///
/// Zero means end of input or an error, which are not told apart. Unsafe because `buffer` must
/// have room for `len` bytes.
unsafe fn stdin_read(buffer : *mut u8, len : u64)
->u64 {
  unsafe { vx_stdin_read(buffer, len) }
}
