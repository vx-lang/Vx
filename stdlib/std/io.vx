extern {
  fn vx_printf_i32(format: *const i8, val: i32) -> i32;
  fn vx_printf_f32(format: *const i8, val: f32) -> i32;
  fn vx_printf_f64(format: *const i8, val: f64) -> i32;
  fn vx_safe_printf(piece: *const i8) -> i32;
  fn vx_stdout_write(buffer: *const u8, len: i64) -> i64;
  fn vx_stderr_write(buffer: *const u8, len: i64) -> i64;
  fn vx_stdin_read(buffer: *mut u8, len: i64) -> i64;
}

fn stdout_write(buffer: *const u8, len: i64) -> i64 {
  vx_stdout_write(buffer, len)
}

fn stderr_write(buffer: *const u8, len: i64) -> i64 {
  vx_stderr_write(buffer, len)
}

fn stdin_read(buffer: *mut u8, len: i64) -> i64 {
  vx_stdin_read(buffer, len)
}

fn print_i32(val: i32) -> i32 {
  vx_printf_i32("%d
", val)
}

fn print_f32(val: f32) -> i32 {
  vx_printf_f32("%f
", val)
}

fn print_f64(val: f64) -> i32 {
  vx_printf_f64("%f
", val)
}

fn print_str(piece: *const i8) -> i32 {
  vx_safe_printf(piece)
}
