extern {
  fn vx_stdout_write(buffer : *const u8, len : i64) -> i64;
  fn vx_stderr_write(buffer : *const u8, len : i64) -> i64;
  fn vx_stdin_read(buffer : *mut u8, len : i64) -> i64;
}

fn stdout_write(buffer : *const u8, len : i64)
-> i64{vx_stdout_write(buffer, len)}

fn stderr_write(buffer : *const u8, len : i64)
->i64{vx_stderr_write(buffer, len)}

fn stdin_read(buffer : *mut u8, len : i64)
->i64 {
  vx_stdin_read(buffer, len)
}
