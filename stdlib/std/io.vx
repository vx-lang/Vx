//===----------------------------------------------------------------------===//
// Input and output on the host: the error type of every I/O operation, the `Seek` trait, and
// the standard streams.
//
// Layer: the OS layer. Runs on: the host only.
//
// Stage: `Error`, `ErrorKind`, `Operation`, `SeekFrom` and `Seek` are incubating, with the
// feature name `file_io_errors`.
//
// Differences from Rust:
//
// - `Error` is a small value that a program can copy. It holds a kind, the operation that
//   failed, and the error code of the operating system. It holds no message text.
// - `Error::message_c_str` returns a C string, because Vx has no text formatting traits yet.
// - `Seek::seek_to` is Rust's `Seek::seek`.
//===----------------------------------------------------------------------===//
import core::ops;
import core::option;
import core::result;

extern {
  /// Classify a native code for this host using the file bridge category table.
  fn vx_io_error_kind(code : i32) -> i32;
}

/// A position in a file, for `Seek::seek_to`. `Start` counts from the start of the file, and
/// cannot be negative. `Current` counts from the current position, and `End` from the end of the
/// file. These two can be negative.
///
/// # Stage
///
/// Incubating, with the feature name `file_io_errors`.
enum SeekFrom {
  Start(u64), Current(i64), End(i64),
}
impl Copy for SeekFrom {}

/// A value with a byte position that a program can move, such as a `File`.
///
/// # Stage
///
/// Incubating, with the feature name `file_io_errors`.
trait Seek {
  /// Move the position, and return the new position from the start.
  ///
  /// # Errors
  ///
  /// Each type says which errors it returns. `File` lists its errors.
  fn seek_to(self : &mut Self, from : SeekFrom) -> Result<u64, Error>;

  /// Return the current position from the start, and do not move it.
  ///
  /// # Errors
  ///
  /// The errors of `seek_to`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let mut file = (unsafe { File::create_raw("/tmp/vx_example_position.txt") }).unwrap();
  /// let letter : u8 = 65;
  /// (unsafe { file.write_raw((&letter) as *const u8, 1) }).unwrap();
  /// assert(file.stream_position().unwrap() == 1, "one byte after the start");
  /// ```
  fn stream_position(self : &mut Self) -> Result<u64, Error> {
    return self.seek_to(SeekFrom::Current(0));
  }
}

/// The kind of an I/O error. The kind is the same on each operating system, so a program can
/// decide what to do from it.
///
/// A program that matches on an `ErrorKind` must have a `_` arm, because a later release can
/// add kinds.
///
/// # Stage
///
/// Incubating, with the feature name `file_io_errors`.
enum ErrorKind {
  NotFound, PermissionDenied, AlreadyExists, InvalidInput, Interrupted,
  WouldBlock, UnexpectedEof, WriteZero, OutOfMemory, LimitExceeded, Unsupported, Other,
}
impl Copy for ErrorKind {}

/// The operation that failed: open, read, write, seek, sync or close. `Unspecified` means that
/// the error does not say.
///
/// A program that matches on an `Operation` must have a `_` arm, because a later release can add
/// operations.
///
/// # Stage
///
/// Incubating, with the feature name `file_io_errors`.
enum Operation {
  Open, Read, Write, Seek, Sync, Close, Unspecified,
}
impl Copy for Operation {}

/// An I/O error. It holds a kind, the operation that failed, and the error code of the operating
/// system when there is one. Making or reading an `Error` does not allocate memory.
///
/// # Stage
///
/// Incubating, with the feature name `file_io_errors`. `Error` is `Copy` today. A later message
/// or cause can make it stop being `Copy`, so code must not depend on it.
///
/// # Example
///
/// One example covers each method of `Error`.
///
/// ```vx
/// let error = Error::from_raw_os_error(2).with_operation(Operation::Open());
/// let missing = match error.kind() {
///   ErrorKind::NotFound() => { true },
///   _ => { false }
/// };
/// assert(missing, "code 2 means that a file does not exist");
/// let opening = match error.operation() {
///   Operation::Open() => { true },
///   _ => { false }
/// };
/// assert(opening, "the operation is Open");
/// assert(error.raw_os_error().unwrap() == 2, "the error keeps its code");
///
/// let made = Error::from_kind(ErrorKind::InvalidInput());
/// assert(made.raw_os_error().is_none(), "a Vx error has no code");
/// let _text = made.message_c_str();
/// ```
struct Error {
  category : ErrorKind,
  action : Operation,
  native : Option<i32>,
}
impl Copy for Error {}

impl Error {
  /// Make an error of `kind` with no error code. Its operation is `Unspecified`.
  fn from_kind(kind : ErrorKind) -> Error {
    return Error {
      category : kind, action : Operation::Unspecified(), native : Option<i32>::None()
    };
  }

  /// Make an error from the error code of the operating system. The error keeps the exact code,
  /// and gets the kind that the code has on this host. Its operation is `Unspecified`.
  fn from_raw_os_error(code : i32) -> Error {
    let status = unsafe { vx_io_error_kind(code) };
    return io_error_from_bridge(status, Operation::Unspecified(), code, true);
  }

  /// Return the same error with the operation `operation`. The kind and the code do not change.
  fn with_operation(self : Error, operation : Operation) -> Error {
    let mut error = self;
    error.action = operation;
    return error;
  }

  /// The kind of the error.
  fn kind(self : &Error) -> ErrorKind {
    return self.category;
  }

  /// The operation that failed.
  fn operation(self : &Error) -> Operation {
    return self.action;
  }

  /// The error code of the operating system, or `None` when the error has no code.
  fn raw_os_error(self : &Error) -> Option<i32> {
    return self.native;
  }

  /// A short text that names the kind of the error, as a NUL-terminated C string. The text is
  /// the same on each operating system. The program must not free it.
  fn message_c_str(self : &Error) -> *const i8 {
    match self.category {
      ErrorKind::NotFound() => {
        return "not found";
      }
      ErrorKind::PermissionDenied() => {
        return "permission denied";
      }
      ErrorKind::AlreadyExists() => {
        return "already exists";
      }
      ErrorKind::InvalidInput() => {
        return "invalid input";
      }
      ErrorKind::Interrupted() => {
        return "interrupted";
      }
      ErrorKind::WouldBlock() => {
        return "would block";
      }
      ErrorKind::UnexpectedEof() => {
        return "unexpected end of file";
      }
      ErrorKind::WriteZero() => {
        return "write made no progress";
      }
      ErrorKind::OutOfMemory() => {
        return "out of memory";
      }
      ErrorKind::LimitExceeded() => {
        return "limit exceeded";
      }
      ErrorKind::Unsupported() => {
        return "unsupported operation";
      }
      ErrorKind::Other() => {
        return "I/O error";
      }
    }
  }
}

/// Decode the private file bridge status. Unknown statuses violate the bridge contract.
fn io_error_from_bridge(status : i32, operation : Operation, code : i32, has_code : bool) -> Error {
  assert(status >= -1 && status <= 12 && status != 0, "invalid file error status");
  let mut kind = ErrorKind::Other();
  match status {
    -1 => {
      kind = ErrorKind::InvalidInput();
    }
    1 => {
      kind = ErrorKind::NotFound();
    }
    2 => {
      kind = ErrorKind::PermissionDenied();
    }
    3 => {
      kind = ErrorKind::AlreadyExists();
    }
    4 => {
      kind = ErrorKind::InvalidInput();
    }
    5 => {
      kind = ErrorKind::Interrupted();
    }
    6 => {
      kind = ErrorKind::WouldBlock();
    }
    7 => {
      kind = ErrorKind::UnexpectedEof();
    }
    8 => {
      kind = ErrorKind::WriteZero();
    }
    9 => {
      kind = ErrorKind::OutOfMemory();
    }
    10 => {
      kind = ErrorKind::LimitExceeded();
    }
    11 => {
      kind = ErrorKind::Unsupported();
    }
    _ => {}
  }
  if status != -1 && has_code {
    return Error {
      category : kind, action : operation, native : Option<i32>::Some(code)
    };
  }
  return Error::from_kind(kind).with_operation(operation);
}

extern {
  /// The Rust core behind `stdout_write`.
  fn vx_stdout_write(buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `stderr_write`.
  fn vx_stderr_write(buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `stdin_read`.
  fn vx_stdin_read(buffer : *mut u8, len : u64) -> u64;
}

/// Write `len` bytes to standard output and answer how many were taken.
///
/// A short write is possible and is not retried here. Unsafe because `buffer` must have `len`
/// bytes to read.
unsafe fn stdout_write(buffer : *const u8, len : u64)
-> u64 {
  unsafe { vx_stdout_write(buffer, len) }
}

/// Write `len` bytes to standard error, with the same caveats as `stdout_write`.
unsafe fn stderr_write(buffer : *const u8, len : u64)
->u64 {
  unsafe { vx_stderr_write(buffer, len) }
}

/// Read up to `len` bytes from standard input and answer how many arrived.
///
/// Zero means end of input or an error, which are not told apart. Unsafe because `buffer` must
/// have room for `len` bytes.
unsafe fn stdin_read(buffer : *mut u8, len : u64)
->u64 {
  unsafe { vx_stdin_read(buffer, len) }
}
