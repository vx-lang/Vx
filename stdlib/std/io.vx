extern {
  fn vx_stdout_write(buffer : *const u8, len : i64) -> i64;
  fn vx_stderr_write(buffer : *const u8, len : i64) -> i64;
  fn vx_stdin_read(buffer : *mut u8, len : i64) -> i64;
}

unsafe fn stdout_write(buffer : *const u8, len : i64)
-> i64 {
  unsafe { vx_stdout_write(buffer, len) }
}

unsafe fn stderr_write(buffer : *const u8, len : i64)
->i64 {
  unsafe { vx_stderr_write(buffer, len) }
}

unsafe fn stdin_read(buffer : *mut u8, len : i64)
->i64 {
  unsafe { vx_stdin_read(buffer, len) }
}
