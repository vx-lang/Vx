//===----------------------------------------------------------------------===//
// Block an OS thread until an atomic changes. The channel and the `Mutex` wait with these two
// functions. A task runs on an OS thread of its own, so a wait blocks only that task.
//
// The pattern: the waiter reads the atomic, and while it does not hold what the waiter needs,
// calls `wait_while` with the value that it read. The waker changes the atomic first, and then
// calls `wake_all`. So the waiter never sleeps through the change.
//===----------------------------------------------------------------------===//
import core::panic;
import core::ptr;
import core::sync::atomic;
import core::time;
import std::time;

extern {
  /// The Rust core behind `wait_while`.
  fn vx_wait_while(word : *mut i64, value : i64) -> void;
  /// The Rust core behind `wait_while_or_cancel`.
  fn vx_wait_while_or_cancel(word : *mut i64, value : i64) -> void;
  /// The Rust core behind `wake_all`.
  fn vx_wake_all(word : *mut i64) -> void;
  /// The Rust core behind `cancelled`.
  fn vx_cancelled() -> i32;
  /// The Rust core behind `cancelled_at`.
  fn vx_cancelled_at(at_file : *const i8, at_line : i32) -> i32;
  /// The Rust core behind `clock_ns`.
  fn vx_clock_ns() -> i64;
  /// The Rust core behind `wait_while_until`.
  fn vx_wait_while_until(word : *mut i64, value : i64, deadline : i64, or_cancel : i32) -> void;
  /// The Rust core behind the start of `within`.
  fn vx_within_start(limit_ns : i64) -> void;
  /// The Rust core behind the end of `within`.
  fn vx_within_end() -> void;
  /// The Rust core behind `waiting_for`.
  fn vx_waiting_for(what : i32, at_file : *const i8, at_line : i32, made_file : *const i8, made_line : i32) -> void;
  /// The Rust core behind `waiting_for_lock`.
  fn vx_waiting_for_lock(at_file : *const i8, at_line : i32, made_file : *const i8, made_line : i32, holder : *mut i64) -> void;
  /// The Rust core behind `lock_taken`.
  fn vx_lock_taken(holder : *mut i64) -> void;
  /// The Rust core behind `lock_released`.
  fn vx_lock_released(holder : *mut i64) -> void;
}

/// What a wait is for, for `waiting_for`.
const WAIT_IN_SEND : i32 = 1;
const WAIT_IN_RECV : i32 = 2;
const WAIT_IN_SELECT : i32 = 4;

/// Say what the next wait of this task is for, one of the `WAIT_IN_` values. When the program
/// stops on a deadlock, the report says it for each task, with the line `at` of the wait and the
/// line `made` that made the channel or the lock.
fn waiting_for(what : i32, at : Caller, made : Location) -> void {
  let l = at.location;
  unsafe { vx_waiting_for(what, l.file, l.line, made.file, made.line); }
}

/// `waiting_for` a `lock` at the line `at`, on a lock that the line `made` made. `holder` is the
/// word where `lock_taken` keeps who holds the lock, so the report can name it.
fn waiting_for_lock(at : Caller, made : Location, holder : &AtomicI64) -> void {
  let l = at.location;
  unsafe {
    vx_waiting_for_lock(l.file, l.line, made.file, made.line, holder.as_ptr());
  }
}

/// Keep in `holder` who runs here, the code that now holds a lock, for the deadlock report.
fn lock_taken(holder : &AtomicI64) -> void {
  unsafe { vx_lock_taken(holder.as_ptr()); }
}

/// The lock with the word `holder` is free. Only the code that took it calls this.
fn lock_released(holder : &AtomicI64) -> void {
  unsafe { vx_lock_released(holder.as_ptr()); }
}

/// `waiting_for` a `select` at the line `at`. It waits on many channels, so it has no `made`.
fn waiting_in_select(at : Caller) -> void {
  let l = at.location;
  unsafe { vx_waiting_for(WAIT_IN_SELECT, l.file, l.line, null<i8>(), 0); }
}

/// Block the thread while `word` holds `value`. It can also return when `word` did not change.
/// So the caller reads `word` again, in a loop.
fn wait_while(word : &AtomicI64, value : i64) -> void {
  unsafe { vx_wait_while(word.as_ptr(), value); }
}

/// As `wait_while`, and also return when the `tasks` block of this task was cancelled. Use it for a
/// wait that can be cancelled, and check `cancelled` after it.
fn wait_while_or_cancel(word : &AtomicI64, value : i64) -> void {
  unsafe { vx_wait_while_or_cancel(word.as_ptr(), value); }
}

/// Whether the `tasks` block of this task, or a block around it, was cancelled. A loop with no
/// wait can check it.
fn cancelled() -> bool {
  return unsafe { vx_cancelled() } != 0;
}

/// `cancelled` for a wait at the line `at`. A task that sees the cancel many times gets a warning
/// that names the line.
fn cancelled_at(at : Caller) -> bool {
  let l = at.location;
  return unsafe { vx_cancelled_at(l.file, l.line) } != 0;
}

/// Runs `body`, and gives its value. Each wait in `body` that can be cancelled gives up `limit`
/// after the call starts, or at the deadline of a call of `within` or a `drop` around it when that
/// is earlier. The limit also holds in the functions that `body` calls. After the limit, a wait
/// gives up as in a cancelled block, and `cancelled()` is true until `body` returns.
///
/// A `return` in `body` ends `body`, and not the function around the call. To give an error,
/// `body` returns a `Result`.
fn within<T>(limit : Duration, body : || -> T) -> T {
  unsafe { vx_within_start(limit.as_nanos_i64()); }
  let value = body();
  unsafe { vx_within_end(); }
  return value;
}

/// Wake each thread that waits on `word`. Change `word` before the call.
fn wake_all(word : &AtomicI64) -> void {
  unsafe { vx_wake_all(word.as_ptr()); }
}

/// Nanoseconds on a clock that never goes back. Only the difference of two readings means
/// something.
fn clock_ns() -> i64 {
  return unsafe { vx_clock_ns() };
}

/// The deadline `d` from now, for `wait_while_until` and the waits of a channel.
fn deadline_after(d : Duration) -> Instant {
  match Instant::now().checked_add(&d) {
    Option<Instant>::Some(at) => {
      return at;
    }
    Option<Instant>::None => {
      return Instant::never();
    }
  }
}

/// Whether the clock reached `deadline`.
fn past_deadline(deadline : Instant) -> bool {
  return deadline != Instant::never() && Instant::now() >= deadline;
}

/// As `wait_while`, and also return at `deadline`. With `can_cancel`, also return when the
/// `tasks` block of this task was cancelled. The caller checks `past_deadline` after it.
fn wait_while_until(word : &AtomicI64, value : i64, deadline : Instant, can_cancel : bool) -> void {
  if deadline == Instant::never() {
    if can_cancel {
      wait_while_or_cancel(word, value);
    } else {
      wait_while(word, value);
    }
    return;
  }
  let mut flag : i32 = 0;
  if can_cancel {
    flag = 1;
  }
  unsafe {
    vx_wait_while_until(word.as_ptr(), value, deadline.as_nanos_i64(), flag);
  }
}
