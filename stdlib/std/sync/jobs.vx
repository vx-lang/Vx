//===----------------------------------------------------------------------===//
// `run_jobs` and `try_run_jobs` run a function on each job of a list, with at most `n` tasks.
//
// They start `n` worker tasks in a `tasks` block. Each worker takes the next job number from an
// atomic counter, and sends the result with its number on a channel. The code of the block puts
// each result in its place. So the results come in the order of the jobs, and the call returns
// only after each worker ends.
//
// `work` is a type parameter `F : Sync`, so it can be a closure or a `fn`. Each worker loop is
// written inside its `spawn` block: the tasks then call `work` where it is, and do not move it.
//===----------------------------------------------------------------------===//
import core::marker;
import core::option;
import core::panic;
import core::result;
import core::sync::atomic;
import std::sync::channel;
import std::sync::wait;
import std::vec;

/// Why `run_jobs` gave no results.
enum RunJobsError {
  // The `tasks` block around the call was cancelled. The jobs that did not start do not run.
  Cancelled,
}

/// Why `try_run_jobs` gave no results.
enum TryRunJobsError<E> {
  // A job gave this error. The jobs that did not start then do not run.
  Failed(E),
  // The `tasks` block around the call was cancelled. The jobs that did not start do not run.
  Cancelled,
}

/// A result, and the number of its job.
struct JobResult<R> {
  job : i32,
  value : R,
}

/// The number of workers for `jobs` jobs and at most `n` tasks.
fn worker_count(jobs : i32, n : i64) -> i32 {
  assert(n >= 1, "run_jobs: the number of tasks must be at least 1");
  if i64::from(jobs) < n {
    return jobs;
  }
  return n as i32;
}

/// The room of the channel that carries the results. At most `workers` tasks send, so it needs
/// no more room than that, and not the `n` of the call: `n` can be much larger than the jobs.
fn jobs_channel_room(workers : i32) -> i64 {
  if workers < 1 {
    return 1;
  }
  return i64::from(workers);
}

/// The results in the order of the jobs. Each slot holds a result.
fn results_in_order<R>(slots : Vec<Option<R>>) -> Vec<R> {
  let mut out = Vec<R>::with_capacity(slots.len());
  for slot in slots.into_iter() {
    out.push(slot.expect("run_jobs: each job has a result"));
  }
  return out;
}

/// An empty slot for each of `n` jobs.
fn empty_slots<R>(n : i32) -> Vec<Option<R>> {
  let mut slots = Vec<Option<R>>::with_capacity(n);
  for _i in 0..n {
    slots.push(Option<R>::None);
  }
  return slots;
}

/// Run `work(job)` on each job of `jobs`, with at most `n` tasks at the same time, and give the
/// results in the order of the jobs. `n` must be at least 1.
///
/// The call returns after each task ends. The tasks borrow `jobs` and call `work` at the same
/// time, so both must be `Sync`. A closure is `Sync` when each value that it captures is. When the `tasks` block around the call is cancelled, the jobs that did not
/// start do not run, and the call gives `Cancelled`.
///
/// A panic in `work` stops the program, as a panic in any task does. The message names the line
/// of the panic, and the call does not return.
fn run_jobs<J : Sync, R : Send + Owned, F : Sync>(jobs : &Vec<J>, n : i64, work : F) -> Result<Vec<R>, RunJobsError> {
  let workers = worker_count(jobs.len(), n);
  let next = AtomicI64::new(0);
  let (tx, rx) = channel<JobResult<R>>(jobs_channel_room(workers));
  let mut slots = empty_slots<R>(jobs.len());
  let mut arrived : i32 = 0;
  tasks {
    for _w in 0..workers {
      let mine = tx.clone();
      spawn {
        while !cancelled() {
          let i = next.fetch_add(1, AtomicOrdering::Relaxed);
          if i >= i64::from(jobs.len()) {
            return;
          }
          let job = i as i32;
          let value : R = work(jobs.get_ref(job));
          if mine.send(JobResult<R> {
            job : job, value : value
          }).is_err() {
            return;
          }
        }
      };
    }
    drop(tx);
    while arrived < jobs.len() {
      match rx.recv() {
        Result<JobResult<R>, RecvError>::Ok(r) => {
          slots.set(r.job, Option<R>::Some(r.value));
          arrived = arrived + 1;
        }
        Result<JobResult<R>, RecvError>::Err(_e) => {
          // A cancel from outside: the workers stop by themselves.
          break;
        }
      }
    }
  };
  if arrived < jobs.len() {
    return Result<Vec<R>, RunJobsError>::Err(RunJobsError::Cancelled);
  }
  return Result<Vec<R>, RunJobsError>::Ok(results_in_order(slots));
}

/// The `tasks` block of `try_run_jobs`. It puts each result in `slots`, and gives true when each
/// job gave one. It gives false on the first error, which it puts in `failure`, and on a cancel.
/// Its `return` leaves the block, so the block cancels the workers.
fn run_until_a_failure<J : Sync, R : Send + Owned, E : Send + Owned, F : Sync>(jobs : &Vec<J>, n : i64, work : F, slots : &mut Vec<Option<R>>, failure : &mut Option<E>) -> bool {
  let workers = worker_count(jobs.len(), n);
  let next = AtomicI64::new(0);
  let (tx, rx) = channel<JobResult<Result<R, E>>>(jobs_channel_room(workers));
  let mut arrived : i32 = 0;
  tasks {
    for _w in 0..workers {
      let mine = tx.clone();
      spawn {
        while !cancelled() {
          let i = next.fetch_add(1, AtomicOrdering::Relaxed);
          if i >= i64::from(jobs.len()) {
            return;
          }
          let job = i as i32;
          let value : Result<R, E> = work(jobs.get_ref(job));
          if mine.send(JobResult<Result<R, E>> {
            job : job, value : value
          }).is_err() {
            return;
          }
        }
      };
    }
    drop(tx);
    while arrived < jobs.len() {
      match rx.recv() {
        Result<JobResult<Result<R, E>>, RecvError>::Ok(r) => {
          match r.value {
            Result<R, E>::Ok(v) => {
              slots.set(r.job, Option<R>::Some(v));
              arrived = arrived + 1;
            }
            Result<R, E>::Err(e) => {
              *failure = Option<E>::Some(e);
              return false;
            }
          }
        }
        Result<JobResult<Result<R, E>>, RecvError>::Err(_e) => {
          return false;
        }
      }
    }
  };
  return true;
}

/// As `run_jobs`, for a `work` that can fail. The first error that arrives cancels the tasks, so
/// the jobs that did not start do not run, and the call gives `Failed` with that error. The call
/// drops the results that arrived before that error.
///
/// A panic in `work` stops the program, as in `run_jobs`.
fn try_run_jobs<J : Sync, R : Send + Owned, E : Send + Owned, F : Sync>(jobs : &Vec<J>, n : i64, work : F) -> Result<Vec<R>, TryRunJobsError<E>> {
  let mut slots = empty_slots<R>(jobs.len());
  let mut failure = Option<E>::None;
  if run_until_a_failure<J, R, E, F>(jobs, n, work, &mut slots, &mut failure) {
    return Result<Vec<R>, TryRunJobsError<E>>::Ok(results_in_order(slots));
  }
  if failure.is_some() {
    return Result<Vec<R>, TryRunJobsError<E>>::Err(TryRunJobsError<E>::Failed(failure.unwrap()));
  }
  return Result<Vec<R>, TryRunJobsError<E>>::Err(TryRunJobsError<E>::Cancelled);
}
