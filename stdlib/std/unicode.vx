// The code points of UTF-8 text, and three classes of them: letters, numbers and white space.
// A code point is a `u32` until Vx has a `char` type.
import core::result;
import std::string;
import std::vec;

/// A code point, and the number of bytes of UTF-8 that hold it.
struct Decoded {
  code : u32,
  len : i32,
}

/// Byte `k` of `bytes`, or -1 when `bytes` has no byte `k`.
fn byte_or_end(bytes : &Vec<u8>, k : i32) -> i32 {
  if k < 0 || k >= bytes.len() {
    return -1;
  }
  return bytes.get(k) as i32;
}

/// The bits that a byte after the first byte of a code point holds, or -1 when it is not such
/// a byte (`10xxxxxx`).
fn continuation(b : i32) -> i32 {
  if b < 128 || b > 191 {
    return -1;
  }
  return b - 128;
}

/// The code point whose UTF-8 starts at byte `i` of `bytes`. When the bytes there are not UTF-8,
/// or `bytes` ends inside them, it gives a `Utf8Error` whose `valid_up_to` is `i`. As in Rust, an
/// encoding that is longer than it needs to be and a surrogate (U+D800 to U+DFFF) are errors.
pub fn decode_at(bytes : &Vec<u8>, i : i32) -> Result<Decoded, Utf8Error> {
  let bad = Utf8Error {
    valid_up_to : i
  };
  let b0 = byte_or_end(bytes, i);
  if b0 < 0 {
    return Result<Decoded, Utf8Error>::Err(bad);
  }
  if b0 < 128 {
    return Result<Decoded, Utf8Error>::Ok(Decoded {
      code : b0 as u32, len : 1
    });
  }
  // The smallest and largest second byte, and the length, for each first byte.
  let mut low = 128;
  let mut high = 191;
  let mut len = 0;
  if b0 >= 194 && b0 <= 223 {
    len = 2;
  } else if b0 >= 224 && b0 <= 239 {
    len = 3;
    if b0 == 224 {
      low = 160;
    }
    if b0 == 237 {
      high = 159;
    }
  } else if b0 >= 240 && b0 <= 244 {
    len = 4;
    if b0 == 240 {
      low = 144;
    }
    if b0 == 244 {
      high = 143;
    }
  } else {
    return Result<Decoded, Utf8Error>::Err(bad);
  }
  let b1 = byte_or_end(bytes, i + 1);
  if b1 < low || b1 > high {
    return Result<Decoded, Utf8Error>::Err(bad);
  }
  // The bits of the first byte: 5 of a 2-byte code point, 4 of 3 bytes, 3 of 4 bytes.
  let mut code = 0;
  if len == 2 {
    code = b0 - 192;
  } else if len == 3 {
    code = b0 - 224;
  } else {
    code = b0 - 240;
  }
  code = code * 64 + (b1 - 128);
  for k in 2..len {
    let bits = continuation(byte_or_end(bytes, i + k));
    if bits < 0 {
      return Result<Decoded, Utf8Error>::Err(bad);
    }
    code = code * 64 + bits;
  }
  return Result<Decoded, Utf8Error>::Ok(Decoded {
    code : code as u32, len : len
  });
}

/// Whether `c` is a letter: its general category is L (Lu, Ll, Lt, Lm or Lo).
pub fn is_letter(c : u32) -> bool {
  // The runs are in order. Find the last run that starts at or before `c`. A const table can
  // only be read one number at a time, so each class has its own search.
  let mut lo = 0;
  let mut hi = UNICODE_LETTER_RUNS;
  while lo < hi {
    let mid = (lo + hi) / 2;
    if UNICODE_LETTER_FIRST[mid] <= c {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo > 0 && c <= UNICODE_LETTER_LAST[lo - 1];
}

/// Whether `c` is a number: its general category is N (Nd, Nl or No).
pub fn is_number(c : u32) -> bool {
  let mut lo = 0;
  let mut hi = UNICODE_NUMBER_RUNS;
  while lo < hi {
    let mid = (lo + hi) / 2;
    if UNICODE_NUMBER_FIRST[mid] <= c {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo > 0 && c <= UNICODE_NUMBER_LAST[lo - 1];
}

/// Whether `c` has the property White_Space. Unicode fixes these 25 code points.
pub fn is_white_space(c : u32) -> bool {
  // Tab, line feed, vertical tab, form feed and carriage return.
  if c >= 9u32 && c <= 13u32 {
    return true;
  }
  // The spaces of different widths, from U+2000 to U+200A.
  if c >= 8192u32 && c <= 8202u32 {
    return true;
  }
  if c == 32u32 || c == 133u32 || c == 160u32 || c == 5760u32 || c == 8232u32 {
    return true;
  }
  return c == 8233u32 || c == 8239u32 || c == 8287u32 || c == 12288u32;
}

