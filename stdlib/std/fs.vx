import core::ops;
import core::result;
import std::io;

import std::fs::raw;

extern {
  /// The Rust core behind `File::open`. Null when the open fails.
  fn vx_file_open(c_path : *const i8, mode : i32) -> *mut i8;
  /// The Rust core behind `File::read`.
  fn vx_file_read(ptr : *mut i8, buffer : *mut u8, len : u64) -> u64;
  /// The Rust core behind `File::write`.
  fn vx_file_write(ptr : *mut i8, buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `File::seek`.
  fn vx_file_seek(ptr : *mut i8, offset : i64, whence : i32) -> i64;
  /// The Rust core behind dropping a `File`.
  fn vx_file_drop(ptr : *mut i8) -> void;

  // libc bindings for high-level I/O
  /// C's `fopen`, for code that wants a `FILE*` rather than the Rust-backed `File`.
  fn fopen(path: *const i8, mode: *const i8) -> *mut i8;
  /// C's `fread`: the number of whole items read, not the number of bytes.
  fn fread(ptr: *mut u8, size: i64, nmemb: i64, stream: *mut i8) -> i64;
  /// C's `fclose`.
  fn fclose(stream: *mut i8) -> i32;
  /// C's `fileno`: the descriptor behind a `FILE*`, for handing to `mmap`.
  fn fileno(f: *mut i8) -> i32;
  /// C's `fseek`.
  fn fseek(f: *mut i8, offset: i64, whence: i32) -> i32;
  /// C's `ftell`: the current position, which is how the size is found after a seek to the end.
  fn ftell(f: *mut i8) -> i64;
  /// C's `mmap`, declared here so a file can be mapped without importing `std::mmap`.
  fn mmap(addr: *mut i8, len: i64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut i8;
  /// C's `munmap`.
  fn munmap(addr: *mut i8, len: i64) -> i32;
}


/// Existing mode choices. New code can use `OpenOptions` for independent access and creation.
enum OpenMode {
  Read,
  Write,
  ReadWriteCreate,
}

impl Copy for OpenMode {}

/// An open file, held by the Rust core behind an opaque pointer.
///
/// Closed when it is dropped.
struct File {
  ptr : *mut i8,
}

// The handle may move to another task. It is not `Sync`, because each method takes
// a mutable receiver. A shared `&File` cannot perform file operations.
unsafe impl Send for File {}

impl File {
  /// Open an existing file for reading. Unsafe: `path` must name a live NUL-terminated string.
  unsafe fn open_raw(path : *const i8) -> Result<File, Error> {
    let options = OpenOptions::new().read(true);
    return unsafe { options.open_raw(path) };
  }

  /// Create or truncate a file for writing. Unsafe: `path` must name a live NUL-terminated string.
  unsafe fn create_raw(path : *const i8) -> Result<File, Error> {
    let options = OpenOptions::new().write(true).create(true).truncate(true);
    return unsafe { options.open_raw(path) };
  }

  /// Create a new file atomically, failing if it exists. Unsafe: `path` must be NUL-terminated.
  unsafe fn create_new_raw(path : *const i8) -> Result<File, Error> {
    let options = OpenOptions::new().write(true).create_new(true);
    return unsafe { options.open_raw(path) };
  }

  /// Open `path` with a named mode.
  ///
  /// Writing creates the file and truncates it; read-and-write creates it and does not
  /// truncate. Reading does not create it.
  ///
  /// A failed open returns a null handle. Use `open_raw` or `OpenOptions::open_raw` for structured errors.
  ///
  /// Unsafe because nothing checks that `path` points at a NUL-terminated string.
  unsafe fn open(path : *const i8, mode : OpenMode) -> File {
    // Read uses code 0; the other modes replace it below.
    let mut mode_code : i32 = 0;
    match mode {
      OpenMode::Read() => {},
      OpenMode::Write() => {
        mode_code = 1;
      }
      OpenMode::ReadWriteCreate() => {
        mode_code = 2;
      }
    }
    let ptr = unsafe { vx_file_open(path, mode_code) };
    File {
      ptr: ptr
    }
  }

  /// Read at most `len` bytes. A short read succeeds; zero means EOF or an empty request.
  /// Unsafe: `buffer` must hold `len` writable bytes. Null is allowed only for an empty request.
  /// Only the first returned-count bytes contain file data. Remaining bytes may also change.
  unsafe fn read_raw(self : &mut File, buffer : *mut u8, len : usize) -> Result<usize, Error> {
    let mut count : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      vx_file_try_read(self.ptr, buffer, len as u64, &mut count, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<usize, Error>::Err(io_error_from_bridge(status, Operation::Read(), code, has_code));
    }
    return Result<usize, Error>::Ok(count as usize);
  }

  /// Write at most `len` bytes. Short writes succeed without retrying.
  /// Unsafe: `buffer` must hold `len` readable bytes. Null is allowed only for an empty request.
  unsafe fn write_raw(self : &mut File, buffer : *const u8, len : usize) -> Result<usize, Error> {
    let mut count : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      vx_file_try_write(self.ptr, buffer, len as u64, &mut count, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<usize, Error>::Err(io_error_from_bridge(status, Operation::Write(), code, has_code));
    }
    return Result<usize, Error>::Ok(count as usize);
  }

  /// Read up to `len` bytes into `buffer` and answer how many arrived.
  ///
  /// Zero means end of file, a null file or buffer, or a read error -- the four are not told
  /// apart. A short read is normal and is not an error.
  ///
  /// Unsafe because `buffer` must have room for `len` bytes; nothing here checks.
  /// Prefer `read_raw` in new code to distinguish errors from EOF.
  unsafe fn read(self : *mut File, buffer : *mut u8, len : u64) -> u64 {
    unsafe { vx_file_read(self.ptr, buffer, len) }
  }

  /// Write up to `len` bytes from `buffer` and answer how many were taken.
  ///
  /// Zero means a null file or buffer, or a write error, with the same lack of distinction
  /// `read` has. A short write is not an error and the remainder is not retried here.
  /// Prefer `write_raw` in new code to inspect write errors.
  unsafe fn write(self : *mut File, buffer : *const u8, len : u64) -> u64 {
    unsafe { vx_file_write(self.ptr, buffer, len) }
  }

  /// Move the read and write position, answering where it ended up.
  ///
  /// `whence` is 0 from the start, 1 from the current position, 2 from the end, as libc's
  /// `SEEK_SET`, `SEEK_CUR` and `SEEK_END`. Answers -1 for a null file, an unknown `whence`,
  /// or a seek the operating system refuses.
  /// Prefer `seek_to` in new code to inspect seek errors.
  fn seek(self : *mut File, offset : i64, whence : i32) -> i64 {
    unsafe { vx_file_seek(self.ptr, offset, whence) }
  }
}

impl Drop for File {
  /// Close the file and release it.
  fn drop(self : &mut File) -> void {
    unsafe { vx_file_drop(self.ptr) };
  }
}

impl Seek for File {
  /// Change the file position or return an I/O error. Relative offsets may be negative.
  fn seek_to(self : &mut File, from : SeekFrom) -> Result<u64, Error> {
    let mut offset : i64 = 0;
    let mut whence : i32 = 0;
    match from {
      SeekFrom::Start(position) => {
        offset = position as i64;
      }
      SeekFrom::Current(delta) => {
        offset = delta; whence = 1;
      }
      SeekFrom::End(delta) => {
        offset = delta; whence = 2;
      }
    }
    let mut position : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      vx_file_try_seek(self.ptr, offset, whence, &mut position, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<u64, Error>::Err(io_error_from_bridge(status, Operation::Seek(), code, has_code));
    }
    return Result<u64, Error>::Ok(position);
  }
}

/// Independent access and creation choices. An empty configuration cannot open a file.
struct OpenOptions {
  flags : i32,
}
impl Copy for OpenOptions {}

impl OpenOptions {
  /// No access or creation options enabled.
  fn new() -> OpenOptions {
    return OpenOptions {
      flags : 0
    };
  }
  /// Enable or disable reading.
  fn read(self : OpenOptions, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | 1;
    } else {
      options.flags = options.flags & !1;
    }
    return options;
  }
  /// Enable or disable writing. This does not create or truncate a file.
  fn write(self : OpenOptions, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | 2;
    } else {
      options.flags = options.flags & !2;
    }
    return options;
  }
  /// Append each write at the end of the file. This also enables writing.
  fn append(self : OpenOptions, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | 4;
    } else {
      options.flags = options.flags & !4;
    }
    return options;
  }
  /// Create the file if absent. Writing or appending must also be enabled.
  fn create(self : OpenOptions, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | 8;
    } else {
      options.flags = options.flags & !8;
    }
    return options;
  }
  /// Truncate an existing file. Writing must also be enabled.
  fn truncate(self : OpenOptions, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | 16;
    } else {
      options.flags = options.flags & !16;
    }
    return options;
  }
  /// Create atomically, failing if the file exists. This overrides `create` and `truncate`.
  fn create_new(self : OpenOptions, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | 32;
    } else {
      options.flags = options.flags & !32;
    }
    return options;
  }
  /// Open with these choices. Invalid combinations return InvalidInput.
  /// Unsafe: `path` must point to a live NUL-terminated string. Unix preserves its raw bytes.
  unsafe fn open_raw(self : &OpenOptions, path : *const i8) -> Result<File, Error> {
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      vx_file_open_options(path, self.flags, &mut ptr, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<File, Error>::Err(io_error_from_bridge(status, Operation::Open(), code, has_code));
    }
    return Result<File, Error>::Ok(File {
      ptr : ptr
    });
  }
}
