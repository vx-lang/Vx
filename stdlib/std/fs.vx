//===----------------------------------------------------------------------===//
// Files and the right to open them. A program gets the right, a `Files`, in its `Root`
// (`std::root`), and passes `&root.files` to `File::open`, or to a function that calls it.
//
// Layer: the OS layer. Runs on: the host only. `File` is `HostOnly`.
//
// Stage: `OpenOptions`, `File::open_raw`, `create_raw`, `create_new_raw`, `try_read_raw`,
// `try_write_raw` and `Seek for File` are incubating, with the feature name `file_io_errors`.
// They give an `IoError` from `std::io`. They take raw pointers and need no `&Files`, so each
// one is `unsafe`.
//===----------------------------------------------------------------------===//
import core::marker;
import core::ops;
import core::ptr;
import core::result;
import std::io;
import std::string;
import std::vec;

import std::fs::raw;
extern {
  /// The Rust core behind `File::open_c_str`. Null when the open fails.
  fn vx_file_open(c_path : *const i8, mode : i32) -> *mut i8;
  /// The Rust core behind `File::open`: 0 and the file in `*file`, or the category of the error
  /// and the error number of the system.
  fn vx_file_try_open(c_path : *const i8, mode : i32, file : *mut *mut i8,
  native_code : *mut i32) -> i32;
  /// The Rust core behind `File::read_raw`.
  fn vx_file_read(ptr : *mut i8, buffer : *mut u8, len : u64) -> u64;
  /// The Rust core behind `File::write_raw`.
  fn vx_file_write(ptr : *mut i8, buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `Folder::open`, with the outputs of `vx_file_try_open`.
  fn vx_folder_open(c_path : *const i8, folder : *mut *mut i8, native_code : *mut i32) -> i32;
  /// The Rust core behind `Folder::open_file` and `Folder::open_folder`. 13 means that the name
  /// does not name a file inside the folder.
  fn vx_folder_open_file(folder : *mut i8, c_name : *const i8, want_folder : i32,
  out : *mut *mut i8, native_code : *mut i32) -> i32;
  /// The Rust core behind `File::seek`.
  fn vx_file_seek(ptr : *mut i8, offset : i64, whence : i32) -> i64;
  /// The Rust core behind dropping a `File`.
  fn vx_file_drop(ptr : *mut i8) -> void;

  // libc bindings for high-level I/O
  /// C's `fopen`, for code that wants a `FILE*` rather than the Rust-backed `File`.
  fn fopen(path: *const i8, mode: *const i8) -> *mut i8;
  /// C's `fread`: the number of whole items read, not the number of bytes.
  fn fread(ptr: *mut u8, size: i64, nmemb: i64, stream: *mut i8) -> i64;
  /// C's `fclose`.
  fn fclose(stream: *mut i8) -> i32;
  /// C's `fileno`: the descriptor behind a `FILE*`, for handing to `mmap`.
  fn fileno(f: *mut i8) -> i32;
  /// C's `fseek`.
  fn fseek(f: *mut i8, offset: i64, whence: i32) -> i32;
  /// C's `ftell`: the current position, which is how the size is found after a seek to the end.
  fn ftell(f: *mut i8) -> i64;
  /// C's `mmap`, declared here so a file can be mapped without importing `std::mmap`.
  fn mmap(addr: *mut i8, len: i64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut i8;
  /// C's `munmap`.
  fn munmap(addr: *mut i8, len: i64) -> i32;
}

// The bits of `OpenOptions`. The Rust bridge reads the same bits in `_vx_file_open_options`.
const _OPEN_READ : i32 = 1;
const _OPEN_WRITE : i32 = 2;
const _OPEN_APPEND : i32 = 4;
const _OPEN_CREATE : i32 = 8;
const _OPEN_TRUNCATE : i32 = 16;
const _OPEN_CREATE_NEW : i32 = 32;

/// The right to open files. Only this file can make a `Files`, and a program gets one in its
/// `Root` (`std::root`). A function that gets a `&Files` uses it during the call and cannot keep
/// it.
struct Files {
  invariant true,
}

/// The file right of the program, for `std::root`. Unsafe because a second `Files` gives the
/// right to code that did not get it.
unsafe fn files_of_the_program() -> Files {
  return Files {};
}

/// Why a file call did not work.
enum FileError {
  // The path holds a NUL byte, so the system cannot read it.
  BadPath,
  // No file has the path, or a folder of the path is missing.
  NotFound,
  // The system does not let the program open the file in the mode, or change it.
  PermissionDenied,
  // The name does not name a file inside the folder: it is empty or absolute, it has a `..`
  // part, or a part of it is a symbolic link.
  NotInFolder,
  // Another failure, with the error number of the system, or 0 when it gave none.
  Os(i32),
}

impl Copy for FileError {}

/// The `FileError` of a status that is not 0. The status is a category of the Rust core.
fn file_error(status : i32, native_code : i32) -> FileError {
  if status == 1 {
    return FileError::NotFound;
  }
  if status == 2 {
    return FileError::PermissionDenied;
  }
  if status == 13 {
    return FileError::NotInFolder;
  }
  return FileError::Os(native_code);
}

/// A NUL-terminated copy of a path, for the Rust core. A drop releases it. The invariant lets
/// only this file make a `CPath` or change its pointer.
struct CPath {
  ptr : *const i8,

  invariant true,
}

impl CPath {
  /// A copy of `path`, or `BadPath` when `path` holds a NUL byte, because a C string ends at its
  /// first NUL.
  fn of(path : &String) -> Result<CPath, FileError> {
    let ptr = unsafe { vx_string_try_as_c_str(path.ptr) };
    if is_null(ptr) {
      return Result<CPath, FileError>::Err(FileError::BadPath);
    }
    return Result<CPath, FileError>::Ok(CPath {
      ptr : ptr
    });
  }
}

impl Drop for CPath {
  /// Release the copy.
  fn drop(self : &mut CPath) -> void {
    let _freed = unsafe { vx_string_free_c_str(self.ptr) };
  }
}

/// The three file-opening behaviors supported by the current host bridge.
enum OpenMode {
  Read,
  Write,
  ReadWriteCreate,
}

impl Copy for OpenMode {}

/// An open file, held by the Rust core behind an opaque pointer.
///
/// Closed when it is dropped.
struct File {
  ptr : *mut i8,

  invariant true,
}


// The handle may move to another task. It is not `Sync`, because each method takes
// `*mut File`, so a shared `&File` has no use yet.
unsafe impl Send for File {}
impl HostOnly for File {}

/// The code of a mode for the Rust core.
fn open_mode_code(mode : OpenMode) -> i32 {
  // Read uses code 0; the other modes replace it below.
  let mut mode_code : i32 = 0;
  match mode {
    OpenMode::Read() => {},
    OpenMode::Write() => {
      mode_code = 1;
    }
    OpenMode::ReadWriteCreate() => {
      mode_code = 2;
    }
  }
  return mode_code;
}

impl File {
  /// Open `path` with a named mode. The caller needs the file right, a `&Files`.
  ///
  /// Writing creates the file and truncates it; read-and-write creates it and does not
  /// truncate. Reading does not create it.
  fn open(_files : &Files, path : &String, mode : OpenMode) -> Result<File, FileError> {
    let c_path = CPath::of(path)?;
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_file_try_open(c_path.ptr, open_mode_code(mode), (&mut ptr) as *mut *mut i8,
      (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<File, FileError>::Err(file_error(status, native_code));
    }
    return Result<File, FileError>::Ok(File {
      ptr : ptr
    });
  }

  /// Read up to `buffer.len()` bytes into `buffer` and give how many arrived. 0 means the end of
  /// the file. A short read is normal and is not an error.
  fn read(self : &mut File, buffer : &mut Vec<u8>) -> Result<u64, FileError> {
    let len = buffer.len() as u64;
    let mut count : u64 = 0;
    let mut native_code : i32 = 0;
    let mut has_native_code = false;
    let status = unsafe {
      _vx_file_try_read(self.ptr, buffer.as_mut_ptr(), len, (&mut count) as *mut u64,
      (&mut native_code) as *mut i32, (&mut has_native_code) as *mut bool)
    };
    if status != 0 {
      return Result<u64, FileError>::Err(file_error(status, native_code));
    }
    return Result<u64, FileError>::Ok(count);
  }

  /// Write up to `buffer.len()` bytes and give how many were taken. A short write is not an
  /// error, and the rest is not tried again here.
  fn write(self : &mut File, buffer : &Vec<u8>) -> Result<u64, FileError> {
    let len = buffer.len() as u64;
    let mut count : u64 = 0;
    let mut native_code : i32 = 0;
    let mut has_native_code = false;
    let status = unsafe {
      _vx_file_try_write(self.ptr, buffer.as_mut_ptr() as *const u8, len,
      (&mut count) as *mut u64, (&mut native_code) as *mut i32,
      (&mut has_native_code) as *mut bool)
    };
    if status != 0 {
      return Result<u64, FileError>::Err(file_error(status, native_code));
    }
    return Result<u64, FileError>::Ok(count);
  }

  /// Open `path` with a named mode, with no file right. Trusted code uses it, for example code
  /// that gets its path from C.
  ///
  /// **A failed open cannot be detected.** The returned `File` holds a null pointer, and Vx
  /// cannot compare a raw pointer against null or cast one to an integer (Vx#714) -- so a
  /// missing file is indistinguishable from an empty one until that closes. Every later call
  /// on it answers 0 or -1 rather than doing anything.
  ///
  /// Unsafe because nothing checks that `path` points at a NUL-terminated string.
  unsafe fn open_c_str(path : *const i8, mode : OpenMode) -> File {
    let ptr = unsafe { vx_file_open(path, open_mode_code(mode)) };
    File {
      ptr: ptr
    }
  }

  /// Read up to `len` bytes into `buffer` and answer how many arrived.
  ///
  /// Zero means end of file, a null file or buffer, or a read error -- the four are not told
  /// apart. A short read is normal and is not an error.
  ///
  /// Unsafe because `buffer` must have room for `len` bytes; nothing here checks.
  unsafe fn read_raw(self : *mut File, buffer : *mut u8, len : u64) -> u64 {
    unsafe { vx_file_read(self.ptr, buffer, len) }
  }

  /// Write up to `len` bytes from `buffer` and answer how many were taken.
  ///
  /// Zero means a null file or buffer, or a write error, with the same lack of distinction
  /// `read_raw` has. A short write is not an error and the remainder is not retried here.
  unsafe fn write_raw(self : *mut File, buffer : *const u8, len : u64) -> u64 {
    unsafe { vx_file_write(self.ptr, buffer, len) }
  }

  /// Move the read and write position, answering where it ended up.
  ///
  /// `whence` is 0 from the start, 1 from the current position, 2 from the end, as libc's
  /// `SEEK_SET`, `SEEK_CUR` and `SEEK_END`. Answers -1 for a null file, an unknown `whence`,
  /// or a seek the operating system refuses.
  fn seek(self : *mut File, offset : i64, whence : i32) -> i64 {
    unsafe { vx_file_seek(self.ptr, offset, whence) }
  }

  /// Open the file at `path` for reading. The file must exist.
  ///
  /// # Errors
  ///
  /// The error that the operating system reports, with the operation `Open`. A missing file
  /// gives `NotFound`, and a file that the program cannot read gives `PermissionDenied`.
  ///
  /// # Safety
  ///
  /// `path` must point to a NUL-terminated string that stays valid during the call.
  ///
  /// # Allocates
  ///
  /// The runtime allocates one small block on the heap for the open file. Dropping the `File`
  /// frees it. A failed open keeps no memory.
  ///
  /// # Stage
  ///
  /// Incubating, with the feature name `file_io_errors`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let error = (unsafe { File::open_raw("/tmp/vx_example_missing_file") }).unwrap_err();
  /// let missing = match error.kind() {
  ///   ErrorKind::NotFound() => { true },
  ///   _ => { false }
  /// };
  /// assert(missing, "a missing file gives NotFound");
  /// ```
  unsafe fn open_raw(path : *const i8) -> Result<File, IoError>
  requires valid(path, 1)
  requires initialized(path, 1)
  {
    let options = OpenOptions::new().read(true);
    return unsafe { options.open_raw(path) };
  }

  /// Open the file at `path` for writing. Make the file if it does not exist, and make it empty
  /// if it does.
  ///
  /// # Errors
  ///
  /// The error that the operating system reports, with the operation `Open`. For example, a
  /// folder in `path` that does not exist gives `NotFound`.
  ///
  /// # Safety
  ///
  /// `path` must point to a NUL-terminated string that stays valid during the call.
  ///
  /// # Allocates
  ///
  /// The runtime allocates one small block on the heap for the open file. Dropping the `File`
  /// frees it. A failed open keeps no memory.
  ///
  /// # Stage
  ///
  /// Incubating, with the feature name `file_io_errors`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let mut file = (unsafe { File::create_raw("/tmp/vx_example_create.txt") }).unwrap();
  /// assert(file.seek_to(SeekFrom::End(0)).unwrap() == 0, "the new file is empty");
  /// ```
  unsafe fn create_raw(path : *const i8) -> Result<File, IoError>
  requires valid(path, 1)
  requires initialized(path, 1)
  {
    let options = OpenOptions::new().write(true).create(true).truncate(true);
    return unsafe { options.open_raw(path) };
  }

  /// Make a new file at `path`, and open it for reading and writing. Fail if the file exists.
  ///
  /// The check and the creation are one step, so another program cannot make the file between
  /// them.
  ///
  /// # Errors
  ///
  /// `AlreadyExists` when the file exists. Otherwise, the error that the operating system
  /// reports. Each error has the operation `Open`.
  ///
  /// # Safety
  ///
  /// `path` must point to a NUL-terminated string that stays valid during the call.
  ///
  /// # Allocates
  ///
  /// The runtime allocates one small block on the heap for the open file. Dropping the `File`
  /// frees it. A failed open keeps no memory.
  ///
  /// # Stage
  ///
  /// Incubating, with the feature name `file_io_errors`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let path = "/tmp/vx_example_create_new.txt";
  /// let _old = unsafe { File::create_raw(path) };
  /// let error = (unsafe { File::create_new_raw(path) }).unwrap_err();
  /// let exists = match error.kind() {
  ///   ErrorKind::AlreadyExists() => { true },
  ///   _ => { false }
  /// };
  /// assert(exists, "the file exists already");
  /// ```
  unsafe fn create_new_raw(path : *const i8) -> Result<File, IoError>
  requires valid(path, 1)
  requires initialized(path, 1)
  {
    let options = OpenOptions::new().read(true).write(true).create_new(true);
    return unsafe { options.open_raw(path) };
  }

  /// Read at most `len` bytes into `buffer`, and return the number of bytes that the read got.
  ///
  /// A read can get fewer bytes than `len`. That is not an error. A count of 0 means the end of
  /// the file, or a `len` of 0. Only the first bytes, up to the count, hold data from the file.
  /// The read can also change the other bytes of `buffer`.
  ///
  /// # Errors
  ///
  /// The error that the operating system reports, with the operation `Read`. For example, a
  /// read from a file that is open only for writing gives an error.
  ///
  /// `Interrupted` when a signal stopped the read before it got a byte. The method does not try
  /// again, so the program can call it again.
  ///
  /// # Safety
  ///
  /// `buffer` must point to `len` bytes that the program can write. The bytes need not hold
  /// values. `buffer` must not be null, also when `len` is 0.
  ///
  /// # Contract
  ///
  /// `buffer` is valid for `len` bytes.
  ///
  /// # Stage
  ///
  /// Incubating, with the feature name `file_io_errors`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let path = "/tmp/vx_example_read.txt";
  /// let mut out = (unsafe { File::create_raw(path) }).unwrap();
  /// let letter : u8 = 65;
  /// (unsafe { out.try_write_raw((&letter) as *const u8, 1) }).unwrap();
  /// drop(out);
  ///
  /// let mut file = (unsafe { File::open_raw(path) }).unwrap();
  /// let mut byte : u8 = 0;
  /// let count = (unsafe { file.try_read_raw((&mut byte) as *mut u8, 1) }).unwrap();
  /// assert(count == 1 && byte == 65, "the read got the letter A");
  /// let end = (unsafe { file.try_read_raw((&mut byte) as *mut u8, 1) }).unwrap();
  /// assert(end == 0, "a count of 0 is the end of the file");
  /// ```
  unsafe fn try_read_raw(self : &mut File, buffer : *mut u8, len : usize) -> Result<usize, IoError>
  requires valid(buffer, len)
  {
    let mut count : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      _vx_file_try_read(self.ptr, buffer, len as u64, &mut count, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<usize, IoError>::Err(_io_error_from_bridge(status, Operation::Read(), code, has_code));
    }
    return Result<usize, IoError>::Ok(count as usize);
  }

  /// Write at most `len` bytes from `buffer`, and return the number of bytes that the write
  /// took.
  ///
  /// A write can take fewer bytes than `len`. That is not an error, and this method does not try
  /// again. A `len` of 0 writes nothing and returns 0.
  ///
  /// # Errors
  ///
  /// The error that the operating system reports, with the operation `Write`. For example, a
  /// write to a file that is open only for reading gives an error.
  ///
  /// `Interrupted` when a signal stopped the write before it took a byte. The method does not try
  /// again, so the program can call it again.
  ///
  /// # Safety
  ///
  /// `buffer` must point to `len` bytes that hold values. `buffer` must not be null, also when
  /// `len` is 0.
  ///
  /// # Contract
  ///
  /// `buffer` is valid for `len` bytes, and each of these bytes holds a value.
  ///
  /// # Stage
  ///
  /// Incubating, with the feature name `file_io_errors`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let mut file = (unsafe { File::create_raw("/tmp/vx_example_write.txt") }).unwrap();
  /// let mut letters = Vec<u8>::new();
  /// letters.push(72u8);
  /// letters.push(105u8);
  /// let count = (unsafe { file.try_write_raw(letters.as_mut_ptr() as *const u8, 2) }).unwrap();
  /// assert(count == 2, "the write took both bytes");
  /// ```
  unsafe fn try_write_raw(self : &mut File, buffer : *const u8, len : usize) -> Result<usize, IoError>
  requires valid(buffer, len)
  requires initialized(buffer, len)
  {
    let mut count : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      _vx_file_try_write(self.ptr, buffer, len as u64, &mut count, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<usize, IoError>::Err(_io_error_from_bridge(status, Operation::Write(), code, has_code));
    }
    return Result<usize, IoError>::Ok(count as usize);
  }
}

impl Drop for File {
  /// Close the file and release it.
  fn drop(self : &mut File) -> void {
    unsafe { vx_file_drop(self.ptr) };
  }
}

impl Seek for File {
  /// Move the position of the next read or write, and return the new position from the start of
  /// the file.
  ///
  /// # Errors
  ///
  /// The error that the operating system reports, with the operation `Seek`. A position before
  /// the start of the file gives `InvalidInput`.
  ///
  /// # Stage
  ///
  /// Incubating, with the feature name `file_io_errors`.
  ///
  /// # Example
  ///
  /// ```vx
  /// let mut file = (unsafe { File::create_raw("/tmp/vx_example_seek.txt") }).unwrap();
  /// let mut letters = Vec<u8>::new();
  /// letters.push(97u8);
  /// letters.push(98u8);
  /// letters.push(99u8);
  /// (unsafe { file.try_write_raw(letters.as_mut_ptr() as *const u8, 3) }).unwrap();
  /// assert(file.seek_to(SeekFrom::Start(1)).unwrap() == 1, "from the start");
  /// assert(file.seek_to(SeekFrom::Current(1)).unwrap() == 2, "from the current position");
  /// assert(file.seek_to(SeekFrom::End(-3)).unwrap() == 0, "from the end");
  /// assert(file.seek_to(SeekFrom::Current(-1)).is_err(), "before the start");
  /// ```
  fn seek_to(self : &mut File, from : SeekFrom) -> Result<u64, IoError> {
    let mut offset : i64 = 0;
    let mut whence : i32 = 0;
    match from {
      SeekFrom::Start(position) => {
        offset = position as i64;
      }
      SeekFrom::Current(delta) => {
        offset = delta; whence = 1;
      }
      SeekFrom::End(delta) => {
        offset = delta; whence = 2;
      }
    }
    let mut position : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      _vx_file_try_seek(self.ptr, offset, whence, &mut position, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<u64, IoError>::Err(_io_error_from_bridge(status, Operation::Seek(), code, has_code));
    }
    return Result<u64, IoError>::Ok(position);
  }
}

/// The choices for opening a file: read, write, append, create, truncate and create new. Each
/// choice is on or off on its own.
///
/// `OpenOptions::new()` turns every choice off. Each setter returns new options, so that a
/// program can chain the calls. Options with no choice turned on cannot open a file.
///
/// # Stage
///
/// Incubating, with the feature name `file_io_errors`.
///
/// # Example
///
/// One example covers `new`, the six setters and `open_raw`.
///
/// ```vx
/// let path = "/tmp/vx_example_options.txt";
/// let create = OpenOptions::new().write(true).create(true).truncate(true);
/// let mut file = (unsafe { create.open_raw(path) }).unwrap();
/// let letter : u8 = 65;
/// (unsafe { file.try_write_raw((&letter) as *const u8, 1) }).unwrap();
/// drop(file);
///
/// let append = OpenOptions::new().append(true);
/// let mut log = (unsafe { append.open_raw(path) }).unwrap();
/// (unsafe { log.try_write_raw((&letter) as *const u8, 1) }).unwrap();
/// assert(log.stream_position().unwrap() == 2, "append writes at the end");
/// drop(log);
///
/// let exclusive = OpenOptions::new().write(true).create_new(true);
/// assert((unsafe { exclusive.open_raw(path) }).is_err(), "the file exists");
/// let nothing = OpenOptions::new().read(true).read(false);
/// assert((unsafe { nothing.open_raw(path) }).is_err(), "no choice is on");
/// ```
struct OpenOptions {
  flags : i32,
}
impl Copy for OpenOptions {}

impl OpenOptions {
  /// Options with every choice turned off.
  fn new() -> OpenOptions {
    return OpenOptions {
      flags : 0
    };
  }

  // Turn the choice `bit` on or off.
  fn _with_flag(self : OpenOptions, bit : i32, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | bit;
    } else {
      options.flags = options.flags & !bit;
    }
    return options;
  }

  /// Turn reading on or off.
  fn read(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_READ, enabled);
  }

  /// Turn writing on or off. Writing alone does not make the file and does not make it empty.
  fn write(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_WRITE, enabled);
  }

  /// Turn appending on or off. Each write then goes to the end of the file. Appending also turns
  /// writing on.
  fn append(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_APPEND, enabled);
  }

  /// Make the file if it does not exist. Writing or appending must also be on.
  fn create(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_CREATE, enabled);
  }

  /// Make an existing file empty. Writing must also be on, and appending must be off.
  fn truncate(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_TRUNCATE, enabled);
  }

  /// Make a new file, and fail if the file exists. The check and the creation are one step.
  /// This choice ignores `create` and `truncate`. Writing or appending must also be on.
  fn create_new(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_CREATE_NEW, enabled);
  }

  /// Open the file at `path` with these options.
  ///
  /// On Unix, the path can hold bytes that are not UTF-8. The method gives them to the operating
  /// system as they are.
  ///
  /// # Errors
  ///
  /// `InvalidInput` when no choice is on, or when the choices do not go together. For example,
  /// `create` without `write` or `append`, or `truncate` with `append`. Otherwise, the error that
  /// the operating system reports. Each error has the operation `Open`.
  ///
  /// # Safety
  ///
  /// `path` must point to a NUL-terminated string that stays valid during the call.
  ///
  /// # Allocates
  ///
  /// The runtime allocates one small block on the heap for the open file. Dropping the `File`
  /// frees it. A failed open keeps no memory.
  unsafe fn open_raw(self : &OpenOptions, path : *const i8) -> Result<File, IoError>
  requires valid(path, 1)
  requires initialized(path, 1)
  {
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      _vx_file_open_options(path, self.flags, &mut ptr, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<File, IoError>::Err(_io_error_from_bridge(status, Operation::Open(), code, has_code));
    }
    return Result<File, IoError>::Ok(File {
      ptr : ptr
    });
  }
}

/// The right to read the files of one folder, and of the folders inside it. A function that
/// gets a `&Folder` can read those files and no others, because a name that leads out of the
/// folder gives `NotInFolder`. A program narrows its `Files` to a `Folder` with `Folder::open`.
///
/// The Rust core holds the open folder, so a rename of the folder does not change which files
/// the `Folder` reads. The invariant lets only this file make a `Folder` or change its field.
struct Folder {
  dir : *mut i8,

  invariant true,
}

// A `Folder` may move to another task, and tasks may share it: an open in a folder does not
// change the folder.
unsafe impl Send for Folder {}
unsafe impl Sync for Folder {}

impl Folder {
  /// Open the folder at `path`. The caller needs the file right, a `&Files`.
  fn open(_files : &Files, path : &String) -> Result<Folder, FileError> {
    let c_path = CPath::of(path)?;
    let mut dir : *mut i8 = unsafe { 0 as *mut i8 };
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_folder_open(c_path.ptr, (&mut dir) as *mut *mut i8, (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<Folder, FileError>::Err(file_error(status, native_code));
    }
    return Result<Folder, FileError>::Ok(Folder {
      dir : dir
    });
  }

  /// Open the file `name` of this folder for reading. `name` is a path inside the folder, such
  /// as `"weights.bin"` or `"adapters/a.bin"`.
  fn open_file(self : &Folder, name : &String) -> Result<File, FileError> {
    let ptr = self.open_below(name, 0)?;
    return Result<File, FileError>::Ok(File {
      ptr : ptr
    });
  }

  /// Open the folder `name` inside this folder: a narrower right.
  fn open_folder(self : &Folder, name : &String) -> Result<Folder, FileError> {
    let dir = self.open_below(name, 1)?;
    return Result<Folder, FileError>::Ok(Folder {
      dir : dir
    });
  }

  /// The handle of the Rust core for `name`, a file or, with `want_folder` 1, a folder.
  fn open_below(self : &Folder, name : &String, want_folder : i32) -> Result<*mut i8, FileError> {
    let c_name = CPath::of(name)?;
    let mut out : *mut i8 = unsafe { 0 as *mut i8 };
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_folder_open_file(self.dir, c_name.ptr, want_folder, (&mut out) as *mut *mut i8,
      (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<*mut i8, FileError>::Err(file_error(status, native_code));
    }
    return Result<*mut i8, FileError>::Ok(out);
  }
}

impl Drop for Folder {
  /// Close the folder. The Rust core holds an open folder as a file.
  fn drop(self : &mut Folder) -> void {
    unsafe { vx_file_drop(self.dir) };
  }
}
