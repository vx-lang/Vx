//===----------------------------------------------------------------------===//
// Files and the right to open them. A program gets the right, a `Files`, in its `Root`
// (`std::root`), and passes `&root.files` to `File::open`, or to a function that calls it.
//
// Layer: the OS layer. Runs on: the host only. `File` is `HostOnly`, so device code cannot use
// it.
//===----------------------------------------------------------------------===//
import core::marker;
import core::ops;
import core::ptr;
import core::result;
import std::string;
import std::vec;

import std::fs::raw;

extern {
  /// The Rust core behind `File::open_c_str`. Null when the open fails.
  pub fn vx_file_open(c_path : *const i8, mode : i32) -> *mut i8;
  /// The Rust core behind `File::open`: 0 and the file in `*file`, or the category of the error
  /// and the error number of the system.
  pub fn vx_file_try_open(c_path : *const i8, mode : i32, file : *mut *mut i8,
  native_code : *mut i32) -> i32;
  /// The Rust core behind `File::read_raw`.
  pub fn vx_file_read(ptr : *mut i8, buffer : *mut u8, len : u64) -> u64;
  /// The Rust core behind `File::write_raw`.
  pub fn vx_file_write(ptr : *mut i8, buffer : *const u8, len : u64) -> u64;
  /// The Rust core behind `Folder::open`, with the outputs of `vx_file_try_open`.
  pub fn vx_folder_open(c_path : *const i8, folder : *mut *mut i8, native_code : *mut i32) -> i32;
  /// The Rust core behind `Folder::open_file` and `Folder::open_folder`. 13 means that the name
  /// does not name a file inside the folder.
  pub fn vx_folder_open_file(folder : *mut i8, c_name : *const i8, want_folder : i32,
  out : *mut *mut i8, native_code : *mut i32) -> i32;
  /// The Rust core behind `File::seek`.
  pub fn vx_file_seek(ptr : *mut i8, offset : i64, whence : i32) -> i64;
  /// The Rust core behind dropping a `File`.
  pub fn vx_file_drop(ptr : *mut i8) -> void;
  /// The Rust core behind `File::map`: 0 with the address in `*base` and the size in `*len`, or
  /// the category of the error and the error number of the system.
  fn vx_file_try_map(ptr : *mut i8, base : *mut *mut u8, len : *mut i64,
  native_code : *mut i32) -> i32;
  /// The Rust core behind dropping a `Mapping`.
  fn vx_file_unmap(base : *mut u8, len : i64) -> void;

  // libc bindings for high-level I/O
  /// C's `fopen`, for code that wants a `FILE*` rather than the Rust-backed `File`.
  pub fn fopen(path: *const i8, mode: *const i8) -> *mut i8;
  /// C's `fread`: the number of whole items read, not the number of bytes.
  pub fn fread(ptr: *mut u8, size: i64, nmemb: i64, stream: *mut i8) -> i64;
  /// C's `fclose`.
  pub fn fclose(stream: *mut i8) -> i32;
  /// C's `fileno`: the descriptor behind a `FILE*`, for handing to `mmap`.
  pub fn fileno(f: *mut i8) -> i32;
  /// C's `fseek`.
  pub fn fseek(f: *mut i8, offset: i64, whence: i32) -> i32;
  /// C's `ftell`: the current position, which is how the size is found after a seek to the end.
  pub fn ftell(f: *mut i8) -> i64;
  /// C's `mmap`, declared here so a file can be mapped without importing `std::mmap`.
  pub fn mmap(addr: *mut i8, len: i64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut i8;
  /// C's `munmap`.
  pub fn munmap(addr: *mut i8, len: i64) -> i32;
}

// The bits of `OpenOptions`. The Rust bridge reads the same bits in `_vx_file_open_options`.
const _OPEN_READ : i32 = 1;
const _OPEN_WRITE : i32 = 2;
const _OPEN_APPEND : i32 = 4;
const _OPEN_CREATE : i32 = 8;
const _OPEN_TRUNCATE : i32 = 16;
const _OPEN_CREATE_NEW : i32 = 32;

/// The right to open files. Only this file can make a `Files`, and a program gets one in its
/// `Root` (`std::root`). A function that gets a `&Files` uses it during the call and cannot keep
/// it.
struct Files {
  invariant true,
}

/// The file right of the program, for `std::root`. Only `std` can call it, because a second
/// `Files` gives the right to code that did not get it.
pkg unsafe fn files_of_the_program() -> Files {
  return Files {};
}

/// Why a file call did not work.
enum FileError {
  // The path holds a NUL byte, so the system cannot read it.
  BadPath,
  // No file has the path, or a folder of the path is missing.
  NotFound,
  // The system does not let the program open the file in the mode, or change it.
  PermissionDenied,
  // The name does not name a file inside the folder: it is empty or absolute, it has a `..`
  // part, or a part of it is a symbolic link.
  NotInFolder,
  // The file exists, and the options say to make a new file.
  AlreadyExists,
  // The options do not go together, or a seek goes before the start of the file.
  InvalidInput,
  // Another failure, with the error number of the system, or 0 when it gave none.
  Os(i32),
}

impl Copy for FileError {}

/// The `FileError` of a status that is not 0. The status is a category of the Rust core.
pub fn file_error(status : i32, native_code : i32) -> FileError {
  if status == 1 {
    return FileError::NotFound;
  }
  if status == 2 {
    return FileError::PermissionDenied;
  }
  if status == 3 {
    return FileError::AlreadyExists;
  }
  if status == 4 {
    return FileError::InvalidInput;
  }
  if status == 13 {
    return FileError::NotInFolder;
  }
  return FileError::Os(native_code);
}

/// A NUL-terminated copy of a path, for the Rust core. A drop releases it. The invariant lets
/// only this file make a `CPath` or change its pointer.
struct CPath {
  ptr : *const i8,

  invariant true,
}

impl CPath {
  /// A copy of `path`, or `BadPath` when `path` holds a NUL byte, because a C string ends at its
  /// first NUL.
  pub fn of(path : &String) -> Result<CPath, FileError> {
    let ptr = unsafe { vx_string_try_as_c_str(path.ptr) };
    if is_null(ptr) {
      return Result<CPath, FileError>::Err(FileError::BadPath);
    }
    return Result<CPath, FileError>::Ok(CPath {
      ptr : ptr
    });
  }
}

impl Drop for CPath {
  /// Release the copy.
  fn drop(self : &mut CPath) -> void {
    let _freed = unsafe { vx_string_free_c_str(self.ptr) };
  }
}

/// The three file-opening behaviors supported by the current host bridge.
enum OpenMode {
  Read,
  Write,
  ReadWriteCreate,
}

impl Copy for OpenMode {}

/// An open file, held by the Rust core behind an opaque pointer.
///
/// Closed when it is dropped.
struct File {
  ptr : *mut i8,

  invariant true,
}

// The handle may move to another task. It is not `Sync`, because each method takes
// `*mut File`, so a shared `&File` has no use yet.
unsafe impl Send for File {}
impl HostOnly for File {}

/// The code of a mode for the Rust core.
pub fn open_mode_code(mode : OpenMode) -> i32 {
  // Read uses code 0; the other modes replace it below.
  let mut mode_code : i32 = 0;
  match mode {
    OpenMode::Read() => {},
    OpenMode::Write() => {
      mode_code = 1;
    }
    OpenMode::ReadWriteCreate() => {
      mode_code = 2;
    }
  }
  return mode_code;
}

/// A position in a file, for `File::seek_to`. `Start` counts from the start of the file.
/// `Current` counts from the current position, and `End` from the end of the file. These two can
/// be negative.
enum SeekFrom {
  Start(u64),
  Current(i64),
  End(i64),
}

impl Copy for SeekFrom {}

impl File {
  /// Open `path` with a named mode. The caller needs the file right, a `&Files`.
  ///
  /// Writing creates the file and truncates it; read-and-write creates it and does not
  /// truncate. Reading does not create it.
  pub fn open(_files : &Files, path : &String, mode : OpenMode) -> Result<File, FileError> {
    let c_path = CPath::of(path)?;
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_file_try_open(c_path.ptr, open_mode_code(mode), (&mut ptr) as *mut *mut i8,
      (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<File, FileError>::Err(file_error(status, native_code));
    }
    return Result<File, FileError>::Ok(File {
      ptr : ptr
    });
  }

  /// Read up to `buffer.len()` bytes into `buffer` and give how many arrived. 0 means the end of
  /// the file. A short read is normal and is not an error.
  pub fn read(self : &mut File, buffer : &mut Vec<u8>) -> Result<u64, FileError> {
    let len = buffer.len() as u64;
    let mut count : u64 = 0;
    let mut native_code : i32 = 0;
    let mut has_native_code = false;
    let status = unsafe {
      _vx_file_try_read(self.ptr, buffer.as_mut_ptr(), len, (&mut count) as *mut u64,
      (&mut native_code) as *mut i32, (&mut has_native_code) as *mut bool)
    };
    if status != 0 {
      return Result<u64, FileError>::Err(file_error(status, native_code));
    }
    return Result<u64, FileError>::Ok(count);
  }

  /// Write up to `buffer.len()` bytes and give how many were taken. A short write is not an
  /// error, and the rest is not tried again here.
  pub fn write(self : &mut File, buffer : &Vec<u8>) -> Result<u64, FileError> {
    let len = buffer.len() as u64;
    let mut count : u64 = 0;
    let mut native_code : i32 = 0;
    let mut has_native_code = false;
    let status = unsafe {
      _vx_file_try_write(self.ptr, buffer.as_mut_ptr() as *const u8, len,
      (&mut count) as *mut u64, (&mut native_code) as *mut i32,
      (&mut has_native_code) as *mut bool)
    };
    if status != 0 {
      return Result<u64, FileError>::Err(file_error(status, native_code));
    }
    return Result<u64, FileError>::Ok(count);
  }

  /// Open `path` with a named mode, with no file right. Trusted code uses it, for example code
  /// that gets its path from C.
  ///
  /// **A failed open cannot be detected.** The returned `File` holds a null pointer, and Vx
  /// cannot compare a raw pointer against null or cast one to an integer (Vx#714) -- so a
  /// missing file is indistinguishable from an empty one until that closes. Every later call
  /// on it answers 0 or -1 rather than doing anything.
  ///
  /// Unsafe because nothing checks that `path` points at a NUL-terminated string.
  pub unsafe fn open_c_str(path : *const i8, mode : OpenMode) -> File {
    let ptr = unsafe { vx_file_open(path, open_mode_code(mode)) };
    File {
      ptr: ptr
    }
  }

  /// Read up to `len` bytes into `buffer` and answer how many arrived.
  ///
  /// Zero means end of file, a null file or buffer, or a read error -- the four are not told
  /// apart. A short read is normal and is not an error.
  ///
  /// Unsafe because `buffer` must have room for `len` bytes; nothing here checks.
  pub unsafe fn read_raw(self : *mut File, buffer : *mut u8, len : u64) -> u64 {
    unsafe { vx_file_read(self.ptr, buffer, len) }
  }

  /// Write up to `len` bytes from `buffer` and answer how many were taken.
  ///
  /// Zero means a null file or buffer, or a write error, with the same lack of distinction
  /// `read_raw` has. A short write is not an error and the remainder is not retried here.
  pub unsafe fn write_raw(self : *mut File, buffer : *const u8, len : u64) -> u64 {
    unsafe { vx_file_write(self.ptr, buffer, len) }
  }

  /// Move the read and write position, answering where it ended up.
  ///
  /// `whence` is 0 from the start, 1 from the current position, 2 from the end, as libc's
  /// `SEEK_SET`, `SEEK_CUR` and `SEEK_END`. Answers -1 for a null file, an unknown `whence`,
  /// or a seek the operating system refuses.
  pub fn seek(self : &mut File, offset : i64, whence : i32) -> i64 {
    unsafe { vx_file_seek(self.ptr, offset, whence) }
  }

  /// Move the position of the next read or write, and give the new position from the start of
  /// the file. A position before the start of the file gives `InvalidInput`.
  pub fn seek_to(self : &mut File, from : SeekFrom) -> Result<u64, FileError> {
    let mut offset : i64 = 0;
    let mut whence : i32 = 0;
    match from {
      SeekFrom::Start(position) => {
        offset = position as i64;
      }
      SeekFrom::Current(delta) => {
        offset = delta; whence = 1;
      }
      SeekFrom::End(delta) => {
        offset = delta; whence = 2;
      }
    }
    let mut position : u64 = 0;
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      _vx_file_try_seek(self.ptr, offset, whence, &mut position, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<u64, FileError>::Err(file_error(status, code));
    }
    return Result<u64, FileError>::Ok(position);
  }

  /// The position of the next read or write. It does not move the position.
  pub fn stream_position(self : &mut File) -> Result<u64, FileError> {
    return self.seek_to(SeekFrom::Current(0));
  }

  /// The whole file in memory, read-only, with no copy: the system reads each part of the file
  /// when the program first reads it. The file must be open for reading, else the result is
  /// `PermissionDenied`. The `Mapping` stays valid after the `File` closes.
  pub fn map(self : &File) -> Result<Mapping, FileError> {
    let mut base : *mut u8 = unsafe { 0 as *mut u8 };
    let mut len : i64 = 0;
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_file_try_map(self.ptr, (&mut base) as *mut *mut u8, (&mut len) as *mut i64,
      (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<Mapping, FileError>::Err(file_error(status, native_code));
    }
    return Result<Mapping, FileError>::Ok(Mapping {
      base : base, len : len
    });
  }
}

impl Drop for File {
  /// Close the file and release it.
  fn drop(self : &mut File) -> void {
    unsafe { vx_file_drop(self.ptr) };
  }
}

/// The choices for opening a file: read, write, append, create, truncate and create new. Each
/// choice is on or off on its own. `OpenMode` names the three common sets of choices.
///
/// `OpenOptions::new()` turns every choice off. Each setter returns new options, so that a
/// program can chain the calls. Rust's setters take `&mut self` instead. The invariant lets only
/// this file make an `OpenOptions` or change its bits.
///
/// ```vx
/// let log = OpenOptions::new().append(true).create(true);
/// let mut file = log.open(&root.files, &path)?;
/// ```
struct OpenOptions {
  flags : i32,

  invariant true,
}
impl Copy for OpenOptions {}

impl OpenOptions {
  /// Options with every choice turned off.
  pub fn new() -> OpenOptions {
    return OpenOptions {
      flags : 0
    };
  }

  // Turn the choice `bit` on or off.
  fn _with_flag(self : OpenOptions, bit : i32, enabled : bool) -> OpenOptions {
    let mut options = self;
    if enabled {
      options.flags = options.flags | bit;
    } else {
      options.flags = options.flags & !bit;
    }
    return options;
  }

  /// Turn reading on or off.
  pub fn read(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_READ, enabled);
  }

  /// Turn writing on or off. Writing alone does not make the file and does not make it empty.
  pub fn write(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_WRITE, enabled);
  }

  /// Turn appending on or off. Each write then goes to the end of the file. Appending also turns
  /// writing on.
  pub fn append(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_APPEND, enabled);
  }

  /// Make the file if it does not exist. Writing or appending must also be on.
  pub fn create(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_CREATE, enabled);
  }

  /// Make an existing file empty. Writing must also be on, and appending must be off.
  pub fn truncate(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_TRUNCATE, enabled);
  }

  /// Make a new file, and fail if the file exists. The check and the creation are one step.
  /// This choice ignores `create` and `truncate`. Writing or appending must also be on.
  pub fn create_new(self : OpenOptions, enabled : bool) -> OpenOptions {
    return self._with_flag(_OPEN_CREATE_NEW, enabled);
  }

  /// Open the file at `path` with these options. The caller needs the file right, a `&Files`.
  ///
  /// Options with no choice on, or with choices that do not go together, give `InvalidInput`.
  /// For example, `create` without `write` or `append`, or `truncate` with `append`. With
  /// `create_new`, a file that exists gives `AlreadyExists`.
  pub fn open(self : &OpenOptions, _files : &Files, path : &String) -> Result<File, FileError> {
    let c_path = CPath::of(path)?;
    let mut ptr : *mut i8 = unsafe { 0 as *mut i8 };
    let mut code : i32 = 0;
    let mut has_code : bool = false;
    let status = unsafe {
      _vx_file_open_options(c_path.ptr, self.flags, &mut ptr, &mut code, &mut has_code)
    };
    if status != 0 {
      return Result<File, FileError>::Err(file_error(status, code));
    }
    return Result<File, FileError>::Ok(File {
      ptr : ptr
    });
  }
}

/// A read-only view of a whole file in memory, from `File::map`. A drop unmaps it. The
/// invariant lets only this file make a `Mapping` or change its fields.
///
/// The view shows the file as it is now. When another program shortens the file, a read past
/// its new end stops the program with the signal SIGBUS.
struct Mapping {
  base : *mut u8,
  len : i64,

  invariant true,
}

// The memory does not change through a `Mapping`, so tasks may share it.
unsafe impl Send for Mapping {}
unsafe impl Sync for Mapping {}

impl Mapping {
  /// The size of the file in bytes, when it was mapped.
  pub fn len(self : &Mapping) -> i64 {
    return self.len;
  }

  /// The address of the first byte of the file, or null for an empty file. Code that reads
  /// through it must keep the `Mapping` until it stops reading.
  pub fn as_ptr(self : &Mapping) -> *const u8 {
    return self.base as *const u8;
  }

  /// Byte `i` of the file. Panics when `i` is outside the file.
  pub fn byte(self : &Mapping, i : i64) -> u8 {
    assert(i >= 0 && i < self.len, "the index is outside the mapped file");
    return unsafe { self.base[i] };
  }
}

impl Drop for Mapping {
  /// Unmap the file.
  fn drop(self : &mut Mapping) -> void {
    unsafe { vx_file_unmap(self.base, self.len) };
  }
}

/// The right to read the files of one folder, and of the folders inside it. A function that
/// gets a `&Folder` can read those files and no others, because a name that leads out of the
/// folder gives `NotInFolder`. A program narrows its `Files` to a `Folder` with `Folder::open`.
///
/// The Rust core holds the open folder, so a rename of the folder does not change which files
/// the `Folder` reads. The invariant lets only this file make a `Folder` or change its field.
struct Folder {
  dir : *mut i8,

  invariant true,
}

// A `Folder` may move to another task, and tasks may share it: an open in a folder does not
// change the folder.
unsafe impl Send for Folder {}
unsafe impl Sync for Folder {}

impl Folder {
  /// Open the folder at `path`. The caller needs the file right, a `&Files`.
  pub fn open(_files : &Files, path : &String) -> Result<Folder, FileError> {
    let c_path = CPath::of(path)?;
    let mut dir : *mut i8 = unsafe { 0 as *mut i8 };
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_folder_open(c_path.ptr, (&mut dir) as *mut *mut i8, (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<Folder, FileError>::Err(file_error(status, native_code));
    }
    return Result<Folder, FileError>::Ok(Folder {
      dir : dir
    });
  }

  /// Open the file `name` of this folder for reading. `name` is a path inside the folder, such
  /// as `"weights.bin"` or `"adapters/a.bin"`.
  pub fn open_file(self : &Folder, name : &String) -> Result<File, FileError> {
    let ptr = self.open_below(name, 0)?;
    return Result<File, FileError>::Ok(File {
      ptr : ptr
    });
  }

  /// Open the folder `name` inside this folder: a narrower right.
  pub fn open_folder(self : &Folder, name : &String) -> Result<Folder, FileError> {
    let dir = self.open_below(name, 1)?;
    return Result<Folder, FileError>::Ok(Folder {
      dir : dir
    });
  }

  /// The handle of the Rust core for `name`, a file or, with `want_folder` 1, a folder.
  pub fn open_below(self : &Folder, name : &String, want_folder : i32) -> Result<*mut i8, FileError> {
    let c_name = CPath::of(name)?;
    let mut out : *mut i8 = unsafe { 0 as *mut i8 };
    let mut native_code : i32 = 0;
    let status = unsafe {
      vx_folder_open_file(self.dir, c_name.ptr, want_folder, (&mut out) as *mut *mut i8,
      (&mut native_code) as *mut i32)
    };
    if status != 0 {
      return Result<*mut i8, FileError>::Err(file_error(status, native_code));
    }
    return Result<*mut i8, FileError>::Ok(out);
  }
}

impl Drop for Folder {
  /// Close the folder. The Rust core holds an open folder as a file.
  fn drop(self : &mut Folder) -> void {
    unsafe { vx_file_drop(self.dir) };
  }
}
