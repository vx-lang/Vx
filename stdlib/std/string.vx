extern {
  fn vx_string_new() -> *mut i8;
  fn vx_string_from_c_str(ptr : *const i8) -> *mut i8;
  fn vx_string_push_c_str(ptr : *mut i8, c_str : *const i8) -> i32;
  fn vx_string_len(ptr : *mut i8) -> i32;
  fn vx_string_as_c_str(ptr : *mut i8) -> *const i8;
  fn vx_string_free_c_str(ptr : *const i8) -> i32;
  fn vx_string_drop(ptr : *mut i8) -> i32;
  fn vx_i32_to_string(val : i32)->*mut i8;
}

struct String {
  ptr : *mut i8,
}

impl String {
  fn new ()->String {
    let ptr = unsafe { vx_string_new() };
    String {
      ptr:
      ptr
    }
  }

  unsafe fn from_c_str(c_str : *const i8) -> String {
    let ptr = unsafe { vx_string_from_c_str(c_str) };
    String {
      ptr:
      ptr
    }
  }

  unsafe fn push_c_str(self : *mut String, c_str : *const i8) -> i32 {
    return unsafe { vx_string_push_c_str(self.ptr, c_str) };
  }

  fn len(self : *mut String) -> i32 {
    return unsafe { vx_string_len(self.ptr) };
  }

  fn as_c_str(self : *mut String) -> *const i8 {
    return unsafe { vx_string_as_c_str(self.ptr) };
  }

  fn drop(self : *mut String) -> i32 {
    return unsafe { vx_string_drop(self.ptr) };
  }
}

impl i32 {
  fn to_string(self : i32) -> String {
    let ptr = unsafe { vx_i32_to_string(self) };
    return String {
      ptr : ptr
    };
  }
}

// Returns the length of a null-terminated string
unsafe fn string_length(s: *const i8) -> i32 {
  let mut len: i32 = 0;
  unsafe { loop { if s[len] == 0 { break; } len = len + 1; } }
  return len;
}

// Compares two null-terminated strings
unsafe fn string_compare(s1: *const i8, s2: *const i8) -> i32 {
  let mut i: i32 = 0;
  let mut result: i32 = 0;
  unsafe {
    loop {
      if s1[i] == 0 || s1[i] != s2[i] {
        break;
      }
      i = i + 1;
    }
    result = (s1[i] as i32) - (s2[i] as i32);
  }
  return result;
}

// Parses a simple integer from a string slice
unsafe fn parse_int(s: *const i8) -> i32 {
  let mut val: i32 = 0;
  let mut i: i32 = 0;
  unsafe {
    loop {
      if s[i] < 48 || s[i] > 57 {
        break;
      }
      let digit: i32 = (s[i] - 48) as i32;
      val = val * 10 + digit;
      i = i + 1;
    }
  }
  return val;
}
