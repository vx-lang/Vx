// Returns the length of a null-terminated string
fn string_length(s: *const u8) -> i32 {
  let mut len: i32 = 0;
  unsafe { while s[len] != 0 { len = len + 1; } }
  return len;
}

// Compares two null-terminated strings
fn string_compare(s1: *const u8, s2: *const u8) -> i32 {
  let mut i: i32 = 0;
  unsafe {
    while s1[i] != 0 && s1[i] == s2[i] {
      i = i + 1;
    }
    return (s1[i] as i32) - (s2[i] as i32);
  }
}

// Parses a simple integer from a string slice
fn parse_int(s: *const u8) -> i32 {
  let mut val: i32 = 0;
  let mut i: i32 = 0;
  unsafe {
    while s[i] >= 48 && s[i] <= 57 {
      let digit: i32 = (s[i] - 48) as i32;
      val = val * 10 + digit;
      i = i + 1;
    }
  }
  return val;
}
