// Centralized unsafe memory allocation bindings.
//===----------------------------------------------------------------------===//

extern "C" {
  fn malloc(size : i64) -> *mut i8;
  fn realloc(ptr : *mut i8, size : i64) -> *mut i8;
  fn free(ptr : *mut i8) -> i32;
}
