import std::closure;
import std::iter;

// Memory management is delegated to the type-erased byte allocator in
// `stdlib/rust_core` (collections/vec.rs). Rust owns alignment, growth doubling,
// `capacity * elem_size` overflow, out-of-memory, and bounds enforcement, so the
// hand-rolled correctness pitfalls (silent i32 overflow, unchecked malloc, and
// the compile-time-only `assert` bounds checks) are gone. Vx keeps only a typed
// `data : *mut T` view into the Rust-managed buffer and does its own typed
// element loads/stores.
extern "C" {
  fn vx_vec_alloc(elem_size : i64, cap : i64) -> *mut i8;
  fn vx_vec_grow(ptr : *mut i8, old_cap : i64, new_cap : i64, elem_size : i64) -> *mut i8;
  fn vx_vec_free(ptr : *mut i8, cap : i64, elem_size : i64) -> i32;
  fn vx_vec_bounds_check(index : i64, len : i64) -> i32;
}

struct Vec<T> {
  data : *mut T,
  len : i32,
  capacity : i32,
}

impl<T>
Vec<T> {
  fn new ()->Vec<T> {
    return Vec<T>::with_capacity(2);
  }

  fn with_capacity(capacity : i32) -> Vec<T> {
    let ptr : *mut T = unsafe { vx_vec_alloc(sizeof<T>(), capacity as i64) };
    return Vec<T> {
      data : ptr, len : 0, capacity : capacity
    };
  }

  fn free(self : &mut Vec<T>) -> i32 {
    unsafe {
      let ptr_i8 : *mut i8 = self.data;
      vx_vec_free(ptr_i8, self.capacity as i64, sizeof<T>());
      self.data = 0 as *mut T;
    }
    self.len = 0;
    self.capacity = 0;
    return 0;
  }

  fn as_mut_ptr(self : &Vec<T>) -> *mut T {
    return self.data;
  }

  fn as_mut_slice(self : &mut Vec<T>) -> &mut T {
    let ptr : *mut T = self.data;
    return unsafe { &mut *ptr };
  }

  fn as_slice(self : &Vec<T>) -> &T {
    let ptr : *mut T = self.data;
    return unsafe { &*ptr };
  }

  fn push(self : &mut Vec<T>, val : T) -> i32 {
    if self
    .len == self.capacity {
      let mut new_cap : i32 = 4;
      if self
      .capacity > 0 {
        new_cap = self.capacity * 2;
      }
      // Rust owns the realloc and the overflow-checked byte-size math; a
      // capacity that overflows i32 here aborts cleanly in `vx_vec_grow`
      // instead of silently wrapping to a bogus allocation.
      let ptr : *mut i8 = self.data;
      self.data = unsafe {
        vx_vec_grow(ptr, self.capacity as i64, new_cap as i64, sizeof<T>())
      };
      self.capacity = new_cap;
    }
    unsafe { self.data[self.len] = val; }
    self.len = self.len + 1;
    return 0;
  }

  fn get(self : &Vec<T>, index: i32) -> T {
    unsafe { vx_vec_bounds_check(index as i64, self.len as i64); }
    return unsafe { self.data[index] };
  }

  fn set(self : &mut Vec<T>, index: i32, val: T) -> i32 {
    unsafe { vx_vec_bounds_check(index as i64, self.len as i64); }
    unsafe { self.data[index] = val; }
    return 0;
  }

  fn len(self : &Vec<T>) -> i32 {
    return self.len;
  }

  fn iter(self : &Vec<T>) -> VecIter<T> {
    return VecIter<T> {
      vec : self, current : 0
    };
  }
}

struct VecIter<T> {
  vec: *const Vec<T>,
  current: i32,
}

impl<T> Iterator<VecIter<T>, T> for VecIter<T> {
  fn next(self : &mut VecIter<T>) -> Option<T> {
    let vec_len : i32 = unsafe { (*self.vec).len };
    let mut ret = Option<T>::None();
    if self
    .current < vec_len {
      let val : T = unsafe { (*self.vec).data[self.current] };
      self.current = self.current + 1;
      ret = Option<T>::Some(val);
    }
    return ret;
  }
}

impl<T>
VecIter<T> {
  fn map<NewItem>(self : VecIter<T>, f : Closure1<T, NewItem>)
  -> VecMap<T, NewItem> {
    return VecMap<T, NewItem> {
      iter : self, f : f
    };
  }
}

struct VecMap<T, NewItem> {
  iter: VecIter<T>,
  f: Closure1<T, NewItem>,
}

impl<T, NewItem> Iterator<VecMap<T, NewItem>, NewItem> for VecMap<T, NewItem> {
  fn next(self : &mut VecMap<T, NewItem>) -> Option<NewItem> {
    let mut ret = Option<NewItem>::None();
    let mut opt = self.iter.next();
    loop {
      if opt
      .is_none() {
        break;
      }
      let item = opt.unwrap();
      let f_closure = self.f;
      let f_ptr = f_closure.func;
      let new_item = f_ptr(f_closure.env, item);
      ret = Option<NewItem>::Some(new_item);
      break;
    }
    return ret;
  }
}

impl<T, NewItem>
VecMap<T, NewItem> {
  fn collect(self : &mut VecMap<T, NewItem>) -> Vec<NewItem> {
    let mut result = Vec<NewItem>::new ();
    loop {
      let mut opt = self.next();
      if opt
      .is_none() {
        break;
      }
      result.push(opt.unwrap());
    }
    return result;
  }
}
