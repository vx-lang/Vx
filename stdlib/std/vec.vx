import std::iter;

extern "C" {
  fn malloc(size: i32) -> *mut i8;
  fn realloc(ptr: *mut i8, size: i32) -> *mut i8;
  fn free(ptr: *mut i8) -> i32;
}

struct Vec<T> {
  data: *mut T,
  len: i32,
  capacity: i32,
}

impl<T> Vec<T> {
  fn new() -> Vec<T> {
    let ptr: *mut T = unsafe { malloc(0) };
    return Vec<T> {
      data: ptr,
      len: 0,
      capacity: 0
    };
  }

  fn push(self: &mut Vec<T>, val: T) -> i32 {
    if self.len == self.capacity {
      let mut new_cap: i32 = 4;
      if self.capacity > 0 {
        new_cap = self.capacity * 2;
      }
      let size_bytes: i32 = new_cap * sizeof<T>();
      
      let ptr: *mut i8 = self.data;
      self.data = unsafe { realloc(ptr, size_bytes) };
      self.capacity = new_cap;
    }
    unsafe {
      self.data[self.len] = val;
    }
    self.len = self.len + 1;
    return 0;
  }

  fn iter(self: &Vec<T>) -> VecIter<T> {
    return VecIter<T> {
      vec: self,
      current: 0
    };
  }
}

struct VecIter<T> {
  vec: *const Vec<T>,
  current: i32,
}

impl<T> Iterator<VecIter<T>, T> for VecIter<T> {
  fn next(self: &mut VecIter<T>) -> Option<T> {
    let vec_len: i32 = unsafe { (*self.vec).len };
    let mut ret = Option<T>::None();
    if self.current < vec_len {
      let val: T = unsafe { (*self.vec).data[self.current] };
      self.current = self.current + 1;
      ret = Option<T>::Some(val);
    }
    return ret;
  }
}
