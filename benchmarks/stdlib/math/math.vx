// Every float method of `core::num` that computes a value, at f32 and f64: the sum of
// the method over 10^6 inputs spread evenly over a range where it is defined. math.cpp
// sums the `<cmath>` counterpart over the same inputs.
//
// The two macros stamp a kernel and a function that runs it and reports; the table at
// the bottom lists the methods and their ranges. `y` is the second operand, spread over
// its own range in another order.
import core::num;
import std::time;

macro_rules unary_bench {
  ($kernel : ident, $run : ident, $t : ident, $lo : expr, $hi : expr, $method : ident, $label : expr) => {
    fn $kernel(n : i32, seed : i32) -> $t {
      let mut acc : $t = 0.0;
      let lo : $t = $lo;
      let step : $t = ($hi - $lo) / 1024.0;
      for i in 0..n {
        let x : $t = lo + (((i + seed) & 1023) as $t) * step;
        acc += x.$method();
      }
      return acc;
    }

    fn $run() -> i32 {
      let mut best : f32 = 1000.0;
      let mut total : f64 = 0.0;
      for rep in 0..5 {
        let t0 = now();
        let r = $kernel(1000000, rep);
        let dt = now() - t0;
        total += r as f64;
        if dt < best {
          best = dt;
        }
      }
      unsafe {
        bench_report($label, "seconds", best);
        bench_report($label, "result", total as f32);
      }
      return 0;
    }
  };
}

macro_rules binary_bench {
  ($kernel : ident, $run : ident, $t : ident, $lo : expr, $hi : expr, $ylo : expr, $yhi : expr, $method : ident, $label : expr) => {
    fn $kernel(n : i32, seed : i32) -> $t {
      let mut acc : $t = 0.0;
      let lo : $t = $lo;
      let step : $t = ($hi - $lo) / 1024.0;
      let ylo : $t = $ylo;
      let ystep : $t = ($yhi - $ylo) / 1024.0;
      for i in 0..n {
        let x : $t = lo + (((i + seed) & 1023) as $t) * step;
        let y : $t = ylo + (((i * 7 + seed) & 1023) as $t) * ystep;
        acc += x.$method(y);
      }
      return acc;
    }

    fn $run() -> i32 {
      let mut best : f32 = 1000.0;
      let mut total : f64 = 0.0;
      for rep in 0..5 {
        let t0 = now();
        let r = $kernel(1000000, rep);
        let dt = now() - t0;
        total += r as f64;
        if dt < best {
          best = dt;
        }
      }
      unsafe {
        bench_report($label, "seconds", best);
        bench_report($label, "result", total as f32);
      }
      return 0;
    }
  };
}

// `mul_add` takes two operands and `clamp` two bounds, so they are written out here, in the
// shape the macros produce: `x.mul_add(y, x)` and `x.clamp(-1.0, 1.0)`.

fn mul_add_f32(n : i32, seed : i32) -> f32 {
  let mut acc : f32 = 0.0;
  let lo : f32 = -10.0;
  let step : f32 = (10.0 - -10.0) / 1024.0;
  let ylo : f32 = -10.0;
  let ystep : f32 = (10.0 - -10.0) / 1024.0;
  for i in 0..n {
    let x : f32 = lo + (((i + seed) & 1023) as f32) * step;
    let y : f32 = ylo + (((i * 7 + seed) & 1023) as f32) * ystep;
    acc += x.mul_add(y, x);
  }
  return acc;
}

fn clamp_f32(n : i32, seed : i32) -> f32 {
  let mut acc : f32 = 0.0;
  let lo : f32 = -10.0;
  let step : f32 = (10.0 - -10.0) / 1024.0;
  for i in 0..n {
    let x : f32 = lo + (((i + seed) & 1023) as f32) * step;
    acc += x.clamp(-1.0, 1.0);
  }
  return acc;
}

fn run_mul_add_f32() -> i32 {
  let mut best : f32 = 1000.0;
  let mut total : f64 = 0.0;
  for rep in 0..5 {
    let t0 = now();
    let r = mul_add_f32(1000000, rep);
    let dt = now() - t0;
    total += r as f64;
    if dt < best {
      best = dt;
    }
  }
  unsafe {
    bench_report("mul_add_f32/core_num", "seconds", best);
    bench_report("mul_add_f32/core_num", "result", total as f32);
  }
  return 0;
}

fn run_clamp_f32() -> i32 {
  let mut best : f32 = 1000.0;
  let mut total : f64 = 0.0;
  for rep in 0..5 {
    let t0 = now();
    let r = clamp_f32(1000000, rep);
    let dt = now() - t0;
    total += r as f64;
    if dt < best {
      best = dt;
    }
  }
  unsafe {
    bench_report("clamp_f32/core_num", "seconds", best);
    bench_report("clamp_f32/core_num", "result", total as f32);
  }
  return 0;
}

fn mul_add_f64(n : i32, seed : i32) -> f64 {
  let mut acc : f64 = 0.0;
  let lo : f64 = -10.0;
  let step : f64 = (10.0 - -10.0) / 1024.0;
  let ylo : f64 = -10.0;
  let ystep : f64 = (10.0 - -10.0) / 1024.0;
  for i in 0..n {
    let x : f64 = lo + (((i + seed) & 1023) as f64) * step;
    let y : f64 = ylo + (((i * 7 + seed) & 1023) as f64) * ystep;
    acc += x.mul_add(y, x);
  }
  return acc;
}

fn clamp_f64(n : i32, seed : i32) -> f64 {
  let mut acc : f64 = 0.0;
  let lo : f64 = -10.0;
  let step : f64 = (10.0 - -10.0) / 1024.0;
  for i in 0..n {
    let x : f64 = lo + (((i + seed) & 1023) as f64) * step;
    acc += x.clamp(-1.0, 1.0);
  }
  return acc;
}

fn run_mul_add_f64() -> i32 {
  let mut best : f32 = 1000.0;
  let mut total : f64 = 0.0;
  for rep in 0..5 {
    let t0 = now();
    let r = mul_add_f64(1000000, rep);
    let dt = now() - t0;
    total += r as f64;
    if dt < best {
      best = dt;
    }
  }
  unsafe {
    bench_report("mul_add_f64/core_num", "seconds", best);
    bench_report("mul_add_f64/core_num", "result", total as f32);
  }
  return 0;
}

fn run_clamp_f64() -> i32 {
  let mut best : f32 = 1000.0;
  let mut total : f64 = 0.0;
  for rep in 0..5 {
    let t0 = now();
    let r = clamp_f64(1000000, rep);
    let dt = now() - t0;
    total += r as f64;
    if dt < best {
      best = dt;
    }
  }
  unsafe {
    bench_report("clamp_f64/core_num", "seconds", best);
    bench_report("clamp_f64/core_num", "result", total as f32);
  }
  return 0;
}

