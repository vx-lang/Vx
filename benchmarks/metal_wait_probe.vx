//===----------------------------------------------------------------------===//
// The probe: the round trip of a small kernel and a host read of its
// output, on the Apple GPU. Each loop launches a kernel of one block of 32
// lanes 960 times. The first loop reads the output once, at the end. The second
// reads `x[0]` with `transfer(&x, Memory::CPU_DRAM)` after each launch, so each
// launch pays a wait for the GPU. Each run prints the wall time of each loop,
// divided by the launches. The reads go through a `&` parameter, so each read
// is in place, and the cost of the loop is the wait.
//
// Run from the repository root:
//
//   cargo build --release
//   target/release/vxc benchmarks/metal_wait_probe.vx --host default --machine fleet/m4-uma.vx -O2
//
// The wait of a read spins on the sentinel only when VX_METAL_SENTINEL=1 is
// set, for the sentinel is opt-in; the waits of a read otherwise block in
// `waitUntilCompleted`.
//
// vx-bench flags: --host default --machine fleet/m4-uma.vx -O2

import core::convert;
import std::time;

// x[i] = x[i] + 1
fn add_one(x : &mut Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for g in 0..1 across blocks {
      for l in 0..32 across lanes(32) {
        let i = g * 32 + l;
        if i < n {
          x[i] = x[i] + 1.0;
        }
      }
    }
  }
  return;
}

// Reads x[0] on the CPU, through a `&` parameter, so the read is in place.
fn read_first(x : &Tensor<f32, [?], Memory::HBM>) -> f32 {
  return transfer(x, Memory::CPU_DRAM)[0];
}

fn main() -> i32 {
  let launches : i32 = 960;
  let n : i32 = 32;
  let mut x = transfer(Tensor<f32, [256]>::fill(0.0), Memory::HBM);
  let mut check : f64 = 0.0;
  for round in 0..3 {
    // A launch alone: the read of the output happens once, after the loop.
    let t0 = Instant::now();
    for i in 0..launches {
      add_one(&mut x, n);
    }
    check += f64::from(read_first(&x));
    let once = f64::from(t0.elapsed().as_secs_f32()) * 1e6 / f64::from(launches);
    // A launch and a read: each launch waits for the GPU, for the read.
    let t1 = Instant::now();
    for i in 0..launches {
      add_one(&mut x, n);
      check += f64::from(read_first(&x));
    }
    let each = f64::from(t1.elapsed().as_secs_f32()) * 1e6 / f64::from(launches);
    if round > 0 {
      println!("a launch alone {} us | a launch and a read {} us | check {}",
      once, each, check);
    }
  }
  // Each read returns x[0] after the launches before it, so `check` has one
  // value that a stale read cannot give. Over the three rounds of the loop,
  // where each round adds one read of `once` and `launches` reads of `each`,
  // the value is 10.5 * launches * (launches + 1).
  let expected = 10.5 * f64::from(launches) * f64::from(launches + 1);
  if check != expected {
    println!("check WRONG {} != {}", check, expected);
    return 1;
  }
  return 0;
}
