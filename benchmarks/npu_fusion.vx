import std::time;
extern "C" {

}

fn run_benchmark_128() -> i32 {
  let mut a_host = Tensor<f32, [128, 128]>::uninit();
  let mut b_host = Tensor<f32, [128, 128]>::uninit();
  let mut bias_host = Tensor<f32, [128, 128]>::uninit();
  let mut out_unfused_host = Tensor<f32, [128, 128]>::uninit();
  let mut out_fused_host = Tensor<f32, [128, 128]>::uninit();

  for i in 0..128 {
    for j in 0..128 {
      let sum_idx = i + j;
      if sum_idx == 0 {
        a_host[i][j] = 1.0;
        bias_host[i][j] = 0.0 - 150.0;
      } else {
        a_host[i][j] = 0.0 - 1.0;
        bias_host[i][j] = 50.0;
      }
      b_host[i][j] = 1.0;
      out_unfused_host[i][j] = 0.0;
      out_fused_host[i][j] = 0.0;
    }
  }

  // Transfer to 128PU
  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);
  let bias = transfer(bias_host, Memory::NPU_HBM);
  let mut out_unfused = transfer(out_unfused_host, Memory::NPU_HBM);
  let mut out_fused = transfer(out_fused_host, Memory::NPU_HBM);

  let mut temp_matmul = Tensor<f32, [128, 128]>::uninit();
  let mut temp_bias = Tensor<f32, [128, 128]>::uninit();
  let mut temp_matmul_npu = transfer(temp_matmul, Memory::NPU_HBM);
  let mut temp_bias_npu = transfer(temp_bias, Memory::NPU_HBM);

  unsafe {
    // Warmup Unfused immediately before benchmark
    spawn on(Topology::NPU[0]) {
      for i in 0..128 {
        for j in 0..128 {
          temp_matmul_npu[i][j] = 0.0;
          for k in 0..128 {
            temp_matmul_npu[i][j] += a[i][k] * b[k][j];
          }
        }
      }
    }
    spawn on(Topology::NPU[0]) {
      for i in 0..128 {
        for j in 0..128 {
          temp_bias_npu[i][j] = temp_matmul_npu[i][j] + bias[i][j];
        }
      }
    }
    spawn on(Topology::NPU[0]) {
      for i in 0..128 {
        for j in 0..128 {
          let val = temp_bias_npu[i][j];
          if val > 0.0 {
            out_unfused[i][j] = val;
          } else {
            out_unfused[i][j] = 0.0;
          }
        }
      }
    }

    // Benchmark Unfused
    let t1 = now();
    for _iter in 0..10 {
      spawn on(Topology::NPU[0]) {
        for i in 0..128 {
          for j in 0..128 {
            temp_matmul_npu[i][j] = 0.0;
            for k in 0..128 {
              temp_matmul_npu[i][j] += a[i][k] * b[k][j];
            }
          }
        }
      }
      spawn on(Topology::NPU[0]) {
        for i in 0..128 {
          for j in 0..128 {
            temp_bias_npu[i][j] = temp_matmul_npu[i][j] + bias[i][j];
          }
        }
      }
      spawn on(Topology::NPU[0]) {
        for i in 0..128 {
          for j in 0..128 {
            let val = temp_bias_npu[i][j];
            if val > 0.0 {
              out_unfused[i][j] = val;
            } else {
              out_unfused[i][j] = 0.0;
            }
          }
        }
      }
    }
    let t2 = now();
    let time_unfused = t2 - t1;

    // Warmup Fused immediately before benchmark
    spawn on(Topology::NPU[0]) {
      for i in 0..128 {
        for j in 0..128 {
          let mut sum = 0.0;
          for k in 0..128 {
            sum += a[i][k] * b[k][j];
          }
          sum += bias[i][j];
          if sum > 0.0 {
            out_fused[i][j] = sum;
          } else {
            out_fused[i][j] = 0.0;
          }
        }
      }
    }

    // Benchmark Fused
    let t3 = now();
    for _iter in 0..10 {
      spawn on(Topology::NPU[0]) {
        for i in 0..128 {
          for j in 0..128 {
            let mut sum = 0.0;
            for k in 0..128 {
              sum += a[i][k] * b[k][j];
            }
            sum += bias[i][j];
            if sum > 0.0 {
              out_fused[i][j] = sum;
            } else {
              out_fused[i][j] = 0.0;
            }
          }
        }
      }
    }
    let t4 = now();
    let time_fused = t4 - t3;

    print!(time_unfused);
    print!(time_fused);
    assert(time_fused <= time_unfused);
  }

  // Verification
  let out_unfused_res = transfer(out_unfused, Memory::CPU_DRAM);
  let out_fused_res = transfer(out_fused, Memory::CPU_DRAM);
  for i in 0..128 {
    for j in 0..128 {
      assert(out_unfused_res[i][j] == out_fused_res[i][j],
      "Mismatch between fused and unfused 128PU results");
    }
  }

  return 0;
}

