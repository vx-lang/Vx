          temp_matmul_npu[i][j] = 0.0;
          for k in 0..2048 {
            temp_matmul_npu[i][j] += a[i][k] * b[k][j];
          }
        }
      }
    }
    spawn on(Topology::NPU[0]) {
      for i in 0..2048 {
        for j in 0..2048 {
          temp_bias_npu[i][j] = temp_matmul_npu[i][j] + bias[i][j];
        }
      }
    }
    spawn on(Topology::NPU[0]) {
      for i in 0..2048 {
        for j in 0..2048 {
          let val = temp_bias_npu[i][j];
          if val > 0.0 {
            out_unfused[i][j] = val;
          } else {
            out_unfused[i][j] = 0.0;
          }
        }
      }
    }

    // Benchmark Unfused
    let t1 = now();
    for _iter in 0..10 {
      spawn on(Topology::NPU[0]) {
        for i in 0..2048 {
          for j in 0..2048 {
            temp_matmul_npu[i][j] = 0.0;
            for k in 0..2048 {
              temp_matmul_npu[i][j] += a[i][k] * b[k][j];
            }
          }
        }
      }
      spawn on(Topology::NPU[0]) {
        for i in 0..2048 {
          for j in 0..2048 {
            temp_bias_npu[i][j] = temp_matmul_npu[i][j] + bias[i][j];
          }
        }
      }
      spawn on(Topology::NPU[0]) {
        for i in 0..2048 {
          for j in 0..2048 {
            let val = temp_bias_npu[i][j];
            if val > 0.0 {
              out_unfused[i][j] = val;
            } else {
              out_unfused[i][j] = 0.0;
            }
          }
        }
      }
    }
    let t2 = now();
    let time_unfused = t2 - t1;

    // Warmup Fused immediately before benchmark
    spawn on(Topology::NPU[0]) {
      for i in 0..2048 {
        for j in 0..2048 {
          let mut sum = 0.0;
          for k in 0..2048 {
            sum += a[i][k] * b[k][j];
          }
          sum += bias[i][j];
          if sum > 0.0 {
            out_fused[i][j] = sum;
          } else {
            out_fused[i][j] = 0.0;
          }
        }
      }
    }

    // Benchmark Fused
    let t3 = now();
    for _iter in 0..10 {
      spawn on(Topology::NPU[0]) {
        for i in 0..2048 {
          for j in 0..2048 {
            let mut sum = 0.0;
            for k in 0..2048 {
              sum += a[i][k] * b[k][j];
            }
            sum += bias[i][j];
            if sum > 0.0 {
              out_fused[i][j] = sum;
            } else {
              out_fused[i][j] = 0.0;
            }
          }
        }
      }
    }
    let t4 = now();
    let time_fused = t4 - t3;

    print!(time_unfused);
    print!(time_fused);
    assert(time_fused <= time_unfused);
  }

  // Verification
  let out_unfused_res = transfer(out_unfused, Memory::CPU_DRAM);
  let out_fused_res = transfer(out_fused, Memory::CPU_DRAM);
  for i in 0..2048 {
    for j in 0..2048 {
      assert(out_unfused_res[i][j] == out_fused_res[i][j],
      "Mismatch between fused and unfused 2048PU results");
    }
  }

  return 0;
}

fn main() -> i32 {
  run_benchmark_128();
  run_benchmark_256();
  run_benchmark_512();
  run_benchmark_1024();
  run_benchmark_2048();
  return 0;
}
