  let mut temp_matmul_npu = transfer(temp_matmul, Memory::NPU_HBM);
  let mut temp_bias_npu = transfer(temp_bias, Memory::NPU_HBM);

  unsafe {
    // Warmup Unfused immediately before benchmark
