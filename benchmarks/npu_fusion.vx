  let mut out_fused_host = Tensor<f32, [2048, 2048]>::uninit();

  for i in 0..2048 {
    for j in 0..2048 {
      let sum_idx = i + j;
      if sum_idx == 0 {
        a_host[i][j] = 1.0;
        bias_host[i][j] = 0.0 - 150.0;
      } else {
        a_host[i][j] = 0.0 - 1.0;
        bias_host[i][j] = 50.0;
      }
      b_host[i][j] = 1.0;
