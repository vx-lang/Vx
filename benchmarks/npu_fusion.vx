//===- npu_fusion_overhead.vx ------------------------------*- Vx -*-===//

extern "C" {
  fn vx_get_time() -> f32;
  fn print_f32(val: f32) -> i32;
}

fn run_benchmark(N: i32) -> i32 {
  let mut a_host = Tensor_f32(N, N);
  let mut b_host = Tensor_f32(N, N);
  let mut bias_host = Tensor_f32(N, N);
  let mut out_unfused_host = Tensor_f32(N, N);
  let mut out_fused_host = Tensor_f32(N, N);

  for i in 0..N {
    for j in 0..N {
      let sum_idx = i + j;
      if sum_idx == 0 {
        a_host[i][j] = 1.0;
        bias_host[i][j] = 0.0 - 150.0;
      } else {
        a_host[i][j] = 0.0 - 1.0;
        bias_host[i][j] = 50.0;
      }
      b_host[i][j] = 1.0;
      out_unfused_host[i][j] = 0.0;
      out_fused_host[i][j] = 0.0;
    }
  }

  // Transfer to NPU
  let a = transfer(a_host, Memory::NPU_HBM);
  let b = transfer(b_host, Memory::NPU_HBM);
  let bias = transfer(bias_host, Memory::NPU_HBM);
  let mut out_unfused = transfer(out_unfused_host, Memory::NPU_HBM);
  let mut out_fused = transfer(out_fused_host, Memory::NPU_HBM);

  let mut temp_matmul = Tensor_f32(N, N);
  let mut temp_bias = Tensor_f32(N, N);
  let mut temp_matmul_npu = transfer(temp_matmul, Memory::NPU_HBM);
  let mut temp_bias_npu = transfer(temp_bias, Memory::NPU_HBM);

  unsafe {
    // Warmup Unfused immediately before benchmark
    spawn on(Topology::NPU[0]) {
      for i in 0..N {
        for j in 0..N {
          temp_matmul_npu[i][j] = 0.0;
          for k in 0..N {
            temp_matmul_npu[i][j] += a[i][k] * b[k][j];
          }
        }
      }
    }
    spawn on(Topology::NPU[0]) {
      for i in 0..N {
        for j in 0..N {
          temp_bias_npu[i][j] = temp_matmul_npu[i][j] + bias[i][j];
        }
      }
    }
    spawn on(Topology::NPU[0]) {
      for i in 0..N {
        for j in 0..N {
          let val = temp_bias_npu[i][j];
          if val > 0.0 {
            out_unfused[i][j] = val;
          } else {
            out_unfused[i][j] = 0.0;
          }
        }
      }
    }

    // Benchmark Unfused
    let t1 = vx_get_time();
    for _iter in 0..10 {
      spawn on(Topology::NPU[0]) {
        for i in 0..N {
          for j in 0..N {
            temp_matmul_npu[i][j] = 0.0;
            for k in 0..N {
              temp_matmul_npu[i][j] += a[i][k] * b[k][j];
            }
          }
        }
      }
      spawn on(Topology::NPU[0]) {
        for i in 0..N {
          for j in 0..N {
            temp_bias_npu[i][j] = temp_matmul_npu[i][j] + bias[i][j];
          }
        }
      }
      spawn on(Topology::NPU[0]) {
        for i in 0..N {
          for j in 0..N {
            let val = temp_bias_npu[i][j];
            if val > 0.0 {
              out_unfused[i][j] = val;
            } else {
              out_unfused[i][j] = 0.0;
            }
          }
        }
      }
    }
    let t2 = vx_get_time();
    let time_unfused = t2 - t1;

    // Warmup Fused immediately before benchmark
    spawn on(Topology::NPU[0]) {
      for i in 0..N {
        for j in 0..N {
          let mut sum = 0.0;
          for k in 0..N {
            sum += a[i][k] * b[k][j];
          }
          sum += bias[i][j];
          if sum > 0.0 {
            out_fused[i][j] = sum;
          } else {
            out_fused[i][j] = 0.0;
          }
        }
      }
    }

    // Benchmark Fused
    let t3 = vx_get_time();
    for _iter in 0..10 {
      spawn on(Topology::NPU[0]) {
        for i in 0..N {
          for j in 0..N {
            let mut sum = 0.0;
            for k in 0..N {
              sum += a[i][k] * b[k][j];
            }
            sum += bias[i][j];
            if sum > 0.0 {
              out_fused[i][j] = sum;
            } else {
              out_fused[i][j] = 0.0;
            }
          }
        }
      }
    }
    let t4 = vx_get_time();
    let time_fused = t4 - t3;

    print_f32(time_unfused);
    print_f32(time_fused);
    assert(time_fused <= time_unfused);
  }

  // Verification
  let out_unfused_res = transfer(out_unfused, Memory::Host_DRAM);
  let out_fused_res = transfer(out_fused, Memory::Host_DRAM);
  for i in 0..N {
    for j in 0..N {
      assert(out_unfused_res[i][j] == out_fused_res[i][j], "Mismatch between fused and unfused NPU results");
    }
  }

  return 0;
}

fn main() -> i32 {
  run_benchmark(128);
  run_benchmark(256);
  run_benchmark(512);
  run_benchmark(1024);
  run_benchmark(2048);
  return 0;
}
