// C = A @ B in bf16 with f32 sums, on the tensor cores. A block computes a 128 x 128 tile of C
// with 8 subgroups. Subgroup w computes the 64 x 32 tile at row 64 * (w / 4) and column
// 32 * (w % 4). K goes 32 at a time. A comes in as two 64 x 32 halves and B as four 32 x 32
// panels, so each subgroup multiplies one half of A by one panel of B.
// run.sh in this folder times it against cuBLAS. It sets M, N and K.
//
// vx-bench flags: --host default --machine fleet/a100-80.vx
const M : i32 = 4096;
const N : i32 = 4096;
const K : i32 = 4096;
const REPS : i32 = 50;

pub fn gemm(c : &mut Tensor<f32, [?, ?], Memory::HBM>, a : &Tensor<bf16, [?, ?], Memory::HBM>, b : &Tensor<bf16, [?, ?], Memory::HBM>, mt : i32, nt : i32, k : i32) -> void {
  spawn on(Topology::Device) {
    for blk in 0..mt * nt across blocks {
      let bm = blk / nt;
      let bn = blk % nt;
      for _once in 0..1 {
        let mut sa = unsafe {
          Tensor<bf16, [2, 64, 32], Memory::SMEM>::uninit()
        };
        let mut sb = unsafe {
          Tensor<bf16, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [8, 64, 32], Memory::SMEM>::uninit()
        };
        for w in 0..8 across subgroups {
          lanes::fill(&mut acc[w], 0.0);
        }
        for kt in 0..k / 32 {
          let a0 = lanes::copy_async(&mut sa[0], a, [bm * 128, kt * 32]);
          let a1 = lanes::copy_async(&mut sa[1], a, [bm * 128 + 64, kt * 32]);
          let b0 = lanes::copy_async(&mut sb[0], b, [kt * 32, bn * 128]);
          let b1 = lanes::copy_async(&mut sb[1], b, [kt * 32, bn * 128 + 32]);
          let b2 = lanes::copy_async(&mut sb[2], b, [kt * 32, bn * 128 + 64]);
          let b3 = lanes::copy_async(&mut sb[3], b, [kt * 32, bn * 128 + 96]);
          a0.wait();
          a1.wait();
          b0.wait();
          b1.wait();
          b2.wait();
          b3.wait();
          for w in 0..8 across subgroups {
            acc[w] = acc[w] + (sa[w / 4] as f32) @ (sb[w % 4] as f32);
          }
        }
        for w in 0..8 across subgroups {
          lanes::copy(c, &acc[w], [bm * 128 + (w / 4) * 64, bn * 128 + (w % 4) * 32]);
        }
      }
    }
  }
  return;
}


// Inputs are small integers, so every sum is exact in f32 and the check can compare bits.
fn main() -> i32 {
  let mut ha = Tensor<bf16, [M, K]>::fill(0.0);
  for i in 0..M {
    for k in 0..K {
      ha[i][k] = ((i * 3 + k * 5) % 7 - 3) as bf16;
    }
  }
  let mut hb = Tensor<bf16, [K, N]>::fill(0.0);
  for k in 0..K {
    for j in 0..N {
      hb[k][j] = ((k * 2 + j) % 5 - 2) as bf16;
    }
  }
  let a = transfer(ha, Memory::HBM);
  let b = transfer(hb, Memory::HBM);
  let mut c = transfer(Tensor<f32, [M, N]>::fill(0.0), Memory::HBM);
  for _rep in 0..REPS {
    gemm(&mut c, &a, &b, M / 128, N / 128, K);
  }
  let hc = transfer(c, Memory::CPU_DRAM);
  let ra = transfer(a, Memory::CPU_DRAM);
  let rb = transfer(b, Memory::CPU_DRAM);
  let mut wrong = 0;
  for s in 0..64 {
    let i = (s * 7919) % M;
    let j = (s * 104729) % N;
    let mut want : f32 = 0.0;
    for k in 0..K {
      want = want + (ra[i][k] as f32) * (rb[k][j] as f32);
    }
    let got = hc[i][j];
    if got != want {
      wrong = wrong + 1;
    }
  }
  println!("gemm {}x{}x{}: {} of 64 samples wrong", M, N, K, wrong);
  return 0;
}
