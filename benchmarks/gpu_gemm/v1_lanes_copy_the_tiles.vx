// C = A @ B in bf16 with f32 sums, on the tensor cores. A block computes a 64 x 64 tile of C,
// and each of its 4 subgroups a 16 x 64 strip. K goes 32 at a time. C is the row-major [m, n]
// matrix seen as [m / 64][4][16][n / 64][2][32], so that each loop variable is one index. The
// lanes copy the tiles of A and B into shared memory one element at a time.
// run.sh in this folder times it against cuBLAS. It sets M, N and K.
//
// vx-bench flags: --host default --machine fleet/a100-80.vx
const M : i32 = 4096;
const N : i32 = 4096;
const K : i32 = 4096;
const REPS : i32 = 50;

pub fn gemm(c : &mut Tensor<f32, [?, 4, 16, ?, 2, 32], Memory::HBM>, a : &Tensor<bf16, [?, ?], Memory::HBM>, b : &Tensor<bf16, [?, ?], Memory::HBM>, mt : i32, nt : i32, k : i32) -> void {
  spawn on(Topology::Device) {
    for bm in 0..mt across blocks {
      for bn in 0..nt across blocks {
        let mut sa = unsafe {
          Tensor<bf16, [4, 16, 32], Memory::SMEM>::uninit()
        };
        let mut sb = unsafe { Tensor<bf16, [32, 64], Memory::SMEM>::uninit() };
        let mut acc = unsafe {
          Tensor<f32, [4, 16, 64], Memory::SMEM>::uninit()
        };
        for w in 0..4 across subgroups {
          for j in 0..32 across lanes {
            for i in 0..16 {
              acc[w][i][j] = 0.0;
              acc[w][i][j + 32] = 0.0;
            }
          }
        }
        for kt in 0..k / 32 {
          for j in 0..64 across lanes {
            for r in 0..32 {
              sb[r][j] = b[kt * 32 + r][bn * 64 + j];
            }
          }
          for w in 0..4 across subgroups {
            for kk in 0..32 across lanes {
              for i in 0..16 {
                sa[w][i][kk] = a[bm * 64 + w * 16 + i][kt * 32 + kk];
              }
            }
            acc[w] = acc[w] + (sa[w] as f32) @ (sb as f32);
          }
        }
        for w in 0..4 across subgroups {
          for j in 0..32 across lanes {
            for i in 0..16 {
              c[bm][w][i][bn][0][j] = acc[w][i][j];
              c[bm][w][i][bn][1][j] = acc[w][i][j + 32];
            }
          }
        }
      }
    }
  }
  return;
}


// Inputs are small integers, so every sum is exact in f32 and the check can compare bits.
fn main() -> i32 {
  let mut ha = Tensor<bf16, [M, K]>::fill(0.0);
  for i in 0..M {
    for k in 0..K {
      ha[i][k] = ((i * 3 + k * 5) % 7 - 3) as bf16;
    }
  }
  let mut hb = Tensor<bf16, [K, N]>::fill(0.0);
  for k in 0..K {
    for j in 0..N {
      hb[k][j] = ((k * 2 + j) % 5 - 2) as bf16;
    }
  }
  let a = transfer(ha, Memory::HBM);
  let b = transfer(hb, Memory::HBM);
  let mut c = transfer(Tensor<f32, [M / 64, 4, 16, N / 64, 2, 32]>::fill(0.0), Memory::HBM);
  for _rep in 0..REPS {
    gemm(&mut c, &a, &b, M / 64, N / 64, K);
  }
  let hc = transfer(c, Memory::CPU_DRAM);
  let ra = transfer(a, Memory::CPU_DRAM);
  let rb = transfer(b, Memory::CPU_DRAM);
  let mut wrong = 0;
  for s in 0..64 {
    let i = (s * 7919) % M;
    let j = (s * 104729) % N;
    let mut want : f32 = 0.0;
    for k in 0..K {
      want = want + (ra[i][k] as f32) * (rb[k][j] as f32);
    }
    let got = hc[i / 64][(i % 64) / 16][i % 16][j / 64][(j % 64) / 32][j % 32];
    if got != want {
      wrong = wrong + 1;
    }
  }
  println!("gemm {}x{}x{}: {} of 64 samples wrong", M, N, K, wrong);
  return 0;
}
