import std::time;
import std::vec;
extern "C" {
  fn vx_advance_ptr_f32(base : *mut f32, offset : i32) -> *mut f32;
}

fn main() -> i32 {
  unsafe {
    let N : i32 = 1000000;
    let p1 : *mut f32 = Vec<f32>::with_capacity(N).data;
    let p2 : *mut f32 = Vec<f32>::with_capacity(N).data;
    let p3 : *mut f32 = Vec<f32>::with_capacity(N).data;

    let start : f32 = now();

    let mut i : i32 = 0;
    for
    j in 0..N {
      let ptr1 : *mut f32 = vx_advance_ptr_f32(p1, j);
      let ptr2 : *mut f32 = vx_advance_ptr_f32(p2, j);
      let ptr3 : *mut f32 = vx_advance_ptr_f32(p3, j);

      let v1 : f32 = *ptr1;
      let v2 : f32 = *ptr2;
      let v3 : f32 = v1 + v2;
      *ptr3 = v3;
    }

    let end : f32 = now();
    let elapsed : f32 = end - start;
    println !("{}", elapsed);
  }
  return 0;
}
