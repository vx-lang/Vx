import std::time;
import std::vec;
import core::ptr;

fn main() -> i32 {
  unsafe {
    let N : i32 = 1000000;
    let p1 : *mut f32 = Vec<f32>::with_capacity(N).leak();
    let p2 : *mut f32 = Vec<f32>::with_capacity(N).leak();
    let p3 : *mut f32 = Vec<f32>::with_capacity(N).leak();

    let start : f32 = now();

    let mut i : i32 = 0;
    for j in 0..N {
      let ptr1 : *mut f32 = add_mut(p1, j as usize);
      let ptr2 : *mut f32 = add_mut(p2, j as usize);
      let ptr3 : *mut f32 = add_mut(p3, j as usize);

      let v1 : f32 = *ptr1;
      let v2 : f32 = *ptr2;
      let v3 : f32 = v1 + v2;
      *ptr3 = v3;
    }

    let end : f32 = now();
    let elapsed : f32 = end - start;
    bench_report("scalar_axpy_1m", "seconds", elapsed);
  }
  return 0;
}
