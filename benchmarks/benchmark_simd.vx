import std::time;
import std::vec;
extern "C" {
  fn vx_advance_ptr_f32(base : *mut f32, offset : i32) -> *mut f32;

  fn vx_simd_reduce_add(v : <4 x f32>)->f32;
}

fn main() -> i32 {
  unsafe {
    let N : i32 = 1000000;
    let p1 : *mut f32 = Vec<f32>::with_capacity(N).data;
    let p2 : *mut f32 = Vec<f32>::with_capacity(N).data;
    let p3 : *mut f32 = Vec<f32>::with_capacity(N).data;

    let start : f32 = now();

    let mut i : i32 = 0;
    let n_div_4 : i32 = N / 4;
    for
    j in 0..n_div_4 {
      let j4 : i32 = j * 4;
      let ptr1 : *mut f32 = vx_advance_ptr_f32(p1, j4);
      let ptr2 : *mut f32 = vx_advance_ptr_f32(p2, j4);
      let ptr3 : *mut f32 = vx_advance_ptr_f32(p3, j4);

      let v1 : <4 x f32> = *ptr1;
      let v2 : <4 x f32> = *ptr2;
      let v3 : <4 x f32> = v1 + v2;
      *ptr3 = v3;
    }

    let end : f32 = now();
    let elapsed : f32 = end - start;
    println !("{}", elapsed);
  }
  return 0;
}
