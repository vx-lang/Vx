// EXPECT: Unranked Memref base@ =
// EXPECT: rank = 2 offset = 0 sizes = [4, 4] strides = [4, 1] data =
// EXPECT: [[24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24],
// EXPECT:  [24,   24,   24,   24]]

fn custom_matmul(a : Ref<Tensor<f32, [ 4, 4 ]>, Memory::NPU_HBM>,
                 b : Ref<Tensor<f32, [ 4, 4 ]>, Memory::NPU_HBM>)
    -> Verified<Ref<Tensor<f32, [ 4, 4 ]>, Memory::NPU_HBM>> {
  let mut result = Tensor<f32>([ 4, 4 ]).with_memory(Memory::NPU_HBM);
  spawn on(Topology::NPU[0]) {
    for
      i in 0..4 {
      for
        j in 0..4 {
          result[i][j] = 0.0;
        for
          k in 0..4 { result[i][j] = result[i][j] + a[i][k] * b[k][j]; }
        }
      }
  }
  return Verified(result);
}

fn main() -> i32 {
  let mut a = Tensor<f32>([ 4, 4 ]).with_memory(Memory::NPU_HBM);
  let mut b = Tensor<f32>([ 4, 4 ]).with_memory(Memory::NPU_HBM);

  for
    i in 0..4 {
    for
      j in 0..4 {
        a[i][j] = 2.0;
        b[i][j] = 3.0;
      }
    }

  let result = custom_matmul(a, b);
  return 0;
}
