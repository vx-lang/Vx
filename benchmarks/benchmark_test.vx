// RUN: vxc %s | mlir-opt --convert-scf-to-cf --expand-strided-metadata
// --lower-affine --finalize-memref-to-llvm --convert-func-to-llvm
// --convert-cf-to-llvm --convert-arith-to-llvm --reconcile-unrealized-casts |
// mlir-translate --mlir-to-llvmir | lli --load=./libvx_rt.dylib RUN: %t |
// FileCheck %s

// The four symbols live in stdlib/rust_core/src/ffi/rt.rs. Three of them return
// nothing and the fourth returns a plain f32; this file used to declare all four
// as returning a rank-0 tensor, which is a different ABI on every one of them.
extern "C" {
  fn start_benchmark() -> f32;
  fn end_benchmark() -> void;
  fn trace_start() -> void;
  fn trace_end() -> void;
}

fn main() -> i32 {
  unsafe {
    trace_start();
    let _elapsed : f32 = start_benchmark();
    end_benchmark();
    trace_end();
  }

  return 0;
}

// CHECK: [TRACE START] Event ID: 100
// CHECK: [TRACE END] Event ID: 100
