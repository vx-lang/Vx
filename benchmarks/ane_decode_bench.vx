extern {
  fn vx_get_time() -> f32;
  fn vx_sqrtf(v: f32) -> f32;
  fn vx_expf(v: f32) -> f32;
  fn vx_sinf(v: f32) -> f32;
  fn vx_cosf(v: f32) -> f32;
  fn vx_get_rope_freq(pos: i32, i: i32, d: i32) -> f32;
}

fn benchmark_attention_proj() -> i32 {
  // Q, K, V, O projections (1x288 * 288x288)
  let mut x_host = Tensor<f32>([1, 288]);
  let mut w_host = Tensor<f32>([288, 288]);
  let mut out_cpu_host = Tensor<f32>([1, 288]);
  let mut out_ane_host = Tensor<f32>([1, 288]);

  for i in 0..1 {
    for j in 0..288 {
      x_host[i][j] = 0.5;
      out_cpu_host[i][j] = 0.0;
      out_ane_host[i][j] = 0.0;
    }
  }
  for i in 0..288 {
    for j in 0..288 {
      w_host[i][j] = 0.1;
    }
  }

  let x = transfer(x_host, Memory::NPU_HBM);
  let w = transfer(w_host, Memory::NPU_HBM);
  let mut out_ane = transfer(out_ane_host, Memory::NPU_HBM);

  unsafe {
    let t_cpu_start = vx_get_time();
    for _iter in 0..1000 {
      for i in 0..1 {
        for j in 0..288 {
          let mut sum = 0.0;
          for k in 0..288 {
            sum += x_host[i][k] * w_host[k][j];
          }
          out_cpu_host[i][j] = sum;
        }
      }
    }
    let t_cpu_end = vx_get_time();
    print !(t_cpu_end - t_cpu_start);
  }

  unsafe {
    spawn on(Topology::NPU[0]) {
      for i in 0..1 {
        for j in 0..288 {
          let mut sum = 0.0;
          for k in 0..288 {
            sum += x[i][k] * w[k][j];
          }
          out_ane[i][j] = sum;
        }
      }
    }
    let t_ane_start = vx_get_time();
    for _iter in 0..1000 {
      spawn on(Topology::NPU[0]) {
        for i in 0..1 {
          for j in 0..288 {
            let mut sum = 0.0;
            for k in 0..288 {
              sum += x[i][k] * w[k][j];
            }
            out_ane[i][j] = sum;
          }
        }
      }
    }
    let t_ane_end = vx_get_time();
    print !(t_ane_end - t_ane_start);
    
    let out_ane_res = transfer(out_ane, Memory::CPU_DRAM);
    for i in 0..1 {
      for j in 0..288 {
        let diff = out_cpu_host[i][j] - out_ane_res[i][j];
        assert(diff * diff < 0.001, "Mismatch QKV");
      }
    }
    assert(out_cpu_host[0][0] != -9999.0, "Prevent DCE");
  }
  return 0;
}

