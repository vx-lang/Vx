//===----------------------------------------------------------------------===//
// Message passing between two blocks: litmus test message_passing_relaxed_flag, with the
// writer in block 0 and the reader in block 1. `go` starts each round in both blocks at about the
// same time. The model allows the reader to read 0: this is the control.
import core::sync::atomic;

fn main() -> i32 {
  let n = 100000;
  let data = transfer(Tensor<i32, [100000]>::fill(0), Memory::HBM);
  let flag = transfer(Tensor<i32, [100000]>::fill(0), Memory::HBM);
  let go = transfer(Tensor<i32, [2]>::fill(0), Memory::HBM);
  let mut seen = transfer(Tensor<i32, [200000]>::fill(-1), Memory::HBM);
  spawn on(Topology::Device) {
    for b in 0..2 across blocks {
      for l in 0..1 across lanes {
        for k in 0..100000 {
          // Both blocks arrive at round k before either one starts it.
          let _a = atomic_fetch_add_i32(&go, b, 1, AtomicOrdering::Relaxed);
          loop {
            if atomic_load_i32(&go, 1 - b, AtomicOrdering::Relaxed) > k {
              break;
            }
          }
          if b == 0 {
            atomic_store_i32(&data, k, 1, AtomicOrdering::Relaxed);
            atomic_store_i32(&flag, k, 1, AtomicOrdering::Relaxed);
          } else {
            loop {
              if atomic_load_i32(&flag, k, AtomicOrdering::Relaxed) == 1 {
                break;
              }
            }
            seen[b * 100000 + k + l] = atomic_load_i32(&data, k, AtomicOrdering::Relaxed);
          }
        }
      }
    }
  }
  let s = transfer(seen, Memory::CPU_DRAM);
  let mut zeros = 0;
  for k in 0..n {
    if s[100000 + k] == 0 {
      zeros = zeros + 1;
    }
  }
  println!("mp_relaxed_blocks: {} of {} reads saw 0", zeros, n);
  return 0;
}
