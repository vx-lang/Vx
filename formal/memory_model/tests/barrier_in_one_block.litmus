LISA barrier_in_one_block
(* A barrier of block scope orders the lanes of one block (C5). The lane that reads after the
   barrier sees the write from before it.
   Expect: never, no data race. *)
{ x = 0; }
 P0                  | P1                   ;
 w[plain] x 1        | f[barrier,block]     ;
 f[barrier,block]    | r[plain] r0 x        ;
scopes: (device (block P0 P1))
exists (1:r0 = 0)
