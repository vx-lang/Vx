LISA fork_publishes_to_the_part
(* A fork is a sequence point (C2). The host writes x before it starts the part, so the part
   reads the new x. P1 is the part, and the release and acquire of go are the fork.
   Expect: never, no data race. *)
{ x = 0; go = 0; }
 P0                  | P1                   ;
 w[plain] x 1        | r[acq] r0 go         ;
 w[rel] go 1         | r[plain] r1 x        ;
scopes: (system P0 P1)
filter (1:r0 = 1)
exists (1:r1 = 0)
