LISA atomic_of_device_scope_across_blocks
(* An atomic of device scope synchronizes lanes of two blocks on one device (C7).
   Expect: never, no data race. *)
{ data = 0; flag = 0; }
 P0                     | P1                     ;
 w[plain] data 1        | r[acq,device] r0 flag  ;
 w[rel,device] flag 1   | r[plain] r1 data       ;
scopes: (device (block P0) (block P1))
filter (1:r0 = 1)
exists (1:r1 = 0)
