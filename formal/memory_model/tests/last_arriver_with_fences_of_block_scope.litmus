LISA last_arriver_with_fences_of_block_scope
(* As last_arriver_of_device_scope.litmus, but the fences have block scope. A fence of block
   scope does not reach another block, so block 1 reads the partial with a data race.
   Expect: sometimes, a data race. *)
{ count = 0; part0 = 0; part1 = 0; }
 P0                                  | P1                                  ;
 w[plain] part0 1                    | w[plain] part1 1                    ;
 f[rel,block]                        | f[rel,block]                        ;
 rmw[rlx,device] r0 (add r0 1) count | rmw[rlx,device] r0 (add r0 1) count ;
                                     | f[acq,block]                        ;
                                     | r[plain] r1 part0                   ;
scopes: (device (block P0) (block P1))
filter (1:r0 = 1)
exists (1:r1 = 0)
