// CHECK:     %0 = builtin.unrealized_conversion_cast to memref<?x?xf32>
// CHECK:     return %0 : memref<?x?xf32>
// CHECK:   }
// CHECK:   func.func @matmul_ScalarBF16_Genericm_Genericn_Generick(%arg0: memref<?x?xbf16>, %arg1: memref<?x?xbf16>) -> memref<?x?xbf16> {
// CHECK:     %0 = builtin.unrealized_conversion_cast to memref<?x?xbf16>
