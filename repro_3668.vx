//===----------------------------------------------------------------------===//
// Repro for https://github.com/vx-lang/Vx/issues/3668: each lane writes four adjacent bf16
// elements of a row. When the row pitch is a run-time value (`Tensor<bf16, [?, ?]>`), LLVM
// cannot prove the four stores are aligned, so it keeps four narrow `st.global.b16`. With a
// compile-time pitch of 4 (`Tensor<bf16, [?, 4]>`), it merges them into `st.global.v2.b32`.
// The comparison shows the missing store widening.
//
// RUN: env CUDA_VISIBLE_DEVICES= vxc %s --host default --machine fleet/h100-sxm.vx --emit-ptx -o %t.ptx
// RUN: FileCheck %s < %t.ptx
//
// CHECK-LABEL: .entry write_rows_dynamic_pitch(
// CHECK-NOT:   st.global.v2.b32
// CHECK-DAG:   st.global.b16
// CHECK-DAG:   st.global.b16
// CHECK-DAG:   st.global.b16
// CHECK-DAG:   st.global.b16
// CHECK-LABEL: .entry write_rows_static_pitch(
// CHECK:       st.global.v2.b32

fn write_rows_dynamic_pitch(out : &mut Tensor<bf16, [?, ?], Memory::HBM>, tiles : &DisjointRanges<Tensor<i32, [?, 2], Memory::HBM>>, n : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for r in 0..4 across lanes(32) {
        let row = (tiles[t][0] as i64) + (r as i64);
        if row < (tiles[t][1] as i64) {
          let v = (10 * t + r) as f32;
          out[row][0] = v as bf16;
          out[row][1] = (v + 1.0) as bf16;
          out[row][2] = (v + 2.0) as bf16;
          out[row][3] = (v + 3.0) as bf16;
        }
      }
    }
  }
  return;
}

fn write_rows_static_pitch(out : &mut Tensor<bf16, [?, 4], Memory::HBM>, tiles : &DisjointRanges<Tensor<i32, [?, 2], Memory::HBM>>, n : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for r in 0..4 across lanes(32) {
        let row = (tiles[t][0] as i64) + (r as i64);
        if row < (tiles[t][1] as i64) {
          let v = (10 * t + r) as f32;
          out[row][0] = v as bf16;
          out[row][1] = (v + 1.0) as bf16;
          out[row][2] = (v + 2.0) as bf16;
          out[row][3] = (v + 3.0) as bf16;
        }
      }
    }
  }
  return;
}
