//===----------------------------------------------------------------------===//
// One tile larger than the device it is staged into.
//
// 262144 x 131072 f32 = 137438953472 bytes = 128 GiB, against the 80 GiB that
// `fleet/a100-80.vx` declares. The bound comes from that cited model rather than
// from a number chosen to match whichever card was rented -- if the two
// boundaries agreed because someone typed them to agree, the pair would
// establish nothing.
//
// This file is the Vx half of a differential pair; see utils/differential/.
//
// RUN: not vxc --host default --machine fleet/a100-80.vx %s --action emit-mlir -o /dev/null 2>&1 | FileCheck %s
// CHECK: E6009
// CHECK-SAME: 'HBM' has capacity 85899345920 bytes

fn main() -> i32 {
  // 262144 x 131072 f32 = 137438953472 bytes = 128 GiB, against an 80 GiB device.
  let weights : Tensor<f32, [ 262144, 131072 ]> = Tensor<f32, [ 262144, 131072 ]>::uninit();
  let _staged = transfer(weights, Memory::HBM);
  return 0;
}
