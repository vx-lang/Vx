//===----------------------------------------------------------------------===//
// Generates tokens with greedy decoding, on the GPU:
//
//   vxc apps/qwen/src/main.vx --package qwen=apps/qwen/src --host default \
//       --machine fleet/m4-uma.vx -- WEIGHTS --tokens 750,75698,1445 --steps 16
//
// It prints the lines that `apps/qwen/scripts/reference.py` prints, without the margin, and
// then the time of a token. `apps/qwen/scripts/compare.py` compares the two outputs.
import core::convert;
import std::time;
import std::vec;
import qwen::weights;
import qwen::model;

/// One token of the prompt, in GPU memory. The struct is there because the flat code generator
/// declines a reference to an element of a `Vec` of tensors, and accepts one to a field.
struct PromptToken {
  t : Tensor<i32, [?], Memory::HBM>,
}

/// The comma-separated numbers of `text`. Asserts that it has only digits and commas, and no empty
/// number.
fn parse_numbers(text : *const i8) -> Vec<i32> {
  let mut numbers = Vec<i32>::new();
  let mut value : i32 = 0;
  let mut digits = 0;
  let mut empty = false;
  let mut i : i64 = 0;
  let mut ch = i32::from(unsafe { text[0] });
  while ch != 0 {
    if ch == 44 {
      empty = empty || digits == 0;
      numbers.push(value);
      value = 0;
      digits = 0;
    } else {
      assert(ch >= 48 && ch <= 57, "a list of numbers can have only digits and commas");
      value = value * 10 + (ch - 48);
      digits = digits + 1;
    }
    i = i + 1;
    ch = i32::from(unsafe { text[i] });
  }
  assert(!empty && digits > 0, "an empty number in a comma-separated list");
  numbers.push(value);
  return numbers;
}

/// The token in `t`. Reading it waits for the GPU to finish the work before it.
fn read_token(t : &Tensor<i32, [?], Memory::HBM>) -> i32 {
  let h = transfer(t, Memory::CPU_DRAM);
  return h[0];
}

/// The logit `token` of `logits`.
fn read_logit(logits : &Tensor<f32, [?], Memory::HBM>, token : i32) -> f32 {
  let h = transfer(logits, Memory::CPU_DRAM);
  return h[token];
}

/// Whether the C string `a` is `b`.
fn same(a : *const i8, b : *const i8) -> bool {
  return unsafe { strcmp(a, b) } == 0;
}

fn main(argc : i32, argv : *mut *mut i8) -> i32 {
  assert(argc == 6, "give: WEIGHTS --tokens 1,2,3 --steps N");
  assert(same(unsafe { argv[2] }, "--tokens") && same(unsafe { argv[4] }, "--steps"), "give: WEIGHTS --tokens 1,2,3 --steps N");
  let prompt = parse_numbers(unsafe { argv[3] });
  let steps_list = parse_numbers(unsafe { argv[5] });
  let steps = steps_list[0];
  let count = prompt.len();
  assert(steps > 0, "--steps must be at least 1");

  let w = load_weights(unsafe { argv[1] });
  let mut s = new_state(&w.config, count + steps);
  // One tensor for each token of the prompt, made before the first token runs.
  let mut prompt_tokens = Vec<PromptToken>::new();
  for i in 0..count {
    assert(prompt[i] < w.config.vocab_size, "a token of the prompt is not in the vocabulary");
    let mut h = Tensor<i32>([1]);
    h[0] = prompt[i];
    prompt_tokens.push(PromptToken {
      t: transfer(h, Memory::HBM)
    });
  }
  let mut next = transfer(Tensor<i32>([1]), Memory::HBM);

  print!("prompt=");
  for i in 0..count {
    if i > 0 {
      print!(",");
    }
    print!("{}", prompt[i]);
  }
  println!(";");

  for i in 0..count {
    run_layers(&w, &mut s, &prompt_tokens[i].t, i);
  }
  predict(&w, &mut s, &mut next);
  // The first token waits for the whole prompt, so the clock starts after it, and the time
  // covers only the steps - 1 tokens that the loop decodes.
  let mut token = read_token(&next);
  let start = Instant::now();
  for step in 0..steps {
    println!("step={} token={} logit={};", step, token, read_logit(&s.logits, token));
    if step + 1 < steps {
      run_layers(&w, &mut s, &next, count + step);
      predict(&w, &mut s, &mut next);
      token = read_token(&next);
    }
  }
  if steps > 1 {
    let ms = f64::from(start.elapsed().as_secs_f32()) * 1000.0 / f64::from(steps - 1);
    println!("time ms_per_token={};", ms);
  }
  return 0;
}
