// MOE-Q4-NEXT: {{^}}lm_head count=65536 codes=249,250,241,235 sum=11707896;{{$}}
// MOE-Q4-NEXT: {{^}}lm_head.scale count=4 codes=963266853,963266853,963266853,963266853 sum=3853067412;{{$}}

import qwen::weights;
import core::num;
import core::convert;

/// The 16 bits of a bf16 value.
fn code(v : bf16) -> u32 {
  return (v as f32).to_bits() >> 16;
}

/// Prints `name count=N codes=a,b,c,d sum=S;`, with the first `shown` codes of `first`.
fn print_line(name : *const i8, layer : i32, count : i64, first : &Tensor<u32, [?]>, shown : i32, sum : u64) -> void {
  if layer >= 0 {
    print!("layers.{}.", layer);
  }
  print!("{} count={} codes=", name, count);
  for i in 0..shown {
    if i > 0 {
      print!(",");
    }
    print!("{}", first[i]);
  }
  println!(" sum={};", sum);
  return;
}

/// The line of a tensor of bf16 values in GPU memory. A code is the 16 bits of a value.
fn report(name : *const i8, layer : i32, t : &Tensor<bf16, [?], Memory::HBM>) -> void {
  let h = transfer(t, Memory::CPU_DRAM);
  let n = h.len();
  let mut first = Tensor<u32>([4]);
  let mut sum : u64 = 0;
  for i in 0..n {
    if i < 4 {
      first[i] = code(h[i]);
    }
    sum = sum + u64::from(code(h[i]));
  }
  print_line(name, layer, i64::from(n), &first, i32::min(n, 4), sum);
  return;
}

/// The line of a matrix of codes in GPU memory: 4 f8e4m3 codes, or 8 Q4_0 codes, in each u32
/// word. A code here is one byte of the word.
fn report_codes(name : *const i8, layer : i32, t : &Tensor<u32, [?], Memory::HBM>) -> void {
  let h = transfer(t, Memory::CPU_DRAM);
  let n = h.len();
  let mut first = Tensor<u32>([4]);
  for k in 0..4 {
    first[k] = (h[0] >> ((8 * k) as u32)) & 255u32;
  }
  let mut sum : u64 = 0;
  for i in 0..n {
    let w = h[i];
    sum = sum + u64::from((w & 255u32) + ((w >> 8u32) & 255u32) + ((w >> 16u32) & 255u32) + (w >> 24u32));
  }
  print_line(name, layer, 4 * i64::from(n), &first, 4, sum);
  return;
}

/// The line of a tensor of f32 scales in GPU memory. A code is the 32 bits of a value.
fn report_scales(name : *const i8, layer : i32, t : &Tensor<f32, [?], Memory::HBM>) -> void {
  let h = transfer(t, Memory::CPU_DRAM);
  let n = h.len();
  let mut first = Tensor<u32>([4]);
  let mut sum : u64 = 0;
  for i in 0..n {
    if i < 4 {
      first[i] = h[i].to_bits();
    }
    sum = sum + u64::from(h[i].to_bits());
  }
  print_line(name, layer, i64::from(n), &first, i32::min(n, 4), sum);
  return;
}

/// The line of a tensor of f16 scales in GPU memory. A code is the 16 bits of a value.
fn report_f16(name : *const i8, layer : i32, t : &Tensor<f16, [?], Memory::HBM>) -> void {
  let h = transfer(t, Memory::CPU_DRAM);
  let n = h.len();
  // A plain host tensor, whose memory a pointer can read as u16 bits.
  let mut plain = Tensor<f16>([n]);
  for i in 0..n {
    plain[i] = h[i];
  }
  let raw : *mut i8 = plain.as_mut_ptr();
  let bits : *mut u16 = raw;
  let mut first = Tensor<u32>([4]);
  let mut sum : u64 = 0;
  for i in 0..n {
    let code = u32::from(unsafe { bits[i] });
    if i < 4 {
      first[i] = code;
    }
    sum = sum + u64::from(code);
  }
  print_line(name, layer, i64::from(n), &first, i32::min(n, 4), sum);
  return;
}

/// The lines of a weight matrix: its bf16 values, or its codes and then its scales.
fn report_matrix(name : *const i8, scale_name : *const i8, layer : i32, m : &WeightMatrix) -> void {
  if m.dtype == U4 {
    report_codes(name, layer, &m.codes);
    report_f16(scale_name, layer, &m.group_scales);
  } else if m.dtype == F8E4M3 {
    report_codes(name, layer, &m.codes);
    report_scales(scale_name, layer, &m.scales);
  } else {
    report(name, layer, &m.bf16);
  }
  return;
}

fn main(argc : i32, argv : *mut *mut i8) -> i32 {
  assert(argc == 2, "give the weight file as the only argument");
  let w = load_weights(unsafe { argv[1] });
  let c = &w.config;
  println!("config hidden={} layers={} vocab={};", c.hidden_size, c.num_layers, c.vocab_size);
  report("embed", -1, &w.embed);
  for l in 0..c.num_layers {
    let layer = &w.layers[l];
    report("attn_norm", l, &layer.attn_norm);
    report_matrix("qkv", "qkv.scale", l, &layer.qkv);
    if c.qkv_bias {
      report("qkv_bias", l, &layer.qkv_bias);
    }
    if c.qk_norm {
      report("q_norm", l, &layer.q_norm);
      report("k_norm", l, &layer.k_norm);
    }
    report_matrix("attn_out", "attn_out.scale", l, &layer.attn_out);
    report("mlp_norm", l, &layer.mlp_norm);
    if c.num_experts > 0 {
      report("router", l, &layer.router);
      report_matrix("experts_gate_up", "experts_gate_up.scale", l, &layer.gate_up);
      report_matrix("experts_down", "experts_down.scale", l, &layer.down);
    } else {
      report_matrix("gate_up", "gate_up.scale", l, &layer.gate_up);
      report_matrix("down", "down.scale", l, &layer.down);
    }
  }
  report("final_norm", -1, &w.final_norm);
  if !c.tied_embeddings {
    report_matrix("lm_head", "lm_head.scale", -1, &w.lm_head);
  }
  return 0;
}
