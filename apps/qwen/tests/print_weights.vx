// Loads a weight file into GPU memory, copies each tensor back, and prints its first codes and
// the sum of all its codes. A code is the bits of one value: 16 for bf16 and f16, 8 for an
// f8e4m3 code, and 32 for an f32 scale. For Q4_0 codes, it is a byte that holds two of them.
// `reference.py --tensors` prints the same lines from the file, so equal lines mean that each
// tensor reached GPU memory whole and in the right place. The second pair of RUN lines does the
// same for the fp8 file of the tiny model, and the third pair for the Q4_0 file of the tiny
// mixture-of-experts model.
//
// RUN: python3 %S/../scripts/make_tiny_model.py %t.vxw > /dev/null
// RUN: vxc %s --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t.vxw | FileCheck %s
// RUN: python3 %S/../scripts/make_tiny_model.py --fp8 %t-fp8.vxw > /dev/null
// RUN: vxc %s --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t-fp8.vxw | FileCheck %s --check-prefix=FP8
// RUN: python3 %S/../scripts/make_tiny_model.py --moe --q4 %t-moe-q4.vxw > /dev/null
// RUN: vxc %s --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t-moe-q4.vxw | FileCheck %s --check-prefix=MOE-Q4
