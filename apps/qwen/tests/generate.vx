// Generates 16 tokens of the tiny model on the GPU with `src/main.vx`, and compares them with
// `reference.py`. The tokens must be equal, and each logit within 0.001 of the reference. The
// other groups of RUN lines do the same for other files, each with its own check prefix:
// - the fp8 file of the tiny model, which runs the fp8 kernels of `std::nn`
// - its Q4_0 file, which runs the Q4_0 kernels, and the fp8 kernel for lm_head
// - the tiny mixture-of-experts model, whose router chooses 2 of 8 experts for each token
// - the Q4_0 file of that model
//
// RUN: python3 %S/../scripts/make_tiny_model.py %t.vxw > /dev/null
// RUN: python3 %S/../scripts/reference.py %t.vxw --tokens 1,2,3,4 --steps 16 > %t.reference
// RUN: vxc %S/../src/main.vx --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t.vxw --tokens 1,2,3,4 --steps 16 > %t.vx
// RUN: python3 %S/../scripts/compare.py %t.reference %t.vx --tolerance 0.001 | FileCheck %s
// RUN: python3 %S/../scripts/make_tiny_model.py --fp8 %t-fp8.vxw > /dev/null
// RUN: python3 %S/../scripts/reference.py %t-fp8.vxw --tokens 1,2,3,4 --steps 16 > %t-fp8.reference
// RUN: vxc %S/../src/main.vx --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t-fp8.vxw --tokens 1,2,3,4 --steps 16 > %t-fp8.vx
// RUN: python3 %S/../scripts/compare.py %t-fp8.reference %t-fp8.vx --tolerance 0.001 | FileCheck %s --check-prefix=FP8
// RUN: python3 %S/../scripts/make_tiny_model.py --q4 %t-q4.vxw > /dev/null
// RUN: python3 %S/../scripts/reference.py %t-q4.vxw --tokens 1,2,3,4 --steps 16 > %t-q4.reference
// RUN: vxc %S/../src/main.vx --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t-q4.vxw --tokens 1,2,3,4 --steps 16 > %t-q4.vx
// RUN: python3 %S/../scripts/compare.py %t-q4.reference %t-q4.vx --tolerance 0.001 | FileCheck %s --check-prefix=Q4
// RUN: python3 %S/../scripts/make_tiny_model.py --moe %t-moe.vxw > /dev/null
// RUN: python3 %S/../scripts/reference.py %t-moe.vxw --tokens 1,2,3,4 --steps 16 > %t-moe.reference
// RUN: vxc %S/../src/main.vx --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t-moe.vxw --tokens 1,2,3,4 --steps 16 > %t-moe.vx
// RUN: python3 %S/../scripts/compare.py %t-moe.reference %t-moe.vx --tolerance 0.001 | FileCheck %s --check-prefix=MOE
// RUN: python3 %S/../scripts/make_tiny_model.py --moe --q4 %t-moe-q4.vxw > /dev/null
// RUN: python3 %S/../scripts/reference.py %t-moe-q4.vxw --tokens 1,2,3,4 --steps 16 > %t-moe-q4.reference
// RUN: vxc %S/../src/main.vx --package qwen=%S/../src --host default --machine fleet/m4-uma.vx -- %t-moe-q4.vxw --tokens 1,2,3,4 --steps 16 > %t-moe-q4.vx
// RUN: python3 %S/../scripts/compare.py %t-moe-q4.reference %t-moe-q4.vx --tolerance 0.001 | FileCheck %s --check-prefix=MOE-Q4
//
// CHECK: {{^}}16 steps, same tokens, logits within 0.001{{$}}
// FP8: {{^}}16 steps, same tokens, logits within 0.001{{$}}
// Q4: {{^}}16 steps, same tokens, logits within 0.001{{$}}
// MOE: {{^}}16 steps, same tokens, logits within 0.001{{$}}
// MOE-Q4: {{^}}16 steps, same tokens, logits within 0.001{{$}}
